                        <placeName corresp="#n1" xml:lang="gez" type="normalized">Bāhǝr Dār Falaga Gannat Qǝddus Giyorgis</placeName>
                        <placeName xml:id="n2" xml:lang="gez">ባሕር፡ ዳር፡ ፈለገ፡ ገነት፡ ቅዱስ፡ ጊዮርጊስ፡</placeName>
                        <placeName corresp="#n2" xml:lang="gez" type="normalized">Bāḥǝr Dār Falaga Gannat Qǝddus Giyorgis</placeName> 
                        <placeName xml:id="n3" xml:lang="gez">ባህር፡ ዳር፡ ጊዮርጊስ፡</placeName>
                        <placeName corresp="#n3" xml:lang="gez" type="normalized">Bāhǝr Dār Giyorgis</placeName> 
                        <region notAfter="1991" type="province" ref="https://betamasaheft.eu/LOC3549Gojjam">Goǧǧām</region>
                        <region notBefore="1991" type="RegionalState" ref="https://betamasaheft.eu/LOC1426Amhara">The regional State of ʾAmharā</region>
                        <settlement type="zone" ref="https://betamasaheft.eu/LOC7491BahrDarSpecialZone">Bāḥǝr Dār Special Zone</settlement>
                        <settlement type="city" ref="https://betamasaheft.eu/LOC1721BaherD">Bāḥǝr Dār</settlement>
                        <settlement>sub-city Safana Salām</settlement>                   
                        <country ref="https://betamasaheft.eu/LOC3010Ethiop">Ethiopia</country>
                        
                        <location>
                            <geo>11.595323 37.38892323311729</geo>
                            <height unit="m" cert="medium">1820.0</height>
                        </location>
                        
                        <note>
                            <date type="foundation" when="1327">The 
                                local tradition tells that the church was founded in 1327 and links the foundation to 
                                <persName ref="https://betamasaheft.eu/PRS1854Amdase">King ʿAmda Ṣǝyon I </persName></date>.
                                                 
                                                       
                            <ab type="history">
                                The subsequent development of the church is associated with the Gondarine time, 
                                particularly with the reign of King <persName ref="https://betamasaheft.eu/PRS5616IyasuI">ʾIyāsu I (r. 1682–1706)</persName>.
                                The present church was built in its current form and inaugurated on 17 June 1966, 
                                during the reign of Emperor <persName ref="https://betamasaheft.eu/PRS5226haylase">Ḫāyla Śǝllāse I</persName>.
                                It was formally inaugurated as a cathedral by the
                                patriarch ʾabuna Mātiyās I on <date>25 February 2014</date>.
                                The church formerly had an ancient museum located approximately 40 meters north. 
                                The old museum of the church is a historic building, ca. five meters high,
                                traditionally associated with the Gondarine period. 
                                Local tradition connects this structure with the Portuguese 
                                and the reign of <persName ref="https://betamasaheft.eu/PRS5616IyasuI">ʾIyāsu I ʾAdyām Sagad</persName>.
                                The former museum has since been replaced by a new museum
                                which houses a collection of ecclesiastical and royal objects, 
                                including royal garments, ceremonial robes, 
                                crowns, chalices, hand crosses, 
                                embroidered vestments, ceremonial umbrellas, and parchment manuscripts.
                                49 manuscripts were inventarized in <date>August 2026</date> in the <foreign xml:lang="am">ʿǝqā bet</foreign> 
                                by Tibebu Anteneh and Mihreteab Merachew Worku (Bahir Dar University). 
                                </ab>
                            
                            <ab type="tabot">
                                <measure quantity="4">4</measure> tābots, dedicated to                            
                                <persName type="tabot" ref="https://betamasaheft.eu/PRS10775Trinity">the Holy Trinity</persName>, 
                                <persName type="tabot" ref="https://betamasaheft.eu/PRS4377Gabriel">Archangel Gabriel</persName>, 
                                <persName type="tabot" ref="https://betamasaheft.eu/PRS5684JesusCh">Saviour of the World</persName>, 
                                the main being of <persName type="tabot" ref="https://betamasaheft.eu/PRS4585Georgeo">St George of Lydda</persName>
                                The feasts of St George are celebrated on 18 Ṭǝrr, 23 Yakātit, 23 Miyāziyā 23, 7 Ḥamle, and 7 Ḫǝdār. 
                                 </ab>                        
                            
                            <ab type="description">Dabr. 22 monks, 5 nuns, 13 priest, 15 deacons, 22 other servants.</ab>
                            <ab type="description" subtype="school">
                                Three teachers of <ref type="authFile" corresp="https://betamasaheft.eu/ZemaBet#Aqwaqwam">ʾaqqʷāqqʷām</ref> (litugrical dance), three teachers of 
                                <ref type="authFile" corresp="https://betamasaheft.eu/ZemaBet#Deggwa">Dǝggʷā</ref>,
                                two teachers of <ref type="authFile" corresp="https://betamasaheft.eu/QeddaseBet">qǝddāse</ref> (liturgy),
                                two teachers of <ref type="authFile" corresp="https://betamasaheft.eu/QeneBet">qǝne-poetry</ref>,
                                four of <foreign xml:lang="gez">tǝrgʷāme</foreign> (interpretation) and 
                                one of <foreign xml:lang="gez">zǝmmāre</foreign> (chanting)
                                (the stand for <date when="2026-08">August 2026</date>).
                            </ab>
                        </note>                        
                 
