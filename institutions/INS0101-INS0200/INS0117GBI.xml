               <t:location>
                  <t:geo>14.1728 39.4906</t:geo>
                  <t:height unit="m">2.607</t:height>
               </t:location>
               <t:note>
                  <t:date type="foundation" notBefore="1400" notAfter="1400">1400-1400</t:date>

                  <t:ab type="history">Dabr. Up to 7 small churches under the authority of Gʷāḥgot ʾIyasus, the old rock-hewn church, are scattered around.
                     One more church is the old church dedicated to the <t:persName type="tabot" ref="https://betamasaheft.eu/PRS11288AnAzMi">Three Youths (Salastu daqiq)</t:persName>. 
                     </t:ab>
                  <t:ab type="description">
                     <t:figure>
                        <t:graphic url="Sites/GBI.tif">
                           <t:desc>The church photographed by Denis Nosnitsin during the Ethio-SPaRe project.</t:desc>
                        </t:graphic>
                     </t:figure>
                     13 Mss., objects photographed: <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi001">GBI-001</t:ref> "Four Gospels"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi002">GBI-002</t:ref> "The Rite of the Holy Week"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi003">GBI-003</t:ref> "Collection of Liturgical Texts"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi004">GBI-004</t:ref> "Psalter"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi005">GBI-005</t:ref> "Five Pillars of the Mystery"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi006">GBI-006</t:ref> "The Faith of the Fathers"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi007">GBI-007</t:ref> "Miracles of Jesus"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi008">GBI-008</t:ref> "Synaxarion (March)"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi009">GBI-009</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi010">GBI-010</t:ref> "Homily of the Saviour of the World "; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi011">GBI-011</t:ref> "Miracles of Mary"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi012">GBI-012</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgbi013">GBI-013</t:ref> "Homily of the Saviour of the World"</t:ab>
                  <t:ab type="tabot">
                     <t:measure quantity="9"/>           Tābots (3 + 6): <t:persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus</t:persName>,
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS7049Michael">Michael</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS4377Gabriel">Gabriel</t:persName>;
                     some of the tābots kept in other churches are 2 of <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName>,
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS5684JesusCh#n3MadhaneAlam">Madḫāne ʿĀlam</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS4585Georgeo">George</t:persName>,
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS10581Zamika">ʾAragāwi</t:persName>.
</t:ab>
