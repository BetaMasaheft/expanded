      <t:body>
         <t:listPlace>
            <t:place type="church dabr" subtype="institution">
               
               <t:placeName xml:id="n1" xml:lang="gez">ሲዔት፡ ቅድስት፡ ማርያም፡</t:placeName>
               <t:placeName corresp="#n1" xml:lang="gez" type="normalized">Siʿet Qǝddǝst Māryām</t:placeName>
               <t:placeName type="alt" xml:id="n2" xml:lang="gez">ደብረ፡ ገነት፡ ቅድስት፡ ማርያም፡ ሲዔት፡</t:placeName>
               <t:placeName type="normalized" corresp="#n2" xml:lang="gez">Dabra Gannat Qǝddǝst Māryām Siʿet</t:placeName>
               <t:placeName type="alt" xml:id="n3" xml:lang="gez">የጋቦ፡ ማርያም፡</t:placeName>
               <t:placeName type="normalized" corresp="#n3" xml:lang="gez">Zag(g)ābo Māryām (former name)</t:placeName>
               
               
               <t:country ref="https://betamasaheft.eu/LOC3010Ethiop">Ethiopia</t:country>
               <t:region notBefore="1991" type="RegionalState" ref="https://betamasaheft.eu/LOC5932Tegray">Bǝḥerāwi Kǝllǝlāwi Mangǝśti Tǝgrāy</t:region>
               
               <t:settlement when="2010-12-07" type="warada" ref="https://betamasaheft.eu/LOC3293GantaA">Gāntā ʾAfašum</t:settlement>
               <t:settlement when="2010-12-07" type="tabiya" ref="https://betamasaheft.eu/LOC7163Debla">Dǝblā Siʿet</t:settlement>
               <t:settlement when="2010-12-07" type="qushat" ref="https://betamasaheft.eu/LOC7162Siet">Siʿet</t:settlement>
               
                              
               <t:location>
                  <t:geo>14.205083 39.4992</t:geo>
                  <t:height unit="m">2700.0</t:height>
               </t:location>
               <t:note>
                  <t:date type="foundation" notBefore="1400" notAfter="1500">1400-1500</t:date>
                  <t:desc type="foundation">According to local tradition, the foundation took place during the time of King <t:persName ref="https://betamasaheft.eu/PRS1854Amdase">King ʿĀmda Ṣǝyon I</t:persName> (r. <t:date>1314-1334</t:date>).</t:desc>
                  <t:ab type="history">Dabr. Formerly, the church could have a different name, cp. GSM-002, Zag(g)ābo/Zag(g)ābu Māryām. Currently, the site accomodates two churches. 
                     The recent (late <t:date>19th or 20th cent.?</t:date>), rectangular church dedicated to <t:ref type="authFile" corresp="https://betamasaheft.eu/CovenantMercy">Kidāna Mǝḥrat</t:ref> stands below, 
                     and the old rock-hewn church dedicated to St. <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName> is located above, cut in the rock. 
                     Many holes and small caves can be seen in the vertical rock around its entrance, formerly used as burials (in a few of them wooden caffins could still be seen) or dwellings of the monks.
</t:ab>
                  <t:ab type="description">
                     <t:figure>
                        <t:graphic url="Sites/GMS.tif">
                           <t:desc>The church photographed by Denis Nosnitsin during the Ethio-SPaRe project.</t:desc>
                        </t:graphic>
                     </t:figure>
                     18 Mss., objects photographed: <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms001">GMS-001</t:ref> "The Rite of the Holy Week"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms002">GMS-002</t:ref> "Four Gospels"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms003">GMS-003</t:ref> "The Book of the Funeral Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms004">GMS-004</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms005">GMS-005</t:ref> "Miracles of Jesus"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms006">GMS-006</t:ref> "Synaxarion (March)"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms007">GMS-007</t:ref> "The Book of the Funeral Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms008">GMS-008</t:ref> "The Faith of the Fathers"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms009">GMS-009</t:ref> "The Book of the Chants"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms010">GMS-010</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms011">GMS-011</t:ref> "Homily of the Saviour of the World"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms012">GMS-012</t:ref> "The Book of the Funeral Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms013">GMS-013</t:ref> "Miracles of Mary"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms014">GMS-014</t:ref> "Homily of St. Michael"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms015">GMS-015</t:ref> "Synoptic Lectionary for the Year"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms016">GMS-016</t:ref> "Vita of Gäbrä Mänfäs Qǝddus"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms017">GMS-017</t:ref> "The Book of the Matrimony Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESgms018">GMS-018</t:ref> "Prayer of Mary"</t:ab>
         
                  <t:ab type="tabot">
                     <t:measure quantity="7"/>Tābots of <t:ref type="authFile" corresp="https://betamasaheft.eu/CovenantMercy">Kidāna Mǝḥrat</t:ref>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS4585Georgeo">George</t:persName>, 
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS7049Michael">Michael</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS10775Trinity">Trinity</t:persName>, 
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS5684JesusCh#n3MadhaneAlam">Madḫāne ʿĀlam</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS12519TwentyFour">Twenty-Four Heavenly Priests</t:persName> (marble).</t:ab>
               </t:note>
            </t:place>
         </t:listPlace>
