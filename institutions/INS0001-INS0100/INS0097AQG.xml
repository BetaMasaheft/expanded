         <t:listPlace>
            <t:place type="church monastery gatar" subtype="institution">
               <t:placeName xml:id="n1" xml:lang="gez">ዓዲ፡ ቆልቋል፡ ጊዮርጊስ፡</t:placeName>
               <t:placeName corresp="#n1" xml:lang="gez" type="normalized">ʿĀddi Qolqʷāl Giyorgis</t:placeName>
               <t:placeName type="alt" xml:id="n2" xml:lang="gez">ቅዱስ፡ ጊዮርጊስ፡ ዓዲ፡ ቆልቋል፡</t:placeName>
               <t:placeName type="normalized" corresp="#n2" xml:lang="gez">Qǝddus Giyorgis ʿĀddi Qolqʷāl</t:placeName>
               
               <t:country ref="https://betamasaheft.eu/LOC3010Ethiop">Ethiopia</t:country>
               <t:region notBefore="1991" type="RegionalState" ref="https://betamasaheft.eu/LOC5932Tegray">Bǝḥerāwi Kǝllǝlāwi Mangǝśti Tǝgrāy</t:region>
               
               <t:settlement when="2011-11-18" type="warada" ref="https://betamasaheft.eu/LOC3640GuloMa">Gulo Maḵadā</t:settlement>
               <t:settlement when="2011-11-18" type="tabiya" ref="https://betamasaheft.eu/LOC6547Haban">Ḥaban</t:settlement>
               <t:settlement when="2011-11-18" type="qushat" ref="https://betamasaheft.eu/LOC6548AddiQ">ʿĀddi Qolqwāl</t:settlement>
               <t:location>
                  <t:geo>14.42075 39.465111</t:geo>
                  <t:height unit="m">2328.0</t:height>
               </t:location>
               <t:note>
                  <t:date type="foundation" notBefore="1400" notAfter="1500">1400-1500</t:date>
                  <t:desc type="foundation">The tradition remembers that the church was "renovated" in the time of däğğazmač <t:persName ref="https://betamasaheft.eu/PRS10102Webeha">Wǝbe Ḫayla Māryām</t:persName> and Metropolitan <t:persName ref="https://betamasaheft.eu/PRS8388SalamaI">Salāmā</t:persName> (in tenure <t:date>1841-1867</t:date>); 
                     however, it states that the church was founded before that time, probably by the local community.</t:desc>
                  
                  
                  <t:ab type="tabot">
                     <t:measure quantity="10" cert="low"/>
                     Tābots (ca. 10?): some of them are three (two wooden and one marble) of <t:persName type="tabot" ref="https://betamasaheft.eu/PRS4585Georgeo">George</t:persName>, two (one wooden and one marble) of <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName>, 
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS5684JesusCh#n3MadhaneAlam">Madḫāne ʿĀlam</t:persName> , <t:persName type="tabot" ref="https://betamasaheft.eu/PRS10775Trinity">Trinity</t:persName>.
                  </t:ab>
                  <t:ab type="description">
                     <t:figure>
                        <t:graphic url="Sites/AQG.tif">
                           <t:desc>The church photographed by Denis Nosnitsin during the Ethio-SPaRe project.</t:desc>
                        </t:graphic>
                     </t:figure>
                     15 Mss. photographed on 18-11-2011: <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg001">AQG-001</t:ref> "Psalter"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg002">AQG-002</t:ref> "Miracles of Jesus"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg003">AQG-003</t:ref> "Four Gospels"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg004">AQG-004</t:ref> "The Rite of the Holy Week"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg005">AQG-005</t:ref> "Vitae of the Martyrs"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg006">AQG-006</t:ref> "Book of the Diciples"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg007">AQG-007</t:ref> "Sinodos"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg008">AQG-008</t:ref> "Pentateuch"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg009">AQG-009</t:ref> "The Book of the Funeral Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg010">AQG-010</t:ref> "The Rite of the Holy Week"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg011">AQG-011</t:ref> "Miracles of Mary; Miracles of George"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg012">AQG-012</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg013">AQG-013</t:ref> "Four Gospels"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg014">AQG-014</t:ref> "Homily of St. George"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESaqg015">AQG-015</t:ref> "Psalter"</t:ab>
                  
                  
               </t:note>
