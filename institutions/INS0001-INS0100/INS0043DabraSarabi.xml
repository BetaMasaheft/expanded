         <t:listPlace>
            <t:place type="monastery" subtype="institution">
               <t:placeName xml:lang="gez" xml:id="n1">ደብረ፡ ጸራቢ፡</t:placeName>
               <t:placeName xml:lang="gez" corresp="#n1" type="normalized">Dabra Ṣarābi</t:placeName>
               <t:placeName xml:id="n2" xml:lang="gez">ደብረ፡ ጸራቢ፡ አቡነ፡ እዎስጣቴዎስ፡</t:placeName>
               <t:placeName corresp="#n2" xml:lang="en">Dabra Ṣarābi ʾAbuna ʾEwosṭātewos</t:placeName>
               
               
               <t:country ref="https://betamasaheft.eu/LOC3010Ethiop">Ethiopia</t:country>
               <t:region notBefore="1991" type="RegionalState" ref="https://betamasaheft.eu/LOC5932Tegray">The regional State of Tǝgrāy</t:region>  
               <t:settlement type="zone" when="2026-05-15" ref="https://betamasaheft.eu/LOC6653EastTegray">East Tǝgrāy zone</t:settlement>
               <t:settlement type="warada" notBefore="2020-01-01" ref="https://betamasaheft.eu/LOC6653EastTegray"> waradā Ḍǝrāʿ Wambartā</t:settlement>
               <t:settlement when="2026-05-01" type="tabiya" ref="https://betamasaheft.eu/LOC7498DabraBerhan">ṭābiyā Dabra Bǝrhān</t:settlement>
               <t:settlement when="2024-03-15" type="qushet" ref="https://betamasaheft.eu/LOC7499DabraSarabi">sub kebele Dabra Ṣarābi</t:settlement>
              
               <t:location>
                  <t:geo>13.651111 39.425056</t:geo>
                  <t:height unit="m">1816.0</t:height>
               </t:location>
               <t:note>
                  <t:date type="foundation" notBefore="1300" notAfter="1399">14th century.</t:date>
                  <t:ab type="history">Gadām. According to the local tradition, the monastery was established by 
                     ʾabbā Bǝnyāmin, a disciple of ʾEwosṭātewos, in the time of 
                     the reign of <t:persName ref="https://betamasaheft.eu/PRS1854Amdase">ʿAmda Ṣǝyon I</t:persName>, but this 
                     account is inconsistent. 
                  </t:ab>
                  <t:ab type="tabot">
                     <t:measure quantity="3">3</t:measure> main  tābots,                              
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName>. 
                     <t:persName type="tabot" ref="https://betamasaheft.eu/PRS3934Ewostate">ʾabuna ʾEwosṭātewos</t:persName>, 
                     and <t:persName type="tabot" ref="https://betamasaheft.eu/PRS3249Cyriacus">Cyriacus</t:persName>.
                  </t:ab>
                    <t:ab type="description">86 manuscripts were inventarized in <t:date>May 2026</t:date>
                     by Hailay Atsbha (Tigray Tourism and Culture Bureau) and 
                     Hagos Gebremariam (Department of Sociology, Adigrat University). The main feast 
                     is celebrated on 18 Maskaram (ʾabuna ʾEwosṭātewos). Ca. 40 servants were in the monastery 
                  in May 2026.</t:ab>
               </t:note>
      
            </t:place>
         </t:listPlace>
         
