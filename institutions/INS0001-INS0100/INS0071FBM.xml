               <t:placeName xml:id="n1" xml:lang="gez">ፈቃዳ፡ ማርያም፡ </t:placeName>
               <t:placeName corresp="#n1" xml:lang="gez" type="normalized">Faqādā Māryām</t:placeName>
               <t:placeName type="alt" xml:lang="gez" xml:id="n2">ደብረ፡ ብርሃን፡ ቅድስት፡ ማርያም፡ ፈቃዳ፡</t:placeName>
               <t:placeName type="normalized" xml:lang="gez" corresp="#n2">Dabra Bǝrhān Qǝddǝst Māryām Faqādā</t:placeName>
               
               <t:country ref="https://betamasaheft.eu/LOC3010Ethiop">Ethiopia</t:country>
               <t:region notBefore="1991" type="RegionalState" ref="https://betamasaheft.eu/LOC5932Tegray">Bǝḥerāwi Kǝllǝlāwi Mangǝśti Tǝgrāy</t:region>
               <t:settlement type="warada" from="2010-05-01" to="2010-05-01" ref="https://betamasaheft.eu/LOC3640GuloMa">Gulo Maḵadā</t:settlement>
               <t:settlement from="2010-05-21" to="2010-05-21" type="tabiya" ref="https://betamasaheft.eu/LOC6959Ambasata">ʾAmbasata Foqadā</t:settlement>
               <t:settlement from="2010-05-21" to="2010-05-21" type="qushat" ref="https://betamasaheft.eu/LOC7043Abiy">ʿĀbiya ʿĀddi</t:settlement>
               <t:location>
                  <t:geo>14.4051 39.394333</t:geo>
                  <t:height unit="m">2495.0</t:height>
               </t:location>
               <t:note>
                  <t:date type="foundation" notBefore="1400" notAfter="1500">1400-1500</t:date>
                  
                  <t:ab type="history">Dabr. A few nuns residing in a separated building in the compound. An additional small church dedicated to <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6951Mazgaba">Mazgabā Śǝllāse</t:persName> 
                     (a head of the monastery Gunda Gunde, <t:date>17th-early 18th century</t:date>) stands nearby in the gorge of river <t:placeName ref="https://betamasaheft.eu/LOC4700MayQar">Qarni</t:placeName>. It is said to have been built at the place where <t:persName ref="https://betamasaheft.eu/PRS6951Mazgaba">Mazgabā Śǝllāse</t:persName> used to pray.</t:ab>
                  <t:ab type="description">
                     <t:figure>
                        <t:graphic url="Sites/FBM.tif">
                           <t:desc>The church photographed by Denis Nosnitsin during the Ethio-SPaRe project.</t:desc>
                        </t:graphic>
                     </t:figure>
                     23 Mss. photographed: <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm001">FBM-001</t:ref> "Miracles of Mary"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm002">FBM-002</t:ref> "The Rite of the Holy Week"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm003">FBM-003</t:ref> "Synaxarion (March)"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm004">FBM-004</t:ref> "Homily of the Saviour of the World"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm005">FBM-005</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm006">FBM-006</t:ref> "The Book of the Funeral Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm007">FBM-007</t:ref> "Synaxarion (September)"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm008">FBM-008</t:ref> "Vita of Mäzgäbä śǝllase"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm009">FBM-009</t:ref> "Psalter"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm010">FBM-010</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm011">FBM-011</t:ref> "Missal"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm012">FBM-012</t:ref> "Vita of Mäzgäbä Śǝllase"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm013">FBM-013</t:ref> "Vita of Täklä Haymanot"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm014">FBM-014</t:ref> "The Book of the Baptismal Rite"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm015">FBM-015</t:ref> "Prayer of Incense"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm016">FBM-016</t:ref> "Acts of the Apostles"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm017">FBM-017</t:ref> "Homily of St. Michael"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm018">FBM-018</t:ref> "Miracles of Jesus"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm019">FBM-019</t:ref> "Miracles of Mary"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm020">FBM-020</t:ref> "Homily of the Sabbath"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm021">FBM-021</t:ref> "Four Gospels"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm022">FBM-022</t:ref> "Story of the Holy Trinity"; <t:ref type="mss" corresp="https://betamasaheft.eu/ESfbm023">FBM-023</t:ref> "Story of St. Mary"</t:ab>
                  <t:ab type="tabot">
                     <t:measure quantity="3"/>
                     Tābots: <t:persName ref="https://betamasaheft.eu/PRS5684JesusCh#n3MadhaneAlam">Madḫāne ʿĀlam</t:persName>, <t:persName ref="https://betamasaheft.eu/PRS6819Mary">Mary</t:persName>, <t:persName type="tabot" ref="https://betamasaheft.eu/PRS6951Mazgaba">Mazgabā Śǝllāse</t:persName> in an additional church (in the gorge).</t:ab>
               </t:note>
               
