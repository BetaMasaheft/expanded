         <t:listPerson>
            <t:person sex="2">


               <t:persName xml:lang="gez" xml:id="n1" type="birth">መስቀል፡ ክብራ፡</t:persName>
                  <t:persName xml:lang="gez" corresp="#n1" type="normalized">Masqal Kǝbrā</t:persName>
               <t:persName>
                  <t:roleName type="title">baʿalta biḥat</t:roleName>
               </t:persName>
               
               <t:nationality type="Ethiopia"/>
               <t:faith type="EOTC"/>
               <t:occupation type="ruler">queen</t:occupation>

               <t:floruit>She was the wife of King <t:persName ref="https://betamasaheft.eu/PRS6152Lalibala">Lālibalā</t:persName> who  played a major role during his reign. She was responsible
                  for the fall of the metropolitan <t:persName ref="https://betamasaheft.eu/PRS7073Mikael">Mikāʿel II</t:persName> who had to return to Egypt after four years in Ethiopia.
                  She is also credited with the building of some churches at <t:placeName ref="https://betamasaheft.eu/LOC4244Laliba">Lālibalā</t:placeName>. Her title can be interpreted as the "Lady of <t:placeName ref="https://betamasaheft.eu/LOC1914Bihat">biḥat</t:placeName>"
               </t:floruit>
               <t:death/>
            </t:person>
            
         </t:listPerson>
