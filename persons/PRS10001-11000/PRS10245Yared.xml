         <t:listPerson>
            <t:person sex="1" sameAs="wd:Q2894973">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">ያሬድ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Yāred</t:persName>
               <t:persName xml:lang="gez" xml:id="n2" type="nick">ማሕሌታዊ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Māḥletāwi</t:persName>
               <t:persName xml:lang="gez" xml:id="n3" type="birth">ማሕሌታይ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n3" type="normalized">Māḥletāy</t:persName>
               <t:persName>
                  <t:roleName type="title">kǝdus</t:roleName>
                  
               </t:persName>
               <t:nationality type="Ethiopia"/>
               <t:faith type="EOTC"/>
               
               <t:birth when="0550" cert="medium"> He was born in <t:placeName ref="https://betamasaheft.eu/LOC7363Aksum">ʾAksum</t:placeName> most probably in the first half of the sixth century. </t:birth>
               <t:floruit> He was a highly venerated saint of the Ethiopian Orthodox Church. He received a
                  traditional education from a priest of <t:placeName ref="https://betamasaheft.eu/LOC1311AksumS">ʾAksum
                     Ṣǝyon</t:placeName>, 
                  <t:persName ref="https://betamasaheft.eu/PRS11209Gedewon">
                     <t:roleName type="title">ʾabbā</t:roleName> Gedewon</t:persName>. He is credited with the invention
                  of Ethiopic sacred music and hymnody.</t:floruit>

            </t:person>
            
         </t:listPerson>
