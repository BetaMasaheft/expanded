      <t:body>
         <t:listPerson>
            <t:person sameAs="wd:Q711866" sex="1">

                  <t:persName xml:lang="gez" xml:id="n1" type="birth">ዮስጦስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Yosṭos</t:persName>

                  <t:persName>
                  <t:roleName type="title">ʾaṣe</t:roleName>
               </t:persName>
               <t:persName xml:lang="gez" xml:id="n2" type="regnal">ፀሐይ፡ ሰገድ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Ḍaḥay Sagad</t:persName>

                  <t:occupation type="ruler">Emperor</t:occupation>

                  <t:floruit notBefore="1711" notAfter="1716">He was a Gondarine king from <t:date>1711</t:date> to <t:date>1716</t:date>.
                     Prior to being crowned, <t:persName ref="https://betamasaheft.eu/PRS10473Yostos">Yosṭos</t:persName> acted as a kingmaker. He was devoted to hunting,
                     which he did every year of his reign. Blinding was a favoured punishment for his enemies. A revolt broke out in the court which he could not prevent.
                     A number of notables were killed, and  the son of
                     <t:persName ref="https://betamasaheft.eu/PRS5616IyasuI">
                     <t:roleName type="title">ʾaṣe</t:roleName> ʾIyāsu the Great</t:persName>, <t:persName ref="https://betamasaheft.eu/PRS3430DawitII">Dāwit III</t:persName>, was bought
                     from <t:placeName ref="https://betamasaheft.eu/LOC6157WahniA">Wahni ʾAmbā</t:placeName>.
                     <t:persName ref="https://betamasaheft.eu/PRS3430DawitII">Dāwit III</t:persName> was proclaimed king and

                     <t:persName ref="https://betamasaheft.eu/PRS10473Yostos">
                     <t:roleName type="title">ʾaṣe</t:roleName> Yosṭos</t:persName> pronounced dead.


                  </t:floruit>
                  <t:death when="1716"/>

               </t:person>
               
         </t:listPerson>



