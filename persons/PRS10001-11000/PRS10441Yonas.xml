      <t:body>
         <t:listPerson>
            <t:person sameAs="wd:Q342894" sex="1">
            
                  <t:persName xml:lang="gez" xml:id="n1" type="birth">ዮናስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Yonās</t:persName>
                <t:persName>
                  <t:roleName type="title">ʾaṣe</t:roleName>
               </t:persName>
                  <t:nationality type="Ethiopia"/>
                  <t:faith type="EOTC"/>
                 <t:occupation type="ruler">king</t:occupation>
               <t:residence>
                  <t:placeName ref="https://betamasaheft.eu/LOC3577Gondar">Gondar</t:placeName>
               </t:residence>
                  
               <t:floruit notBefore="1797" notAfter="1798">He was one of the short-lived kings on the Solomonic throne during the Zamana Masāfǝnt. 
                  He was a rival claimant to <t:persName ref="https://betamasaheft.eu/PRS9142TaklaGi">Takla Giyorgis I</t:persName> and a pawn in the rivalry between <t:persName ref="https://betamasaheft.eu/PRS9142TaklaGi">Takla Giyorgis I</t:persName> 
                  and <t:persName ref="https://betamasaheft.eu/PRS9811Wahdu">Wahdu</t:persName>. Finally, he was deposed from the throne by <t:persName ref="https://betamasaheft.eu/PRS9142TaklaGi">Takla Giyorgis I</t:persName> in <t:date>1798</t:date>. 
                  Sources confirmed that he spent his last years as a monk in <t:placeName ref="https://betamasaheft.eu/LOC4244Laliba">Lālibalā (town)</t:placeName>. </t:floruit>
               <t:death when="1832">He died being over 76 years old.</t:death>
                  
               </t:person>
               
         </t:listPerson>
