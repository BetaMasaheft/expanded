      <t:body>
         <t:listPerson>
            <t:person sameAs="wd:Q147677" sex="1">

                        <t:persName xml:lang="gez" xml:id="n1" type="birth">ዘርአ፡ ያዕቆብ፡</t:persName>
                        <t:persName xml:lang="gez" corresp="#n1" type="normalized">Zarʾa Yāʿqob</t:persName>
               <t:persName>
                  <t:roleName type="title">ʾaṣe</t:roleName>
               </t:persName>
                     <t:persName xml:lang="gez" xml:id="n2" type="regnal">ቈስጠንጢኖስ፡</t:persName>
                        <t:persName xml:lang="gez" corresp="#n2" type="normalized">Qʷasṭanṭinos</t:persName>

                     <t:occupation type="ruler">Emperor</t:occupation>
               <t:birth when="1399">He was born in <t:placeName ref="https://betamasaheft.eu/LOC3061Fataga">Faṭagār</t:placeName> in <t:date>1399</t:date>.</t:birth>
               <t:residence>
                  <t:placeName ref="https://betamasaheft.eu/LOC2246DabraB">Dabra Bǝrhān</t:placeName>
               </t:residence>
               <t:floruit notBefore="1434" notAfter="1468">He was the fourth son of
                  <t:persName ref="https://betamasaheft.eu/PRS3429DawitII">
                     <t:roleName type="title">ʾaṣe</t:roleName>Dāwit</t:persName>
                  to become a king and ascended to the throne after several years of chaos following the death of his brother

                  <t:persName ref="https://betamasaheft.eu/PRS10342Yeshaq">
                     <t:roleName type="title">ʾaṣe</t:roleName> Yǝsḥaq</t:persName> and
                  the short reign of another brother King <t:persName ref="https://betamasaheft.eu/PRS9175TaklaMa">Takla Māryām</t:persName>
                  in <t:date>1430-1433</t:date> as well  as three of his nephews.
                  He was an outstanding ruler of the early Solomonic period, between <t:date>1270-1527</t:date>.
                  He played a remarkable role to the development of Gǝʿǝz literature.</t:floruit>

                     <t:death when="1468"/>
                  </t:person>
            
         </t:listPerson>
