               <t:persName xml:lang="gez" xml:id="n1" type="birth">ገላውዴዎስ፡</t:persName>
               <t:persName xml:lang="gez" type="normalized" corresp="#n1">Galāwdewos</t:persName>
               <t:persName>
                  <t:roleName type="title">ʾaṣe</t:roleName>
               </t:persName>
               
               <t:persName xml:lang="gez" type="alt" xml:id="n2">ጌላውዴዎስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2">Gelāwdewos</t:persName>
               <t:persName xml:lang="gez" xml:id="n3">አጽናፍ፡ ሰገድ፡</t:persName>
               <t:persName type="regnal" corresp="#n3">ʾAṣnāf Sagad</t:persName>
               <t:persName xml:lang="en">Claudius</t:persName>
               <t:occupation type="ruler">emperor</t:occupation>
               <t:birth when="1522"/>
               <t:floruit notBefore="1540" notAfter="1559">
                  Galāwdewos became emperor at the age of 18 in <t:date>1540</t:date>.
                  His reign was marked by a successful struggle against <t:persName ref="https://betamasaheft.eu/PRS1522Ahmadb">ʾAḥmad b. ʾIbrāhīm al-Ġāzī</t:persName>.</t:floruit>
               <t:death when="1559" evidence="internal">He died on <t:date>23 March 1559</t:date>, in battle with <t:persName ref="https://betamasaheft.eu/PRS7623NurbM">Nūr b. Muǧāhīd</t:persName>.</t:death>
               <t:residence/>
               <t:nationality type="Ethiopia"/>
               <t:faith type="EOTC"/>
            </t:person>
            
            
            
            
