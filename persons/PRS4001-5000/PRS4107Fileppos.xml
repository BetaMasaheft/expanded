      <t:body>
         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">ፊልጶስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Filǝṗṗos</t:persName>
                  <t:persName>
                  <t:roleName type="title">ʾAbbā</t:roleName>
               </t:persName>
                  <t:nationality type="Ethiopia"/>
                  <t:faith type="EOTC"/>
                  <t:occupation type="ecclesiastic">abbot</t:occupation>
               <t:birth notBefore="1322" notAfter="1323">He was born  
                  during the reign of King <t:persName ref="https://betamasaheft.eu/PRS1854Amdase">ʿAmda Ṣǝyon I</t:persName>. </t:birth>
               <t:floruit notBefore="1350" notAfter="1406">He was a saint and prominent member of the 
                  <t:persName ref="https://betamasaheft.eu/PRS11207Ewostateans">ʾEwosṭāteans</t:persName>
                  who lived in the 14th and 15th century. He was the spiritual son of <t:persName ref="https://betamasaheft.eu/PRS2385Bakimos">
                     Bakimos of Dabra Ṣarābi</t:persName>, 
                  who was the pupil of <t:persName ref="https://betamasaheft.eu/PRS3934Ewostate">ʾEwosṭātewos</t:persName>. 
                  He was the founder of the monastery of 
                  <t:placeName ref="https://betamasaheft.eu/LOC2251DabraB">Dabra Bizan</t:placeName> in <t:date>1373/74</t:date>, the strong hold of 
                  <t:persName ref="https://betamasaheft.eu/PRS11207Ewostateans">ʾEwosṭāteans</t:persName>.
                  During his tenure as an  abbot, the monastery of  
                  <t:placeName ref="https://betamasaheft.eu/LOC2251DabraB">Dabra Bizan</t:placeName> became prosperous. 
                  Due to his refusal to renounce the teaching of the
                  two Sabbaths, he was imprisoned in <t:placeName ref="https://betamasaheft.eu/INS0327DHE">Dabra Ḥayq ʾƎsṭifānos</t:placeName> and set free in <t:date>1403/04</t:date>. 
                  He was succeeded by
                  <t:persName ref="https://betamasaheft.eu/PRS10371Yohanne"> 
               ʾabbā Yoḥannǝs</t:persName>, 
                  the second abbot of <t:placeName ref="https://betamasaheft.eu/LOC2251DabraB">Dabra Bizan</t:placeName>.</t:floruit>
                  <t:death when="1406">He died at the age of 84.</t:death>
               </t:person>  
               
         </t:listPerson>
         
