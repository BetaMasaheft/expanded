         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1" type="baptismal">እስጢፋኖስ፡</t:persName>
               
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">ʾƎsṭifānos</t:persName>
                  <t:persName xml:lang="gez" xml:id="n2" type="birth">ሀድገ፡ አንበሳ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Hadga ʾAnbasā</t:persName>

                  
               <t:persName>
                  <t:roleName type="title">ʾabbā</t:roleName>
               </t:persName>
     
                  
               <t:birth notBefore="1397" notAfter="1398"/>
               <t:residence>He was born in <t:placeName ref="https://betamasaheft.eu/LOC1236Agama">ʾAgama</t:placeName>. </t:residence>
               <t:floruit when="1416" evidence="internal">He was ordained deacon by ʾabuna <t:persName ref="https://betamasaheft.eu/PRS2469Bartalom">Bartalomewos</t:persName>. 
                  He established a new monastic community in <t:date>1428/29</t:date>.
                     </t:floruit>
               <t:death when="1444" evidence="internal">He was tortured, flogged and 
                  imprisoned by the order of 
                  <t:persName ref="https://betamasaheft.eu/PRS10626ZaraY">
                     <t:roleName type="title">ʾaṣe</t:roleName>  
                     Zarʾa Yāʿqob</t:persName>
                  and finally he died. </t:death>
            </t:person>
            
         </t:listPerson>
