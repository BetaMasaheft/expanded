      <t:body>
         <t:listPerson>
            <t:person sex="1" sameAs="wd:Q3767165">
               <t:persName><t:forename>Giovanni</t:forename> <t:forename>Battista</t:forename> <t:surname>Ellero</t:surname>
               </t:persName>
               <t:occupation type="literary">He was a scholar focusing primarily on customary law, traditional land right and land resources,
                  genealogies, and pastoral taxonomy. He was in assiduous correspondence with <t:persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</t:persName>, who 
                  published several articles based on his research.</t:occupation>
               <t:birth when="1910-07-17">17 July 1910</t:birth>
               <t:death when="1942">In June 1942, he was made war prisoner by the British troops and sent to South Africa. He died as the ship
                  that transported him was sunk by the German navy.</t:death>
               <t:floruit notBefore="1936" notAfter="1942">He was colonial officer of the Italian East Africa serving in several posts in 
                  <t:placeName ref="https://betamasaheft.eu/LOC5932Tegray">Bǝḥerāwi Kǝllǝlāwi Mangǝśti Tǝgrāy</t:placeName>.</t:floruit>
            </t:person>
         </t:listPerson>
         
