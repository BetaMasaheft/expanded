         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">ሚካኤል፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Mikāʾel [IV]</t:persName>
               <t:persName>
                  <t:roleName type="title">ʾabuna</t:roleName>
               </t:persName>
               <t:occupation type="ecclesiastic">metropolitan</t:occupation>
               <t:nationality type="Egypt"/>
               <t:faith type="Coptic"/>
             
               
               <t:floruit notBefore="1650" notAfter="1663">He was a metropolitan of the Ethiopian Orthodox Church who succeeded    
             
                  <t:persName ref="https://betamasaheft.eu/PRS6776Marqos"> 
                     <t:roleName type="title">ʾabuna</t:roleName>
                     Mārqos [III]</t:persName> in <t:date>1650</t:date> during the reign of  
                  King <t:persName ref="https://betamasaheft.eu/PRS4015Fasilada">Fāsiladas</t:persName>. During his episcopate, a debate took place between Qǝbāt (Unctionists) and Kārrā (Unionists)
                  on <t:date>23 June 1655</t:date>. His successor was ʾabuna <t:persName ref="https://betamasaheft.eu/PRS6071Krestodo">Krǝstodolu [II]</t:persName>.      
                 </t:floruit>
               <t:death when="1663"/>
              
            </t:person>
            
         </t:listPerson>
