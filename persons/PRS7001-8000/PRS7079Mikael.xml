      <t:body>
         <t:listPerson>
            <t:person sex="1" sameAs="wd:Q752011">
               
               <t:persName xml:lang="gez" xml:id="n1">ሚካኤል፡ ዓሊ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Mikāʾel ʿĀli</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="alt">ሚካኤል፡ አሊ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Mikāʾel ʾAli</t:persName>
               <t:persName xml:lang="gez" xml:id="n3" type="birth">መሐመድ፡ አሊ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n3" type="normalized">Maḥammad ʾAli</t:persName>
               <t:persName xml:lang="gez" xml:id="n4" type="horse">አባ፡ ሻንቆ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n4" type="normalized">ʾAbbā Šānqo</t:persName>
               <t:persName xml:lang="gez" xml:id="n5" type="baptismal">ሚካኤል፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n5" type="normalized">Mikāʾel</t:persName>
               <t:persName>
                  <t:roleName type="title">ʾimām</t:roleName>
               </t:persName>
               <t:persName>
                  <t:roleName type="title">nǝguś</t:roleName>
               </t:persName>
               <t:occupation type="ruler">king</t:occupation>
               <t:nationality type="Ethiopia"/>
               <t:faith type="EOTC"/>
               <t:residence>
                  <t:placeName ref="https://betamasaheft.eu/LOC2575Dase">Dase</t:placeName>
               </t:residence>

               <t:birth notBefore="1847" notAfter="1850">He was born at 
                  <t:placeName ref="https://betamasaheft.eu/LOC6242WarraH">Warra Himano</t:placeName> between<t:date>1847–1850</t:date>.</t:birth>
               <t:floruit notBefore="1870" notAfter="1916">He was an important ruler of <t:placeName ref="https://betamasaheft.eu/LOC6185Wallo">Wallo</t:placeName> and 
                  the entire northern Ethiopia. 
                  He was born Muslim and later converted to Christianity after the council of <t:placeName ref="https://betamasaheft.eu/LOC1980BoruMe">Boru Medā</t:placeName> in <t:date>1878</t:date>, adopting the baptismal name Mikaʾel. 
                  He maintained an alliance with <t:persName ref="https://betamasaheft.eu/PRS10378Yohanne">Yoḥannǝs IV</t:persName> until the emperor’s death in <t:date>1889</t:date> at the battle of 
                  <t:placeName ref="https://betamasaheft.eu/LOC4637Matamm">Matammā</t:placeName>. 
                  After <t:persName ref="https://betamasaheft.eu/PRS10378Yohanne">Yoḥannǝs’s</t:persName> death
                  he declared his submission to <t:persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk</t:persName>
                  to whom he was loyal till the end of his reign. He was one of the military commanders at the 
                  battle of <t:placeName ref="https://betamasaheft.eu/LOC1264Adwa">ʿAdwā</t:placeName>.

               </t:floruit>
               <t:death when="1916">He was killed at the battle of <t:placeName ref="https://betamasaheft.eu/LOC5446Sagale">Sagale</t:placeName> in
                     <t:date>1916</t:date>. </t:death>
            </t:person>
            
         </t:listPerson>
