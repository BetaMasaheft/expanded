      <t:body>
         <t:listPerson>
            <t:person sex="1">
            
                  
                  
                  <t:persName xml:lang="gez" xml:id="n1" type="birth">ክፍሌ፡ ገሪማ፡ ወልደ፡ ኪዳን፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Kǝfle Garimā Walda Kidān</t:persName>
               <t:persName xml:lang="gez" xml:id="n2" type="baptismal">ሚካኤል፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Mikāʾel II</t:persName>
               
              
               <t:persName>
                  <t:roleName type="title">ʾabbā</t:roleName>
               </t:persName>
               <t:occupation type="ecclesiastic">bishop</t:occupation>
                  
                  
                  
                  <t:faith type="EOTC"/>
                  
                  
          
               <t:residence ref="LOC3577Gondar"/>
               <t:residence ref="LOC3957Jerusa"/>
               <t:birth when="1886">He was born at <t:placeName ref="https://betamasaheft.eu/LOC1390AmbaGe">Amba Gǝšän</t:placeName>
               </t:birth>
                  
               <t:floruit notBefore="1946" notAfter="1959">He was the bishop of 
                  <t:placeName ref="https://betamasaheft.eu/LOC3577Gondar">Gondar</t:placeName> from <t:date>1946</t:date> to <t:date>1959</t:date>.
                  He became a monk and was consecrated priest in <t:date>1924</t:date> 
                  by 
                  <t:persName ref="https://betamasaheft.eu/PRS6876Matewos">
                     <t:roleName type="title">ʾabuna</t:roleName> 
                     Mātewos</t:persName>.
                  In <t:date>1924-25</t:date> he made a pilgrimage to <t:placeName ref="https://betamasaheft.eu/LOC3957Jerusa">Jerusalem</t:placeName> where he stayed for six months. In <t:date>1935</t:date>, 
                  he was appointed head of the Ethiopian monasteries in <t:placeName ref="https://betamasaheft.eu/LOC3957Jerusa">Jerusalem</t:placeName>. After the liberation of the country from Italian colonial rule, 
                  he was ordained as bishop of <t:placeName ref="https://betamasaheft.eu/LOC3577Gondar">Gondar</t:placeName> in <t:date>1946</t:date>where he served until his death.
                  </t:floruit>
               <t:death when="1959">He died at <t:placeName ref="https://betamasaheft.eu/LOC1390AmbaGe">Amba Gǝšän</t:placeName>
               </t:death>
                  
                  
               </t:person>
               
               
         </t:listPerson>
         
         
         
         
