         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">ጴጥሮስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Ṗeṭros IV</t:persName>
               <t:persName>
                  <t:roleName type="title">ʾabuna</t:roleName>
               </t:persName>
               <t:occupation type="ecclesiastic">metropolitan</t:occupation>
               <t:nationality type="Egypt"/>
               <t:faith type="Coptic"/>
          
               <t:residence>
                  <t:placeName ref="https://betamasaheft.eu/LOC1114AddiAb">ʿAddi Abun</t:placeName> 
               </t:residence>
               <t:floruit notBefore="1882" notAfter="1917">He was the metropolitan of the Ethiopian Orthodox Church,
                  consecrated by <t:persName ref="https://betamasaheft.eu/PRS3259CyrilV">Cyril V</t:persName>  
                  in <t:date when="1882">1882</t:date> together with the other three bishops: <t:persName ref="https://betamasaheft.eu/PRS6876Matewos">Mātewos X</t:persName>, <t:persName ref="https://betamasaheft.eu/PRS6404Luqas">Luqas</t:persName> and 
                  <t:persName ref="https://betamasaheft.eu/PRS13100Marqos">Marqos</t:persName>. 
                  He was the successor of ʾabuna <t:persName ref="https://betamasaheft.eu/PRS2225Atnatewo">ʾAtnātewos</t:persName>.
          </t:floruit>
               <t:death when="1917-10-20">20 October 1917</t:death>
            </t:person>
            
         </t:listPerson>
