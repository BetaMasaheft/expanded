         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1">ኃይለ፡ ሥላሴ፡ ጉግሳ፡</t:persName>
               <t:persName xml:lang="gez" type="normalized" corresp="#n1">Ḫāyla Śǝllāse Gugsā</t:persName>
               <t:persName><t:roleName type="rank">daǧǧāzmāč</t:roleName></t:persName>
               <t:persName><t:roleName type="rank">rās</t:roleName></t:persName>
               <t:occupation type="military"/>
               <t:birth when="1900">1900</t:birth>
               <t:death when="1974">1974</t:death>
               <t:floruit notBefore="1930" notAfter="1946">He was a nobleman whom Emperor <t:persName ref="https://betamasaheft.eu/PRS5226haylase">Ḫāyla Śǝllāse I</t:persName> 
                  appointed governor of eastern <t:placeName ref="https://betamasaheft.eu/LOC6569Tegray">Tǝgrāy</t:placeName> in 1934. 
                  Earlier, in 1932, he married <t:persName ref="https://betamasaheft.eu/PRS10605Zannaba">Zannaba Warq</t:persName>, the younger daughter of
                  <t:persName ref="https://betamasaheft.eu/PRS5226haylase">Ḫāyla Śǝllāse I</t:persName>. During the war, he collaborated with the Italians, who promoted him to the rank of rās. 
                  From 1941 on, he continued to render services to the British administration, hoping that they would enable him and his supporters in eastern 
                  Tǝgrāy to gain independence from the Ethiopian Empire. After the war, he was put on trial in Addis Ababā and sentenced to death, later commuted to a life sentence.
               </t:floruit>
            </t:person>
        
         
