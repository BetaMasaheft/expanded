      <t:body>
         <t:listPerson>
            <t:person sex="1" sameAs="wd:Q49689">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">ኃይለ፡ መለኮት፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Ḫāyla Malakot</t:persName>
              <t:persName>
                  <t:roleName type="title">nǝguś</t:roleName>
               </t:persName>
                  <t:nationality type="Ethiopia"/>
                  <t:faith type="EOTC"/>
                  <t:occupation type="political">king</t:occupation>
                  <t:birth when="1827"/>
               <t:floruit notBefore="1847" notAfter="1855">He was <t:persName ref="https://betamasaheft.eu/PRS5205haylaMa">
                     <t:roleName type="title">nǝguś 
               </t:roleName>
                  </t:persName>
                   
                  of <t:placeName ref="https://betamasaheft.eu/LOC5597Sawa">
                  Šawā </t:placeName> from about <t:date>1827</t:date> to <t:date>1855</t:date>. 
                  He aspired to a central role in Ethiopian politics and he even took the title 
                  <t:persName ref="https://betamasaheft.eu/PRS5205haylaMa">
                     <t:roleName type="title">ʾaṣe</t:roleName>Ḫāyla Malakot</t:persName> although he was not anointed. 
                  When  
                  <t:persName ref="https://betamasaheft.eu/PRS9430Tewodros">
                     <t:roleName type="title">ʾaṣe</t:roleName> Tewodros II</t:persName> 
                  invaded <t:placeName ref="https://betamasaheft.eu/LOC6185Wallo">Wallo</t:placeName>, 
                  <t:persName ref="https://betamasaheft.eu/PRS5205haylaMa">Ḫāyla Malakot</t:persName> cooperated with the 
                  <t:placeName ref="https://betamasaheft.eu/LOC6185Wallo">Wallo</t:placeName> ruler, 
                  <t:persName ref="https://betamasaheft.eu/PRS10062Warqitu">Warqitu</t:persName> but their plan  failed.
                  Then,  
                  <t:persName ref="https://betamasaheft.eu/PRS9430Tewodros">
                     <t:roleName type="title">ʾaṣe </t:roleName>
                     Tewodros II</t:persName> invaded <t:placeName ref="https://betamasaheft.eu/LOC5597Sawa">
                     Šawā </t:placeName> and <t:persName ref="https://betamasaheft.eu/PRS5205haylaMa">Ḫāyla Malakot</t:persName> was defeated and seriously wounded. </t:floruit>
                  
               <t:death when="1855">He died in <t:date>1855</t:date> 
                  and was buried <t:placeName ref="https://betamasaheft.eu/LOC2238DabraB">Dabra Baggǝʿ</t:placeName>.
               </t:death>
               </t:person>
               
         </t:listPerson>
