               <t:persName>
                  <t:roleName type="title">marʿǝd ʾazmāč</t:roleName>
               </t:persName>
                  <t:nationality type="Ethiopia"/>
                  <t:faith type="EOTC"/>
                  <t:occupation type="political">ruler</t:occupation>

               <t:floruit notBefore="1719" notAfter="1743">He was the third ruler of the kingdom of
                  <t:placeName ref="https://betamasaheft.eu/LOC5597Sawa">
                  Šawā </t:placeName> from about <t:date>1719</t:date> to <t:date>1743</t:date>,
                  a period of  territorial expansion and administrative consolidation.
                  Like his predecessors, in alliance with the walasma rulers,
                  he continued a campaign against the <t:persName ref="https://betamasaheft.eu/ETH1973Oromo">Oromo</t:persName>
                  of Karrayyu and pushed the border of the principality.
                  It was during his rule  that the typical land tenure system of  <t:placeName ref="https://betamasaheft.eu/LOC5597Sawa">
                     Šawā </t:placeName> was developed. He was succeeded by
                  <t:persName ref="https://betamasaheft.eu/PRS1878AmmehaI">
                     <t:roleName type="title">marʿǝd ʾazmāč</t:roleName>
                        ʾAmmǝḫā ʾIyyasus</t:persName>
               </t:floruit>


               </t:person>
               
         </t:listPerson>
