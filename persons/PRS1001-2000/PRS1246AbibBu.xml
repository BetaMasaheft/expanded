               <t:persName xml:lang="en" type="alt" corresp="#n3">Paulus</t:persName>     
               <t:faith type="Christianity"/>
               <t:floruit notBefore="0300" notAfter="0350">The name of his father was Abraham, and that of his mother was Harik, and they were natives of the country
                  of Rome, and came from the borders of Lupi; and since there was a persecution in the days
                  of the Emperor Maximianus they continued to fly from city to city... </t:floruit>
               <t:note type="commemoration"><t:date type="diesNatalis" ref="ethiocal:Teqemt25">25 Ṭǝqǝmt</t:date></t:note>
            </t:person>
