      <t:body>
         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">አንበስ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">ʾAnbas</t:persName>
               <t:persName xml:lang="gez" xml:id="n2" type="birth">አንበሳ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">ʾAnbasā</t:persName>
                  <t:persName>
                  <t:roleName type="title">ʾabbā</t:roleName>
               </t:persName>
                  <t:nationality type="Ethiopia"/>
                  <t:faith type="EOTC"/>
                  
                  
               <t:floruit> He is a saint commemorated on <t:date ref="ethiocal:Maskaram3" type="diesNatalis">3 Maskaram</t:date> who lived in the 14th century or 16th century. 
                  He is known as the founder of the monastery of <t:placeName ref="https://betamasaheft.eu/LOC3839Hazalo">Ḥāzalo</t:placeName>
                  in <t:placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</t:placeName>. 
                  <t:persName ref="https://betamasaheft.eu/PRS1911Anbas">
                     <t:roleName type="title">ʾabbā </t:roleName> ʾAnbas</t:persName> 
                  was one of the 33 disciples of 
                  <t:persName ref="https://betamasaheft.eu/PRS9152TaklaHa">
                     <t:roleName type="title">ʾabuna</t:roleName> Takla Hāymānot I</t:persName>.                     
                  </t:floruit>
                  
               </t:person>  
               
         </t:listPerson>
         
