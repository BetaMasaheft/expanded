            <t:person sex="2">
               <t:persName xml:lang="gez" xml:id="n1" type="birth">አስቴር፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">ʾAster</t:persName>
               <t:persName xml:lang="gez" xml:id="n2" type="alt">አስቴር፡ ኢያሱ፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">ʾAster ʾIyāsu</t:persName>
               <t:persName>
                  <t:roleName type="title">wayzaro</t:roleName>
               </t:persName>
               <t:occupation type="political">Princess</t:occupation>
               
               <t:floruit notBefore="1700" notAfter="1799">She was the daughter of 
                  <t:persName ref="https://betamasaheft.eu/PRS2682BerhanM">Bǝrhān Mogasā</t:persName> and 
                 
                  <t:persName ref="https://betamasaheft.eu/PRS5621Iyasu">  
                     <t:roleName type="title">grāzmāč</t:roleName> ʾIyāsu</t:persName>. 
                  She was a prominent member of the Gondarine aristocracy. 
                  She was reportedly the second wife of <t:persName ref="https://betamasaheft.eu/PRS7091Mikael">Mikāʾel Sǝḥul</t:persName>, to whom she was married in 1768. 
           </t:floruit>
            
            </t:person>
            
