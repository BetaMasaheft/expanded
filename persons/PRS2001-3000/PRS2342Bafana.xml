      <t:body>
         <t:listPerson>
            <t:person sex="2" sameAs="wd:Q989362">
               <t:persName xml:lang="gez" xml:id="n1">ባፈና፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n1" type="normalized">Bāfanā</t:persName>
               <t:persName xml:lang="gez" xml:id="n2">ባፈና፡ ወልደ፡ ሚካኤል፡</t:persName>
               <t:persName xml:lang="gez" corresp="#n2" type="normalized">Bāfanā Walda
                  Mikāʾel</t:persName>
               <t:persName>
                  <t:roleName type="title">wayzaro</t:roleName>
               </t:persName>
               <t:persName>
                  <t:roleName type="title">ʾǝmmǝyāt</t:roleName>
               </t:persName>
               <t:occupation type="ruler">queen</t:occupation>
               <t:occupation type="ecclesiastic">nun</t:occupation>
               <t:faith type="EOTC"/>
               <t:residence>
                  <t:placeName ref="https://betamasaheft.eu/LOC4578Marhab">Marḥābete</t:placeName>
               </t:residence>
               <t:floruit notBefore="1865" notAfter="1910">She was born to a noble family living in
                     <t:placeName ref="https://betamasaheft.eu/LOC4578Marhab">Marḥābete</t:placeName>. She was a spouse of King <t:persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk II</t:persName>
                  <t:date from="1865" to="1882">from 1865 to 1882</t:date>. Although her exact date of
                  birth is unknown, she is believed to be older than the king. Bāfanā and <t:persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk II</t:persName> had no children together, though she
                  had five children from previous marriages, three sons and two daughters. At first,
                  she was supportive of her husband’s ambitions and probably even helped <t:persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk II</t:persName> to establish his authority in
                     <t:placeName ref="https://betamasaheft.eu/LOC4578Marhab">Marḥābete</t:placeName>. However, spousal conflict of a political
                  nature started in <t:date when="1876">1876</t:date> when she prevented one of her
                  daughters from marrying <t:persName ref="https://betamasaheft.eu/PRS6837MasasaS">Mäšäša Säyfu</t:persName> and continued to escalate
                  in the following years. After plotting an unsuccessful rebellion attempt against <t:persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk II</t:persName>, she left for <t:placeName ref="https://betamasaheft.eu/LOC2296DabraL">Dabra Libānos</t:placeName> and became a nun.</t:floruit>

               <t:death when="1900" cert="medium">She died at <t:placeName ref="https://betamasaheft.eu/LOC2296DabraL">Dabra
                     Libānos</t:placeName> c. 1900.</t:death>

            </t:person>
            
         </t:listPerson>
