      <t:body>
         <t:listPerson>
            <t:person sex="1">
               <t:persName xml:lang="gez" xml:id="n1">አዝቂር፡</t:persName>
               <t:persName xml:lang="gez" type="normalized" corresp="#n1">ʾAzqir</t:persName>
               <t:persName xml:lang="gez" xml:id="n2">አጽቂር፡</t:persName>
               <t:persName xml:lang="gez" type="normalized" corresp="#n2">ʾAṣqir</t:persName>
               <t:residence ref="LOC4955Najran"/>
               <t:residence ref="LOC3868Himyar"/>
               <t:floruit>A priest named Azqir preached Christianity in <t:placeName ref="https://betamasaheft.eu/LOC4955Najran">Najran</t:placeName>, which
                  gained him the hostility of some influential groups there. These had him placed under arrest while a message was sent to the 
                  Himyarite king in <t:placeName ref="https://betamasaheft.eu/LOC6409Zafar">Zafar</t:placeName>, accusing him of preaching "a new religion". In due course a
                  royal summons came for him to be sent to Zafar for trial, and he was sent there in the custody of a party of
                  traders going that way. The king was unimpressed by Azqir's claim that the religion he preached was not
                  new; and some räbbanat among the king's councillors advised that he should be sent back to Najran to be
                  publicly executed there.</t:floruit>
               <t:faith type="Christianity"/>
               <t:note type="commemoration"><t:date type="diesNatalis" ref="ethiocal:Hedar24">24 Ḫedār</t:date></t:note>
            </t:person>
            
            
         </t:listPerson>
         
