<?xml version="1.0" encoding="UTF-8"?>
<project default="xar" name="expanded">
    <xmlproperty file="expath-pkg.xml" />
    <property name="project.version" value="${package(version)}" />
    <property name="project.app" value="expanded" />
    <property name="build.dir" value="build" />
    <target name="clean" description="delete all build artefacts">
        <delete includeemptydirs="true" failonerror="false">
            <fileset dir="${build.dir}" includes="**/*" />
        </delete>
    </target>
    <target name="xar" depends="clean">
        <mkdir dir="${build.dir}" />
        <!-- Data package only: TEI corpora + eXist package metadata/indexes.
             CI scripts, tests, docs, and editor cruft stay out of autodeploy. -->
        <zip basedir="." destfile="${build.dir}/${project.app}-${project.version}.xar">
            <exclude name="${build.dir}/**" />
            <exclude name=".git/**" />
            <exclude name=".github/**" />
            <exclude name=".vscode/**" />
            <exclude name=".codacy/**" />
            <exclude name=".cursor/**" />
            <exclude name=".agent/**" />
            <exclude name=".zed/**" />
            <exclude name=".worktrees/**" />
            <exclude name="docs/**" />
            <exclude name="scripts/**" />
            <exclude name="test/**" />
            <exclude name=".gitignore" />
            <exclude name=".dockerignore" />
            <exclude name=".DS_Store" />
            <exclude name="*.code-workspace" />
            <exclude name="*report.txt" />
        </zip>
    </target>
</project>
