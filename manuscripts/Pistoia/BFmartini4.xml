                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <seg type="script" cert="medium">Eighteenth-century script (?). </seg>
                                <seg type="ink">Black, red.</seg>                                
                                <seg type="rubrication">Groups of lines in the incipit page of the “Faith of the Fathers”; two incipit lines of the sections of the same text; two incipit lines of the “Book of the epistle”, alternating with a black line; the name of Mary; the word ክፍል፡; elements of the punctuation signs and numerals, in full or in part</seg>
                            </handNote>
                        </handDesc>                        
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus target="#1r"/>
                                    <desc type="Record">transaction note written in Amharic in black ink. The name of king Zär˒a Yaʿqob is mentioned</desc>
                                    <q xml:lang="am">አቤቶ፡ አደይ፡ የሸጡት፡ የዚኅ፡ መድኑ፡ የወለተ፡ አቢብ፡ ልጅ፡ መቻ፡ አድጎ፡ የተጻፈው፡ በአፄ፡ ዘርአ፡ ያዕቆብ፡ በመንፈቀ፡ ዘመኑ፡</q>
                                </item>
                                <item xml:id="a2">
                                    <locus target="#1r"/>
                                    <desc type="Record">transaction note, written in Amharic in the same hand as the previous note, concerning certain properties in the Muslim quarter of an unspecified Ethiopian city</desc>
                                    <q xml:lang="am">አቤቶ፡ እዝራ፡ የሸጡት፡ የስላምጌ፡ ቦታ፡ አድግመት፡ እፃውን፡ የዚኅ፡ ዋጋው፡ ወቄታ፡ ድሪም፡ መድኑ፡</q>
                                </item>
                                <item xml:id="a3">
                                    <locus target="#1r"/>
                                    <desc type="Record"> transaction note written in Amharic in black ink, in the same hand as the previous notes. The text is partly erased</desc>
                                    <q xml:lang="am">ያቤቶ፡ ወልደ፡ ኢየሱስ፡ ልጁች፡ ወለተ፡ ሥሉስና፡ አበኔር፡ የሸጡት፡ ያማጋው፡ ዕፃቸውን፡</q>
                                </item>
                                <item xml:id="e1">
                                    <locus target="#2v"/>
                                    <desc>The note written in Italian in pencil by Quinto Santoli (1875–1959), librarian of the Forteguerriana; it is dated <date>27 April 1931</date>.</desc>
                                    <q xml:lang="it">27.4.1931 IX. Questo codice consta di 212 carte delle quali soltanto la 1b è bianca. Q. Santoli</q>
                                </item>
                                
                                
                            </list>
