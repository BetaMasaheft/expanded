                        </decoDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus from="36va" to="37vb"/>
                                    <desc type="GuestText">invocation entitled Bä˒ǝntä qǝddǝsat sälamawit, written in small and slanted script</desc>
                                    <q xml:lang="gez">በእንተ፡ ቅድሳት፡ ሰላማዊት፡ ሰላመ፡ ናስ<supplied reason="omitted">ተ</supplied>በቍዕ፡ ከመ፡ እግዚአብሔር፡ ያስተሳልመነ። በሣህለ፡ ዚአሁ። በእንተ፡ <sic>ሃይማኖተነ፡</sic> <sic>ናስ<supplied reason="omitted">ተ</supplied>በቁዕ፡</sic>...</q>
                                </item>
                                <item xml:id="a2">
                                    <locus from="38ra" to="38va"/>
                                    <desc type="GuestText">calendric note written in Amharic in mediocre hand</desc>
                                    <q xml:lang="am">የሰንበተ፡ ሰንበታት፡ ቍጥሩ፡ ፵፱፡ ነው፡ የሰንበተ፡ ዓባይ፡ ቍጥሩ፡ ፺እ፩፡ ነው፡ የሁለቱም፡ አወጣጡ፡ ዮሐንስ፡ ሰኞ። …</q>
                                </item>
                                <item xml:id="e1">
                                    <locus target="#2v"/>
                                    <desc>The note written in Italian in pencil by Quinto Santoli (1875–1959), librarian of the Forteguerriana; it is dated <date>27 April 1931</date>.</desc>
                                    <q xml:lang="it">27.4.1931 IX. Questo codice consta di 38 carte di cui le prime due sono bianche. Q. Santoli</q>
                                </item>
                                
                                
                            </list>
