         <sourceDesc>
            <msDesc>
               <msIdentifier>
                  <repository ref="https://betamasaheft.eu/INS0692CUL">Cambridge University Library Collections</repository>
                  <idno facs="https://cudl.lib.cam.ac.uk//iiif/MS-OR-02269" corresp="https://cudl.lib.cam.ac.uk//iiif/MS-OR-02269">CUL Or. 2269</idno>
               </msIdentifier>
               <msContents>
                  <summary>A personal copy containing Mystagogia [ትምሕርተ ፡ ኅቡዓት], the
                     Gospel of John [ወንጌል ፡ ዘዮሐንስ], and various prayers and hymns. </summary>
                  <msItem xml:id="ms_i1">
                     <locus from="1r" to="4r">1r-4r</locus>
                     <title>Mystagogia</title>
                     <title xml:lang="gez">ትምሕርተ ፡ ኅቡዓት</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <explicit/>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="5r" to="112v">5r-112v</locus>
                     <title>Gospel of John</title>
                     <title xml:lang="gez">ወንጌል ፡ ዘዮሐንስ</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <explicit/>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="113r" to="113v">113</locus>
                     <title>Hymn to the Angels</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <note>The first seven lines on 113r consist of a non-Ge'ez language in Ge'ez script.</note>
                  </msItem>
                  <msItem xml:id="ms_i4">
                     <locus from="113v" to="115v">113v-115v</locus>
                     <title>Hymn to Gabra Manfas Qeddus መፍቀሬ ፡ ጸሎት ፡ ወጾመ</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <note>The hymn was copied by Takla
                        Ab</note>
                     <explicit/>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="115v" to="115v">115v</locus>
                     <title>Hymn to the Angels ነዓ ፡ ነዓ ፡ መልአክ ፡ ፍጡነ ፡ ከመ ፡ ትንግረኒ ፡ ነገረ ፡
                        ማኅፀንተ ፡ ሥላሴ</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <explicit/>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="115v" to="116r">115v-116r</locus>
                     <title>Prayer Against the Angels of Darkness Being
                        Revealed</title>
                     <textLang mainLang="gez">Geez</textLang>
                     <explicit/>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="Codex">
                     <supportDesc material="parchment">
                        <extent>116 ff.<dimensions type="leaf" unit="cm">
                           <height>15.6</height>
                           <width>12.6</width>
                        </dimensions><dimensions subtype="computed" unit="mm" type="leaf"><height quantity="156" unit="mm"/><width quantity="126" unit="mm"/></dimensions>
                        </extent>
                        
                     </supportDesc>
                     <layoutDesc>
                        <layout columns="2" writtenLines="14 21"> 14-21 lines per
                           leaf</layout><layout subtype="computed" type="catalogue" columns="2"><writtenLines quantity="21"/></layout>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote script="Ethiopic" xml:id="h1">
                        <seg type="script">
                           Black ink; at least three different hands; rubrications
                           throughout.
                        </seg>
                     </handNote>
                  </handDesc>   
                  <decoDesc>
                     <decoNote type="frame" xml:id="d1"><list>
                        <item>f. <locus target="#5r">5r</locus> Harag</item>
                     </list></decoNote>
                  </decoDesc>
                  <additions>
                     <list>
                        <item xml:id="a1">Prayers for Walda Kirubēl added in
                           a secondary hand on ff. <locus target="#26r">26r</locus>,
                           <locus target="#32r">32r</locus>, <locus target="#59r">59r</locus>, <locus target="#76r">76r</locus>, <locus from="93v" to="93v">93v</locus>, <locus target="#103v">103v</locus></item>
                        <item xml:id="e1">An
                           ownership note of the work is found on f. <locus target="#4r">4r</locus> and contains the name Abbā Walda Kirubēl; the name of the original owner has been
                           erased and replaced with Walda Kirubēl on ff. 5r-112v; prayers for Walda
                           Kirubēl were added in a secondary hand on ff. 26r, 32r, 59r, 76r, 93v, 103v.
                           The following note was found on the inside back cover: "This book was
                           taken from Theodores' camp under Magdala 14 April 1868. Presented to M.
                           Garbios (?), with kind regards, by this finder. 9 Feb 1870. 
                        </item>
                     </list>
                  </additions>
                  <bindingDesc>
                     <binding>
                        <decoNote xml:id="b1">Wooden boards covered with stamped leather</decoNote>
                        <decoNote xml:id="b2">Book accompanied by <material key="leather">leather</material> satchel</decoNote>
                     </binding>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate notBefore="1700" notAfter="1800" calendar="Gregorian">18th
                        cent.</origDate><origPlace>Ethiopia.</origPlace></origin>
                  <provenance>Ethiopia. </provenance>
                  <acquisition>Pr. Cherry, 16 July 1983. According to a note on the inside back cover, the book was taken from
                     Emperor Tewodros's camp at
                     Magdala on <date when="18680414">14 April 1868</date>, and was presented to Mr.
                     Garbios(?) by the "finder" on <date when="18700209">9 February 1870</date>
                  </acquisition>
                 
               </history>
