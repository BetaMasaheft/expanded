                            <textLang mainLang="gez"/>
                            <explicit xml:lang="gez" type="subscriptio">በዝየ፡ ተፈጸመ፡ ራእየ፡ ሕዝቅኤል፡ ነቢይ፡ ጸሎቱ፡ ወበረከቱ፡ የሃሉ፡ ምስለ፡ 
                                ፍቁሩ፡ <hi rend="rubric">
                           <persName ref="https://betamasaheft.eu/PRS11725Mardokyos">መርዶክዮስ፡</persName>
                        </hi> ለዓለመ፡ ዓለም፡ አሜን፡ ወአሜን፡ ለይኩን፡ ለይኩን፨</explicit>
                            <note>Chapters are always indicated by <foreign xml:lang="gez">ምዕራፍ፡</foreign>
                                or <foreign xml:lang="gez">ክ<supplied reason="undefined" resp="PRS4747Goldschm">ፍል፡</supplied>
                        </foreign>, but never numbered.
                            The chapter division differs from the Western one.</note>
