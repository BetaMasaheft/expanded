                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                ሕማመ፡ ዓይነ፡ ጽላ፡ ወፀባ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ዕ</sic>
                                    <corr>ዒ</corr>
                                </choice>ተ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ፀር፡ በአጵርኤል፡ ጽርናኤል፡ አክርኤል፡ ልማኤል፡</incipit>
                            <explicit xml:lang="gez"> ሰድድኤል፡ ኰደኤል፡ በዝ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አስማተ፡ አድኅነኒ፡ እምጋኔን፡
                                ወእማዓይነት፡ ቡዳ፡ ለገብርከ፡ ብሩ፡</explicit>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <title ref="https://betamasaheft.eu/LIT7836PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-qwǝrḍat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                    ሕ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>መ</sic>
                                    <corr>ማ</corr>
                                </choice>መ፡ ዓይነ፡ ጽላ፡ ወ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ቁ</sic>
                                    <corr>ቈ</corr>
                                </choice>ርፀት፡ ዖግ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ዴን፡ ዴግዲ፡ ዲ፡</incipit>
                            <explicit xml:lang="gez"><supplied reason="omitted" resp="bm:GrebTiss1935Codices">በ</supplied> ቃለ፡ አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                    ወወለድ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ወመንፈስ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ቅዱስ፡ አድኅነኒ፡ እም<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ቁ</sic>
                                    <corr>ቈ</corr>
                                </choice>ርፀት፡ ለገብርከ፡ ብሩ፡</explicit>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <title ref="https://betamasaheft.eu/LIT7837PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-ʿĀyna Warq</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                ሕማመ፡ ዓይነ፡ ጽላ፡ ወጽላ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ወጊ፡ ወርእስ፡ <choice resp="bm:GrebTiss1935Codices">
                                    <sic>መ</sic>
                                    <corr>ም</corr>
                                </choice>ትአት፡ ያሸኤር<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ይአኢርር፡ ያሸኢርር፡<gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ግርማኤል፡ አማኑኤል፡
                                አድኅነኒ፡ እምሕማመ፡ ርእሰ፡ ምትአት፡ ለገብርከ፡ ብሩ፡ </incipit>

                        </msItem>
                        <msItem xml:id="ms_i7">
                            <title ref="https://betamasaheft.eu/LIT7838PPrayer">Ṣalot baʾǝnta wǝgʿat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                ውግዓት፡ ዐቀፍር፡ አቀፍር፡ አቀፍር፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ፍለይ፡ ፍለይ፡ ፍለያ፡ አስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አልቦ፡
                                ነገር፡ ዘይሰአኖ፡ ለእግዚአብሔር፡ ወወወወ፡</incipit>

                        </msItem>
                        <msItem xml:id="ms_i8">
                            <title cert="low" ref="https://betamasaheft.eu/LIT2993RepCh274">Ba-sǝma ʾƎgziʾabǝḥer qadāmāwi za-ʾǝnbala tǝmālǝm</title>
                            <textLang mainLang="gez"/>
                            <note>In the middle of the text, there is an additional supplication
                                formula <q xml:lang="gez">አድኅኖ፡ እምሕማመ፡ ምትአት፡ ለገብርከ ተክለ፡ ማርያም፡ ብሩ፡
                                    ነዓ፡ ኀቤየ፡ ኢየሱስ፡ ክርስቶስ፡ ወልደ<supplied reason="omitted">፡</supplied>
                                    እግዚአብሔር፡ ሕያው፡ ወልደ፡ ማርያም<supplied reason="omitted">፡</supplied>
                                    ሥግው፡</q></note>
                        </msItem>
                        <msItem xml:id="ms_i9">
                            <title ref="https://betamasaheft.eu/LIT7923PPMichael">Yǝbe Mikāʾel ba-sǝma ʾEgziʾābḥer</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ይቤ፡ ሚካኤል፡ በስመ፡ እግዚአብሔር፡ ዘኢተዓደወ፡ ትእዛዛቲሁ፡ ዘኀረየ፡
                                በርእሱ፡ ዘንተ፡ ስመ፡ ወበዝንቱ፡ ስም፡ ዘይሰድድከ፡ <choice resp="ESh">
                                    <sic>መዓፈስ፡</sic>
                                    <corr>መንፈስ፡</corr>
                                </choice> ርኩስ፡ እምሥጋሁ፡ ለገብርከ፡ ብሩ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ፃዕ፡ በኃይለ፡ እግዚአብሔር፡ ልዑል፡ ወግሩም፡
                                አሜን፡ ለገብርከ፡ ተክለ፡ ማርያም፡ ብሩ፡</incipit>
                        </msItem>
