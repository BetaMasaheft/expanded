                        <item xml:id="a1_665">
                           <locus target="#1v-2r">-1v-2r</locus>
                           <q xml:lang="ar">Decorated frames for sūrat al-Fātiḥa and the beginning of sūrat al-Baqara</q>
                           <desc>Drawings / Decorations</desc>
                           <note/>
                        </item>
                        <item xml:id="a0_665">
                           <locus target="#Throughout">-Throughout</locus>
                           <q xml:lang="ar">Sūra headings, long a-vowels, taǧwīd, ḥizb (and its halves and quarters), ǧuz' and verse markers (circles) in red. Markers for the eighths in black or red and black. </q>
                           <desc>Drawings / Decorations</desc>
                           <note/>
                        </item>
                        <item xml:id="a2_665">
                           <locus target="#71r">-71r</locus>
                           <q xml:lang="ar">قرات يوم السبت من سورة المائدة الى سورة يونس
</q>
                           <desc>Marginalia</desc>
                           <note/>
                        </item>
                        <item xml:id="a4_665">
                           <locus target="#150r">-150r</locus>
                           <q xml:lang="ar">قال النبي صلعم من قرء سورة هود عليه السلام يخرج من الدنيا كما خرج يحيى ابن زكريا طاهر او مطهل ويكون في الجنة رفيق ط يحيى عليه السلام</q>
                           <desc>Marginalia</desc>
                           <note>
                              <term key="Hadit" ana="#Hadit"/>
                           </note>
