                       <additions>
                           <list>                            
                                  
                               <item xml:id="a1">
                                   <desc type="GuestText"><title type="complete" ref="https://betamasaheft.eu/LIT7766JesusChristWhoseName">ʾIyasus Krǝstos ṭǝʿuma sǝm la-za-yǝṣewwǝʿo</title>The hymn is written in a recent hand.</desc>
                               </item>
                               
                               <item xml:id="a2">
                                   <locus target="#3r"/>
                                   <desc type="OwnershipNote">The note stating that the owning institution is Dabra Ṣarābi; 
                                       the donor name is mamhǝr Takla Giyorgis.</desc>
                               </item>
                               
                               <item xml:id="a3">
                                
                                   <desc type="Genealogy">A extensive genealogy of the lineage of Ṣǝrā, from Ḥebāy 
                                       to Gabra Krǝstos, in Amharic.</desc>
                                   <q xml:lang="am">ኍልቈ፡ ትውልድ፡ ዘጽራ፡ ሔባይ፡ ተለምን፡ ወለደ፡ ተለም፡ ብጸሎትን፡ ወለደ፡ 
                                         በጸሎት፡ ህላዌ፡ ክርስቶስን፡ ህላዌ፡ ክ፡ ኃለፎም፡ ዘለፎምን፡ ወለደ፡ <gap reason="ellipsis" resp="DN"/>
                                       </q>
                                   
                               </item>
                               <item xml:id="v1">
                                   <locus target="#1r"/>
                                   <desc type="Unclear">A pen trial written in the main hand.</desc>
                               </item>
                           </list>
                       </additions>
