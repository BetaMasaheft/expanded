   <summary/>
                     
                    <msItem xml:id="ms_i1">
   <locus from="1r1" to="1r56"/>
                       <title type="complete" ref="https://betamasaheft.eu/LIT7157PPMalkFan">Beginning of Malkǝʾa Fānuʾel</title>
                     <textLang mainLang="gez"/>
                       <note>The <foreign xml:lang="gez">masgabiyā</foreign> of Malkǝʾa Fānuʾel is followed by lengthy additional supplications.</note>
                       <incipit xml:lang="gez">
                          <hi rend="rubric">በስመ፡ አብ፡ ወወልድ<supplied reason="omitted">፡</supplied>
                             ወመንፈስ፡ ቅዱስ፡ ፩ አምላ</hi>ክ፡ ጸሎት፡ በእንተ፡ ዓይነ፡ ጥላ፡ ወመደንግጸ፡ ሰይጣናት፡ ሰላም፡
                          ለተፈጥሮትከሳለ፡ መለኮትከ<supplied reason="omitted">፡</supplied> ኅቡረ፡ እንዘ፡ ኢይከውን፡ ቅድመ፡ ወእንዘ ኢይዴኃር፡ ድኅረ፡ ሰዳዴ፡ አጋንንት፡ 
                       </incipit>
                       <explicit xml:lang="gez">በስመ፡ እግዚአብሔር፡ ልዑል፡ ወዓቢይ ማኅየዊ፡ ዘኢይትወለጥ፡ አልቦ፡ ኃይል፡
                          ወአልቦ፡ ጽንእ፡ ከመ፡ እግዚአብሔር፡ ልዑል፡ ወግሩም፡ እቀባ፡ ወአድኀና፡ ለአመተ፡ እግዚአብሔር፡ <hi rend="rubric"><persName ref="https://betamasaheft.eu/PRS13493Taytu">ጣይቱ፡</persName></hi></explicit>
                  </msItem>   
                  
                  <msItem xml:id="ms_i2">
                     <locus from="1r56" to="1r92"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                     <textLang mainLang="gez"/>
                     <incipit xml:lang="gez">
                        <hi rend="rubric">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ ፩ አምላክ፡ ጸሎ</hi>ት፡ በእንተ፡ ሕማመ፡
                        ባርያ፡ ወደም፡ ፋረጸ፡ የማን፡ ጽጽቅ፡ የአ፡ ሰሃኔ፡ ድ፡ ከምጅጅ፡ ይእዜሰ፡ ወስከርጅ፡ ከማሁ፡ ክትር፡ ወአቅም፡ ውሃዘ፡
                        ደም፡ 
                     </incipit>
                     <explicit xml:lang="gez">
                        ሰንከራም፡ ሰንተከራም፡ ዝንቱ፡ ደም፡ ዘወጽአ፡ እምገቦሁ፡ <hi rend="rubric">ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ከማሁ፡ ትክትር፡ ወአቁም፡
                        ወስ</hi>ተ፡ ደም፡ አመተ፡ እአቀባ፡ ወአድኅና<supplied reason="omitted">፡</supplied> ለአመትከ፡ <hi rend="rubric"><persName ref="https://betamasaheft.eu/PRS13493Taytu">ጣይቱ፡</persName></hi> 
                     </explicit>
                  </msItem>   
                  
                  <msItem xml:id="ms_i3">
                     <locus from="1r93" to="1r125"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                     <textLang mainLang="gez"/>
                     <incipit xml:lang="gez">
                        <hi rend="rubric">ጸሎት፡ በእንተ፡ ሕማመ፡ ደም፡ ቆርቆ<gap reason="illegible"/></hi>ኤል፡
                        ቆርቆታኤል፡ ቆርቆርታኤል<supplied reason="omitted">፡</supplied> ቆርቆርቆርታኤል፡
                     </incipit>
                     <explicit xml:lang="gez">
                        ዘአቀምከ፡ ደማ፡ እንተ፡ ደም፡ ዘይውዝ፡ እም፡ ፲ወ<gap reason="illegible"/> ክረምታ፡ ከማሁ፡ አቁም<supplied reason="omitted">፡</supplied>
                        ወክትር፡ ደማ፡ ሊሰአፍፊስ፡ መሳሌላሊስ፡ መላሊስ፡ መላሌስ፡ መሳልዮስኅ ዘዐርጋዕከ፡ ኃይለ፡ በረድ። ወነፋስ<supplied reason="omitted">፡</supplied> ዘዐርጋዕከ፡ ደመ፡ ትክቶሃ፡ ከማሁ፡ አቁም፡ ደማ፡ ለአመትከ፡ <hi rend="rubric"><persName ref="https://betamasaheft.eu/PRS13493Taytu">ጣይቱ፡</persName></hi>
                     </explicit>
                  </msItem>   
                  
                  <msItem xml:id="ms_i4">
                     <locus from="1r126" to="1r162"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT6609ProtectPrayer">Protective Prayer (general record)</title>
                     <textLang mainLang="gez"/>
                     <incipit xml:lang="gez">
                        <hi rend="rubric">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩ አምላክ፡ ጸሎት፡ በእንተ፡</hi>
                        ድንጋፄ፡ እምብዝኃ፡ ድንድንጋፄ፡ ምንተ፡ ይመስል፡ ፍጥረቶሙ፡ ለናህብት<supplied reason="omitted">፡</supplied>
                        ርኩሳን፡ ወድዩአን፡ ተማኅፀንኩ፡ እቀባ<supplied reason="omitted">፡</supplied> ወአድኅና፡
                        ለአመትከ፡ <hi rend="rubric"><persName ref="https://betamasaheft.eu/PRS13493Taytu">ጣይቱ፡</persName></hi>
                        እምባርያ፡ ጸሊማን፡
                     </incipit>
                     <explicit xml:lang="gez">
                        በ፭ ቅ<hi rend="rubric">ንዋተ<supplied reason="omitted">፡</supplied> መስቀሉ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡</hi>
                        በዝ፡ አስማት፡ አድኅና፡ ለአመትከ፡ <hi rend="rubric"><persName ref="https://betamasaheft.eu/PRS13493Taytu">ጣይቱ፡</persName></hi>
                     </explicit>
                  </msItem>   
                
               </msContents>


