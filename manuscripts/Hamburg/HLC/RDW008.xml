      <t:body>
         
         <t:div type="edition">
            <t:div type="textpart" subtype="recto">
               
               <t:div type="textpart" subtype="section" n="1" xml:id="sec1">
                  <t:div type="textpart" subtype="text" n="1" xml:id="text1part1" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:pb n="1r"/>
                        <t:lb n="1"/><t:hi rend="rubric">በስመ አብ ወወልድ 
                        <t:lb n="2"/>ወመን<t:gap reason="lost"/>ስ ቅዱስ
                        <t:lb n="3"/><t:gap reason="illegible"/> አምላክ ጸ
                        <t:lb n="4"/>ሎት በእንእንተ ሕማ
                        <t:lb n="5"/>መ ዓይነት ወዓነ ዛር
                        <t:lb n="6"/>በስመ እግዚአብሔር</t:hi>
                        <t:lb n="7"/>ሕያ
                     </t:ab>
                  </t:div>
               </t:div>
               
               <t:div type="textpart" subtype="section" n="2" xml:id="sec2">
                  <t:div type="textpart" subtype="picture" n="1" xml:id="pic1" corresp="https://betamasaheft.eu/RDW008#d1"/>
               </t:div>
               
               <t:div type="textpart" subtype="section" n="3" xml:id="sec3">
                  <t:div type="textpart" subtype="text" n="1" xml:id="text1part2" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:lb n="8"/><t:hi rend="rubric">ው ነባቢ ወፈጣሪ ጸሎ
                        <t:lb n="9"/>ቱ ለቅዱስ ሱስንዮስ በ
                        <t:lb n="10"/>እንተ አሳሰሎተ ደዌ
                        <t:lb n="11"/>እምሕፃናት እለ ይጠ
                        <t:lb n="12"/>በው ጥባ እሞሙ ወ
                        <t:lb n="13"/>ይባቁዓ አጺላ ብእሲት
                        <t:lb n="14"/>ፅንሰት ዘኢየሐይው ላቲ
                        <t:lb n="15"/>ሕፃናት ታጽሕፍ ወታ
                        <t:lb n="16"/>ታሰቅሎ ላዕሌሃ ወይ
                        <t:lb n="17"/>በቁዓ በረድየተ እግቡ
                        <t:lb n="18"/>ዚአብሔር ልዑል ወክ
                        <t:lb n="19"/>ቡር ሰሙ እስከ ለዓለ
                        <t:lb n="20"/>መ ዓለም አሚን ጸሎ
                        <t:lb n="21"/>ቱ ወበረከቱ ለቅዱስ
                        <t:lb n="22"/>ሱስንዮስ የሃሉ ምስ
                        <t:lb n="23"/>ፍቁሩ ለዓለመ ዓለ
                        <t:lb n="24"/>ም ዓሜን ወሀሎ ፩
                        <t:lb n="25"/>ብእሲ ዘስሙ ሱስን
                        <t:lb n="26"/>ዮስ ወአወቦ ለብእሲት
                        <t:lb n="27"/>ወወለደ ወልደ ተባዕ
                        <t:lb n="28"/>ተ ወበቀማይ ወል
                        <t:lb n="29"/>ዱ መጽአት ውርዝል
                        <t:lb n="30"/>ያ ወቀተለቶ <t:add place="above">ለወልዳ</t:add> ወሖረት
                        <t:lb n="31"/>ወከልሐት ወአውየወ
                        <t:lb n="32"/>ወትወሶ በስምዓ ቅዱ
                        <t:lb n="33"/>ስ ሱስንዮስ ወይቤላ
                        <t:lb n="34"/>ለምንት ያበክየኪ
                        <t:lb n="35"/>ብእሲ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>
               
               <t:div type="textpart" subtype="section" n="4" xml:id="sec4">
                  <t:div type="textpart" subtype="picture" n="2" xml:id="pic2" corresp="https://betamasaheft.eu/RDW008#d2"/>
               </t:div>
                           
               <t:div type="textpart" subtype="section" n="5" xml:id="sec5">
                  <t:div type="textpart" subtype="text" n="1" xml:id="text1part3" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:lb n="36"/><t:hi rend="rubric">ቶ ወትቤሎ እስመ ዝ
                        <t:lb n="37"/>ልያ መጽአት ወቀተ
                        <t:lb n="38"/>ለቶ ለወልድየ ወሶ
                        <t:lb n="39"/>በ ሰምዓ ቅዱስ ሱስ
                        <t:lb n="40"/>ንዮስ ተፅዕነ ዲበ ፈ
                        <t:lb n="41"/>ረሱ ወነሰሦ አኩናቶ
                        <t:lb n="42"/>ወሖረ መምሥራቅ
                        <t:lb n="43"/>መንገሊሃ፡ ወረከባ ለ 
                        <t:lb n="44"/>አራጊት ነቢራ ላዕለ
                        <t:lb n="45"/>ኖኅት ወይቤላ አይ
                        <t:lb n="46"/>ቲ ሖረት ውርዝልያ ወ
                        <t:lb n="47"/>ትቤሎ ቦአት ውስተ<t:gap reason="illegible"/>
                        <t:lb n="48"/>ነት ዘሀሎ በቅድሜከ
                        <t:lb n="49"/>ወሶቤሃ ሖረ ወረከባ ለ
                        <t:lb n="50"/>ውርዝልያ ነቢራ ላዕለ
                           <t:lb n="51"/>የም ወየአውድዋ ብ
                        <t:lb n="52"/>ዙኃን አጋንንት ወቆ
                        <t:lb n="53"/>መ ላዕሌየ ቅዱስ ሱስ
                        <t:lb n="54"/>ንዮስ ወረደ እምላዕ
                        <t:lb n="55"/>ለ ፈረሱ ወሚጠ ገጾ ሰ
                           <t:lb n="56"/>መንገለ ምሥራቅ ወ
                        <t:lb n="57"/>ገደ በብረኪሁ ወሰፍ
                           <t:lb n="58"/>ሐ እደዊሁ ወሰአለ ኀበ
                        <t:lb n="59"/>እግዚአብሔ እንዘ ይ
                           <t:lb n="60"/>ብል እግዚ እወ አም
                           <t:lb n="61"/>የለኪ የ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>          
               
               <t:div type="textpart" subtype="section" n="6" xml:id="sec6">
                  <t:div type="textpart" subtype="picture" n="3" xml:id="pic3" corresp="https://betamasaheft.eu/RDW008#d3"/>
               </t:div>
               
               <t:div type="textpart" subtype="section" n="7" xml:id="sec7">
                  <t:div type="textpart" subtype="text" n="2" xml:id="text1part4" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:lb n="62"/><t:hi rend="rubric">ኢየሱስ ክርስቶስ አም
                        <t:lb n="63"/>ላኮሙ ለክርስቲያን
                           <t:lb n="64"/>ወንጉሦሙ ለነገሥ
                        <t:lb n="65"/>ት ወሶበ ቦአት ውርዝ
                        <t:lb n="66"/>ልያ ውስተ እደዊ እት
                        <t:lb n="67"/>ምቀልክዎ ከመ ኢ
                        <t:lb n="68"/>ትቅትል ሕፃናተ ወ
                        <t:lb n="69"/>ከመዘ ኢትቅረብ ኀ 
                        <t:lb n="70"/>በ በነፍስየ አንስት
                        <t:lb n="71"/>ወኃበ አምታቲሆን 
                           <t:lb n="72"/><t:add place="above">ወ</t:add>አንሰ አሐውር ወእከ
                        <t:lb n="73"/>ውን ሰማእተ በእንተ 
                        <t:lb n="74"/>ስምከ ቀዱስ ወእን
                        <t:lb n="75"/>ዘ ይስአል ከመዝ ሰ
                        <t:lb n="76"/>ምዓ ቃለ እምሰማ
                        <t:lb n="77"/>ይ እንዘ ይብል ኦሱስ
                        <t:lb n="78"/>ንዮስ ናሁ ተሰምሮ
                        <t:lb n="79"/>ጸሎትከ ወተውበከ 
                        <t:lb n="80"/>ሥልጣን እምነህበ እ 
                        <t:lb n="81"/>ግዚአብሔር ከመ ት
                        <t:lb n="82"/>ንሥአ ለውርዝልያ
                        <t:lb n="83"/>ወትንሥኣ ወትቅት
                        <t:lb n="84"/>ላ ወተግባረ ኩሎ
                        <t:lb n="85"/>ከ ዘፈቀድ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>
                        
               <t:div type="textpart" subtype="section" n="8" xml:id="sec8">
                  <t:div type="textpart" subtype="picture" n="4" xml:id="pic4" corresp="https://betamasaheft.eu/RDW008#d4"/>
               </t:div>
                        
               <t:div type="textpart" subtype="section" n="9" xml:id="sec9">
                  <t:div type="textpart" subtype="text" n="" xml:id="text1part5" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:lb n="86"/><t:hi rend="rubric">ወሶበ ሰምአ ቅዱስ
                        <t:lb n="87"/>ሱስንዮስ ተፅፅነ ዲ
                           <t:lb n="88"/>በ ፈረሱ ወነስአ ኩና
                        <t:lb n="89"/>ት በየማኑ ወረገጸ ገ
                          <t:lb n="90"/> ቦ ሃበ የማኑ የዘየማ
                        <t:lb n="91"/>ን ወይእቲእቲኒ ሰገ
                        <t:lb n="92"/>ደት ቅድሜሁ እንዘ
                        <t:lb n="93"/>ዘትብል እግዚእየ 
                        <t:lb n="94"/>ኢየሱስ ክርስቶስስ
                           <t:lb n="95"/>ወሱስንዮስ አመሕ
                        <t:lb n="96"/>ለከ በ፱ፆታ መዓረ
                        <t:lb n="97"/>ግ ዘሊቃነ መላ ሜካ
                        <t:lb n="98"/>ኤል ወገብርኤል ሱ
                        <t:lb n="99"/>ራፌ ወኪሩቤ  ሱ
                        <t:lb n="100"/>ልሱራኤል ወሩፋ
                        <t:lb n="101"/>ቤልኤል ወኪሩ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>
            </t:div>
            
            <t:div type="textpart" subtype="verso">
               
               <t:div type="textpart" subtype="section" n="10" xml:id="sec10">
                  <t:div type="textpart" subtype="text" n="" xml:id="text1part6" corresp="https://betamasaheft.eu/RDW008#ms_i1">
                     <t:ab>
                        <t:pb n="1v"/>
                        <t:lb n="102"/><t:hi rend="rubric">ኡራኤል ወሩፋኤ
                        <t:lb n="103"/>ል አናንንያ ወአዛር
                        <t:lb n="104"/>ያ ወሚሳኤል እለ እ
                        <t:lb n="105"/>ሙንቱ ይቀውሙ
                           <t:lb n="106"/>ቅድመ እግዚአብ
                           <t:lb n="107"/>ሔር፡ አኃዚ ኩሉ ዘ
                           <t:lb n="108"/>ልፈ እስከ ለዓለመ
                           <t:lb n="109"/>ዓለም ወመሐለት
                           <t:lb n="110"/>ውርዝልያ እስመ በ
                        <t:lb n="111"/>ስመ ሥላሴ ቅዱስ
                        <t:lb n="112"/>ት ከመ ኢትቅረብ</t:hi>
                        <t:lb n="113"/>ኀበ አንስት ወኃበ እዐ
                        <t:lb n="114"/>መታቲሆን ወኀበ
                        <t:lb n="115"/>ኩሎ ዘያፀውር ጽ
                           <t:lb n="116"/>መሐፈ ገጽልክ አእ
                           <t:lb n="117"/>መሃ ተባዕተ ወመ
                           <t:lb n="118"/>ሄ አንስት አው፡ ል
                           <t:lb n="119"/>ሂቅ አው ሕፃን አ
                           <t:lb n="120"/>ው ወሬዛ ወዘሀሎ
                           <t:lb n="121"/><t:hi rend="rubric">በስተ ከርሠ እሙ
                           <t:lb n="122"/>ወቅዱስ ሱስንየስ
                           <t:lb n="123"/>ሰማዕተ ኮነ በእን
                           <t:lb n="124"/>ተ ስመ እግዚእነ
                           <t:lb n="125"/>ኢየሱስ ክርስቶ
                           <t:lb n="126"/>ስ ሎቱ ስብሐት እ
                           <t:lb n="127"/>ስከ ለዓለመ ዓለ
                           <t:lb n="128"/>ም ዓሜን፡ ለአመ
                           <t:lb n="129"/>ትኪ ወለተ ኂሒሂ
                           <t:lb n="130"/>ወትሕ
                           <t:lb n="131"/>የርፋ የርፋ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>
                        
               <t:div type="textpart" subtype="section" n="11" xml:id="sec11">
                  <t:div type="textpart" subtype="picture" n="6" xml:id="pic6" corresp="https://betamasaheft.eu/RDW008#d6"/>
               </t:div>
               
               <t:div type="textpart" subtype="section" n="12" xml:id="sec12">
                  <t:div type="textpart" subtype="text" n="" xml:id="text2" corresp="https://betamasaheft.eu/RDW008#ms_i2">
                     <t:ab>
                        <t:lb n="130"/><t:hi rend="rubric">በስመ አብ ወወል
                        <t:lb n="131"/>ድ ወመንፈስ ቅዱ
                        <t:lb n="132"/>ስ አሐዕ አምላክ
                        <t:lb n="133"/>ጸሎት በእንተ ሕ
                        <t:lb n="134"/>ማመ ዓይነት ባ
                        <t:lb n="135"/>ርያ ወሌጌዎን ዛ
                           <t:lb n="136"/>ር ወቁራኛ ቡዳ
                           <t:lb n="137"/>ወቁመኛ መር
                           <t:lb n="138"/>በብተ ሰሎሞን
                           <t:lb n="139"/>ዘከመ ረበቦ ዘከ</t:hi>
                           <t:lb n="140"/>መ ረበቦሙ ለአጋን
                           <t:lb n="141"/>ንት ከመ መርበብ
                           <t:lb n="142"/>ተ ዓዓሣ ዘባሕር ኤል
                           <t:lb n="143"/>ኪአሰኪና ሚሰአና
                           <t:lb n="144"/>ሚሰአና ምዓስአና
                        <t:lb n="145"/>ሚኤል ዓላ መረቡ
                        <t:lb n="146"/>ዋሊፍ አሊፍ ጸልላ
                        <t:lb n="147"/>እግ<t:hi rend="rubric">ዚኦ በአክናፍ
                        <t:lb n="148"/>እምጸላኢ ወጸ<t:gap reason="illegible"/>
                           <t:lb n="149"/>ፍም ወአም <t:gap reason="illegible"/>
                           <t:lb n="150"/>ምመምሦዣ</t:hi>
                     </t:ab>
                  </t:div>
               </t:div>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>