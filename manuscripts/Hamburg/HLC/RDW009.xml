                                    <t:lb n="71"/>ጸና፡ ሄም
                                    <t:lb n="72"/>ራ ሕፍና፡
                                    <t:lb n="73"/>ማሕጸና፡
                                    <t:lb n="74"/>ሆው ይምጸእ
                                    <t:lb n="75"/>በስምረትከ
                                    <t:lb n="76"/>ደመ፡ ተክቶ
                                    <t:lb n="77"/>ሃ ወልደ ዘን
                                    <t:lb n="78"/>ብለከ፡ ዘይት
                                    <t:lb n="79"/>ዘከር፡ እግ
                                    <t:lb n="80"/>ዚኦ እለ ዘን
                                    <t:lb n="81"/><t:gap reason="illegible"/>ለከ፡ ሔ
                                    <t:lb n="82"/>ት፡ ክፍለለ
                                    <t:lb n="83"/>ወሊድ ወል
                                    <t:lb n="84"/>ደ ዘይበቁዕ
                                    <t:lb n="85"/>ለአመትከ፡
                                    <t:lb n="86"/>ራሕመት የ
                                    <t:lb n="87"/>ፈንታየ ል
                                    <t:lb n="88"/>ጅ ራሕመት</t:hi>
                                       <t:milestone unit="parchmentStrip" n="3"/>
               </t:ab>
                        </t:div>
                              
