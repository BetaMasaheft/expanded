               <t:div type="textpart" subtype="section" n="1" xml:id="sec1">
                        <t:div type="textpart" subtype="text" n="1" xml:id="text1" corresp="https://betamasaheft.eu/RDW009#ms_i1">
               <t:ab>
                  <t:pb n="1r"/>
               <t:lb n="1"/><t:hi rend="rubric">በስመ አብ ወልድ
                  <t:lb n="2"/>ወመንፈስ ቅዱስ
                  <t:lb n="3"/>፩ አምላክ</t:hi>
                  <t:lb n="4"/>ጸሎት በእንተ
                  <t:lb n="5"/>ዓይነ ጥላ ወመ
                  <t:lb n="6"/>ደንግግጸ አጋ
                  <t:lb n="7"/>ንንት ወመደን
                  <t:lb n="8"/>ግጸ ሰይጣናት
                  <t:lb n="9"/>ሰላም፡ ለተፈ
                  <t:lb n="10"/>ጥሮትከ ም
                  <t:lb n="11"/>ስለ መላእክ
                  <t:lb n="12"/>ት ሕቡረ እን
                  <t:lb n="13"/>ዘ ኢይከውን
                  <t:lb n="14"/>ቅድመ ወእን
                  <t:lb n="15"/>ዘ ኢይዴኅር
                  <t:lb n="16"/><t:gap reason="illegible"/>ድኅረ፡ ሰዳ
                  <t:lb n="17"/>ዴ አጋንንት፡
                  <t:lb n="18"/>ፋኑኤል፡ እም
                  <t:lb n="19"/>ላእለ ፍጡሩ
                  <t:lb n="20"/>ን ወትረ ሰድ
                  <t:lb n="21"/>ዶሙ ለአጋን
                  <t:lb n="22"/>ንት ወአርእ
                  <t:lb n="23"/>ዮሙ ሐሰረ ከ
                  <t:lb n="24"/>መ፡ ኢይግበሩ
                  <t:lb n="25"/>ኪያየ ማሕ
                  <t:lb n="26"/>ደረ አድኅና
                  <t:lb n="27"/>ወእቀባ፡ ለአመ
                  <t:lb n="28"/>ትከ፡ <t:persName role="owner" ref="https://betamasaheft.eu/PRS13479Rahmat">Rāḥmāt<t:hi rend="rubric">ራሕማት</t:hi></t:persName>
               </t:ab>
                        </t:div>
                  
                  <t:div type="textpart" subtype="text" n="2" xml:id="text2" corresp="https://betamasaheft.eu/RDW009#ms_i2">
                     <t:ab>
                        <t:lb n="29"/>ጸሎት፡ በእ
                        <t:lb n="30"/>ንተ ዓይነ ጥላ
                        <t:lb n="31"/>ወመስጥመ፡
                        <t:lb n="32"/>አጋንንት፡ ዘአ
                        <t:lb n="33"/>ሰሞሙ ለእ
                        <t:lb n="34"/>ስክንድር ን
                        <t:lb n="35"/>ጉሥ፡ አጋንን
                        <t:lb n="36"/>ት ንጉሠ ቀለይ
                        <t:lb n="37"/>ወምድር ወ
                        <t:lb n="38"/>ባሕር ኢይ
                        <t:lb n="39"/>ራፎን ውል
                        <t:lb n="40"/>ዊት፡ ለአብ
                        <t:lb n="41"/>ኤልክሥ፡ በኤ
                        <t:lb n="42"/>ል፡ ለአብኤል
                        <t:lb n="43"/>ክስ፡ በኤል ሰ
                        <t:lb n="44"/>አብኤልክስ፡ በ
                        <t:lb n="45"/>ኤል፡ አማኑኢ
                        <t:lb n="46"/>ል አማኑኢል፡
                        <t:lb n="47"/>አማኑኢል፡ ዘ
                        <t:lb n="48"/>ተደመራ ለእ
                        <t:lb n="49"/>ለተ እሁድ ዘተ
                        <t:lb n="50"/>ደመራ ለእለተ እ
                        <t:lb n="51"/>ኁድ <t:add place="above"><t:hi rend="rubric">ሰሉስ</t:hi></t:add> ዘተደመራ
                        <t:lb n="52"/>ለእለተ ረቡዕ፡ ዘ
                        <t:lb n="53"/>ተደመራ ለእለተ
                        <t:lb n="54"/>ሐሙስ ዘተደመ
                        <t:lb n="55"/>ራ፡ ለእለ፡ ዓርብ፡
                        <t:lb n="56"/>ዘተደመራ፡
                        <t:lb n="57"/>ለእለተ ቀዳሚት
                        <t:lb n="58"/>ሂጥ ተመይጥ፡
                        <t:lb n="59"/>እምላእለ፡ አ
                        <t:lb n="60"/>መትከ፡ <t:persName role="owner" ref="https://betamasaheft.eu/PRS13479Rahmat">ራሕመ<t:add place="above">ት</t:add></t:persName>
                        <t:milestone unit="parchmentStrip" n="2"/>
                     </t:ab>
                  </t:div>
               </t:div>
                     
                     
                           <t:div type="textpart" subtype="section" n="2" xml:id="sec2">
                              <t:div type="textpart" subtype="text" n="3" xml:id="text3" corresp="https://betamasaheft.eu/RDW009#ms_i3">
                                 <t:ab>
                                    <t:lb n="61"/><t:hi rend="rubric">በስመ አብ ወ
                                    <t:lb n="62"/>ወልድ ወመን
                                    <t:lb n="63"/>ፈስ ቅዱስ ፩
                                    <t:lb n="64"/>አምላክ፡ ጸ
                                    <t:lb n="65"/>ሎት በእንተ
                                    <t:lb n="66"/>ዓይነ ጥላ ሕ
                                    <t:lb n="67"/>ማመ ጽንእ
                                    <t:lb n="68"/>አሌፍ ስሞ
                                    <t:lb n="69"/>ኮ አርግስይ
