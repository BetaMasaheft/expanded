                    <msContents>
                        <msItem xml:id="ms_i1">
                            <locus from="5r" to="193ra"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT2001Mazmur">Mazmura fǝśśuḥān wa-ṣalota tǝkkuzān</title>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> መዝሙረ፡ ፍሡሓን፡ ወጸሎተ፡ ትኩዛን፡ ዘአስተጋብአ፡ ብእሲ፡ ምስኪን፡ 
                                ዘውእቱ፡ ጸያፍ፡ ወላዕላዐ፡ ልሳን፡ ትሑት፡ በውስተ፡ ሕዝብ፡ ወኀበ፡ ሰብእ፡ ምኑን፡ ዝውእቱ፡ ውዳሴ፡ 
                                ሰማያውያን፡
                            </incipit>
                            <incipit xml:lang="gez">
                                ማኅበረ፡ መላእክት፡ ወሰብእ፡ ተዓይነ፡ ክርስቶስ፡ ወእሙ፡ ሰላም፡ ለክሙ፡ ሶበ፡ እከሥት፡ አፉየ፡ 
                                ለውዳሴክሙ፡ <gap reason="ellipsis"/>
                            </incipit>
                            <incipit xml:lang="gez">
                                ሰላም፡ ለአብ፡ ወለወልድ፡ ቃሉ፡ 
                                ወለመንፈስ፡ ቅዱስ፡ ሰላም፡ ዘአካሎሙ፡ አካሉ፡ 
                                ለማርያም፡ ሰላም፡ እንተ፡ ተሳተፈት፡ ስምሐተ፡ እሉ፡ 
                                ሰላም፡ ለመላእክት፡ ወለማኅበረ፡ ኵሉ፡ 
                                ጽሑፋነ፡ መልክዕ፡ ወስም፡ በሰማይ፡ ዘላዕሉ፡ 
                            </incipit>
                            <explicit xml:lang="gez">
                                
                            </explicit>
                            
