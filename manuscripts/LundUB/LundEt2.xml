                        <msItem xml:id="ms_i2">
                            <locus from="193r" to="193v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT5069Prayer">Saʾalnāka maḥari saʾalnāka faṭāri</title>
                            
                            <incipit xml:lang="gez">
                                ሰአልናከ፡ መሓሪ፡ ሰአልናከ፡ ፈጣሪ፡ ሰአልናከ፡ ዘኢትከልእ፡ ወዘኢትሌሊ፡ የማንከ፡ ነቅዐ፡ ሕይወት፡ 
                                የማንከ፡ ፈልፈለ፡ ፍሥሓ፡ ወሐሤት፡ <gap reason="ellipsis"/>
                                ፈኑ፡ እዴከ፡ ጽንዕ<sic resp="PRS6337Lofgren">ት</sic>፡ ወመዝራዕትከ፡ 
                                ልዕል<sic resp="PRS6337Lofgren">ት</sic>፡ ይብልዑ፡ አግብርቲከ፡ ርኁባን፡ 
                                ወይስትዩ፡ አግብርቲከ፡ ጽሙኣን፡ <gap reason="ellipsis"/>
                            </incipit>
                        </msItem>
                            
                        <msItem xml:id="ms_i3">
                            <locus from="193v" to="200va"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT2384Taamme">Taʾammǝra Māryām</title>
                            
                            <msItem xml:id="ms_i3.1">
                                <locus from="193v" to="195v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3584Intro">Introductive exhortation to the Taʾammǝra Māryām</title>
                                <note>
                                    <bibl><ptr target="bm:Loefgren1974Katalog"/><citedRange unit="page">150</citedRange></bibl>
                                    writes that the manuscripts contains material “from the introduction” to the 
                                    <ref type="work" corresp="https://betamasaheft.eu/LIT2384Taamme">Taʾammǝra Māryām</ref>, perhaps indicating that the 
                                    <ref type="work" corresp="https://betamasaheft.eu/LIT3584Intro">Introductive exhortation to the Taʾammǝra Māryām</ref> is incomplete
                                    (or that, in his perception, it constitutes only a part of the introduction
                                    to <ref type="work" corresp="https://betamasaheft.eu/LIT2384Taamme">Taʾammǝra Māryām</ref>).
                                </note>
                            </msItem>
                            
