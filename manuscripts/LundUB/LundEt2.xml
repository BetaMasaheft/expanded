    </teiHeader><t:text xmlns:t="http://www.tei-c.org/ns/1.0" xml:base="https://betamasaheft.eu/">
        <t:body>
            <t:div type="edition" xml:lang="gez" xml:id="div1LundEt2">
                <t:div type="textpart" xml:id="intro">
                    <t:lg>
                        <t:l n="1">በስመ፡ ቀዳማዊ፡ አምላክ፡ ወድኅረ፡ ዓለማት፡ ሀላዊ፡</t:l>
                        <t:l n="2">እንበለ፡ ተሐውኮ፡ ኅዳጠ፡ እመንበረ፡ መንግሥት፡ መለኮታዊ፡</t:l>
                        <t:l n="3">ውዳሴ፡ መልክዕከ፡ ንንግር፡ በመድበለ፡ ካህናት፡ ደቂቀ፡ ሌዊ፡</t:l>
                        <t:l n="4">ይርከበነ፡ ለውሉድከ፡ በረከትከ፡ ሣህላዊ፡</t:l>
                        <t:l n="5">እንድርያኖስ፡ አቡነ፡ <t:supplied reason="omitted" resp="PRS6337Lofgren">ጳ</t:supplied>ውሎስ፡ ዕብራዊ፡</t:l>
                    </t:lg>
                </t:div>
                <t:div type="textpart" xml:id="stanza1">
                    <t:lg>
                        <t:l n="1">ሰላም፡ ለፅን<t:supplied reason="undefined" resp="PRS6337Lofgren">ሰ</t:supplied>ትከ፡ 
                            ውስተ፡ ከር<t:supplied reason="undefined" resp="PRS6337Lofgren">ሠ</t:supplied>፡ ኅሪት፡ ማርያም፡</t:l>
                        <t:l n="2"><t:supplied reason="undefined" resp="PRS6337Lofgren">ለብ</t:supplied>ራተ፡ 
                            መልአ<t:supplied reason="undefined" resp="PRS6337Lofgren">ክ፡ በ</t:supplied>ልደትከ፡ ሰላም፡</t:l>
                        <t:l n="3"><t:supplied reason="undefined" resp="PRS6337Lofgren">እን</t:supplied>ድርያኖስ፡
                            ሲኖ<t:supplied reason="undefined" resp="PRS6337Lofgren">ዳ፡ በብ</t:supplied>ሕታዌከ፡
                            ፍጹ<t:supplied reason="undefined" resp="PRS6337Lofgren">ም</t:supplied>፡</t:l>
                        <t:l n="4"><t:supplied reason="undefined" resp="PRS6337Lofgren">አ</t:supplied>ስተባሪ<t:choice><t:sic>ዐ</t:sic><t:corr resp="PRS6337Lofgren">የ</t:corr></t:choice>ከ፡ 
                            ደ<t:supplied reason="undefined" resp="PRS6337Lofgren">ብረ፡ ሊ</t:supplied>ባኖስ፡ እም፡</t:l>
                        <t:l n="5">ወ<t:supplied reason="undefined" resp="PRS6337Lofgren">ፈሊ</t:supplied>ሰከ፡ አስቄጥስ፡
                            <t:supplied reason="undefined" resp="PRS6337Lofgren">ገ</t:supplied>ዳም፡</t:l>
                    </t:lg>
                </t:div>
                <t:div type="textpart" xml:id="stanza2">
                    <t:lg>
                        <t:l n="1">ሰላም፡ ለዝ<t:supplied reason="undefined" resp="PRS6337Lofgren">ክረ፡ </t:supplied>ስምከ፡
                            እንተ፡ ተ<t:supplied reason="undefined" resp="PRS6337Lofgren">ጽሕፈ፡ </t:supplied>ውስቴቱ፡</t:l>
                        <t:l n="2">ፊደላተ፡ <t:supplied reason="undefined" resp="PRS6337Lofgren">ሞ</t:supplied>ገስ፡ 
                            ወጸጋ፡ ዘኊላ<t:supplied reason="undefined" resp="PRS6337Lofgren">ቌ፡ አዝማ</t:supplied>ን፡ ፯፡</t:l>
                        <t:l n="3">እንድርያኖስ፡ <t:supplied reason="undefined" resp="PRS6337Lofgren">ጴ</t:supplied>ጥሮስ፡ 
                            ለቆርኔሊ<t:supplied reason="undefined" resp="PRS6337Lofgren">ዮ</t:supplied>ስ፡ አመ፡ ዕብራቱ፡</t:l>
                        <t:l n="4"><t:supplied reason="undefined" resp="PRS6337Lofgren">ዘ</t:supplied>ወረደ፡ እምሰማያት፡ 
                            <t:supplied reason="omitted" resp="PRS6337Lofgren">ሞ</t:supplied>ታሕተ፡ ራእይ፡ ሎቱ፡</t:l>
                        <t:l n="5">ስዕለ፡ እንስሳ፡ ወአራ<t:supplied reason="undefined" resp="PRS6337Lofgren">ዊት፡ </t:supplied>ዘተስዕለ፡ ቦቱ፡</t:l>
                    </t:lg>
                </t:div>
                <t:div type="textpart" xml:id="stanza41">
                    <t:lg>
                        <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ግንዘተ፡ አርሳኒ፡ ዘተሳተፈ፡</t:l>
                        <t:l n="2">ወለመቃብሪከ፡ ባቲ፡ እንተ፡ ረሰይከ፡ ምዕራፈ፡</t:l>
                        <t:l n="3">እንድርያኖስ፡ ፈለስከ፡ እንዘ፡ ታተሉ፡ አእላፈ፡</t:l>
                        <t:l n="4">ገነት፡ ኀበ፡ ተርኅወ፡ ወዘርቤተ፡ ዕረፍት፡ ተነጽፈ፡</t:l>
                        <t:l n="5">ምስለ፡ ነፍሰ፡ ጻድቃን፡ አኀው፡ ከመ፡ ትንበር፡ ዘልፈ፡</t:l>
                    </t:lg>
                </t:div>
                <t:div type="textpart" xml:id="end">
                    <t:lg>
                        <t:l n="1">ለዘበስምረት፡ አቅረብኩ፡ አምኃ፡ መኃልይ፡ እንግዳ፡</t:l>
                        <t:l n="2">ለስምከ፡ ዐቢይ፡ አምሳለ፡ ስመ፡ ኪሮስ፡ ወሲኖዳ፡</t:l>
                        <t:l n="3">እንድርያኖስ፡ ሀበኒ፡ ዐስበ፡ ማኅሌትየ፡ ካዕብተ፡ ፍዳ፡</t:l>
                        <t:l n="4">ሰብእሰ፡ ተዐውቀ፡ አኮኑ፡ በአስቆሮታዊ፡ ይሁዳ፡</t:l>
                        <t:l n="5">ከመ፡ ሀይማኖቶ፡ ይሠይጥ፡ በብሩር፡ ፀዐዳ፡</t:l>
                    </t:lg>
                </t:div>
            </t:div>
        </t:body>
    </t:text></TEI>