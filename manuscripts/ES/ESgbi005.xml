                  <summary/>
                  
                  <msItem xml:id="ms_i1">
                        <locus from="2r" to="124v"/>
                        <title ref="https://betamasaheft.eu/LIT1097Ammest">ʾAmmǝstu ʾaʿmāda mǝśṭir</title>
                     <note>The text contains linguistic features characteristic of so-called Old Amharic.</note>
                        <textLang mainLang="am"/>
                        
                        <msItem xml:id="ms_i1.1">
                           <locus from="2r" to="5v"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#Introduction">ʾAmmǝstu ʾaʿmāda mǝśṭir: Introduction to the Five
        Pillars of Mystery</title>
                           <incipit xml:lang="gez"><hi rend="rubric">በስመ፡</hi> <gap reason="ellipsis" xml:lang="gez"/> እጽሕፍ፡ ነገረ፡ ሃይማኖት፡ ዘተናገርዎ፡ አበው፡ ሐዋርያት፡ ፫፻<add place="above">ወ</add>፲፰፡ ርቱዓነ፡ ሃይማኖት፡ ወእለ፡ ተርፉ፡ ሊቃውንት፡ <gap reason="ellipsis" xml:lang="gez"/>
                              የሃይማኖትን፡ ነገር፡ እናገራለሁ፡ ሃይማኖት፡ <add place="above">ማለት፡</add> ምን፡ ማለት፡ ነው፡ ቢሉ፡ የክርስ<add place="above">ቲ</add>ያን፡ <gap reason="ellipsis" xml:lang="gez"/></incipit> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.2">
                           <locus from="6r" to="20v"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#Trinity">ʾAmmǝstu ʾaʿmāda mǝśṭir: Mystery of the Trinity (ምሥጢረ፡
        ሥላሴ፡)</title>
                           <incipit xml:lang="am"><hi rend="rubric">ምሥጢረ፡ ሥላሴስ፡ ይቀድማል፡ አልኸኝ</hi>ና፡ ምሥጢረ፡ ሥስላሴ፡ እንዴት፡ ነው፡ ቢሉ። እ<hi rend="rubric">ግዚአብሔር፡ አንድ፡</hi> ሦስት፡ ይኾናል፡፡ አንድ፡ ሲኾን፡ ሦስት። ሦስት፡ <add place="left">ሲኾን፡</add>፡ አንድ፡ መኾን፡ እንዴት፡ ይቻላል። 
                              ብሉ፡ ስንኳን፡ ፈጣሪ፡ ፍጡራን፡ ፀሐይ፡ እሳት፡ ባሕር፡ ነፍስ፡ አንድም፡ ሦስትም፡ ይኾናሉ። <gap reason="ellipsis" xml:lang="gez"/></incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.3">
                           <locus from="20v" to="50r"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#Incarnation">ʾAmmǝstu ʾaʿmāda mǝśṭir: Mystery of the Incarnation
        (ምሥጢረ፡ ሥጋዌ፡)</title>
                           <incipit xml:lang="am"><hi rend="rubric">ጥንቱን፡ እግዚአብሔር፡ ለአዳም፡ አም</hi>ስት፡ ሺኽ፡ ካምስት፡ መቶ፡ አመት፡ ሲፈ<hi rend="rubric">ጸም፡ ከልጂህ፡ ልጅ፡ ተወልጄ፡ በሜዳ</hi>ህ፡ ድኄ፡ ሕማማተ፡ መስቀል፡ ታግሼ፡ ለ<hi rend="rubric">ቤዛ፡ ዓለም፡ ደሜን፡ አፍስሴ፡ አድንኅ፡</hi> አለኹ፡ ብሎ፡ ተስፋ፡ ሰጥቶት፡ ነበረ፡ ይላሉ፡ 
                              <hi rend="rubric">የተጋናረውን፡ ያይረሳ፡ የሰጠ</hi>ውን፡ ተስፋ፡ ያይነሳ፡ እግዚአብሔር። <gap reason="ellipsis" xml:lang="gez"/></incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.4">
                           <locus from="50r" to="78v"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#BaptismMystery">ʾAmmǝstu ʾaʿmāda mǝśṭir: Mystery of the Baptism,
        ምሥጢረ፡ ጥምቀት፡)</title>
                           <note>The texts concerns the baptism of Jesus Christ from fol. 58vb</note>
                           <incipit xml:lang="am"><hi rend="rubric">ጥንቱን፡ እግዚአብሔር፡ በልቡ፡ የመ</hi>ከረውን፡ በነቢያት፡ ትንቢት፡ ያናገረውን፡ በሱባዔ፡ ያስቈ<hi rend="rubric">ፀረውን፡ ለመፈጸም፡ ሥጋ፡ ሲ</hi>ለብስም፡ ተፀንሠ፡ በከርሥ፡ ወልደቱ፡ ተዓውቀ፡ እመንፈስ፡ ቅዱስ፡ እንዳለ፡ 
                              <hi rend="rubric"> ወንጌል፡ አምላክ፡ ከሳማየ፡ ሰማያት፡ ወርዶ፡ 
                                 በማ<add place="above">ኅ</add>ፀ</hi>ነ፡ <add place="above">እ<hi rend="ligature">ግዝ</hi> እትነ፡</add> ማርያም፡ <add place="above">ተፀነሠ።</add><gap reason="ellipsis" xml:lang="gez"/></incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.5">
                           <locus from="78v" to="94v"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#Eucharist">ʾAmmǝstu ʾaʿmāda mǝśṭir: Mystery of the Eucharist (ምሥጢረ፡
        ቍርባን፡)</title>
                           <incipit xml:lang="am"><hi rend="rubric">ምሥጢረ፡ ጥምቀትስ፡ ነገርኸኝና፡</hi> ምሥጢረ፡ ቁርባን፡ እንዴት፡ ነው፡ ቢሉ። ወእምዝ፡ ወሰዶ፡ መንፈስ፡ ገዳመ፡ ዳለ። <hi rend="rubric">ወንጌል</hi>። 
                              ኸተጠመቀ፡  በኋላ፡ አልዋለም፡ አላደረም፡ ቆሮቶስ፡ የሚሉት፡ ገዳም፡ ገባ፡ ገብቶም፡ ወጾመ፡ እግዚእነ፡ <hi rend="rubric">ኢየሱስ፡ ክርስቶስ፡</hi> <gap reason="ellipsis" xml:lang="gez"/></incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.6">
                           <locus from="94v" to="124v"/>
                           <title ref="https://betamasaheft.eu/LIT1097Ammest#Resurrection">ʾAmmǝstu ʾaʿmāda mǝśṭir: Mystery of the Resurrection
        (ምሥጢረ፡ ትንሣኤ፡)</title>
                           <incipit xml:lang="am"><hi rend="rubric">ምሥጢረ፡ ቁር<supplied reason="omitted">ባ</supplied>ን</hi><surplus>ን</surplus>ስ፡ ነገርኸኝና፡ ም<hi rend="rubric">ሥጢረ፡ ትንሣኤ</hi>፡ ሙታን፡ እንዴት፡ <hi rend="rubric">ነው፡ ቢሉ፡ ወእን</hi>ዘ፡ ይዴረሩ፡ ቦአ፡ ሰይጣን፡ ውስተ፡ ልበ፡ ይሁዳ፡  አስቆሮታዊ፡ ዳለ። 
                              <hi rend="rubric"> ሥጋ</hi>ውን፡ <hi rend="rubric">ደሙ</hi>ን፡ ከሰጣቸው፡ በኋላ፡ በይሁዳ፡ ልብ፡ ሰይጣን፡ ገባ። <hi rend="rubric">ጌታ</hi>ውን ያስያዘው፡ ቀድሞ፡ ገብቶበት፡ አይደለን፡ ቢሉ። <gap reason="ellipsis" xml:lang="gez"/></incipit>
                        </msItem>
                  </msItem>
