               <history>
                  <origin>
                     <origPlace>
                        <placeName ref="https://betamasaheft.eu/INS0174MAKM">Māy ʾAnbasā Dabra Gannat Kidāna Mǝḥrat</placeName>
                     </origPlace>
                     
                     <origDate notBefore="1850" notAfter="1930">According to <ref target="#coloph1"/>, the manuscript was donated to <placeName ref="https://betamasaheft.eu/INS0174MAKM">Māy ʾAnbasā</placeName>
                        in <date calendar="ethiopian" when-custom="1923" notBefore="1930" notAfter="1931">1923 A.M., that is, 1930/31 A.D.</date>.</origDate>
                  </origin>
                  <provenance>In <ref target="#coloph1"/> and <ref target="#a1"/>, <persName role="donor" ref="https://betamasaheft.eu/PRS15436GabraHeywat"><roleName type="title">ʾAbbā</roleName> Gabra Ḥǝywat</persName> is mentioned as the donor. 
                     <persName ref="https://betamasaheft.eu/PRS15438GabraMaryam"><roleName type="title">ʾAbuna</roleName> Gabra Māryām</persName> is mentioned in the supplication formulas. He is possibly the same person as in manuscripts <ref type="mss" corresp="https://betamasaheft.eu/ESmakm002#a2">ʾƎndartā, Māy ʾAnbasā Dabra Gannat Kidāna Mǝḥrat, C4-IV-9:   additio a2</ref> and 
                     <ref type="mss" corresp="https://betamasaheft.eu/ESmakm007#a3">ʾƎndartā, Māy ʾAnbasā Dabra Gannat Kidāna Mǝḥrat, C4-IV-65:   additio a3</ref>. 
                     <persName ref="https://betamasaheft.eu/PRS15439GabraEgziab"><roleName type="title">ʾAbuna</roleName> Gabra ʾƎgziabǝḥer</persName> and <persName ref="https://betamasaheft.eu/PRS15440ZaraBuruk"><roleName type="title">ʾAbuna</roleName> Zarʾā Buruk</persName> are mentioned in the supplication
                     formula on <locus target="#54rb"/>, and <persName ref="https://betamasaheft.eu/PRS15441WalattaMadhen"> Walatta Madḫǝn</persName> in a supplication formula on <locus target="#58vb"/>.</provenance></history>
