                  <bindingDesc>
                     <binding contemporary="true">
                        <decoNote xml:id="b1">Two wooden boards.</decoNote>
                        <decoNote xml:id="b2" type="Cover">Reddish-brown tooled leather cover, <term key="tooling" ana="#tooling">blind-tooled ornament on the brown leather cover and on the turn-ins</term> 
                           (at least 5 tools were used: <term key="doubleCircle" ana="#doubleCircle">double circle</term>, <term key="doubleStraightLine" ana="#doubleStraightLine">double line fillet</term>, <term key="crissCross" ana="#crissCross"> crisscross</term>,
                           interlaced line fillet, double sine wave with dots); overback made of reddish-brown leather laced with a cord;
                           <term key="textileInlay" ana="#textileInlay">textile inlays</term></decoNote>
                        <decoNote xml:id="b3" type="Sewing">Two pairs of sewing stations.</decoNote>
                        <decoNote xml:id="b4" type="SewingStations">4</decoNote> 
                        <decoNote xml:id="b5" type="Endbands">Present.</decoNote>
