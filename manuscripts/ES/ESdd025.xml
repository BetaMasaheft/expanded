               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i1">
                     <locus from="3ra" to="215rb"/>

                     <title ref="https://betamasaheft.eu/LIT2375Synaxa#SecondHalf">Sǝnkǝsār (General record): Second half of the year</title>                     
                     <note>The commemorative notes are followed by salām-hymns which are grouped at the end of each day.</note>
                     
                     
                     <msItem xml:id="ms_i1.1">
                        <locus from="3ra" to="36rb"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Maggabit">Sǝnkǝsār (General record): Commemorative notices for the month of Maggābit</title>
                        <explicit type="subscriptio"><locus target="#36rc"/>
                        ተፈጸመ፡ በዝየ፡ ዘይትነበብ፡ በወርኀ፡ መጋቢት፡ በሰላመ፡ እግዚአብሔር፡ አብ፡ ዓሜን።</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.2">
                        <locus from="36va" to="62rc"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Miyazya">Sǝnkǝsār (General record): Commemorative notices for the month of Miyāzyā</title>
                        <explicit type="subscriptio"><locus target="#62rc"/>
                           ተፈጸመ፡ ወርኀ፡ ቡሩክ፡ ሚያዝያ፡ በስብሐተ፡ እግዚአብሔር፡ ወኵሉ፡ ዝፈጽመኒ፡ በድኅና፡ ለዓለመ፡ ዓለም፡ ዓሜን።
                        </explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.3">
                        <locus from="62va" to="96vc"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Genbot">Sǝnkǝsār (General record): Commemorative notices for the month of Gǝnbot</title>      
                        <explicit type="subscriptio"><locus target="#96vc"/>
                        ተፈጸመ፡ ወርኀ፡ ግንቦት፡ በሥምረተ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ለዓለመ፡ ዓለም፡ ዓሜን።
                        </explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.4">
                        <locus from="97ra" to="129rb"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Sane">Sǝnkǝsār (General record): Commemorative notices for the month of Sane</title>
                        <explicit type="subscriptio"><locus target="#129rc"/>
                           ተፈጸመ፡ ወርኀ፡ ሰኔ፡ ቡሩክ፡ ስብሐት፡ ለእግዚአብሔር፡ ወላዕሌነ፡ ይኩን፡ ሣህሉ፡ ወምሕረቱ። ለዓለመ፡ ዓለም፡ ዓሜን።
                        </explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.5">
                        <locus from="129rc" to="174vc"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Hamle">Sǝnkǝsār (General record): Commemorative notices for the month of Ḥamle</title>
                        <explicit type="subscriptio"><locus target="#174vc"/>
                           ተፈጸመ፡ ወርኀ፡ ሐምሌ፡ ቡሩክ፡ በሰላመ፡ እግዚአብሔር፡ ዓሜን።
                        </explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.6">
                        <locus from="175ra" to="208vb"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Nahase">Sǝnkǝsār (General record): Commemorative notices for the month of Naḥāse</title>
                        <explicit type="subscriptio"><locus target="#208vb"/>
                           ተፈጸመ፡ ወር፡ ነሐሴ፡ ቡሩክ፡ በሰላመ፡ እግዚአብሔር፡ ዓሜን።
                        </explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.7">
                        <locus from="208vb" to="215rb"/>
                        <title ref="https://betamasaheft.eu/LIT2375Synaxa#Pagwemen">Sǝnkǝsār (General record): Commemorative notices for the month of Ṗagʷǝmen</title>                        
                        <explicit type="subscriptio"><locus target="#215rb"/>
                           ተፈጸመ፡ መጽሐፈ፡ ስንክሳር፡ በሥምረቱ፡ ለእግዚአብሔር፡ ዘአፈጸመኒ፡ በ<sic>ደ</sic>ኅና፡ ይትዓኩት፡ ወ<add place="above">ይ</add>ሰባሕ፡ ስሙ፡ ለእግዚአብሔር።
                        </explicit>
                     </msItem>                     
                  </msItem>
                  
