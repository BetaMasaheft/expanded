                  <handDesc>
                     
                     <handNote xml:id="h1" script="Ethiopic">
                        <locus from="3r" to="23v"/>,  <locus from="135v" to="149r"/>
                        <seg type="script">Second half of the eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <desc>Fine;  letters with pronounced serifs, slanted at somewhat different angles.</desc>
                     </handNote>
                     
                     <handNote xml:id="h2" script="Ethiopic">
                        <locus from="24r" to="134r"/>
                        <seg type="script">Second half of the eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <desc>Fine and careful; ‘squeezed’, thick letters.</desc>
                     </handNote>
                     
                     <handNote xml:id="h3" script="Ethiopic">
                        <seg type="script">Second half of the eighteenth-century script.</seg>
                        <seg type="ink">Red.</seg>
                        <desc>Fine and careful. The scribe was responsible for rubrication.</desc>
                        <seg type="rubrication">Divine names; 1st, 3rd, 5th, 6th, 16th and 17th lines of the opening page; titles of the paragraphs, chapters, discourses
                           and prayers; the 1st and 3rd lines of the prayer on <locus target="#2r"/>; elements of punctuation signs.</seg>
                     </handNote>
                  </handDesc>
          
                  <additions>
                     <list>
                        <item xml:id="a1">
                           <locus target="#2r"/>
                           <desc type="ScribalSupplication">Scribe’s exhortation to the Lord. The note is written in <ref target="#h1">Hand 1</ref>.</desc>
                           <q xml:lang="gez"><hi rend="rubric">ለዛቲ፡ ብርዕየ፡ ዘወጠንክዋ፡</hi> አሥምራ፡ እግዚኦ፡ ወአሠንያ፡
                              <hi rend="rubric">ወአፈጽመኒ፡ በዳህና፡ ወበሰላወጳው<supplied reason="omitted" resp="MK">ም፡</supplied></hi></q>
                           <quote xml:lang="en">This pen of mine which I have begun [to use], accept
                              it o Lord and beautify it and help me finish it [my work] in wellness and peace.</quote>
                        </item>
                        <item xml:id="e1">
                           <desc>The title of the work is written on the front board.</desc> </item>
