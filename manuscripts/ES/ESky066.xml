               <msContents>
                  <summary/>

                  <msItem xml:id="ms_i1">
                     <locus from="3ra" to="39va"/>
                     <title ref="https://betamasaheft.eu/LIT6063Ananya">Hagiographic Dossier of St ʾAnānyā</title>
                     <msItem xml:id="ms_i1.1">
                        <locus from="3ra" to="28rb"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1419GadlaA">Gadla ʾAnānyā</title>
                        <note>With shorter incipit than <ref type="mss" corresp="https://betamasaheft.eu/ANLcr90">Rome, Biblioteca dell’Accademia Nazionale dei Lincei, Conti Rossini 90</ref>.</note>
                        <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> በስመ፡ እግዚአብሔር፡ ወልደ፡ ዋሕድ፡ ወበስመ፡ እግዚአብሔር፡ ጰራቅሊጦስ፡ ዋኅድ። ህላዌ፡ 
                           ትስብዕቱ፡ ዘኢይትበዓድ። <gap reason="ellipsis"/> ንጽሕፍ፡ ዜና፡ ገድሉ፡ ለአቡነ፡ አናንያ፡ ሰማዕት፡ ወሐዋርያ፡ እምብዕል፡ ለንዲት፡ ዛኃረያ፤ ወለሰብእናሁ፡
                           ዘአንደያ።</incipit>
                        <textLang mainLang="gez"/>
                     </msItem>

                     <msItem xml:id="ms_i1.2">
                        <locus from="28rb" to="35vb"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA">Taʾammǝra ʾAnānya</title>
                        <textLang mainLang="gez"/>
                        <note>The miracles are not numbered.</note>

                        <msItem xml:id="ms_i1.2.1">
                           <locus from="28rb" to="28va"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Incipit">Taʾammǝra ʾAnānya: Incipit</title>
                           <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ንጽሕፍ፡ ዜና፡ ተአምሪሁ፡ ወዕበየ፡ ኃይሉ፡ ትሩፋቲሁ፡ ለዝንቱ፡ ጻድቅ፡ አቡነ፡ አናንያ፡ ዘውገ፡
                              <pb n="28va"/> ፋሲለደስ፡ ሰማዕት፡ ዘተገብረ፡ እምድኅረ፡ ሞቱ፡</incipit>
                           <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.2.2">
                           <locus target="#28va"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#SupplicationTM">Taʾammǝra ʾAnānya: Supplication</title>
                           <incipit xml:lang="gez">ጸሎቱ፡ ወበረከተ፡ ወሀብተ፡ ረድኤቱ፡ ወጸጋ፡ አምላኩ። ወትንብልንሃ፡ ለእግዝእትነ፤ ቅድስት፡ ወድንግልት፡ በ፪ ማርያም፡ ወላዲተ፡ 
                              አምላክ፡ የሃሉ፤ ምስለ፡ ገብሩ፡ ገብረ፡ ሥላሴ፡ ለዓ፡ ዓ፡ አ።</incipit>
                        </msItem>

                        <msItem xml:id="ms_i1.2.3">
                           <locus from="28va" to="29vb"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#FirstMiracle">Taʾammǝra ʾAnānya: Miracle and Hymn 1</title>
                           <textLang mainLang="gez"/>

                           <msItem xml:id="ms_i1.2.3.1">
                              <locus from="28va" to="29va"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Miracle1">Taʾammǝra ʾAnānya: First Miracle</title>
                              <incipit xml:lang="gez">ቀዳማዊ፡ ተአምር፡ ዘገብረ፡ አቡነ፡ አናንያ፡ ዘኤለ፡ አድባራተ፡ ወገዳማተ፡ ወምኔታተ፡ ወከመ፡ አቡሁ፤ ዘከፈለ፡ ባሕረ፡ ግርምተ፡
                                 ወከመ፡ ኤልያስ፡ ዘቀፀበ፡ ደመናተ፡ ወከመ፡ ጳው<add place="margin">ሎ</add>ስ፡ ዘአንኃ፡ ስብከተ፡ ወከመ፡ ጴጥሮስ፡ ዘትወፈየ፡ መራኁተ፡ ወተሰቅለ፡
                                 ቍልቍሊተ፡ ወከመ፡ ጊዮርጊስ፤ ዘኮነ፡ ሰማ<supplied reason="omitted" resp="CH">ዕ</supplied>ተ፡ ጸሎቱ፡ ወበረካቱ፡ የሃሉ፤ ምስለ፤ ገብሩ፡
                                 ገብረ፡ ኪዳን፡ ለ<pb n="29ra"/>ዓለመ፤ ዓለም፤ አሜን። ወበ፩ ዕመዋዕል፡ መጽኡ፡ ብዙኃን፡ ድውያን፡ ወሕሙማን፡</incipit>
                              <explicit xml:lang="gez">ወይብሉ፤ ዘይፌውስ፡ ድውያነ፡ በዘፈረ፡ ልብሱ፤ ኢርኢነ፤ ወኢሰማዕነ፡ ዘእንበለ፡ እግዚእነ፡ ወመድኃኒነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘፈውሰ፡ 
                                 በዘፈረ፡ ልብሱ፤ ወአርዳኢሁ፡ ሐዋርያት፡ <pb n="29ra"/> ውእቱኒ፡ ኢያኅፀፀ፡ እምኔሆሙ፡ በገቢረ፡ ተአምራት፡ ወመንክራት። ጸሎቱ፡ ወበረከቱ፡ ይዕቀቦ፡ ለፍቁሩ፡
                                 ገብረ፡ ኪዳን፡ ለዓለ፤ ዓ፡ አሜን።
                              </explicit>
                              <textLang mainLang="gez"/>
                           </msItem>

                           <msItem xml:id="ms_i1.2.3.2">
                              <locus from="29va" to="29vb"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Arke1">Taʾammǝra ʾAnānya: ʿĀrke-hymn 1</title>
                              <incipit xml:lang="gez">ሰላም፡ ለልብሰከ፡ ፈዋሴ፡ ሕማም፡ ወደዌ። ወእምነ፡ ኵሉ፡ ምንሳዌ።</incipit>
                              <explicit xml:lang="gez">ወእምነ፡ እሳት፡ ነነ<cb n="29vb"/>ዌ። በስብከተ፡ ነቢይ፡ ዮናስ፡ ዘአልቦ፡ ሕሳዌ።</explicit>
                              <textLang mainLang="gez"/>
                           </msItem>
                        </msItem>

                        <msItem xml:id="ms_i1.2.4">
                           <locus from="29vb" to="32ra"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#SecondMiracle">Taʾammǝra ʾAnānya: Miracle and Hymn 2</title>
                           <textLang mainLang="gez"/>

                           <msItem xml:id="ms_i1.2.4.1">
                              <locus from="29vb" to="31vb"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Miracle2">Taʾammǝra ʾAnānya: Second Miracle</title>
                              <incipit xml:lang="gez">ተአምሪሁ፡ ለብፁዕ፡ ወቅዱስ፡ ወትሩፈ፡ አቡነ፡ አናንያ፡ እምብዕለ፡ ዓለም፡ ለመንግሥተ፡ ሰማይ፡ ዘኃረያ። ጸሎቱ፤ ወበረከቱ፤ የሃሉ፤
                                 ምስለ፡ ፍቁሩ፤ ገብረ፡ ስላሴ፡ ለዓለመ፤ ዓለ፤ አሜ። ወበ፩ እመዋዕል። መጽኡ፡ ፪ መነኮሳት፡ ተማኪሮሙ፡ ምስለ፡ ሰብአ፡ ሰራዌ። ወኮነ፡ በሀገሮሙ፡ አባረ፡ እክል፡ ወጽምዓ፡ 
                                 ማይ፡ በእንተ፡ ኃጢአ፡ ዝናም። ወበልኦ፡ አንቦጣ፡ ኵሎ፡ ፍሬ፡ ምድሮሙ፡</incipit>
                              <explicit xml:lang="gez">ወኮነ፡ ዘይፌውስ፡ ድውያነ፡ እስከ፡ ዛቲ፡ ዕለት፡ አዕፅምቲሆሙ፡ አበው፡ ጻድቃን። ጸሎቶሙ፡ 
                                 <surplus>ወ</surplus>ወበረከቶሙ፡ የሃሉ፡ ምስለ፤ ዓመቱ፡ ወለተ፡ ማርያም፡ ለዓለመ፤ ዓለ፤ አሜን።</explicit>
                              <textLang mainLang="gez"/>
                           </msItem>

                           <msItem xml:id="ms_i1.2.4.2">
                              <locus from="31vb" to="32ra"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Arke2">Taʾammǝra ʾAnānya: ʿĀrke-hymn 2</title>
                              <incipit xml:lang="gez">ሰላም፡ ለአዕፅምቲክሙ፡ ዘይፌውሱ፡ ድውያነ፡</incipit>
                              <explicit xml:lang="gez">ወንጽሕናክሙ፡ ለይዕቀብ፡ ሥጋነ።</explicit>
                              <textLang mainLang="gez"/>
                           </msItem>
                        </msItem>

                        <msItem xml:id="ms_i1.2.5">
                           <locus from="32ra" to="32vb"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#ThirdMiracle">Taʾammǝra ʾAnānya: Miracle and Hymn 3</title>
                           <textLang mainLang="gez"/>

                           <msItem xml:id="ms_i1.2.5.1">
                              <locus from="32ra" to="32va"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Miracle3">Taʾammǝra ʾAnānya: Third Miracle</title>
                              <incipit xml:lang="gez">ተአምሪሁ፡ ለቅዱስ፡ ወብፁዕ፡ አናንያ፡ ጻድቅ፡ ወሰማዕት፡ መፍቀሬ፤ ጾም፡ ወጸሎት፡ ጸሎቱ፤ ወበረከቱ፤ የሃሉ፤ ምስለ፡ ዓመቱ፤ 
                                 ወለተ፡ ስላሴ፡ ለዓለመ፤ ዓለም፤ አሜ። ወነበሩ፡ ፪ ሰብእ፡ ፩ መነኮስ፡ ወ፩ ወሬዛ፡ ወንበረቶሙ፡ ለ፪ኤሆሙ፡ አሐቲ፡ ገራህት፡ ወተካፈልዋ። ወ<cb n="32rb"/>
                                 በአሐቲ፡ ዕለት፤ መጽአ፡ አንበጣ። ወውእቱ፡ ወሬዛ፡ ሐፀበ፡ ማየ፡ እምልብሰ፡ መግነዙ፡ ለአቡነ፡ አናንያ፡ ወነዝኃ፡ ለይእቲ፡ ገራህት፤ ዘተካፈለ፡ በዕፃ፡ እንዘ፡ ክድንት፡
                                 ይእቲ፡ ኵለንታሃ፡ በአንቦጣ፤ ወኢጥዕመ፡ አንቦጣ፡ እምፍሬ፤ እክል፡</incipit>
                              <explicit xml:lang="gez">ወእለ፡ ርእዩ፡ ሰብእ፡ አንከሩ፡ ዓቢየ፡ አንክሮ፡ ወተደሙ፡ <add place="above">እም</add>ተአምራቲሁ፤ 
                                 ወመንክራቲሁ፡ ለንጹሕ፡ ወኅሩይ፡ መስተጋድል፡ አናንያ፡ ጸሎቱ፡ ወበረከቱ፤ የሃሉ፡ ምስለ፡ ዓመቱ፡ አመተ፡ ሚካኤል፡ ለዓለመ፤ ዓለ፤ አሜን፤</explicit>
                              <textLang mainLang="gez"/>
                           </msItem>

                           <msItem xml:id="ms_i1.2.5.2">
                              <locus from="32va" to="32vb"/>
                              <title type="complete" ref="https://betamasaheft.eu/LIT5061TaammeraA#Arke3">Taʾammǝra ʾAnānya: ʿĀrke-hymn 3</title>
                              <incipit xml:lang="gez">ኦዘአሰርኮ፡ አፈ፡ አንቦጣ፡ በላዒ። ከመ፡ ዘየአሥር፡ ንጉሥ፡ አእጋረ፡ ዓለዊ፡ ወጸላኢ።</incipit>
                              <explicit xml:lang="gez">አናንያ፡ ካህን፡ ከመ፡ ሱራፌ፡ ሠዋዒ። በጸሎትከ፡ አባ፡ አድኅነኒ፡ እምእድ፡ ፅኑዕ፡ ጸላኢ። ወኢይገፈአኒ፡ ብእሲ፡ ገፋዒ። ።</explicit>
                              <textLang mainLang="gez"/>
                           </msItem>
                        </msItem>

                        <msItem xml:id="ms_i1.2.6">
                           <locus from="32vb" to="34rb"/>
