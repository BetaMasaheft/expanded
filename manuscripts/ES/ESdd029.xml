                     <binding contemporary="partly">
                        <decoNote xml:id="b1" type="Boards">Two wooden boards (both broken and repaired).</decoNote>
                        <decoNote xml:id="b2" type="Cover">Leather cover (for the most part missing).</decoNote>
                        <decoNote xml:id="b3" type="Sewing">Two pairs of sewing stations.</decoNote>
                        <decoNote xml:id="b4" type="SewingStations">4</decoNote>
                        <decoNote xml:id="b5" type="bindingMaterial">
                           <material key="wood"/>
                           <material key="leather"/>
                        </decoNote>
                        <decoNote xml:id="b6" type="Endbands">Present.</decoNote>
                        <decoNote xml:id="b7" type="Other">Two pairs of chains of endband stitches at the spine cover. The turn-ins are laced with cords. 
                           Small reinforcing strips of parchment inserted under the threads holding the headband, in the middle of the quires: <locus target="#38 #78 #88 #98 #108 #118 #148"/>.
                           <ref target="#q1 #q2 #q7 #q11"/>are reinforced by parchment guards. A short parchment guard is sewn in the middle of <ref target="#q1"/>.
                           <locus target="#8 #5 #23 #32 #54 #65 #72 #78 #90 #102 #105 #107 #117 #129"/>
                           <term key="leafStringMark" ana="#leafStringMark">Coloured threads</term> inserted in the right upper corner of some folia. The Psalms are divided into groups of ten separated by a line of
                           alternating black and red dots. The division corresponds to the insertion of the coloured threads.</decoNote>
                     </binding>
                  </bindingDesc>
               </physDesc>
