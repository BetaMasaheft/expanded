                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script">A nineteenth-century script (?)</seg>
                        <seg type="ink">Black, red (moderate red, moderate vermillion).</seg>
                        <desc>Mediocre, awkward, hard to read.</desc>
                        <seg type="rubrication">Divine names, name of the supplicants; several groups
                           of lines on the incipit page of <ref target="#ms_i1"/>, alternating with black lines; two
                           lines of the incipit of <ref target="#ms_i2"/>, <ref target="#ms_i3"/>, <ref target="#ms_i4"/>, <ref target="#ms_i5"/>, 
                           <ref target="#ms_i7"/>, <ref target="#ms_i8"/> and <ref target="#ms_i9"/>; first word of
                           <ref target="#ms_i6"/>; incipit of each section in <ref target="#ms_i1"/> and <ref target="#ms_i8"/>, incipit of each
                           miracle in <ref target="#ms_i2"/>, <ref target="#ms_i7"/> and <ref target="#ms_i9"/>, incipit of each strophe in Text <ref target="#ms_i3"/>. 
                           The word <foreign xml:lang="gez">ʾǝsaggǝd</foreign> (‘I worship’) in Text  <ref target="#ms_i4"/>; elements of punctuation
                           signs, text dividers and Ethiopic numerals.</seg>
                     </handNote>
                  </handDesc>
                  <decoDesc>

                     <decoNote type="frame" xml:id="d1">
                        <locus target="#2r"/>
                        <desc>(incipit page of <ref target="#ms_i1"/>) Uncoloured ornamental band; crude interlaces.</desc></decoNote>
                  </decoDesc>
                  
                  <additions>
                     <list>
                        <item xml:id="a1"> 
                           <locus target="#1v"/>
                           <desc>A one-page text that is illegible because the ink has faded.</desc>
                        </item>
                        
                        <item xml:id="a2"> 
                           <locus from="90ra" to="90rb"/>
                           <desc>A text that is illegible due to faded ink.</desc>
                        </item>
                        
                        <item xml:id="a3"> 
                           <locus from="92ra" to="92vb"/>
                           <desc type="Genealogy">A genealogy of a family tracing the lineage of a certain Yafǝqǝr Dammo (?). 
                              The second part of the Additio contains a note concerning a family rule governing bequests. 
                              It mentions priest (qasis) <persName ref="https://betamasaheft.eu/PRS15606TawaldaMed">Tawalda Madḫǝn</persName> (the one who wrote the note), 
                              priest (qes) <persName ref="https://betamasaheft.eu/PRS15607Tasfay">Tasfāy</persName>, priest (qes) <persName ref="https://betamasaheft.eu/PRS15608GabraHeywat">Gabra Ḥǝywat</persName>, and
                              priest (qes) <persName ref="https://betamasaheft.eu/PRS15609WaldaAbreha">Walda ʾAbrǝhā</persName>. It is written in a fine hand.</desc>
                           <quote xml:lang="am">ውልድ፡ የፍቅር፡ ደሞ፡ ተወለደ፡ ደሞም፡ ቄስ፡ ምእንቶ፡ ወለደ፡ ቄስ፡ ምእንቶም፡ ነማር<supplied reason="omitted">ያ</supplied>ም፡ ገለላዊት፡ ወለተ፡ ጽዮን፡
                              ወለደ፡ የነዚህ፡ ፍጎ፡ አቶ፡ መንበሩ፤ ነማርያም<add place="above">ን፡</add> ሐብቱ፡ ወልደ፡ ጋብር፡ ስቡን፡ ክርስቶሳዊት፡ 
                              ንግሥቲ፡ ወለደ፡ የነዚህ፡ ፍጎ፡ አቶ፡ ገብረ፡ አናንያ። <gap reason="omitted" resp="MK"/></quote>
                        </item>
                        
                        <item xml:id="a4"> 
                           <locus target="#93rb"/>
                           <desc type="DonationNote">A donation note of a book (possibly the present codex). The note mentions <persName ref="https://betamasaheft.eu/PRS15610GabraMed"><roleName type="function">Mamḥǝre</roleName> Gabra Madḫǝn</persName> and
                              <persName ref="https://betamasaheft.eu/PRS15611Hesh"><roleName type="function">Mamḥǝre</roleName> Ḥǝš</persName>. It was written by <persName ref="https://betamasaheft.eu/PRS15612WaldaSadqan">Walda Ṣādǝqān</persName>, in a very crude way. 
                              The ink has partly faded away.</desc>
                           <quote xml:lang="gez">በስመ፡ <gap reason="omitted" resp="MK"/> በስመ፡ እግዚአብሔር፡ ክቡር፡ ወልዑል፡ ፀሃፊአ፡ ወልደ፡ ጻድቃን፡ ወድ፡ መምሕሬ፡ ገብረ፡ መድኅን፡ ክቡር፡
                              ወልዑል፡ መፅሐፍ፡ ዘወሀቡኒ፡ አቦይ፡ መምሕሬ፡ ሕሽ፡</quote>
                        </item>
                        
                        <item xml:id="e1">
                           <locus target="#38ra #47va #85ra"/>
                           <desc>Tamallas-sign, in the shape of perpendicular lines (┴), indicating the place where the omissions, written in the upper
                           margin, belong.</desc>
                          </item>
                        
                        <item xml:id="e2">
                           <locus target="#6ra #11rb #19ra #46va #50vb #62ra #72vb"/>
                           <desc>Omitted letters or words inserted interlineally in <ref target="#h1"/>.</desc>
                        </item>
                        
                        <item xml:id="e3">
                           <locus from="53va" to="53vb"/>
                         <desc>Omitted letters written interlineally in blue pen in a recent secondary hand.</desc>
                        </item>
                        
                        <item xml:id="e4">
                           <locus target="#86rb"/>
                          <desc>An omitted letter written at the end of the line in <ref target="#h1"/>.</desc>
                        </item>
                        
                        <item xml:id="e5">
                           <locus target="#11va"/>
                          <desc>Omitted letters written at the end of the line in blue pen in a recent secondary hand.</desc> 
                        </item>
                        
                        <item xml:id="e6">
                           <locus target="#2rb #6va #13ra #24va #47va #47vb #72vb #80va"/>
