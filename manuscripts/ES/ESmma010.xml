                        </item>
                        
                        <item xml:id="e7">
                           <locus target="#12vb #70rb"/>
                           <desc>Corrections written over erasures in <ref target="#h1"/>.</desc>
                        </item>
                        
                        <item xml:id="e8">
                           <locus from="56va" to="56vb"/>
                           <desc>Erasures marked with thin black lines.</desc>
                        </item>
                           
                           <item xml:id="e9">
                              <locus target="#40vb"/>
                          <desc>A space for a name left unfilled.</desc>
                           </item>
                        
                              <item xml:id="e10">
                                 <locus target="#4r #17r #23r #80r #90v #91r #93v #94r"/>
                                 <desc>A pen trial, scribbles; the folia listed above are a few examples.</desc>
                              </item>
                        
                                 <item xml:id="e11">
                                    <locus target="#93ra"/>
                                    <desc>A recent poorly readable note in blue pencil.</desc>
                                 </item>
                        
                        <item xml:id="e12">
                           <desc type="findingAid">Readings are indicated by the name of the month (only Maggābit) written in blue pen, in a secondary hand, in the upper
                              margin of the following folia: <foreign xml:lang="gez">ዘመጋቢት፡</foreign> on <locus target="#25ra"/>,
                              <foreign xml:lang="gez">መጋቢት፡</foreign> on <locus target="#61va"/>, <foreign xml:lang="gez">መጋቢት፡</foreign> on <locus target="#84vb"/>.</desc>
                        </item>
                     </list>
                  </additions>
                  
