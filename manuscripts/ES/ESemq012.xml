                    <msContents>
                        <summary>Tārika Walda ʾAmid, Zenā ʾƎskǝndǝr</summary>
                        <msItem xml:id="ms_i1">
                            <locus from="3rb" to="50va"/>
                            <title ref="https://betamasaheft.eu/LIT7447AbrTarWA">Abridged Version of the Tārika Walda ʾAmid
          (β-recension)</title>
                            <note>The name of the owner on <locus target="#1rb6"/> and <locus from="49va22" to="49va23"/>, ending in 
                                <foreign xml:lang="gez">ማርያም፡</foreign>, was partly erased.</note>
                            <textLang mainLang="gez"/>
                            <msItem xml:id="ms_i1.1">
                                <locus from="3rb1" to="3rb7"/>
                                <title ref="https://betamasaheft.eu/LIT7447AbrTarWA#Preface">Abridged Version of the Tārika Walda ʾAmid (β-recension): Attribution to the author by
          the translator.</title>
                                <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ መሐሪ፡ ወመስተሣህል። ንጽሕፍ፡ መጽሐፈ፡ ታሪክ፡ ዘጊዮርጊስ፡ ወልደ፡ ዓሚድ።</incipit>
                                <explicit xml:lang="gez">ጸሎቱ፡ ወበረካቱ፡ የሀሉ፡ ምስለ፡ ፍቁሩ፡ <gap reason="lost" unit="chars" quantity="3"/> ማርያም፡ ለዓለመ፡
                                    ዓለም፡ አሜን።</explicit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="3rb7" to="3va12"/>
                                <title ref="https://betamasaheft.eu/LIT7447AbrTarWA#TentaFetrat">Abridged Version of the Tārika Walda ʾAmid
          (β-recension): Summary on the creation</title>
                                <incipit xml:lang="gez">ይቤ፡ ከመ፡ ቃለ፡ ኦሪት፡ በዕለተ፡ እሑድ፡ ፈጠረ፡ <gap reason="omitted" unit="chars" quantity="7"/>
                                    ፰ ሥዉራተ፡ ፩፡ ነቢብ፡ ወ፯፡ በአርምሞ።</incipit>
                                <explicit xml:lang="gez">ወበሳብዕት፡ ዕለት፡ አዕረፈ፡ <gap reason="omitted" unit="chars" quantity="7"/> እምኵሉ፡ ግብሩ።</explicit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">
                                <locus from="3va12" to="50va"/>
                                <title ref="https://betamasaheft.eu/LIT7447AbrTarWA#preislamichistory">Abridged Version of the Tārika Walda ʾAmid
          (β-recension): The pre-Islamic history from Adam to Heraclius.</title>
                                <incipit xml:lang="gez">ወወለ<unclear>ደ፡</unclear> አዳም፡ ቃየልሃ፡ ወአቤል፡</incipit>
                                <explicit xml:lang="gez">ተፍጻመ፡ ታሪክ፡ ዘጊዮርጊስ፡ ወልደ፡ ዓሚድ፤ ጸሎቱ፡ ወበረከቱ፡ የሀሉ፡ ምስለ፡ ፍቁሩ፡ 
                                    <gap reason="lost" unit="chars" quantity="3"/>፡ ማርያም፡ ለዓለመ፡ ዓለም፡ አሜን።</explicit>
                                  
                            </msItem>
                            <msItem xml:id="ms_i2">
                                <locus from="50vb" to="51ra"/>
                                <title>Names of countries that changed their names after the Turks took power</title>
                                <note>List of biblical place names and their hypothesised identification with places at a later time. The largest part of the
                                    information is probably based on <ref type="work" corresp="https://betamasaheft.eu/LIT4723TarikaWaldaAmid">Tārika Walda ʾAmid (general record)</ref>.</note>
                                <incipit xml:lang="gez">አስማተ፡ አኅጉራት፤ ዘከመ፡ ወለጠ፡ ጥንተ፡ አስማቲሆሙ፡ ንጉሥ፡ ትርኵ፤ ቅድመሰ፡ ነበረ፡ ስማ፡ ሰናኦር፤</incipit>
                                <explicit xml:lang="gez">ጽዮን፡ ብሂል፡ ፀወን፡ ሰሎሞንሂ፡ ሶበ፡ ሐነጸ፡ መቅደሰ፡ በታሕቴሃ፡ ሰመያ፡ ኢየሩሳሌም፡ ኢየሩሳሌም፡ ብሂል፡ ሀገረ፡ ሰላም፤
                                    ኢየሩሳሌም፡ ብሂል፡ ዝዥ፡ ኢየሩሳሌም፡ ብሂል፡ ሰላም።</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i3">
                                <locus from="52ra" to="95vb"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT2616Zenaes">Zenā ʾƎskǝndǝr</title>
                                <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩፡ አምላክ። ዝንቱ፡ መጽሐፍ፡ ዘተጽሕፈ፡ በኪልቄዶን፡ በእንተ፡ ግብሩ፡ ወመንግሥቱ፡
                                    ለእስክንድር፡ ንጉሥ፡ ፍቁረ፡ እግዚአብሔር።</incipit>
                                <explicit xml:lang="gez">ጸሎቱ፡ ወበረካቱ፡ ወሀብተ፡ ረድኤቱ፡ ለእስክንድር፡ ንጉሥ፡ የሀሉ፡ ምስለ፡ ፍቁሩ፡ 
                                    ዘ<gap reason="illegible" unit="chars" quantity="2"/> ማርያም፡ ለዓለመ፡ ዓለም፡ አሜን።</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <note/>
                        </msItem>
                    </msContents>
