                        <additions>
                            <list>
                                <item xml:id="a1">                 
                                    <locus target="#iiv"/>
                                    <desc type="OwnershipNote">                                 
                                        Note written in Latin stating that the manuscript belongs to  <persName role="owner" ref="https://betamasaheft.eu/PRS13179Gabra">Gabra Giyorgis</persName>.
                                    </desc>
                                    <q xml:lang="la">
                                        Grammatica <sic>Aetiopica</sic> R<supplied reason="explanation">everen</supplied>di<lb/> 
                                        D. Georgii Galabbada<lb/>
                                        ex<lb/>
