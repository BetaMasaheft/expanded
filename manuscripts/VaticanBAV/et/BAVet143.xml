                            <additions>
                                <list>
                                    <item xml:id="a1">
                                        <locus target="#188r"/>
                                        <desc type="Supplication">
                                            Short invocation written by multiple hands in the upper margin of the folio. Part of the text is illegible or lost. 
                                            The names of <persName ref="https://betamasaheft.eu/PRS15039SayfaAm">Sayfa ʾAmlāk</persName> and 
                                            <persName ref="https://betamasaheft.eu/PRS15040BetaGi">Beta Giyorgis Sirāk</persName> are mentioned as <foreign xml:lang="gez">ገብርከ፡</foreign>, ‘your servant’.
                                            It is unclear whether the note was added before or after the binding of the two codicological units.
                                        </desc>
                                        <q xml:lang="gez">
                                            <gap reason="lost"/> ሰውሮ፡ እም<gap reason="lost"/> ውግዓት፡ አድኅኖ፡ ለገብርከ፡ ሰይፈ፡ አም<lb/>ላክ፡ 
                                            <gap reason="lost"/> ዕጣን፡ ሀብተ፡ ማርያም<supplied reason="omitted">፡</supplied> 
                                            <lb/> <gap reason="lost"/> ለገብርከ፡ ቤተ፡ ጊዮርጊስ፡ ሲራክ፡
                                        </q>
                                    </item>
                                </list>
