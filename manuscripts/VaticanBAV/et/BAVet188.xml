                    <msContents>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="1r" to="33v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT3949MashafaKrL">Maṣḥafa krǝstǝnnā</title>
                            <textLang mainLang="gez"/>
                        
                        <msItem xml:id="ms_i1.1">
                            <locus from="1r"/>
                            <title xml:lang="gez">Introduction</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ንጽሐፍ፡ <gap reason="illegible" extent="unknown"/> ተሣሃለነ፡ በል፡ አመ፡
                                ይወጽኡ፡ በል፡ አድኅነ<supplied reason="omitted">ኒ፡</supplied> እግዚኦ፡ እስመ፡ በጽሐ፡ <gap reason="illegible" extent="unknown"/> ወትብል፡
                                በእንተ፡ ጸሎት፡ እግዚእ፡ እግዚአብሔር<supplied reason="omitted">፡</supplied> ኢየሱስ፡ ክርስቶስ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ዘአጽናዕከ፡</corr><sic>ዘአጽናዕካ፡</sic></choice> ሰማያተ፡ ወወረድከ፡ ዲበ፡ ምድር፡
                            </incipit>
                        </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="7r"/>
                                <title xml:lang="gez">First prayer over those to be baptized</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    መፍቀሬ፡ ሰብእ፡ መሐሪ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዘኢሀሎ፡ ውስተ፡ ዘ<surplus>ኢ</surplus>ሀሎ፡ ገብርከ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ትክል። አእትቶ፡ ወአፍልሶ፡ ዘንተ፡ ነፍሰ፡ እግዚኦ፡ እምእከይ፡ ውስተ፡ 
                                    ኂሩት<supplied reason="omitted">፡</supplied>
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">
                                <locus from="7v"/>
                                <title xml:lang="gez">Second prayer over those to be baptized</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ወካዕበ፡ ናስተበቍዕ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ከመ፡ ይክሥት፡ እዝነ፡ ልቦሙ፡ 
                                    ወያበ<supplied reason="lost" rend="effaced">ርህ፡</supplied> አዕይንተ፡ አልባቢሆሙ፡ <supplied reason="omitted">በ</supplied>ልቡና፡ ወየሀቦሙ፡ ብርሃነ፡ 
                                    አእምሮ፡ 
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.4">
                                <locus from="8r"/>
                                <title xml:lang="gez">Third prayer over those to be baptized</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አንተ፡ ጸዋዕከ፡ አግብርቲከ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> እምጽልመት፡ ውስተ፡ ብርሃን፡ ወእምኢያእምሮ፡ ውስተ፡ አእምሮ፡ አማን፡ ኵሎ፡ ተረፈ፡
                                    ጣዖት፡ ደምስስ፡ እምውስተ<supplied reason="omitted">፡</supplied> ሕሊናሆሙ፡ 
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.5">
                                <locus from="9r"/>
                                <title xml:lang="gez">Prayer after anointing</title>
                                <textLang mainLang="gez"/>
                                <note>The prayer follows <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#PrayerOilVessel">Maṣḥafa krǝstǝnnā: PrayerOilVessel</ref> and 
                                    <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#PrayerOil">Maṣḥafa krǝstǝnnā: PrayerOil</ref>.</note>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር፡ እግዚእየ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ኢየሱስ፡ ክርስቶስ፡ ባሕቲትከ፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ታእምር፡</corr><sic>ተእምር፡</sic></choice> 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዕበየ፡ ክብሩ፡ ለአብ፡ ወለፍጥረት፡ ዓራቂ፡ ሊቀ፡ 
                                    ካህናት<supplied reason="omitted">፡</supplied> ለነፍሶሙ፡ ፈውስ፡ ለእለ፡ የሐሙ<supplied reason="omitted">፡</supplied>
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.6">
                                <locus from="9v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT3949MashafaKrL#ChangingClothes">Maṣḥafa krǝstǝnnā: ChangingClothes</title> 
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i1.7">
                                <locus from="11r"/>
                                <title xml:lang="gez">Prayer before the blessing of the water</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር<supplied reason="omitted">፡</supplied> እግዚእየ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዘገበርከ፡ ሰማየ፡ 
                                    ወምድረ፡ ወባሕረ<supplied reason="omitted">፡</supplied> ወኵሎ፡ <supplied reason="omitted">ዘ</supplied>ውስቴቶሙ፡ 
                                    ዘገብሮ<supplied reason="omitted">፡</supplied> ለሰብእ፡ በዘዚአሁ፡ አርአያ፡ ወአምሳል፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.8">
                                <locus from="11v"/>
                                <title xml:lang="gez">Exorcism of the water</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር፡ ዘለዓለም፡ ማእምር፡ ዘኅቡዕ፡ ንስእለከ፡ ወናስተበቍዓከ፡ ፈኑ፡ ቅዱሰ፡ ኀይለከ፡ ዲበዝ፡ ማይ፡ ወቀድሶ፡ ወሚጦ፡ ወባርኮ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.9">
                                <locus from="12v"/>
                                <title xml:lang="gez">Prayer</title>
                                <textLang mainLang="gez"/>
                                <note>The prayer follows the directive on preparing the baptismal font.</note>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር፡ እግዚእየ፡ ዘኵሎ<supplied reason="omitted">፡</supplied> ትእኅዝ፡ አንተ፡ ገበርከ፡ ሰማየ<supplied reason="omitted">፡</supplied>
                                    ወምድረ፡ ወባሕረ፡ <choice><corr resp="bm:GrebTiss1935Codices">ወኵሎ፡</corr><sic>ወኵሉ፡</sic></choice> ዘውስቴቶሙ፡ አንተ፡ ገበርከ፡
                                    በአርአያ<supplied reason="omitted">፡</supplied> ዚአከ፡ ወበአምሳል፡ ወአንበርከ፡ ውስተ፡ ገነት፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.10">
                                <locus from="14v"/>
                                <title xml:lang="gez">Formula of the baptism</title>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i1.11">
                                <locus from="15r"/>
                                <title xml:lang="gez">Directive about the going out of the baptismal font and directive about the baptism of the sick</title>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i1.12">
                                <locus from="15v"/>
                                <title xml:lang="gez">Prayer to be said by the priest before the anointing with oil</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር<supplied reason="omitted">፡</supplied> እግዚእየ፡ ዘኵሎ<supplied reason="omitted">፡</supplied> ትእኅዝ፡ አብ፡ ለእግዚእነ፡
                                    ወመድኃኒነ፡ ኢየሱስ<supplied reason="omitted">፡</supplied> ክርስቶስ፡ ስፋሕ<supplied reason="omitted">፡</supplied> እዴከ፡ ዘኢያስተርኢ፡
                                    ላዕለ፡ ፍሬ<supplied reason="omitted">፡</supplied> ዝንቱ፡ ዘይት፡ በዘይትቀባዕ፡ በዘቀባዕከ፡ ካህናተ<supplied reason="omitted">፡</supplied> 
                                    ወነቢያት፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.13">
                                <locus from="16v"/>
                                <title xml:lang="gez">Prayer</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚእየ፡ ዘኵሎ፡ ትእኅዝ፡ አምላከ፡ ኃያላን፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ንስእለከ፡ ከመ፡ ትፈኑ፡ ዲበ፡ ዝንቱ፡ ቅብዕ፡
                                    <choice><corr resp="bm:GrebTiss1935Codices">መንፈሰ፡</corr><sic>መንፈስ፡</sic></choice> ኃይል፡ ረስዮ፡ ኪያሁ፡ ይኩን፡ ለረድአ፡ ሃይማኖት፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.14">
                                <locus from="17r"/>
                                <title xml:lang="gez">Thanksgiving of the bishop</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ያወሥእ፡ ኤጲስ፡ ቆጶስ<supplied reason="omitted">፡</supplied> አልዕሉ፡ ልበክሙ፡ ወእለ፡ ይቀውሙ፡ ምስለ፡ መንፈስከ፡ ኤጲስ፡ ቆጶስ፡ አልዕሉ፡
                                    ልበክሙ፡ ወእለ፡ ይቀውሙ<supplied reason="omitted">፡</supplied> ብነ፡ ኀበ፡ እግዚአብሔር፡ ወእሙንቱ፡ 
                                    ርቱዕ<supplied reason="omitted">፡</supplied> ወጽድቅ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.15">
                                <locus from="17v"/>
                                <title xml:lang="gez">Blessing of the oil</title>
                                <textLang mainLang="gez"/>
                                <note>The blessing follows the directive of the priest</note>
                                <incipit xml:lang="gez">
                                    ከመዝ<supplied reason="omitted">፡</supplied> ርቱዕ፡ ውእቱ፡ ወጽድቅ፡ ኪያከ<supplied reason="omitted">፡</supplied> ንሴብሕ፡ ለከ፡ ንትአመን፡
                                    <choice><corr resp="bm:GrebTiss1935Codices">ወናአኵተከ፡</corr><sic>ወናአኩ<orig>ቴ</orig><corr>ተ</corr>ከ፡</sic></choice> በኵሉ፡ 
                                    ገብርከ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ንቄርብ<supplied reason="omitted">፡</supplied> ዘንተ፡ <sic>በለሶን፡</sic>
                                    ዘወሀብከነ፡ ለፈውስ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.16">
                                <locus from="18v"/>
                                <title xml:lang="gez">Prayer</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚእየ፡ ዘኵሎ<supplied reason="omitted">፡</supplied> ትእኅዝ፡ ዘነቢያት፡ እግዚአብሔር፡ ወለሐዋርያት፡ እግዚእ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ፍኖከ<supplied reason="omitted">፡</supplied> ኀበ፡ ኃይል፡ በዝንቱ፡ ቅብዕ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ይሠዓር፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ኵሉ፡</corr><sic>ኵሎ</sic></choice> 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ሥራይ፡</corr><sic>ሥራየ፡</sic></choice> 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ወኵሉ፡</corr><sic>ወኵሎ</sic></choice>መንፈስ፡ እኩይ፡ ወርኩስ፡ ይሰደድ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.17">
                                <locus from="20v"/>
                                <title xml:lang="gez">Prayer of the imposition of the hands</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    እግዚአብሔር፡ ዘኵሎ፡ ትእኅዝ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ለከ<supplied reason="omitted">፡</supplied> አትሐቱ፡
                                    አግብርቲከ፡ <choice><corr resp="bm:GrebTiss1935Codices">ንዑስ፡</corr><sic>ንዑሰ፡</sic></choice>  ክርስቲያን፡ አርእስቲሆሙ፡ ለከ፡ አግረሩ፡
                                    ቀፈተ፡ ልብ<supplied reason="omitted">፡</supplied> ወሥጋ<gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ባርክ፡ ኪያሆሙ፡ ወኪያሆን፡
                                    ወአጽምዕ፡ ሎሙ<supplied reason="omitted">፡</supplied> አዝነከ፡ ወስምዖሙ፡ ጸሎቶሙ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.18">
                                <locus from="22r"/>
                                <title xml:lang="gez">Rite of consecration and prayer of thanksgiving</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ከመዝ፡ ርቱዕ<supplied reason="omitted">፡</supplied> ወጽድቅ፡ ኪያከ<supplied reason="omitted">፡</supplied> ንሴብሕ፡ ኪያከ፡ ንዌድስ፡ ለከ፡
                                    ንትአመን፡ <choice><corr resp="bm:GrebTiss1935Codices">ወናአኵተከ</corr><sic>ወናአኩተከ፡</sic></choice> በኵሉ፡ ዘገበርከ፡ ምስሌነ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> እስመ፡ አንተ፡ ዘይትኃጐል፡ <sic>ዓለም፡</sic> 
                                    <choice><corr resp="bm:GrebTiss1935Codices">አድኀንከ፡</corr><sic>አድኅንከ፡</sic></choice> ፈኒወከ፡ ፩ወልደከ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ 
                                    አኮ፡ ከመ፡ <choice><corr resp="bm:GrebTiss1935Codices">ይኰንን፡</corr><sic>ይኴንን፡</sic></choice> ዓለም፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ለከ፡ ናቀርብ፡ ዘንተ፡ <sic>በለሳነ፡</sic> ዘወሀብከ፡ ለፈውስ፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.19">
                                <locus from="23r"/>
                                <title xml:lang="gez">Anointing of the forehead and chest of the neophytes</title>
                                <textLang mainLang="gez"/>
                                <note>Then, after the Song of the three youths, the abjuration of Satan is recited 
                                    (cf. almost as in <bibl corresp="http://zotero.org/groups/358366/items/JEVV6IFP"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Grebaut1927Ordre"/><title level="a">Ordre du baptême et de la confirmation dans l’Église éthiopienne</title><title level="j">Revue de l’Orient Chrétien</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><date>1927</date><biblScope unit="volume">26, Troisième série, 6</biblScope><biblScope unit="page">105–189</biblScope><note type="url">http://catholicapedia.net/Documents/Revue-de-l.Orient-chretien/26-1927.1928_revue-de-l.orient-ch_paris.pdf</note><note type="tags"><note type="tag">bm:Grebaut1927Ordre</note></note><note type="tag">bm:Grebaut1927Ordre</note><citedRange unit="page">162</citedRange></bibl>), 
                                    then follows a Confession of Faith pronounced by the neophytes and the priest.</note>
                            </msItem>
                            <msItem xml:id="ms_i1.20">
                                <locus from="25r"/>
                                <title xml:lang="gez">Prayer</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ንስእለከ፡ <choice><corr resp="bm:GrebTiss1935Codices">ወናስተበቍዓከ፡</corr><sic>ወናስተበቁዓከ</sic></choice> ሕፅን፡ አግብርቲከ፡ ወአዕማቲከ፡
                                    ዓቃቤ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ምሥጢርከ፡ ይኩን፡
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.21">
                                <locus from="33v"/>
                                <title xml:lang="gez">Imposition of the hands and final prayer</title>
                                <textLang mainLang="gez"/>
                                <note>
                                    The imposition follows <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#Titus">Maṣḥafa krǝstǝnnā: Titus</ref>, <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#FirstJohn">Maṣḥafa krǝstǝnnā: FirstJohn</ref>
                                    (mistakenly entitled <q xml:lang="gez">ሐዋርያ<supplied reason="omitted">ት</supplied>፡</q>), <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#Acts8">Maṣḥafa krǝstǝnnā: Acts8</ref>, 
                                    <ref type="work" corresp="https://betamasaheft.eu/LIT3949MashafaKrL#John3">Maṣḥafa krǝstǝnnā: John3</ref>, and the directive about saying the litany (cf. <bibl corresp="http://zotero.org/groups/358366/items/JEVV6IFP"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Grebaut1927Ordre"/><title level="a">Ordre du baptême et de la confirmation dans l’Église éthiopienne</title><title level="j">Revue de l’Orient Chrétien</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><date>1927</date><biblScope unit="volume">26, Troisième série, 6</biblScope><biblScope unit="page">105–189</biblScope><note type="url">http://catholicapedia.net/Documents/Revue-de-l.Orient-chretien/26-1927.1928_revue-de-l.orient-ch_paris.pdf</note><note type="tags"><note type="tag">bm:Grebaut1927Ordre</note></note><note type="tag">bm:Grebaut1927Ordre</note><citedRange unit="page">169–175</citedRange></bibl>).
                                </note>
                                <incipit xml:lang="gez">
                                    እግዚኦ፡ እግዚአብሔር፡ አምላክነ<supplied reason="omitted">፡</supplied> ዲበ<supplied reason="omitted">፡</supplied> ርእሶሙ፡ አብርህ፡
                                    አክሊለ<supplied reason="omitted">፡</supplied> ሃይማኖት፡ <del>አ</del>ክሊለ፡ ጽድቅ<supplied reason="omitted">፡</supplied>  
                                </incipit>
                            </msItem>
                        </msItem>
