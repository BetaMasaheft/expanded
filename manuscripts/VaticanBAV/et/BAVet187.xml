                    <msContents>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="2r" to="31r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2246salotz">Ṣalot za-ʾǝgzǝʾtǝna Māryām ba-Dabra Golgotā</title>
                            <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <locus from="31v" to="38v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2444Temher">Tǝmhǝrta ḫǝbuʾāt</title>
                            <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <locus from="38v" to="39r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7761PPrayer">Protective prayer containing ʾasmāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በዝንቱ፡ ቃል፡ ኪዳንከ፡ ዕቀቦ፡ ወአድኅኖ፡ ለገብርከ፡ <gap reason="illegible" unit="word" quantity="1"/> ማርያም፡ ኢኮስ፡ እስሴ፡ ኢፓ፡ ኢፓስ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                በጸሎታ፡ ወበስእለታ፡ ለእግዝእትነ፡ ማርያም፡ ወላዲተ፡ አምላክ፡ ያድኅኖ፡ ወልዳ፡ ለገብረ፡ እግዚአብሔር፡ <gap reason="illegible" unit="word" quantity="1"/>
                                ማርያም፡
                            </explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i4">
                            <locus from="39r" to="40r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7762PPrayer">Protective prayer containing ʾasmāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                እካሲ፡ አሜ፡ <gap reason="illegible"/>ረን፡ አቲእያ፡ ኬምክያን፡ ፒሳ፡ ጊሎ፡ እሰካ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ወያንብሮ፡ ውስተ፡ መካን፡ ንጹሕ፡ ወቅዱስ፡ ከመ፡ ይኩኖ፡ ሕይወት፡ ወወልታ፡ መድኃኒት፡ ወመግረሬ፡ ፀር፡ በዝ<supplied reason="omitted">፡</supplied> 
                                ቃልከ፡ ዕቀቦ፡ ለገብርከ፡ <choice><orig><persName ref="https://betamasaheft.eu/PRS15188WaldaMa">ወልደ፡ 
                                    ማርያም፡</persName></orig><corr><persName ref="https://betamasaheft.eu/PRS15189GabraMa">ገብረ፡ ማርያም።</persName></corr></choice> 
                                <add><persName ref="https://betamasaheft.eu/PRS15190GabraAm">ገብረ፡ አማኑኤል፡</persName> 
                                    ዝቅ<supplied reason="omitted">፡</supplied> አ<supplied reason="omitted">ድ</supplied>ርጋቸው።</add>
                            </explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i5">
                            <locus target="#41v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7763PPrayer">Protective prayer containing ʾasmāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                <del rend="expunctuated">ለ</del><del rend="effaced" unit="char" quantity="1"/>ለበለ፡ አልባዎም፡ ወለቄሶን፡ እሌክ፡ ሙያሴር፡ አሳዮር፡ አህቤር፡ እቀበኒ፡
                                ወአድኅነኒ፡ እምጸረ፡ ወጸላ<supplied reason="omitted">እ</supplied>ትየ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i6">
                            <locus target="#41v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7764PPrayerLove">Ṣalot baʾǝnta fǝqr</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                <sic>ጸሎተ፡</sic> በ<add place="interlinear">እ</add>ንተ፡ ፍቅር፡ ማፋጸ<del rend="erasure" unit="char" quantity="1"/>ስ፡ አስቢላጅ፡ 
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> <sic>ታሽፍድ፡</sic> <sic>ታሽፈድፍድ፡</sic> <sic>ታሽቁጥ፡</sic> <sic>ታሽቆጥቁጥ፡</sic>
                                ፍትወተ<supplied reason="omitted">፡</supplied> ሥ<del rend="effaced" unit="char" quantity="1"/>ጋየ፡
                            </incipit> 
                        </msItem>
