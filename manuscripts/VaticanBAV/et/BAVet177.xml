                    <msContents>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="3r" to="4v"/>
                            <title type="incomplete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2444Temher">Tǝmhǝrta ḫǝbuʾāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                <gap reason="lost"/>ስ፡ ዘተሰቅለ፡ ዘቦቱ፡ ጸጋማይ፡ <choice><corr resp="bm:GrebTiss1935Codices">ከመ፡ ዘየማናይ፡</corr><sic>ኮነ፡</sic></choice>
                                ወታሕታይ፡ ከመ፡ ዘላዕላይ፡ ወደኃራይ፡ ከመ፡ ዘቀዳማይ፡ እሙታን፡ ተንሢኦ፡ ሲኦል፡ ከይዶ፡ በሞት፡ ለሞት፡ ደምሰሶ፡ እምድኅረ፡ ተንሥአ፡ በሣልስት፡ 
                                ዕለት፡ አእኰቶ፡ ለአብ፡
                            </incipit>
                            <note>The beginning of the text is missing.</note>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <locus from="5r" to="57v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2286ZenaSellase">Zenā nagaromu la-Śǝllāse</title>
                            <textLang mainLang="gez"/>
                            <msItem xml:id="ms_i2.1">
                                <locus from="5r" to="11r"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Introduction">Sayfa Śǝllāse: Introduction</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ተማኅፀንኩ፡ ብክሙ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ በከመ፡ ዓተውክሙ፡ ቤተ፡
                                    አብርሃም፡ ከማሁ፡ <choice><corr resp="bm:GrebTiss1935Codices">ዓዕትዉኒ፡</corr><sic>ዓዓትውኒ፡</sic></choice> ውስተ፡ መንበርክሙ፡ ተማኅፀንኩ፡
                                    ብክሙ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ትረስዩኒ፡ እንሣዕ፡ አክሊለ፡ ምሕረት፡ እምኀቤክሙ፡ ተማኅፀንኩ፡ ብክሙ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡
                                    አንኅልዋ፡ ለኃጢአትየ፡ ወአድ<add place="interlinear">ኅ</add>ንዋ፡ ለነፍስየ፡ እምእለ፡ ይትቃረንዋ፡ አጋንንት፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    <expan><abbr>ተማኅ</abbr><ex>ፀንኩ</ex></expan>፡ በሥጋሁ፡ ቅዱስ፡ ወበደሙ፡ ክቡር፡ ዘወሀቦ፡ መድኃኒተ፡ ለሰብእ፡ አውገዝኩ፡ ወኃተምኩ፡ እለ፡ ይገብሩ፡
                                    ሥራየ፡ ወኃይለ፡ ጸላዒ፡ ወእምሰብእ፡ መማዒ፡ ከመ፡ ኢይቅረቡ፡ ኀቤየ፡ ወኀበ፡ ቤትየ፡ ወሰብእየ፡ ወእንስሳየ፡ ሊተ፡ ለገብርከ፨
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i2.2">
                                <locus from="11r" to="16v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Monday">Sayfa Śǝllāse: Praise for Monday</title>
                                <textLang mainLang="gez"/>                        
                            </msItem>
                            <msItem xml:id="ms_i2.3">
                                <locus from="16v" to="18r"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7311MTPromises">Miracle of the Trinity: Promises to the faithful</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ተአምራቲሆሙ፡ ለአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ በረከተ፡ ጸጋሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወአሐተ፡ ዕለተ፡ አብኒ፡
                                    ይቤ፡ ዘአክበረኒ፡ በምድር፡ አነኒ፡ አከብሮ<del rend="effaced">ሙ</del>፡ በመንግሥተ፡ ሰማያት፡ ወአምሳሊሁ፡ ይመስል፡ ገጻ፡ አርያም፡ ዘወሀበኒ፡
                                    <sic>መብዓ፡</sic> ወስሂነ፡ ወይነ፡ ወ<surplus>ወ</surplus>ስንዳሌ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ወኀበ፡ ንዋሙ፡ አነ፡ እነውም፡ ወእተክል፡ ደብተራ፡ ብርሃን፡ ለዝንቱ፡ ብእሲ፡ ኢይትረከብ፡ አምሳሊሁ፡ አልቦ፡ ዘኢይትሀበሎ፡ እምሰብእ፡ ወእመላእክት፡ 
                                    ወአመጽእ፡ <sic>ፀዓዲ፡</sic> <sic>ን<add place="interlinear">ህ</add>ብ፡</sic> ከመ፡ ይቀስሞ፡ ወስብሐቲሁኒ፡ ከመ፡ መብረቅ፡ ወጥዑመ፡ ቃል፡ ይከውን፡
                                    ወእትሜሰል፡ አነ፡ ቦቱ፡ በረከቱ፡ አብ፡  <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i2.4">
                                <locus from="18r" to="24v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Tuesday">Sayfa Śǝllāse: Praise for Tuesday</title>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i2.5">
                                <locus from="24v" to="25v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7312MTBeer">Miracle of the Trinity: Demons burnt in beer</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ተአምራቲሆሙ፡ ለአብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> በረከተ፡ ጸጋሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                                    ወሀሎ፡ ፩ብእሲ፡ ውስተ፡ ሀገረ፡ ፍልስጥኤም፡ ወአሐተ፡ ዕለተ፡ ረሰየ፡ ምዝረ፡ በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ለገቢረ፡ ተዝካሮሙ፡ ወመጽኡ፡
                                    ሰይጣናት፡ ተመሲሎሙ፡ ከመ፡ አጽልልት፡ <sic>ወአተው፡</sic> ውስተ፡ ውእቱ፡ ምዝር፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    <sic>ወአተው፡</sic> ውስተ፡ መንግሥተ፡ ሰማያት፡ በ<supplied reason="omitted">በ</supplied>ረከተ፡ ረድኤቶሙ፡ ተኃድገ፡ ሎሙ፡ ኃጢአቶሙ፡ ከማሆሙ፡
                                    ኅድጉ፡ ኃጢአትየ፡ ብዙኃ፡ ለገብርክሙ፡ በረከተ፡ ጸጋሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i2.6">
                                <locus from="25v" to="30v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Wednesday">Sayfa Śǝllāse: Praise for Wednesday</title>
                            </msItem>
                            <msItem xml:id="ms_i2.7">
                                <locus from="30v" to="31r"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7313MTGovernor">Miracle of the Trinity: A governor is angry with his troops
        for commemorating the Trinity</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ተአምራቲሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወሀሎ፡ ፩ብእሲ፡ ውስተ፡ ሀገረ፡ ፍልስጥኤም፡ ወአሐተ፡ ዕለተ፡ አዘዘ፡ ከመ፡
                                    ይትጋብዑ፡ ሠራዊቱ፡ ወሶበ፡ ተጋብዑ፡ ይቤሎሙ፡ መኰንን፡ ለሠራዊቱ፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ዘይገብር፡</corr><sic>ዘይነበር፡</sic></choice> ተዝካሮሙ፡ ለአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ 
                                    ይንበር፡ ውስተ፡ ብሔርየ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ወዘንተ፡ ነገረ፡ ሶበ፡ ሰምዑ፡ ሠራዊቱ፡ ሖሩ፡ በበብሔሮሙ፡ ወገብሩ፡ ተዝካሮሙ፡ ለአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ወቦዑ፡ ውስተ፡ መንግሥተ፡ ሰማያት፡
                                    ዘኢየሐልቅ፡ በረከተ፡ ጸጋሆሙ፡
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i2.8">
                                <locus from="31r" to="37v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Thursday">Sayfa Śǝllāse: Praise for Thursday</title>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i2.9">
                                <locus from="37v" to="38v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7314MTFather">Miracle of the Trinity: Promise by God the Father to the
        faithful</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ተአምራቲሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወአሐተ፡ ዕለተ፡ ቦሙ፡ ውስተ፡ አርያም፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ወነበሩ፡
                                    ዲበ፡ መንበሮሙ፡ ለፌ፡ ወለፌ፡ ወርእያ፡ አብ፡ ለዛቲ፡ ዕለት፡ ወይቤ፡ ዛቲ፡ ዕለት፡ በዓልየ፡ ወበዓለ፡ ወልድ፡ ወበዓለ፡ መንፈስ፡ ቅዱስ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ወይቤ፡ አብ፡ ሶበ፡ ትወጽዕ፡ ነፍሱ፡ አነ፡ እመጽእ፡ ወእጸውሮ፡ በዘባንየ፡ ወአ<supplied reason="omitted">ዐ</supplied>ድዎ፡ ባሕረ፡ እሳት፡ ወአወርሶ፡ 
                                    መንግሥተ፡ <supplied reason="omitted">ሰማያት፡</supplied> ወአስተቄጽሎ፡ አክሊለ፡ ዲበ፡ ርእሱ፡ ዘዲበ፡ ርእስየ፡ ወይከውን፡ ዕሩየ፡ ምስሌየ፡ በረከተ፡ 
                                    ጸጋሆሙ፡
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i2.10">
                                <locus from="38v" to="44v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2296Sayfas#Friday">Sayfa Śǝllāse: Praise for Friday</title>
                                <textLang mainLang="gez"/>
                            </msItem>
                            <msItem xml:id="ms_i2.11">
                                <locus from="44v" to="45v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7315MTVoice">Miracle of the Trinity: Promises to the faithful by the voice of
        the Trinity</title>
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ተአምራቲሆሙ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወአሐተ፡ ዕለተ፡ ውስተ፡ ፈለገ፡ ጸቃውዕ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡
                                    ወተናገሩ፡ እንዘ፡ ይብሉ፡ ለዝንቱ፡ ቃልነ፡ ዘይሰምዖ፡ በእዝኑ፡ እንዘ፡ ይትነበብ፡ ንሕነ፡ ንባርኮ፡ በዕርፈ፡ መስቀል፡ ፯ዕለተ፡ አሜሃ፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ይነጽሕ፡</corr><sic>ይነጽሖ፡</sic></choice> እምኃጢአቱ፡ ዘገብሮ፡ እምንዕሱ፡ እስከ፡ 
