                          <item xml:id="a1">
                            <locus from="1r" to="1v"/>
                            <desc type="MagicText">Magic formula agains goiter (<foreign xml:lang="am">ምንሺሮ፡</foreign>).</desc>
                          </item>
                          
                          <item xml:id="a2">
                            <locus target="#1v"/>
                            <desc type="GuestText">The beginning of <title ref="https://betamasaheft.eu/LIT2839RepCh123">Malkǝʾa ʾIyasus</title>.</desc>                            
                          </item>
                          
                          <item xml:id="a3">
                            <locus from="1v" to="2r"/>
                            <desc type="MagicText">Prayer against side pain (<q xml:lang="gez">ውግአት፡</q>) with an invocation to magic names: Sādor, ʾAlādor, Dānāt, ʾAderāt, Rodās.</desc>
                          </item>
                          
                          <item xml:id="a4">
                            <locus target="#2v"/>
                            <desc type="MagicText"> Short  prayer agains back pain (<q xml:lang="gez">ጀርባ፡ ደዌ፡</q>.)</desc>
                          </item>
                          
                          <item xml:id="a5">
                            <locus from="83r" to="83v"/>
                            <desc type="MagicText">A magic formula for avoiding various diseases: <q xml:lang="gez"><seg part="I"/>ጸሎት፡ በእንተ፡ ሕማመ፡ ባርያ፡ ወርእስ፡ ወፍጽምት፡ መጋኛ፡ <gap reason="ellipsis"/> በኃይለ። ዝንቱ፡ አ<del rend="erasure">ስ</del>ስማቲከ፡ አድኅኖ፡ እምሀማ<supplied reason="omitted" resp="GrebTiss1935Codices">መ</supplied>፡ ባርያ፡ ወፍልጸት፡</q>.</desc>
                            <q xml:lang="gez"/>
                          </item>
                          
                          <item xml:id="a6">
                            <locus target="#83v"/>
                            <desc type="GuestText">Few words from <title ref="https://betamasaheft.eu/LIT3509Epistle">1 Joh. 1: 1-3</title>.</desc>
                          </item>
                          
                        </list>
