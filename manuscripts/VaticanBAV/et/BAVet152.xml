                    <msContents>
                      
                      <msItem xml:id="ms_i1">
                        <locus from="3r" to="62r"/>
                        <title ref="https://betamasaheft.eu/LIT3994Hymn">Hāle luyā ʾaʿattǝb wa-ʾǝtnaśśāʾ</title>
                        <incipit xml:lang="gez">ሃሌ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ አአትብ፡ ወእትነሣእ፡ በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፫አስማተ፡ ነሢአየ፡ እትመረጐዝ፡ እመኒ፡ ወደቁ፡
                        እትነሣእ፡ ወእመኒ፡ ሖርኩ፡ ውስተ፡ ጽልመት፡ እግዚአብሔር፡ ያበርህ፡ ሊተ፡ በእግዚአብሔር፡ ተወከልኩ፡</incipit>
                        <note>Biblical exerpts on <locus from="22r" to="33r"/>include: 
                           <ref type="work" corresp="https://betamasaheft.eu/LIT1558Matthew">25: 1-13</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT1793Leviti">23: 3-8</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT1019Actsof">17: 2-4</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT1693John">5: 1-11</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT3516Epistle">15: 51-16: 2</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT3509Epistle">1: 1-5</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT1019Actsof">20: 6-12</ref>
                          <ref type="work" corresp="https://betamasaheft.eu/LIT1693John">3: 1-21</ref>.</note>
                        
                        <note><ref type="work" corresp="https://betamasaheft.eu/LIT4272Salam">Salām-hymn to Our Lady Mary</ref> is added on <locus target="45v"/> .</note>
                        
                        <note>Another added text is <ref type="work" corresp="https://betamasaheft.eu/LIT2970RepCh251">Hymn to Jesus Christ</ref>. </note>
                        
                        <note>Another added text is <ref type="work" corresp="https://betamasaheft.eu/LIT3023RepCh303">Hymn to Our Lady Mary</ref>.</note>
                        
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i2">
                        <locus from="62v" to="72v"/>
                        <title type="incomplete" ref="https://betamasaheft.eu/LIT3012RepCh292">Bǝḍǝʿt ʾanti</title>
                        <incipit xml:lang="gez">ብፅዕት፡ አንቲ፡ ወንግሥተ፡ ጽድቅ፡ ዘትሜንኒ፡ ማርያም፡ መንበረ፡ ስላቅ፡ ታቦትነ፡ አንቲ፡ እንተ<supplied reason="omitted">፡</supplied> ወርቅ። ሰአሊ፡ ለነ፡ እፎኑ፡ <surplus>እ<choice><corr>ፎ</corr><orig>ሆ</orig></choice>ነ፡</surplus> ድንግል፡ <del>ነ</del>ነገሥታተ፡ ምድር፡ ተንሥኡ፨</incipit>
                        <explicit xml:lang="gez">መላእክት፡ ወሰ<add place="above">ብ</add>ዕ፡ ወእንስሳ፡ ምድር። አእዋፈ፡ ሰማይ፡ ወአሣተ፡ ባህር<supplied reason="omitted">፡</supplied> ይሴብሑኪ፡ ድንግል፡ በማኅበር። ማርያም። <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> እስመ። አብዝኃ፡ ትዕግልተ፡ ወአምፆ፡ </explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i3">
                        <locus from="68r" to="70r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT4957SebhataF">Sǝbḥāta fǝqur za-Giyorgis</title>
                        <incipit xml:lang="gez">ነአ፡ ነአ፡ ነአ፡ ጊዮርጊስ፡ እንዘ፡ ትሰርር፡ በፈረስ፡ ወነአ፡ ፍቁርየ፡ ዘልዳ፡ <add place="margin">ንጉሥ<supplied reason="omitted">፡</supplied></add> ሰአለነ፡ ናቄርብ፡ ለከ፡ ስብሐተ፡  ወጋዳ።</incipit>
                        <explicit xml:lang="gez"><expan><abbr>ጊዮር</abbr><ex>ጊስ፡</ex></expan> ነዓ፡ ርድዓኒ፡ ወሣህልከ፡ ፍጡነ፡ ይርከበኒ። በእንተ፡ ክቡር፡ አቡነ፡ ተክለ፡ ሃይማኖት፡ <add place="margin">ባህት፡</add> <sic>እመትዮጵያ፡</sic> ሰዳዴ፡ 
                          ጽልመት፡ እግዚአ፡ መናፍስት፡ ህብአነ፡ እምገጸ፡ ሞት፡ ሃሌ፡ ሉያ፡ አቡነ፡ <space reason="owner"/> መምሕር፡ ፈጻሜ፡ ትሕትና፡ <surplus>ወ</surplus>ወፍቅር፡ ዘሐረየከ፡ እግዚአብሔር።</explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i4">
                        <locus from="70r" to="70v"/>
                        <title ref="https://betamasaheft.eu/LIT7823Invocation">Invocation to various saints</title>
                        <incipit xml:lang="gez">አመንኩ፡ አመንኩ፡ በዘ<supplied reason="omitted">፡</supplied> ነበብኩ፡ ማርያ<add place="above">ም</add>፡ ብኪ፡ ተወከልኩ። በእንተ፡ ጸሎቱ፡ ቅድስት፡ ለኤዎስጣቴዎስ። 
                          አቡነ፡ ክ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">ር</supplied>ስቶስ፡ መድኀኒነ። መሃላነ፡ <del>ስ</del>ስማዕ፡ ፍጡነ፡ ሰአ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">ል</supplied>፡ ለነ፡ ገብረ፡ መንፈስ፡ ቅዱስ።</incipit>
                        <explicit xml:lang="gez">አንሥእ፡ ኃይለከ፡ ወ<choice><corr>ነ</corr><orig>ን</orig></choice>ዓ፡ አድኅነ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">ነ</supplied>፡ በእበየ፡ ስምከ፡ ክርስቶስ፡ ተማኅፀነ፡</explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i5">
                        <locus from="70v" to="71r"/>
                        <title>Invocation to Michael, Gabriel and Raphael</title>
                        <incipit xml:lang="gez">ነአ፡ ነአ፡ ነአ፡ ሚካኤል፡ ሰአሌ፡ ምህረት፡ ወመተንብል፡ ከመ፡ ውሉደ፡ ሰብእ፡ ትቤዙ፡ እመቅሠፍት፡ ወሃጕል፡ ሰአል፡ ለነ፡</incipit>
                        <explicit xml:lang="gez">ሩፋኤል፡ አፍጥን፡ ተራድኦተ፡ ከመ፡ ለሳራ፡ ወለጦብያ፡ ወለጦቢት፡ ብርሃኖሙ፡ አንተ። ሰአለነ።</explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i6">
                        <locus from="73r" to="79r"/>
                        <title ref="https://betamasaheft.eu/LIT1869Malkea#Monday">Malkǝʾa wǝddāse Māryām: Monday</title>
                        <incipit xml:lang="gez">ፈቀደ፡ እግዚእ፡ ለአዳም፡ ያግዕዞ፡ ሥጋኪ፡ ንጽሐ፡ እስመ፡ ረሰየ፡ አራዞ፡ <expan><abbr>ማርያ</abbr><ex>ም፡</ex></expan> ድሉት፡ ለምሕረት፡ ወለናዝዘ። ይቅብዓኒ፡ እፍረተ፡ ጽድቅ፡ ወያምዕዘኒ፡ አምዕዞ፡ ያማነ፡ እዴኪ፡ እዴየ፡ እኂዞ፨</incipit>
                        <explicit>ስብሐት<supplied reason="omitted">፡</supplied> ለኪ፡ ማርያም<supplied reason="omitted">፡</supplied> በኍልቈ፡ አድባር፡ ወአውግር፡ 
                          <expan>ስ<abbr/><ex>ብሐት፡</ex></expan> <expan><abbr>ለ</abbr><ex>ኪ፡</ex></expan> ማርያም<supplied reason="omitted">፡</supplied> በኍልቈ፡ ቀላያት፡ ወባሕር፡  
                          <expan>ስ<abbr/><ex>ብሐት፡</ex></expan> <expan><abbr>ለ</abbr><ex>ኪ፡</ex></expan><expan><abbr>ማርያ</abbr><ex>ም፡</ex></expan> በኍልቈ ዕፀው፡ ወሳዕር፡ 
                          <expan>ስ<abbr/><ex>ብሐት፡</ex></expan> <expan><abbr>ለ</abbr><ex>ኪ፡</ex></expan> ንግሥት<supplied reason="omitted">፡</supplied> <del unit="chars" quantity="1"/>በልሳነ፡ ኵሉ፡ ፍጡር፡ እስመ፡ ምሉዕ፡ ስብሐትኪ፡ በሰማይ፡ ወበምድር፨ </explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      
                      <msItem xml:id="ms_i7">
                        <locus from="79r" to="83r"/>
                        <title xml:lang="en" ref="https://betamasaheft.eu/LIT7824Praise">Hymn to Mary</title>
                        <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> እስመ፡ ክብርት፡ አንቲ፡ ኦእግዝእትየ፡ ማርያም፡ እምኵሉ፡ ፍጡር፡ አልቦ ዘይከብር፡ እመግዚአብሔር፡ ኦእግዝእትየ፡ ማርያም፡ እሙ፡ ለፈጣሪ፨ 
                          ኀበ፡ <add place="above">ሖርኩ፡</add> ሑሪ፡ ወኀበ፡ ኀደርኩ፡ ኅድሪ፨ ወኀበ፡ ተናገርኩ፡ ተናገሪ፡ ወኀበ፡ ወፈርኩ፡ ውፍሪ፨</incipit>
                        <explicit xml:lang="gez">ወእምኪሩቤል፡ ወሱራፌል፡ ይፈደፍድ፡ ንጽሕኪ፡ ኵሎ፡ አሚረ፡ እባርከኪ፡ ለዓለመ፡ ዓለም፡ እሴብሕ፡ ስመኪ፡ በየማነ፡ እዴኪ፡ ፍጽምየ፡ ባርኪ፨ ወበልህኒ፡ እምሰይጣን፡ ሀወኪ፡ ፀረ፡ ዚአየ፡ ይትወቀይ፡ በሰይፈ፡ ወልድኪ፨
                          ሊተ፡ <choice><corr>ለገብርኪ፡</corr><sic>ለገብርከ፡</sic></choice><del rend="erasure"/></explicit>
                        <textLang mainLang="gez"/>
                      </msItem>
                      

                      
                                          
