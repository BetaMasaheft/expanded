                    <msPart xml:id="p4">
                        <msIdentifier/>                        
                        <msContents>
                            <summary/>
                            <msItem xml:id="p4_i1">
                                <locus from="70r" to="85v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea">Malkǝʾa wǝddāse Māryām</title>
                                <textLang mainLang="gez"/>
                                <msItem xml:id="p4_i1.1">
                                    <locus from="70r" to="72r"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Monday">Malkǝʾa wǝddāse Māryām: Monday</title>
                                    <note>The hymn consists of nine stanzas. The first stanza begins as in <ref type="mss" corresp="https://betamasaheft.eu/BAVet15">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 15</ref>, f. 104v.</note>
                                    <textLang mainLang="gez"/>                                    
                                </msItem>
                                <msItem xml:id="p4_i1.2">
                                    <locus from="72r" to="76r"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Tuesday">Malkǝʾa wǝddāse Māryām: Tuesday</title>
                                    <note>The hymn consists of fifteen stanzas.</note>
                                    <textLang mainLang="gez"/>                                    
                                    <incipit xml:lang="gez">
                                        አክሊለ፡ ምክኅነ፡ አንቲ፡ እንተ፡ <choice><corr resp="bm:GrebTiss1935Codices">ኃጣእኪ፡</corr><sic>ኃጣይኪ፡</sic></choice> መምስለ፡ እስመ፡
                                        ወለድኪ፡ ለነ፡ ዘእግዚአብሔር፡ ቃለ፡ ማርያም፡ ገነት፡ ዘትጸውሪ፡ አስካለ፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p4_i1.3">
                                    <locus from="76r" to="78r"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Wednesday">Malkǝʾa wǝddāse Māryām: Wednesday</title>
                                    <note>The hymn consists of eight stanzas.</note>
                                    <textLang mainLang="gez"/>                      
                                    <incipit xml:lang="gez">
                                        <choice><corr resp="bm:GrebTiss1935Codices">ኵሉ፡</corr><sic>ኩሉ፡</sic></choice> ሠራዊተ፡ ሰማያት፡ በእንቲአ<del rend="effaced">ከ</del>ኪ፡
                                        ይብ<surplus>ብ</surplus>ሉ፡ ብፅዕት<supplied reason="omitted">፡</supplied> አንቲ፡ ሰማይ፡ ለእግዚአብሔር፡ አባሉ፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p4_i1.4">
                                    <locus from="78r" to="79v"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Thursday">Malkǝʾa wǝddāse Māryām: Thursday</title>
                                    <note>The hymn consists of seven stanzas.</note>
                                    <textLang mainLang="gez"/>          
                                    <incipit xml:lang="gez">
                                        <add place="interlinear">ዕፅ፡ እን</add>ተ፡ ርእየ፡ ሙሴ፡ በደብር፡ ምስሌኪ፡ ኮነ፡ መንገለ፡ ኅቡዕ፡ ምስጢር፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p4_i1.5">
                                    <locus from="79v" to="80v"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Friday">Malkǝʾa wǝddāse Māryām: Friday</title>
                                    <note>The hymn consists of six stanzas.</note>
                                    <textLang mainLang="gez"/>             
                                    <incipit xml:lang="gez">
                                        <add place="interlinear">ቡር<supplied reason="omitted">ክ</supplied>ት፡</add> አንቲ፡ ዘእምኔኪ፡ ሰረቀ፡ ፀሐየ፡ ቅዱሳን፡ ክርስቶስ፡ እንተ፡ በይሁዳ፡
                                        ተአውቀ፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p4_i1.6">
                                    <locus from="80v" to="83r"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Saturday">Malkǝʾa wǝddāse Māryām: Saturday</title>
                                    <note>The hymn consists of ten stanzas.</note>
                                    <textLang mainLang="gez"/>                  
                                    <incipit xml:lang="gez">
                                        ንጽሕት<supplied reason="omitted">፡</supplied> <surplus>ንጽሕት፡</surplus> ሰዓሪተ፡ ማርገም<supplied reason="omitted">፡</supplied> ወጻሕቅ፡
                                        እንበይነ፡ አዕሩግ፡ ወደቂቅ፨ <add place="interlinear">ማርያም፡</add> ድንግል፡ ማ<surplus>፡</surplus><add place="interlinear">ርያም፡</add> ማዕነቅ፡
                                        ገቦኪ፡ ሥርግው፡ በሐመልማለ፡ ወርቅ፡
                                    </incipit>
                                </msItem>
                                <msItem xml:id="p4_i1.7">
                                    <locus from="83r" to="85v"/>
                                    <title type="complete" ref="https://betamasaheft.eu/LIT1869Malkea#Sunday">Malkǝʾa wǝddāse Māryām: Sunday</title>
                                    <note>The hymn consists of nine stanzas.</note>
                                    <textLang mainLang="gez"/>        
                                    <incipit xml:lang="gez">
                                        ተሰመ<add place="interlinear">ይ</add><supplied reason="omitted">ኪ፡</supplied> ፍቅርተ፡ <add place="interlinear">ኦቡርክት፡</add> 
                                        እምአ<supplied reason="omitted">እ</supplied>ኑስ፡ አንቲ፡ ውእቱ፡ ቀመር፡ 
                                        <choice><corr resp="bm:GrebTiss1935Codices">ዳግሚት፡</corr><sic>ደግሚት፡</sic></choice> ሐዳስ፡ ማርያም፡ 
                                        ድንግ<del rend="expunctuated">ሚት</del>ል፡ ወለተ፡ ዳዊት፡ ንጉሥ፡
                                    </incipit>
                                    <explicit xml:lang="gez">
