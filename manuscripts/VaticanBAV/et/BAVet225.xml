               <msContents>
                  <summary/>
            
                  <msItem xml:id="ms_i1">
                     <title ref="https://betamasaheft.eu/LIT7940PPAynaTela">Ṣalot ba-ʾǝnta ʿāyna Ṭǝlā ʿāyna Gargāriyā ʿāyna Budā</title>
                     <note>According to the catalogue description in <bibl><ptr target="bm:GrebTiss1935Codices"/>
                        <citedRange unit="page">697</citedRange></bibl>, this prayer ends as the one in <ref type="mss" corresp="https://betamasaheft.eu/BAVet220#ms_i4">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 220: Protective prayer against the fear of demons (dǝngāḍe ʾagānǝnt
        za-maʿālt wa-za-lelit) (in ms_i4)</ref>.</note>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                        ጸሎት<supplied reason="omitted">፡</supplied>
                        በእንተ፡ ሕማመ፡ ዓይነ፡ ጥላ፡ ወዓይነ፡ <choice resp="bm:GrebTiss1935Codices">
                           <sic>ት</sic>
                           <corr>ተ</corr>
                        </choice>ጻራሪ፡ ወዓይነ፡ አገርጋር፡ ወዓይነ፡ ቡዳ፡ ወዓይነ፡ <surplus>ወ</surplus>ጠቢብ<supplied reason="omitted">፡</supplied>
                        ወዓይነ፡ <choice>
                           <sic>ቁረኛ፡</sic>
                           <corr>ቍራኛ፡</corr>
                        </choice> ወዓይነ፡ አ<choice resp="bm:GrebTiss1935Codices">
                           <sic>ጋ</sic>
                           <corr>ገ</corr>
                        </choice>ርጋር፡ ወዓይነ፡ ባለ<supplied reason="omitted">፡</supplied> 
                        ጋራ፡ ወዓይነ፡ ነሃቢ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                        ቃለ፡ እግዚአብሔር፡ ይመትር፡ ነደ፡ እሳት፡ 
                     </incipit>
                     </msItem>
              
                  <msItem xml:id="ms_i2">
                     <title ref="https://betamasaheft.eu/LIT5888AsmatPrayer">Magic prayer against an eye disease, Zār, pleurisy, and other evil spirits and illnesses</title>
                     
                     <incipit xml:lang="gez"><del rend="erasure">በስመ፡</del> አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ። ሕማመ፡ ለፌራ<supplied reason="omitted">፡</supplied>
                        ወለንዳድ፡ ሕማመ፡ ዓይነ፡ ወርቅ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                        በሎፍሃም፡ ስምከ፡</incipit>
                     <explicit xml:lang="gez">ዛር፡ ውላጅ፡ እሰር፡ ለአይነት፡ ወለፍልፀት፡ ወከንትር፡</explicit>
                  </msItem>
                  
               </msContents>
          
