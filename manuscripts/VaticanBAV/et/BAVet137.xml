                    <msContents>
                        <msItem xml:id="ms_i1">
                            <locus from="5r" to="54v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT1019Actsof">Gǝbra ḥawāryāt</title>
                            <incipit xml:lang="gez" type="inscriptio">
                                <locus target="#9r"/>
                                መጽሐፈ፡ ግብረ፡ ልዑካን፡ ዝንቱ፡ ውእቱ፡ ዜና፡ ሐዋርያት፡ ንጹሐን፨ እምጊዜ፡ ዕርገቱ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘጸሐፈ፡ ሉቃስ፡ ወንጌላዊ፡ ወፈነወ፡ ኀበ፡ ታኦፊላ፡ ዘውእቱ፡ መፍቀሬ፡ እግዚአብሔር፡ ብሂል፨ ዝውእቱ፡ ዘጸሐፈ፡ ሎቱ፡ ቀዲሙ፡ ወንጌለ፡ ወዘንተኒ፡ ዳግመ፨
                            </incipit>
                            <explicit xml:lang="gez">
                                <locus target="#54v"/>
                                ወተሠወረ፡ እምኔሁ፡ እስመ<supplied reason="omitted">፡</supplied>    
                                <choice><corr resp="bm:GrebTiss1935Codices">አንተሰ፡</corr><sic>እንተሰ</sic></choice>
                                ትረክብ፡ በቀዳሚ፡ ፈካሬ፡ መልእክታተ፡ ጳውሎስ፨ እስመ፡ ውእቱ፡ ቦአ፡ ኀበ፡ <choice><corr resp="bm:GrebTiss1935Codices">ኔሮን፡</corr><sic>ኒሮን</sic></choice>
                                  በቀዳሚ፡ ጊዜ፡ ሞአ፡ ወሖረ፡ በሰላም፨ ወነበረ፡ እምድኅረዝ፡ ኑኃ፡ ፪ዓመታት፡ ወወፅአ፡ ወእምዝ፡ ተመይጠ፡ ወአጥመቀ፡ አዝማዲሁ፡ ለ<surplus>፡</surplus>ኔሮን፨ ወስምዓ፡ ኮነ፡ በእዴሁ፡ በሰይፍ፡ ዕጉሥ<supplied reason="omitted">፡</supplied> ወስብሐት፡ ለእግዚአብሔር፡ ለዓለመ፡ ዓለም፡ አሜን፨ 
                            </explicit>
                            
                            <msItem xml:id="ms_i1.1">
                                <locus from="5r" to="7r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT1019Actsof#Introduction">Gǝbra ḥawāryāt:  Introduction</title>
                                <incipit xml:lang="gez">
                                    <locus target="#5r"/>
                                    በስመ፡ አብ፡ <gap reason="ellipsis"/> ንቀድም፡ በረድኤተ፡ እግዚአብሔር፡ ወስንዓ፡ ሀብቱ፡ ተርጕሞ፡ ግብራተ፡ ሐዋርያት፡ ዘይሰመይ<supplied reason="omitted">፡</supplied> በጽርዕ፡ እብረክሲስ፨ ወንጽሕፍ፡ ቅድመ፡ ምክንያተ፡ ጽሒፎተ፡ ሉቃስ፡ ወንጌላዊ፡ ለዝንቱ፡ መጽሐፍ፨ ወንስእል፡ መርሐ፡ እግዚአብሔር፡ በእንተ፡ ዘከመ፡ ጸሐፈ፡ ክቡር፡ ሉቃስ፡ ውስተ፡ ወንጌል፡ ሥርዓተ፡ ግብሩ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በሥጋ፡ ወእንሶስዎቶ፡ በምድር፨ ወዘከመ፡ አዘዘ፡ ለአርድእት፡ እምድኅረ፡ ተንሥአ፡ እሙታን፡ ከመ፡ ይጸውዑ፡ ኵሎ፡ ሰብአ፡ ኀበ፡ አሚን፡ ቦቱ፨
                                </incipit>
                                <explicit xml:lang="gez">
                                    ወዜነዎሙ፡ ለአሕዛብ፡ እለ፡ ህየ፡ ስብከተ፡ ዘበክርስቲያን፡ ወረሰየ፡ ዜና፡ ግብሩ፡ ለጳውሎስ፡ ውስተ፡ ብዙኅ፡ ክፍላት፡ እስከ፡ ፈጸመ፡ መጽሐፈ፡ ወረሰየ፡ ርእሰ፡ መጽሐፉ፡ ከመዝ፡ ወስብሐት፡ ለእግዚአብሔር፡ ለዝሉፉ፡ አሜን፡ ወአሜን፨
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="7r" to="7v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT1019Actsof#TituliActs">Gǝbra ḥawāryāt: Tituli of the Acts of the Apostles</title>
                                <incipit xml:lang="gez">
                                    አርእስት፡ ምንባቦት፡ ዘልዑካን፡ አርድእት። ፩ቀዳሚሁ፡ ለነገር፡ ፪ወውእተ፡ አሚረ፡ ተንሥአ፡ ጴጥሮስ፨ ፫ወመጽአ፡ ግብተ፡ እምሰማይ፨
                                </incipit>
                                <explicit xml:lang="gez">
                                    ፷፮<supplied reason="omitted">፡</supplied> ወእምድኅረ፡ ብዙኅ፡ መዋዕል፨
                                    ፷፯<supplied reason="omitted">፡</supplied> ወአመ፡ አሡር፡ ወረቡዕ፡ ሰኰይነ፤
                                    ፷፰<supplied reason="omitted">፡</supplied> ወእምድኅረ፡ ፫ዕለት፡ ለአከ፡ ጳውሎስ፨
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">
                                <locus from="7v" to="8r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT1019Actsof#NoteLuke">Gǝbra ḥawāryāt: Note on Luke</title>
                                <incipit xml:lang="gez">
                                    ወዝንቱ፡ ሉቃስ፡ ኮነ፡ ሀገሩ፡ አንጾኪያ፡ ወይእቲ፡ እምድረ፡ ሶርያ፡ እምርት፡ እምካልአኒሃ፨ ወበጽሒፈ፡ ብስራተ፡ ወንጌልሂ፡ ተበፅዓ፡ እስመ፡ ውእቱ፡ ኮነ፡ ዐቢይ፡ ዓቃቤ፡ ሥራይ፡ በውስተ፡ አንጾኪያ፨
                                </incipit>
                                <explicit xml:lang="gez">
                                    <sic>ነአምር፡</sic> ርቱዓ፡ ከመ፡ ይኩን፡ መድኃኒተ፡ ነፍስ፡ በቃላቲሁ፡ እምአሜ፡ ልደቱ፡ በ፹ዓም፡ አዕረፈ፨
                                </explicit>
                            </msItem>
                            <msItem xml:id="ms_i1.4">
                                <locus target="#8r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT7651Regions">On some
          foreign regions compared with those in Ethiopia</title>
                                <incipit xml:lang="gez">
                                    ምጣኔ፡ ሀገር፨ ከመ፡ ፈጠጋር፡ ፋርስ፨ ከመ፡ ደዋሮ፡ ወበሊ፡ ባቢሎን፨ ከመ፡ <sic>አደል፡</sic> ሕንደኬ፨
                                </incipit>
                            </msItem>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">                        
                            <locus from="55r" to="169v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT3505PaulineEpis">Pauline Epistles</title>
                            <msItem xml:id="ms_i2.1">
                                <locus from="55r" to="56r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT4664Introduction#Romans">Maqdǝma Ṗawlos ḥawāryā: Introduction to the epistle to the Romans</title>
                                <incipit xml:lang="gez">
                                    መቅድመ፡ ጳውሎስ፡ ሐዋርያ፡ ምክንያተ<supplied reason="omitted">፡</supplied> መልእክቱ፡ ለሮማውያን፨ በእንተ፡ 
                                    <choice><orig>፪ክብር፡</orig><corr>፪ግብር፡</corr></choice> 
                                    ብዙኅ። እስመ፡ በሮሜ፡ ነበሩ፡ አይሁድ፡ ወአረሚ፡ ኅቡረ፡ ወ፪ሆሙ፡ ተወክፉ፡ አሚነ፡ በክርስቶስ፨ ወድኅሬሆሙ፡ <sic>ተቀሐዉ፡</sic> በበይናቲሆሙ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ወጳውሎስ፡ ሜጦሙ፡ እምዝንቱ፡ ስሕተት፡ ውስተ፡ አሚነ፡ ወንጌል፡ ርትዕት፨ ወጸሐፈ፡ ሎሙ<supplied reason="omitted">፡</supplied> ዘንተ፡ መልእክተ፡ እንዘ፡ ሀሎ፡ በቆሮንቶስ፡ ወፈነዋ፡ በእደ፡ ፌቤን፡ <supplied reason="omitted">እንተ፡</supplied> <sic>ተለአከተ<supplied reason="omitted">፡</supplied></sic> ቤተ፡ ክርስቲያን፡ ዘከንክርኤስ፨
                                </explicit>
                            </msItem> 
                            
                            <msItem xml:id="ms_i2.2">
                                <locus target="#56r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT4664Introduction#Corinthians1">Maqdǝma Ṗawlos ḥawāryā: Introduction to the first epistle to the Corinthians</title>
                                <incipit xml:lang="gez">
                                    ምክንያተ፡ ጽሒፎቱሰ፡ <sic>መልእክተ፡</sic> በቀዳማዊ፡ ቆሮንቶስ፡ ዘውእቱ፡ እስመ፡ ይቤ፡ ሰሎሞን፡ በተግሣጽ፡ ነገረ፡    <choice>
                                        <sic>ልቢባን<supplied reason="omitted">፡</supplied></sic>
                                        <corr resp="bm:GrebTiss1935Codices">ጠቢባን<supplied reason="omitted">፡</supplied></corr>
                                    </choice> ከመ፡ ፈትል፡ ቀኖት፨ ወዲዮናስዮስኒ፡ አርዮስ፡ ፋጎስ፡ ይቤ፡ መላእክት፡ እለ፡ ቅሩባን፡ ኀበ፡ እግዚአብሔር፡ <sic>የአምሩ፡</sic> ፈቃደ፡ ዚአሁ፨
                                </incipit>
                                <explicit xml:lang="gez">
                                    ሔጥዎሙ፡ ካልአን፡ በተጥባበ፡ ነገር፡ ወበትምህርተ፡ አይሁድ፨ ወሶበ፡ አእመረ፡ ዘንተ፡ ቅዱስ፡ ጳውሎስ፡ እንዘ፡ ሀሎ፡ በኤፌሶን፨ ጸሐፈ፡ ሎሙ፡ ዘንተ፡ መልእክተ፡ በእደ፡ ጢሞቴዎስ፡ ፈነዋ፡ ከመ፡ ይሚጦሙ፡ በዝንቱ፡ ውስተ፡ ፍኖተ፡ ወንጌል፡ ርትዕት፨ ወሃይማኖት፡ ክርስቶስ፨
                                </explicit>
                            </msItem>
                            
                            <msItem xml:id="ms_i2.3">
                                <locus from="56r" to="56v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT4664Introduction#Corinthians2">Maqdǝma Ṗawlos ḥawāryā: Introduction to the second epistle to the Corinthians</title>
                                <incipit xml:lang="gez">
                                    አንብሮተ፡ መፍቅዱ፡ ዳግም፡ ቆሮንቶስ<supplied reason="omitted">፡</supplied> እስመ፡ ለመልእክቱ፡ ቀዳሚት፡ ቦእምኔሆሙ፡ ዘተወክፉ፡ ፍጡነ፨ ወቦ፡ ዘተሐከዩ፡ በተአዝዞቶሙ፡ ለሐሳውያን፡ ሐዋርያት፨ በዛቲ፡ ምክንያት፡ ጸሐፈ፡ ሎሙ፡ ዘንተ፡ መልእክት፨
                                </incipit>
                                <explicit xml:lang="gez">
                                    ይንዕዶሙ፡ በተወክፎ፡ ትምህርቱ፡ ወዓዲ፡ <choice>
                                        <sic>ይንግሮሙ፡</sic>
                                        <corr resp="bm:GrebTiss1935Codices">ይነግሮሙ፡</corr>
                                    </choice> ከመ፡ ይጽንዑ፡ ላዕለ፡ ትእግሥት፡ ጸሐፈ፡ ሎሙ፡ በጢሮዓዳ፡ ወፈነወ፡ በእደ፡ ቲቶ፨
                                </explicit>
                            </msItem>
                            
                            <msItem xml:id="ms_i2.4">
                                <locus target="#56v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT4664Introduction#Galatians">Maqdǝma Ṗawlos ḥawāryā: Introduction to the epistle to the Galatians</title>
                                <incipit xml:lang="gez">
