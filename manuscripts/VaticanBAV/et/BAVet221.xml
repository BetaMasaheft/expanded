                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <title ref="https://betamasaheft.eu/LIT1878Marbab">Marbabta Salomon</title>
                            <note>According to the catalogue description in <bibl><ptr target="bm:GrebTiss1935Codices"/>
                                    <citedRange unit="page">692–694</citedRange></bibl>, this magic
                                prayer is similar or identical to the one edited in <bibl><ptr target="bm:Euringer1928NetzSalomons"/><citedRange unit="page">178–182</citedRange></bibl>.</note>
                            <explicit xml:lang="gez">ወካዕበ፡ ደገመ፡ ወእስተርእየ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ሰሎሞን፡ ዘንተ፡ ሎፍሐም፡
                                ኢየሑክ፡ ኢዮርሳዊት፡ እንዘ፡ <supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ይብል፡ እውጽአ፡ ልሳኖ፡ በእመተ፡
                                መልአክ፡ ወአተበ፡ ሰሎሞን፡ እንዘ፡ ይብል፡ መርመራ።</explicit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title ref="https://betamasaheft.eu/LIT7866GodSalomon">Wa-ʾǝmdǝḫra ʾaḫazǝwo la-Salomon wa-ʾanbarǝwo la-Salomon</title>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አአትብ፡ ገጽየ፡
                                እምብዝኃ፡ ድንጋፄ፡ ምንት፡ ይመስል፡ ፍጥረቶሙ፡ ለነሀብት፡ ርኩሳን፡ ወጽዩአን፡ ከመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                ኢይምጽኡ፡ ኀቤየ፡ ተማኅፀንኩ፡ <supplied reason="omitted" resp="bm:GrebTiss1935Codices">ለ</supplied>ገብርከ፡ መኩሯው፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title ref="https://betamasaheft.eu/LIT7758PPLofham">Prayer against Bāryā and Legewon, colic, migraine, Maggaññā, etc.</title>
                            <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> በሎፍሐም፡ ስምከ፡ ተማኅፀንኩ፡ ከመ፡
                                    እርብቦሙ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ወዕዝብጦሙ፡ ለደስክ፡ ወለጉዳሌ፡ ወለስራይ፡ ወለኵሎሙ፡ መናፍስ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ተ</sic>
                                    <corr>ት</corr>
                                </choice><supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ርኩሳን፡ ከመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ኢይምጽኡ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ኀቤየ፡
                                    መናፍስ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ተ</sic>
                                    <corr>ት</corr>
                                </choice><supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ርኩሳን፡ </incipit>
                            <explicit xml:lang="gez">ወከመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ኢይንበሩ፡ <choice resp="bm:GrebTiss1935Codices">
                                    <sic>በትራስየ፡</sic>
                                    <corr>በትርአስየ፡</corr>
                                </choice> ወበትርጋፅየ፡ ወኢይቅረቡኒ፡ ላዕሌየ፡ ተማኅፀንኩ፡ አነ፡ ገብርከ፡ መኩሯው፡ ለዓለመ፡ ዓለም፡
                                አሜን፡</explicit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <title ref="https://betamasaheft.eu/LIT7936PPDawitKebron">Ṣalot za-ṣalaya Dāwit ba-hagara Kebron</title>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ጸሎት፡
                                ዘጸለየ፡ ዳዊት፡ በሀገረ፡ ኬብሮን፡ በቄላት፡ ኤላ፡ <sic>ኢሙሴሂ</sic>፡ ገላው<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ዳ</sic>
                                    <corr>ዴ</corr>
                                </choice>ዎን፡ <del rend="erasure">ወነትዑ፡ ፀር፡ ከማሁ፡</del>
                                <choice resp="bm:GrebTiss1935Codices">
                                    <sic>ወሚጣ፡</sic>
                                    <corr>ወሜጠ፡</corr>
                                </choice> ሰይፈ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <sic resp="ESh">ገላውዴዎን፡</sic> ወነትዑ፡ ፀር፡ ከማሁ፡ <supplied reason="omitted" resp="bm:GrebTiss1935Codices">አ</supplied>ንትዖሙ፡
                                ለፀርየ፡</incipit>
                            <explicit xml:lang="gez">ማዕሠሮሙ፡ ለአጋንንት፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወለኵ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">ሎ</supplied>ሙ፡ ጣዖታት፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ተማኅፀንኩ፡
                                    ከመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ታድኅነኒ፡ ሊተ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> ለገብርከ፡ መኩራው<supplied reason="omitted" resp="bm:GrebTiss1935Codices">።</supplied></explicit>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <title>Prayer for the wisdom of David and Solomon</title>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> እነግረክሙ፡ ጥበበ፡
                                እግዚአብሔር፡ ዘወሀቦ፡ ለዳዊት፡ ገብሩ፡ ወለሰሎሞን፡ ወልዱ፡ መድኃኒት፡ ወሞገስ፡ ወሥልጣን፡ ወአንተኒ፡
                                ለእመ፡ ኮንከ፡ ጠቢበ፡ ዕቀብ፡ ዘንተ፡ ጸሎት፡</incipit>
                            <explicit xml:lang="gez">ወይትሜሰሉ፡ ዝዕበ፡ ወ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ቁ</sic>
                                    <corr>ቍ</corr>
                                </choice>ንጽለ፡ ወሆባየ፡ እለ፡ ኢይነውሙ፡ በመዓልት፡ ወበሌሊት፡ በእንተ፡ ዘጋኔን፡ </explicit>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <title ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer (general record)</title>
                            <incipit xml:lang="gez">በስመ፡ <surplus>መ</surplus>አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡
                                እኩያን፡ ሚር፡ ምርድ፡ ዮሳብ<hi rend="expunct">ዕ</hi>ድ፡ ዮፍታ<supplied reason="omitted" resp="ESh">ሔ</supplied>፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> በዝንቱ፡ አስማት፡ ተማኅፀንኩ፡ አነ፡
                                ገብርከ፡</incipit>


                        </msItem>
                        <msItem xml:id="ms_i7">
                            <title ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer (general record)</title>
                            <incipit xml:lang="gez">በስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አብ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዮፍታሔ፡ ንንዋኤል፡
                                ትኤል፡ አዝዮን፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                                ሂራዳኤል፡ ዱድያ፡ በዝንቱ፡ አስማቲከ፡ ተማኅፀንኩ፡ ለዓለመ፡ ዓለም፡ አሜን፡ አድኅኖ፡ ለገበርከ፡
                                    አስመ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አልቦ፡ ነገር፡ ዘይስአኖ፡ ለእግዚአብሔር፡</incipit>
                        </msItem>
