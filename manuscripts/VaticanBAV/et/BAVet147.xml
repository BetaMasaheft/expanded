                      <additions>
                        
                        <list>
                          <item xml:id="a1">
                            <locus from="1r" to="2v"/>
                            <desc type="ProtectivePrayer">Prayer to Mary</desc>
                            <q xml:id="gez">
                              በስመ፡ አብ፡ <gap reason="omitted"/>ኦእግዚእየ፡ ኢየሱስ<supplied reason="omitted">፡</supplied> ክርስቶስ፡ በእንተ፡ ማርያም<supplied reason="omitted">፡</supplied> ወላዲትከ፡ ርድአኒ<supplied reason="omitted">፡</supplied> ኦእግዚእየ፡ 
                                ኢየሱስ፡ ክርስቶስ<supplied reason="omitted">፡</supplied> በእንተ፡ ማርያም<supplied reason="omitted">፡</supplied>  ወላዲትከ፡ ተሣሃለኒ<supplied reason="omitted">፡</supplied> ኦእግዚእየ<supplied reason="omitted">፡</supplied> ኢየሱስ፡ ክርስቶስ፡ በእንተ<supplied reason="omitted">፡</supplied> ማርያም፡ ወላዲትከ፡ ውስተ፡
                              ከብካብከ፡ ኈልቈኒ፡ <gap reason="omitted"/>
                              ዕቀባ፡ ወኢትግድፋ፡ ለነፍስየ፡ ኢየሱስ፡ ክርስቶስ፡ ተሣሃላ፡ ወኢ<supplied reason="omitted">ት</supplied>ግድፋ፡ ለነፍስየ፡ <surplus>ለ<del>ነ</del>ፍስየ፡</surplus> ኢየሱስ፡ ክርስቶስ፡ 
                                እምርስሐተ፡ ኃጢአትየ፡ አንጽሓ፡ ለነፍስየ፡ ኢየሱስ፡ ክርስቶስ፡ <sic>ሣሀልከ፡</sic> ፈኑ፡ ሊተ፡ ለገብርከ፡ <persName role="scribe" ref="https://betamasaheft.eu/PRS15222TaklaAb">ተክለ<supplied reason="omitted">፡</supplied> አብ፡</persName> ለዓለመ፡ ዓለም፡ አሜን።
                            </q>
                           </item>
                          
                          <item xml:id="a2">
                            <locus target="2r"/>
                            <desc type="ScribalSupplication"/>
                            <q xml:lang="gez">ለዛቲ፡ መጽሐፍ፡ አነ፡ ጸሐፍክዋ፡ ተዘኪርየ<supplied reason="omitted">፡</supplied> <persName role="scribe" ref="https://betamasaheft.eu/PRS15222TaklaAb">ተክለ፡ አብ፡</persName> ከመ፡ ይዕቀቡኒ፡ ለዓለመ፡ ዓለም። ወለጸሐፊሁኒ፡ <choice><corr resp="bm:GrebTiss1935Codices">ኢትርስኡኒ።</corr><sic>ኢትርሰአኒ፡</sic></choice></q>
                          </item>
                          
                          <item xml:id="e1">
                            <desc>The name of the first owner has been erased. The names of later owners are: <persName ref="https://betamasaheft.eu/PRS15223NezhataDam">Nǝzḫata Dam</persName>, 
                              <persName ref="https://betamasaheft.eu/PRS15224WaldaKiros">Walda Kiros</persName> and <persName ref="https://betamasaheft.eu/PRS15225WaldaSellase">Walda Śǝllāse</persName>.</desc>
                          </item>
                          
