                    <msContents>
                      <summary/>
                      
                      <msItem xml:id="ms_i1">
                       <locus from="3r" to="112r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano">ʾArgānona wǝddāse</title>
                        <note>The readings for each day are preceded with  a short introduction.</note>
                        <textLang mainLang="gez"/>
                        
                        
                        <msItem xml:id="ms_i1.1">
                          <locus from="3r" to="21r"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Monday">ʾArgānona wǝddāse: for Monday</title>
                          <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.2">
                          <locus from="21v" to="39r"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Tuesday">ʾArgānona wǝddāse: for Tuesday</title>
                          <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ አብ፡ ለስንኪ፡ ዘአፍቅሮ። ወበስመ፡ እግዚአብሔር፡ ወልድ፡ ዘ<add place="above">ረ</add>ሰየኪ፡ ማኅደሮ። ወበስመ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ዘወጥሃ፡ ዲቤኪ፡ ብርሃነ<supplied reason="omitted">፡</supplied> ስብሐቲሁ፡ ወምእዛሮ፡ እስእለኪ፡ ኦእግዝእትየ።</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.3">
                          <locus from="39v" to="57v"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Wednesday">ʾArgānona wǝddāse: for Wednesday</title>
                          <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ አብ<supplied reason="omitted">፡</supplied> ዘአሰርገወኪ፡ ንጽሐ፡ ወ<surplus>ወ</surplus>ጽድቀ፨ ወበስመ፡ እግዚአብሔር፡ ወልድ፡ እምከርሥኪ፡ ዘሠረቀ። ወበስመ፡ እግዚአንሔር፡ መ<surplus>መ</surplus>ንፈስ፡ ቅዱስ፡ ዘረሰየኪ፡ ምርፋቀ። <sic>ወአስተበቁአኪ፡ </sic>ኦእግዝእትየ፡</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.4">
                          <locus from="58r" to="77r"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Thursday">ʾArgānona wǝddāse: for Thursday</title>
                          <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ አብ፡ ዘሃረየኪ፡ ከመ፡ ትኩኒዮ<surplus>ሙ </surplus>፡ መ<add place="above">ር</add>አተ፨ 
                            ወበስመ፡ እግዚአብሔር፡ ወልድ፡ ዘሠምረ፡ እምኔኪ፡። <choice><corr resp="bm:GrebTiss1935Codices">ተሰግዎተ።</corr><sic>ተሰግወተ።</sic></choice> ወበስመ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ <choice><corr resp="bm:GrebTiss1935Codices">ዘረሰየኪ፡ ታቦተ።</corr><sic>ዘረሰየከ፡ ታቦት።</sic></choice> ዕስእለኪ፡ ኦእግዝእትየ።</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>

                        <msItem xml:id="ms_i1.5">
                          <locus from="77v" to="93v"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Friday">ʾArgānona wǝddāse: for Friday</title>
                          <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ አብ፡ በቅድስና። ወበንጽሕ፡ ሥጋ፡ ዚአኪ<supplied reason="omitted">፡</supplied> ዘአነመ፡ ወበስመ፡ እግዚአብሔር፡ ወልድ፡ ዘረሰየኪ፡ እመ። ወ<surplus>ስ</surplus>በስመ<supplied reason="omitted">፡</supplied> እግዚአብሔር፡ 
                            መንፈስ<supplied reason="omitted">፡</supplied> ቅዱስ፡ ጽላሎተ፡ <choice><corr>ዲቤኪ<supplied reason="omitted">፡</supplied></corr><sic>ዲቤከ<supplied reason="omitted">፡</supplied></sic></choice> ዘሤመ። ዕስእለኪ፡። ኦእግዝእትየ፡</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.6">
                          <locus from="93v" to="102v"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Saturday">ʾArgānona wǝddāse: for Saturday</title>
                          <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ አብ<supplied reason="omitted">፡</supplied> ንጽሐ፡ <surplus>ዚአ፡</surplus> ዚአኪ፡ ዘአ<add>ፍቀረ፡</add>
                            ወበስመ፡ እግዚአብሔር፡ ወልድ<supplied reason="omitted">፡</supplied> ውስተ፡ ክርሥኪ፡ ዘኃደረ<supplied reason="omitted">፡</supplied> 
                            ወበስመ፡ እግዚአብሔር<supplied reason="omitted">፡</supplied> መንፈስ፡ ቅዱስ፡ <sic>ጽላሎትኪ፡</sic> ዘሠምረ። እባርከኪ<supplied reason="omitted">፡</supplied> ኦእግዝእትየ።</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.7">
                          <locus from="102v" to="112r"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1146Argano#Sunday">ʾArgānona wǝddāse: for Sunday</title>
                          <incipit xml:lang="gez">ብስ<surplus>ስ</surplus>መ፡ እግዚአብሔር<supplied reason="omitted">፡</supplied> አብ፡ ቀርነ፡ መንግሥትኪ፡ እስከ፡ አርያም፡ ዘአ<surplus>ዘአ</surplus>ንኀ፡ 
                            ወበስመ፡ እግዚአብሔር፡ ወልድ፡ ዘተፀውረ፡ በከርሥኪ፡ ፱አውራኃ።
                            ወበስመ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ፍናዊኪ፡ ዘሰርሐ። አቄርብ፡ ለኪ፡ ዓ<choice><corr resp="bm:GrebTiss1935Codices">ሶ</corr><sic>ሳ</sic></choice>ተ፡ ውዳሴ፡ ብዙኃ።</incipit>
                          <textLang mainLang="gez"/>
                        </msItem>

                          </msItem>
                      
