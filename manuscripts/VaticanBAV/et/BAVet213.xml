                        <msItem xml:id="ms_i5">
                            <locus target="#1v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7845Prayer">Prayer against stomach ache</title>
                            <textLang mainLang="gez"/>
                            <note>The following is the entire text.</note>
                            <incipit xml:lang="gez">
                                በስመ<supplied reason="omitted">፡</supplied> አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ቁርቁር፡ ቁርቁር፡ ቁርቁር፡ ቁርቁር፡ 
