                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራ<supplied reason="omitted">ይ</supplied>፡
                                ወጽላ<supplied reason="omitted">፡</supplied> <sic><del rend="effaced">ዋ</del>ጊ፡</sic> ወዘቅማ<surplus>ም</surplus>ንት፡ ወዘአምሐራ፡ ወእጀ፡ 
                                <supplied reason="omitted">ሰብእ፡</supplied> ከናንህ፡ ከን<add place="interlinear">ን</add>ህ<supplied reason="omitted">፡</supplied> 
                                ከን<add place="interlinear">ን</add>ህ፡ ከናንህ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                መክን፡ መክን፡ መክን፡ አውክክ፡ አውክክ፡ አውክክ፡ ውሹሕ፡ ውሹሕ፡ ውሹሕ፡ ውሹሕ፡ ፍታሕ፡ ተፈታሕ<supplied reason="omitted">፡</supplied> 
