                    <msContents>
                        <msItem xml:id="ms_i1">
                            <locus from="3r" to="8v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7270PrayerUCh">Ṣalot baʾǝnta maftǝḥe śǝrāy</title> 
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ ሩኵ፡ አልቍድሳ፡ ኤላነንህባ፨ ሰላም፡ ለስእርተ፡
                                ርእስከ፡ ዘስሙር፡ አብቋሉ፡ <sic>ሰዳር፡</sic> ወጽፉቅ፡ ጥቀ፡ ለአርዘ፡ ሊባኖስ፡ አምሳለ፡ ቈጽሉ፡ <add place="above">አላዶር፤</add> ኢየሱስ፡ ክርስቶስ፡ ሊቀ፡
                                ካህናት፡ ዘላዕለ፡ ኵሉ፤ <add place="interlinear">ዳናት፤</add> <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አዴራ፡ 
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ሮዳስ፨ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዝቅ<surplus>ቅ</surplus>ንዋት፡
                                መግረሬ፡ ሥራይ፡ ውእቱ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/>
                            </incipit>
                            <explicit xml:lang="gez">
                                አንተ፡ ውእቱ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ዘትፈትሕ፡</corr><sic>ዘት<del rend="expunctuated">ት</del>ትፈታሕ፡</sic></choice> 
                                ኵሎ፡ ሥራያተ፡ ጅጅጅዋል፡ ዘአረሚ፡ ወዘክርስቲያን፡ ዘቀሲስ፡ ወዘዲያቆን፡ ቀርበ<supplied reason="omitted">፡</supplied> ጁጁን፡ ፍታሕ፡ እምላዕለ፡ ገብርከ፡
                                <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀል፡</persName>
                            </explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <locus from="8v" to="9v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7798PPrayer">Prayer for undoing charms</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዋህድ፡ ተፈታሕ፡ አሌፍ፡ ወኢብን፡ ዋህድ፡ ተፈታሕ፡ ቤት፡ አል፡ ዕንቁ፡ 
                                አል<surplus>፡ </surplus>ቁድስ፡ ዋህድ፡ ተፈታሕ፡ ዳሌጥ፡ ክንበሬን፡ ዋህድ፡ ተፋታሕ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ዘአንሣእኮ፡ <sic>ለአላዛር፡</sic> እምከርሠ፡ መቃብር፡ ከማሁ፡ አንሥእ፡ አዕምሮ፡ ህሊናየ፡ ወአዕምሮ፡ ሥጋየ፡ ወልቡናየ፡ ለገብርከ፡ 
                                <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀ<supplied reason="omitted">ል</supplied>።</persName>
                            </explicit>
                        </msItem>
                        
                            <msItem xml:id="ms_i3">
                                <locus target="#9v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7799PrayerDeath">Prayer for the hour of death</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ሽሽርአ፡ ኵኰናሽር፡ ለእመ፡ ወድቀ፡ በድነ፡ ሥጋየ፡ 
                                    <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ከማሁ፡ አንቅህ፡ አዕምሮ፡ ህሊናየ፡ ወሥጋየ፡ ወልቡናየ፡ ለገብርከ፡ 
                                    <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀ<supplied reason="omitted">ል</supplied>፡</persName>
                                </incipit>
                            </msItem>
                        
                            <msItem xml:id="ms_i4">
                                <locus from="9v" to="11v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7800PrayerCharms">Prayer against charms</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ለፍን፡ ወለፈን፡ ፍልፍላኤል፡ ዘርዝርናኤል፡ ዘርዝር፡ አስማተ፡ ወሥራያተ፡ ፍታሕ፡
                                    እምላዕለ፡ ገብርከ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ<supplied reason="omitted">፡</supplied>
                                        <expan><ex>መስቀ</ex><abbr>ል፡</abbr></expan></persName> እስመ፡ አልቦ፡ ነገር፡ 
                                    ዘኢ<supplied reason="omitted">ይ</supplied>ሰአኖ፡ ለእግዚአብሔር፡ ወኵሉ፡ ይትከኃለከ፡ አምላከ፡ አናንያ፡ ወአዛርያ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ሸለሚሽ፡ ሸርማቅ። ቱርማ<del rend="expunctuated">ር</del>ቅ፡ ፍታሕ፡ ወዘርዝር፡ ሰዓር፡ 
                                    ወ<supplied reason="omitted">አ</supplied>መ<surplus>ን</surplus>ዝ<supplied reason="omitted">ብ</supplied>ር። ኵሎ፡ አስማተ፡ ወሥራያተ፡ እምላዕለ፡
                                    ገብርከ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀ<supplied reason="omitted">ል</supplied>፡</persName> እስመ፡ አልቦ፡ ነገር፡ 
                                    ዘ<add hand="#h2">ይ</add>ሰአ<choice><orig>ሎ</orig><corr>ኖ</corr></choice>፡
                                    ለእግዚአብሔር፡ ለዓለም፡ ዓለም፡ አሜን። ወአሜን። 
                                </explicit>
                            </msItem>
                        
                            <msItem xml:id="ms_i5">
                                <locus from="11v" to="12v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7801PrayerCharms">Ṣalot baʾǝnta maftǝḥe śǝrāy</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ 
                                    <supplied reason="omitted">ይትፈታሕ፡</supplied> ሥራየ፡ አረሚ፡ ወአምሐራ፡ ይትፈታሕ፡ ሥራየ፡ ጋላ፡ ወሻ<add place="interlinear">ን</add>ቅላ፡ ወዢራ፡
                                    ይትፈታሕ<supplied reason="omitted">፡</supplied> ሥራየ፡ እስላም፡ ወክርስቲያን፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    ፍታሕ፡ ወዘርዝር፡ ሰዓር፡ ወ<supplied reason="omitted">አ</supplied>መዝብር፡ ኵሎ፡ ሥራየተ፡ ወአስማተ፡ ፍታሕ፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">እምእደ፡</corr><sic>እምእጀ፡</sic></choice> ሰብእ፡ ወጽላ፡ ወጊ፡ ወአልጉም፡ ለገብርከ፡ 
                                    <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀል።</persName>
                                </explicit>
                            </msItem>
                        
                            <msItem xml:id="ms_i6">
                                <locus from="12v" to="14r"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7802PPrayer">Ṣalot baʾǝnta maftǝḥe śǝrāy</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ አክርምና፡ አክርምና። አክርምና፡ ፍታሕ፡ ፍሎና፡
                                    ፍሎና፡ ፍሎና፡ ፍታሕ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    በዘአሠርከ፡ ቃል፡ ፀሐየ፡ ወወርኃ፡ በዘአሠርከ፡ <choice><corr resp="bm:GrebTiss1935Codices">ቃል፡</corr><sic>ቃለ፡</sic></choice> ኵሎሙ፡
                                    <sic>መሠርያን፡</sic> ጵልሐምሐም፡ ድልቅያም፡ አግያዊ፡ አሚስ፡ ፍታሕ፡ ኤልሳዕ፡ ለገብርከ፡ 
                                    <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀል<supplied reason="omitted">።</supplied></persName>
                                </explicit>
                            </msItem>
                        
                            <msItem xml:id="ms_i7">
                                <locus from="14r" to="19v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7803PrayerCharms">Ṣalot baʾǝnta maftǝḥe śǝrāy</title>  
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ ዘረበቦሙ፡ አጋንንት፡ <choice><corr resp="bm:GrebTiss1935Codices">በትእዛዘ፡</corr><sic>በትእዘዘ፡</sic></choice>
                                    እግዚአብሔር፡ <supplied reason="omitted">እንዘ፡</supplied> ይቤ፡ ሸምዳን። አሸምዳን፡ አሸማዳኤል፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    በትንሣኤሁ፡ ቅድስት፡ ወበዕርገቱ፡ ውስተ፡ ሰማያት፡ በርደቱ፡ ለጰራቅሊጦስ፡ መንፈሰ፡ ጽድቅ፡ በከመ፡ ፈትሐ፡ ቆጵርያኖስ፡ ከማሁ፡ 
                                    <choice><corr resp="bm:GrebTiss1935Codices">ፈታሕ፡</corr><sic>ፈትሕ፡</sic></choice> ለገሢሥ፡ <supplied reason="omitted">በ</supplied>አስማቲሁ፡
                                    ግሩም፡ በነበልባለ፡ ቃሉ፡ መድምም፡ ፍታሕ፡ ሥራያታተ፡ ሥራይ፡ ለገብርከ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡
                                        መስቀል፡</persName> 
                                </explicit>
                            </msItem>
                        
                            <msItem xml:id="ms_i8">
                                <locus from="19v" to="27v"/>
                                <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7271PrayerCharms">Prayer against the charms of enemy peoples</title> 
                                <textLang mainLang="gez"/>
                                <incipit xml:lang="gez">
                                    በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ ወ፩ጥላ፡ ወጊ፡ ወዘቅማንት፡ ወአምሐራ፡
                                    <sic>ወእጅ፡</sic> ሰብእ። ክናንህ፡ ክናንህ፡ ክናንህ፡ ክናንህ፡ ክናንህ፡ ክናንህ፡ ክናንህ፨ ምኖህ፡ ከማኖህ፡ ምኖህ፡ ከማኖህ፡
                                </incipit>
                                <explicit xml:lang="gez">
                                    መሐሽም፡ መሐሽም፡ መሐሽም፡ መሐሽም፡ መሐሽም፨ በጻድቃን፡ ወሰማዕታት፡ ወበመላእክት፡ <sic>አመሐልኩክሙ፡</sic> ፍትሑ፡ ዘተገብረ፡ በላዕለ፡
                                    <sic>ገብርከ፡</sic> <persName role="owner" ref="https://betamasaheft.eu/PRS15250WaldaMa">ወልደ፡ መስቀል፡</persName>
                                </explicit>
                            </msItem>
                        
                        <msItem xml:id="ms_i9">
                            <locus from="27v" to="29v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7804PrayerCharms">Ṣalot baʾǝnta maftǝḥe śǝrāy</title> 
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ መፍትሔ፡ ሥራይ፡ ዮፍታሔ፡ ዮፍታሂ፡ ዮፍታሒ፡ ዮፍታሔ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ጁሐር፡ ጁሐር፡ ጁሐር፨ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ሐበጅር፡ ሐበጅር፡ ሐበጅር፨ 
