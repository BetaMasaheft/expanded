                    <msContents>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="3r" to="22r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2444Temher">Tǝmhǝrta ḫǝbuʾāt</title>
                            <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <locus from="22r" to="23r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT5876AsmatPrayer">ʾAsmāt-prayer of the Archangel Michael</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ኤኮስ፡ አስሌ፡ ኤፓ፡ ኤፓስ፡ ኤንከምካም፡ ኤቦካ፡ ኬርማ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ፀፀፀ፡ ዘተአመነ፡ <supplied reason="omitted">በ</supplied>ጸሎቱ፡ ወበስእለቱ፡ ለቅዱስ፡ ሚካኤል፡ <surplus>ቀ</surplus>ሊቀ፡ መላእክት፡ ወበስእለታ፡ 
                                ለእግዝእትነ፡ ማርያም፡ ድንግል፡ ወላዲተ፡ አምላክ፡ ኦሊቀ፡ መላእክት፡ ዕቀባ፡ ወአድኅና፡ ለዓመትከ፡ ሸኮር፡ <persName ref="https://betamasaheft.eu/PRS15282WalattaMa">ወለተ፡
                                    ማርያም፡</persName>
                            </explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <locus from="23v" to="24r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7822Asmat">Prayer containing ʾasmāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                አከስ፡ አሜዕ፡ ቤካ፡ ካዜን፡ አሮአያኬ፡ ኬምካዮን፡ ፒጉጊሎ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ዝንቱ፡ አስማት፡ ዐቢይ፡ <choice><corr resp="bm:GrebTiss1935Codices">ወክቡር፡</corr><sic>ወክብር፡</sic></choice> ወልዑል፡ ውእቱ፡ እምኵሉ፡ 
                                ቃላት፡ በነገረ፡ ዕብራይስጥ፡ እንዘ፡ በጥዩቅ፡ ነገር፡ ኦቅዱስ፡ ሚካኤል፡ ሊቀ፡ መላእክት፡ ዕ<del rend="effaced">ባ</del>ቀባ፡ ወአድኅና፡ ለዓመትከ፨ 
                                ሸኮር፡ <persName ref="https://betamasaheft.eu/PRS15282WalattaMa">ወለተ፡ ማርያም።</persName>
                            </explicit>
                        </msItem>
                    </msContents>
                    
