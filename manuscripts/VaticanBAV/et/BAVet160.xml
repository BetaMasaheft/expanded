                      <additions>
                        <list>
                          <item xml:id="a1">
                            <locus target="#128r"/>
                            <desc type="ScribalNoteCompleting">
                              The note contains a supplication on behalf of <persName role="owner" ref="https://betamasaheft.eu/PRS15113TaklaSe">Takla Śǝllāse</persName>, who apparently was the owner
                              of the book. The note also mentions his father <persName ref="https://betamasaheft.eu/PRS15114HaylaSe">Ḫāyla Śǝllāse</persName>, his mother 
                              <persName ref="https://betamasaheft.eu/PRS15115WalattaIy">Walatta ʾIyasus</persName>, his son <persName ref="https://betamasaheft.eu/PRS15116MannaSe">Mannā Śǝllāse</persName>, his brother
                              <persName ref="https://betamasaheft.eu/PRS15117SaggaSe">Ṣaggā Śǝllāse</persName>, and their place of residence, Sāšohā. 
                              According to the note, the book was completed on the 17th of Tāḫśāś in an unspecified year.
                            </desc>
                            <q xml:lang="gez">ዕቀበኒ፡ እም<lb/>ኵሉ፡ ዕኩይ፡ ለገብርኪ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15113TaklaSe">ተክለ፡ ሥላሴ።</persName> <lb/> ተፈጸመ፡
                              ዝመጽሐፍ፡ ዘተክለ፡ ሥላሴ፡ በወ<lb/>ርኃ፡ ታኅሣሥ፡ በ፲ወ፯መዓልት፡ በ፳ወ፭<lb/>ሌሊት። አቡሁ፡ <persName ref="https://betamasaheft.eu/PRS15114HaylaSe">ኃይለ፡
                                ሥላሴ፡</persName> ወእሙ፡ <persName ref="https://betamasaheft.eu/PRS15115WalattaIy">ወ<lb/>ለተ፡ ኢየሱስ፡</persName> ወውሉዱ፡ 
                              <persName ref="https://betamasaheft.eu/PRS15116MannaSe">መና፡ ሥላሴ።</persName> ወእሁ<lb/>ሁ፡ <persName ref="https://betamasaheft.eu/PRS15117SaggaSe">ጸጋ፡ ሥላሴ፡</persName> ሀገሩ፡
                              ሳሾሃ፡</q>
                          </item>
                          
                          <item xml:id="e1">
                            <locus from="128r" to="130v"/>
                            <desc>Scribbles.</desc>
                          </item>
                        </list>
                      </additions>
                      
