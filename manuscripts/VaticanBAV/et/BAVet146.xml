                      <msItem xml:id="ms_i7">
                          <locus from="40v" to="50r"/>
                          <title type="complete" ref="https://betamasaheft.eu/LIT1191Baenta">Baʾǝnta śǝllāseka</title>
                          <incipit xml:lang="gez">በእንተ፡ ሥላሴከ፡ እግዚኦ፡ ተሣ<supplied reason="omitted">ሀ</supplied>ለነ፡ በእንተ፡ ርደትከ፡ እግዚኦ፡ ተሣሃለነ፡ በእንተ፡ ትስብእትከ፡ <expan><abbr>እ</abbr><ex>ግዚኦ</ex></expan>፡  ተ<supplied reason="omitted">ሣሀለነ</supplied>፡ 
                              በእንተ፡ ማርያም፡ እምከ፡ <expan><abbr>እ</abbr><ex>ግዚኦ</ex></expan>፡ ተ<supplied reason="omitted">ሣሀለነ</supplied>፡ <expan><abbr>በእ</abbr><ex>ንተ</ex></expan>፡ ማሕፀና፡ ዘጾረከ፤ <expan><abbr>እ</abbr><ex>ግዚኦ</ex></expan>፤ ተ<supplied reason="omitted">ሣሀለነ</supplied>፤
                              <expan><abbr>በ</abbr><ex>እንተ</ex></expan>፡ ልደትከ፤ <expan><abbr>እ</abbr><ex>ግዚኦ</ex></expan>፡ ተ<supplied reason="omitted">ሣሀለነ</supplied>፤ <expan><abbr>በ</abbr><ex>እንተ</ex></expan>፡ ጥምቀትከ፤ <expan><abbr>እ</abbr><ex>ግዚኦ</ex></expan>፤ ተ<supplied reason="omitted">ሣሀለነ</supplied>፡</incipit>
                          <explicit xml:lang="gez"><expan><abbr>ሃ</abbr><ex>ሌ፡ ሉያ</ex></expan>፡ <expan><abbr>ሃ</abbr><ex>ሌ፡ ሉያ</ex></expan>፡  ኦአብ፡ በእንተ፡ ክርስቶስ፡ ርድአነ፤ ክርስቶስ፡ በአቡከ፡ ተማኅፀነ፤ መንፈሰ፡ አብ፡ 
                              ወወልድ፡ ናዝዘነ፨ ፫ጊዜ፡ በል፤ ስማዕ፡ ጸሎተነ፡ በል፤ <expan><abbr>እግ</abbr><ex>ዚኦ</ex></expan>፤ <expan><abbr>መሐ</abbr><ex>ረነ፤</ex></expan> <expan><abbr>ክ</abbr><ex>ርስቶስ</ex></expan>፡ ፫<supplied reason="omitted">ጊዜ፡ በል</supplied>፤ <expan><abbr>በ</abbr><ex>እንተ</ex></expan>፤ <expan><abbr>እግዝ</abbr><ex>እትነ</ex></expan>፤ ማርያም፡ <expan><abbr>መሐ</abbr><ex>ረነ፤</ex></expan> <expan><abbr>ክ</abbr><ex>ርስቶስ</ex></expan>፤ ፫ጊዜ፡ በል፨</explicit>
                          <textLang mainLang="gez"/>
                      </msItem>
                        
                        <msItem xml:id="ms_i8">
                           <locus from="50v" to="64r"/> 
                            <title type="complete" ref="https://betamasaheft.eu/LIT2807RepCh91">Malkǝʾ-hymn to Our Lady Mary</title>
                            <incipit xml:lang="gez">ሰላም፡ ለኪ<supplied reason="omitted">፡</supplied> ማርያም፡ ድንግል፡ ዘመዓዛ፡ አፉኪ፡ ኮል፤ እንተ፡ ትፄንዊ፡ በገዳም፡ ወሐቅል፤ ወልታ፡ ረዲኦትየ፡ በውስተ፡ ቀትል፤ <expan><abbr>ሰ</abbr><ex>ላም</ex></expan>፤ <expan><abbr>ለ</abbr><ex>ኪ</ex></expan>፤ ተሰፍዎ፡ ባዕድ፡ አልብየ፤ ዘእንበሌኪ፡ ምክህየ፤ 
                                በኢመንኖ፡ በልኒ፡ ገብርየ፡ ገብርየ፤ ዘተሣየጥኩከ፡ በንዋይየ፡</incipit>
                            <explicit xml:lang="gez"><expan><abbr>ሰ</abbr><ex>ላም</ex></expan>፤ <expan><abbr>ለ</abbr><ex>ከ፡</ex></expan>ዘመሐረነ፡ ወልድከ፡ ጸሎተ፡ ቅዱሳን፡ እንግልጋ፤ ሶበ፡ ንጼሊ፡ እንበለ፡ ንትጋ፤ ፈኑ፡ ለነ፡ መንፈሰ፡ ጸጋ፤ ዘይሤኒ፡ ላዕለ፡ ነፍስ፡ ወሥጋ፨ ጸሎታ፡ ወበረከታ፡ ለእግዝእትነ፡ ማርያም፡ ወላዲተ፡ አምላክ፡ 
                                ወምሕረተ፡ ፍቁር፡ ወልዳ፡ የሃሉ፡ ምስለ፡ ገብራ፤ <add place="overstrike"><persName role="owner" ref="https://betamasaheft.eu/PRS15198WaldaSadeq">ወልደ ጻድቅ፡</persName></add> እቀቦ፡ ወአድኅኖ፡ ለነፍሰ<supplied reason="omitted">፡</supplied> <add place="overstrike">ወል<sic>ዶ</sic>፡ ጻድቅ፡</add>።</explicit>
                            <textLang mainLang="gez"/>
                            <note>,Preceded by a title <foreign xml:lang="gez">ሰላምታ፡ ዘ፯ጊዜያት፡</foreign>.</note>
                        </msItem>
                        
                        <msItem xml:id="ms_i9">
                          <locus from="64v" to="73v"/>
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT3585Taamme">Selection from the "Miracles of Mary"</title>
                           
                            <msItem xml:id="ms_i9.1">
                               <locus from="64v" to="69v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3584Intro">Introduction</title>
                                <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> ንነግረክሙ፡ አኃዊነ፡ ፍቁራን፡ ውሉደ፡ ቤተ፡ ክርስቲያን፡ እግዚአብሔር፡ ያበርህ፡ አዕይንተ፨ አልባቢክሙ፨ ወይባርክሙ፡ ለሰሚዓ፡ ተአምሪሃ፡ ለእግዝእትነ፡ ቅድስት፡ 
                                    ወድንግልት፡ በክልኤ፡ ማርያም፡ ዘበዕብራይስጢ፡ ማሪሃም፡ ጥዕምተ፡ ስም፡ ሕይወተ፡ ኵሉ፡ ዓለም፨ ወላዲተ፡ አምላክ፡</incipit>
                                <explicit xml:lang="gez">ወተሰመይኪ፡ እመ፡ ወአመተ፡ በልደተ፡ መድኃኒነ፡ ቅዱስ። ሰላም፡ ለኪ፡ ኦእግዝእትየ፡ ቅድስት፡ ድንግል፡ በ፪ማርያ<supplied reason="omitted">ም</supplied>፡ ወላዲተ፡ አምላክ፡ 
                                    እስመ፡ ረከብኪ፡ ሞገሰ፡ እግዚአብሔር፡ ምስሌኪ፡ ጸልዪ፡ ወሰአሊ፡ ኀበ፡ ፍቁር፡ ወልድኪ፡ ከመ፡ ይስረይ፡ ለነ፡ ኃጣውኢነ፨</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            
                            <msItem xml:id="ms_i9.2">
                               <locus from="69v" to="71r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3587Miracle">On the monk who lacked clothing and food</title>
                                <explicit xml:lang="gez">ወኵሎሙ፡ ሕዝብ፡ እለ፡ ርእዩ፡ ወሰምዑ፡ ዘንተ፡ ተአምረ፡ አንከሩ፡ ዓቢየ፡ ወሰብሕዋ፡ ወአፈድፈዱ፡ አክብሮተ፡ ስማ፡ ለእግዝእትነ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> ጸሎታ፡ ወበረከታ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> ምስለ፡ ገብራ፤ <add>ከ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15198WaldaSadeq">ወልደ፡ ጻድቅ፡</persName></add> ለዓለመ፡ ዓለም፡ አሜን፨</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            
                            <msItem xml:id="ms_i9.3">
                                <locus from="71r" to="72r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3901Miracle">On the man who sought sustenance from the monks</title>
                                <incipit xml:lang="gez">፪ተአምሪሃ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/> ወሀሎ፡ ፩ብእሲ፡ ረድኦሙ፡ ለመነኮሳት፡ ወይሄሊ፡ ሲሳዮሙ፡ ለለዕለቱ፨ ወአሐተ፡ ዕለተ፡ ሶበ፡ ኃልቀ፡ ሲሳዮሙ፡ ለቁዱሳን፡ ተንሥአ፡ ወቆመ፡ እንዘ፡ ይስእላ፡ ለእግዝእትነ፡</incipit>
                                <explicit xml:lang="gez">ወሶበ፡ ርእዩ፡ ዘንተ፡ ተአምረ፡ ሰብሕዎ፡ ለእግዚአብሔር፡ ልዑል፡ ወወደስዎ፡ ለእግዝእትነ፡ ቅድስት፡ ድንግል፡ በ፪<supplied reason="omitted">፡</supplied> ማርያም፡ ወላዲተ፡ አምላክ፡ ወ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">ወ</supplied>ሀቢተ፡ ጸጋ፨ ጸሎታ፡ ወበረከታ፡ የሃሉ፡ ምስለ፡ ገብራ፡ <add><persName role="owner" ref="https://betamasaheft.eu/PRS15198WaldaSadeq">ወልደ፡ ጻድቅ፡</persName></add> ለዓለመ፡ ዓለም፡ አሜን።</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            
                            <msItem xml:id="ms_i9.4">
                               <locus from="72r" to="73v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3605Miracle">How Mary appeared to St. George while he was in prison</title>
                                <incipit xml:lang="gez">፫ተአምሪሃ፡ <gap reason="omitted"/>ጸሎታ፡ <gap reason="omitted" resp="bm:GrebTiss1935Codices"/>ወሀሎ፡ ፩ብእሲ፡ መስተጋድል፡ ፈድፋደ፡ በከዊነ፡ ስምዕ፡ በእንተ፡ ስመ፡ ክርስቶስ፡ ዘስሙ፡ ጊዮርጊስ፨ ወአሐተ፡ ዕለተ፡ ተጽዒሮ፡ ኖመ፡ እምብዝኃ፡ ኵነኔ።</incipit>
                                <explicit xml:lang="gez">ወነበረ፡ ፬መዋዕለ፡ እንዘ፡ ኢይበልዕ፡ ወኢይሰቲ፡ እምብዝኃ፡ <sic>ፍሥሐ፡</sic> ዘመልዐ፡ ውስተ፡ ልቡ፡ ወእምጣዕመ፡ መዓዛሃ፡ ለእግዝእትነ፡ ቅድስት፡ ድንግል፡ በ፪ማርያም፡ ወላዲተ፡ አምላክ፡ ጸሎታ፡
                                    ወበረከታ፡ ወምሕረተ፡ ፍቁር፡ ወልዳ፡ የሃሉ፡ ምስለ፡ ገብራ<supplied reason="omitted">፡</supplied> <surplus>ለ</surplus>ገብርከ፡ <add><persName role="owner" ref="https://betamasaheft.eu/PRS15198WaldaSadeq">ወልደ፡ ጻድቅ፡</persName></add></explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                        </msItem>       
                            
                            
                            <msItem xml:id="ms_i10">
                                <locus from="73v" to="76v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3108RepCh388">Praise of Mary</title>
                                <incipit xml:lang="gez">ይዌድስዋ፡ መላእክት፡ ለማርያም፡ በውስተ፡ ውሣጤ፡ መንጦላዕት፡ <gap reason="omitted"/> ይቤላ፡ መልአክ፡ ለማርያም፡ ተወከፊዮ፡ ለቃል፡ ኀቤኪ፡ ይመጽአ፡ ወበማኅፀነ፡ ዚአኪ፡ የኃድር፡</incipit>
                                <note>The text ends with the <ref type="work" corresp="https://betamasaheft.eu/LIT4272Salam">invocation to Mary</ref>.</note>
                                <textLang mainLang="gez"/>   
                            </msItem>
                            
                            <msItem xml:id="ms_i11">
                                <locus from="76v" to="81r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT3088RepCh368">Hymn to Mary</title>
                                <note>At the end an invocation to Mary is added: <q xml:lang="gez">ወእሰግድ፡ ቅድመ፡ ማርያም፡ ለዝክረ፡ ስምኪ፡ በጽዋዔ። ወአሰግድ፡ ካዕበ፡ ማርያም፡ ለድንግልናኪ፡ ክልኤ፨ 
                                    ወእሰግድ፡ ሥልሰ፡ ማርያም፡ ለሥዕልኪ፡ ቅድመ፡ ጉባኤ፨ ዘኢሰገደሰ<supplied reason="omitted">፡</supplied> ለሥዕልኪ፡ አሥሪጾ፡ ምማዔ። በሥጋሁ፡ ወበነፍሱ፡ ኢይርከብ፡ ትንሣኤ።
                                </q>.</note>
                                <textLang mainLang="gez"/>    
                            </msItem>
                            
                            <msItem xml:id="ms_i12">
                                <locus from="81r" to="81v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT7766JesusChristWhoseName">Hymn to Jesus Christ</title>
                                <incipit xml:lang="gez">ኢየሱስ፡ ክርስቶስ፡ ጥዑመ፡ ስም፡ ዘይጼውዖ፨ ኢየሱስ፡ ክርስቶስ፡ ህብስተ፡ ሕይወት፡ ለዘይበልዖ። ኢየሱስ፡ ክርስቶስ፡ ስቴ<supplied reason="omitted">፡</supplied> መድኃኒት፡ ለዘይጸምዖ፨</incipit>
                                <explicit xml:lang="gez">ውስተ፡ ስያሐ፡ ሱራፊ፡ ለስእለትየ፡ ደዮ፨ ወበሕማምከ፡ ለቍስልየ፡ አጥዕዮ፨</explicit>
                                <textLang mainLang="gez"/>
                            </msItem>
                            
                            <msItem xml:id="ms_i13">
                                <locus from="81v" to="84r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT6396MJIntroduction">Miracle of Jesus Christ</title>
                                <incipit xml:lang="gez">ተአም<supplied reason="lost" rend="effaced">ሪሁ፡</supplied> ለእግዚእነ፡ ወመድ<surplus>ወመድ</surplus>ኃኒነ፡ ወአምላክነ፡ ኢየሱስ፡ ክርስቶስ፡ በረከተ፡ ጸጋሁ፡ <gap reason="omitted"/> ዝንቱ፡ ምስጢር፡ አምላካዊ፡ ዘነገሮ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ለረድኡ፡ ወሐዋርያሁ፡ ዮሐንስ፡ ወልደ፡ ዘብዴዎስ<supplied reason="omitted">፡</supplied> እምቅድመ፡ ዕርገቱ፡</incipit>
                                <explicit xml:lang="gez">ወተሠይጦትከ፡ ከመ፡ ገብር፡ በኅዳጥ፡ ብሩር፤ ሃሌ፤ ሉያ፤ በብዝኃ፡ ሣህልከ፡ ኢየሱስ<supplied reason="omitted" resp="bm:GrebTiss1935Codices">፡</supplied> አድኅኖ፡ ለገብርከ፡ <add><persName role="owner" ref="https://betamasaheft.eu/PRS15198WaldaSadeq">ወልደ፡ ጻድቅ፡</persName></add> ስብሐት፡ ለከ፡ አምላኪየ፡ በኍልቈ፡ ኵሉ፡ አዕፅምትየ፡ ስብሐ<supplied reason="omitted">ት</supplied>፡ ለከ፡ አምላኪየ፡ በኍልቈ፡ ኵሉ፡ ስእርትየ፡ <gap reason="omitted"/> ስብሐተ፡ ሥላሴከ፡ ወትረ፡ ይነግር፡ አፉየ። </explicit>
                                <textLang mainLang="gez"/>  
                            </msItem>
                            
                            <msItem xml:id="ms_i14">
                                <locus target="#84v"/>
                                <title type="complete">Magic names</title>
                                <incipit xml:lang="gez">ኤኮስ፡ አስሊ፡ ኤፓ፡ ኤፓስ፡ ኤንከምክም፡ ኤኮካ፡</incipit>
                                <note>A number of ʾAsmāt, similar to those in <ref type="work" corresp="https://betamasaheft.eu/LIT5876AsmatPrayer">ʾAsmāt-prayer of the Archangel Michael</ref>, <ref type="work" corresp="https://betamasaheft.eu/LIT7112Asmat">Names of the Archangel Michael</ref>, <ref type="work" corresp="https://betamasaheft.eu/LIT5186PrayerAsmatAbayt "><seg corresp="LIT5186PrayerAsmatAbayt ">No item: LIT5186PrayerAsmatAbayt</seg></ref> and <ref type="work" corresp="https://betamasaheft.eu/LIT1637Homily">Homily on the Archangel Michael by Timothy of Alexandria
        (Ḫǝdār)</ref>. </note>
                                <textLang mainLang="gez"/>
                            </msItem>
                            
