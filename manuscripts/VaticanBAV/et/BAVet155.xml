                        <msItem xml:id="ms_i3">
                            <locus from="29" to="53"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT6489SchoolChants#Aryam">School Chants: ʾAryām</title>
                            <textLang xml:lang="gez"/>
                            <incipit xml:lang="gez">
                                ቃልየ፡ አጽምዕ፡ እግዚኦ፡ ሃሌ፡ ሉያ፡ ሃሌ፡ ሉያ፡ ወለቡ፡ ጽራኅየ፡ ሃሌ፡ ሉያ፡ ሃሌ<supplied reason="omitted">፡</supplied> ሉያ፡ ወአጽምዓኒ፡ ቃለ፡ 
                                ስእለትየ፡ ንጉሥየኒ፡ ወአምላኪየኒ፡ ሃሌ፡ ሉያ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                <supplied reason="lost">ወሪ</supplied>ዶሙ፡ እምደብር፡ እምደብረ፡ ታቦር፡ አዘዞሙ፡ ኢይንግሩ፡ ዘርእዩ፡ በደብር፡ አስከ፡ አመ፡ ይትከሠት፡ በዕድሜሁ። 
                                በለስ፡ አእምሩ፡ አምሳሊሁ፡ እምከመ፡ ለምለመ፡ አጽቁ፡ ሠረፀ፡ ቈፅሉ። 
                                <supplied reason="omitted">ተ</supplied>ፈጸመ<supplied reason="omitted">፡</supplied> ፫<supplied reason="omitted">፡</supplied> ዘኍላቌሁ፡ ፶ወ፰፡
                            </explicit>                           
                        </msItem>
                        
                        <msItem xml:id="ms_i4">
                            <locus target="#53r"/>
                            <title type="complete" xml:lang="en">Chant in honour of the Trinity</title> 
                            <textLang xml:lang="gez"/>
                            <incipit xml:lang="gez">
                                ሃሌ፡ ሉያ፡ ለአብ፡ ሃሌ፡ ሉያ፡ ለወልድ<supplied reason="omitted">፡</supplied> ሃሌ፡ ሉያ፡ <surplus>ወ</surplus>ለመንፈስ፡ ቅዱስ፡ ንሴብሕ፡ 
                                ወን<del rend="expunctuated">ም</del>ዜምር፡ ስብሐት፡ በአርያም፡ ስብሐት፡ ለዘፈለጠ፡ ብርሃነ።
                            </incipit>
                            <explicit xml:lang="gez">
                                <expan><ex>ተዘ</ex><abbr>ከርኩ፡</abbr></expan> በሌሊት፡ ስመከ፡ ያንቅሃኒ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ቃልከ፡</corr><sic>ቃለከ፡</sic></choice> <surplus>ዘ</surplus>በትእዛዝከ፡ ተሠርዓ፡ ጎህ፡ ወጽባሕ፡ 
                                ኮነ፡ ብርሃነ፡ ወጸብሐ።
                            </explicit>                       
                        </msItem>
