                    <msContents>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="3r" to="4v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7126Asmat">Names of God found by the Archangel Michael</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> የኮስ፡ ያሜዕ፡ ኤንካዕ፡ ከዚዕ፡ አርናክዮን፡ 
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> እሉ፡ ክቡራት፡ ወኅቡአት፡ አስማቲሁ፡ ለእግዚአብሔር፡ ዘተረክቡ፡ በእደ፡ 
                                ሚካ<del rend="erasure" unit="chars" quantity="1"/>ኤል<supplied reason="omitted">፡</supplied> ሊቀ፡ መ<surplus>መ</surplus>ላእክት፡ መግረሬ፡ ፀር፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ወይድግም፡ በትሑት፡ ቃል፡ ለለ<supplied reason="omitted">፡</supplied> ጽባሑ፡ በኃይለ፡ ዝንቱ፡ አስማቲከ፡ አድኅነኒ፡ እምሕማመ፡ ነፍስ፡ ወሥጋ፡ ለገብርከ፡
                            </explicit>
                        </msItem>
                        
