                            <msItem xml:id="ms_i2.8">
                                <locus from="56r" to="61v"/>
                                <title type="complete">Prayer for the first hour of the night</title>
                                <incipit xml:lang="gez">ቡሩክ፡ እግዚአብሔር፡ አብ፡ ወወልዱ፡ ዋህድ፡ ገብረ፡ ኵሎ፡ ዓለመ፡ ዘፈጠረ፡ ጽልመተ፡ ወብርሃነ። ወይእዜኒ፡ ንስአሎ፡ ከመ፡ ይዕቀ<supplied reason="omitted">በ</supplied>ነ፡  ኵሎ፡ ኑኃ፡
                                    ሌሊት፡ በኃይለ፡ መላእክቲሁ፡ <choice><corr>ቅዱሳን፡</corr><sic>ቅዱሰን፡</sic></choice></incipit>
                                <explicit xml:lang="gez">ወባርክ፡ ነቂሆተነሂ፡ በኃይለ፡ ተንሥኦቱ፡ ከመ፡ ንሰብሕ፡ ስመከ፡ ወስመ፡ ወልድከ፡ ወስመ፡ መንፈስ፡ ቅዱስ፡ ለዓለመ፡ ዓለም፡ አሜን፨ ኦእግዚኦ፡ ተሠሀሎ፡ ለኃጥእ፡ ገብርከ፨ <expan><abbr>ለዓለ</abbr><ex>መ</ex></expan>፡ ዓለም፡ አሜን፡ </explicit>
                            </msItem>
                            
