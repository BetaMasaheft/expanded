                            <msItem xml:id="ms_i2.11">
                                <locus from="64r" to="64v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT7818Zatawakkafka">Zatawakkafka maśwāʿta ʾAbrǝhām ʾabuna</title>
                                <incipit xml:lang="gez">እግዚአብሔር፡ አምላክነ፡ ዘተወከፍከ፡ መሥዋዕተ፡ አብርሃም፡ አቡነ፡ ወህየንተ፡ ይስሐቅ፡ ወልዱ፤ ዘአስተዳሎከ፡ ወአውረድከ፡ ሎቱ፤  <choice><corr>ቤዛሁ፡</corr><sic>ቤዘሁ፡</sic></choice>በግዓ፡</incipit>
                                <explicit xml:lang="gez">ወረስየነ፡ ድልዋነ፡ ከመ፡ ንትለአክ፡ ቅድመ፡ <surplus>ውስዳ፡</surplus> ንጽህከ፡ ኦመፍቀሬ፡ እጓለ፡ እመሕያው፡ በኵሉ፡ መዋዕለ፡ ሕ<supplied reason="omitted">ይ</supplied>ወትነ፡ በትፍሥሕት፡ ወበሐሤት፨</explicit>
                            </msItem>
                            
                            <msItem xml:id="ms_i2.12">
                              <locus from="64v" to="65v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT4711Mastabqwe">Prayer for the deceased</title>
                                <incipit xml:lang="gez">ወከዕበ፡ ናስተበቍ<add place="above">ዕ</add>፡ በል፡ በእንተ፡ እለ፡ ኖሙ፡ አኃዊነ፡ ከመ፡ ነፍሶሙ፡ ያግዕዝ፡ ውስተ፡ መካን፡ ሥዑር፡ ኀበ፡ ማየ፡ ዕረፍት፡</incipit>
                                <explicit xml:lang="gez">መናኅየ፡ ወመናዝዝ፡ ለሰብኦሙ፡ ፈኑ፡ ከዊነከ፡ ክፍል፡ በክርስቶስ፡ ዘቦቱ፡ ለከ፡ ምስሌሁ፡ በል።</explicit>
                            </msItem>
                            
                            <msItem xml:id="ms_i2.13">
                                <locus from="65v" to="67r"/> 
                                <title type="complete">Prayer of blessing</title>
                                <incipit xml:lang="gez">ጸሎተ፡ ቡራኬ፡ ኦሥሉስ፡ ቅዱስ<supplied reason="omitted">፡</supplied> አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ባርክ፡ ዲበ፡ ሕዝብከ፡ ፍቁራን፡ ክርስቶሳውያን፡ መሲሓውያን፡</incipit>
                                <explicit xml:lang="gez">ተዘከሮሙ፡ እግዚኦ፡ በመንግሥትከ፡ ሰማያዊት፡ ኦእግዚኦ፡ አድኅን፡ ሕዝብከ፡ ወባርክ፡ ርስተከ፡ ረዓዮሙ፡ ወአልዕሎሙ፡ እስለ፡ ለዓለመ፡ ዓለም፡ አሜን።</explicit>
                            </msItem>
                            
