                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT5920JohnBeg">John 1:1-5</title>
                            <explicit type="supplication" xml:lang="gez">አድኅና፡ ለዓመትከ፡ ወለተ<supplied reason="omitted">፡</supplied> ገብርኤል፡</explicit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title ref="https://betamasaheft.eu/LIT5136MagicFormula">Magic Formula Against Stomachache</title>
                            <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ቍርጸት፡ ድሜጥሮስ፡
                                ፫ጊዜ፡ ጋይስጦስ፡ ፫<supplied reason="omitted">፡</supplied>
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> በኃይለ፡ ዝንቱ፡
                                አስማቲከ፡ ባርያ፡ ጸሊማን፡ ባርያ፡ ቀይሐን፡ እደ፡ ሰብእ፡ መሰርያን፡ ምትአት፡ ወቍርጸት፡ ለገብርከ፡
                                እገሌ።</incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title ref="https://betamasaheft.eu/LIT7935HmamaKabed">Ṣalot ba-ʾǝnta ḥǝmāma kabd</title>
                            <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ ሕማመ፡ <choice resp="bm:GrebTiss1935Codices">
                                        <sic>ክበድ፡</sic>
                                        <corr>ከብድ፡</corr>
                                </choice> ይትባረክ፡ እግዚአብሔር፡ አምላክ፡ አናንያ፡ ወአዛርያ፡ ወሚሳኤል፡ እም<supplied reason="omitted" resp="bm:GrebTiss1935Codices">እ</supplied>ቶነ፡
                                እሳት፡ ዘይነድድ፡ በኂሩትከ፡ ይትመየጥ፡ ወይሰሰል፡ ዝንቱ፡ ሕማመ፡ <choice resp="bm:GrebTiss1935Codices">
                                    <sic>ክበድ፡</sic>
                                    <corr>ከብድ፡</corr>
                                </choice>
                                <choice resp="bm:GrebTiss1935Codices">
                                    <sic>አድኅኖ</sic>
                                    <corr>አድኅና</corr>
                                </choice>፨ ለዓመትከ፡ <supplied reason="omitted" resp="bm:GrebTiss1935Codices">ወለተ፡</supplied> ገብርኤል፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <title ref="https://betamasaheft.eu/LIT6785PPDengade">Protective prayer against the fear of demons (dǝngāḍe ʾagānǝnt
        za-maʿālt wa-za-lelit)</title>
                            <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ ድንጋፄ፡ ዘመዓልት፡ ወዘሌሊት፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ወለ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ወ</sic>
                                    <corr>ው</corr>
                                </choice>ግረ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ት</sic>
                                    <corr>ተ</corr>
                                </choice>፡ ዕብን፡ እመሂ፡ ባርያ፡ ወሌጌዎን፡ ወነገርጋር፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ሽዱሐም፡ ንዱረካኤል፡</incipit>
                            <explicit xml:lang="gez">ፈርሃ፡ ወደንገፀ፡ ዲያብሎስ፡ ርእየ፡ ብሁት፡ <sic>ልደተ፡</sic> በሥጋ፡
                                    አምላ<choice resp="bm:GrebTiss1935Codices">
                                    <sic>ከ</sic>
                                    <corr>ክ</corr>
                                </choice>፡ በሲኦል፡ አድኅና፡ ለዓመትከ፡ ማዴ፨ ወለተ<surplus>ተ</surplus>፡ ገብርኤል፡
                                እስመ፡ አልቦ፡ ነገር፡ ዘይሰ<supplied reason="omitted">አ</supplied>ኖ፡
                                ለእግዚአብሔር፡ አድኅና፡ ለዓመትከ፡ ወለተ፡ ገብርኤል፡</explicit>
                        </msItem>
                    </msContents>
