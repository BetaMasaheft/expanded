                    <msContents>
                        <msItem xml:id="ms_i1">
                            <locus from="2r" to="2v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7832PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-ʿĀyna Warq</title>
                            <textLang mainLang="gez" otherLangs="am"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነ፡ ጽላ፡ ወዓይነ፤ ወርቅ፡ ለሜርጅጅን፡ ወአላጁን፡ 
                                ወፈቀጁን፡ ወላዑማኑ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                በኃይለ፡ ዝንቱ፡ <choice><corr resp="bm:GrebTiss1935Codices">በዝቃልከ፡</corr><sic>በዝቃልቦ፡</sic></choice> 
                                <sic>አድኅኖ<supplied reason="omitted">፡</supplied></sic> እምዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡ ሊተ፡ ለገብርከ። 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ዓየለ፡ ካሳ፡ ገብረ፡ ማርያም፡</persName>
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <locus from="2v" to="4v"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7833PPrayer">ʾAnuzabaʿǝhi rǝḫman raḫim ʾiyāqelā ʾaʾaziʿun raḫmān</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አኑዘበዕሂ፡ ርኅመን፡ ረኂም፡ ኢያቄላ፡ አአዚዑን፡ ረኅማን፡  
                            </incipit>
                            <explicit xml:lang="gez">
                                መመዓቱን፡ ወቀብ፡ አራሕን፡ ወበቃለ፡ አረቢ፡ አድኅኖ፡ እምሕማመ፡ ዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡ ሊተ፡ ለገብርከ፡ 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ዓየለ፡ ካሳ፡ ገብረ፡ ማርያም።</persName> ዘሠሉስ፡
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <locus from="5r" to="8r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7834PPrayer">ʾAsmāta ḫāyl ʾakāʿ kǝsbǝʾel ʾaqmāhel ʾazāhel lǝmāʾel</title>
                            <textLang mainLang="gez"/>
                            <note>The text is preceded by a squared figure consisting of eighty-one boxes.</note>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> አስማተ፡ ኃይል፡ አካዕ፡ ክስብኤል፡ አቅማሄል፡ አዛሄል፡ ልማኤል፡
                            </incipit>
                            <explicit xml:lang="gez">
                                አድኅነኒ፡ እምሕማመ፡ ዓይነ፡ ጽላ፡ ወሌጌዎን፡ ዛር፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ነሐቢ፡ ወነሀብት፡ ሰሪ፡ ምትአት፡ ወሰሪ፡ ውግዓት፡
                                ለገብርከ፡ <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ዓየለ፡ <del>ሳ</del><choice><corr resp="bm:GrebTiss1935Codices">ካ</corr><sic>ከ</sic></choice>ሳ፡ 
                                    ገብረ፡ ማርያም፡</persName>
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <locus from="8r" to="10r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7835PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-ʿĀyna Warq</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ወፀባዒተ፡</corr><sic>ወፀባዕተ፡</sic></choice> ፀር፡ በአጵርኤል፡ ጽርናኤል፡ አክርኤል፡ ልማኤል፡
                            </incipit>                            
                            <explicit xml:lang="gez">
                                አድኅነኒ፡ እምሕማመ፡ ጋኔን፡ ወዛር፡ <choice><corr resp="bm:GrebTiss1935Codices">ወፀባዒተ፡</corr><sic>ወፀባዕተ፡</sic></choice> ፀር፡ ወሌጌዎን፡
                                ለገብርከ፡ <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ዓየለ፡ ካሳ፡ ገብረ፡ ማርያም፡</persName>
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <locus from="10v" to="12r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7836PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-qwǝrḍat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ጽላ</corr><sic>ጸላ፡</sic></choice> 
                                ወ<choice><corr resp="bm:GrebTiss1935Codices">ቍ</corr><sic>ቁ</sic></choice>ርፀት፡ በዲ፡ ነማሃ፡ ዱጥጥቁር፡ ዴግዴ፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ቃለ፡ አብ፡ ወወልድ<supplied reason="omitted">፡</supplied> ወመንፈስ፡ ቅዱስ፡ አድኅነኒ፡ 
                                እም<choice><corr resp="bm:GrebTiss1935Codices">ቍ</corr><sic>ቁ</sic></choice>ርፀት፡ ሊተ፡ ለገብርከ፡ 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ገብረ፡ ማርያም፡ ዓየለ፡ ካሳ፡</persName>
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <locus from="12r" to="13r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7837PPrayer">Ṣalot baʾǝnta ḥǝmāma ʿĀyna Ṣǝllā wa-ʿĀyna Warq</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ<supplied reason="omitted">፡</supplied> ዓይነ፡ ጽላ፡ ወዓይነ፡ ወርቅ፡
                                ወጽላ፡ ወጊ፡ ወርእሰ፡ ምትዓት፡ ያሸኢር፡ ወያሸርር፡ ያሸርር፡ ኢያሸርር፡ ያሸርር፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ግርኤራ፡ ግርማኤ፡ አማኑኤል፡ አድኅነኒ፡ እምሕማመ<supplied reason="omitted">፡</supplied> ርእሰ፡ ምትዓት፡ ለገብርከ፡ 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ገብረ፡ ማርያም፡ ዓየለ፡ ካሳ፡</persName>
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i7">
                            <locus from="13r" to="14r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT7838PPrayer">Ṣalot baʾǝnta wǝgʿat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ አብ<supplied reason="omitted">፡</supplied> <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ጸሎት፡ በእንተ፡ 
                                <choice><corr resp="bm:GrebTiss1935Codices">ው</corr><sic>ወ</sic></choice>ግዓት፡ የቀፍር፡ አቀፍር፡ አቀፍር፡ አቀፍር፡ አቀፍር፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ፍለይ<supplied reason="omitted">፡</supplied> ፍለይ፡ ፍለይ፤ ፍለያ፡ እስመ፤ አልቦ፤ ነገር፡ ዘይሰአኖ፡ ለእግዚአብሔር፤ ወወወወወወወ፡
                            </explicit>
                        </msItem>
                        <msItem xml:id="ms_i8">
                            <locus from="14r" to="24r"/>
                            <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2993RepCh274">Ba-sǝma ʾƎgziʾabǝḥer qadāmāwi za-ʾǝnbala tǝmālǝm</title>
                            <textLang mainLang="gez"/>
                            <note>The text corresponds to that published in <bibl corresp="http://zotero.org/groups/358366/items/8JZE4KJX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Grebaut1923Priere"/><title level="a">Prière pour conjurer les démons</title><title level="j">Revue de l'Orient Chrétien</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><date>1923</date><biblScope unit="volume">23</biblScope><biblScope unit="page">199-208</biblScope><note type="tags"><note type="tag">bm:Grebaut1923Priere</note></note><note type="tag">bm:Grebaut1923Priere</note></bibl>, but after the word 
                                <foreign xml:lang="gez">ክርስቶስ፡</foreign> (<bibl corresp="http://zotero.org/groups/358366/items/8JZE4KJX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Grebaut1923Priere"/><title level="a">Prière pour conjurer les démons</title><title level="j">Revue de l'Orient Chrétien</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><date>1923</date><biblScope unit="volume">23</biblScope><biblScope unit="page">199-208</biblScope><note type="tags"><note type="tag">bm:Grebaut1923Priere</note></note><note type="tag">bm:Grebaut1923Priere</note><citedRange unit="page">203 l. 9</citedRange></bibl>) 
                                on <locus target="#21v"/> the text continues as follows.
                            </note>
                            <explicit xml:lang="gez">
                                ኢዳሲ፡ ገል፡ ጥኤል፡ ሱኑ<choice><corr resp="bm:GrebTiss1935Codices">ኤ</corr><sic>ኢ</sic></choice>ል፡ አማኑኤል፡ በዕሉ፡ አስማቲከ። ቦቱ፡
                                ለ<surplus>ን</surplus>ስሑ፡ ሕምዙ፡ ለሞት፡ ወተቀጥቀጠ፡ ኃይሉ፡ ከማሁ<supplied reason="omitted">፡</supplied> ይልሳህ፡ ሕምዞሙ፡ ለአጋንንት፡
                                ወይትቀጥቀጥ፡ ኃይሎሙ፡ ለሰይጣናት፡ ከመ፡ ኢይቅረቡ፡ ኀበ፡ ነፍሱ፡ ወሥጋሁ፡ ለገብርከ፡ 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ገብረ<supplied reason="omitted">፡</supplied>
                                    ማርያም፡ አየለ<supplied reason="omitted">፡</supplied> ካሳ፡</persName> <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ፃዕ፡ 
                                ፃዕ<supplied reason="omitted">፡</supplied> ፃዕ፡ ፃዕ፡ በስመ፡ አምላክ፡ <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ፃዕ፡ በኃይለ፡ ዝንቱ፡
                                ወበኃይለ፡ እግዚአብ<choice><corr resp="bm:GrebTiss1935Codices">ሔ</corr><sic>ሒ</sic></choice>ር፡ ልዑል፡ ወግሩም፡ አሜን፡ 
                                <gap reason="ellipsis" resp="bm:GrebTiss1935Codices"/> ዕቀበኒ፡ ወ<surplus>ዐ</surplus>አድኅነኒ፡ <sic>እምእኵያን፡</sic> ሊተ፡ ለገብርከ፡ 
                                <persName ref="https://betamasaheft.eu/PRS15322GabraMa">ገብረ፡ ማርያም፡ አየለ፡ ካሳ።</persName>
                            </explicit>
                        </msItem>
