                                    <note>95 salām-hymns</note>
                                </msItem>
                                <msItem xml:id="p1_i1.12">
                                    <locus from="122ra" to="134vb"/>
                                    <title type="complete">Collection for Ḥamle</title>
                                    <note>123 salām-hymns</note>
                                </msItem>
                                <msItem xml:id="p1_i1.13">
                                    <locus from="134vb" to="145rb"/>
                                    <title type="complete">Collection for Naḥase</title>
                                    <note>105 salām-hymns</note>                                                                
                                </msItem>
                                <msItem xml:id="p1_i1.14">
                                    <locus from="145rb" to="146vb"/>
                                    <title type="incomplete">Collection for Ṗagʷǝmen</title>
                                    <note>16 salām-hymns. The text ends abruptly after the 16th salām for Ṗagʷǝmen, belonging to the 6th of this month, 
                                        which is the last but one according to the edition of <bibl><ptr target="bm:GrebautGuidi1913Synaxaire"/><citedRange unit="page">472</citedRange></bibl>.</note>
                                    <explicit xml:lang="gez">ሰይከ፡ እግዚኦ፡ ጸሪቀ፡ መበለት፡ ውኩፈ። እምእለ፡ አብኡ፡ ብዑላን፡ ተርፈ።</explicit>
                                </msItem>
                            </msItem>
