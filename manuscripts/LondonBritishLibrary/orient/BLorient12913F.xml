                        <msItem xml:id="ms_i1">
                            <title type="complete">Letter from Menelik II to Gordon Pasha</title>
                            <note>Letter from <persName ref="https://betamasaheft.eu/PRS7006Menilek">Mǝnilǝk</persName> to <persName role="owner" ref="https://betamasaheft.eu/PRS4765Gordon">Charles George Gordon</persName>, who is
                                called <foreign xml:lang="am">ቍርዱን፡ ባሻ፡</foreign>. In the letter, Mǝnilǝk is designated as nǝguś, but the legend on the
                                round seal at the bottom designates him as nǝguśa nagaśt.</note>
                            <textLang mainLang="am"/>
                        </msItem>
