                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <locus target="#1r"/>
                            <title type="complete">Letter of safe conduct to Mr. Richard Hosking</title>
                                <note>Typewritten letter of safe conduct by the Chancellery of the Ethiopian Orthodox Church, signed by 
                                    <persName ref="https://betamasaheft.eu/PRS15032SemenahB">Sǝmenah Baqalā</persName>, vice-director for relations with foreign churches to 
                                    <persName ref="https://betamasaheft.eu/PRS15031Hosking">Richard Hosking</persName> of the British Museum to visit the following churches on the
                                    <placeName ref="https://betamasaheft.eu/LOC5888Tana">lake Ṭānā</placeName> and see the Ethiopic manuscripts preserved there:
                                    Daq (!) ʾƎsṭifānos (<placeName ref="https://betamasaheft.eu/INS0329DE">Dāgā ʾƎsṭifānos</placeName>), 
                                    <placeName ref="https://betamasaheft.eu/INS0357Kebran">Kǝbrān Gabrǝʾel</placeName>,
                                    <placeName ref="https://betamasaheft.eu/LOC4970NargaS">Narga Śǝllāse</placeName>,
                                    <placeName ref="https://betamasaheft.eu/LOC6307WerraK">ʾUrā Kidāna Mǝhrat</placeName> and 
                                    <placeName ref="https://betamasaheft.eu/LOC7468KrestosSam">Krǝstos Samrā</placeName>.
                                    The letter is addressed to <persName ref="https://betamasaheft.eu/PRS7822Petros">H. B. ʾabuna Ṗeṭros, archbishop of Gondar</persName>,
                                    and <persName ref="https://betamasaheft.eu/PRS6772Marqos">H. B. ʾabuna Mārqos, archbishop of Goǧǧām at Dabra Mārqos</persName>.</note>
                                <textLang mainLang="am"/>
                        </msItem>
                    </msContents>
