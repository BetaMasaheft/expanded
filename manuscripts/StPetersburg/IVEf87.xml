                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <title type="complete" cert="medium" ref="https://betamasaheft.eu/LIT4644MagicPr">Ṣalot baʾǝnta ḥǝmāma ʿāynat bāryā wa-ʿāyna sabʾ ʾǝkuy
        wa-legewon</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis" resp="PRS9602Turaev"/> ጸሎት፡ በዕንተ፡ ሕማመ፡ ባርያ፡ ወዓይነ፡ ሰብዕ፡ <foreign>In the name  <gap reason="ellipsis" resp="PRS9602Turaev"/>prayer against bāryā and evil eye</foreign>
                     </incipit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5036ProtectivePrayer">Protective prayer against illness</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis" resp="PRS9602Turaev"/> ጸሎት፡ በእንተ፡ ሕማመ፡ <foreign xml:lang="en">In the name  <gap reason="ellipsis" resp="PRS9602Turaev"/>prayer against the illness</foreign>
                     </incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5037ProtectivePrayer">Ṣalot baʾǝnta ḥǝmāma bāryā wa-gǝrmā madfāna ṣor za-sǝmu
        Qaʾmon</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis" resp="PRS9602Turaev"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ባርያ፡ ወግርማ፡ መድፍነ፡ ጾር፡ ዘስሙ፡ ቀእሞን፡ <foreign xml:lang="en">
                                In the name  <gap reason="ellipsis" resp="PRS9602Turaev"/>prayer against the illness of bāryā and the dread of the enemy's treasure, whose name is Qaʾǝmon
                            </foreign>
                     </incipit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <title type="complete" cert="medium" ref="https://betamasaheft.eu/LIT4570MagicPr">Ṣalot baʾǝnta maftǝḥe śǝrāy</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis" resp="PRS9602Turaev"/> ጸሎት፡ በእንተ፡ ሕማመ፡ (sic!) መፍትሔ፡ ሥራይ
                                <foreign xml:lang="gez"/>In the name  <gap reason="ellipsis" resp="PRS9602Turaev"/>prayer against the illness (sic!) of  undoing charms</incipit>
                        </msItem>
