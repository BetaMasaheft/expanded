                  <additions>
                      <list>
                        <item xml:id="a1">
                           <locus target="#1r"/>
                          <desc type="Unclear" xml:lang="gez"/>
                           <note>List of the commemoration feasts of the Apostles.</note>
                          </item>

                          <item xml:id="a2">
                          <locus target="#2r"/>
                          <desc type="Unclear" xml:lang="gez"/>
                          <note>Beginning of an unidentified prayer to <persName ref="https://betamasaheft.eu/PRS6819Mary">
                          St Mary</persName>.</note>
                        </item>

                            <item xml:id="a3">
                              <locus from="3r"/>
                               <desc type="GuestText" corresp="LIT3595Miracle" cert="low" xml:lang="gez"/>
                               <note>A miracle of Mary telling about an icon in the hospital
                                 <foreign>ቤተ፡ ሕሙማን፡</foreign> that consouls the sick.</note>
                             </item>

                             <item xml:id="a4">
                               <locus from="4r"/>
                                <desc type="GuestText" corresp="LIT3605Miracle" xml:lang="gez"/>
                                <note>A miracle of Mary concerning <persName ref="https://betamasaheft.eu/PRS4587Georget">George the New</persName>
                                who was released from prison.</note>
                              </item>

                              <item xml:id="a5">
                                <locus from="31v"/>
                                 <desc type="MagicText" xml:lang="gez"/>
                                 <note>Magic prayer against pain in the eyes.</note>
                                 <q>ጸሎት፡ በእንተ፡ ኅማመ፡ አይንት፡</q>
                                 </item>

                              <item xml:id="a6">
                                <locus from="32r"/>
                                 <desc type="MagicText" xml:lang="gez"/>
                                 <note>Magic prayer against demons and "evel eye".</note>
                                 <q>አንተ፡ በሰማይ፡ ወአንተ፡ በምድር፡ አንተ፡ ትቀትል፡ ወአንተ፡ ተሐዩ፡</q>
                                 </item>

                               <item xml:id="a7">
                                 <locus from="34r"/>
                                  <desc type="MagicText" xml:lang="gez"/>
                                  <note>Conjurations preventing
                                    from leaving for a different place</note>
                                </item>
                           </list>


                  </additions>


