                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script"/>
                        <seg type="ink">Black, red</seg>
                        <date/>
                        <desc>
                           <persName ref="https://betamasaheft.eu/PRS9602Turaev">Turaev
                        </persName>states that the text is written
                        in several different hands, but neither describes them
                        and nor proposes any dating for the manuscript.
                      </desc>
