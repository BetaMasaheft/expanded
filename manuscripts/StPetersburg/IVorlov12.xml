               <msContents>
                  <summary/>

                  <msItem xml:id="ms_i1">
                    <locus from="6v" to="30v"/>
                    <title type="incomplete" ref="https://betamasaheft.eu/LIT1850Malkea">ጉባኤ፡ መልክእ፡</title>
                      <textLang mainLang="gez"/>

                     <msItem xml:id="ms_i1.1">
                        <locus from="6v"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT2842RepCh125">Malkǝʾa masqal</title>
                        <incipit>ሰላም፡ ለዝክረ፡ ስምከ፡ በመጽሔተ፡ መስቀል፡ ዘተለክዓ፡</incipit>
                     </msItem>

                     <msItem xml:id="ms_i1.2">
                        <locus from="14r"/>
                       <title type="complete" ref="https://betamasaheft.eu/LIT2932RepCh213">መልክአ፡ ፍልሰታ፡</title>
                       <incipit>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ምስለ፡ ነፍስኪ፡</incipit>
                      </msItem>

                     <msItem xml:id="ms_i1.3">
                        <locus from="18r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT5694LukeSalam">Luke 1:26-38 and salām-hymns</title>
                        <note>Unspecified salāms said by <persName ref="https://betamasaheft.eu/PRS4372Gabreel">
                          St Gabriel</persName>, preceded by Luke 1:26-38.</note>
                        </msItem>

                     <msItem xml:id="ms_i1.4">
                        <locus from="21r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1716Kidanz">ኪዳን፡ ዘነግህ፡</title>
                        <note>Musical notation on the first leaf.</note>
                        </msItem>

                        <msItem xml:id="ms_i1.5">
                           <locus from="30r"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT3101RepCh381">Hymn to the Four Cherubim</title>
                         <incipit>
                           <lb n="1"/>ካህናተ፡ ሰማይ፡ ሱራፌል፡ ቅሩባነ፡ አምላክ፡ አንትሙ፡
                           <lb n="2"/>ጸሎተ፡ ቅዱሳን፡ ምሉዕ፡ ፍያላቲክሙ፡
                           <lb n="3"/>ለምሕረት፡ ዘኢታርመሙ፡
                         </incipit>
                         <note>Seven triplets.</note>
                           </msItem>


                        </msItem>
                     </msContents>

