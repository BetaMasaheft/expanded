                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <title type="complete" ref="https://betamasaheft.eu/LIT1120Apocal">Apocalypse of Baruch</title>
                            <textLang mainLang="gez"/>
                            
                            <incipit xml:lang="gez">
                                <hi rend="rubric">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩</hi> አምላክ፡ ራዕይ፡ 
                                ዘአረዮ፡ <hi rend="rubric">እግዚአብሔር፡</hi> ለቅዱስ፡ ባሮክ። እምድኅረ፡ ኮነ፡ ሎቱ፡ ፴ወ፭ ዓመተ፡ 
                                ወሰድዎ፡ አቡሁ፡ ወእሙ፡ ኢየሩሰሌም፡ ወዓቀምዎ፡ ቅድመ፡ ሊቀ፡ ካህናት፡ ዘስሙ፡ 
                                እለ፡ እስክንድሮስ፡ ወደመሮ፡ ኀበ፡ አፃዌ፡ ኃዋኅው፡ ወነ<pb/>በረ፡ እንዘ፡ ይትላዓክ፡ 
                                ፳ ዓመተ።
                            </incipit>
                            <explicit xml:lang="gez">
                                ወይመጽእ፡ ንጉሠ፡ ሰማያት፡ ወምድር፡ ወይፈድዮ፡ ለ<pb/>ኵሉ፡ በከመ፡ 
                                ምግባሩ፡ ሎቱ፡ ስብሐት፡ ወአኰቴት። <hi rend="rubric">ወልደ፡ ማርያም፡</hi> አነ። ኃጥእ፡ 
                                <sic resp="DR">ወእባሲ፡</sic> ገብረ፡ 
                                <hi rend="rubric">እግዚአብሔር፡</hi> ለዓለም፡ ዓለም፡ አሜን። ወአሜን። ለይኩን። ። ። ተጽሕፈ መጽሐፈ፡ 
                                <hi rend="rubric">ባሮክ፡</hi> <sic resp="DR">በእምሰለ፡</sic> <hi rend="rubric">ገነት፡</hi> ዘደብረ፡ <hi rend="rubric">ቁስቋም፡</hi> <sic resp="DR">ጸሐፌሁ፡</sic> ገብረ፡ <hi rend="rubric"><sic resp="DR">እፍዚአብሔር።።</sic></hi>
                            </explicit>
                        </msItem>
                      
