               <msPart xml:id="p1">
                  <msIdentifier/>
                  <msContents>
                     <summary/>
                     
                     <msItem xml:id="p1_i1">
                        <locus from="1r" to="14v"/> 
                        
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1570habeka">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ዮሐንስ፡ ወንጌላዊ፡ ሐዋርያ፡ 
                           </title>
                        <textLang mainLang="gez"/>
                        <incipit type="supplication" xml:lang="gez">ጸሎቱ፡  ወበረከቱ፡ የሀሉ፡ ምስለ፡ <persName ref="https://betamasaheft.eu/PRS11601EdaM">እደ፡ ማርያም።</persName>
                        </incipit>
                        <incipit xml:lang="gez">ኀቤከ፡ እግዚኦ፡ አንቃዕዶነ፡ አዕይንተነ፡ አንሣዕነ፡ ልበነ፡ ወአልዓልነ፡ ሕሊናነ፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">21</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i2">
                        <locus from="14v" to="25v"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1103Anapho">አኰቴተ፡ ቍርባን፡ ዘ፫፻፲ወ፰ ርቱዓነ፡ ሃይማኖት።</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ግሩም፡ በውስተ፡ ደመናት፡ ወልዑል፡ እምሰማያት፡ እግዚአብሔር፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">26</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i3">
                        <locus from="26r" to="34v"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1347Epipha">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ኤጲፋንዮስ፡ አርቶዶክሳዊ፡</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ዐቢይ፡ ውእቱ፡ እግዚአብሔር፡ በዕበዩ፡ ቅዱስ፡ በቅዳሴሁ፡ እኩት፡ በአኰቴቱ፡ ስቡሕ፡ ውእቱ፡ በስብሐቲሁ፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">29</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i4">
                        <locus from="35r" to="42v"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2404Tanseu">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ያዕቆብ፡ ዘስሩግ፡ ጸሎቱ፡ 
                           ምስሌነ፡ ተሀሉ።</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ተንሥኡ፡ በፍርሐተ፡ እግዚአብሔር፡ ከመ፡ ታጽምዑ፡ አርኅው፡ መካክወ፡ አዕዛኒክሙ፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">31</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i5">
                        <locus from="42v" to="49r"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT3120Anapho">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ዮሐንስ፡ አፈ፡ ወርቅ፡ በረከቱ፡ 
                           ትኩን፡ ምስሌነ፡ አሜን፡</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ናሁ፡ ንዜኑ፡ ህላዌሁ፡ ለአብ፡ ዘሀሎ፡ እምቅድመ፡ ይትፈጠር፡ ዓለም፡ ወይሄሉ፡ እስከ፡ ለዓለመ፡ ዓለም፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">20</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i6">
                        <locus from="49r" to="52v"/> 
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1100Anapho">ቅዳሴ፡ ዘእግዚእነ፡ ወመድኃኒነ፡ ኢየሱስ፡ ክርስቶስ፡</title>
                        <textLang mainLang="gez"/>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">15</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i7">
                        <locus from="53" to="55"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1104Anapho">ቅዳሴ፡ ሐዋርያት፡</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ነአኵተከ፡ እግዚኦ፡ በፍቁር፡ ወልድከ፡ ኢየሱስ፡ ዘበደኃሪ፡ መዋዕል፡ ፈኖከ፡ ለነ፡ ወልደከ፡</incipit>
                     </msItem>
                     
                     <msItem xml:id="p1_i8">
                        <locus from="55v" to="68v"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1099Anapho">ቅዳሴ፡ ዘእግዝእትነ፡ ማርያም፡ ዘደረሰ፡ አባ፡ ህርያቆስ።</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ጐሥዓ፡ ልብየ፡ ቃለ፡ ሠናየ፡</incipit>
                        <explicit xml:lang="gez">ነአኵቶ፡ ለእግዚአብሔር፡ በእንተ፡ ጸጋ፡ ዘአሰልጠና፡ ለእሙ፡ ላዕለ፡ ዛቲ፡ ቅዳሴ፡ ወረሰየነ፡ ንሕነሂ፡ ንንብብ፡ 
                           ወንፈጽም፡ ኪያሃ፡ በሥምረቱ፡ ወውእቱ፡ ጠቢብ፡ እስከ፡ ለዓለመ፡ ዓለም።</explicit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">16–18</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i9">
                        <locus from="68v" to="72v">
                           <certainty locus="value" match="../@to" cert="low"/>
                        </locus>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2040Naakkw">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ጎርጎርዮስ፡</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">ነአኵቶ፡ ለገባሬ፡ ሠናያት፡ ላዕሌነ፡ እግዚአብሔር፡ መሐሪ፡ አቡሁ፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">24</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
                     <msItem xml:id="p1_i10">
                        <locus from="73r" to="74v"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT3180Anapho">አኰቴተ፡ ቍርባን፡ ዘቅዱስ፡ ዲዮስቆሮስ፡</title>
                        <textLang mainLang="gez"/>
                        <incipit xml:lang="gez">እምቅድመ፡ ዓለም፡ ወእስከ፡ ለዓለም፡ ሀሎ፡ እግዚአብሔር፡ በመንግሥቱ፡</incipit>
                        <listBibl type="secondary">
                           <bibl>
                              <ptr target="bm:Hammerschmidt1987Anaphoras"/>
                              <citedRange unit="page">18–19</citedRange>
                           </bibl>
                        </listBibl>
                     </msItem>
                     
