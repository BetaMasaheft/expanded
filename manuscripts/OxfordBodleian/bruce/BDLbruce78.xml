                     <textLang mainLang="gez"/> 
                     
                     <msItem xml:id="ms_i1.1">
                        <locus from="1ra" to="12rb"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionGospels">Four Gospels: Introduction to the Four
        Gospels</title>
                        <textLang mainLang="gez"/> 
                        
                        <msItem xml:id="ms_i1.1.1">
                           <locus from="1ra" to="7va"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionMaqdema">Four Gospels: Maqdǝma wangel</title>
                           <textLang mainLang="gez"/>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.2">
                           <locus target="#7vb"/>
                           <locus from="4ra" to="4rb"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1349EpistlEusebius">Epistle of Eusebius to Carpianus (General record)</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.3">
                           <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionGessawe">Four Gospels: Gǝṣṣāwe śǝrʿāt</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.4">
                           <title type="complete" ref="https://betamasaheft.eu/LIT1558Matthew#SecondIntroduction">Gospel of Matthew (Collection): Relialibity of
        the Gospel</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.5">
                           <locus from="9ra" to="11rb"/>
                           <title type="incomplete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionCanons">Four Gospels: Canons of Eusebius</title>
                           <textLang mainLang="gez"/>  
                           <note>There are only four canon tables.</note>
                        </msItem>
                     </msItem>
                     
                     
                     <msItem xml:id="ms_i1.2">
                        <locus from="13ra" to="56ra"/>
                        <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2709Matthew">ወንጌል፡ ዘማቴዎስ፡</title>
                        <textLang mainLang="gez"/> 
                        <note>The text of this Gospel is filled to such an extent with glosses that it resembles more a paraphrase
                        than a translation of the Greek text.</note>
                     </msItem>
                        
                        <msItem xml:id="ms_i1.3">
                           <locus from="56ra" to="56va"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1882MarkGo#BiographyMark">Gospel of Mark (Collection): Biography of
        Mark</title>
                           <textLang mainLang="gez"/> 
                           <note>The various divisions of the Gospel of Mark and the 48 sections into which the
                           Ethiopic text is divided are listed.</note>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.4">
                           <locus from="57ra" to="80rb"/>
                           <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT2711Mark">ወንጌል፡ ዘማርቆስ፡</title>
                           <textLang mainLang="gez"/> 
                           <note>There are many glosses, but less than in <ref target="#ms_i1.2"/>.</note>
                        </msItem>
                        
                        <msItem xml:id="ms_i1.5">
                           <locus from="80rb" to="81ra"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1812GospelLuke#BiographyLuke">Wangel za-Luqās: Biography of Luke</title>
                           <textLang mainLang="gez"/> 
                           <note>The 84 chapters, into which <ref type="work" corresp="https://betamasaheft.eu/LIT1812GospelLuke">Wangel za-Luqās</ref> is divided, are added after
                           <ref target="#ms_i1.1.4"/>.</note>
                        </msItem>
                     
