                  <msItem xml:id="ms_i1">
                        <locus from="1r" to="206v"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel">Four Gospels</title>
                        <textLang mainLang="gez"/> 
                     <note>There are numerous variants, duplications, glosses and embellishments as compared with printed versions.</note>
                     
                     <msItem xml:id="ms_i1.1">
                        <locus from="1r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionGospels">Four Gospels: Introduction to the Four
        Gospels</title>
                        <textLang mainLang="gez"/> 
                        
                        <msItem xml:id="ms_i1.1.1">
                           <locus from="1r" to="2r"/>
                           <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionGessawe">
                              <hi rend="rubric">ግጻዌ፡ ሥርዓት፡</hi>
                           በእንተ፡ ኅብረተ፡ ቃላት፡ ዘአርባዕቱ፡ ወንጌላት።</title>
                           <note>The last sentence of <ref type="work" corresp="https://betamasaheft.eu/LIT1560Gospel#IntroductionGessawe">Four Gospels: Gǝṣṣāwe śǝrʿāt</ref>
                           on <locus target="#2r"/> is copied in a pupil's hand, <ref target="#h2"/>, next to the original.</note>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.2">
                           <locus from="2r"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1349EpistlEusebius">Epistle of Eusebius to Carpianus (General record)</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.1.3">
                           <locus from="3v"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1560Gospel#IntroductionCanons">Four Gospels: Canons of Eusebius</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                     </msItem>
                     
                     <msItem xml:id="ms_i1.2">
                        <locus from="7r" to="30v"/>
                        <locus from="68" to="106r"/>
                        <title type="complete" ref="https://betamasaheft.eu/LIT1558Matthew">Gospel of Matthew (Collection)</title>
                        <textLang mainLang="gez"/> 
                        <note>
                           <locus target="#25"/> is bound upside down.</note>
                        <note>
                           <locus target="#68r"/> starts with Matthew 12:5.</note>
                     </msItem>
                     
                     <msItem xml:id="ms_i1.3">
                        <locus target="#106r"/>
                        <locus from="60" to="67"/>
                        <locus from="31r" to="57r"/>
