                        <textLang mainLang="gez"/> 
                        
                        <msItem xml:id="ms_i1.3.1">
                           <locus target="#106r"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT1882MarkGo#TituliMark">Gospel of Mark (Collection): Tituli of the Gospel of
        Mark</title>
                           <textLang mainLang="gez"/> 
                        </msItem>
                        
                        <msItem xml:id="ms_i1.3.2">
                           <locus from="60" to="67"/>
                           <locus from="31r" to="57r"/>
                           <title type="complete" ref="https://betamasaheft.eu/LIT2711Mark">Gospel of Mark (Mk)</title>
                           <textLang mainLang="gez"/> 
                           <note>
                              <locus from="60r" to="67v"/> contains Mark 1:1-5:20. <locus target="#31r"/> starts with Mark 5:20.</note>
                           <note>On <locus target="#62v"/> there is an erroneous rubricated heading <foreign xml:lang="gez">ማቴዎስ</foreign>
                           </note>
                        </msItem>
