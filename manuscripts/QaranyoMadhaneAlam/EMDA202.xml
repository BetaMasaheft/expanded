                    <msContents>
                        <summary>Old Testament Wisdom books: Enoch, fol. 7r-74v; Proverbs, fol. 77r-115v; Ecclesiastes, fol. 115v-128r; Wisdom of Solomon, fol. 128v-156r; Song of Songs, fol. 156v-163r
                            
                        </summary>
                        <msItem xml:id="ms_i1">
                            <locus from="7" to="74"/>
                            <title ref="https://betamasaheft.eu/LIT1340EnochE">Henok</title>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <locus from="77r" to="115v"/>
                            <title>Proverbs</title>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <locus from="115v" to="128r"/>
                            <title>Ecclesiastes</title>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <locus from="128v" to="156r"/>
                            <title>Wisdom of Solomon</title>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <locus from="156v" to="163r"/>
                            <title>Song of Songs</title>
                        </msItem>
                    </msContents>
                    <physDesc>
                        <objectDesc form="Codex">
                            <supportDesc>
                                <support>
                                    <material key="parchment"/></support>
                                
                                <condition key="good"/>
                            </supportDesc>
<layoutDesc><layout columns="2"/></layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic"/>
                        </handDesc>                       
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus target="#1r"/>
                                    <desc type="GuestText">ስለት፡ ዘቤተ፡ ክርስቲያን</desc>
                                </item>
                                <item xml:id="a2">
                                    <locus from="1v" to="2v"/>
                                    <desc type="CalendaricNote">Astronomical tables with descriptions of the brightness of the sun and moon, zodiac signs, month names, celestrial spheres, and correspondance between the four body liquids and four elements. </desc> 
                                 </item>    
                                <item xml:id="a3">
                                    <locus from="3r" to="3v"/>
                                    <desc type="Excerpt">Excerpt from Chapter 78 of <ref type="work" corresp="https://betamasaheft.eu/LIT1340EnochE">(Ethiopic Book of) Enoch</ref></desc>
                                </item>
                                <item xml:id="a4">
                                    <locus from="3v" to="4v"/>
                                    <desc type="Excerpt">Excerpt from <ref type="work" corresp="https://betamasaheft.eu/LIT3989Aragawi">መጽሐፈ፡ አረጋዊ፡ መንፈሳዊ</ref></desc>
                                 </item>
                                <item xml:id="a5">
                                    <locus target="#5r"/>
                                    <desc type="Excerpt">Excerpt from ነገረ፡ አብራይስጢ፡ አምንስቲ</desc>
                                </item>
                                <item xml:id="a6">
                                    <locus target="#5r"/>
                                    <desc type="Gloss">Glossaries of metrological and measuring terminologies</desc>
                                </item>
                                <item xml:id="a7">
                                    <locus target="#5r"/>
                                    <desc type="GuestText">Fragment of a work by <persName ref="https://betamasaheft.eu/PRS4439Galen">Galen</persName>, possibly his "On Diagnosis from Dreams"</desc>
                                </item>
                                <item xml:id="a8">
                                    <locus target="#5v"/>
                                    <desc type="GuestText">Computus text and table of the moon</desc>
                                </item>
                                <item xml:id="a9">
                                    <locus from="5v" to="6r"/>
                                    <desc type="GuestText">አምጣነ፡ ድካማ፡ ለንባብነ, a treatise concerning the Trinity</desc>
                                </item>
                                <item xml:id="a10">
                                    <locus target="#6v"/>
                                    <desc type="Excerpt">Excerpt from <ref type="work" corresp="https://betamasaheft.eu/LIT3330Cyril">ድርሳነ፡ ቄርሎስ</ref></desc>
                                </item>
                            </list>
                        </additions>
