                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script" cert="medium">Late eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <list type="abbreviations">
                           <item>
                              <abbr>ሰ፤ ለ፤ ቅ፤</abbr> for <expan>ሰአሊ፡ ለነ፡ ቅድስት፡</expan></item>
                        </list>
                        <seg type="rubrication">Divine names, chapter numbers, incipits, some
                           punctuation marks, some Ethiopic numerals as well as supplicants’
                           names.</seg>
                        <desc>Regular, neat, careful.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="miniature">
                        <locus target="#1r"/>
                        <desc>A miniature depicting the Lord appearing to <persName ref="https://betamasaheft.eu/PRS7181MosesM">Moses</persName>.</desc></decoNote>
                     <decoNote xml:id="d2" type="miniature">
                        <locus target="#2v"/>
                        <desc>A miniature depicting the <term key="angel" ana="#angel">angel</term> expeling Adam
                           and Eve from Eden.</desc></decoNote>
                     <decoNote xml:id="d3" type="miniature">
                        <locus target="#3va"/>
                        <desc>A miniature depicting the Magi adoring <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Infant Jesus</persName>.</desc></decoNote>

                     <decoNote xml:id="d4" type="miniature">
                        <locus target="#4v"/>
                        <desc>A miniature in two parts. The top one depicts, according to <bibl corresp="http://zotero.org/groups/358366/items/TDIJ8SGG"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Cerulli1965ChesterBeatty"/><title level="m">I manoscritti etiopici della Chester Beatty Library in Dublino</title><title level="s">&lt;hi rend="italics"&gt;Atti della Reale Accademia nazionale dei Lincei, Memorie, Classe di scienze morali, storiche e filologiche&lt;/hi&gt;</title><author><forename>Enrico</forename><surname>Cerulli</surname></author><pubPlace>[Roma]</pubPlace><publisher>[Accademia nazionale dei Lincei]</publisher><date>1965</date><series><title level="s">&lt;hi rend="italics"&gt;Atti della Reale Accademia nazionale dei Lincei, Memorie, Classe di scienze morali, storiche e filologiche&lt;/hi&gt;</title><biblScope unit="volume">Serie ottava, 11/6</biblScope></series><biblScope unit="volume">Serie ottava, 11/6</biblScope><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Dublin</note><note type="tag">Ethiopic</note><note type="tag">Manuscripts</note><note type="tag">bm:Cerulli1965ChesterBeatty</note></note><note type="tag">Cataloguing</note><note type="tag">Dublin</note><note type="tag">Ethiopic</note><note type="tag">Manuscripts</note><note type="tag">bm:Cerulli1965ChesterBeatty</note><citedRange unit="page">291–292</citedRange></bibl>, the Lord revealing the Nativity of
                              <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> to <persName ref="https://betamasaheft.eu/PRS3417David">David</persName>. The
                           one at the bottom depicts the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref> and <ref type="authFile" corresp="https://betamasaheft.eu/AT1020Massacre">Massacre of the Innocents</ref>. Traces of a <term key="protectiveCurtain" ana="#protectiveCurtain"/>.</desc></decoNote>

                     <decoNote xml:id="d5" type="miniature">
                        <locus target="#5r"/>
                        <desc>A miniature depicting <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> and two <term key="angel" ana="#angel">angels</term>. Traces of a <term key="protectiveCurtain" ana="#protectiveCurtain"/>.</desc></decoNote>
                     <decoNote xml:id="d6" type="miniature">
                        <locus target="#7r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>, adored by people.</desc></decoNote>
                     <decoNote xml:id="d7" type="miniature">
                        <locus target="#7v"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1002Annunciation">Annunciation</ref>.</desc></decoNote>
                     <decoNote xml:id="d8" type="miniature">
                        <locus target="#8r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref> and an <term key="angel" ana="#angel"/>.</desc></decoNote>
                     <decoNote xml:id="d9" type="miniature">
                        <locus target="#8va"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>. Infant Jesus is portrayed as a <term key="animal" ana="#animal">lamb</term>.</desc></decoNote>
                     <decoNote xml:id="d10" type="miniature">
                        <locus target="#8vb"/>
                        <desc>A miniature depicting the Holy Family.</desc></decoNote>
                     <decoNote xml:id="d11" type="miniature">
                        <locus target="#9r"/>
                        <desc>A miniature depicting Jacob’s ladder.</desc></decoNote>
                     <decoNote xml:id="d12" type="miniature">
                        <locus target="#9r"/>
                        <desc>A miniature of <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>.</desc></decoNote>
                     <decoNote xml:id="d13" type="miniature">
                        <locus target="#9vb"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>.</desc></decoNote>
                     <decoNote xml:id="d14" type="miniature">
                        <locus target="#9va"/>
                        <desc>A miniature depicting a Tabernacle.</desc></decoNote>
                     <decoNote xml:id="d15" type="miniature">
                        <locus target="#10r"/>
                        <desc>A miniature depicting <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> and the Syrian
                           potter.</desc></decoNote>
                     <decoNote xml:id="d16" type="miniature">
                        <locus target="#10v"/>
                        <desc>A miniature depicting the Syrian potter singing to <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>.</desc></decoNote>
                     <decoNote xml:id="d17" type="miniature">
                        <locus target="#11r"/>
                        <desc>A miniature depicting the Syrian potter, the <ref type="authFile" corresp="https://betamasaheft.eu/AT1030Trinity">The Trinity</ref> and <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>.
                        </desc></decoNote>
                     <decoNote xml:id="d18" type="miniature">
                        <locus target="#11v"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>, adored by people.</desc></decoNote>
                     <decoNote xml:id="d19" type="miniature">
                        <locus target="#12r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref> and the Temple
                        Lampstand.</desc></decoNote>
                     <decoNote xml:id="d20" type="miniature">
                        <locus target="#12vb"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>.</desc></decoNote>
                     <decoNote xml:id="d21" type="miniature">
                        <locus target="#12va"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref> and <persName ref="https://betamasaheft.eu/PRS3417David">David</persName>
                           burning incense. Traces of a <term key="protectiveCurtain" ana="#protectiveCurtain"/>.</desc></decoNote>
                     <decoNote xml:id="d22" type="miniature">
                        <locus target="#14r"/>
                        <desc>A miniature depicting the  <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>,
                           adored by <term key="angel" ana="#angel">angels</term>. </desc></decoNote>
                     <decoNote xml:id="d23" type="miniature">
                        <locus target="#13v"/>
                        <desc>A miniature depicting <persName ref="https://betamasaheft.eu/PRS1002Aaron">Aaron</persName> and his
                        rod.</desc></decoNote>
                     <decoNote xml:id="d24" type="miniature">
                        <locus target="#13ra"/>
                        <desc>A miniature depicting a blooming tree and two men, one of whom is
                           probably <persName ref="https://betamasaheft.eu/PRS3417David">David</persName>. The second man is not identified
                           yet.</desc></decoNote>
                     <decoNote xml:id="d25" type="miniature">
                        <locus target="#13rb"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>.</desc></decoNote>
                     <decoNote xml:id="d26" type="miniature">
                        <locus target="#15r"/>
                        <desc>A miniature depicting the Syrian potter dying and <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> carrying his
                           soul to Paradise.</desc></decoNote>
                     <decoNote xml:id="d27" type="miniature">
                        <locus target="#15v"/>
                        <desc>A miniature depicting three <term key="bird" ana="#bird">birds</term> announcing to <persName ref="https://betamasaheft.eu/PRS3417David">young David</persName> that he will become king. An
                              <term key="angel" ana="#angel"/> appears to the King <persName ref="https://betamasaheft.eu/PRS3417David">David</persName>
                              on the throne. <term key="animal" ana="#animal">Horses</term> stand in front of the
                           king.</desc></decoNote>
                     <decoNote xml:id="d28" type="miniature">
                        <locus target="#16v"/>
                        <desc>A miniature depicting the Syrian potter singing to <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>. Traces of a
                              <term key="protectiveCurtain" ana="#protectiveCurtain"/>. </desc></decoNote>
                     <decoNote xml:id="d29" type="miniature">
                        <locus target="#18r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1025NativityJesus">Nativity of Jesus</ref>.</desc></decoNote>
                     <decoNote xml:id="d30" type="miniature">
                        <locus target="#18r"/>
                        <desc>A miniature depicting an <term key="angel" ana="#angel"/> announcing the birth of Jesus to
                           the shepherds and their <term key="animal" ana="#animal">cattle</term>.</desc></decoNote>
                     <decoNote xml:id="d31" type="miniature">
                        <locus target="#19r"/>
                        <desc>A miniature depicting <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> and two <term key="angel" ana="#angel">angels</term>.</desc></decoNote>
                     <decoNote xml:id="d32" type="miniature">
                        <locus target="#19r"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1066DavidHarp">David Playing the Harp</ref>.</desc></decoNote>
                     <decoNote xml:id="d33" type="miniature">
                        <locus target="#19v"/>
                        <desc>A miniature in two parts depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>
                           and an <term key="angel" ana="#angel"/> at the top as well as <persName ref="https://betamasaheft.eu/PRS3417David">David</persName> at the bottom. A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/>, covering both miniatures, is sewn on the top with green and blue
                           threads.</desc></decoNote>
                     <decoNote xml:id="d34" type="miniature">
                        <locus target="#21v"/>
                        <desc>A miniature depicting the <ref type="authFile" corresp="https://betamasaheft.eu/AT1025NativityJesus">Nativity of Jesus</ref> and the defeat of the Devil.</desc></decoNote>
                  </decoDesc>
               </physDesc>
