               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i1">
                     <locus from="3ra" to="78vb"/>
                     <title ref="https://betamasaheft.eu/LIT3178Deggwa">Dǝggʷā (general record for multiple-type collections)</title>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="78vb" to="79ra"/>
                     <title ref="https://betamasaheft.eu/LIT3123Calend">Calendar of saints</title>
                  </msItem>
               </msContents>
               <physDesc>

                  <objectDesc form="Codex">
                     <supportDesc>
                        <support>
                           <material key="parchment"/>
                           <note>Holes in <locus target="#1 #2"/> were sewn up.</note>
                        </support>
                        <extent>
                           <measure unit="leaf" quantity="82">82</measure>
                           <measure unit="page" type="blank">5</measure>
                           <locus target="#2v"/>, <locus from="81" to="82"/>
                           <dimensions type="outer" unit="mm">
                              <height unit="mm">258</height>
                              <width unit="mm">205</width>
                           </dimensions><dimensions subtype="computed" unit="mm" type="outer"><height quantity="258" unit="mm"/><width quantity="205" unit="mm"/></dimensions>
                        </extent>
                        <foliation>Foliation provided by the library is marked in pencil on the right
                           upper edge of the recto folia.</foliation>
                        <condition key="good">At least two folia between <locus target="#79"/> and
                              <locus target="#80"/> were torn off, there is only one column
                           of <locus target="#80"/> left. Despite the fading of the red ink over time,
                           the text is mostly readable.</condition>
                     </supportDesc>
                     <layoutDesc>
                        <layout columns="3"/>
                     </layoutDesc>

                  </objectDesc>
                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script">Eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <seg type="rubrication">Divine names, first word of each verse, elements of
                           punctuation marks and numerals.</seg>
                        <desc>Regular, neat, careful, very small letters.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="ornamentation">
                        <locus target="#32vs #54vc #78vb"/>
                        <desc>Double horizontal ornamental bands (ḥarags), marking the end of a text
                           part and featuring triangles, dots and other geometrical figures.</desc>
                     </decoNote>
                     <decoNote xml:id="d2" type="headpieceBand">
                        <locus target="#35r"/>
                        <desc>A horizontal ornamental band (ḥarag) over columns a–c, featuring
                           triangles, dots and other geometrical figures.</desc>
                     </decoNote>
                  </decoDesc>
                  <additions>
                     <list>
                        <item xml:id="a1">
                           <locus target="#2r"/>
                           <desc>A short medical prescription in Amharic.</desc>
                           <q xml:lang="am"><gap reason="illegible"/> ፍሬ፡ ፯<surplus>፯</surplus>ቱን፡ ፯ቀን፡ ፯ወር፡ ሊይልቅ፡ ፯ቀን፡ ሲቀረው፡ ፯ቱን፡ ለ፩ቀን፡ እስከ፡ ፯ቀን፡ ድረስ፡ 
                              በትንሽ፡ ሳይበዛ፡ በነጭ፡ ማር፡ በጥዋት፡ ሽንት፡ ሻትሸን፡ ከሰው፡ ሳትነጋገር፡ በማር፡ ለውሶ፡ በትክል፡ ድንጋይ፡ ቆማ፡ 
                              ፊትዋን፡ ወደ፡ ምስራቅ፡ ምልሳ፡ ተዋጠው፡ </q>
                        </item>
                        <item xml:id="a2">
                           <locus target="#4r"/>
                           <desc type="OwnershipNote">A short ownership note mentioning <persName ref="https://betamasaheft.eu/PRS15433Zagiyorgis">Zagiyorgis</persName>, <persName ref="https://betamasaheft.eu/PRS15435IyasusMDM">ʾIyasus Moʿā Baʾǝda Māryām</persName>,
                              <persName ref="https://betamasaheft.eu/PRS15434WaldaDawitWS">Walda Dāwit</persName>, and <persName ref="https://betamasaheft.eu/PRS15444MazmuraDeng">Mazmura Dǝngǝl Sirāk</persName>, written by the main hand.
                           </desc>
                           <q xml:lang="gez"><hi rend="rubric">ዝመጽሐፍ፡ 
                              ዘዘጊዮርጊስ፡ ወመምህሩ፡ ኢያሱስ፡ ሞአ፡ በእደ፡ ማርያም፡ ወአቡሁ፡ ወልደ፡ ዳዊት፡ ወመዝሙረ፡ ድንግል፡ ሲራክ፡</hi></q>
                        </item>
                        
                        <item xml:id="a3">
                           <locus target="#78vb"/>
                           <desc type="OwnershipNote">A short ownership note mentioning <persName ref="https://betamasaheft.eu/PRS15433Zagiyorgis">Zagiyorgis</persName>, <persName ref="https://betamasaheft.eu/PRS15444MazmuraDeng">Mazmura Dǝngǝl Sirāk</persName>, and 
                              <persName ref="https://betamasaheft.eu/PRS15445GermaIya">Gǝrmā ʾIyasus</persName>, written by the main hand.</desc>
                           <q xml:lang="gez"><hi rend="rubric">ዝመጽሐፍ፡ 
                              ዘዘጊዮርጊስ፡ ወዘአቡሁ፡ መዝሙረ፡ ድንግል፡ ሲራክ፡ <unclear>ወእኁሁ፡</unclear> ግርማ፡ ኢያሱስ፡</hi></q>
                        </item>
                        <item xml:id="a4">
                           <locus from="79ra" to="79vc"/>
                           <desc type="GuestText">Different prayers, written by a crude
                              late-19th-century hand, with numerous corrections, making them
                              illegible. These prayers may be pen trials.</desc>
                        </item>
                        <item xml:id="a5">
                           <locus target="#80ra"/>
                           <desc>An excerpt from <title ref="https://betamasaheft.eu/LIT2361somade">Ṣoma dǝggʷā</title>, written probably by
                              the main hand.</desc>
                        </item>
                        <item xml:id="a6">
                           <locus target="#80va"/>
                           <desc>Short medical prescription in Amharic against malarian
                              fever.</desc>
                           <q xml:lang="am">የሀሎ፡ ለዓለም፡ የጨቀማ፡ ቅጥል፡ ዕፀ፡ <unclear>ዘዌለጥ፡</unclear> ናጨ፡
                              ቅጥል፡ የሬት፡ ስር፡ የምጽር፡ አባይ፡ ዘርጭ፡ አባይ፡ የጠሌገጅ፡ ስራቸውን፡ የገተም፡ ቅርፊት፡ የብስና፡
                              ቅርፊት፡ የንኩይ፡ ቅርፊት፡ ለወባ፡ መድኃኒት፡ በማር፡ <unclear>ዋጥ፡</unclear></q>
                        </item>
                        <item xml:id="e1">
                           <locus target="#1r #1v"/>
                           <desc>Pen trials.</desc>
                        </item>
                     </list>
                  </additions>
               </physDesc>
               <history>
                  <origin>
                     <origDate notBefore="1700" notAfter="1799">18th century</origDate>
                  </origin>
                  <provenance>On <locus target="#4r"/> and <locus target="#78vb"/>, there are two ownership notes mentioning <persName ref="https://betamasaheft.eu/PRS15433Zagiyorgis">Zagiyorgis</persName>, 
                     <persName ref="https://betamasaheft.eu/PRS15444MazmuraDeng">Mazmura Dǝngǝl Sirāk</persName>,
                     <persName ref="https://betamasaheft.eu/PRS15445GermaIya">Gǝrmā ʾIyasus</persName>, <persName ref="https://betamasaheft.eu/PRS15435IyasusMDM">ʾIyasus Moʿā Baʾǝda Māryām</persName>,
                     and <persName ref="https://betamasaheft.eu/PRS15434WaldaDawitWS">Walda Dāwit</persName> as the owners of the manuscripts.</provenance>
               </history>
