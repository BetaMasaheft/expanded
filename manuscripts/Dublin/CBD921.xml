               <history>
                  <origin>
                     <origDate notBefore="1600" notAfter="1699">17th century</origDate> The
                     manuscript consists of 2 production units. <ref target="#p1"/> consisting of
                        <locus from="1" to="81"/> and <locus target="#84"/> is dated by Cerulli to
                        17th century. The date of <ref target="#p2"/> consisting of
                        <locus from="82" to="84"/> is unknown; it was sewn later to the codex. </origin>
                  
                  <provenance>The manuscript contains a long supplication in Amharic and Gǝʿǝz for
                        <persName ref="https://betamasaheft.eu/PRS15446SagaZaab">Ṣaggā Zaʾab</persName>, written by <ref target="#h2"/>, on
                        <locus from="19vb" to="20rb"/>. Another
                     short supplication note for <persName ref="https://betamasaheft.eu/PRS15450WaldaMaryam">Walda Māryām</persName> can be found
                     on <locus target="#67r"/>.</provenance>
               </history>
               <msPart xml:id="p1">
                  <msIdentifier/>
                  <msContents>
                     <summary/>
                     <msItem xml:id="p1_i1">
                        <locus from="2r" to="2v"/>
                     
                        <title type="incomplete" ref="https://betamasaheft.eu/LIT6011FeastsList">List of commemorations for the Apostles and the
        Evangelists</title>
                     </msItem>
                     <msItem xml:id="p1_i2">
                        <locus from="3r" to="16ra"/>
                        <title ref="https://betamasaheft.eu/LIT1716Kidanz">Kidān za-nagh</title>
                        <notatedMusic>
                           <desc>Contains music notation.</desc>
                        </notatedMusic>
                     </msItem>
                     <msItem xml:id="p1_i3">
                        <locus from="15v" to="16ra"/>
                        <title type="incomplete" ref="https://betamasaheft.eu/LIT6011FeastsList">List of commemorations for the Apostles and the
        Evangelists</title>
                     </msItem>
                     <msItem xml:id="p1_i4">
                        <locus from="16v" to="18vb3"/>
                        <title>Liturgical invocation of the Epiclesis</title>
                        <incipit><q xml:lang="gez">በእንተ፡ ጥብሑ፡ ለወልድ፡ ቁ<supplied reason="omitted">ባ</supplied>ነ፡ አምልኮ፡ ዋሕድ፡ በውስተ፡ ዛቲ፡ ም<gap reason="illegible"/> ፡
                              መንፈስ፡ ቅዱስ፡ ይረድ፡ ኃይለ፡ ጸለኢ፡ ይስደድ።</q></incipit>
                     </msItem>
                     <msItem xml:id="p1_i5">
                        <locus from="18vb4" to="19vb"/>
                        <title type="incomplete" ref="https://betamasaheft.eu/LIT2362Songof">Song of Songs</title>
                        <notatedMusic>
                           <desc>Contains music notation.</desc>
                        </notatedMusic>
                     </msItem>
                     
                     <msItem xml:id="p1_i6">
                        <locus from="21r" to="73r"/>
                        <title ref="https://betamasaheft.eu/LIT4711Mastabqwe">Mastabqʷǝʿān</title>
                        <notatedMusic>
                           <desc>Contains music notation.</desc>
                        </notatedMusic>
                     </msItem>
                     <msItem xml:id="p1_i7">
                        <locus from="73v" to="81v"/>
                        <title type="incomplete" ref="https://betamasaheft.eu/LIT2709Matthew">Parable of the Ten Virgins (Mt
                           25:1–25:13)</title>
                     </msItem>
                  </msContents>
                  <physDesc>
                    
                     <handDesc>
                        <handNote xml:id="h1" script="Ethiopic" corresp="https://betamasaheft.eu/CBD921#p1_i1 #p1_i2 #p1_i6">
                           <seg type="script" cert="medium">Late seventeenth-century script.</seg>
                          
                           <desc>Neat, careful, round shape, some letters have serifs.</desc>
                        </handNote>
                        <handNote xml:id="h2" script="Ethiopic" corresp="https://betamasaheft.eu/CBD921#p1_i3 #p1_i4 #p1_i7">
                           <desc>Not very careful; big letters with serifs.</desc>
                        </handNote>
                        <handNote xml:id="h3" script="Ethiopic" corresp="https://betamasaheft.eu/CBD921#p1_i5">
                        <desc>Not very careful; small letters with long horizontal strokes.</desc></handNote>
                     </handDesc>
                     <additions>
                        <list>
                           <item xml:id="a1">
                              <locus target="#1v"/>
                              <desc type="GuestText">A fragment of <title ref="https://betamasaheft.eu/LIT6447MalkeaGMQeddus">Malkǝ'a gabra manfas qǝddus</title>, written by <ref target="#h2"/>.</desc>
                           </item>
                           <item xml:id="a2">
                              <locus from="19vb" to="20rb"/>
                              <desc>A supplication in Amharic and Gǝʿǝz for
                                 <persName ref="https://betamasaheft.eu/PRS15446SagaZaab">Ṣaggā Zaʾab</persName>, written by <ref target="#h2"/>.</desc>
                              <q xml:lang="am">በዜና፡ ማርቆስ፡ መስቀል፡ በደብረ፡ ሊባኖስ፡ መስቀል፡
                                 ተማኀጸኛለሁ፡ ለነፍሴም፡ ለሥጋዬም፡ ተማኀጸንኩ፡ ዕቀቦ፡ ወአድኃኖ፡ ለገብርከ፡ ጸጋ፡ ዘአብ።</q>
                              <q xml:lang="gez">ዘሠረቆ፡ ወዘፈሐቆ፡ በሥልጣነ፡ ጴጥሮስ፡ ወጳውሎስ፡ ውጉዝ፡ ከመ፡ አርዩስ፡</q>
                           </item>
                           <item xml:id="e1">
                              <locus target="#1r #84r"/>
                              <desc>Pen trial.</desc>
                           </item>
                           <item xml:id="e2">
                              <locus target="#4r #11v"/>
                              <desc>Spaces reserved for rubrication were left blank.</desc>
                           </item>
                        </list>
                     </additions>

                  </physDesc>

