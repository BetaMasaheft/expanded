               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="5v"/>
                     <title ref="https://betamasaheft.eu/LIT2999RepCh279">Malkǝʾa Yoḥannǝs Maṭmǝq</title>
                     <explicit type="supplication">A supplication for the comissioner <persName role="donor" ref="https://betamasaheft.eu/PRS15497ZawaldaMar">Zawalda
                        Māryām</persName>.</explicit>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="6v" to="133r"/>
                     <title ref="https://betamasaheft.eu/LIT2715John">Gospel of John</title>
                     <explicit type="supplication">A supplication for the comissioner <persName role="donor" ref="https://betamasaheft.eu/PRS15497ZawaldaMar">Zawalda Māryām</persName>, his
                        father <persName ref="https://betamasaheft.eu/PRS15507BaedaMaryam">Baʾǝda Māryām</persName>, his mother <persName ref="https://betamasaheft.eu/PRS15508Magdalawit">Magdalāwit</persName>, his sisters <persName ref="https://betamasaheft.eu/PRS15509WalattaIyasus">Walatta ʾIyasus</persName> and <persName ref="https://betamasaheft.eu/PRS15510WalattaMar">Walatta Māryām</persName> as
                        well as the scribe <persName role="scribe" ref="https://betamasaheft.eu/PRS15505Ewostatewos">ʾEwosṭātewos</persName>.</explicit>
                  </msItem>
               </msContents>
