                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <title ref="https://betamasaheft.eu/LIT7212PPTaosAzyos">Prayer containing ʾasmāt</title>
                            <incipit xml:lang="gez">ታዖስ፡ አዝዮስ፡ ማሲ፡ ማስያስ፡ አቅጼፌር፡ በስሙ፡ ለሐራጉ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT4035SenkessarDL#Naha12MikaelSalam">Sǝnkǝsār (Second revision, Dabra Libānos
        recension): Salām-hymn to Michael 'Salutation to thee, O Michael, angel of the covenant and
        counsel of God'</title>
                            <incipit xml:lang="gez">ሰላም፡ ለከ፡ መልአከ፡ ኪዳኑ፡ ወምክሩ፡ ለእግዚአብሔር፡ ልዑል፡ ዘግሩም፡
                                ግብሩ፡ በረድኤትከ፡ ረዋጺ፡ ዘአሠረ፡ ነፋስ፡ አሠሩ፡ ሶበ፡ ላዕሌየ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer (general record)</title>
                            <incipit xml:lang="gez">ለስይጣን፡ አስማት፡ ኃይል፡ ስፒራ፡ አሽፒራ፡ ገለሹ፡ ጨስሹር፡
                                ገንሌ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT6786MatthewEight">Matthew 8:28–32</title>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT2711Mark#chapter5">Gospel of Mark (Mk): ምዕራፍ 5</title>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT2713Luke#chapter8">Bǝsrāta Luqās: ምዕራፍ 8</title>
                        </msItem>
                        <msItem xml:id="ms_i7">
                            <title ref="https://betamasaheft.eu/LIT7895NzenuLaAmlak">Nǝzenu za-ʿAmlākǝna ḫirut tǝḥtǝnnā wa-yawwǝhat</title>
                            <note>This version of the prayer contains <term key="Asmat" ana="#Asmat"/> and <term key="MagicSymbols" ana="#MagicSymbols">charaktêres</term>.</note>
                        </msItem>
                        <msItem xml:id="ms_i8">
                            <title ref="https://betamasaheft.eu/LIT7365PrayerJesus">Yǝtnaśāʿ ʾƎgziʾabǝḥer wa-yǝzzaraw ḍaru ...</title>
                        </msItem>
                        <msItem xml:id="ms_i9">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT3500Chroni#Cap33">2 Chronicles: Chapter 33</title>
                            <incipit xml:lang="gez">እግዚኦ፡ አኃዜ፡ ኵሉ፡ ዓለም፡ አምላኮሙ፡ ለአበዊነ፡ ለአብርሃም፡
                                    ወለይስሕ<supplied reason="omitted">ቅ</supplied>፡ ወለያዕቆብ፡ ወለኵሉ፡
                                ፍሬሆሙ፡ ለጻድቃን።</incipit>
                        </msItem>
                        <msItem xml:id="ms_i10">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT1693John#JohnGospel">Gospel of John (Collection): Gospel of John</title>
                        </msItem>
                        <msItem xml:id="ms_i11">
                            <title ref="https://betamasaheft.eu/LIT6852Prayer">Prayer for binding the demons</title>
                        </msItem>
                        <msItem xml:id="ms_i12">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT3138Negeranni">Nǝgǝranni sǝmaka</title>
                        </msItem>
                        <msItem xml:id="ms_i13">
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT1693John#JohnGospel">Gospel of John (Collection): Gospel of John</title>
                        </msItem>
                    </msContents>
