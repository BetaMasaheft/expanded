                        <decoDesc>
                            <decoNote xml:id="d1" type="miniature"><desc>A <term key="MagicDrawing" ana="#MagicDrawing">magic drawing</term> depicting a face surrounded by four
                                        <term key="cross" ana="#cross">cross-shaped</term> wings with bands
                                    featuring eyes above and below it, most probably a <term key="angel" ana="#angel">cherub</term>.</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="miniature">
                                <desc>A <term key="MagicDrawing" ana="#MagicDrawing">magic drawing</term> depicting a
                                    face surrounded by four <term key="cross" ana="#cross">cross-shaped</term>
                                    wings with bands featuring rhombi above and below it, most
                                    probably a <term key="angel" ana="#angel">cherub</term></desc>
                            </decoNote>
                            <decoNote xml:id="d3" type="miniature"><desc>A <term key="MagicDrawing" ana="#MagicDrawing">magic drawing</term> depicting a face enclosed in a net
                                    with eyes in each corner. <q xml:lang="gez">ልብሰ፡ ቃል፡</q></desc>
                            </decoNote>
                            <decoNote xml:id="d4" type="miniature"><desc>A <term key="MagicDrawing" ana="#MagicDrawing">magic drawing</term> depicting a pair of lobed-shaped <term key="demon" ana="#demon">demons</term> consisting of eyes, wings and
                                    scales. <q xml:lang="gez">ምስለ፡ <sic>ዓባሁ፡</sic> ወልድ፡ ወመስለ፡ ብእሲቱ፡
                                        ንግስት፡ ማርያም፡ <unclear/></q></desc>
                            </decoNote>
                            <decoNote xml:id="d5" type="miniature"><desc>A <term key="MagicDrawing" ana="#MagicDrawing">magic drawing</term> depicting a face enclosed in a <term key="cross" ana="#cross"/> with checkerboard-like patterns at its
                                    corners and five <term key="animal" ana="#animal">birds</term>. <q xml:lang="gez">አእዋፍ፡ ብሂል፡ መለእክት፡ ዝጠል፡ ስም፡ ዘእ<supplied reason="omitted">ስ</supplied>ክንድር፡</q></desc>
                            </decoNote>
                        </decoDesc>
                    </physDesc>
