                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <seg type="script" cert="medium">Late eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <seg type="rubrication">The name of Jesus, chapter numbers, incipits, asterisks, a few other
                           punctuation marks and numerals.</seg>
                        <desc>Regular, neat, careful.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="miniature">
                        <locus target="#1r"/>
                        <desc>Sermon on the Mount. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ተናገሮሙ፡
                                 እግዚእነ፡ በመሳሌ፡ ለሕዝብ፡</hi></q></desc></decoNote>
                     <decoNote xml:id="d2" type="miniature">
                        <locus target="#2r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> heals a leper. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ፈወሰ፡ እግዚእነ፡ እምለምጹ፡</hi></q></desc></decoNote>
                     <decoNote xml:id="d3" type="miniature">
                        <locus target="#3v"/>
                        <desc>The centurion asks <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> to heal his
                           servant. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ሰአሎ፡ መስፍን፡ በእንተ፡ ደዌሁ፡
                                 ለገብር፡</hi></q></desc></decoNote>
                     <decoNote xml:id="d4" type="miniature">
                        <locus target="#4r"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1021MiraclesOfJesus">The healing of
                              the boy.</ref>
                           <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ረከቦ፡ መስፍን፡ ለቁልዔሁ፡
                           ሕያዎ፡</hi></q></desc></decoNote>
                     <decoNote xml:id="d5" type="miniature">
                        <locus target="#5r"/>
                        </decoNote>
                     <decoNote xml:id="d6" type="miniature">
                        <locus target="#6v"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> casts out a <term key="demon" ana="#demon"/>. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ አዉፅአሙ፡ እግዚእነ፡ ለአጋንንት፡ እምላዕለ፡
                                 ሰብእ።</hi></q></desc></decoNote>
                     <decoNote xml:id="d7" type="miniature">
                        <locus target="#7r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> tells to the scribe and the Disciple
                           to follow Him. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ይቤሎሙ፡ እግዚእነ፡
                                 ለጸሐፊ፡ ወለረድእ፡ ንዑ፡ ትልዉኒ።</hi></q></desc></decoNote>
                     <decoNote xml:id="d8" type="miniature">
                        <locus target="#8v"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> in the boat. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ኖመ፡ እግዚእነ፡ መልዕልተ፡ ሐመር፡ ወዘከመ፡ አንቅሕዎ፡ ሐዋርያት፡
                                 አምፍርሃት፡ ማዕበል።</hi></q></desc></decoNote>
                     <decoNote xml:id="d9" type="miniature">
                        <locus target="#9v"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1021MiraclesOfJesus">Jesus heals a
                              leper in Gergesa who were possessed by demons.</ref>
                           <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ፈወሰ፡ ድዉያነ፡ እለ፡ ቦሙ፡ አ<supplied reason="lost">ጋ</supplied>ንንት፤</hi></q>
                        </desc></decoNote>
                     <decoNote xml:id="d10" type="miniature">
                        <locus target="#10r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> sends <term key="demon" ana="#demon">demons</term>
                           into <term key="animal" ana="#animal">pigs</term>. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ አብሐሙ፡ ለአጋንንት፡ ይባኡ፡ ዉስተ፡ አኀርዉ።</hi>
                           </q></desc></decoNote>
                     <decoNote xml:id="d11" type="miniature">
                        <locus target="#11r"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1074JesusHealsParalytic"><seg corresp="AT1074JesusHealsParalytic">No item: AT1074JesusHealsParalytic</seg></ref></desc>
                        <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ነስቱ፡ ጠፈረ፡ ወዘከመ፡ ፈወሶ፡
                           ለመፃጉዕ፡</hi></q></decoNote>
                     <decoNote xml:id="d12" type="miniature">
                        <locus target="#12v"/>
                        <desc>The supper in <persName ref="https://betamasaheft.eu/PRS8854Simeon">Simeon’s</persName>
                           house.</desc>
                        <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ገብረ፡ መሳሐ፡ ፡ በቤተ፡
                        ስምዖን፤</hi></q></decoNote>
                     <decoNote xml:id="d13" type="miniature">
                        <locus target="#13r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> is asked to visit a dead girl.</desc>
                        <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ሰአሎ፡ <choice>
                                 <sic>መኮንን፡</sic>
                                 <corr>መኮነን፡</corr>
                              </choice> በእንተ፡ ደዌሃ፡ ወለቱ።</hi></q></decoNote>
                     <decoNote xml:id="d14" type="miniature">
                        <locus target="#13v"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1021MiraclesOfJesus">The woman with
                              the hemorrhage.</ref> The centurion asks <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> to heal his daughter. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ገሰሰት፡ ጽንፈ፡ ልብሱ፡ እንተ፡ ደም፡ ይዉኅዘ። ወዘከመ፡ ነገሮ፡ መስፍን፡
                                 ጽንዓ፡ ደዌሃ፡ ለወለቱ</hi></q></desc></decoNote>
                     <decoNote xml:id="d15" type="miniature">
                        <locus target="#14v"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1021MiraclesOfJesus">The resurrection
                              of the daughter of the centurion.</ref>
                           <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ፈወሳ፡ እግዚእነ፡ ለወለተ፡
                           መስፍን፡</hi></q></desc></decoNote>
                     <decoNote xml:id="d16" type="miniature">
                        <locus target="#15v"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1070JesushealstheBlind">Jesus Heals the Blind</ref></desc>
                        <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ አብርሃ፡ አዕይንቲሆሙ፡ ለዕዉራን፡
                           እግዚእነ፡</hi></q></decoNote>
                     <decoNote xml:id="d17" type="miniature">
                        <locus target="#16v"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> heals the mute and possessed man. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ፈወሳ፡ ለጽሙም፡ ወዘከመ፡ ገሠጸ፡
                              ለጋኔን፤</hi></q></desc></decoNote>
                     <decoNote xml:id="d18" type="miniature">
                        <locus target="#17r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> confers power on the Apostles. <q xml:lang="gez"><hi rend="rubric">ዘከመ፡ ወሀቦሙ፡ እግዚእነ፡ ለሐዋርያት፡
                              ሥልጣነ፤</hi></q></desc></decoNote>
                     <decoNote xml:id="d19" type="miniature">
                        <locus target="#20r"/>
                        <desc>The Disciples gather grain during Sabbath.</desc></decoNote>
                     <decoNote xml:id="d20" type="miniature">
                        <locus target="#21v"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1021MiraclesOfJesus">The miracle of a
                              withered hand.</ref></desc></decoNote>
                     <decoNote xml:id="d21" type="miniature">
                        <locus target="#22r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> disputes with the
                        Pharisees.</desc></decoNote>
                     <decoNote xml:id="d22" type="miniature">
                        <locus target="#23r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> before Caiaphas.</desc></decoNote>
                     <decoNote xml:id="d23" type="miniature">
                        <locus target="#24r"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1023Mocking">Mocking of Jesus</ref></desc></decoNote>
                     <decoNote xml:id="d24" type="miniature">
                        <locus target="#25r"/>
                        <desc>Flagellation.</desc></decoNote>
                     <decoNote xml:id="d25" type="miniature">
                        <locus target="#26r"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> takes the <term key="cross" ana="#cross"/> on his
                           shoulders. <persName ref="https://betamasaheft.eu/PRS7928Pontius">Pontius Pilate</persName> washes his
                        hands.</desc></decoNote>
                     <decoNote xml:id="d26" type="miniature">
                        <locus target="#27r"/>
                        <desc>The Cyrenean helps <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName>.</desc></decoNote>
                     <decoNote xml:id="d27" type="miniature">
                        <locus target="#28r"/>
                        <desc>Longinus wounds <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> while He is on the
                           <term key="cross" ana="#cross"/>.</desc></decoNote>
                     <decoNote xml:id="d28" type="miniature">
                        <locus target="#28v"/>
                        <desc><persName ref="https://betamasaheft.eu/PRS13687JosephArim">Joseph of Arimathea</persName> asks <persName ref="https://betamasaheft.eu/PRS7928Pontius">Pontius Pilate</persName> for the <term key="deadjesus" ana="#deadjesus">corpse of
                              Jesus</term>.</desc></decoNote>
                     <decoNote xml:id="d29" type="miniature">
                        <locus target="#29r"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1007Deposition">Deposition from the Cross</ref> and <ref type="authFile" corresp="https://betamasaheft.eu/AT1010Entombment">Entombment of Jesus</ref>.</desc></decoNote>
                     <decoNote xml:id="d30" type="miniature">
                        <locus target="#30r"/>
                        <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1049Resurrection">Resurrection of Jesus</ref>.</desc></decoNote>
                     <decoNote xml:id="d31" type="miniature">
                        <locus target="#31r"/>
                        <desc>An <term key="angel" ana="#angel"/> announces the Resurrection to holy women.
                              <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName> appears to the
