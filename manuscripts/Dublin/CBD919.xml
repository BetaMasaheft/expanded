               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i1">
                     <title type="complete" ref="https://betamasaheft.eu/LIT1850Malkea">Malkǝʾa gubāʾe</title>
                     <msItem xml:id="ms_i1.1">
                        <locus from="1ra" to="7vb"/>
                        <title ref="https://betamasaheft.eu/LIT4551Salam">Malkǝʾa Lālibalā</title>
                        <explicit type="supplication">Several supplications for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName>.</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.2">
                        <locus from="8ra" to="8vb"/>
                        <title ref="https://betamasaheft.eu/LIT0219Malke">Malkǝʾa Yǝmrǝḥanna Krǝstos</title>
                     </msItem>
                     <msItem xml:id="ms_i1.3">
                        <locus from="9ra" to="21vb"/>
                        <title ref="https://betamasaheft.eu/LIT1201Bartos">Bārtos</title>
                        <explicit type="supplication">Several supplications for <persName ref="https://betamasaheft.eu/PRS15402TasfaM">Tasfā Mikāʾel</persName> occur throughout the text.</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.4">
                        <locus from="22ra" to="33ra"/>
                        <title ref="https://betamasaheft.eu/LIT2179Prayer">Prayer of Cyprian (General record)</title>
                        <explicit type="supplication">Several supplications for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> occur throughout the text. In some places, the name
                           of <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> has been partly erased, but is still
                           recognizable. There are two supplications on <locus target="#27rv #29ra"/> for <persName ref="https://betamasaheft.eu/PRS15403GabraM">Gabra Mikāʾel</persName>, whose name was probably added
                           later over erasures.</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.5">
                        <locus from="33rb" to="35rb"/>
                        <title ref="https://betamasaheft.eu/LIT6377HymnMary">Malkǝʾa Ḥannā</title>
                     </msItem>
                     <msItem xml:id="ms_i1.6">
                        <locus from="35va" to="37r"/>
                        <title ref="https://betamasaheft.eu/LIT2915RepCh196">Malkǝʾa Gabra Manfas Qǝddus</title>
                     </msItem>
                     <msItem xml:id="ms_i1.7">
                        <locus from="38ra" to="40rb"/>
                        <title ref="https://betamasaheft.eu/LIT1864Malkea">Malkǝʾa śǝʿl</title>
                        <explicit type="supplication">A supplication for a man, whose name has been
                           obliterated.</explicit>
                     </msItem>

                     <msItem xml:id="ms_i1.8">
                        <locus from="44vb" to="45vb"/>
                        <title ref="https://betamasaheft.eu/LIT0229Malke">Malkǝʾa Śǝllāse</title>

                     </msItem>
                     <msItem xml:id="ms_i1.9">
                        <locus from="52ra" to="53vb"/>
                        <title ref="https://betamasaheft.eu/LIT2851RepCh133">Malkǝʾa Kiros</title>
                        <explicit type="supplication">A supplication for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> at the end of the text.</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.10">
                        <locus from="54ra" to="55vb"/>
                        <locus from="56ra" to="56vb"/>
                        <locus from="57ra" to="57vb"/>
                        <title ref="https://betamasaheft.eu/LIT2881RepCh162">Malkǝʾ-hymn to Gabra Manfas Qǝddus</title>
                        <explicit type="supplication">A supplication for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName>.</explicit>
                     </msItem>
                     <msItem xml:id="ms_i1.11">
                        <locus from="58ra" to="58vb"/>
                        <title ref="https://betamasaheft.eu/LIT2896RepCh177">Malkǝʾa maṭlali</title>
                     </msItem>

                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="41ra" to="44va"/>
                     <title ref="https://betamasaheft.eu/LIT7858SeqayatihuG">Śǝqāyātihu la-Qǝddus Mār Giyorgis</title>
                     <incipit type="supplication">A supplication for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> at the beginning of the text.</incipit>
                     <explicit type="supplication">A supplication for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> at the end of the text.</explicit>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="46r" to="51v"/>
                     <title ref="https://betamasaheft.eu/LIT7859FSDuhadm">Ṣalota fǝtḥata śǝrāy wa-ʾagānǝnt wa-duḥadǝm</title>
                     <note>Unlike other texts, this prayer is written in one column and without
                        rubrication.</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="Codex">
                     <supportDesc>
                        <support>
                           <material key="parchment"/>
                        </support>
                        <extent>
                           <measure unit="leaf">58</measure>
                           <dimensions type="outer" unit="mm">
                              <height>115</height>
                              <width>105</width>
                           </dimensions><dimensions subtype="computed" unit="mm" type="outer"><height quantity="115" unit="mm"/><width quantity="105" unit="mm"/></dimensions>
                        </extent>
                        <foliation/>
                        <condition key="deficient">The boards and the cover are missing. The text is not fully
                           readable due to numerous stains (e.g., <locus target="#1r #14v #40v #58v"/> and the fading of the red ink. Some folia (e.g., <locus target="#57 #58 #59"/>) were damaged by rodents. The <locus target="#37"/> is smaller than others and was probably inserted
                           later.</condition>
                     </supportDesc>
                     <layoutDesc>
                        <layout columns="1 2" writtenLines="18"/><layout subtype="computed" type="catalogue" columns="1 2"><writtenLines quantity="18"/></layout>
                     </layoutDesc>

                  </objectDesc>

                  <additions>
                     <list>

                        <item xml:id="a1"><locus target="#21vb"/>
                           <desc type="MagicText">Magic prayer against various diseases including
                              stomach ache and bleeding, mentioning <term key="demon" ana="#demon">Bāryā</term>
                              and containing a supplication for <persName ref="https://betamasaheft.eu/PRS15402TasfaM">Tasfā Mikāʾel</persName>.</desc>
                           <q xml:lang="gez">በሰመ፡<gap reason="ellipsis" resp="ESh"/> አብ፡ እሳት፡ በአካሉ፡
                              ወልድ፡ እሳት፡ በአካሉ፡ መንፈስ፡ ቅዱስ፡ እሳት፡ በአካሉ፡ በዝንቱ፡ አስማት፡ ዘአድራዕከ፡ ግብር፡ ለዲያብሎስ፡
                              ከማሁ፡ አጽረዕ፡ ሕማመ፡ ባርያ፡  ዓይነት፡ ወውግዓት፡ ቁርፀት፡ <gap reason="ellipsis" resp="ESh"/></q>
                        </item>
                        <item xml:id="a2"><locus target="#44va"/>
                           <desc type="MagicText">Magic prayer against stomach ache, mentioning
                                 <term key="demon" ana="#demon">Dask</term>. The prayer is interrupted in the middle
                              of a sentence.</desc>
                           <q xml:lang="gez">ጸሎተ፡ <choice>
                                 <sic>ውግዳት፡</sic>
                                 <corr>ውግአት፡</corr>
                              </choice> በለምለም፡ ዘፈቃ፡ በደምደም፡ ዘፈቅ<gap reason="illegible"/>፡ በሚን፡ ዕፅ፡
                              አመ፡ <gap reason="ellipsis" resp="ESh"/></q>
                        </item>
                        <item xml:id="a3"><locus target="#57v"/>
                           <desc type="GuestText">A fragment of a prayer. Its text is mostly
                              illegible due to a parchment tear and ink fading.</desc>
                           <q xml:lang="gez">በሰመ፡<gap reason="ellipsis" resp="ESh"/> አናንያ፡ ወአዛርያ፡
                              ወ<choice><sic>ሚካኤል፡</sic><corr>ሚሳኤል፡</corr></choice> አምላከ፡ ስድራቅ፡ ወሚሳቅ፡ ወአብድናጎ፡ አምላኩ፡ ለቅዱስ፡ ጊዮርጊስ፡ ወለአቡነ፡ ገብረ፡ መንፈስ፡
                              ቅዱስ፡ ዘወሀበከ፡ እግዚአብሔር፡ <gap reason="ellipsis" resp="ESh"/></q>
                        </item>
                        <item xml:id="e1">
                           <locus target="#2r"/>
                           <desc type="StampExlibris">An Arabic stamp; its text is not readable due
                              to a poor quality of the images and its fading.</desc>
                        </item>
                        <item xml:id="e2">
                           <locus target="#51v"/>
                           <desc>Spaces left for a male name are left blanc.</desc>
                        </item>

                     </list>
                  </additions>
                  <bindingDesc>
                     <binding contemporary="true">
                        <decoNote xml:id="b1">The boards and the cover are missing.</decoNote>
                        <decoNote xml:id="b2" type="Sewing">Two pairs of sewing stations.</decoNote>
                        <decoNote xml:id="b3" type="SewingStations">4</decoNote>
                     </binding>
                  </bindingDesc>
               </physDesc>
               <history>
                  <origin>
                     <origDate notBefore="1600" notAfter="1699">17th century</origDate>
                  </origin>
                  <provenance>There are numerous supplications for <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName>, <persName ref="https://betamasaheft.eu/PRS15403GabraM">Gabra Mikāʾel</persName>, <persName ref="https://betamasaheft.eu/PRS15402TasfaM">Tasfā Mikāʾel</persName> and
                     probably some more men. While <persName ref="https://betamasaheft.eu/PRS15404TabdanaKr">Ṭabdana Krǝstos</persName> and <persName ref="https://betamasaheft.eu/PRS15402TasfaM">Tasfā Mikāʾel</persName> seem to be original supplicants, the name of
                        <persName ref="https://betamasaheft.eu/PRS15403GabraM">Gabra Mikāʾel</persName> was likely added later.</provenance>
               </history>
