               <msContents>
                  <summary/>

                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="2v"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT2866RepCh147">Malkǝʾa Giyorgis</title>
                     <incipit><q xml:lang="gez"><gap reason="lost"/>
                        <supplied reason="undefined">ዘያሜኒ፡</supplied> ኵሎ፡ ወዘያስተሴፉ፡ ጥዑመ፡ ዜና፡ <gap reason="omitted"/> ለኃሊብ፡ <choice>
                              <sic>ዕጐል፡</sic>
                              <corr>ዕጐልት፡</corr>
                           </choice> ሱታፉ፡ <sic>ሰምከ፡</sic>
                           <gap reason="illegible"/> በላዕሌየ፡ ያዕርፉ፡ አኮ፡ ለምድር፡ ዳዕሙ፡ ለዝላፉ።<gap reason="omitted"/></q></incipit>

                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="5r" to="26v"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT2883RepCh164">Malkǝʾa madḫāne ʿālam</title>
                     <note>The end of the hymn is missing.</note>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="27r" to="29r"/>

                     <title ref="https://betamasaheft.eu/LIT7854Sequtqut">Magic prayer for loosening the tongue with Asmat mentioning Šǝquṭquṭ</title>

                  </msItem>
               </msContents>
               <physDesc>
