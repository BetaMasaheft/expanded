               <msContents>
                  <summary/>
                  <msItem xml:id="ms_i1">
                     <locus from="2r" to="44r"/>
                     <title ref="https://betamasaheft.eu/LIT7297DossierM">Hagiographic Dossier of St Mercurius Philopater</title>
                     <msItem xml:id="ms_i1.1">
                        <locus from="2ra" to="37vb"/>
                        <title ref="https://betamasaheft.eu/LIT7292MartyrMa">The Martyrdom of Mercurius (recension a)</title>
                     </msItem>
                     <msItem xml:id="ms_i1.2">
                        <locus from="37vb" to="44r"/>
                        <title ref="https://betamasaheft.eu/LIT7297TammeraMerc">Miracles of Mercurius</title>
                        <msItem xml:id="ms_i1.2.1">
                           <locus from="37vb" to="38vb"/>
                           <title ref="https://betamasaheft.eu/LIT7303TammeraBishops">Miracle of Mercurius: Death of the Emperor Julian the
        Apostate (version b)</title>
                        </msItem>
                        <msItem xml:id="ms_i1.2.2">
                           <locus from="38vb" to="44r"/>
                           <title>The miracle of the Muslim Egyptian who got lost on the road to
                              Mecca</title>
                           <note>The miracle resembles <title ref="https://betamasaheft.eu/LIT6226MGBebaMuslim">Miracle of St George: A Muslim of Bǝbā gets lost in the
        desert on a pilgrimage to Mecca</title>.</note>
                           <explicit type="supplication">
                              <locus target="#44rb"/>
                              <note>A supplication for <persName ref="https://betamasaheft.eu/PRS15474WalattaMik">Walatta
                                    Mikāʾel</persName>.</note>
                           </explicit>
                        </msItem>
                     </msItem>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="45ra" to="48va7"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT2888RepCh169">Malkǝʾa Marqorewos</title>
                     <note>The beginning is missing.</note>
                     <explicit type="supplication">
                        <locus target="#48va"/>
                        <note>A supplication for <persName ref="https://betamasaheft.eu/PRS15475SahlaMikael">Śāhla
                              Mikāʾel</persName>.</note>
                     </explicit>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="Codex">
                     <supportDesc>
                        <support>
                           <material key="parchment"/>
                        </support>
                        <extent>
                           <measure unit="leaf" quantity="50">50</measure>
                           <height unit="mm">75</height>
                           <width unit="mm">56</width>
                        </extent>
                     </supportDesc>
                     <layoutDesc>
                        <layout columns="2">
                           <locus from="2r" to="49v"/></layout>
                        <layout columns="1">
                           <locus target="#1rv #50rv"/></layout>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <handNote xml:id="h1" script="Ethiopic">
                        <locus from="2r" to="44r"/>
                        <seg type="script" cert="medium">Eighteenth-century script.</seg>
                        <seg type="rubrication">Divine names, names of saints, incipits, elements of
                           punctuation marks, and some Ethiopic numbers.</seg>
                        <desc>Regular, neat, careful, square letters.</desc>
                     </handNote>
                     <handNote xml:id="h2" script="Ethiopic">
                        <locus from="45ra" to="48va7"/>
                        <seg type="script" cert="medium">Eighteenth-century script.</seg>
                        <desc>Quite regular.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="miniature">
                        <locus target="#44v"/>
                        <desc>A miniature of <persName ref="https://betamasaheft.eu/PRS7025Mercury">MercuriusMercury</persName>
                           <ref type="authFile" corresp="https://betamasaheft.eu/AT1012Equestrian">on a horse</ref>,
                           piercing a laying man with his spear. The <term key="animal" ana="#animal">horse</term>
                           is drawn very anatomically and has a highly detailed harness. <q xml:lang="gez">ቅዱስ፡ መርቆሬዎስ፡</q></desc>
                     </decoNote>
                  </decoDesc>
                  <additions>
                     <list>
                        <item xml:id="a1">
                           <locus from="1r" to="1v"/>
                           <desc type="GuestText">Several different fragments from <title ref="https://betamasaheft.eu/LIT7297DossierM">Hagiographic Dossier of St Mercurius Philopater</title>, partially repeating the main
                              content.</desc>
                        </item>

                        <item xml:id="a2">
                           <locus target="#19r"/>
                           <desc>A supplication note written in the upper margin by the main
                              hand.</desc>
                           <q xml:lang="gez">ተአምሪሁ፡ ለቅዱስ፡ መርቆሬዎስ፡ ስማዕት፡ ጸሎቱ፡ ወበረከቱ፡ የሃሉ፡ ምስለነ፡
                              አሜን።</q>
                        </item>
                        <item xml:id="a3">
                           <locus from="5v" to="6r"/>
                           <locus from="7v" to="8r"/>
                           <locus from="16v" to="17r"/>
                           <locus from="33v" to="34r"/>
                           <locus from="34v" to="35r"/>
                           <locus target="#18v #20r #35v"/>
                           <desc>Hardly readable notes in the upper and the lower margins, probably
                              containing <term key="Asmat" ana="#Asmat">ʾasmāt</term> and supplicantsʼ
                              names.</desc>
                        </item>
                        <item xml:id="a4">
                           <locus from="48va" to="49r"/>
                           <desc type="MagicText">A magic prayer.</desc>
                           <q xml:lang="gez"><unclear>በደርከኖ፡</unclear> ንጉሥ፡ በቆጵርያሮስ፡ ንጉሥ፡ በእክሮስስ፡
                              ንጉሥ፡ <unclear>በአዩር፡</unclear> ንጉሥ፡ ሰናስለ፡ እሳት፡ ስጉንጥረ፡ እሳት፡ <unclear/>
                              እሳት፡</q>
                        </item>
                        <item xml:id="e1">
                           <locus target="#1r"/>
                           <desc>Pen trial.</desc>
                        </item>

                        <item xml:id="e2">
                           <locus target="#19r"/>
                           <desc>The space for the name of a male supplicant has been left
                              blank.</desc>
                        </item>
                     </list>
                  </additions>
                  <bindingDesc>
                     <binding contemporary="true">
                        <decoNote xml:id="b1">Two wooden boards.</decoNote>
                        <decoNote xml:id="b2" type="Cover">Tooled leather cover.</decoNote>
                        <decoNote xml:id="b3" type="bindingMaterial">
                           <material key="wood"/>
                           <material key="leather"/>
                        </decoNote>
                     </binding>
                  </bindingDesc>
