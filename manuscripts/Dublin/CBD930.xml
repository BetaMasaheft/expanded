                  <handDesc>

                     <handNote xml:id="h1" script="Ethiopic">
                        <locus from="3r" to="37r"/>
                        <seg type="script">Early eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <seg type="rubrication">Divine names, incipits, punctuation marks, Ethiopic
                           numerals and the supplicants’ names.</seg>
                        <desc>Regular, neat, careful, small square letters; copied by the <persName role="scribe" ref="https://betamasaheft.eu/PRS15460GabraHeywat">Gabraḥǝywat</persName>.</desc></handNote>
                     <handNote xml:id="h2" script="Ethiopic">
                        <locus from="37v" to="104v"/>
                        <seg type="script">Eighteenth-century script.</seg>
                        <seg type="ink">Black, red.</seg>
                        <seg type="rubrication">Divine names, incipits, punctuation marks, Ethiopic
                           numerals and the supplicants’ names.</seg>
                        <desc>Regular, neat, careful, larger round letters with more space between
                           them; copied by the <persName role="scribe" ref="https://betamasaheft.eu/PRS15462WaldaGabr">Walda Gabrǝʾel</persName>. Despite clear
                           differences in style between <ref target="#h1"/> and <ref target="#h2"/>,
                           the transition is smooth and, therefore, precisely not
                           identifiable.</desc>
                     </handNote>
                  </handDesc>
                  <decoDesc>
                     <decoNote xml:id="d1" type="drawing">
                        <locus target="#1v"/>
                        <desc>A drawing of a warrior with a long spear, in pencil. Based on its
                           highly realistic anatomical features and the use of pencil, the drawing
                           was probably added later to the manuscript and was made not by the
                           same artist(s) who painted miniatures.</desc>
                     </decoNote>
                     <decoNote xml:id="d2" type="drawing">
                        <locus target="#2r"/>
                        <desc>An unfinished pencil drawing of several warriors with <term key="sword" ana="#sword">swords</term>, made by the same artist as <ref target="#d1"/>.</desc>
                     </decoNote>
                     <decoNote xml:id="d3" type="headpieceBand">
                        <locus target="#3r"/>
                        <desc>An elaborate black outline for a horizontal ornamental band (ḥarag)
                           over columns a–b, featuring interlaces, cross-shaped flowers, with three
                           lateral extensions and an eye in the middle of the band.</desc>
                     </decoNote>
                     <decoNote xml:id="d4" type="drawing">
                        <locus target="#69r"/>
                        <desc>A simple unfinished pencil drawing of a face.</desc>
                     </decoNote>
                     <decoNote xml:id="d5" type="drawing">
                        <locus target="#77v"/>
                        <desc>A sketch drawing of <ref target="#d20"/>, in pencil.</desc>
                     </decoNote>
                     <decoNote xml:id="d6" type="headpieceBand">
                        <locus target="#103r"/>
                        <desc>An outline for two horizontal ornamental bands (ḥarags), over each
                           column one, featuring interlaces, with four lateral extensions
                           each.</desc>
                     </decoNote>
                     <decoNote xml:id="d7" type="drawing">
                        <locus target="#105r"/>
                        <desc>A drawing of three <term key="animal" ana="#animal">lions</term>, one in ink and two
                           in pencil.</desc>
                     </decoNote>
                     <decoNote xml:id="d8" type="drawing">
                        <locus target="#105v"/>
                        <desc>An outline of three horizontal ornamental bands (ḥarags), featuring
                           interlaces, with shadows, along with an outline of an elaborate <term key="cross" ana="#cross">cross</term>; a few doodlings, all in pencil.</desc>
                     </decoNote>
                     <decoNote xml:id="d9" type="miniature">
                        <locus target="#12v"/>
                        <desc>Two miniatures belonging to the <term key="FirstGondarineStyle" ana="#FirstGondarineStyle"/> in a
                           double red frame. In the first one, <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName> on a
                              <term key="animal" ana="#animal">horse</term> with soldiers appears to Joshua. In
                           the second one, <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName> appears to a shepherd. 
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d10" type="miniature">
                        <locus target="#18v"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS15488Longinus">Longinus</persName> wounding
                              the crucified <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName>
                           in the presence of <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> and <persName ref="https://betamasaheft.eu/PRS5741Johnthe">St John the Baptist</persName>. A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d11" type="miniature">
                        <locus target="#27v"/>
                        <desc>A miniature in a double red frame depicting the miracle of
                           the jewel found in the <term key="animal" ana="#animal">fish</term>.
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d12" type="miniature">
                        <locus target="#31v"/>
                        <desc>Two miniatures in a single double red frame depicting the miracle of the
                           boat and the miracle of Qison at the door of the church of <persName ref="https://betamasaheft.eu/PRS7049Michael">Saint Michael</persName>, respectively.
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d13" type="miniature">
                        <locus target="#45v"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS4585Georgeo">St George of Lydda</persName> killing the <term key="dragon" ana="#dragon"/>. Traces of a <term key="protectiveCurtain" ana="#protectiveCurtain"/>.</desc>
                     </decoNote>
                     <decoNote xml:id="d14" type="miniature">
                        <locus target="#46v"/>
                        <desc>A miniature in a double red frame depicting <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>
                           with two <term key="angel" ana="#angel">angels</term>, <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName> and <persName ref="https://betamasaheft.eu/PRS4377Gabriel">Gabriel</persName> as well as <persName role="patron" ref="https://betamasaheft.eu/PRS15461ZawaldaMaryam">Zawalda Māryām</persName>
                           prostrating before Them. 
                        <q xml:lang="gez">ቅዱስ፡ ሚካኤል። ቅዱስ፡ ገብርኤል። ዘከመ፡ ተማኀጸኑ፡ መምህር፡ ዘወልደ፡ ማርያም።</q>
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d15" type="miniature">
                        <locus target="#52v"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS5720JohnChr">John Chrysostom</persName> before a group of people.</desc>
                     </decoNote>
                     <decoNote xml:id="d16" type="miniature">
                        <locus target="#55v"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName> spearing the <term key="demon" ana="#demon">devil</term> who was trying to throttle <persName ref="https://betamasaheft.eu/PRS14019Euphemia">Euphemia</persName>.
                        <q xml:lang="gez">ቅዱስ፡ ሚካኤል። አፎምያ፡ ሰይጣን።</q>
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d17" type="miniature">
                        <locus target="#63v"/>
                        <desc>A miniature in a double red frame depicting a rich man and his two poor neighbors.
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia. </desc>
                     </decoNote>
                     <decoNote xml:id="d18" type="miniature">
                        <locus target="#69v"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName> bringing souls to judgement before <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName>.
                           <q xml:lang="gez">እግዚእነ፡ ኢየሲስ። ቅዱስ፡ ሚካኤል።</q>
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d19" type="miniature">
                        <locus target="#73v"/>
                        <desc>A miniature in a double red frame depicting the small chest filled with money that was sent to the poor man by <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName>.
                        <q xml:lang="gez">እግዚእነ። ሰይጣን። ሣፅን፤ አሣ፤ ጉማራ።</q>
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia.</desc>
                     </decoNote>
                     <decoNote xml:id="d20" type="miniature">
                        <locus target="#77r"/>
                        <desc>A miniature in a double red frame depicting <persName ref="https://betamasaheft.eu/PRS5584Isaiah">Isaiah</persName> healing <persName ref="https://betamasaheft.eu/PRS5680Jeremiah">Jeremiah</persName> by pouring water on his head.
                        <q xml:lang="gez">ቅዱስ፡ ሚካኤል። ኢሳያስ። ሕዝያስ።</q>
                           A white cotton <term key="protectiveCurtain" ana="#protectiveCurtain"/> is
                           sewn to the top of the folia. </desc>
                     </decoNote>
                  </decoDesc>
                  <additions>
                     <list>
                        
                        <item xml:id="a1">
                           <locus target="#2r"/>
                           <desc type="PurchaseNote">Purchase note mentioning <persName ref="https://betamasaheft.eu/PRS15463AmataWald">ʾAmata Wald</persName> and
                                 <persName ref="https://betamasaheft.eu/PRS15464AbbaWaldaAr">Walda ʾAragāwi</persName>.</desc>
                           <q xml:id="am">ለአመተ፡ ወልደ፡ አረጋዊ፡ ፩ቀን፡ ለአባ፡ ወልደ፡ አረጋዊ፡ ፩ጨበር፡ ማላሻ፡ ፪ጨበር፡</q>
                        </item>
                        <item xml:id="a2">
                           <locus target="#73ra"/>
                           <desc>Sale note written in pencil. Its text is faded and hardly
                              legible.</desc>
                           <q xml:lang="am">በ፲፻፱፻፮ ዓመተ፡ ምሕረት፡ በዘ <gap reason="illegible"/> ፡ ማርቆስ፡
                              በ፲፪ ቀን፡ ፊታውራሪ፡ <gap reason="illegible"/> ፺ብር፡ ለ <gap reason="illegible"/> ልብሱ፡ አባቶችም፡ <sic>ትላቀ፡</sic> <gap reason="illegible"/>
                              መጋቢ፡ ወልደ፡ ገብርኤል። ጊዜ፡ <gap reason="illegible"/></q>
                        </item>
                        <item xml:id="e1">
                           <locus target="#3r"/>
                           <desc type="StampExlibris">A blue Ethiopian stamp with a cross in the
                              middle, which is illegible due to its fading.</desc>
                        </item>
                      
                        <item xml:id="e2">
                           <locus target="#104v"/>
                           <desc>Pen trial.</desc>
                        </item>
                     </list>
                  </additions>
                  <bindingDesc>
                     <binding contemporary="true">
                        <decoNote xml:id="b1">Two wooden boards.</decoNote>
                        <decoNote xml:id="b2" type="Cover">Reddish brown tooled leather cover with
                           bright pink <term key="inlay" ana="#inlay">textile inlays</term> with a geometrical
                           green-and-yellow pattern. The <term key="tooling" ana="#tooling">blind tooled
                              ornament</term> includes <term key="cross" ana="#cross">crosses</term>, <term key="doubleStraightLine" ana="#doubleStraightLine">double line fillets</term>, <term key="doubleCircle" ana="#doubleCircle">double circles</term>, <term key="interlace" ana="#interlace">interlaces</term>, and other ornamental elements.</decoNote>
                        <decoNote xml:id="b3" type="Sewing">Two pairs of sewing stations.</decoNote>
                        <decoNote xml:id="b4" type="SewingStations">4</decoNote>
                        <decoNote xml:id="b5" type="Endbands">Endbands are present, the tailband is
                           slightly damaged.</decoNote>
                        <decoNote xml:id="b6" type="bindingMaterial">
                           <material key="wood"/>
                           <material key="textile"/>
                           <material key="leather"/>
                        </decoNote>
                     </binding>
                  </bindingDesc>
               </physDesc>
