                        <msItem xml:id="ms_i1">
                            <locus from="3r" to="21rb"/>
                            <title ref="https://betamasaheft.eu/LIT1940Mashaf">Maṣḥafa krǝstǝnnā (General record)</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> መጽሐፈ፡ ክርስትና፡ ዘሕፃናት፡ ጸሎተ፡ አንብሮ፡ እድ፡ ላእለ፡ እሙ፡ እምድኅረ፡ ነጽሐ፡
                                ኅፃን፡ በ፵ ዕለት፡ ወይባዕ፡ ውስተ፡ ቤተ፡ ክርስቲያን፡ ወይብል፡ ካህን፡ ላዕለ፡ ጸሎተ፡ አኰቴት፡ ወጸሎተ፡ ዕጣን፡ ውዳሴ፡ ድግም፡</incipit>
                            <explicit type="supplication" xml:lang="am">ሲሆን፡ ከሥጋ፡ አባት፡ የመንፈስ፡ ቅዱስ፡ አባት፡ ይበልጣል፡ የመንፈስ፡ ቅዱስ፡ <sic>አባትክን፡</sic>
                                ከሥጋ፡ አባትህ፡ አብልጠህ፡ ውደድ፡ የመንፈስ፡ ቅዱስ፡ አባትም፡ የመንፈስ፡ ቅዱስ፡ ልጅህን፡ ከሥጋ፡ ልጅህ፡ አብልጠህ፡ ውደድ፡ አለዚያም፡ ከሥጋ፡ ልጅህ፡ አትለይ፤
                                እምአብ፡ ሥጋ፡ የዓቢ፡ አበ፡ መ<cb n="21rb"/>ንፈስ፡ እንዳለ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> 
                                መጽሐፍ። ይህነን፡ ሳይደርግ፡ የሰው፡ ልጅ፡ ክርስትና፡ አያንሻ።</explicit>
                            <textLang mainLang="gez"/>
                            <colophon xml:id="coloph1">
                                <locus target="#21rb"/>
                                The manuscript was written for <persName role="owner" ref="https://betamasaheft.eu/PRS15481WaldaTans">Walda Tanśāʾe</persName>
                                by the copier <persName role="scribe" ref="https://betamasaheft.eu/PRS15482WaldaGab">Walda Gabrǝʾel</persName> on 
                                <date when="1900-08-23" when-custom="1892-12-18" calendar="ethiopian">18 Naḥase 1892 A.M. (= 23 August 1900 A.D.)</date>.
                                <q xml:lang="gez">፲፰፻፺፪፡ ዓመተ፡ ምሕረት፡ ዘመነ፡ ዮሐንስ፡ በነሐሴ፡ ፲፰ ቀን፡ ተፈጸመ።</q>
                            </colophon>
                        </msItem> 
