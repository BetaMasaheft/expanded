                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <locus from="5ra" to="103rb"/>
                            <title ref="https://betamasaheft.eu/LIT1931Mashaf">Maṣḥafa gǝnzat (general record)</title>
                            <textLang mainLang="gez"/>
                            <msItem xml:id="ms_i1.1">
                                <locus from="5ra" to="14va"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Intro">Maṣḥafa gǝnzat (general record): Introduction</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ንጽሐፍ፡ በረድኤተ<supplied reason="undefined">፡</supplied> 
                                    እግዚአብሔር፡ መቅድመ<supplied reason="undefined">፡</supplied> ግንዘት፡ ዘአስተጋባእነ፡ እምሲኖዶስ፡ ወእምፍትሐ፡ ነገሥት፤ 
                                    ወእምዝንቱ፡ መጽሐፍ፡ በበሥርዐቱ፡ ወበበመትልው፡ ቀዳሚ<choice resp="PRS8999Strelcyn"><sic>፡</sic><corr>።</corr></choice>
                                    ኵሉ፡ ጊዜ፡ ፀዓተ፡ ነፍስ፡ ማኅለፍተ፡ ነፍስ፡ ዘቃለ፡ አትናቴዎስ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="14va" to="18vb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Passing">Maṣḥafa gǝnzat (general record): Prayer of Athanasius for
        the passing of the soul</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ነገር፡ ዘበእ<surplus>እ</surplus>ንተ፡ ሞት፡ ቃለ፡ አትናቴዎስ፡ ወጸሎት፡
                                    ዘበእንተ፡ ማኅለፍተ፡ ነፍስ። አንተ፡ ውእቱ፡ ባሕቲ<unclear>ት</unclear>ከ፡ ዘኢትመውት፡ ዘፈጠርኮ፡ ወገበርከ፡
                                    ለ<supplied reason="undefined" resp="PRS8999Strelcyn">እ</supplied>ጓለ፡ እመሕያው።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">
                                <locus from="18vb" to="24ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Jerusalem">Maṣḥafa gǝnzat (general record): The book that came from
        Jerusalem</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዛቲ፡ መጽሐፍ፡ ዘወጽአት፡ እምኢየሩሳሌም፡ ለመድኃኒተ፡ ሥጋ፡ ወነፍስ።
                                    በእንተ፡ ጻድቃን፡ ወጠቢባን፡ በእንተ፡ ጳጳሳት፡ ወሊቃነ፡ ጳጳሳት፡ በእንተ፡ ቀሳውስት፡ ወዲያቆናት፡ ወመዘምራን። ወበእንተ፡ ቅዱሳት፡ አንስት፡ ወበእንተ፡ ዘማውያን፡
                                        </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.4">
                                <locus from="24ra" to="25rb"/>
                                <title>Prayer of Severus for peace of the soul of the deceased</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎተ፡ ሰዊሮስ፡ እግዚእነ፡ ወአምላክነ፡ ወመድኃኒነ፡ ኢየሱስ፡ ክርስቶስ፡ በአፈ፡ 
                                    ሚካኤል፡ ወገብርኤል፡ ሱራፌል፡ <cb n="24rb"/> ወኪሩቤል፡ ኡራኤል፡ ወሩፋኤል፡ ሱሩያል፡ ወፋኑኤል። አፍነን፡ ወራጉኤል፡ ወሳቁኤል፡ ሊቃነ፡ 
                                    መላእክት፡ ፍቱሐ፡ ወንጹሐ፡ ረስዮ፡ ለዝንቱ፡ በድን። በአፈ፡ ፬ እንስሳ፡ ወበአፈ፡ ፳ወ፬ ካህናተ፡ ሰማይ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.5">
                                <locus from="26rb" to="27vb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Mary">Maṣḥafa gǝnzat (general record): Prayer of Our Lady Mary over
        all dead</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎተ፡ እግዝእትነ፡ ማርያም፡ ወላዲተ፡ አምላክ፡ ወላዲተ፡ መድኅን፡ ወሕይወት።
                                    ወላዲተ፡ ኢየሱስ፡ ክርስቶስ፡ ወላዲተ፡ አማኑኤል፡ ወላዲተ፡ የማኑ፡ ለአብ፡ ወላዲተ፡ ጽድቅ፡ ወላዲተ፡ መዓልት፡ ዘንተ፡ ኵሎ፡ ወዘይመስሎ፡ ወልድ፡ ቃለ፡ አብ፡ 
                                    ቀዳማዊ፡ ዘይትነበብ፡ ላዕለ፡ ኵሎሙ፡ ምውታን፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.6">
                                <locus from="27vb" to="41rb"/>
                                <title>Common order of the funerals</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ ዘይትነበብ፡ ላዕለ፡ ኵሎሙ፡ ሙታን፡ እምድኅረ፡ ግንዘት። ስብሐት፡ 
                                    ለእግዚአብሔር፡ ስፉሐ፡ ምሕረት፡ ወውዱሰ፡ አምላክ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.7">
                                <locus from="41rb" to="43ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Sepulchre">Prayers of the tomb and of the return to the earth</title>
                                <note>The first prayer of the tomb as attested in <ref type="mss" corresp="https://betamasaheft.eu/BNFet337">Paris, Bibliothèque nationale de France, BnF Éthiopien 337</ref> is missing.</note>
                                <incipit xml:lang="gez">ጸሎተ፡ መቃብር፡ በስሙ፡ ለዳዊት፡ ድኅነ፡ ዮዳፍ፡ አፍሎ፡ ጳ፡ ሜሎስ፡ ስምዖን፡ ጴጥሮስ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.8">
                                <locus from="43ra" to="46vb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Blessings">Maṣḥafa gǝnzat (general record): Eight Blessings of
        ʾabbā Sāmuʾel</title>
                                <incipit xml:lang="gez">ጸሎተ፡ ቡራኬ፡ ዘአባ፡ ሳሙኤል፡ ለዘአዕረፈ፡ ይምሕሮ፡ እግዚአብሔር፡ ይሣሃሎ፡ እግዚአብሔር፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.9">
                                <locus from="46vb" to="50ra"/>
                                <title ref="https://betamasaheft.eu/LIT1758Lefafa">Lǝfāfa ṣǝdq</title>
                                <note>Divided into four sections.</note>
                                <msItem xml:id="ms_i1.9.1">
                                    <locus from="46vb" to="47vb"/>
                                    <title>Section one</title>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዝንቱ፡ መጽሐፍ፡ መጽሐፈ፡ ሕይወት፡ ወመጽሐፈ፡ ድኅነት፡ ልፋፈ፡ ጽድቅ፡ ዘጸሐፋ፡
                                        አብ፡ በእዴሁ፡ ወወሀባ፡ አብ፡ ለእግዝእትነ፡ ማርያም፡ እምቅድመ፡ ይትወለድ፡ ክርስቶስ፡ እማርያም፡ ውስተ፡ ፀባብ፡ አንቀጽ።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.9.2">
                                    <locus from="47vb" to="48vb"/>
                                    <title>Section two</title>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ ዘፃዕረ፡ ሞት፡ ድቃስ፡ በትሮን፡ ምጕያዮን፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.9.3">
                                    <locus from="48vb" to="49rb"/>
                                    <title>Section three</title>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> እነግረክሙ፡ አኃውየ፡ ዘተአመንክሙ፡ በቃለ፡ ዛቲ፡ መጽሐፍ፡ ልፋፈ፡ ጽድቅ፡
                                        ዘወሀባ፡ አብ፡ ለእግዝእትነ፡ ቅድስት፡ ወድን<pb n="49ra"/>ግል፡ ማርያም፡ በደኃሪት፡ ዕለት፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.9.4">
                                    <locus from="49rb" to="50ra"/>
                                    <title>Section four - Prayers to find the way to heaven</title>
                                    <note>Followed by five prayers on the same person.</note>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> በእንተ፡ መንገደ፡ ሰማይ፡ ዕቀበኒ፡ ክርስቶስ፡ ከመ፡ ኢያዕቅፍዋ፡ ለነፍስየ፡ መላእክተ፡
                                        ጽልመት፡ ውስተ፡ ጸባብ፡ አንቀጽ፡ <unclear>መ</unclear>ሐረኒ፡ ክርስቶስ፡ ለገብርከ፡ <gap reason="illegible"/></incipit>
                                </msItem>
                            </msItem>
                            <msItem xml:id="ms_i1.10">
                                <locus from="50ra" to="58rb"/>
                                <title>Prayers said during incense burning</title>
                                <note>Some prayers are identical to those in 
                                    <ref type="mss" corresp="https://betamasaheft.eu/BNFet337">Paris, Bibliothèque nationale de France, BnF Éthiopien 337, fol. 53vb to 58rb</ref>.</note>
                                <incipit xml:lang="gez">ለእመ፡ ኮነ፡ ቀሲስ፡ ይቁሙ፡ ካህናት፡ ከቢቦሙ፡ ምውተ፡ ወይዕጥኑ፡ ዕጣነ፡ 
                                    ወይትቀ<supplied reason="undefined" resp="PRS8999Strelcyn">ነ</supplied>ዩ፡ በዜማ፡ ኃዘን፡ ተዘከሮ፡ እግዚኦ፡ ለዳዊት፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.11">
                                <locus from="58rb" to="62rb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Deacons">Maṣḥafa gǝnzat (general record): Readings and prayers over
        deceased deacons</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘዲያቆናት፡ ወትብል፡ እግዚእ፡ መሐረነ፡ ፫ ጊዜ፡ ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡ ዘ፶ተሣሃለኒ፡ በል፤</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.12">
                                <locus from="62rb" to="64vb"/>
                                <title ref="https://betamasaheft.eu/LIT1629Homily">Homily on Priests and Deacons who have Fallen Asleep</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ድርሳን፡ ዘደረሰ፡ አባ፡ ያዕቆብ፡ ዘሥሩግ፡ ዘእንተ፡ እለ፡ ኖሙ፡ ካህናት፡ ወዲያቆናት፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.13">
                                <locus from="64vb" to="66rb"/>
                                <title ref="https://betamasaheft.eu/LIT1644Homily">Homily on the Deceased</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ድርሳን፡ ዘደረሰ፡ ብፁዕ፡ ወቅዱስ፡ አባ፡ ሰላማ፡ ሊቀ፡ <pb n="65ra"/> ጳጳሳት፡ 
                                    ዘብሔረ፡ ኢትዮጵያ፡ ዘይትነበብ፡ ላዕለ፡ ሙታን፡ በሰላመ፡ እግዚአብሔር፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.14">
                                <locus from="66rb" to="67vb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Absolution">Maṣḥafa gǝnzat (general record): Absolution and
        prayers</title>
                                <incipit xml:lang="gez">አብስልዋጥስ፡ በዜማ፡ ግዕዝ፡ እግዚአብሔር፡ መፍቀሬ፡ ሰብእ፡ እግዚእነ፡ ኢ<cb n="va"/>የሱስ፡ ክርስቶስ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.15">
                                <locus from="67vb" to="71ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Monks">Maṣḥafa gǝnzat (general record): Readings and prayers over
        deceased monks</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘመነኮሳት፡ ዕደው፡ ወትብል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ አኰቴት፡ ወተዓርግ፡ ዕጣነ፡ ወበል፡ ዘንተ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.16">
                                <locus from="71ra" to="73ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Men">Maṣḥafa gǝnzat (general record): Readings and prayers over
        deceased adult and young men</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘአበው፡ <supplied reason="undefined" resp="PRS8999Strelcyn">ወ</supplied>ወራዙት፡
                                    ወትብል፡ ጸሎተ፡ አኰቴት፡ ወዘ፶ተሠሃለኒ።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.17">
                                <locus from="73ra" to="75ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Children">Maṣḥafa gǝnzat (general record): Readings and prayers
        over deceased children</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘሕፃናት፡ ወትበል፡ እግዚኦ፡ መሐረነ፡ ወፀሎተ፡ አኰቴት፡ ወዘ፶ተሠሃለኒ፡ ወትብል፡ በጊዜ፡ ቍርባን፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.18">
                                <locus from="75ra" to="76va"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Nuns">Maṣḥafa gǝnzat (general record): Readings and prayers over
        deceased nuns</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘአንስት፡ መነኮሳይያት፡ ወትብል፡ ጸሎተ፡ አኰቴት፡ ወታዕርግ፡ ዕጣነ፡ ወትብል።</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.19">
                                <locus from="76va" to="77va"/>
                                <title>Funeral ritual for women who died in childbirth</title>
                                <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/BAVet115">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 115, fol. 42r</ref>.</note>
                                <incipit xml:lang="gez">ግንዘት፡ ዘአንስት፡ እለ፡ ይወልዳ፡ ሶበ፡ ይመውታ፡ ይሕፅብዎን፡ ወይግንዝዎን፡ በካልዕ፡ ልብስ፡ ወትብል፡ ጸሎተ፡ አኰቴት፡ ወያዕርግ፡
                                    ዕጣነ፡ ወይበል፡ ጸሎተ፡ ኢሳይያስ፡ እስከ፡ ተፍጻሜቱ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.20">
                                <locus from="77va" to="81va"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Women">Maṣḥafa gǝnzat (general record): Readings and prayers over
        deceased adult women</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘዓበይት፡ አንስት፡ ወትብል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡ 
                                    ዘ፶፡ ወተዓርግ፡ ዕጣነ፡ ወትብል፡ ጸሎተ፡ ዕጣን፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.21">
                                <locus from="81va" to="83ra"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#YoungGirls">Maṣḥafa gǝnzat (general record): Readings and prayers
        over deceased young girls</title>
                                <incipit xml:lang="gez">ግንዘት፡ ዘአዋልድ፡ ንዑሳት፡ ወትብል፡ እግዚኦ፡ መሐረነ፡ <cb n="81vb"/> ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡
                                    ዘ፶<supplied reason="undefined" resp="PRS8999Strelcyn">፡</supplied> ወተዓርግ፡ ዕጣነ፡ ወትብል፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.22">
                                <locus from="83ra" to="92rb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#ReadingsOccasions">Maṣḥafa gǝnzat (general record): Readings for
        various occasions</title>
                                <msItem xml:id="ms_i1.22.1">
                                    <locus from="83ra" to="84va"/>
                                    <title ref="https://betamasaheft.eu/LIT1931Mashaf#Third">Maṣḥafa gǝnzat (general record): Reading for the 3rd day
        after burial</title>
                                    <incipit xml:lang="gez">ዘይትነበብ፡ በሣልስት፡ ዕለት፡ ወበል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡ ዘ፶</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.22.2">
                                    <locus from="84va" to="86rb"/>
                                    <title ref="https://betamasaheft.eu/LIT1931Mashaf#Seventh">Maṣḥafa gǝnzat (general record): Reading for the 7th day
        after burial</title>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዘይትነበብ፡ በ፯ ዕለት፡ ወትብል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡ 
                                        ዘ፶።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.22.3">
                                    <locus from="86rb" to="87vb"/>
                                    <title ref="https://betamasaheft.eu/LIT1931Mashaf#Twelfth">Maṣḥafa gǝnzat (general record): Reading for the 12th day
        after burial</title>
                                    <incipit xml:lang="gez">ዘ፲ወ፪ ዕለት፡ ዘይትነበብ፡ ወበል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ 
                                        አኰቴ<supplied reason="undefined" resp="PRS8999Strelcyn">ት</supplied>፡ ወመዝሙር፡ 
                                        ዘ፶<supplied reason="undefined" resp="PRS8999Strelcyn">፡</supplied></incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.22.4">
                                    <locus from="87vb" to="89vb"/>
                                    <title ref="https://betamasaheft.eu/LIT1931Mashaf#Thirtieth">Maṣḥafa gǝnzat (general record): Reading for the 30th
        day after burial</title>
                                    <incipit xml:lang="gez">በ፴ ዕለት፡ ዘይትነበብ፡ በል፡ እግዚኦ፡ መሐረነ፡ ወጸሎተ፡ አኰቴት፡ ወመዝሙር፡ 
                                        ዘ፶<supplied reason="undefined" resp="PRS8999Strelcyn">፡</supplied></incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.22.5">
                                    <locus from="89vb" to="92rb"/>
                                    <title>Reading on the 40th, 60th and 80th day; on the six-month anniversary; and on every anniversary after burial</title>
                                    <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/EMIP02017#ms_i1.35">Washington, D.C., Howard University School of Divinity, Tweed Codex 068: </ref>.</note>
                                    <incipit xml:lang="gez">ዘይትነበብ፡ በተፍጻሜተ፡ ፵ ዕለት፡ ወበ፷ ወበ፹ ወበመንፈቀ፡ ወበዓመት፡ ወበኵሉ፡ ተዝካረ፡ ሙታን። ኦእግዚኦ፡ መሐረነ፡ ወጸሎተ፡
                                        አኰቴት፡ ወመዝሙር፡ ዘ፶<supplied reason="undefined" resp="PRS8999Strelcyn">፡</supplied> ወተዓርግ፡ <pb n="90ra"/>
                                        ዕጣነ።</incipit>
                                </msItem>
                            </msItem>
                            <msItem xml:id="ms_i1.23">
                                <locus from="92rb" to="103rb"/>
                                <title ref="https://betamasaheft.eu/LIT1931Mashaf#Peace">Maṣḥafa gǝnzat (general record): Prayer pronounced after the
        Gospel for those who died in the peace of God (ጸሎት፡ ድኅረ፡ ወንጌል፡ ዘይትነበብ፡ ላዕለ፡ ኵሎሙ፡ ሙታን፡ በሰላመ፡
        እግዚአብሔር፡)</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ድልዋን፡ ዘይትነበብ፡ እምድኅረ፡ ወንጌል፡ ላዕለ፡ ኵሎሙ፡ ሙታን፡ በሰላመ፡ እግዚአብሔር፡
                                    አሜን።</incipit>
                            </msItem>
