                                <locus from="12r" to="31v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT1489Gadlas">Gadla Ṣādǝqān za-Bāraknāhā</title>
                                <note>This is probably the copy of the manuscript from the church of 
                                    <placeName ref="https://betamasaheft.eu/INS0919Baraknaha">Bāraknāhā</placeName>, which <persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> used
                                    in <bibl corresp="http://zotero.org/groups/358366/items/XELQF66E"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:ContiRossini1903Ricordi"/><title level="m">Ricordi di un soggiorno in Eritrea</title><author><forename>Carlo</forename><surname>Conti Rossini</surname></author><pubPlace>Asmara</pubPlace><publisher>Tipografia della Missione Svedese</publisher><date>1903</date><note type="tags"><note type="tag">bm:ContiRossini1903Ricordi</note></note><note type="tag">bm:ContiRossini1903Ricordi</note></bibl>.</note>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዝውእቱ፡ መጽሐፈ፡ ዜናሆሙ፡ ለአበው፡ ቅዱሳን፡ እለ፡ ወጽኡ፡ እምሮም፡ 
                                    በመዋዕሊሁ፡ ለዓልሜድ፡ ን<choice resp="PRS8999Strelcyn"><sic>ገሠ</sic><corr>ጉሥ</corr></choice>፡ ዘኢትዮጵያ፡
                                    ጸሎቶሙ፡ ወበረከቶሙ፡ የሀሉ፡ ምስለ፡ ፍቅሮሙ፡ <persName role="owner" ref="https://betamasaheft.eu/PRS15080TaklaKres">ተክለ፡ ክርስቶስ፡</persName>
                                    ለዓለመ፡ ዓለም፡ አሜን።</incipit>
                                <colophon xml:lang="gez" xml:id="coloph1">
                                    <locus from="31r"/>
                                    ተፈጸመ፡ መጽሐፈ፡ ገድሎሙ፡ ለጻድቃን፡ ዘበርክናሃ፡ ዘጸሐፋ፡ 
                                    <persName role="scribe" ref="https://betamasaheft.eu/PRS15079GabraSel">ገብረ፡ <sic>ሥላሥየ፡</sic></persName> በእንተ፡ ፍቁሮሙ፡ ለጻድቃን፡
                                    ወይደምሮ፡ ምስለ፡ <sic>አዜቤዊት፡</sic> መካን፡ ለዓለመ፡ ዓለም፡
                                    አሜን<choice resp="PRS8999Strelcyn"><sic>፡</sic><corr>።</corr></choice> ለዘጸሐፎ፡ ወለዘአንበቦ፡ ወለዘተርጐሞ፡
                                    <gap reason="ellipsis"/></colophon>
                                <textLang mainLang="gez"/>
