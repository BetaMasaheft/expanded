                    <physDesc>
                        <objectDesc form="Leporello">
                            <supportDesc>
                                <support>
                                    <material key="paper"/>
                                    <note>Oriental paper.</note>
                                </support>
                                <extent>
                                    <note>The leporello consists of <measure unit="leaf">8</measure> leaves created through folding.</note>
                                    <dimensions type="outer" unit="mm">
                                        <height>615</height>
                                        <width>90</width>
                                    </dimensions>
                                    <dimensions type="leaf" unit="mm">
                                        <height>90</height>
                                        <width>77</width>
                                    </dimensions>
                                </extent>
                                <condition key="other">The folds between leaves are torn in several
                                    places.</condition>
                            </supportDesc>
                        </objectDesc>
                        
                        <decoDesc>
                            <decoNote xml:id="d1" type="miniature">
                                <locus target="#1r"/>
                                <desc><ref type="authFile" corresp="https://betamasaheft.eu/AT1012Equestrian">Equestrian Saint</ref>:
                                    <persName ref="https://betamasaheft.eu/PRS4585Georgeo">St George of Lydda</persName>.</desc>
                                <q xml:lang="gez">ሥዕለ፡ ቅዱስ፡ ጊዮርጊስ፡ ሰማዕት።</q>
                            </decoNote>
                            
                            <decoNote xml:id="d2" type="miniature">
                                <locus target="#2r"/>
                                <desc>A representation of the <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChild">Virgin and Child</ref>.
                                    <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName> with the infant <persName ref="https://betamasaheft.eu/PRS5684JesusCh">Jesus Christ</persName>
                                    (identified by the caption
                                    <foreign xml:lang="gez">ምስለ፡ ፍቁር፡ ወልዳ፡</foreign>)
                                    is surrounded by the two <term key="angel" ana="#angel">archangels</term>
                                    <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName>  (identified by the caption
                                    <foreign xml:lang="gez">ሚካኤል፡</foreign>) and <persName ref="https://betamasaheft.eu/PRS4377Gabriel">Gabriel</persName>  (identified by the caption
                                    <foreign xml:lang="gez">ገብርኤል፡</foreign>).</desc>
                            </decoNote>
                            
                            <decoNote xml:id="d3" type="miniature">
                                <locus target="#3r"/>
                                <desc>A representation of the <ref type="authFile" corresp="https://betamasaheft.eu/AT1055ManofSorrows">Man of Sorrows</ref>:
                                the upper body of Christ crowned with the crown of thorns.</desc>
                                <q xml:lang="gez">ሥዕለ፡ ኵርዓተ፡ ርእሱ።</q>
                            </decoNote>
                            
                            <decoNote xml:id="d4" type="miniature">
                                <locus target="#4r"/>
                                <desc>A representation of the <ref type="authFile" corresp="https://betamasaheft.eu/AT1005Crucifixion">Crucifixion of Jesus</ref> with <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>
                                    to the left  (identified by the caption
                                    <foreign xml:lang="gez">ማርያም።</foreign>)
                                    and <persName ref="https://betamasaheft.eu/PRS5695John">John</persName> to the right  (identified by the caption
                                    <foreign xml:lang="gez">ዮሐንስ።</foreign>).</desc>
                                <q xml:lang="gez">ሥዕለ፡ ስቅለት።</q>
                            </decoNote>
                            
                            <decoNote xml:id="d5" type="miniature">
                                <locus target="#5r"/>
                                <desc>A representation of the <ref type="authFile" corresp="https://betamasaheft.eu/AT1049Resurrection">Resurrection of Jesus</ref>.</desc>
                                <q xml:lang="gez">ሥዕለ፡ ትንሣኤ፡</q>
                            </decoNote>
                            
                            <decoNote xml:id="d6" type="miniature">
                                <locus target="#6r"/>
                                <desc>A representation of the <ref type="authFile" corresp="https://betamasaheft.eu/AT1036MercyCovenant">Covenant of Mercy</ref>. 
                                </desc>
                                <q xml:lang="gez">ዘከመ፡ ወሀባ፡ ኪዳነ፡ ምሕረት፡ ለእሙ።</q>
                            </decoNote>
                            
                            <decoNote xml:id="d7" type="miniature">
                                <locus target="#6r"/>
                                <desc>A  <term key="donordepiction" ana="#donordepiction">donor depiction</term>: 
                                    <persName role="owner" ref="https://betamasaheft.eu/PRS15008HabtaM">Habta Mikāʾel</persName> places himself under the
                                    protection of <persName ref="https://betamasaheft.eu/PRS6819Mary">St Mary</persName>.</desc>
                                <q xml:lang="gez">ዘከመ፡ ተማኅፀነ፡ <persName ref="https://betamasaheft.eu/PRS15008HabtaM"><roleName type="title">አባ፡</roleName> ሀብተ፡ ሚካኤል።</persName></q>
                            </decoNote>
                            
                            <decoNote xml:id="d8" type="miniature">
                                <locus target="#7r"/>
                                <desc>A representation of a <ref type="authFile" corresp="https://betamasaheft.eu/AT1082Angel">Angel</ref>: <persName ref="https://betamasaheft.eu/PRS7049Michael">Michael</persName>.</desc>
                                <q xml:lang="gez">ሥዕለ፡ ቅዱስ፡ ሚካኤል፡ ሊቀ፡ መላእክት።</q>
                            </decoNote>
                            
                            <decoNote xml:id="d9" type="miniature">
                                <locus target="#8r"/>
                                <desc>A representation of an <ref type="authFile" corresp="https://betamasaheft.eu/AT1041HolyMen">Holy Men Potrait</ref> showing <persName ref="https://betamasaheft.eu/PRS4306GabraMa">Gabra Manfas Qǝddus</persName>  (identified by the caption
                                    <foreign xml:lang="gez">አቡነ፡ ገብረ፡ መንፈስ፡ ቅዱስ።</foreign>), 
                                    <persName ref="https://betamasaheft.eu/PRS9162TaklaHa">Takla Hāymānot</persName>  (identified by the caption
                                    <foreign xml:lang="gez">አቡነ፡ ተክለ፡ ሃይማኖት።</foreign>), <persName ref="https://betamasaheft.eu/PRS3934Ewostate">ʾEwosṭātewos</persName>  (identified by the caption
                                    <foreign xml:lang="gez">አቡነ፡
                                        ኤዎ<supplied reason="omitted">ስ</supplied>ጣቴዎስ።</foreign>),
                                    <persName ref="https://betamasaheft.eu/PRS4107Fileppos">Filǝṗṗos</persName>  (identified by the caption
                                    <foreign xml:lang="gez">አቡነ፡ ፊልጶስ። </foreign>) and 
                                    <persName ref="https://betamasaheft.eu/PRS10371Yohanne">Yoḥannǝs za-Dabra Bizan</persName>  (identified by the caption
                                    <foreign xml:lang="gez">አቡነ፡ ዮሐንስ፡</foreign>).</desc>
                            </decoNote>
                        </decoDesc>
                        
                        <additions>
                            <list>
                                <item xml:id="e1">
                                    <desc>The manuscript was probably produced for
                                        <persName role="owner" ref="https://betamasaheft.eu/PRS15008HabtaM">Habta Mikāʾel</persName> who is
                                        mentioned in <ref target="#d7"/>.</desc>
                                </item>
                                
                                <item xml:id="e2">
                                    <desc>The verso is empty.</desc>
                                </item>
                                
                                <item xml:id="e3">
                                    <locus target="#1v"/>
                                    <desc type="StampExlibris"/>
                                    <q xml:lang="la">Ex libris <persName ref="https://betamasaheft.eu/PRS3182ContiRo">CCR</persName></q>
                                </item>
                            </list>
                        </additions>
                        
                        <bindingDesc>
                            <binding xml:id="binding">
                                <decoNote xml:id="b1">Thick leather boards with a thread.</decoNote>
                                <decoNote xml:id="b2" type="bindingMaterial">
                                    <material key="leather"/>
                                </decoNote>
                                <decoNote xml:id="b3" type="SlipCase">Kept in a small bag made of rough
                                cloth, which in turn is kept in a very damaged leather case that
                                had been made for a smaller manuscript.</decoNote>
                            </binding>
                        </bindingDesc>
                    </physDesc>
                    
                    <history>
                        <origin>
                       <origDate notBefore="1700" notAfter="1799" evidence="lettering" cert="low"/>
                        </origin>
                        <provenance>The manuscript was either acquired by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>) or sent to him after his return to Europe.</provenance>
                        <acquisition>The manuscript passed into the possession of the library in <date when="1950">1950</date>,
                            following Conti Rossini’s death in <date when="1949">1949</date> 
                            (see <ref target="https://www.menestrel.fr/?-Roma-&amp;lang=fr#845">Menestrel</ref>).</acquisition>
                    </history>
                    
