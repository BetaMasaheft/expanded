                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <title type="complete" ref="https://betamasaheft.eu/LIT1824Mafteh">Maftǝḥe śǝrāy</title>
                            <textLang mainLang="gez"/>
                            
                            <msItem xml:id="ms_i1.1">
                                <incipit xml:lang="gez">
                                    በስመ፡ <gap reason="ellipsis"/> ጸሎተ፡ መፍትሕ፡ ሥራይ። <sic resp="DR">ተተቀደሃ፡</sic> እምሰማንያ፡
                                    ወ፩ መጻሕፍት፡ በስመ፡ እግዚአብሔር፡ አብ፡ ብርሃን፡ ወበእንተ፡
                                    ሥራዩ፡ ለሰይጣን፡ ወለሥራዩ፡ ለጋኔን፡ ወለሥራዩ፡ ለዓይነ፡ ሰብእ፡
                                    አስማተ፡ ኃይል፡ ዘስሙ፡ ሰፒራ፡ አላፒራ፡ <gap reason="ellipsis"/>
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.2">
                                <incipit xml:lang="gez">
                                    በስመ፡ <gap reason="ellipsis"/> በማርስ፡ በርቅያኖስ፡ በወርማቴዎስ፡ <gap reason="ellipsis"/> በከመ፡ ፈታሕኩ፡ ለጴጥሮስ፡ 
                                    እመዋቅሕተ፡ ብርት፡ ከማሁ፡ ፍታሕ፡ ሥራየ፡
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.3">
                                <incipit xml:lang="gez">
                                    በስመ፡ <gap reason="ellipsis"/> አልመክኑን፡ ስፋዝር፡ ፍታሕ፡ ቀንተው፡ ቀርነጸው፡ ፍታሕ፡ ሰንተው፡ ፍታሕ፡ 
                                    ራፎን፡ <gap reason="ellipsis"/> ይትፈታሕ፡ ኵሉ፡ ሥራያት፡
                                    ወኵሉ፡ መቋፅራት፡
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.4">
                                <incipit xml:lang="gez">
                                    በስመ፡ <gap reason="ellipsis"/> ዮፍታሔ፡ ዮፍታሔ፡ ዮፍታሔ፡ ፍታሕ፡ ወዘርዝር፡ ሠየር፡ ወመንዝር፡
                                    ኵሎ፡ ሥራያተ፡ <gap reason="ellipsis"/> ዝንቱ፡ አስማተ፡ ፍትሐተ፡ ሥራይ፡ ዮፍታሔ፡
                                    ድንጥናኤል፡ <gap reason="ellipsis"/> በኃይለ፡ ዝንቱ፡ አስማት፡ ተፈታሕ፡ ይቤሉከ፡ አብ፡
                                    ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ <surplus>ወመንፈስ፡ ቅዱስ፡</surplus> ለእመ፡ ገበርክሙ፡ ካህናት፡ ወዲያቆናት፡ እስላም፡ ወክርስቲያን፡ ወእመሂ፡ አገው፡
                                    ወበለው፡
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.5">
                                <title type="complete" ref="https://betamasaheft.eu/LIT7270PrayerUCh">Ṣalot baʾǝnta maftǝḥe śǝrāy</title>
                                <incipit xml:lang="gez">
                                    ሰላም፡ ለስዕርተ፡ ርዕስከ፡ ዘስሙር፡ አብቋሉ፡ <choice><corr>ሳዶር፡</corr><sic>ሳዳር፡</sic></choice>
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.6">
                                <incipit xml:lang="gez">
                                    ተሮሰሮስ፡ ሰክስ፡ <gap reason="ellipsis"/> ዝንቱ፡ ቃል፡ ዘተጽሐፈ፡ በደሙ፡ ለእግዚአብሔር፡ ኢየሱስ፡ ክርስቶስ፡ መግረሬ፡ ፀር፡ ውእቱ፡ ፍታሕ፡
                                    ሥራየ፡
                                    እምላዕለ፡ ዓመትከ፡
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.7">
                                <incipit xml:lang="gez">
                                    አሽትያ፡ ተላሹን፡ መቅደሹን፡ <gap reason="ellipsis"/> በዝንቱ፡ አስማት፡ ይትፈታሕ፡
                                    ኵሉ፡ ሥራይ፡ ዘይትሜሰሉ፡ በብዙኃ፡ ፌራ፡ ወንዳድ፡ ምች፡
                                </incipit>
                            </msItem>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <title type="complete" ref="https://betamasaheft.eu/LIT6609ProtectPrayer">Protective Prayer (general record)</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎተ፡ ቡዳ፡ ወነሀቢ፡ ወበዓለ፡ ግብር፡ ፊላላምያስ፡ ቁራብኤል፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7605PPIllnesses">ናሁ፡ አቅረብኩ፡ ለመልክዕከ፡ ስብሐተ፡</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ናሁ፡ አቅረብኩ፡ ለመልክዕከ፡ ስብሐተ፡ መጠነ፡ አሐቲ፡ ፵ እንዘ፡ ያተሉ፡ ፭ ተወኪፈከ፡ ዓስበ፡ ማሀሌትየ፡ 
                                ዘንተ <gap reason="ellipsis"/> ወበዝ፡ ቃልከ፡ አድኅነኒ፡ እምሕማመ፡ ባርያ፡ ወሌጌዎን፡ 
                                ወእምሕማመ፡ በዳ፡ <sic>ወፍላሻ</sic><supplied reason="omitted">፡</supplied> ወእምነ፡
                                ፈጸንት፡ ወፈንጻጻ፡ ወእምነ፡ ፌራ<supplied reason="omitted">፡</supplied>
                                ወንዳድ፡ ወትግሪዳ፡ ዛር፡ ወዛሪት፡ ወእምነ<supplied reason="omitted">፡</supplied>
                                ኵሉ፡ ሕማመ፡ ዓባል፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i4">
                            <title type="complete" ref="https://betamasaheft.eu/LIT6492PPFanuel">Protective prayer with stanza of the Malkǝʾa Fānuʾel</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መደንግጸ፡ አጋንንት፡ ወበእንተ፡ ባርያ፡
                                ሰላም፡ ለከ፡ <surplus>፡</surplus> ሰዳዴ፡ ሰይጣናት፡ ፋኑኤል፡<surplus>፡</surplus>
                                እምገፀ፡ ፈጣሪ፡ ልዑል፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i5">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7327InvocCross">Invocation of the Cross</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                    ጸሎት፡ በእንተ፡ መግ<add place="below">ረ</add>ሬ፡ ፀር፡ ወጸላኢ፡ ሠናያት፡ መስቀል፡
                                መግረሬ፡ ፀር። መስቀል፡ መዋዔ፡ ፀር፡<supplied reason="omitted">፡</supplied>
                                መስቀል<supplied reason="omitted">፡</supplied> ጸላኤ፡ ፀር፡<supplied reason="omitted">፡</supplied>
                                <gap reason="ellipsis"/> ወከማሁ፡ ኦእግዚእየ፡ ኢየሱስ፡ ክርስቶስ፡ ዕቀበኒ፡ ወኀፅረኒ፡ በኃይለ፡ መስቀል፡ ወአድህነኒ፡ ሊተ፡ 
                                ለገብርከ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i6">
                            <title type="complete" ref="https://betamasaheft.eu/LIT4625Prayer">Ṣalot baʾǝnta ḥǝmāma wǝgāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ሰላም፡ ለገቦከ፡ ኵናተ፡ ለንጊኖስ፡ ዘወግዓ፡ ወለከርሥከ፡ ሰላም፡ <gap reason="ellipsis"/> በዝ፡ ቃለ፡
                                መለኮትከ፡ ዕቀበኒ፡ እምኵሉ፡ አጋንንት፡ አእዋጋንንት፡  ጸዋጋን፡ ወሰብእ፡ መሰርያን፡ ወባርያ፡ ጸሊማን፡ 
                                ወመናፍስተ፡ ደዌ፡ ርኩሳን፡
                            </incipit>
                        </msItem>
                        
