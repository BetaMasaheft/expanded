                    <msContents><summary/>
                        <msItem xml:id="ms_i1">
                            <locus from="2r" to="14v"/>
                            <title ref="https://betamasaheft.eu/LIT6063Ananya">Hagiographic Dossier of St ʾAnānyā</title>
                            <note>Without a distinct section of malkǝʾ in the end, but with a salām-hymn after some of the miracles.</note>
                            <msItem xml:id="ms_i1.1">
                                <locus from="2r" to="12r"/>
                                <title ref="https://betamasaheft.eu/LIT1419GadlaA">Gadla ʾAnānyā</title>
                                <note>Some names of people upon whom the scribe of the original wished to invoke the blessing of the saint are 
                                    preserved in this copy, for example: ʾAbuna <persName ref="https://betamasaheft.eu/PRS15045GabraSem">Gabra Sǝmʿu Krǝstos</persName> (<locus target="#2v"/>) and
                                    ʾAbuna <persName ref="https://betamasaheft.eu/PRS15044GabraHey">Gabra Ḥǝywat</persName> (<locus target="#5r"/>).</note>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ንጽሕፍ፡ ዜና፡ ገድሉ፡ ለአቡ<unclear>ነ</unclear>፡ ክቡር፡ ሰማዕት፡ ጻድቅ፡
                                    አናንያ፡ ኅሩይ፡ ወመስተጋድል፡ በስመ፡ እግዚአብሔር፡ አብ፡ ዋሕድ፡ ወበስመ፡ እግዚአብሔር፡ ወልደ፡ ዋሕድ፡ ወበስመ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ጰራቅሊጦስ፡
                                    ዋሕድ፡ ህላዌ፡ ትሥልስቱ፡ ዘኢይትበዓድ። <gap reason="ellipsis"/><pb n="2v"/><gap reason="ellipsis"/> ንንግርክሙ፡ ዜና፡ ገድሉ፡ 
                                    ወትሩፋቲሁ፡ ለጻድቅ፡ ወሰማዕት፡ አቡነ፡ አናንያ። በምድረ፡ ሰራዌ፡ ዘስማ፡ መራጕዝ፡ በሀገረ፡ ሃይማኖት፡ ወምግባር፡ ወሰብአ፡ ዚአሃ፡ ኄራን፡ እሙንቱ።
                                    <gap reason="ellipsis"/><pb n="3r"/><gap reason="ellipsis"/> ወቦአ፡ ሶቤሁ፡ 
                                    ውስ<choice resp="CH"><sic>ቱ</sic><corr>ተ</corr></choice>፡ ቤቱ፡ ለአቡነ፡ ጳውሎስ፡ መምሕረ፡ ጸራቢ፡ ሰገደ፡ ወቆመ፡ ቅድሜሁ።
                                </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="12r" to="14v"/>
                                <title ref="https://betamasaheft.eu/LIT5061TaammeraA">Taʾammǝra ʾAnānya</title>
                                <note>Six miracles, followed by salām-hymns</note>
                                <msItem xml:id="ms_i1.2.1">
                                    <locus target="#12r"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaammeraA#Incipit">Taʾammǝra ʾAnānya: Incipit</title>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ንጽሕፍ፡ ዜና፡ ተአምሪሁ፡ ወዕበየ፡ ትሩፋቲሁ፡ ለዝንቱ፡ ጻድቅ፡ አቡነ፡ አናንያ፡ ዘውገ፡
                                        ፋሲለደስ፡ ሰማዕት፡ ዘገብረ፡ እምድኅረ፡ ሞቱ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.2.2">
                                    <locus target="#12r"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaammeraA#SupplicationTM">Taʾammǝra ʾAnānya: Supplication</title>
                                    <incipit xml:lang="gez">ጸሎቱ፡ ትኵኖ፡ ወበረከተ፡ አምላኩ፡ ወትንብልንሃ፡ ለእግዝእትነ፡ ማርያም፡ ጸሎታ፡ ወበረከታ፡ የሃሉ።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.2.3">
                                    <locus from="12r" to="12v"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaammeraA#FirstMiracle">Taʾammǝra ʾAnānya: Miracle and Hymn 1</title>
                                    <msItem xml:id="ms_i1.2.3.1">
                                        <locus from="12r" to="12v"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Miracle1"><seg corresp="LIT5061TaameraA#Miracle1">No item: LIT5061TaameraA, could not check for Miracle1</seg></title>
                                        <incipit xml:lang="gez">ቀዳሚ፡ ተአምር፡ ዘገብረ፡ አቡነ፡ አናንያ፡ ዘኤላ፡ ገዳማተ፡ ወአድባራተ፡ ወምኔታተ፡ ወከመ፡ አቡሁ፡ ዘከፈለ፡ ባሕረ፡ ግርምተ፡
                                            ወበከመ፡ ጊዮርጊስ፡ ዘኮነ፡ ሰማዕተ፡ ወከመ፡ ኤልያስ፡ ዘዓቀበ፡ ደመናተ፡ ወከመ፡ ጳውሎስ፡ ዘአንኃ፡ ስብከተ፡ ወከመ፡ ጴጥሮስ፡ ዘትወፈየ፡ መራኁተ፡ ወተሰቅለ፡
                                            ቍልቍሊተ። ወበ፩፡ እመዋዕል፡ መጽኡ፡ ብዙኃን፡ ድውያን፡ ወሕሙማን፡</incipit>
                                        <explicit xml:lang="gez">ወይብሉ፡ ዘይፈውሱ፡ ድውያነ፡ በዘፈረ፡ ልብሱ፡ ኢርኢነ፡ ወኢሰማዕነ፡ ዘእንበለ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘፈውሰ፡ 
                                            በዘፈረ፡ ልብሱ፡ ወዘእንበለ፡ አርዳኢሁ፡ ወሐዋርያቲሁ፡ ውእቱኒ፡ ኢያሕፀፀ፡ እምኔሆሙ፡ <pb n="12v"/> በገቢረ፡ ተአምራት፡ ወመንክራት፡ ጸሎቱ።
                                                </explicit>
                                    </msItem>
                                    <msItem xml:id="ms_i1.2.3.2">
                                        <locus target="#12v"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Arke1"><seg corresp="LIT5061TaameraA#Arke1">No item: LIT5061TaameraA, could not check for Arke1</seg></title>
                                        <incipit xml:lang="gez">ሰላም፡ ለልብከ፡ ፈዋሴ፡ ሕማም፡ ወደዌ፡ ወእምነ፡ ኵሉ፡ ምንሳዌ፡</incipit>
                                        <explicit xml:lang="gez">ወእምነ፡ እሳት፡ ነነዌ፡ በስብሐተ፡ ነቢይ፡ ዮናስ፡ አልቦቱ፡ ሕሳዌ።</explicit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="ms_i1.2.4">
                                    <locus from="12v" to="13r"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaameraA#SecondMiracle"><seg corresp="LIT5061TaameraA#SecondMiracle">No item: LIT5061TaameraA, could not check for SecondMiracle</seg></title>
                                    <msItem xml:id="ms_i1.2.4.1">
                                        <locus from="12v" to="13r"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Miracle2"><seg corresp="LIT5061TaameraA#Miracle2">No item: LIT5061TaameraA, could not check for Miracle2</seg></title>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ ለብፁዕ፡ ወለቅዱስ፡ ትሩፈ፡ ምግባር፡ አቡነ፡ ጻድቅ፡ ወሰማዕት፡ አቡነ፡ አናንያ። እምብዕለ፡ ዓለም፡ ለመንግሥተ፡
                                            ሰማያት፡ ዘኃረያ፡ ጸሎቱ። ወበ፩፡ እመዋዕል፡ መጽኡ፡ መነኮሳት፡ ተማኪሮሙ፡ ምስለ፡ ሰብአ፡ ሰራዌ፡ ወኮነ፡ በሀገሮሙ፡ አባረ፡ እክል፡ ወጽምዓ፡ ማይ፡ በእንተ፡ 
                                            ኃጢአ፡ ዝናም፡ ወበልዓ፡ አን<choice resp="PRS8999Strelcyn"><sic>ቦ</sic><corr>በ</corr></choice>ጣ፡ ፍሬ፡ 
                                            ምድሮሙ፡</incipit>
                                        <explicit xml:lang="gez">ወኮኑ፡ ይፈውሱ፡ ኵሎ፡ ድውያነ፡ እስከ፡ ዛቲ፡ ዕለት፡ እስመ፡ ንጹሕ፡ ወክቡር፡ እዕፅምቲሆሙ፡ ለጻድቃን፡ አበው፡ ጸሎቶ።
                                                </explicit>
                                    </msItem>
                                    <msItem xml:id="ms_i1.2.4.2">
                                        <locus target="#13r"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Arke2"><seg corresp="LIT5061TaameraA#Arke2">No item: LIT5061TaameraA, could not check for Arke2</seg></title>
                                        <incipit xml:lang="gez">ሰላም፡ አዕፅምቲክሙ፡ ዘትይፌውሱ፡ ድውያነ፡</incipit>
                                        <explicit xml:lang="gez">ወንጽሕናክሙ፡ ያንጽሕ፡ ሥጋነ።</explicit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="ms_i1.2.5">
                                    <locus from="13r" to="13v"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaameraA#ThirdMiracle"><seg corresp="LIT5061TaameraA#ThirdMiracle">No item: LIT5061TaameraA, could not check for ThirdMiracle</seg></title>
                                    <msItem xml:id="ms_i1.2.5.1">
                                        <locus from="13r" to="13v"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Miracle3"><seg corresp="LIT5061TaameraA#Miracle3">No item: LIT5061TaameraA, could not check for Miracle3</seg></title>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ ለአቡነ፡ አናንያ፡ <gap reason="ellipsis"/> ወነበሩ፡ ፪ አኃው፡ ፩ ወሬዛ፡ ወ፩ መነኮስ። ወንብረቶሙ፡ 
                                            ለ፪ሆሙ። አኃቲ፡ ገራኅት፡ ወተከፍለት፡ በዕፃ፡ ወበአኃቲ፡ ዕለት፡ <pb n="13v"/> መጽአ፡ አንበጣ። ወውእቱኒ፡ ወሬዛ፡ ሐፀበ፡ በማይ፡ እምልብሰ፡ መግንዙ፡
                                            ለአቡነ፡ አናንያ፡ ወነዝኃ፡ ማየ፡ ጸሎት፡ ለይእቲ፡ ገራህት፡ ዘተከፍለት፡ በዕፃ፡ እንዘ፡ ክድንት፡ ይእቲ፡ ኵለንታሃ፡ በአን<sic>ቦ</sic>ጣ፡ ወኢጥዕመ፡ አንቦጣ፡
                                            እምፍሬ፡ እክል።</incipit>
                                        <explicit xml:lang="gez">ወእለ፡ ርእዩ፡ ሰብእ፡ አንከሩ፡ ወተ<add place="above"><unclear>ጻ</unclear></add>ሙ፡ እምዕበየ፡
                                            ተአምራቲሁ፡ ለንጹሕ፡ ወቅዱስ፡ ኅሩይ፡ መስተጋድ፡ ጸ<supplied reason="omitted" resp="CH">ሎቱ።</supplied></explicit>
                                    </msItem>
                                    <msItem xml:id="ms_i1.2.5.2">
                                        <locus target="#13v"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Arke3"><seg corresp="LIT5061TaameraA#Arke3">No item: LIT5061TaameraA, could not check for Arke3</seg></title>
                                        <incipit xml:lang="gez"><supplied reason="omitted" resp="CH">ሰላም፡ ለ</supplied>አዘሰርከ፡ አፈ፡ አንቦጣ፡ በላዒ፡</incipit>
                                        <explicit xml:lang="gez">ወገፋዒ፡ አናንያ፡ ካህን፡ ቢጸ፡ ሱራፌል፡ ሠዋዒ፡ በጸሎትከ፡ አባ፡ አድኅነኒ፡ እምዕደ፡ ጽኑዕ፡ መዋዒ፡ ወኢይገድፈኒ፡ ብዕሲ፡ 
                                            ገፋዒ። ።</explicit>
                                    </msItem>
                                </msItem>
                                <msItem xml:id="ms_i1.2.6">
                                    <locus from="13v" to="14r"/>
                                    <title ref="https://betamasaheft.eu/LIT5061TaameraA#FourthMiracle"><seg corresp="LIT5061TaameraA#FourthMiracle">No item: LIT5061TaameraA, could not check for FourthMiracle</seg></title>
                                    <msItem xml:id="ms_i1.2.6.1">
                                        <locus from="13v" to="14r"/>
                                        <title ref="https://betamasaheft.eu/LIT5061TaameraA#Miracle4"><seg corresp="LIT5061TaameraA#Miracle4">No item: LIT5061TaameraA, could not check for Miracle4</seg></title>
                                        <incipit xml:lang="gez">ተአምሪሁ፡ ለአቡነ፡ አናንያ፡ <gap reason="ellipsis"/> ወበ፩ እመዋዕል፡ መጽአ፡ ፩ ብእሲ፡ እምሀገረ፡ ተንቤን፡ ዘደወየ፡
