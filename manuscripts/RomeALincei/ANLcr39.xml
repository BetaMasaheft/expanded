                    <msContents>
                        <summary/>           
                        <msItem xml:id="ms_i1">
                            <title ref="https://betamasaheft.eu/LIT6609ProtectPrayer">Prayer for protection</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ዕቀበኒ፡ ነግሀ፡ ወሰርከ፡ መዓልተ፡ ወሌሊተ፡</incipit>
                            <textLang mainLang="gez"/>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title ref="https://betamasaheft.eu/LIT7772PPSealSalo">... ba-za-bottu ʾasaromu Salomon la-ʾagānǝnt ba-māʾkala ḫǝlqat</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ተማኅፀንኩ፡ 
                                አነ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ገብርከ፡ <gap reason="lost"/>
                                እምነ፡ ነሀብት፡ በላዕያነ፡ ሥጋ፡ ሰብእ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወሰታያነ፡ 
                                ደ<supplied reason="omitted" resp="PRS8999Strelcyn">መ፡</supplied> ሰብእ፡ እኩያን፡ ወእምዓቃብያነ፡ ሥራይ፡ በዘቦቱ፡ ለሰሮሙ፡
                                <persName ref="https://betamasaheft.eu/PRS8925Solomon">ሰሎሞን፡</persName> ለአጋንንት፡ በማዕከለ፡ ኅልቀተ፡ ዓጻብኡ፡ ዘፀጋሙ፡ ቀሐሸን፡ ያጠሸን፡</incipit>
                            <explicit xml:lang="gez">አሰልጠኒ፡ በላዕለ፡ ደስክ፡ ወጉዳሌ፡ 
                                ወባር<supplied reason="omitted" resp="PRS8999Strelcyn">ያ</supplied>፡ ወነሀብት፡ ወኵሎሙ፡ መናፍስተ፡ ደዌ፡
                                ርኩሳን<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> አድኅነኒ፡ 
                                ለገብረ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> እግዚአብሔር፡ <gap reason="lost"/></explicit>
                            <textLang mainLang="gez"/>  
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title ref="https://betamasaheft.eu/LIT5888AsmatPrayer">Prayer against the evil aspirations of the blacksmiths and against demons</title>
                            <note>The end of the prayer is written on the verso of the second strip.</note>
                            <incipit xml:lang="gez">ቅዱስ፡ ቅዱስ፡ ቅዱስ፡ ሥሉስ፡ ስሉስጥስዩጥ፡ ምዩጥ፡ <gap reason="ellipsis"/> 
                                ከማሁ፡ አርስእ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ምክሮሙ፡ ለነሀብት<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ወለአጋንንት፡ ለባርያ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ለደስክ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ወለጕደሌ፡ <surplus resp="PRS8999Strelcyn">ለደስክ፡ ለጕ፡</surplus> 
                                ለዶቢ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወለዶቢት፡
                                ለማሪ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ወለማሪት<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied>
                                ወለኵሎሙ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> 
                                እለ፡ የሐውሩ፡ በኅቡዕ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ወበክሱት፡
                                ሸአራዴን<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ሸሩርሸአድሩዴአ፡ <gap reason="ellipsis"/>
                                <pb n="1v"/><gap reason="ellipsis"/> በዝንቱ፡ ስም፡ እስሮሙ፡ ለአጋንንት፡ አድኅነኒ፡ ለገብርከ፡ <gap reason="lost"/></incipit>
                            <textLang mainLang="gez"/>  
                        </msItem>
