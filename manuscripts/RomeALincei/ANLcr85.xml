                    <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">       
                            <locus from="1r" to="31r"/>
                            <title>Various genealogies</title>
                            <note>Probably an Amharic adaptation of one or more Gǝʿǝz manuscripts containing historical and genealogical texts.</note>
                            <textLang mainLang="am"/>
                            <msItem xml:id="ms_i1.1">  
                                <locus from="1r" to="4v"/>
                                <title>The biblical genealogy since Adam</title>
                            </msItem>
                            <msItem xml:id="ms_i1.2">      
                                <locus from="1r" to="4v"/>
                                <title>The genealogy of the Virgin</title>
                            </msItem>
                            <msItem xml:id="ms_i1.3">  
                                <locus from="1r" to="4v"/>
                                <title>The history of the Orthodox Church</title>
                            </msItem>
                            <msItem xml:id="ms_i1.4">       
                                <locus from="4v"/>
                                <title>The genealogy of Muhammad</title>
                            </msItem>
                            <msItem xml:id="ms_i1.5">    
                                <locus from="5v" to="10r"/>
                                <title>The history of Salomon, the Queen of the South, and Mǝnilǝk I’s reign</title>
                            </msItem>
                            <msItem xml:id="ms_i1.6">      
                                <locus from="10r" to="10v"/>
                                <title>List of the kings of Aksum</title>
                                <note>According to <ref type="work" corresp="https://betamasaheft.eu/LIT3854KingList">King list B</ref>.</note>
                            </msItem>
                            <msItem xml:id="ms_i1.7"> 
                                <locus from="11v" to="13r"/>
                                <title>The history of the Nine Saints, the Zāgʷe-dynasty and the restauration of the Solomonid dynasty</title>
                            </msItem>
                            <msItem xml:id="ms_i1.8">   
                                <locus from="17v" to="22v"/>
                                <title>The history of the Grāññ-wars</title>
                            </msItem>
                            <msItem xml:id="ms_i1.9">       
                                <locus from="22v" to="27r"/>
                                <title>The history of the Gāllā</title>
                            </msItem>
                            <msItem xml:id="ms_i1.10">
                                <locus from="5v" to="10r"/>
                                <title>The history of the Ethiopian kings until Susǝnyos (1607–1632)</title>
                            </msItem>
                            <msItem xml:id="ms_i1.11">       
                                <locus from="28v" to="31r"/>
                                <title>Incomplete list of the Patriarchs of Alexandria from St Mark to Mark V</title>
                                <note>Up to <persName ref="https://betamasaheft.eu/PRS11114MarkV">Mark V (1602–1617)</persName>.</note>
                            </msItem>
                            <msItem xml:id="ms_i1.12">       
                                <locus from="28v" to="31r"/>
                                <title>Presentation on the royal title ‘ʾaṣe’ and the court titles</title>
                            </msItem>
                        </msItem>
                    </msContents>
