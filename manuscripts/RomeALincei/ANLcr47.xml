                        <msIdentifier/>
                        <msContents><summary/>
                            <msItem xml:id="p2_i1">
                                <locus from="93ra" to="118vb"/>
                                <title ref="https://betamasaheft.eu/LIT1824Mafteh">Collection of prayers for loosening of charms (Maftǝḥe śǝrāy)</title>
                                <msItem xml:id="p2_i1.1">
                                    <locus from="93ra"/>
                                    <title ref="https://betamasaheft.eu/LIT7270PrayerUCh">Ṣalot baʾǝnta maftǝḥe śǝrāy</title>
                                    <note>Unlike the text attested in <ref type="mss" corresp="https://betamasaheft.eu/BAVet203">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 203</ref>, this text does not contain an Arabic name 
                                        for the Holy Spirit at the beginning.</note>
                                    <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መርእስክ፡ 
                                        ዘ<cb n="93rb"/>ስሙ<add place="below">ር</add>፡ አብቋሉ፡ ሳዶር፡</incipit>
                                    <textLang mainLang="gez"/>
                                </msItem>
                                <msItem xml:id="p2_i1.2">
                                    <locus from="98vb"/>
                                    <title ref="https://betamasaheft.eu/LIT7799PrayerDeath">Prayer for the hour of death</title>
