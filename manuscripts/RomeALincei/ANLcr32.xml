                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <title type="complete" ref="https://betamasaheft.eu/LIT6845PPSatolay">Protective prayer against šatolāy, with ʾasmāt</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ <sic>ማዕሰሬ፡</sic> ለሰይጣን፡ በቃለ፡ እግዚአብሔር፡ 
                                ወበእ<supplied reason="omitted">ን</supplied>ተ፡ ሼቶላይ፡ ወሼቶ<supplied reason="omitted">ላ</supplied>ዊት፡ ዘትቀትል፡
                                <sic resp="DR">ሕፀናተ፡</sic> አምሐልኩከ፡ ወአውገዝኩከ፡ ወሐተምኩከ፡  ወለጕምኩከ፡
                                ወአስርኩከ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7601PPSalomon">Protective prayer for the excommunication of šetolāy and šetolāwit by the names of the
          five nails of the cross</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ሰሎሞን፡ ሰሎሞን፡ ሰሎሞን፡ ሎፍሐም፡ ሎፍሐም፡ ሎፍሐም፡ ንምሎስ፡ ንምሎስ፡ ንምሎስ፡
                                <gap reason="ellipsis"/> በዝንቱ፡ አስማቲከ፡ በ፭ቱ፡ ቅንዋተ፡ መስቀሉ፡ ለእግዚእነ፡ ለአምላክነ፡ ወመድኃኒነ፡ ኢየሱስ፡ 
                                ክርስቶስ፡ አምሐልኩከ፡ 
                                ወአውገዝኩከ፡ ወሐተምኩከ፡ በማኅተ<supplied reason="omitted">መ</supplied>፡ አብ፡ ወወልድ፡ ወመንፈስ፡
                                ቅዱስ፡ ፩ አምላክ፡ አንተ፡ ሼቶላይ፡ ወሼቶላዊት፡ ጋኔን፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7602PPAqter">Protective
          prayer against various illnesses and demons</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስሙ፡ ለእግዚአብሔር፡ አብ፡ <gap reason="ellipsis"/> አቅቴር፡ አቅድቴር፡ <gap reason="ellipsis"/> ይጥፍዑ፡ በውእቱ፡ ስምከ፡ ኵሎሙ፡ መናፍስተ፡ ደዌ፡ ርኩሳን፡ ባርያ፡ ጸሊማን፡ ባርያ፡ ቀይሐን፡ ደሥክ፡ ወጉዳሌ፡ 
                                ወሌጌዎን፡ መጋኛ፡ 
                                <sic>ወጉሹመት፡</sic> ወሞፈንት፡ አይነት፡ ወውግአት፡ ቁርፀት፡ ወጽፍአት፡ ምች፡ ወተለውሻ፡ ፌራ፡ ወንዳድ፡ 
                                ልብጥ፡ ወነቀጥቃጥ፡ ዛር፡ ወዛሪት፡ ማሪ፡ 
                                ወማሪት፡ ወመዊት፡ ሼቶላይ፡ ወሼቶ<supplied reason="omitted">ላ</supplied>ዊት፡
                                ቅርጥማት፡ እድ፡ ወእግር፡ ሐቄ፡ ወዘባን፡ ወኵሉ፡ አባለ፡ ሥጋሀ፡ ቡዳ፡ ወነሃቢ፡ ወበአለግብር፡ ወጠበብት፡
                                ወነ<supplied reason="omitted">ገ</supplied>ርጋር፡ ሸነፈር፡ ድድቅ፡ ወጋኔነ፡ ቀትር፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i4">
                            <title type="complete" ref="https://betamasaheft.eu/LIT6609ProtectPrayer">Protective Prayer (general record)</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ትግርትያ፡ ወባርያ፡ ወጁማን፡ ቤልባብ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i5">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7231AynatBarya">Prayer
          against ʿaynat, the evil eye of Bāryā, and for stopping vaginal haemorrhage</title>
                            <textLang mainLang="gez"/>
                            <note>The identification of this text with <ref type="work" corresp="https://betamasaheft.eu/LIT7231AynatBarya">Prayer
          against ʿaynat, the evil eye of Bāryā, and for stopping vaginal haemorrhage</ref>
                                is approximate due to the brevity of the excerpts provided.</note>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ አርግኤ፡ ደም፡ ድማሊስ፡ አፍሊስ፡ አፍሊስ፡  አፍሊስ፡ <gap reason="ellipsis"/> ከማሁ፡ አርግዕ፡ ደመ፡ ትክቶሃ፡ ለዓመትከ፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i6">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በእንተ፡ ዓ<add place="below">ር</add>ግኤ፡ ደም፡ በእንተ፡ ፈሪሆተ፡ ስምከ፡ እግዚኦ፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i7">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ አርግኤ፡ ደም፡ ሺን፡ ሺን፡ ሺን፡ ሻን፡ ሻን፡ ሻን፡ ሻን፡ ሻን፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i8">
                            <title type="complete" ref="https://betamasaheft.eu/LIT1763Legend">Ṣalot za-qǝddus Susǝnyos baʾǝnta ʾasassǝlo dawe</title>
                            <note>According to the catalogue, this manuscript contains the
                                abbreviated version of this work.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንት ቅዱስ፡ ሱስንዮስ፡ በስመ፡ ፈጣሪ፡ ነባቤ፡ መለኮት፡ ሕያው፡ እግዚአብሔር፡
                                በእንተ፡ አሰስሎ፡ ደዌ፡ 
                                እምሕፃናት፡ እለ፡ ይጠብው፡ ጥበ፡ እሞሙ፡ እምኵሉ፡ ደዌያት፡ ወይበቍዕ፡ አዲ፡ ለብእሲት፡ ፅንስት፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i9">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5690MagicPrayer">Ṣalot baʾǝnta ḥǝmāma ʿaynat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ አይነተ፡ ባርያ፡ ወአይነ፡ ወርቅ፡ ሕማመ፡
                                ነደራ፡ <gap reason="ellipsis"/> ወእንዘ፡ የሐውር፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ አርዳኢሁ፡ ምስሌሁ፡ ወርእዩ፡ መልክዓ፡ ገጻ፡ 
                                ለአሮጊት እንዘ፡ ትገብር፡ 
                                ላቲ፡ መፍርህት፡ ወመደንግፅት፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i10">
                            <title type="complete" ref="https://betamasaheft.eu/LIT2765RepCh49">Malkǝʾ-hymn (Salām) to Phanuel</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ሰላም፡ ለከ፡ ሰዳዴ፡ አጋንንት፡ ፋኑኤል፡ ለእግዚአብሔር፡ እም<supplied reason="omitted">ጽ</supplied>ርሑ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i11">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ አርግኤ፡ ደም፡ ሊስ፡ አፍሊስ፡ ኩልዮስ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i12">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5199MagicPrayer">Ṣalot baʾǝnta ʾargǝʿǝ dam</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ አርግኤ፡ ደም፡ ሰንተርም፡ ሰንተርም፡ ሰንተርም፡ ሰንከርም፡  ሰንከርም፡  ሰንከርም፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i13">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7603PPErmeyas">Ṣalota
          ʾErmǝyās za-tanāgaro la-Muse ba-Dabra Sinā</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎተ፡ ኤርምያስ፡ ዘተናገሮ፡ ለሙሴ፡ በደብረ፡ ሲና፡ በአምደ፡ ደመና፡ በአብጀር፡ ቆዕ፡ እምሱራፌል፡ ቆዕ፡
                                እምኪሩቤል፡ <gap reason="ellipsis"/> በከመ፡ ከተርኮ፡ ለሰማይ፡ ከማሁ፡ ክትር፡ ደመ፡ ትክቶሃ፡ ለዓመትከ፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i14">
                            <title type="complete" ref="https://betamasaheft.eu/LIT4624Prayer">Ṣalot baʾǝnta ḥǝmāma wǝgāt</title>
                            <note>The identification of this text with <ref type="work" corresp="https://betamasaheft.eu/LIT4624Prayer">Ṣalot baʾǝnta ḥǝmāma wǝgāt</ref>
                                is approximate due to the brevity of the excerpts provided.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ ሕማመ፡ ውግአት፡ ምድያስ፡ ምድያስ፡ ምድያስ፡ ምድምያስ፡ ምድምያስ፡ ምድምያስ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i15">
                            <title type="complete" ref="https://betamasaheft.eu/LIT6609ProtectPrayer">Protective Prayer (general record)</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ጸሎት፡ በእንተ፡ ሕማመ፡ ቡዳ፡ ወባርያ፡ ኢዮኤል፡ ኢዮኤል፡ ኢዮኤል፡ ገብርኤል፡ መልአክ፡ ነበልባለ፡ እሳት፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i16">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7604PPMattNine">Protective prayer: Matthew 9:20–25</title>
                            <textLang mainLang="gez"/>
                        </msItem>
                        
                    </msContents>
                    
