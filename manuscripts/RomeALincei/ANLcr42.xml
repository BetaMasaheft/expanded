                            <msItem xml:id="ms_i1.8">
                                <locus from="40v" to="76r"/>
                                <title ref="https://betamasaheft.eu/LIT2252salota">Ṣalota ʿǝṭān</title>
                                <msItem xml:id="ms_i1.8.1">
                                    <locus from="40v"/>
                                    <title ref="https://betamasaheft.eu/LIT7817Etan">Zǝ ʿǝṭān yǝʿrǝg baʾǝnta sǝma ʾAb</title>
                                    <incipit xml:lang="gez">ዝ፡ ዕጣን፡ ይዕርግ፡ በእንተ፡ ስመ፡ አብ፡ በእንተ፡ ስመ፡ ወልድ፡ በእንተ፡ ስመ፡ መንፈስ፡ ቅዱስ። ዝ፡ ዕጣን፡ ይዕርግ፡ በእንተ፡ ስመ፡ 
                                        ሚካኤል፡ ወገብርኤል፡ ኡራኤል፡ ወፋኑኤል፡ ራጉኤል፡ ወሳቁኤል፡ ወኵሎሙ፡ ነገደ፡ መላእክት።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.2">
                                    <locus from="42r"/>
                                    <title ref="https://betamasaheft.eu/LIT2252salota#Tawakkafetan">Prayer of offering incense</title>
                                    <incipit xml:lang="gez">እግዚአብሔር፡ አብ፡ እግዚአብሔር፡ ወልድ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ተወከፍ፡ ለነ፡ ዘንተ፡ ዕጣነ፡ ንጹሐ፡ ወዘንተ፡ ማኅቶተ፡
                                        ወዘንተ፡ ጸሎተ፡ ወዘንተ፡ ስእለተ፡ ፫ ጊዜ፡ በል። እግዝእትነ፡ ማርያም፡ አዕርጊ፡ ጸሎተ<pb n="42v"/>ነ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.3">
                                    <locus from="51r"/>
                                    <title ref="https://betamasaheft.eu/LIT2252salota#Nesebhaka">Ṣalota ʿǝṭān: Intercessory prayer (Nǝsebbǝḥākka ʾǝgziʾo la-ʾaḫāze kʷǝllu ʿālam…)</title>
                                    <incipit xml:lang="gez">ጸሎተ፡ ዕጣን፡ ንሴብሐከ፡ <pb n="51v"/> እግዚኦ፡ ለአኃዜ፡ ኵሉ፡ ዓለም፡ አቡሁ፡ ለእግዚእነ፡ ወመድኃኒነ፡ ኢየሱስ፡ ክርስቶስ፡
                                        </incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.4">
                                    <locus from="58v"/>
                                    <title ref="https://betamasaheft.eu/LIT2252salota#Thanksaakkweto">Ṣalota ʿǝṭān: Prayer of thanksgiving (ʾĀʾakkʷǝto la-ʾǝgziʾa ṣǝdq wa-ʾāleʿǝl sǝmo la-neguśa ʿālam…)</title>
                                    <incipit xml:lang="gez">ጸሎተ፡ ዕጣን፡ አአኵቶ፡ ወእሴብሖ፡ ወአሌዕሎ፡ ለእግዚአብሔር፡ ጻድቅ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.5">
                                    <locus from="59r"/>
                                    <title ref="https://betamasaheft.eu/LIT7818Zatawakkafka">Prayer for incense</title>
                                    <note>The same as in <ref type="mss" corresp="https://betamasaheft.eu/BAVet181#ms_i2.11">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 181: Zatawakkafka maśwāʿta ʾAbrǝhām ʾabuna (in ms_i2.11)</ref>.</note>
                                    <incipit xml:lang="gez">ጸሎተ፡ ዕጣን፡ እግዚአብሔር፡ አምላክነ፡ ዘተወከፍከ፡ ምሥዋዕተ፡ አብርሃም፡ አቡነ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.6">
                                    <locus from="59v"/>
                                    <title ref="https://betamasaheft.eu/LIT2252salota#Nesel">Ṣalota ʿǝṭān: Supplication for offering the incense (Nǝsǝʾǝl wa-nāstabaqqʷǝʾ ḫiruta śannāyātika ʾǝgziʾo…)</title>
                                    <incipit xml:lang="gez">ጸሎተ፡ ዕጣን፡ ንስእል፡ ወናስተበቍዕ፡ ኂሩተ፡ ሠናያቲከ፡ እግዚኦ፡ አምላክነ፡ አኃዜ፡ ኵሉ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.7">
                                    <locus from="63v"/>
                                    <title>Prayer for incense</title>
                                    <incipit xml:lang="gez">ዘእሁድ፡ በቀዳሚት፡ ሰዓተ፡ ሌሊት፡ መፍትው፡ እንከ፡ ከመ፡ ናዕርፍ፡ ሰንበታተ፡ ወናምጽእ፡ ቃለ፡ ቅዱሳት፡ ከመ፡ ንግበር፡ ፈቃዶ።
                                            </incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.8">
                                    <locus from="69r"/>
                                    <title>Imposition of hands at the ninth hour</title>
                                    <incipit xml:lang="gez">አንብሮ፡ እድ፡ ዘ፱ ሰዓት፡ አኃውየ፡ ኵሉ፡ ጊዜ፡ እግዚአብሔር፡ የሃሉ፡ ምስሌክሙ፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.9">
                                    <locus from="69v"/>
                                    <title>Prayer for incense at midnight</title>
                                    <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/BAVet74#ms_i1.37.3">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 74: </ref>.</note>
                                    <incipit xml:lang="gez">ዘመ<add place="below">ን</add>ፈቀ፡ ሌሊት፡ <gap reason="ellipsis"/> ዘዲበ፡ ኢዮር፡ መንበሩ፡ 
                                        በአርያም፡ ፍጹም፡ ማኅደሩ።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.10">
                                    <locus from="70v"/>
                                    <title>Imposition of hands in the evening</title>
                                    <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/BAVet74#ms_i1.37.4">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 74: </ref>.</note>
                                    <incipit xml:lang="gez">አንብሮ፡ እድ፡ ዘሠርክ። መንጦላዕቱ፡ ዘእሳት፡ ወቅድመ፡ ገጹ፡ ብርሃናት።</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.11">
                                    <locus target="#71r"/>
                                    <title>Prayer at the ninth hour of the night</title>
                                    <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/BAVet74#ms_i1.37.5">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 74: </ref>.</note>
                                    <incipit xml:lang="gez">ዘ፱ሰዓተ፡ ሌሊት። ዘዲበ፡ ኢዩር፡ መንበሩ፡ በል። እግዚአብሔር፡ መሓሪ፡ ወመስተሣህል፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.12">
                                    <locus from="71r"/>
                                    <title>Imposition of hands</title>
                                    <note>Similar to <ref type="mss" corresp="https://betamasaheft.eu/BAVet74#ms_i1.37.6">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 74: </ref>.</note>
                                    <incipit xml:lang="gez">አንብሮ፡ እድ፡ እግዚአብሔር፡ ዘረወ፡ <surplus>ወ</surplus>ማኅደረ፡ ሰቃልያን፡ ወአስተጋብአ፡ ማኅበረ፡ መሃይምናን፡</incipit>
                                </msItem>
                                <msItem xml:id="ms_i1.8.13">
                                    <locus from="71v"/>
                                    <title>For the ninth hour of the night</title>
                                    <note>According to <bibl corresp="http://zotero.org/groups/358366/items/N6HPGQK3"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Strelcyn1976Catalogue"/><title level="m">Catalogue des manuscrits éthiopiens de l’Accademia Nazionale dei Lincei: Fonds Conti Rossini et Fonds Caetani 209, 375, 376, 377, 378</title><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><author><forename>Stefan</forename><surname>Strelcyn</surname></author><pubPlace>Roma</pubPlace><publisher>Accademia Nazionale dei Lincei</publisher><date>1976</date><series><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><biblScope unit="volume">9</biblScope></series><biblScope unit="volume">9</biblScope><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note><citedRange unit="item">42</citedRange><citedRange unit="page">127</citedRange></bibl>, this passage is for ‘the ninth hour of the morning’, but not for 
                                        the night.</note>
                                    <incipit xml:lang="gez">ዘ፱ሰዓተ፡ ሌሊት። <supplied reason="omitted" resp="PRS8999Strelcyn">ንስሓ፡</supplied> ዘዲበ፡ ኢዮር፡ መንበሩ፡ በል። 
                                        እግዚ<pb n="72r"/>አብሔር፡ አምላክነ፡ ኄር፡ ነጽር፡ እለ፡ ውስተ፡ ሀለዉ፡ ወተሣሃሎሙ፡ በከመ፡ ዕበየ፡ ሣህልከ፡</incipit>
                                </msItem>
                                <colophon xml:id="coloph1" xml:lang="gez">
                                    <locus target="#76r"/>
                                    <note>According to <bibl corresp="http://zotero.org/groups/358366/items/N6HPGQK3"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Strelcyn1976Catalogue"/><title level="m">Catalogue des manuscrits éthiopiens de l’Accademia Nazionale dei Lincei: Fonds Conti Rossini et Fonds Caetani 209, 375, 376, 377, 378</title><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><author><forename>Stefan</forename><surname>Strelcyn</surname></author><pubPlace>Roma</pubPlace><publisher>Accademia Nazionale dei Lincei</publisher><date>1976</date><series><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><biblScope unit="volume">9</biblScope></series><biblScope unit="volume">9</biblScope><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note><citedRange unit="page">127–128</citedRange></bibl>, the date is to be corrected to 
                                        <foreign xml:lang="gez">በ፲፱፻ወ፬ ዓመተ፡ ምሕረት፡</foreign> 
                                        (<date when-custom="1904" calendar="ethiopian" notBefore="1911" notAfter="1912">1904 AM = 1911/1912 AD</date>).
                                    </note>
                                    ወጸሐፊሁ፡ ኃጥእ፡ ወድኩም፡ ወአባሲ፡ 
                                    <persName role="scribe" ref="https://betamasaheft.eu/PRS15259WaldaGiy">ወልደ፡ ጊዮርጊስ።</persName> ። ። ዝንቱ፡ መጽሐፍ፡ ተጽሕፈ፡ 
                                    በ፲፱ወ፻<surplus resp="PRS8999Strelcyn">፲</surplus>ወ፬ ዓመተ፡ ምሕረት። ምስለ፡ አጽሐፊሃ፡ <pb n="77r"/> 
                                    <persName role="patron" ref="https://betamasaheft.eu/PRS15257WalattaIy">ወለተ፡ ኢየሱስ።</persName> ለዓለመ። ዓለም። አሜን። ለይኩን። ለይኩን። ።
                                </colophon>
                            </msItem>
                        </msItem>
