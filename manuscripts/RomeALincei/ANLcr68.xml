                                <condition rend="deficient">The manuscript is in a very poor condition. A large number of leaves are detached and 
                                    crudely sewn to the others. Many have been damaged by rodents. (e.g. <locus from="62" to="84"/>).</condition>
                            </supportDesc>
                            <layoutDesc><layout columns="2" writtenLines="14"/><layout subtype="computed" type="catalogue" columns="2"><writtenLines quantity="14"/></layout></layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Beautiful handwriting of the copier Zawalda Māryām (cf. <locus target="#92v"/>).</desc>
                                <seg type="script">Eighteenth century script.</seg>
                                <seg type="ink">Black, red.</seg>
                                <date notBefore="1700" notAfter="1799"/>
                                <persName role="scribe" ref="https://betamasaheft.eu/PRS15480ZawaldaM">Zawalda Māryām</persName>
                            </handNote>                  
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1">
                                <desc>Engraving of a cross and a few letters on the front board.</desc>
                            </decoNote>
                            <decoNote xml:id="d2">
                                <desc>A few incisions on the back board.</desc>
                            </decoNote>
                        </decoDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus from="26va" to="27vb"/><locus target="#27r"/>
                                    <desc>Prayer, which was written on an empty page (<locus target="#26v"/>) and on the upper margin of the
                                        following page (<locus target="#27r"/>). Judged from the incipit, it likely comes from 
                                        <ref type="work" corresp="https://betamasaheft.eu/LIT1917Mashaf">Maṣḥafa ʾaślǝṭi</ref> as it is attested in <ref type="mss" corresp="https://betamasaheft.eu/MALZ024">Eastern Tǝgrāy Zone, ʿĀddi Lāq̲mā Qǝddǝst Māryām, MALZ-024</ref>.</desc>
                                    <q xml:lang="gez">ኵሎ፡ ዘኢያፈቅሮ፡ ለእግዚእነ፡ ወመድኃኒነ፡ 
                                        <choice resp="PRS8999Strelcyn"><sic>አያ</sic><corr>ኢየ</corr></choice>ሱስ፡ ክርስቶስ፡ ዘኢየአምር፡ ልደቶ፡ 
                                        እማርያም<supplied resp="PRS8999Strelcyn" reason="omitted">፡</supplied></q>
                                </item>
                                <item xml:id="a2">
                                    <locus from="91vb" to="92v"/>
                                    <desc>A prayer on the last line of <locus target="#91vb"/> and on <locus target="#92"/>, possibly with a lacuna
                                        between <locus target="#91vb"/> and <locus target="#92"/>.</desc>
                                </item>
                                <item xml:id="a3">
                                    <desc>Note on the inner side of the front board stating the provenance of the manuscript from a church in ‘Arbambà’ 
                                        in <placeName ref="https://betamasaheft.eu/LOC5597Sawa">Šawā</placeName>, possibly corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName>.</desc>
                                    <q xml:lang="it">Chiesa di Arbambà</q>
                                </item>
                                <item xml:id="e1">
                                    <desc type="StampExlibris">Ex Libris of <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName>.</desc>
                                </item>
                            </list>
                        </additions>
                        <bindingDesc>
                            <binding>
                                <decoNote xml:id="b1">Wooden boards; the back cover is broken and repaired with a string.</decoNote>
                            </binding>
                        </bindingDesc>
                    </physDesc>
                    <history>
                        <origin>
                            <origDate notBefore="1700" notAfter="1799" evidence="lettering">Eighteenth century.</origDate>
                        </origin>
                        <provenance>The manuscript was either acquired by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>) or sent to him after his return to Europe.</provenance>
                        <acquisition>The manuscript passed into the possession of the library in <date when="1950">1950</date>,
                            following Conti Rossini’s death in <date when="1949">1949</date> 
                            (see <ref target="https://www.menestrel.fr/?-Roma-&amp;lang=fr#845">Menestrel</ref>).</acquisition>
                    </history>
