                            </decoNote>
                        </decoDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <desc>On the verso side of the scroll, at the bottom part, a note by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName>,
                                        stating that the manuscript was given from <persName role="owner" ref="https://betamasaheft.eu/PRS15459Celoria">
