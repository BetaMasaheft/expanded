                    <msContents><summary/>
                        <msItem xml:id="ms_i1">
                            <locus target="#2r"/>
                            <title ref="https://betamasaheft.eu/LIT7912Sadadihomu">Prayer against the pain of the eye of Bāryā and Legewon, for the binding and warding off
                                the demons</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነ፡ ባርያ፡ ወሌጌዎን፡ ሰዳዲሆሙ፡ ወመደንግፆሙ፡ ለአጋንንት፡
                                ወመሸብሮሙ፡ ለሰይጣናት። ስድዶሙ፡ እግዚኦ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <locus from="2r" to="2v"/>
                            <title ref="https://betamasaheft.eu/LIT7913PrAryanos">Prayer against the pain of the evil eye of Bāryā, Legewon and for the drowning of demons</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነ፡ ባርያ፡ ወሌጌዎን፡ መስጥሞሙ፡ ለአጋንንት። ጋሃን፡ አርያኖስ፡
                            </incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <locus from="2v" to="3r"/>
                            <title ref="https://betamasaheft.eu/LIT5920JohnBeg">Prayer against Zār reciting John 1:1–5</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎተ፡ ዛር፡ ወንጌል፡ ዘዮሐንስ፡ ቃዳሚሁ፡ ቃል፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <locus from="3r" to="3v"/>
                            <title ref="https://betamasaheft.eu/LIT4697MagicPr">Salām-hymn to Phanuel and prayer for the binding of demons</title>
                            <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ ማእሰረ፡ አጋንንት፡ ወሰይጣናት። ሰላም፡ ለከ፡ ሰዳዴ፡ አጋንንት፡ ፋኑኤል፡ ለእግዚአብሔር፡ እምጽርሑ፤</incipit>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <locus from="3v" to="4r"/>
                            <title ref="https://betamasaheft.eu/LIT5690MagicPrayer">Prayer against ʿAyna Warq, Nadarā containing the legend of the witch, seen by the 
                                Apostles on the shore of Galilee (Tiberias)</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ሕማመ፡ ዓይነት፡ ወሕማመ፡ ዓይነ፡ ወርቅ። ጸሎተ፡ ነዳራ። ወእንዘ፡ የሐውር፡ 
                                እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ውስተ፡ ባሕረ፡ ጥብርያደስ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <locus from="4r" to="4v"/>
                            <title ref="https://betamasaheft.eu/LIT7212PPTaosAzyos">Prayer to bind demons and to strike terror into the devils</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ማዕሠሮሙ፡ ለአጋንንት፡ ወመሸብሮሙ፡ ወመደንግፆሙ፡ ወመርዕዶሙ፡ 
                                <pb n="4v"/> ለሰይጣናት፡ በስሙ፡ ለእግዚአብሔር፡ አብ፡ በስሙ፡ ለእግዚአብሔር፡ ወልድ፡ በስሙ፡ ለእግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ታኦስ፡ አዝዮስ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i7">
                            <locus target="#4v"/>
                            <title ref="https://betamasaheft.eu/LIT7914PrNightmare">Salām la-śǝqāyǝka ba-ṭǝbṭābe maqśaft za-ḥamma</title>
                            <incipit xml:lang="gez">ሰላም፡ ለሥቃይከ፡ በጥብጣቤ፡ መቅሰፍት፡ ዘሐመ፤ <gap reason="ellipsis"/> ወኢታርእየኒ፡ መደንግፀ፡ ሕልመ። ኦአምላከ፡ 
                                ጊዮርጊስ፡ አ<choice resp="PRS8999Strelcyn"><sic>ድ</sic><corr>ደ</corr></choice>ኅነኒ፡ ለገብርከ፡ <gap reason="omitted"/>
                            </incipit>
                        </msItem>
                        <msItem xml:id="ms_i8">
                            <locus target="#5r"/>
                            <title ref="https://betamasaheft.eu/LIT6783MarkFive">Prayer for binding demons with a citation of Mark V</title>
                            <note>Magic prayer to bind demons, to terrify devils, and against illnesses caused by these devils and demons—ʾAlgum 
                                and ʾAngargǝnot—and the evil eye of all magicians and evil spirits. The text contains a citation of Mark V, 1-10.</note>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ማዕሰሮሙ፡ ለአጋንንት፡ ወመደንግፆሙ፡ ወመሸብሮሙ፡ ወመርዕዶሙ፡ 
                                ለሰይጣናት፡ ወለዘመቃብር፡ ጋኔን፡ ወከልክሎት፡ ወንጌል፡ ዘማርቆስ፡ ወበጽሐ፡ ማዕዶተ፡ ባሕር፡ ኀበ፡ አድያመ፡ ጌርጌሴኖን፡ ወሪዶ፡ እምሐመር፡ ተቀበሎ፡ ሶቤሃ፡ ብእሲ፡ 
                                ዘአኀዞ፡ ውስተ፡ <surplus>ውስተ፡</surplus> መቃብር፡ ጋኔን፡ ዘኮነ፡ ማኅደሩ፡ ውስተ፡ መቃብር፡ ወውስተ፡ አድባር፡ <gap reason="ellipsis"/> ይቤሎ፡ 
                                <choice resp="PRS8999Strelcyn"><sic>ወ</sic><corr>ው</corr></choice>እቱ፡ ሌጌዎን፡ ስምየ፡ እስመ፡ ብዙኃን፡ ንሕነ፡ 
                                ወአስተብቍዖ፡ ከመ፡ ያብሖሙ፡ ላዕለ፡ አሕርው፡ <gap reason="ellipsis"/> ፃእ፡ ሕማመ፡ አጋንንት፡ ወሰይጣናት፡ ሕማመ፡ አልጉም፡ 
                                ወአንገርግሮ<add place="below">ት</add>፡ ወእምዓይነ፡ ኵሎሙ፡ መሰርያን፡ ወመናፍስት፡ ርኩሳን፡ ከመ፡ ኢይቅረቡ፡ ላእሌሁ፡ አድኅኖ።
                                <gap reason="omitted"/></incipit>
                        </msItem>
                        <msItem xml:id="ms_i9">
                            <locus from="5r" to="5v"/>
                            <title ref="https://betamasaheft.eu/LIT7922Saytanat">Ṣalot baʾǝnta sayṭānāt ḥǝmāma ʾaganǝnt wa-ḥǝmāma ʿāyna Sayṭān</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ሰይጣናት፡ ሕማመ፡ አጋንንት፡ ወሕማመ፡ <sic>ዓይነት፡</sic> ሰይጣን፡ 
                                ዘትሬኢ፡ በዓይነ፡ ጠባይዕ፡ ሰማያዊ፡ <pb n="5v"/> ተአሰር፡ ይቤለከ፡ ቃለ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i10">
                            <locus target="#5v"/>
                            <title ref="https://betamasaheft.eu/LIT7921Yanaelan">Ṣalot baʾǝnta ʿāyna Bāryā wa-Legewon</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ዓይነ፡ ባርያ፡ ወሌጌዎን፡ ኤናኢለን፡ ወሌጌዎን፡ ኤናኢለን፡ ያርኢን፡ ያናኤላን፡
                                    </incipit>
                        </msItem>
                        <msItem xml:id="ms_i11">
                            <locus from="5v" to="6r"/>
                            <title ref="https://betamasaheft.eu/LIT7920Enemy">Ṣalot baʾǝnta magrare ḍar</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መግረሬ፡ ፀር፡ ላኢላህ፡ ሊሂም፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i12">
                            <locus target="#6r"/>
                            <title ref="https://betamasaheft.eu/LIT6752PPSmiths">Protective prayer against smiths, containing ʾasmāt</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ነሀብት፡ ሃሮፓሮስ፡ ሃሮፓሮስ፡ ሃሮፓሮስ፡ ሃሮፓሮስ፡ ሃሮስ፡ አልካ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i13">
                            <locus from="6r" to="6v"/>
                            <title ref="https://betamasaheft.eu/LIT7919MagrareDar">Ṣalot baʾǝnta magrare ḍar</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መግረሬ፡ ፀር፡ ሴቃ፡ ጼቃ፡ ቤጣ፡ ቤቃ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i14">
                            <locus from="6v" to="7v"/>
                            <title ref="https://betamasaheft.eu/LIT6788PPDrowning">Protective prayer for the drowning (maśṭǝm) of demons, for
        Sunday</title>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መግረሬ፡ ፀር፡ መስጥመ፡ አጋንንት፡ ዓቃቢሁኒ፡ ሳቁኤል፡ ወክበቡኒ፡ ሽመሽ፡ 
                                አሁማ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i15">
                            <locus target="#8r"/>
                            <title ref="https://betamasaheft.eu/LIT7918SalotFeqr">Ṣalot baʾǝnta fǝqr</title>
                            <incipit xml:lang="ti" type="inscriptio">መስተፋቅር፡ ዝገበረቶ፡ ሐንቲ፡ ሰበይቲ፡</incipit>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ግርማ፡ ሞገስ፡ ግርማ፡ መፍርህ፡ ግርማ፡ መደንግጽ፡ ጸሎት፡ በእንተ፡ ፍቅር፡ ሒም፡ ሒም፡ ሒም፡ 
                                ረቢ፡ ረረቢ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i16">
                            <locus target="#9r"/>
                            <title ref="https://betamasaheft.eu/LIT7917SevenKings">Names of the ‘seven kings’</title>
                            <quote xml:lang="gez">ስመ፡ አጋንንት። ኖብ፡ የአየር፡ ንጉሥ፡ አፈጋም፡ የባህርና፡ የገደል፡ ንጉሥ፡ ሰደፍ፡ የዛፍ፡ ንጉሥ፡ ቀጨር፡ የባርያ፡ ንጉሥ፡ ዧሌፍ፡ 
                                የንዳድ፡ ንጉሥ፡ ቆቢን፡ የዛር፡ ንጉሥ፡ ፍናስር፡ የመስተፋቅር፡ ንጉሥ፡</quote>
                        </msItem>
