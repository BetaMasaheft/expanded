                                </extent>
                                <collation>The manuscript is composed of 18 quires. One paper bifolium in the front (<locus from="1" to="2"/>) and one 
                                    paper bifolium at the end (<locus from="147" to="148"/>) are pasted on the front and back board, respectively.
                                    <signatures>The first 15 out of 18 quires are marked with quire marks (<foreign xml:lang="gez">፩</foreign> on 
                                       <locus target="#3r"/> to <foreign xml:lang="gez">፲፭</foreign> on <locus target="#113r"/>).</signatures>
                                </collation>
                                <condition key="good">The spine is damaged. The covers are worm-eaten.</condition>
                            </supportDesc>
                            <layoutDesc>
                                <layout columns="1" writtenLines="25"><locus from="3r" to="130v"/></layout><layout subtype="computed" type="catalogue" columns="1"><writtenLines quantity="25"/></layout>
                                <layout columns="2" writtenLines="25"><locus from="131r" to="136v"/></layout><layout subtype="computed" type="catalogue" columns="2"><writtenLines quantity="25"/></layout>
                            </layoutDesc>
                        </objectDesc>
                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Regular handwriting.</desc>
                                <seg type="ink">Black, red</seg>
                            </handNote>                            
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1" type="drawing">
                                <locus target="#2v"/>
                                <desc>Graffiti</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="band">
