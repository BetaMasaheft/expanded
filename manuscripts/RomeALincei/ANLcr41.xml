                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus target="#1ra"/>
                                    <desc type="GuestText">Fragment of <ref type="work" corresp="https://betamasaheft.eu/LIT2807RepCh91">Malkǝʾ-hymn to Our Lady Mary</ref></desc>
                                    <q xml:lang="gez">መንበረ<supplied reason="omitted" resp="PRS8999Strelcyn">፡</supplied> ጸሐይ፡ ሰማይ፡ ዘከዋክብት፡
                                        አክሊላ፡ ወምድርኒ፡</q>
                                </item>
                                <item xml:id="a2">
                                    <locus from="1va" to="1vb"/>
                                    <desc type="GuestText"><ref type="work" corresp="https://betamasaheft.eu/LIT6609ProtectPrayer">Magic prayer against wild animals</ref> 
                                        by an untrained hand.</desc>
                                    <q xml:lang="gez"><gap reason="ellipsis"/><supplied reason="omitted" resp="PRS8999Strelcyn">እግ</supplied>
                                        ዚአብ<supplied reason="omitted" resp="PRS8999Strelcyn">ሔ</supplied>ር፡ ነፍስ፡ <unclear>እ</unclear>፡ በስመ፡ 
                                        <gap reason="ellipsis"/> ጸሎት፡ ለዘትነድፈ፡ እምአርዌ፡ ጸለየ፡ ዳዊት፡ ወልደ፡ እሴይ፡ ይቤሎ፡ ለእግዚአብሔር፡ ዘቀተልከ፡ አንበሳ፡ ወክይሲ፡ 
                                        ከ<supplied reason="omitted" resp="PRS8999Strelcyn">ማ</supplied>ሁ፡ ቅትሎ፡ ለዝንቱ፡ አርዌ፡ ምድር፡ ወለዝንቱ፡ 
                                        አ<supplied reason="omitted" resp="PRS8999Strelcyn">ር</supplied>ዌ፡ ገዳም፡</q>
                                </item>  
                                <item xml:id="a3">
                                    <locus target="2r"/>
                                    <desc type="GuestText">Salām-hymn to the Trinity in the <ref target="#h1">main hand</ref>.</desc>
                                    <q xml:lang="gez">ሰላም፡ ለአብ፡ ወለወልድ፡ ወለመንፈስ፡ ቅዱስ፡</q>
                                </item>
                                <item xml:id="a4">
                                    <locus target="2r"/>
                                    <desc type="ProtectivePrayer">The middle of the page has been erased and written over upside down in another hand: 
                                        <ref type="work" corresp="https://betamasaheft.eu/LIT5888AsmatPrayer">a prayer to break spells</ref>.</desc>
                                    <q xml:lang="gez">መዡር፡ መዝርያል፡ ቸልያጊም፡</q>
                                </item> 
                                <item xml:id="a5">
