                    <msContents>
                        <summary>Protective Prayers</summary>
                        <msItem xml:id="ms_i1">
                            <title ref="https://betamasaheft.eu/LIT1878Marbab">Marbabta Salomon</title>
                            <textLang mainLang="gez"/>                            
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> መርበብተ፡ ሰሎሞን፡ ዘረበቦሙ፡ ለአጋንንት፡ ከመ፡ 
                                መርበብተ<supplied reason="omitted">፡</supplied> አሣ፡ ዘማዕከለ፡ ባሕር፡ እንዘ፡ ይብል፡ ሰዳቃኤል፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <title ref="https://betamasaheft.eu/LIT7865PrSalomon">ʾAsmāta Salomon ṣǝdǝryān ʾayās</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ወካዕበ፡ አስማተ፡ ሰሎሞን፡ ጽድርያስ፡ አያስ፡ <gap reason="ellipsis"/> ስሙ፡ ለእግዚአብሔር፡ አሐዘ፡ ሰሎሞን፡ አድኅነኒ፡
                                እምእደዊሆሙ፡ ለነሃብት፡ ወእምአቃብያነ፡ ሥራይ፡ ከማሁ፡ ሠውረኒ፡ ወአድኅነኒ፡ ሊቀ፡ ለገብርከ፡ <gap reason="lost"/></incipit>
                        </msItem>
                        <msItem xml:id="ms_i3">
                            <title ref="https://betamasaheft.eu/LIT7866GodSalomon">Wa-ʾǝmdǝḫra ʾaḫazǝwo la-Salomon wa-ʾanbarǝwo la-Salomon</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ወእምድኅረ፡ አሐዝዎ፡ ለሶሎሞን፡ ወአንበርዎ፡ ለሰሎሞን፡ እስከ፡ ሠሉስ፡ ዕለት፡ አምሳለ፡ ንውም፡ <gap reason="ellipsis"/>
                                ወአተበ፡ ገጸ፡ ሰሎሞን፡ እንዘ፡ ይብለ፡ በስመ፡ <gap reason="ellipsis"/> አአትብ፡ ገጽየ፡ ወኵለንታየ፡ እምብዝኃ፡ ድንጋፄ፡ ፍጥረቶሙ፡ ለነሃብት፡ ርኩሳን፡
                                ወሥጋየ፡ ወተሠሃለኒ፡ ሊተ፡ ገብርከ፡ <gap reason="lost"/></incipit>
                        </msItem>
                        <msItem xml:id="ms_i4">
                            <title ref="https://betamasaheft.eu/LIT7445PPQahashun">Prayer against Bāryā and Legewon, pleurisy (guśǝmt), Budā, Falāšā, wǝgʾāt and ʾaynat</title>
                            <note>Directed against the demons Bāryā and Legewon, as it is the case in another attestation in
                                <ref type="mss" corresp="https://betamasaheft.eu/BLorient11339">London, British Library, BL Oriental 11339</ref>, but in addition also against the demon Budā, as well as against various
                                diseases like fǝlṣat (headache), qʷǝrḍat (stomach ache), magāññā (colic with bad stomach ache caused by the tapeworm),
                                guśǝmt (chronic pleurisy with cough) and wǝgʿāt (rheumatism or stroke), against the Falāšā and against the
                                Evil Eye.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ቃሐሹን፡ ቃሐሹን፡ ቃሐሹን፡ <gap reason="ellipsis"/> በዘቦቱ፡ ሞኦሙ፡ ለባርያ፡ ወሌጌዎን፡ ለፍልፀት፡ ወለቍርፀት፡
                                ለመጋኛ፡ ወጉሥምት፡ ለቡዳ፡ ወፈላሻ፡ ለውግአት፡ ወለአይነት፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i5">
                            <title>Ṣalotāt baʾǝnta masṭǝma ʾagānǝnt</title>
                            <note>Prayers of the type masṭǝma ʾagānǝnt (drowner of demons)</note>
                            <textLang mainLang="gez"/>
                            <msItem xml:id="ms_i5.1">
                                <title ref="https://betamasaheft.eu/LIT7867MastemaYan">Ṣalot baʾǝnta masṭǝma ʾagānǝnt yānāʾelān behāqe</title>
                                <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ መስጥመ፡ አጋንንት፡ ያናኤላን፡ ቤሃቄ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i5.2">
                                <title ref="https://betamasaheft.eu/LIT7868MastemaYas">Ṣalot baʾǝnta masṭǝma ʾagānǝnt yāšamkǝt</title>
                                <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ መስጥመ፡ አጋንንት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡ ያሸምክት፡
                                    የሐል፡ ጥብሐል፡ ጥብሐል፡ ጥብሐል፡ ጥብሐል፡ ጥብሐል፡ ጥብሐል፡ ጥብሐል፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i5.3">
                                <title ref="https://betamasaheft.eu/LIT7869MasteLayal">Ṣalot baʾǝnta masṭǝma ʾagānǝnt layālafahem</title>
                                <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ መስጥመ፡ አጋንንት፡ ለያለፈሄም፡ ቁረጸሼሀ፡</incipit>
                            </msItem>
                        </msItem>
                        <msItem xml:id="ms_i6">
                            <title ref="https://betamasaheft.eu/LIT7871WegatMetat">Ṣalot baʾǝnta ḥǝmāma wǝgʿāt wa-mǝtʾat</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ ሕማመ፡ ውግዓት፡ ወምትአት፡ አኽላ፡ በላኽላኽ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i7">
                            <title>Prayer against a stitch in the side</title>
                            <note>Magic prayer against a stitch in the side, which begins with the 15th stanza of 
                                <ref type="work" corresp="https://betamasaheft.eu/LIT2842RepCh125">Malkǝʾa masqal</ref> and possibly resembles <ref type="work" corresp="https://betamasaheft.eu/LIT4625Prayer">Ṣalot baʾǝnta ḥǝmāma wǝgāt</ref>.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ሰላም፡ ለገቦከ፡ ኵናተ፡ ለንጊኖስ፡ ዘወግዖ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i8">
                            <title>Magic glyphs</title>
                            <note><term key="MagicSymbols" ana="#MagicSymbols">Magic glyphs (charaktêres)</term>.</note>
                        </msItem>
                        <msItem xml:id="ms_i9">
                            <title>Prayer against Bāryā and blacksmiths</title>
                            <note>Similar to <ref type="work" corresp="https://betamasaheft.eu/LIT4620Prayer">Ṣalot baʾǝnta ḥǝmāma nahabt wa-ʾagānǝnt ʾAlāhumā Wayānurā</ref>, but also directed to the demon Bāryā.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ጸሎት፡ በእንተ፡ ባርያ፡ ወነሃብተ፡ ሰብእ፡ አላሁማ፡ ወያኑራ፡</incipit>
                        </msItem>
                        <msItem xml:id="ms_i10">
                            <title ref="https://betamasaheft.eu/'LIT5888AsmatPrayer">Prayer against blacksmiths and Budā</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ ነሃብተ፡ ሰብእ፡ ወቡዳ፡ ጠቢብ፡ ሀሮጉሮፓስ፡ አርከ፡</incipit>
                        </msItem>
                    </msContents>
