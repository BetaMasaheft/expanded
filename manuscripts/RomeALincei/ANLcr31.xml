                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="1r" to="9v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT4960Taabbeyo">Saʾali lana Māryām saʾali lana Māryām ḫaba waldǝki ḫer madhane
        ʿālam</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <supplied reason="omitted">አብ፡</supplied> ወወልድ፡ ወመንፈስ፡ ቅዱስ <gap reason="ellipsis"/> ወጠንኩ፡ ዘለኪ፡ ውዳሴ፡ ማርያም፡ እህቱ፡ ለሙሴ፡ ሃ፡
                                እምቅ<supplied reason="omitted">ድ</supplied>መ፡ ሰማይ፡ ወምድር፡
                            </incipit>
                            <explicit xml:lang="gez">
                                ኦእግዚእትነ፡ እመ፡ ፈጣሪ፡ ኃጢአተነ፡ <sic>አስተሪ፡</sic> ወጸሎተነ፡ ስመሪ። ኦእግዝእትነ፡ እመ፡ ከሐሊ።
                            </explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <locus from="10r" to="16r"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT4957SebhataF">Sǝbḥāta fǝqur za-Giyorgis</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ነአ፡ ነአ፡ ጊዮርጊስ፡ ሰማዕተ፡ ኢየሱስ፡ ክርስቶስ፡ ወነዓ፡ ፍቁርየ፡ ዘልዳ፡ ንጉሥ። ነአ፡ ጊዮርጊስ፡
                                እንዘ፡ ትጼዕን፡ በፈረስ፡ <expan><abbr>ወ፡</abbr><ex>ወነዓ፡</ex></expan>
                                <expan><abbr>ፍቁ፡</abbr><ex>ፍቁርየ፡</ex></expan>
                                <expan><abbr>ዘል፡</abbr><ex>ዘልዳ፡</ex></expan> 
                                <expan><abbr>ንጉ።</abbr><ex>ንጉሥ።</ex></expan> ነዓ፡ ጊዮርጊስ፡ እንዘ፡ ትሰርር፡ በፈረስ፡
                                <expan><abbr>ወ፡</abbr><ex>ወነአ፡</ex></expan> <expan><abbr>ፍ፡</abbr><ex>ፍቁርየ፡</ex></expan> 
                                <expan><abbr>ዘ፡</abbr><ex>ዘልዳ፡</ex></expan> <expan><abbr>ን።</abbr><ex>ንጉሥ።</ex></expan> 
                                ሰላም<supplied reason="omitted">፡</supplied> ዘሐረጸከ፡ ዱድያኖስ፡ ወወገረከ፡ ደብረ፡ ይድራስ፡ ዘዘረወከ፡ በነፋስ፡
                               ሰላም፡ ለከ፡ ጊዮርጊስ። <expan><abbr>ሰላ፡</abbr><ex>ሰላም፡</ex></expan> ናሁ፡ ወጠነኩ፡ ዝክረ፡ 
                                ው<supplied reason="omitted">ዳ</supplied>ሴከ፡ 
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <locus from="17r" to="23v"/>
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT1869Malkea">Malkǝʾa wǝddāse Māryām</title>
                            <note>The catalogue contains no statement on the completeness of the
                                text, which begins with stanza 6 of the section for Thursday
                                of <ref type="work" corresp="https://betamasaheft.eu/LIT1869Malkea">Malkǝʾa wǝddāse Māryām</ref>.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ዳዊት፡ በነግሠ፡ መልዕልተ፡ እስራኤል፡ ሐራ፡ ኪያኪ፡ ሰብሐ፡ በአ<add place="below">ው</add>ታር፡ ወበእንዚራ፡ 
                                ማርያም፡ ድንግል፡ ማር<add place="below">ያ</add>ም፡ ወለተ፡ ቅሰራ፡ 
                                ለነፍሰ፡ ዚአየ፡ አስተዳልዊ፡ ማኅደራ፡ 
                                ውስተ፡ መቅደስኪ፡ ለማኅቡዕ፡ ኅቡራ።
                            </incipit>
                            <explicit xml:lang="gez">
                                ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ አድባር፡ ወአውግር፡ 
                                ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ ቀላያት፡ ወባሕር፡ 
                                ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ ዕፀው፡ ወሣዕር፡ 
                                ስብሐት፡ <add place="below">ለኪ፡</add> ንግሥትየ፡ በልሳነ፡ <add place="below">ኵሉ፡</add> ፍጥረት፡ እስመ፡ ምሉዕ፡ 
                                ስብሐትኪ፡ በሰማይ፡ ወምድር።
                            </explicit>
                        </msItem>
                    </msContents>
                    
