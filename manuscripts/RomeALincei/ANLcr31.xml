                    <history>
                        <origin>
                       <origDate notBefore="1700" notAfter="1899" evidence="lettering"/>
                        </origin>
                        <provenance>The manuscript 
                            came from a church in ‘Arbambà’ in <placeName ref="https://betamasaheft.eu/LOC5597Sawa">Šawā</placeName>, maybe
                            corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName> (see <ref target="#e3"/>). It was either acquired by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>)
                            or sent to him after his return to Europe.
                        </provenance>
                        <acquisition>The manuscript passed into the possession of the library in <date when="1950">1950</date>, following Conti Rossini’s death in <date when="1949">1949</date> 
                            (see <ref target="https://www.menestrel.fr/?-Roma-&amp;lang=fr#845">Menestrel</ref>).</acquisition>
                    </history>
                    
