                    <msContents>
                        <summary/>           
                        <msItem xml:id="ms_i1">
                            <locus from="4ra" to="53rb"/>
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT1407GadlaA">Gadla ʿAbiya ʾƎgziʾ</title>
                            <note><persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> could not use this witness for 
                                <bibl corresp="http://zotero.org/groups/358366/items/32R9XIJ9"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:ContiRossini1938AbiyaEgzi"/><title level="a">Note di agiografia etiopica (ʿAbiya Egziʾ, ʿArkalēdes e Gabra-Iyasus)</title><title level="j">Rivista degli Studi Orientali</title><author><forename>Carlo</forename><surname>Conti Rossini</surname></author><date>1938</date><biblScope unit="volume">17</biblScope><biblScope unit="page">409–452</biblScope><note type="url">https://www.jstor.org/stable/i40089325</note><note type="tags"><note type="tag">bm:ContiRossini1938AbiyaEgzi</note></note><note type="tag">bm:ContiRossini1938AbiyaEgzi</note></bibl>, because the article was already in print, 
                                when he acquired the manuscript.</note>
                            <incipit xml:lang="gez">በስመ፡ <gap reason="ellipsis"/> ገድሉ፡ ወዜና፡ ኂሩቱ፡ ለአቡነ፡ ዓቢየ፡ እግዚእ፡ ዘሰመዮ፡ አቡሁ፡ እምንዕሱ። ወዘሰመዮሰ፡ 
                                መምሕሩ፡ ዘበምንኵስና፡ እንጦንዮስ፡ ንንግርክሙ፡ ወናየድዕክሙ፡ ትዕግሥቶ፡ ዘከመ፡ ገብረ፡ ሎቱ፡ እግዚአብሔር<sic>።</sic> ተአምረ፡ ወመንክረ፡ እስከ፡ 
                                ያነክሩ፡ ኵሎሙ፡ ሰብእ፡ ኂሩቶ፡ ወትዕግሥቶ። ጸሎቱ፡ ወበረከቱ፡ የሃሉ፡ ምስለ፡ <gap reason="lost"/> ለዓለመ፡ ዓለም፡ አሜን።</incipit>
                            <textLang mainLang="gez"/>
                        </msItem>    
                        <msItem xml:id="ms_i2">
                            <locus from="53va" to="62ra"/>
                            <title ref="https://betamasaheft.eu/LIT0308Malke">Malkǝʾa ʿAbiya ʾƎgziʾ</title>
                            <incipit xml:lang="gez">
                                ሰላም፡ ለዝ<supplied reason="omitted" resp="PRS8999Strelcyn">ክ</supplied>ረ፡ ስምከ፡ ዘተሰብሐ፡ ፈድፋደ።<lb/>
                                በአፈ፡ መላእክት፡ ወሰብእ፡ እስመ፡ ጽድቅከ፡ ተንዕድ።<lb/>
                                ዓቢየ<supplied reason="omitted" resp="PRS8999Strelcyn">፡ </supplied>
                                እግዚ<supplied reason="omitted" resp="PRS8999Strelcyn">እ</supplied>፡ ክቡር፡ እንተ፡ ትመስል፡ መረግደ
                                <supplied reason="omitted" resp="PRS8999Strelcyn">።</supplied><lb/>
                                ኵሎ፡ ፍጥረታተ፡ ወኵሎ፡ ነገደ።<lb/>
                                አባ፡ መንክራቲከ፡ በዓለም፡ አስገደ።<lb/>
                            </incipit>
                            <textLang mainLang="gez"/>
                        </msItem>
