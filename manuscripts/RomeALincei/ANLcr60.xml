                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Careful handwriting. Name of the scribe: <persName role="scribe" ref="https://betamasaheft.eu/PRS15059BezawaWald">Bezawa Wald</persName>.</desc>
                                <seg type="ink">Black, red.</seg>
                            </handNote>
                        </handDesc>
                        <decoDesc>
                            <decoNote xml:id="d1" type="drawing">
                                <desc>The pieces of parchment that form the spine and protrude from the front and back of the manuscript are
                                    covered with graffiti.</desc>
                            </decoNote>
                            <decoNote xml:id="d2" type="drawing">
                                <desc>Graffiti on the inner front board.</desc>
                            </decoNote>
                        </decoDesc>
                        <additions>
                            <list>               
                                <item xml:id="a1">
                                    <locus from="1ra"/>
                                    <desc type="GuestText"><ref type="work" corresp="https://betamasaheft.eu/LIT7716PrayerJes">Sǝʾlat wa-ʾastabqʷǝʾot ḫaba ʾƎgziʾǝna wa-ʾAmlākǝna ʾIyasus Krǝstos la-śǝgā wa-nafs</ref> 
                                        <q xml:lang="gez">ስዕለት፡ ወመስተብቁዓት፡ እግዚእነ፡ ወአምላክነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘትበቍዕ፡ ለሥጋ፡ ወነፍስ፡</q></desc>
                                </item>
                                <item xml:id="a2">
                                    <locus from="1rb"/>
                                    <desc type="GuestText">Salām-hymn concerning the different parts of the body of the Virgin Mary, possibly part of 
                                        <ref type="work" corresp="https://betamasaheft.eu/LIT5685Hymn">Hymn to Jesus Christ</ref>. 
                                        <q xml:lang="gez">ሰላም፡ ለኪ፡ ኦአፍ፡ ቅድስት፡ ዘቤዛዊነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘፈቀድኪ፡ ትጥዓሚ፡ 
                                            ሐሞተ<supplied reason="omitted">፡</supplied> ወከርቤ፡ <unclear>ቱስሐ፡</unclear>
                                            ከመ<supplied reason="omitted">፡</supplied> ተሀበኒ፡ መድ<supplied reason="omitted">ኃ</supplied>ኒተ፡
                                            ለነፍሳቲነ፡ አድኅነነ፡ እምእደ፡ ዕጣን፡ ፀርነ፡ <gap reason="ellipsis"/> ሰላም፡ ለኪ፡ ኦእድ፡ ቅድስት፡ የማናዊት፡</q></desc>
                                </item>
                                <item xml:id="a3">
                                    <locus from="1rb"/>
                                    <desc type="GuestText">Prayer for the salutation of a certain <persName ref="https://betamasaheft.eu/PRS15071Zamanuel">Zāmānuʾel</persName>.</desc>
                                </item>
                                <item xml:id="a4">
                                    <locus from="63va" to="64ra"/>
                                    <desc type="GuestText">Halleluyatic prayer in three Halleluyas, with musical annotation, possibly taken from
                                        <ref type="work" corresp="https://betamasaheft.eu/LIT2361somade">Ṣoma dǝggʷā</ref>:
                                        <q xml:lang="gez">በ፫ ሃ<supplied reason="undefined" resp="PRS8999Strelcyn">፡</supplied> ስምዕዎኬ፡ ለእግዚእነ፡ 
                                            ኵልክሙ፡ አብያተ፡ ክርስቲያናት፡ <gap reason="ellipsis"/></q></desc>
                                </item>
                                <item xml:id="a5">
                                    <locus from="64rb" to="65vb"/>
                                    <desc type="GuestText">Salām-hymn to the Virgin, similar to <ref type="work" corresp="https://betamasaheft.eu/LIT2814RepCh98">Salām laki dāgǝmit samāy</ref> as well as 
                                        to the explicit of <ref type="work" corresp="https://betamasaheft.eu/LIT1807Litonz">ʾƎnza naʾakkʷǝto ʾǝsma ʿaqabanna</ref> as attested in 
                                        <ref type="mss" corresp="https://betamasaheft.eu/BAVet1#ms_i4.2">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 1: ʾƎnza naʾakkʷǝto ʾǝsma ʿaqabanna (in ms_i4.2)</ref> on fol. 126v: <q xml:lang="gez">ሰላም፡ ዳግሚት፡ ሰማይ፡ ማርያም፡ ሙፃዓ፡ 
                                            ፀሐይ፡ <unclear>አንቀጸ፡</unclear> መድኃኒት፡ ሙዳየ፡ እፍረት፡ <gap reason="ellipsis"/></q></desc>
                                </item>                 
                                <item xml:id="a6">
                                    <locus target="#63ra"/>
                                    <desc type="OwnershipNote">Ownership note for <persName role="owner" ref="https://betamasaheft.eu/PRS15057SennaGiy">Sǝnna Giyorgis</persName>,
                                        father of <persName ref="https://betamasaheft.eu/PRS15058TaklaAmin">Takla ʾAmin</persName>.</desc>
                                </item>
                                <item xml:id="a7">
                                    <locus target="#63va"/>
                                    <desc type="OwnershipNote">Ownership note for <persName role="owner" ref="https://betamasaheft.eu/PRS15057SennaGiy">Sǝnna Giyorgis</persName>.</desc>
                                </item>
                                <item xml:id="e1">
                                    <locus target="#63va"/>
                                    <desc type="ScribalSignature">Name of the scribe <persName role="scribe" ref="https://betamasaheft.eu/PRS15059BezawaWald">Bezawa Wald</persName>.</desc>
                                </item>
                                <item xml:id="e2">
                                    <desc type="StampExlibris">Ex libris <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName></desc>
                                </item>
                                <item xml:id="e3">
                                    <desc type="StampExlibris"><q xml:lang="it">Chiesa di Arbambà (Scioa)</q>
                                        Possibly corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName>.</desc>
                                </item>
                            </list>
                        </additions>
                        <bindingDesc>
                            <binding contemporary="Ethiopian">
                                <decoNote xml:id="b1" type="Boards">Wooden boards, of which only the front board is preserved</decoNote>
                                <decoNote xml:id="b2" type="EndLeaves">The manuscript is sewn into a sheet of parchment with pieces of cloth
                                    on both sides between the manuscript and the wooden covers.</decoNote>
                                <decoNote xml:id="b3" type="bindingMaterial"><material key="wood"/><material key="textile"/></decoNote>
                            </binding>
                        </bindingDesc>
                    </physDesc>
                    <history>
                        <origin>
                            <origDate notBefore="1700" notAfter="1800">18th century</origDate>
                        </origin>
                        <provenance>The owner was <persName role="owner" ref="https://betamasaheft.eu/PRS15057SennaGiy">Sǝnna Giyorgis</persName> as mention in <ref target="#a6 #a7"/>.
                            The manuscript was in possession of a church in ‘Arbambà’ in <placeName ref="https://betamasaheft.eu/LOC5597Sawa">Šawā</placeName>, possibly
                            corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName> (see <ref target="#e3"/>). 
                            It was either acquired by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>) or sent to him after his return to Europe.</provenance>
                    </history>
