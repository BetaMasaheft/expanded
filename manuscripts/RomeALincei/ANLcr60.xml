                  <msContents>
                        <summary/>
                        <msItem xml:id="ms_i1">
                            <locus from="3ra" to="63ra"/>
                            <title ref="https://betamasaheft.eu/LIT3575Mashaf">Maṣḥafa saʿātāt</title>                        
                            <notatedMusic><desc>With musical notation.</desc></notatedMusic>
                            <incipit type="inscriptio" xml:lang="gez">ሰዓታቱ፡ ለአባ፡ <persName ref="https://betamasaheft.eu/PRS4709Giyorgis">ጊዮርጊስ፡</persName>
                                ዘመዓልት፡ ወዘሌሊት፡ በረድኤተ፡ እግዚእነ፡ ዘደረሰ፡ በሰላመ፡ እግዚአብሔር፡</incipit>
                            <msItem xml:id="ms_i1.1">
                                <locus from="3ra" to="13rb"/>
                                <title>Morning service</title>                        
                                <incipit xml:lang="gez">መዝሙር፡ በ፭ሃሎ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ በጽሐ፡ አዕይንትየ፡ ለገይስ፡ ከመ፡ እንብብ፡ ቃለከ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.2">
                                <locus from="13rb" to="23va"/>
                                <title>Service of the 3rd hour</title>                        
                                <incipit xml:lang="gez">መዝሙር፡ በ፫ሰአት፡ መኑ፡ ዘደመሮ፡ ለብርሃን፡ ምስለ፡ ጽልመት፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.3">
                                <locus from="23va" to="31vb"/>
                                <title>Service of the 6th hour</title>                        
                                <incipit type="inscriptio" xml:lang="gez">መዝሙር፡ ዘቀትር፡ በ፭ሃሌ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ ሃሌ፡ ሃሌ፡ ሃሌ፡ ሉያ፡ ትግሁ፡ እንከ፡ አኃውየ፡ ጽልዩ፡ ወሰአሉ፡
                                    ከመ፡ ኢትባዑ፡ ውስተ፡ መንሱት፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.4">
                                <locus from="31vb" to="41va"/>
                                <title>Service of the 9th hour</title>                        
                                <incipit xml:lang="gez">መዝሙር፡ ዘተስዐቱ፡ ሰዓት<supplied reason="omitted">፡</supplied> ኖላዊ፡ ዘመዓልት፡ ሀላዊ፡ ዘሌሊት፡
                                    </incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.5">
                                <locus from="41va" to="55vb"/>
                                <title>Service of Vespers</title>                        
                                <incipit xml:lang="gez">መዝሙር፡ ዘሠርክ፡ በ፭ሃሌ፡ ሃሌ፡ ሊሌ። <unclear>ሕየኒ፡</unclear> እዴከ፡ ትመርሐኒ፡ ወታነብረኒ፡</incipit>
                            </msItem>
                            <msItem xml:id="ms_i1.6">
                                <locus from="55vb" to="63ra"/>
                                <title>Compline</title>                        
                                <incipit xml:lang="gez">መዝሙር፡ ዘንዋም፡ ሃሌ፡ ሉያ፡ መኑ፡ ይትኤረዮ፡ ለእግዚአብሔር፡ በደመናት፡</incipit>
                            </msItem>
                        </msItem>
                        <msItem xml:id="ms_i2">
                            <locus from="63r" to="63v"/>
                            <title ref="https://betamasaheft.eu/LIT3655Miracle">Miracle of Mary: Miracle of a woman from Ceasarea whom Mary
        helped to give birth</title>    
                            <incipit xml:lang="gez">ተአምሪሃ፡ <gap reason="ellipsis"/> ወሀለወት፡ አሐቲ፡ ብእሲት፡ እምዐበይት፡ ሀገረ፡ ሶርያ፡ ወኮነ፡ አቡሃ፡ በአለ፡ በሕቁ፡
                                በወርቅ፡ ወ<cb n="63rb"/>በብሩር፡ ወበኵሉ፡ ንዋየ፡ ዓለም፡ ሐላፊ፡ ወይእቲሰ፡ ብእኢት፡ ኮነት፡ ፅንስተ፡</incipit>
                        </msItem>
                    </msContents>
