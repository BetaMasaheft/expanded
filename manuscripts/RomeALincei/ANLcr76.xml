                    <msPart xml:id="p2">
                        <msIdentifier/>
                        <msContents><summary>Copy of the preceding Tigrinyā poems and Miracles of Mary</summary>
                            <msItem xml:id="p2_i1">
                                <locus from="1r" to="7v"/>
                                <title>Nuzāze</title>                        
                                <note>Copy of work in <ref target="#p1_i1"/>, which is a poem in rhyming stanzas and of unequal length authored by 
                                    <persName role="author" ref="https://betamasaheft.eu/PRS15077TaklaWM">fitawrāri Takla Walda Māryām</persName>, containing some 
                                    corrections.</note>
                                <incipit xml:lang="ti">
                                    ክንደይ፡ ዘገርም፡ እዩ፡ ናይዚ፡ ናተይ፡ ምላደይ፡<lb/>
                                    ብሀንደበት፡ ቀሪቡ፡ ምዕጻደይ፡<lb/>
                                    ክሳዕ፡ ሎሚ፡ ከይፈለጥኩ፡ ዓደይ፡<lb/>
                                    ብዐንተቦይ፡ ከይጸርግ፡ መገደይ፡<lb/>
                                    እዋን፡ ንእስነተይ፡ ይሓልፍ፡ አነ፡ ዘይግደይ፡<lb/>
                                    ንህይዋን፡ ዘስሓተ፡ ጌረዮ፡ ዘመደይ፡<lb/>
                                    መርገም፡ ናተይ፡ ሓዲሩ፡ ናብ፡ ከብደይ።<lb/>
                                </incipit>
                                <textLang xml:lang="ti"/>
                            </msItem> 
                            <msItem xml:id="p2_i2">
                                <locus from="8r" to="12r"/>
                                <title ref="https://betamasaheft.eu/LIT3585Taamme">Three miracles of Mary</title>
                                <note>Copy of <ref target="#p1_i2"/> with some corrections.</note>
                                <msItem xml:id="p2_i2.1">
                                    <locus from="8r" to="9r"/>
                                    <title ref="https://betamasaheft.eu/LIT4998MiracleJewJerusalem">Miracle of Mary: Miracle of a Jew from Jerusalem
        swallowed by a snake</title>
                                    <incipit xml:lang="gez">ተአምሪሀ፡ <gap reason="ellipsis"/> ወሀሎ፡ አሀዱ፡ ብእሲ፡ እብራዊ፡ እም፡ ዘመደ፡ ክቡራን፡ በሀገረ፡ ኢየሩሳሌም፡
                                        ዘስሙ፡ እስክንድሮስ፡ ወይሀውር፡ በግእዘ፡ አይሁደ፡ ወይገብር፡ ሀጣውአ፡ ብዙሀ፡ ዘይአምጽ፡ ለእግዚአብሄር፡ ወአሀቱ፡ እለተ፡ እንዘ፡ ያሰግር፡ አሳ፡ ዘመርበብተ፡
                                        መጽኣ፡ ሀቤሁ፡ ተመን፡ አብይ፡ እምውስተ፡ ገዳም፡ መን<choice resp="PRS8999Strelcyn"><sic>በላ</sic><corr>ገለ፡</corr></choice>
                                        ባህር፡ እንዘ፡ ይግህር፡ ከመ፡ አንበሳ፡ ወአብቀወ፡ እራሁ፡ ከመ፡ ይሀቦ፡ ወጸርሀ፡ በልኡል፡ ቃለ፡ እንዘ፡ ይብል፡ እግዝእትየ፡</incipit>
                                </msItem>
                                <msItem xml:id="p2_i2.2">
                                    <locus from="9r" to="10v"/>
                                    <title ref="https://betamasaheft.eu/LIT3917Miracle">Miracle of Mary: How the Virgin Mary obtained forgiveness for a
        monk who mutilated himself after he had defiled himself</title>
                                    <incipit xml:lang="gez">ወሀሎ፡ ፩ መነኮስ፡ ዘስሙ፡ በርድዮስ፡ በሀገረ፡ ባኖስ፡ ወእንዘ፡ ይሀውር፡ ሀበ፡ አባ፡ ያእቆብ፡ ወአሀተ፡ እለተ፡ ተንስኣ፡ ይሁር፡
                                        ወአስተፋነወቶ፡ ብእሲቱ፡ አበክስያ፡ ወእንዘ፡ ሀሎ፡ በፍኖት፡ ቀንኣ፡ ላእሌሁ፡ ሰይጣን፡ ወሞኣ፡ ፍትወተ፡ ርኩስ፡ ወሰከበ፡ 
                                        ም<supplied reason="undefined" resp="PRS8999Strelcyn">ስ</supplied>ሌሀ፡ በተደምሮ፡ ስጋ፡</incipit>
                                </msItem>
                                <msItem xml:id="p2_i2.3">
                                    <locus from="10v" to="12r"/>
                                    <title ref="https://betamasaheft.eu/LIT3630Miracle">Miracle of Mary: Miracle of an Arab chief sparing Christian
        pilgrims</title>
                                    <incipit xml:lang="gez">ወሀሎ፡ ፩፡ ወኮነ፡ በ፩፡ እመዋዕል፡ እንዘ፡ ይገብሩ፡ በአለ፡ እግዝእትነ፡ ቅድስት፡ በክልኤ፡ ማርያም፡ ወላዲተ፡ አምላክ፡ በሀገረ፡ 
                                        አትሪብ፡ አ<supplied reason="undefined" resp="PRS8999Strelcyn">መ</supplied>፡ ፳፡ ወ<sic>፬</sic>፡ ለወርሀ፡ ሰኔ፡ ቅዳሴ፡
                                        ቤተ፡ <sic>ክርስትና፡</sic> በሀገረ፡ ፊልጱስዩስ፡ ወበዝንቱ፡ በአል፡ <sic>አደ፡</sic> ተጋብኡ፡ ህዝብ፡ መሀይምናን፡ ሀበ፡ ቤተ፡ ክርስቲያን፡</incipit>
                                </msItem>
                                <textLang xml:lang="gez"/>
                            </msItem>
                            <msItem xml:id="p2_i3">
                                <locus from="12r" to="14v"/>
                                <title>ʾƎziʾā ʾawāhlila za-yǝtǝrǝssāʿ</title>                        
                                <note>Copy of <ref target="#p1_i3"/> with some corrections. Composed by the same 
                                    author as <ref target="#p1_i1"/> (= <ref target="#p2_i1"/>).</note>
                                <incipit xml:lang="ti">እንተኾነ፡ ግና፡ ነዚኣ፡ ከዋህልላ፡ ነገር፡ ሰንበተ፡ ሰንበት፡ ምስ፡ ተአከቡ፡ አነ፡ ድማ፡ ምስኣቶም፡ ከይደ፡ ኮፍ፡ ይብል፡ ድሓር፡ ነዛ፡ መጽሓፍ፡
                                    እዚአ፡ የንብበልና፡ እታ፡ ሀገር፡ ኩላ፡ ጽን፡ ኢላ፡ ትሰምዕ፡ እንተኾነ፡ ካብኡ፡ ፋሕ፡ ምስ፡ በልካ፡ እንተ፡ 
                                    ጠየቝካያ፡
                                    እንታይ፡ እንታይ፡ ሰሚዕኪ፡ እንተ፡ በልካያ፡ ግና፡ ሐንቲ፡ አይትመልሰልካን፡</incipit>
                            </msItem>
                        </msContents>
