                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <locus from="1r" to="38v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT7565MasAm">Masarata ʾamin</title>
                            <textLang mainLang="gez" otherLangs="am"/>
                            
                            <msItem xml:id="ms_i1̏.1">
                                <locus from="1r" to="19r"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT7565MasAm#">On the Trinity</title>
                                <note>Since <locus target="#1"/> is legible only with difficulty, the
                                    beginning of the text is not certain.</note>
                                <incipit xml:lang="am">
                                    በስመ፡ <gap reason="ellipsis"/>ንጽሕፍ፡ መጽሐፈ፡ ዘይሰመይ፡ መሰረተ፡ አሚን። እንዘ፡
                                    ንብል፡
                                    <gap reason="illegible"/>
                                    በት፡ ሃይማኖት፡ ሶስት፡ አካላት፡ ሐንድ፡ መለኮት፡ ነው፡ <gap reason="illegible"/> ሐንድ፡ 
                                    <gap reason="illegible"/>
                                    <pb n="1v"/>ቺ፡ <gap reason="illegible"/>
                                    ቢሉን። ድዮናስ<supplied reason="omitted">ዮ</supplied>ስ፡ ዘአትናስ፡
                                    እስመ፡ ፩ ኃይል፡ እሙንቱ፡ ወበእንተዝ፡ ይከውኑ፡ አሐደ፡ ወእንዘ፡ ይትሌለዩ፡
                                    ገጻተ፡ ሥላሴ፡ በበመልክዑ፡ ፍጹመ፡ የሐብሩ፡ በተዋሕዶተ፡ መለኮት፡ ይላል።
                                    አግናጥዮስም<supplied reason="omitted">፡</supplied> ዘሮም፡ በ፪ ክፍል፡ 
                                    እስ<pb n="2r"/>መ፡ ባሕርየ፡ ሥላሴ፡ ፩ ውእቱ፡
                                    ዘውእቱ፡ ፩ መለኮት፡ ይላል፡ ጎርጎርዮስም፡<surplus>፡</surplus> ዘቂሳርያ፡ በ፩ ክፍል፡
                                    ወሥሉስ፡ ቅዱስ፡ ይሰመይ፡ እሎንተ፡ አስማተ፡ ጽኑዓነ፡ እንዘ፡ ውእቱ፡ ፩ <sic resp="DR">ህላሄ፡</sic>
                                        ፫ አካላት፡ ፩ መለኮት፡ ይላል።
                                </incipit>
                            </msItem>
                            
                            <msItem xml:id="ms_i1.2">
                                <locus from="19r" to="38v"/>
                                <title type="complete" ref="https://betamasaheft.eu/LIT7565MasAm#">On the Incarnation</title>
                                <incipit xml:lang="am">
                                    የሥጋዌነም፡ ነገር፡ እንዴህ፡ እንላለን፡ ከ፫ አካላት፡ አካለ፡ ቃል፡ ሥጋ፡ ኾነ፡ እንላለን፡
                                    ወንጌል፡ ዮሐንስ፡ ወውእቱ፡ ቃል፡ ሥጋ፡ ኮነ፡ ወኀደረ፡ ላዕሌነ፡ እንዳለ።
                                </incipit>
                            </msItem>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <locus from="39r" to="46v"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT3083RepCh363">ʾƎgziʾabǝḥer za-bǝrhānāt ʾǝgziʾabǝḥer za-śǝlṭānāt</title>
                            <textLang mainLang="gez"/>
                            <note><ref type="work" corresp="https://betamasaheft.eu/LIT3083RepCh363">ʾƎgziʾabǝḥer za-bǝrhānāt ʾǝgziʾabǝḥer za-śǝlṭānāt</ref> is followed by other prayers.</note>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <locus from="46v" to="48v"/>
                            <title type="incomplete" ref="https://betamasaheft.eu/LIT4963Naahabeya">Naʿā ḫabeya ʾo-ʾǝgziʾǝya ʾIyasus Krǝstos</title>
                            <note>The catalogue (   <bibl corresp="http://zotero.org/groups/358366/items/N6HPGQK3"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Strelcyn1976Catalogue"/><title level="m">Catalogue des manuscrits éthiopiens de l’Accademia Nazionale dei Lincei: Fonds Conti Rossini et Fonds Caetani 209, 375, 376, 377, 378</title><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><author><forename>Stefan</forename><surname>Strelcyn</surname></author><pubPlace>Roma</pubPlace><publisher>Accademia Nazionale dei Lincei</publisher><date>1976</date><series><title level="s">Indici e Sussidi Bibliografici della Biblioteca</title><biblScope unit="volume">9</biblScope></series><biblScope unit="volume">9</biblScope><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:IHABook182</note><note type="tag">bm:Strelcyn1976Catalogue</note><citedRange unit="page">105</citedRange></bibl>) describes the text as ‘Sayfa malakot hymn’. The end is missing, the text ends abruptly.</note>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">መብረቀ፡ መለኮት፡ መድን<pb n="47r"/>ግጽ፡<surplus>፡</surplus> ፍኅመ፡ መለኮት፡ ብቍጽ።
                                ኃጸ፡ መለኮት፡ ርውፅ። እሳተ፡ መለኮት፡ ውዑይ፡<surplus>፡</surplus>
                                <sic>ነድ፡</sic> መለኮት፡ ውኵይ። <sic>ጸሐይ፡</sic> መለኮት፡ ልሁይ። እብነ፡ መለኮት፡</incipit>
                            <explicit xml:lang="gez"><pb n="48v"/><gap reason="ellipsis"/> መስዋእተ፡
                                ንጹሐ፡ ዘእለተ፡ ዐርብ፡ በዲበ፡ እፀ፡
                                መለኮት፡ ተጸ</explicit>
                        </msItem>
                        
                        <msItem xml:id="ms_i4">
                            <locus from="52v" to="54r"/>
                            <title type="complete" ref="https://betamasaheft.eu/LIT7564PPDemons">Protective prayer against demons and sorcerers</title>
                          <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ንሐሐ፡ ውእቱ፡ ኢየሱስ፡ ክርስቶስ፡ በግዕ፡ ርጉዝ፡ <gap reason="ellipsis"/>
                                <pb n="53v"/><gap reason="ellipsis"/>
                                አውግ<pb n="54r"/>ዞሙ፡ ለሰይጣናት፡ በመለኮተ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡
                                ፩ እግዚአብሔር፡ 
                                ኢይቅረቡ፡ እምኔየ። አውግዞሙ፡ ለአጋንንት፡ እኩያን፡
                                ወሰብእ፡ መሰርያን፡ አውገዝኵክመ፡ በአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ አነ፡
                                <space reason="owner"/>
                            </incipit>
                        </msItem>
                        
