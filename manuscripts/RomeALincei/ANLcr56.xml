                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Very small and careful handwriting of circa 2 mm in height, with even smaller script on <locus target="#23v"/>
                                    and immediately after with a height of just only 1 mm. Very small signs of musical notation.</desc>
                                <seg type="ink">Black, red.</seg>
                                <date notBefore="1900" notAfter="1949" resp="PRS8999Strelcyn">First half of the 20th century</date>
                                <persName role="scribe" ref="https://betamasaheft.eu/PRS15177YohannesT">Yoḥannǝs Taklu</persName>
                            </handNote>                            
                        </handDesc>
                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <desc type="GuestText">Fragments of prayers.</desc>
                                </item>
                                <item xml:id="a2">
                                    <locus from="77vb" to="78r"/>
                                    <desc type="GuestText">Fragments of New Testament texts, written in a larger handwriting.</desc>
                                    <q xml:lang="gez">ዘኤፌሶን፡ ወእምይእዜሰ፡ ኢኮነ፡ ነግደ፡ ወፈላሴ፡ ሀገሪቶሙ፡ ለቅዱሳን፡ ንሕነ፡ ወሰብአ፡ ቤቱ፡ ለእግዚአብሔር፡ ተሐነጽክሙ፡ ዲበ፡
                                        መሠረተ፡ ነቢያት፡</q>
                                </item>
                                <item xml:id="a3">
                                    <locus target="#1r"/>
                                    <desc>Note written by <persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> stating the provenance of the
                                        manuscript from a church in ‘Arbambà’ in <placeName ref="https://betamasaheft.eu/LOC5597Sawa">Šawā</placeName>, maybe
                                        corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName>.</desc>
                                    <q xml:lang="it">proviene dalla chiesa di Arbambà (Scioa)</q>
                                </item>
                                <item xml:id="e1">
                                    <locus target="#1 #2 #35v #55va #78v #79 #80"/>
                                    <desc>Numerous graffiti and pen trials in ink, black or violet pencil.</desc>
                                </item>
                                <item xml:id="e2">
                                    <locus target="#1r"/>
                                    <desc type="StampExlibris">Ex libris of <persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName>.</desc>
                                </item>
                                <item xml:id="e3">
                                    <locus target="#80r"/>
                                    <desc>Note in pencil by the scribe, who was probably the scribe of the manuscript.</desc>
                                    <q xml:lang="gez">ጸሐፊሁ፡ 
                                        <persName role="scribe" ref="https://betamasaheft.eu/PRS15421HabtaGabr">ሃ<supplied reason="omitted" resp="PRS8999Strelcyn">ብ</supplied>ተገብርኤል፡</persName></q>
                                </item>
                            </list>
                        </additions>
