                    <history>
                        <origin><persName ref="https://betamasaheft.eu/PRS5712JohnXVI"><roleName type="office">Patriarch</roleName> Yoḥannǝs</persName>,
                            who held office from 1727 to 1745 and 
                            <persName ref="https://betamasaheft.eu/PRS6072Krestodo"><roleName type="title">Metropolitan</roleName> Krǝstodolu III</persName>
                            (<foreign xml:lang="gez">ክርስተዶሉ፡</foreign>), who held office from 1720 to 1735, are mentioned on 
                            <locus target="#62v"/>, which allows to assume that the manuscript was produced 
                            <origDate notBefore="1727" notAfter="1735">between 1727 and 1735 A.D.</origDate>
                        </origin>
                        <provenance>The manuscript came from a church in ‘Arbambà’ in <placeName ref="https://betamasaheft.eu/LOC5597Sawa">Šawā</placeName>, possibly
                            corresponding to <placeName ref="https://betamasaheft.eu/LOC1516ArbaAm">Arba Amba</placeName> (see <ref target="#e1"/>). 
                            It was either acquired by <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>) or sent to him after his return to Europe.
                        </provenance>
                    </history>
