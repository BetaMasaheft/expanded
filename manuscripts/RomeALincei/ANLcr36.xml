                        <additions>
                            <list>
                                <item xml:id="a1">
                                    <locus target="#1r"/>
                                    <desc type="MagicText">Protective recipes in Amharic for horses
                                        and humans.</desc>
                                    <q xml:lang="am"><seg part="I">ለመ<supplied reason="omitted">ድ</supplied>ኃኒት፡ ለዓይነ፡ ሕማም፡ ለፈረስ፡
                                        <gap reason="ellipsis"/> ቁርጸት፡ <gap reason="ellipsis"/> እስኪቱ፡ ለሞተበት፡</seg></q>
                                </item>
                                
                                <item xml:id="a2">
                                    <locus target="#122va"/>
                                    <desc type="MagicText">Two protective prayers against <foreign xml:lang="gez">wǝgʿat</foreign>.</desc>
                                    <q xml:lang="gez"><seg part="I">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ <supplied reason="omitted">ቀዱስ፡</supplied> በል፡
                                        ጸሎት፡ በእንተ፡ ሕማመ፡ ውግዓት፡
                                        ዲዳ፡ ወሪዳ፡</seg></q>
                                </item>
                                
                                <item xml:id="e1">
                                    <desc>The main owner was <persName role="owner" ref="https://betamasaheft.eu/PRS15011AsmaG">ʾAṣma Giyorgis</persName>. Two
                                        other men, <persName ref="https://betamasaheft.eu/PRS15012WaldaA">Walda ʾAragāwi</persName> and <persName ref="https://betamasaheft.eu/PRS15013ZawaldaM">Zawalda Māryām</persName>, are
                                        named with him (see <locus target="#117rb"/>).</desc>
                                </item>
                                
                                <item xml:id="e2">
