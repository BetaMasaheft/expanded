                    <msPart xml:id="p1">
                        <msIdentifier/>
                        <msContents><summary/>
                        <msItem xml:id="p1_i1">
                            <locus from="3ra" to="9r"/>
                            <title ref="https://betamasaheft.eu/LIT1716Kidanz">Kidān za-nagh</title>
                            <incipit xml:lang="gez">ኪዳን፡ ዘመሐሮሙ፡ እግዚእነ፡ ለአርዳኢሁ፡ እምድኅረ፡ ትንሣኤሁ፡ ቅዱስ፡ እግዚአብሔር፡ ቅዱስ፡ ኃያል፡ ቅዱስ፡ ሕያው፡ 
                                ዘኢይመውት፡ ዘተወልደ፡ እማርያም፡ እምቅድስት፡ ድንግል፡ ተሣሃለነ፡ እግዚኦ። ቅዱስ፡ እግዚአብሔር፡</incipit>
                        </msItem>
                        </msContents>
                        <physDesc>
                            <objectDesc form="Codex">
                                <supportDesc>
                                    <support><material key="parchment"/></support>
                                    <extent>
                                        <measure unit="leaf" quantity="10">10</measure>
                                        <measure unit="page" type="blank">6</measure><locus from="1v" to="2v"/><locus from="9v" to="10v"/>
                                        <dimensions type="outer" unit="mm">
                                            <height unit="mm">180</height>
                                            <width unit="mm">130</width>
                                        </dimensions><dimensions subtype="computed" unit="mm" type="outer"><height quantity="180" unit="mm"/><width quantity="130" unit="mm"/></dimensions>
                                    </extent>
                                    <collation>Two endleaves (<locus target="#1 #2"/> and one quaternion <locus from="3" to="10"/>.</collation>
                                    <condition key="good"/>
                                </supportDesc> 
                            </objectDesc>  
                            <handDesc>
                                <handNote xml:id="h1" script="Ethiopic"> 
                                    <seg type="script">Nineteenth or twentieth-century script.</seg>
                                    <desc>Written by the same copier as the other part (<persName ref="https://betamasaheft.eu/PRS15382WaldaIya">Walda ʾIyasus</persName>,
                                        who is mentioned on <locus target="#54"/>). However his handwriting is slightly larger and thicker than
                                        <ref target="#h2"/>.</desc>
                                    <seg type="ink">Black, red.</seg>
                                </handNote>
                            </handDesc>
                            <additions>
                                <list>
                                    <item xml:id="e2">
                                        <desc>Pen trials.</desc>
                                    </item>
                                </list>
                            </additions>
                        </physDesc>
                        <history>
                            <origin>Since the copier is mentioned by the same name <persName ref="https://betamasaheft.eu/PRS15382WaldaIya">Walda ʾIyasus</persName>. The same
                                name appears as copier for <ref target="#p2"/>. It is therefore likely, that both codicological units have been produced 
                                by the same copier around the same time, i.e.
                                <origDate notBefore="1875" notAfter="1925">the end of the nineteenth or beginning of the twentieth century</origDate>.
                            </origin>
                        </history>
