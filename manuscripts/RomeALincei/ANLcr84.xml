                        <msContents><summary/>
                            <msItem xml:id="p2_i1">
                                <title ref="https://betamasaheft.eu/LIT1482GadlaM">Gadla Mātyās za-ʿAddǝqe</title>
                                <msItem xml:id="p2_i1.1">
                                    <locus from="20r" to="29v"/>
                                    <title ref="https://betamasaheft.eu/LIT1482GadlaM#Life">Gadla Mātyās za-ʿAddǝqe:  Life</title>
                                    <note>Copied from a manuscript, which was kept at the church of Šǝmāgǝlle in Ḥamāsen, as it is indicated in the
                                        inscribed title. The text is printed as a facsimile and translated into Italian by Paolo Marrassini in
                                        <bibl corresp="http://zotero.org/groups/358366/items/GUADDBUS"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Marrassini1983Matyas"/><title level="a">Il &lt;hi rend="italics"&gt;Gadla Mātyās&lt;/hi&gt;</title><title level="j">Egitto e Vicino Oriente</title><author><forename>Paolo</forename><surname>Marrassini</surname></author><date>1983</date><biblScope unit="volume">6</biblScope><biblScope unit="page">247–307</biblScope><note type="url">https://www.jstor.org/stable/24232660</note><note type="tags"><note type="tag">Hagiography, Ethiopian</note><note type="tag">bm:Marrassini1983Matyas</note></note><note type="tag">Hagiography, Ethiopian</note><note type="tag">bm:Marrassini1983Matyas</note></bibl>.</note>
                                    <textLang mainLang="gez"/>
                                    <incipit type="inscriptio" xml:lang="gez"><locus target="#20r"/>ገድለ፡ አባ፡ ማትያስ፡ ዘዓድቄ፡ ዘጽሑፍ፡ በመጽሐፈ፡ ቤተ፡ ክርስቲያን፡ 
                                        ዘሀገረ፡ ሽማግሌ፡ በሐማሴን።</incipit>
                                    <incipit xml:lang="gez"><locus target="#21r"/>በስመ፡ <gap reason="ellipsis"/> ንወጥን፡ በረድኤተ፡ እግዚአብሔር፡ ጽሒፈ፡ ገድሉ፡
                                        ለአቡነ፡ ማትያስ፡ ዘአድቄ፡ ዘአዕረፈ፡ አመ፡ ፳ወ፩ ለግንቦት። በሥምረተ፡ ሥሉስ፡ ቅዱስ፡ እንዘ፡ ፩፫ ወእንዘ፡ ፫፩ እሙንቱ፡ አበ፡ እቄድስ፡ 
                                        ወእሴ<supplied reason="omitted" resp="PRS8999Strelcyn"/>ብሕ። ወእምቅድመ፡ ዓለም፡ ወእስከ፡ ለዓለም፡ መንግሥቱ። 
                                        <gap reason="ellipsis"/><pb n="21v"/><gap reason="ellipsis"/> በስመ፡ <gap reason="ellipsis"/> ወከመዝ፡ ውእቱ፡ ጥንተ፡
                                        ሙላዱ፡ ለአቡነ፡ ማትያስ፡ ወቀዳሜ፡ ስሙ፡ ጥሪተ፡ እግዚእ።</incipit>
                                </msItem> 
                                <msItem xml:id="p2_i1.2">
                                    <locus from="29v" to="33v"/>
                                    <title ref="https://betamasaheft.eu/LIT1482GadlaM#Miracles">Gadla Mātyās za-ʿAddǝqe:  Miracles</title>
                                    <textLang mainLang="gez"/>
                                    <msItem xml:id="p2_i1.2.1">
                                        <locus from="29v"/>
                                        <title ref="https://betamasaheft.eu/LIT1482GadlaM#Healing">Gadla Mātyās za-ʿAddǝqe:  Healing</title> 
                                        <incipit xml:lang="gez">ተአምሪሁ፡ ለአቡነ፡ ማትያስ፡ <gap reason="ellipsis"/> ወነበረ፡ ፩ ብእሲ፡ ዘስሙ፡ ከንቲባ፡ ተክለ፡ ጽዮን፡ ኀበ፡ አኃቲ፡ ሀገር፡ ዘትሰመይ፡
                                            ፃዕዳ፡ ዘጋ፡ ወነበሩ፡ እንዘ፡ የኃዝኑ፡ በእንተ፡ ዘአልቦሙ፡ ውሉድ። ወመጽአ፡ ምስለ፡ ብእሲቱ<supplied reason="omitted">፡</supplied> አመ፡ ፳ሁ፡ ለግንቦት፡
                                            ወሰአሉ፡ ኀበ፡ እግዝእትነ፡ ማርያም፡</incipit>
                                    </msItem>
                                    <msItem xml:id="p2_i1.2.2">
                                        <locus from="30r"/>
