                    <msContents>
                        <summary/>
                        
                        <msItem xml:id="ms_i1">
                            <title type="complete" ref="https://betamasaheft.eu/LIT5920JohnBeg">Beginning of the Gospel of John</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                በስመ፡ <gap reason="ellipsis"/> ቀዳሚሁ፡ ቃል፡ ውእቱ፡ <gap reason="ellipsis"/> ኢይረክብዎ፡ 
                                ወኢይቀርብዎ፡ ኀበ፡ ነፍሱ፡ ወስጋሁ፡ ለገብርከ፡ <space reason="owner"/>
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i2">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7582PPPsalm">Za-yaḫaddǝr ba-radʾeta lǝʿul...</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                ዘየሐድር፡ በረድኤተ፡ ልዑል፡ ወይነብር፡ ውስተ፡ ጽላሎቱ፡ ለአምላከ፡ ሰማይ፡ እብሎ፡ ለእግዚአብሔር፡ ምስዋርየ፡ ወጸወንየ፡ አንተ፡ አምላኪየ፡ 
                                ወረዳእየ፡ ወእትዌከል፡ ቦቱ፡ እስመ፡ ውእቱ፡ ይበልሐኒ፡ እመሥገርት፡ ነዓዊት፡ ወእምነገር፡ መደንግፅ፡
                            </incipit>
                        </msItem>
                        
                        <msItem xml:id="ms_i3">
                            <title type="complete" ref="https://betamasaheft.eu/LIT7583PPVarious">Protective prayer against various diseases and demons</title>
                            <textLang mainLang="gez"/>
                            <incipit xml:lang="gez">
                                አህያ፡ ሻራህያ፡ <gap reason="ellipsis"/> አጽራዕ፡ ግብሮ፡ <supplied reason="omitted">ለ</supplied>ዲያብሎስ፡ 
                                ከ<supplied reason="omitted">ማሁ፡ አ</supplied>ጽራዕ፡ ህማመ፡ <supplied reason="omitted">ባ</supplied>ርያ፡
                                ወሌጌዎን፡ <supplied reason="omitted">ደ</supplied>ስክ፡ ወጉዳሌ፡ 
                                <supplied reason="omitted">ነ</supplied>ገርጋር፡ ትግር<supplied reason="omitted">ዳ፡</supplied> ፌራ፡ 
                                ወንዳድ፡ ተላወሽ፡ ወጉስ<supplied reason="omitted">ም</supplied>ት፡ ፍልፀት፡
                                ወ<supplied reason="omitted">ቍ</supplied>ርጸት፡ ውግዓ<supplied reason="omitted">ት</supplied>፡
                                ወቁርጥማት፡ ወኵሉ፡ ግብ<supplied reason="omitted">ረ</supplied>፡ ሥራይ፡
                                ከመ<supplied reason="omitted">፡</supplied> ኢይቅ<supplied reason="omitted">ረ</supplied>ቡ፡ ኀበ፡ ነፍሱ፡
                                ወስ<supplied reason="omitted">ጋ</supplied>ሁ፡ ለገብርከ፡ <space reason="owner"/>
                            </incipit>
                        </msItem>
                        
                    </msContents>
                    
                    <physDesc>
                        <objectDesc form="Scroll">
                            <supportDesc>
                                <support>
                                    <material key="parchment"/>
                                </support>
                                <extent>
                                    <note>Probably consists of <measure unit="strips">1</measure>
                                        strip, though the catalogue does not explicitly mention this.</note>
                                    <dimensions type="outer" unit="mm">
                                        <height>800</height>
                                        <width>45</width>
                                    </dimensions>
                                </extent>
                                <condition key="deficient">The state of preservation of the
                                    manuscript is bad. It had been worn as an amulet on the body; it has large stains of sweat
                                and its margins are damaged by rodents. The last lines, which had
                                constituted a further prayer, are illegible.</condition>
                            </supportDesc>
                        </objectDesc>
                        
                        <handDesc>
                            <handNote xml:id="h1" script="Ethiopic">
                                <desc>Regular hand.</desc>
                                <seg type="ink">Black, red.</seg>
                                <date notBefore="1800" notAfter="1899"/>
                            </handNote>                  
                        </handDesc>
                        
                        <decoDesc>
                            <decoNote xml:id="d1" type="drawing" corresp="#pic1">
                                <desc>Two rudimentary <term key="MagicDrawing" ana="#MagicDrawing">protective
                                    pictures</term> at the beginning and end of the scroll.</desc>
                            </decoNote>
                        </decoDesc>
                        
                        <additions>
                            <list>
                                <item xml:id="e1">
                                    <desc>The name of the original owner was <persName role="owner" ref="https://betamasaheft.eu/PRS15006GabraM">Gabra Mikāʾel</persName>.
                                        At the end of <ref target="#ms_i3"/>, his name has been
                                        replaced with that of <persName role="owner" ref="https://betamasaheft.eu/PRS15007Sinoda">Sinodā</persName>.</desc>
                                </item>
                                
                                <item xml:id="e2">
                                    <desc>Note in ink on the verso of the scroll (presumably by
                                        <persName ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName>), stating
                                        that the manuscript came from the store room of <placeName ref="https://betamasaheft.eu/INS0105DD">Dabra Dāmmo ʾAbuna ʾAragāwi</placeName>.</desc>
                                    <q xml:lang="it">Dal ripostiglio di
                                        Dabra Dammò</q>
                                </item>
                                
                                <item xml:id="e3">
                                    <desc type="StampExlibris">On the verso of the scroll.</desc>
                                    <q xml:lang="la">Ex libris <persName ref="https://betamasaheft.eu/PRS3182ContiRo">CCR</persName></q>
                                </item>
                            </list>
                        </additions>
                    </physDesc>
                    
                    <history>
                        <origin>
                       <origDate notBefore="1800" notAfter="1899" evidence="lettering"/>
                        </origin>
                        <provenance>The manuscript was acquired from <placeName ref="https://betamasaheft.eu/INS0105DD">Dabra Dāmmo ʾAbuna ʾAragāwi</placeName> (see
                            <ref target="#e2"/>), either by 
                            <persName role="owner" ref="https://betamasaheft.eu/PRS3182ContiRo">Carlo Conti Rossini</persName> 
                            during his stay in <placeName ref="https://betamasaheft.eu/LOC2991Eritre">Eritrea</placeName>
                            (<date notBefore="1899" notAfter="1903">1899–1903</date>) or sent to him after his return to Europe.</provenance>
                        <acquisition>The manuscript passed into the possession of the library in <date when="1950">1950</date>,
                            following Conti Rossini’s death in <date when="1949">1949</date> 
                            (see <ref target="https://www.menestrel.fr/?-Roma-&amp;lang=fr#845">Menestrel</ref>).</acquisition>
                    </history>
                    
