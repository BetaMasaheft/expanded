                     <textLang mainLang="gez">Gǝ'ǝz</textLang>
                  </msItem>
                  <msItem xml:id="ms_i3">
                     <locus from="56r" to="76r" facs="056"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2807RepCh91">used during Passion week, arranged
                        for the hours of the day</title>
                     <textLang mainLang="gez">Gǝ'ǝz</textLang>
                  </msItem>
