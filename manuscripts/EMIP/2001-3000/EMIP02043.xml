                    <msItem xml:id="ms_i3.7">
                        <locus from="32r" facs="036"/>
                      <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer of the Archangel Afnin</title>
