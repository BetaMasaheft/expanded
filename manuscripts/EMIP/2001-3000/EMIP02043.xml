                  <msItem xml:id="ms_i4">
                     <locus from="32r" to="33r" facs="036"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT2388Taamme">Taʾammǝra Śǝllāse</title>
                     <note>one miracle</note>
                  </msItem>
                  <msItem xml:id="ms_i5">
                     <locus from="33r" facs="037"/>
                    <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer for Sending away and Binding a demon</title>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡  <gap reason="omitted"/> በጁሐም፡ ድግርትያ፡ ተሰደዱ፡ በሾሐል፡ ድግርትያ፡ ተአሠሩ፡ ሎኤ፫፡</incipit>
                  </msItem>
                  <msItem xml:id="ms_i6">
                     <locus from="33r" to="33v" facs="037"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2755RepCh39">Malkǝʾ-hymn to the guardian angel</title>
                     <incipit xml:lang="gez">ሰላም፡ ለከ፡ መልአከ፡ ዑቃቤ፡ ቃውም፡</incipit>
                  </msItem>
                  <msItem xml:id="ms_i7">
                     <locus from="33v" to="34v" facs="038"/>
                    <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer to lure a lover, <foreign xml:lang="gez">ጸሎት፡ በእንተ፡ መስተፋቅር፡</foreign>
                     </title>
                  </msItem>
                  <msItem xml:id="ms_i8">
                     <locus from="34v" facs="039"/>
                    <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer against Evil Eye and Epilepsy, <foreign xml:lang="gez">ጸሎት፡ በእንተ፡ ዓይነት፡ ባሪያ፡ ገርጋሪ፡</foreign>
                     </title>
                     <incipit xml:lang="gez">ጸሎት፡ በእንተ፡ ዓይነት፡ ባሪያ፡ ገርጋሪ፡ ካፍ፡ ካፍ፡ ካፍ፡ ካፍ፡ ካፍ፡ ካፍ፡ ካፍ፡ ላፍ፡ ላፍ፡ ላፍ፡ ላፍ፡ <gap reason="omitted"/>
                     </incipit>
                  </msItem>
                  <msItem xml:id="ms_i9">
                     <locus from="34v" to="36r" facs="039"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer to weaken the power of kings</title>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡  <gap reason="omitted"/> ጸሎት፡ በእንተ፡ ዘያደክም፡ ኃይለ፡ ነገሥት፡ <gap reason="omitted"/> በረድኤተ፡ ፀብዕ፡ ወኵናት፡ አድርስ፡ ኵናተ፡ አረሚ፡ ጠቅልል፡ ከመ፡ ቈርበት፡ ይህፈር፡ ወኢይሰርር፡  <gap reason="omitted"/>
                     </incipit>
                  </msItem>
                  <msItem xml:id="ms_i10">
                     <locus from="36r" to="36v" facs="040"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer">ʾAsmāt-prayer (general record)</title>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡  <gap reason="omitted"/> ጸሎት፡ በእንተ አቃቤ፡ ርእስ፡ ዘወሃቦሙ፡ እግዚአብሔር፡ ለሄኖክ፡ ወለዕዝራ፡ ወኤልያስ፡ ከመ፡ ያምስጡ፡ እምገፀ፡ ሞት፡  <gap reason="omitted"/>
                     </incipit>
                  </msItem>
                  <msItem xml:id="ms_i11">
                     <locus from="36v" facs="041"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT3085RepCh365">Malkǝʾa Rāguʾel</title>
                     <note>excerpt</note>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡  <gap reason="omitted"/> ጸሎት፡ በእንተ፡ መስደዴሆሙ፡ ለአጋንንት ወሰይጣናት፡ እጼውዕ፡ ስመከ፡ ወእኤምኃከ፡ በተድላ፡ ራጕኤል፡ መልአክ፡ ለዓለም፡ መስተበቅላ፡ <gap reason="omitted"/>
                     </incipit>
                  </msItem>
                  <msItem xml:id="ms_i12">
                     <locus from="36v" to="40r" facs="041"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT3034RepCh314">Lǝssāna sabʾ</title>
                     <incipit xml:lang="gez">በስመ፡ አብ፡ ወወልድ፡  <gap reason="omitted"/> ጸሎት፡ በእንተ፡ ልሳነ፡ ስብእ፡ ምቀኛ፡ ወተንኰለኛ፡ እደ፡ ሰብእ፡ ቡዳ፡ ወኵሎሙ፡ አጋንንት፡ ዕቀበኒ፡  <gap reason="omitted"/> ናሁ፡ ተማኅፀንኩ፡ በኆኅተ፡ ስምከ፡ ካፍ፡  <gap reason="omitted"/>
                     </incipit>
                  </msItem>
                  <msItem xml:id="ms_i13">
                     <locus from="40r" facs="044"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2300Sebhat">Sǝbḥata fǝqur</title>
                     <incipit xml:lang="gez">ሰላም፡ ለከ፡ ሊቀ፡ መላእክት፡ ገብርኤል፡ ዘተልዕከ፡ በልዕልና፡</incipit>
                  </msItem>
