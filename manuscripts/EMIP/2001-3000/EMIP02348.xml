                  <additions>
                    <list>
                      <item xml:id="e1"><desc><locus target="#ir #iv" facs="001 002"/>Blank</desc></item>
                      <item xml:id="e2"><desc><locus target="#15v #16r" facs="017"/>Spaces for the names of the patriarchs left blank</desc></item>
                      <item xml:id="a1"><desc><locus target="#18v" facs="020"/>Mentions <persName ref="https://betamasaheft.eu/PRS8388SalamaI">Salāmā III</persName></desc></item>
                      <item xml:id="a2"><desc><locus target="#20r" facs="021"/>Mentions Wäldä ʾƎsraʿel (<foreign xml:lang="gez">ወልደ፡ እስራኤል፡</foreign>)</desc></item>
                      <item xml:id="a3"><desc><locus target="#22r" facs="023"/>Mentions Wäldä Maryam (<foreign xml:lang="gez">ወልደ፡ ማርያም፡</foreign>) and Wäldä ʾƎsraʿel (<foreign xml:lang="gez">ወልደ፡ እስራኤል፡</foreign>)</desc></item>
                      <item xml:id="a4"><desc><locus target="#31v" facs="033"/>Mentions Wäldä ʾÄbsabyos (<foreign xml:lang="gez">ወልደ፡ አብሳብዮስ፡</foreign>) and Wäldä Maryam (<foreign xml:lang="gez">ወልደ፡ ማርያም፡</foreign>)</desc></item>
                      <item xml:id="a5"><desc><locus target="#31v #32r" facs="033"/>Mentions  <persName ref="https://betamasaheft.eu/PRS3258CyrilIV">Cyril IV</persName> and <persName ref="https://betamasaheft.eu/PRS8388SalamaI">Salāmā III</persName></desc></item>
                      <item xml:id="e3"><desc><locus target="#33v" facs="035"/>Space for the name of the king is left blank</desc></item>
                      <item xml:id="a6"><desc><locus target="#38r" facs="039"/>A prayer for Gäbrä Hana (<foreign xml:lang="gez">ገብረ፡ ሃና፡</foreign>), ʾÄskalä Gäbrǝʾel (<foreign xml:lang="gez">አስካለ፡ ገብርኤል፡</foreign>), Wäldä ʾÄbsabyos, and Wäldä ʾƎsraʿel.</desc></item>
                      <item xml:id="a7"><desc><locus target="#43r" facs="044"/>Mentions Wäldä ʾƎsraʿel and ʾÄskalä Gäbrǝʾel.</desc></item>
                      <item xml:id="a8"><desc><locus target="#43v #45r" facs="045 046"/>Mentions Wäldä ʾÄbsabyos and his beloved Wäldä ʾƎsraʿel and his brother ʾÄskalä Gäbrǝʾel</desc></item>
                      <item xml:id="a9"><desc type="ScribalSignature"><locus target="#45r" facs="046"/>Mentions the scribe Wäldä Maryam (<foreign xml:lang="gez">ወልደ፡ ማርያም፡</foreign>)</desc></item>
                      <item xml:id="a10"><desc><locus target="#49r" facs="050"/>Contains a list of names of people who prayed the prayer.</desc></item>
                      <item xml:id="e4"><desc><locus target="#38 #42" facs="039 043"/>Navigation system: white string sewn into fore edge</desc></item>
                      <item xml:id="e5"><desc>Numbered quire 2–5.</desc></item>
                      <item xml:id="e6"><desc>
                        Scribal intervention:
                        words of text are written interlinearly, <locus target="#1v #4r #5r #9v #21v" facs="003 005 006 011 023"/>, etc.;
                        text has been removed, <locus target="#20v #35v #36r" facs="022 037"/></desc></item>
