                   </msItem>
                 <msItem xml:id="ms_i2"><locus from="48r" to="49r" facs="050"/><title type="incomplete" ref="https://betamasaheft.eu/LIT7863SalamMikael">Salām laka Mikāʾel malʾak mǝkru la-lǝʿul</title>
                     	  <textLang mainLang="gez"/>
                      <incipit xml:lang="gez">ሰአል፡ ሚካኤል፡ አስተምር፡ ለነ፡</incipit>
                      <note>Continuation from <ref target="#ms_i6"/> on <locus target="#90r" facs="092"/>.</note>
                    </msItem>
                      <msItem xml:id="ms_i3"><locus from="50r" to="75r" facs="052"/><title type="complete" ref="https://betamasaheft.eu/LIT2509Weddas">Wǝddāse Māryām</title>
                        <textLang mainLang="gez"/>
                      <incipit xml:lang="gez">እግዝእትየ፡ ፍትሕኒ፡ እማዕሰሩ፡ ለሰይጣን፡ እሙ፡ ለመድኅን፡ ወለተ፡ ብርሃን። ፈቀደ፡ እግዚእ፡ ያግዕዞ፡ ለአዳም፡ <gap reason="omitted"/></incipit>                    </msItem>
                      	<msItem xml:id="ms_i4"><locus from="75r" to="85r" facs="077"/><title type="complete" ref="https://betamasaheft.eu/LIT1113Anqasa">ʾAnqaṣa bǝrhān</title>
                        <textLang mainLang="gez"/>
                      </msItem>
                        <msItem xml:id="ms_i5"><locus from="85r" to="85r" facs="087"/><title type="complete" ref="https://betamasaheft.eu/LIT3108RepCh388">Yǝweddǝsǝwwa malāʾǝkt la-Māryām</title>
                          <textLang mainLang="gez"/>
                      </msItem>
                        <msItem xml:id="ms_i6"><locus from="85v" to="90r" facs="088"/><title type="incomplete" ref="https://betamasaheft.eu/LIT7863SalamMikael">Salām laka Mikāʾel malʾak mǝkru la-lǝʿul</title>
                          <note>With some interpolations from <ref type="work" corresp="https://betamasaheft.eu/LIT7864HymnGabriel">ʾAstamhǝr lana Gabrǝʾel</ref> and continued in 
                            <ref target="#ms_i2"/> on <locus from="48r" to="49r" facs="050"/>.</note>
                          <textLang mainLang="gez"/>
                          <incipit xml:lang="gez">መልአከ፡ ምክሩ፡ ለቃል፡ ሚካኤል፡ ፫ጊዜ፡ ሰአል፡ ለነ፡ ሚካኤል፡ ፫ጊዜ፡ አስተምህር፡ ለነ፡ ገብ<supplied reason="omitted">ር</supplied>ኤል፡ ሚካኤ<supplied reason="omitted">ል</supplied>፡ መጋቢ፡ ለነፍሰ፡ ኵሉ፡ ፍጥረት፡ <gap reason="omitted"/></incipit>
                      </msItem>
