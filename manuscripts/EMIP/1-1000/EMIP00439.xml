                  <msItem xml:id="ms_i1"><locus from="1r" to="17r" facs="002"/><title type="complete" ref="https://betamasaheft.eu/LIT2444Temher">Tǝmhǝrta ḫǝbuʾāt</title>
                  <textLang mainLang="gez">Gǝ‘ǝz</textLang>
                  </msItem>
                  <msItem xml:id="ms_i2"><locus from="17r" to="18r" facs="018"/><title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer"> Asmat Prayer of the Archangel Mika’el</title>
                  <textLang mainLang="gez">Gǝ‘ǝz</textLang>
                  <note>which is written on his left and right wings. Often included in Derana Michael in the month of Ḫǝdar</note>
                  </msItem>
                  <msItem xml:id="ms_i3"><locus from="18v" to="23r" facs="020"/><title type="complete" ref="https://betamasaheft.eu/LIT5888AsmatPrayer"> Asmat prayer against evil eye and demons</title>
                  <textLang mainLang="gez">Gǝ‘ǝz</textLang>
                  <note>written in red ink by a different hand</note>
                  </msItem>
