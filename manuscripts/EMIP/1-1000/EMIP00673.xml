               <msContents>
                  <summary>Asmat prayer of Peter and of the Disciples and others, arranged for the days of the week</summary>
                  <msItem xml:id="ms_i1">
                    <locus from="1r" to="38v" facs="004"/>
                    <textLang mainLang="gez"/>
                    <title type="incomplete" ref="https://betamasaheft.eu/LIT4668Prayer">Ṣalotu la-Ṗeṭros</title>
                    <textLang mainLang="gez"/>
                  <msItem xml:id="ms_i1.1"><locus from="1r" to="1v" facs="004"/><title>Introduction</title>
                  <textLang mainLang="gez"/>
                  <note>incomplete at the beginning</note>
                  </msItem>
                    <msItem xml:id="ms_i1.2"><locus from="1v" to="5v" facs="005"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Monday">For Monday: ʾAsmāt-prayer of Peter</title>
                      <incipit xml:lang="gez">በስመ፡ አብ፡ <gap reason="omitted"/>  ጸሎቱ፡ ለጴጥሮስ፡ ዝውእቱ፡ ዘየዓቢ፡ እምሐዋርያቲሁ፡ ዘኃረዮ፡ ክርስቶስ፡ እምቅድመ፡ ኵሎሙ፡ ሐዋርያቲሁ፡ ለኢየሱስ፡ ክርስቶስ፡ ወልደ፡ እግዚአብሔር፡ ሕያው። ወጸውዖሙ፡ ለኵሎሙ፡ ሐዋርያቲሁ፡ ወነበረ፡ ምስሌሆሙ፡ <gap reason="omitted"/></incipit>
                  </msItem>
                    <msItem xml:id="ms_i1.3"><locus from="5v" to="10v" facs="009"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Tuesday">For Tuesday: ʾAsmāt-prayer of Melkezedeq</title>
                  </msItem>
                    <msItem xml:id="ms_i1.4"><locus from="10v" to="13v" facs="014"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Wednesday">For Wednesday: ʾAsmāt-prayer of Thomas</title> 
                  </msItem>
                    <msItem xml:id="ms_i1.5"><locus from="14r" to="20v" facs="017"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Thursday">For Thursday: ʾAsmāt-prayer given from the angels to the Disciples</title>
                  </msItem>
                    <msItem xml:id="ms_i1.6"><locus from="20v" to="25r" facs="024"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Friday">For Friday: ʾAsmāt-prayer of the Disciples</title> 
                  </msItem>
                    <msItem xml:id="ms_i1.7"><locus from="25r" to="29v" facs="028"/><title ref="https://betamasaheft.eu/LIT4668Prayer#Saturday">For Saturday: Prayer of the Disciples for forgiveness of sins</title>
                      <incipit xml:lang="gez" type="inscriptio">ጸሎተ፡ ስርየተ፡ ኃጢአት፡</incipit>
                  </msItem>
                  <msItem xml:id="ms_i1.8"><locus from="30r" to="35r" facs="033"/><title> Asmat-prayer of the three Israelite Children</title>
                  </msItem>
                    <msItem xml:id="ms_i1.9">
                      <locus from="35v" to="38v" facs="039"/>
                      <title ref="https://betamasaheft.eu/LIT4668Prayer#Daily">Daily ʾAsmāt-prayer: ‘I beseech You lest I die early’</title>
                      <incipit xml:lang="gez">በስመ፡ አብ፡<gap reason="omitted"/> ተማኅፀንኩ፡ ከመ፡ ኢይሙት፡ ዘእንበለ፡ ጊዜየ፡ ከመ፡ ሠራቂ፡ ሌሊት፡ ወከመ፡ ቀታሊ፡ 
                        መዓልት፡ በመንግሥተ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ <gap reason="omitted"/></incipit>
                  </msItem>
                </msItem>
