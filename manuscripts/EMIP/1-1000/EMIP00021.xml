                  <decoDesc>
                    <decoNote type="miniature" xml:id="d1">
                      <locus target="#Inside front cover" facs="001"/>
                      <desc>Crude drawing in pencil</desc>
                    </decoNote>
                    <decoNote type="miniature" xml:id="d2">
                      <locus target="#Inside back cover" facs="033"/>
                      <desc>Crude drawing of talisman face</desc>
                    </decoNote>
                    <decoNote type="frame" xml:id="d3">
                      <desc>Decorative designs: <locus target="#1r #2v" facs="001 003"/> (<foreign xml:lang="gez">ሐረግ፡</foreign> using black and red)</desc>
                    </decoNote>
                  </decoDesc>
                  <additions>
                    <list>
                        <item xml:id="e1">
                          <locus target="#3v #4r" facs="004"/>
                           <desc>Practice on how to write a letter</desc>
                        </item>
                        <item xml:id="a2">
                          <locus target="#13v #14r #14v #15r #15v #16r" facs="014 015 016"/>
                           <desc type="GuestText">Isolated sentence from <title type="incomplete" ref="https://betamasaheft.eu/LIT2362Songof#Chp1">Song of Songs:  Chp1</title></desc>
                        </item>
                        <item xml:id="a3">
                          <locus target="#32r" facs="032"/>
                           <desc type="GuestText">Words and sentences copied from <title type="incomplete" ref="https://betamasaheft.eu/LIT2509Weddas">Wǝddāse Māryām</title>, in crude hands
                        </desc>
                        </item>
                        <item xml:id="e2">
                          <locus target="#10r #16r #23r" facs="010 016 023"/>
                           <desc>Overlooked words of text are written interlinearly</desc>
                        </item>
                        <item xml:id="e3">
                        <desc>Rebound in some disorder. The general condition of the vellum is dirty</desc>
                      </item>
                        <item xml:id="e4">
                           <locus target="#32v" facs="033"/>
                              <desc>blank</desc>
                      </item>
                    </list>
                  </additions>
                  <bindingDesc>
                    <binding xml:id="binding" contemporary="false">
                        <decoNote xml:id="b1">Rebound, attached to rough-hewn boards both of which have been broken about 2–3 cm from the spine and the outer portion of the covers have been replaced with rough-hewn boards but with grain going perpendicular to the grain of the original boards.</decoNote>
                        <decoNote xml:id="b2" type="bindingMaterial">
                           <material key="wood"/>
                        </decoNote>
                    </binding>
