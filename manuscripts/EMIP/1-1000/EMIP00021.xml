                    <locus from="1r" to="20v" facs="001"/>
                    <title type="complete" ref="https://betamasaheft.eu/LIT2509Weddas">Wǝddāse Māryām</title>
                  </msItem>
                  <msItem xml:id="ms_i2">
                     <locus from="20v" to="27v" facs="021"/>
