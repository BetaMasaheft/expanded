               <msContents>
                  <summary>Gospel of John, Anaphora of Our Lady Mary</summary>
                  <msItem xml:id="ms_i1"><locus from="1r" to="84r" facs="001"/><title type="complete" ref="https://betamasaheft.eu/LIT1693John"> Arranged with chapter numbers. The <foreign xml:lang="gez">መልዓ</foreign> is at <locus target="#84r" facs="084"/></title>
                  <textLang mainLang="gez">Gǝ'ǝz</textLang>
                </msItem>
                  <msItem xml:id="ms_i2"><locus from="85r" to="101v" facs="085"/><title type="complete" ref="https://betamasaheft.eu/LIT1099Anapho">ʾAkkʷateta qʷǝrbān za-qǝddus Hǝryāqos za-hagara Bǝhnǝsā</title>
                  <textLang mainLang="gez">Gǝ'ǝz</textLang>
                </msItem>
                  <msItem xml:id="ms_i3"><locus from="102r" to="103v" facs="102"/><title>Fragment of an unidentified work, incomplete at the beginning and end</title>
                  <textLang mainLang="gez">Gǝ'ǝz</textLang>
                </msItem>
               </msContents>
