                       <decoDesc>
                           <decoNote type="drawing" xml:id="d1">
                               <locus target="#1r"/>
                               <desc>A fine drawings of the Crucifix, the name of the painter, Tadlā,
                                   is possibly mentioned in the caption</desc>
                           </decoNote>      
                           
                           <decoNote type="drawing" xml:id="d2">
                               <locus target="#4v"/>
                               <desc>Fine drawings of <ref type="authFile" corresp="https://betamasaheft.eu/AT1012Equestrian">St George slaying the dragon</ref>, 
                                   <ref type="authFile" corresp="https://betamasaheft.eu/AT1042HagiographicScene">Takla Hāymānot with wings standing on one leg </ref>, 
                                   and a donor lying beneath,  identified by the legend as Gabra Mikāʾel</desc>
                           </decoNote>                                  

                               <decoNote type="miniature" xml:id="d3">
                                   <locus target="#4v"/>
                                   <desc>A fine miniature of <ref type="authFile" corresp="https://betamasaheft.eu/AT1031VirginAndChil">the Virgin with Child</ref>, and two angels standing, on a piece of 
                                   modern paper (?) protected by a textile curtains</desc>
                               </decoNote>  
     
                           <decoNote type="Headband" xml:id="d4">    
                               <locus target="#5r"/>
                               <desc>A fine ornamental band, here and at the incipits of other texts</desc>
                           </decoNote>  
                       
                       <decoNote type="miniature" xml:id="d5">                   
                           <desc>A fine miniature of the Virgin with Child, with two angels behind, St Ephrem the Syrian (?) and a donor
                               around, on the folium before the incipit page of the Wǝddāse Māryām</desc>
                       </decoNote>                             
                           
                           <decoNote type="drawing" xml:id="d6">                   
                               <desc>A fine drawing of a complex composition, which shows the Saviour enthroned, with the Virgin on his side, 
                                   judging the souls (?). The donor (identified as Gabra Śǝllāse) is depicted lying beneath. 
                                   around</desc>
                           </decoNote>                             
                            </decoDesc>
                       
                       
                       <additions>
                           <list>
                               <item xml:id="a1">
                                   <locus target="#1v"/>
                                   <desc type="MagicText">A short text with ʾasmāt</desc>                                   
                               </item>                                                 
                               <item xml:id="a2">
                                   <locus target="#1v"/>
                                   <desc type="ProtectivePrayer">A prayer protecting against wild anymals ʾasmāt</desc>  
                                   <q xml:lang="gez">ጸሎት፡ ዘመስተኃድርት፡ 
                                       ትሌክን፡ ቁቈራን፡ ይምጻእ፡ በሳላሙ፡ ላእሌነ፡ በዝ፡ ገጹ፡ በወናግድ፡ በብርክ፡ <gap reason="omitted" resp="DN"/></q>
                               </item>   
                               
                               <item xml:id="a3">       
                                   <locus from="1v" to="4v"/>
                                   <desc type="GuestText"><title type="complete" ref="https://betamasaheft.eu/LIT2260salota">Ṣalota kidān</title></desc>
                                     </item>
                               <item xml:id="a4">       
                                   <locus target="#4v"/>
                                   <desc type="Unclear">A poorly readable note, referring to the binder of the manuscript</desc>
                               </item>
                               
                               <item xml:id="a5">       
                           <desc type="Unclear">A list of episodes from the Bible where someone is saved by God 
                               (Noah from the flood, Israel from the Pharaoh etc.)</desc>
                               </item>
                               
                                
                               
                               
                               <item xml:id="v1">
                                   <locus target="#1r"/>
                                   <desc type="StampExlibris">Shelfmarks, the title of the books, stickers with unclear
                                       indications on the first leaf and on the inner side of the back board</desc>                                   
                               </item> 
                               
                               <item xml:id="v2">
                                   <locus target="#1r"/>
                                   <desc type="Unclear">Scribbles, poorly readable crude minor writings on many folia</desc>                                   
                               </item> 
                           </list>
                       </additions>
                       
                   
                       
