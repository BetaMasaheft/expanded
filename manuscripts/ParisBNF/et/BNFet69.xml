      <t:body>
         <t:div type="edition" xml:id="div1BNFet69">
            <t:div type="textpart" subtype="stanza" xml:id="Stanza6" xml:lang="gez" corresp="https://betamasaheft.eu/BNFet69#ms_i9">
               <t:ab>
                  <t:lb n="1"/>ስብሐት፡ ለከ፡ ከመ፡ ንንግር፡ ኵሎ፡ ስብሐተ።
        <t:lb n="2"/>በአናቅጺሃ፡ ለጽዮን፡ ማኅደረ፡ ብዙኅ፡ ሰላም።
        <t:lb n="3"/>ዘአንቃሕከነ፡ እምነ፡ ንዋም።
        <t:lb n="4"/>ኢየሱስ፡ ወልደ፡ ማርያም።
        </t:ab>
            </t:div>
         </t:div>
      </t:body>
  </t:text></TEI>