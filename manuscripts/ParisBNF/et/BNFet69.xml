               <msContents>
                  <summary/> 
         
                  <msItem xml:id="ms_i1">
                     <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1716Kidanz">ኪዳን፡ ዘነግህ።</title> 
                     <textLang mainLang="gez"/>
                  </msItem>
                
                  <msItem xml:id="ms_i2">
                     <locus from="14v"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2444Temher">Tǝmhǝrta ḫǝbuʾāt</title>
                     <textLang mainLang="gez"/>
                  </msItem>
                
                  <msItem xml:id="ms_i3">
                     <locus from="21v"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2993RepCh274">Ba-sǝma ʾƎgziʾabǝḥer qadāmāwi za-ʾǝnbala tǝmālǝm</title>
                     <textLang mainLang="gez"/>
                     <incipit xml:lang="gez">በስመ፡ እግዚአብሔር፡ ቀዳማዊ፡ ዘእንበለ፡ ትማልም፡ ወማዕከላዊ፡ ዘእንበለ፡ ዮም፡
                ወደኃራዊ፡ ዘእንበለ፡ ጌሠም።</incipit>
                  </msItem>
  
                  <msItem xml:id="ms_i4">
                     <locus from="25r"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT3083RepCh363">ʾƎgziʾabǝḥer za-bǝrhānāt ʾǝgziʾabǝḥer za-śǝlṭānāt</title>
                     <textLang mainLang="gez"/>
                  </msItem>
            
                  <msItem xml:id="ms_i5">
                     <locus from="28r"/>
                     <title type="complete" xml:lang="gez" ref="https://betamasaheft.eu/LIT1100Anapho">አኰቴተ፡ ቍርባን፡
                ዘእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</title>
                     <textLang mainLang="gez"/>
                     <note>This version differs from the one in <ref type="mss" corresp="https://betamasaheft.eu/BNFet68#ms_i6.2">Paris, Bibliothèque nationale de France, BnF Éthiopien 68: ʾAkkʷateta qʷǝrbān za-ʾǝgziʾǝna ʾIyasus Krǝstos (in ms_i6.2)</ref>
                and <ref type="mss" corresp="https://betamasaheft.eu/BNFet67#ms_i4.9">Paris, Bibliothèque nationale de France, BnF Éthiopien 67: Maṣḥafa qǝddāse: Anaphora by John
        Chrysostom (in ms_i4.9)</ref>
                as well as from the printed editions
                <bibl>
                           <ptr target="bm:Petrus1548Test"/>
                           <citedRange unit="page">168</citedRange>
                        </bibl>; 
                <bibl>
                           <ptr target="bm:Rodwell1863Liturgies"/>
                           <citedRange unit="page">118–122</citedRange>
                        </bibl> and 
                <bibl>
                           <ptr target="bm:Ludolf1691Commentarius"/>
                           <citedRange unit="page">341–345</citedRange>
                        </bibl>.</note>
                  </msItem>
            
                  <msItem xml:id="ms_i6">
                     <locus from="39r"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2839RepCh123">Malkǝʾa ʾIyasus</title>
                     <textLang mainLang="gez"/>
                     <note>There are 50 stanzas, the following is the first:</note>
                     <incipit xml:lang="gez">
                        <lb n="1"/>
                        <choice>
                           <sic resp="DR">ሰለም፡</sic>
                           <corr resp="DR">ሰላም፡</corr>
                        </choice> ለዝክረ፡ ስምከ፡ ስመ፡ መሐላ፡ ዘኢይሔሱ፡
                <lb n="2"/> ዘአንበረ፡ ቅድመ፡ እግዚአብሔር፡ በአትሮንሱ።
                <lb n="3"/> ኢየሱስ፡ ክርስቶስ፡ ለዳዊት፡ ባሕርየ፡ ከርሱ።
                <lb n="4"/>አክሊለ፡ ስምከ፡ እንዘ፡ ይትቄጸል፡ በርእሱ።
                <lb n="5"/> አኅጉረ፡ ፀር፡ ወረሰ፡ ኢያሱ።
              </incipit>
                  </msItem>
            
                  <msItem xml:id="ms_i7">
                     <locus from="54r"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2891RepCh172">Malkǝʾa Māryām</title>
                     <textLang mainLang="gez"/>
                     <note>There are 57 stanzas, the following is the first:</note>
                     <incipit xml:lang="gez">
                        <lb n="1"/>ሰላም፡ ሰላም፡ ለዝክረ፡ ስምኪ፡ ሐዋዝ፡
                <lb n="2"/> እምነ፡ ከልበኔ፡ ወቍስጥ፡ ወእምነ፡ ሰንበልት፡ ምዑዝ፡
                <lb n="3"/> ማርያም፡ ድንግል፡ ለባሲተ፡ ዓቢይ፡ ትእዛዝ፡
                <lb n="4"/> ይስቅየኒ፡ ለለጽባሑ፡ ወይነ፡ ፍቅርኪ፡ አዚዝ።
                <lb n="5"/>   ከመ፡ ይሰቅዩ፡ ውኂዝ፡ 
                <lb n="6"/>  ለሠናይ፡ ዓርዝ።
              </incipit>
                  </msItem>
            
                  <msItem xml:id="ms_i8">
                     <locus from="70r"/>
                     <title type="incomplete" ref="https://betamasaheft.eu/LIT2835RepCh119">Malkǝʾa Mikāʾel</title>
                     <textLang mainLang="gez"/>
                     <note>The end is missing. There are 40 stanzas, 
                the following is the first:</note>
                     <incipit xml:lang="gez">
                        <lb n="1"/>ሰላም፡ ለዝክረ፡ ስምከ፡ ምስለ፡ ስመ፡ ልዑል፡ ዘተሳተፈ።
                <lb n="2"/> ወልደ፡ ያሬድ፡ ሄኖክ፡ በከመ፡ ጸሐፈ።
                <lb n="3"/> ሶበ፡ እጼውዕ፡ ስመከ፡ ከሢትየ፡ አፈ።
                <lb n="4"/>ረዳኤ፡ ምንዱባን፡ ሚካኤል፡ በከመ፡ ታለምድ፡ ዘልፈ።
                <lb n="5"/>ለረዲኦትየ፡ ነዓ፡ ሰፊሐከ፡ ክንፈ።  
              </incipit>
                  </msItem>
            
                  <msItem xml:id="ms_i9">
                     <locus from="80r"/>
                     <title type="complete" ref="https://betamasaheft.eu/LIT2807RepCh91">Malkǝʾ-hymn to Our Lady Mary</title>
                     <textLang mainLang="gez"/>
                     <incipit xml:lang="gez"> 
                        <lb n="1"/>ሰላም፡ ለኪ፡ ማርያም፡ ድንግል፡
                <lb n="2"/> ዘመዓዛ፡ አፉኪ፡ ኮል።
                <lb n="3"/>  እንተ፡ ትጼንዊ፡ በገዳም፡ ወሐቅል።
                <lb n="4"/>ወልታ፡ ረዲኦትየ፡ በውስተ፡ ቀትል።
              </incipit>
                     <note>From the sixth stanza on, the praises are addressed to Jesus Christ, see also <ref target="#Stanza6"/>.</note>
                  </msItem>
            
               </msContents>
          
