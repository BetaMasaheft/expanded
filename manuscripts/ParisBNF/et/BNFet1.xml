                  <additions>
                     <list>
                        <item xml:id="a1" rend="marginal">
                           <date when="1680-09-18"/>
                           <desc type="Record">Note at the end of the volume about some manuscripts which 
                              <persName ref="https://betamasaheft.eu/PRS10789Picques">Louis Picques</persName> saw in the library of 
                              <persName ref="https://betamasaheft.eu/PRS3150Colbert">Charles Colbert</persName>,
                              among them the Bible of <persName ref="https://betamasaheft.eu/PRS10790Charles">Charles</persName>, etc.</desc>
                           <q xml:lang="fr" cert="high"/>    
                        </item>
                    
                        <item xml:id="a2" rend="marginal">
                           <desc type="Correction">Many grammatical and orthographical corrections of the copy written by <persName ref="https://betamasaheft.eu/PRS6378Ludolf">Hiob Ludolf</persName> in red.
                           </desc>
                           <q xml:lang="gez" cert="high"/>      
                        </item>
                
                        <item xml:id="a3" rend="marginal">
                           <desc type="Comment">Notes by <persName ref="https://betamasaheft.eu/PRS6378Ludolf">Hiob Ludolf</persName> indicating lacunae of the Ethiopic version</desc>
                           <q xml:lang="gez" cert="high"/>      
                        </item>
                
                        <item xml:id="a4" rend="marginal" cert="low">
                           <locus target="#1" cert="low"/>
                           <desc type="Comment">Note by <persName ref="https://betamasaheft.eu/PRS6378Ludolf">Hiob Ludolf</persName>. 
                              Cp. <ref type="mss" corresp="https://betamasaheft.eu/BNFet154#a1">Paris, Bibliothèque nationale de France, BnF Éthiopien 154:   additio a1</ref> and 
                              <bibl>
                                 <ptr target="bm:Ludolf1691Commentarius"/>
                                 <citedRange unit="page">295–297</citedRange>
                              </bibl>.
                           </desc>
                           <q xml:lang="la">Nota bene : Quandoquidem diu satis, multumque animum meum
                              torserit  ex quanam lingua, quoue interprete, Bibliae aethiopiae factae sint, tandem, 
                              sint gratiae diuinae misericordiae, reperi in Martyrologio aethiopico manuscripto, 
                              quod asseruatur in Bibliotheca <persName ref="https://betamasaheft.eu/PRS8700Seguier">
                                 <certainty locus="value" match="../@ref" cert="low"/>Cancellarii Franciae</persName>, claris verbis, quod eas 
                              <persName ref="https://betamasaheft.eu/PRS8387SalamaI">Aba Salama</persName>, apostolus Aethiopum, ex arabico 
                              traduxerit: cujus uerba integre hic 
                              adscribam: <date>20 Augusti</date>: 
                              <foreign xml:lang="gez">ሰላም፡ ለአባ፡ <persName ref="https://betamasaheft.eu/PRS8387SalamaI">ሰላማ</persName>
                                 <gap reason="omitted" extent="unknown" resp="PRS10747Zotenbe"/>
                              </foreign>
                           </q>       
                        </item>
                    
                        <item xml:id="a5" rend="marginal">
                           <desc type="Gloss">Notes and glosses by <persName ref="https://betamasaheft.eu/PRS10789Picques">Louis Picques</persName>
                              as well as some variants and translations of rubrics. </desc>
                           <q xml:lang="grc"/>
                           <q xml:lang="he"/> 
                           <q xml:lang="ar"/>
                           <q xml:lang="cop"/>   
                        </item>
                
                        <item xml:id="a6" rend="marginal">
                           <desc type="Unclear">Several notes by <persName ref="https://betamasaheft.eu/PRS10036Wansleb">Johann-Michael Wansleben</persName> 
                           </desc>
                           <q xml:lang="gez"/>
                           <q xml:lang="la" cert="high"/>
                        </item>
                  
                        <item xml:id="a7">
                           <desc type="Unclear">Several ecclesiastical lessons both marginal and in the body of the
                              text as described in <bibl> 
                                 <ptr target="bm:Dillmann1853Octateuch"/> 
                                 <citedRange unit="page">164</citedRange>
                              </bibl>
                           </desc>
                           <q xml:lang="gez"/>
                        </item>
                     </list>
                  </additions>
