                  <additions>
                     <list>
                        <item xml:id="a1">
                           <desc type="PurchaseNote"/>
                           <q xml:lang="gez">ለዛቲ፡ መጽሐፍ፡ ዘተሣየጣ፡ <persName ref="https://betamasaheft.eu/PRS11161AsanaG">ዓሣዕነ፡
                                 ጊዮርጊስ፡</persName> በ<persName ref="https://betamasaheft.eu/PRS11164SaggaM">ጸጋ፡
                                 ማርያም፡</persName> ይጽሐፍ፡ ስሞ፡ <gap reason="omitted" extent="unknown" resp="PRS10747Zotenbe"/>
                           </q>
                        </item>

                        <item xml:id="a2">
                           <desc type="DonationNote">Note stating that <persName ref="https://betamasaheft.eu/PRS11161AsanaG">ʿAśāʿna Giyorgis</persName> donated the manuscript to <persName ref="https://betamasaheft.eu/PRS11162TersitaW">Tǝrsita Wald</persName>, whose name is also written at several
                              other places.</desc>
                           <q xml:lang="gez">እግዚአብሔር፡ አብ፡ የሀቦ፡ ለ<persName ref="https://betamasaheft.eu/PRS11161AsanaG">አሥኣነ፡
                                 ጊዮርጊስ፡</persName> ዘወሀበኒ፡ ዘንተ፡ ኦርጋኖን፡ ለአነ፡ <persName ref="https://betamasaheft.eu/PRS11162TersitaW">ትርሲተ፡ ወ</persName>
                              <gap reason="omitted" extent="unknown" resp="PRS10747Zotenbe"/>
                           </q>
                        </item>

                        <item xml:id="a3">
                           <locus target="#190rb"/>
                           <desc type="Record">Note written at the beginning of the manuscript by
                                 <persName ref="https://betamasaheft.eu/PRS11165Roger">Eugène Roger</persName>.</desc>
                           <q xml:lang="fr">Je eut ce liure, en langue et caractère aethiopien, de
                                 <persName ref="https://betamasaheft.eu/PRS8324saggaKr">Zaga Christ</persName>, prince
                                 d'<placeName ref="https://betamasaheft.eu/LOC3010Ethiop">Aethiopie</placeName>, filz du
                                 <persName ref="https://betamasaheft.eu/PRS7943Prester">preste Jehan</persName>, nomé Jacob,
                              lequel <persName ref="https://betamasaheft.eu/PRS8324saggaKr">Zaga Christ</persName> je vis
                              conuerty à nostre s<hi rend="apices">te</hi> foy par le Père <persName ref="https://betamasaheft.eu/PRS11163Vendosme">Jacques de Vendosme</persName>, Recolet à
                                 <placeName ref="https://betamasaheft.eu/LOC4977Nazare">Nazareth</placeName>, le jour de
                                    <date>S<hi rend="apices">t</hi> Pierre 1632</date>. Ledict
                                 <persName ref="https://betamasaheft.eu/PRS8324saggaKr">Zaga Christ</persName> est mort à
                                 <placeName ref="https://betamasaheft.eu/LOC5386RueilM">Ruel</placeName> le <date>vint
                                 deusiesme d'Apuril 1638</date>, et est ensépulteré dans la paroise
                              deuant la chaise du curé. Frère <persName ref="https://betamasaheft.eu/PRS11165Roger">Eugène
                                 Roger</persName>.</q>
                           <listBibl type="secondary">
                              <bibl>
                                 <ptr target="bm:Ludolf1681Historia"/>
                                 <citedRange unit="volume">2</citedRange>
                                 <citedRange unit="part">7</citedRange>
                                 <citedRange unit="page">53</citedRange>
                              </bibl>
                              <bibl>
