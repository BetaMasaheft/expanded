                                              <history>
                                                 <origin>
                                                    <origDate when="1847">1847</origDate>
                                                    According to <bibl><ptr target="bm:Abbadie1859Cat"/></bibl>, the text <ref target="#ms_i1"/>
                                                  was copied at Gʷalʿā (near <placeName ref="https://betamasaheft.eu/INS0161BGY">Golʿa Dabra Bǝrhān Yoḥannǝs</placeName>)
                                                  on paper, for <persName role="bequeather" ref="https://betamasaheft.eu/PRS1071dAbbadi">Antoine d’Abbadie [d’Arrast]</persName>,
                                                  at the Catholic mission administered by
                                                  <persName ref="https://betamasaheft.eu/PRS3451DeJacob">Giustino De Jacobis</persName>, from
                                                  an exemplar manuscript that came from <placeName ref="https://betamasaheft.eu/INS0005Gund">Gunda Gunde</placeName>
                                                  and was presumably dated to <date>1538</date>.
                                                  That manuscript has not been identified yet (possibly lost; it is thought to be
                                                   different from a copy of the same text, <ref type="work" corresp="https://betamasaheft.eu/LIT1594Shephe">Shepherd of Hermas</ref>,
                                                   acquired at <placeName ref="https://betamasaheft.eu/INS0005Gund">Gunda Gunde</placeName>
                                                   later by <persName ref="https://betamasaheft.eu/PRS7165Mordini">A. Mordini</persName>).
                                                 </origin>
                                                 <acquisition>The manuscript entered the <placeName ref="https://betamasaheft.eu/INS0303BNF">Bibliothèque
                                               nationale de France</placeName> in
                                               <date>1902</date>.
                                               </acquisition>
                                              </history>

