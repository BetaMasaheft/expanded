<msContents>
    <summary/>
    <msItem xml:id="ms_i1">
        <title ref="https://betamasaheft.eu/LIT4031EgziabeherN">ʾƎgziʾabǝḥer nagśa (Zarʾa Yāʿqob)</title>
        <textLang mainLang="gez"/>
        <incipit xml:lang="gez"><hi rend="rubric">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ፩ አምላክ፡ ጸሐፍነ፡ በዘንዜከር፡ እግዚአብሔር፡ ዘነ</hi>ግሠ፡ ዘአስተጋብአ፡ ፩ካህን፡ ከመ፡ ይንግር፡ ዜናሆሙ፡ ለእለ፡ አሥመርዎ፡ በንጽሕ፡ ለመድኃኒነ።</incipit>
        
        
        
         
        
        
    </msItem>
    <msItem xml:id="ms_i2">
        <title ref="https://betamasaheft.eu/LIT1326egziab">ʾƎgziʾabǝḥer nagśa za-ʿĀrke</title>
        <textLang mainLang="gez"/>
    </msItem>
    <msItem xml:id="ms_i3">
           <locus from="222r"/>
        <title ref="https://betamasaheft.eu/LIT2741RepCh25">Malkǝʾa ḥǝmāmāta masqal</title>
        <textLang mainLang="gez"/>
    </msItem>
    <msItem xml:id="ms_i4">
        <locus from="226r"/>
        <title ref="https://betamasaheft.eu/LIT7584TaameraMah">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa'</title>
        <textLang mainLang="gez"/>
        <msItem xml:id="ms_i4.1">
            <locus target="#226r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Introduction">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Introduction</title>
        <incipit xml:lang="gez">ንጽሕፍ፡ ኃይለ፡ ወተአምረ፡ ዘኮነ፡ በማኅሌተ፡ እግዚአብሔር፡ ነግሠ። በረከተ፡ እግዚአብሔር፡ አምላክነ፡ ንጉሠ፡ ነገሥት፡ ወእግዚአ፡ አጋዕዝት፡ የሀሉ፡ ምስለ፡ ኵልነ፡ ውሉደ፡ ጥምቅት፡ ለዓለመ፡ ዓለም፡ አሜን።
       </incipit>
        </msItem>
        <msItem xml:id="ms_i4.2">
            <locus from="226r" to="227r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle1">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': First miracle</title>
            <incipit xml:lang="gez"><supplied reason="subaudible" resp="AD">፩ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡</supplied> ወሀሎ፡ ፩ብእሲ፡ ቅሲስ፡ ዓቢይ፡ ሊቀ፡ ካህናት፡ እምዓበይተ፡ ሰብአ፡ ኢትዮጵያ፡ ዘያፈቅር፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወኢያጸርዕ፡ ባቲ፡ ዘምሮ፡ መዓልተ፡ ወሌሊተ፡</incipit>
        </msItem>
        <msItem xml:id="ms_i4.3">
            <locus from="227r" to="228r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle2">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Second miracle</title>
            <incipit xml:lang="gez">፪ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ይቤ፡ ፩ብእሲ፡ ቀሲስ፡ መነኮስ፡ እንዘ፡ ይነግራ፡ ዕበያ፡ ወክብራ፡ ለማኅሌተ፡ እግዚአብሔር፡ ነግሠ። ወሶበ፡ ኮነ፡ ሕማመ፡ ብድብድ፡ አዘዘ፡ ንጉሥ፡ ከመ፡ ይትመሐለሉ፡ በተቀንዮ፡ እግዚአብሔር፡ ነግሠ።</incipit>   </msItem>
        <msItem xml:id="ms_i4.4">
            <locus from="228v" to="229r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle3">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Third miracle</title>
            <incipit xml:lang="gez">፫ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ስምዓ፡ ኮነ፡ ፩ዲያቆን፡ ምሉዓ፡ ልቡና፡ ወጥበብ፡ ወምሉዓ፡ መንፈስ፡ የዋህ፡ ወትሑት፡ ወይቤ፡ እንዘ፡ ሀሎኩ፡ አሐተ፡ ዕለተ፡ ውስተ፡ ቤተ፡ ክርስቲያን፡ አመ፡ ፳ወ፩ለጥር፡ በዕለተ፡ በዓላ፡ ለእግዝእትነ፡ ማርያም፡</incipit>
        </msItem>
        <msItem xml:id="ms_i4.5">
            <locus from="229r" to="229v"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle4">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Fourth miracle</title>
            <incipit xml:lang="gez">፬ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ስምዓ፡ ኮነ፡ ፩መነኮስ፡ በእንተ፡ ዕበያ፡ ወክብራ፡ ለማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወይቤ፡ እንዘ፡ ሀሎኩ፡ በኀዘነ፡ ልብ፡ በእንተ፡ ሕማመ፡ ብድብድ፡ ዘኮነ፡ በውእቱ፡ ጊዜ።</incipit></msItem>
        <msItem xml:id="ms_i4.6">
            <locus target="#229v"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle5">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Fifth miracle</title>
            <incipit xml:lang="gez">፭ተኣምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ይቤ፡ ፩እምካህናት፡ ወእንዘ፡ ንትቀነይ፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወሶበ፡ በጻሕነ፡ ኀበ፡ ውዳሴ፡ ለአባ፡ ሲኖዳ፡ ርእሰ፡ መነኮሳት፡ ነሥአኒ፡ ንስቲት፡ ንዋም፡</incipit></msItem>
        <msItem xml:id="ms_i4.7">
            <locus from="229v" to="230r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle6">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Sixth miracle</title>
            <incipit xml:lang="gez">፮ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ይቤ፡ ፩እምካህናት፡ ወእንዘ፡ ይትቀነዩ፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ አስተርአየኒ፡ ቀስተ፡ ደመና፡ ብሩህ፡ መልዕልተ፡ ርእሶሙ፡ ለካህናት።</incipit></msItem>
        <msItem xml:id="ms_i4.8">
            <locus from="230r" to="230v"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle7">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Seventh miracle</title>
            <incipit xml:lang="gez">፯ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ይቤ፡ ፩ካህን፡ ዓቢይ፡ ወእንዘ፡ ሀሎኩ፡ ውስተ፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ በእንተ፡ ሕማመ፡ ብድብድ። ከመ፡ ያዕትት፡ እግዚአብሔር፡</incipit></msItem>
        <msItem xml:id="ms_i4.9">
            <locus target="#230v"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle8">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Eigth miracle</title>
            <incipit xml:lang="gez">፰ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ርኢኩ፡ በአሐቲ፡ ሌሊት፡ እንዘ፡ እትቀነይ፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ በቤተ፡ ክርስቲያን፡ ምስለ፡ ካህናት፡ እንዘ፡ ይቀውም፡ ማእከሌነ፡ ፩ብእሲ፡ ዘይለብስ፡ ብርሃነ።</incipit></msItem>
        <msItem xml:id="ms_i4.10">
            <locus from="230v" to="231v"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle9">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Ninth miracle</title>
            <incipit xml:lang="gez">፱ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ስምዑ፡ ንነግረክሙ፡ ተአምሪሁ፡ ለማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ዘአርአዮ፡ እግዚአብሔር፡ ለ፩ብእሲ፡ ወውእቱ፡ ጥቀ፡ ያፈቅሮ፡ ለማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡</incipit></msItem>
        <msItem xml:id="ms_i4.11">
            <locus from="231v" to="233r"/>
            <title type="complete" ref="https://betamasaheft.eu/LIT7584TaameraMah#Miracle10">Miracles of the Hymn 'ʾƎgziʾabǝḥer nagśa': Tenth miracle</title>
            <incipit xml:lang="gez">፲ተአምር፡ ዘማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወካዕበ፡ ስምዑ፡ ንንግርክሙ፡ ተአምሪሃ፡ ለእግዝእትነ፡ ድንግል፡ በ፪ኤ፡፡ [fol. 232r] ማርያም፡ ዘገብረት፡ ተአምረ፡ ወመንክረ፡ በማኅሌተ፡ እግዚአብሔር፡ ነግሠ። ወሀሎ፡ ፩ብእሲ፡ ዘያፈቅር፡ ማኅሌተ፡ እግዚአብሔር፡ ነግሠ፡ ወሀሎ፡ ዘያነብብ፡ ለለዕለቱ፡</incipit>
        </msItem>
         </msItem>
