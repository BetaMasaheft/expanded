         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2978RepCh259">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ሥላሴ፨</t:l>
                  <t:l n="2">እዌጥን፡ ዘዚአክሙ፡ ውዳሴ፨</t:l>
                  <t:l n="3">ተፈሥሑ፡ ብየ፡ ማኅበረ፡ ነቢያት፡ እለ፡ ሙሴ፨</t:l>
                  <t:l n="4">ከመ፡ ትትፌሣሕ፡ ብእሲት፡ ዘይከውና፡ ወራሴ፨</t:l>
                  <t:l n="5">ሶበ፡ በዓለም፡ አጥረየት፡ ወወደት፡ ብእሴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">እመሰ፡ ይትከሀለኒ፡ ፍጻሜ፨</t:l>
                  <t:l n="2">ውዳሴክሙ፡ ወጠንኩ፡ ለዓለመ፡ ዓለም፡ ቀዋሜ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ነቢያት፡ ንግሩኒ፡ ወመሐሩኒ፡ ትርጓሜ፨</t:l>
                  <t:l n="4">ኢየኀሥሥ፡ እንበሌክሙ፡ ወኢይሰአል፡ ሐላሜ፨</t:l>
                  <t:l n="5">ለእመ፡ መዋዕል፡ ኀለፈ፡ ወጐንደየ፡ ዕድሜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ በመጽሐፈ፡ ሕይወት፡ ዘይሄሉ፨</t:l>
                  <t:l n="2">ድኅረ፡ ዓለማት፡ ወዘውስቴቶሙ፡ ኵሉ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ነቢያት፡ ጽሑፋን፡ ለእግዚአብሔር፡ በቃሉ፨</t:l>
                  <t:l n="4">ከመ፡ ትጽብኡ፡ ጸላእትየ፡ ወዕድዋንየ፡ ትትትሉ፨</t:l>
                  <t:l n="5">ጽንዑ፡ እምአንበሳ፡ ወእምድብ፡ ኀይሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ሰላም፡ ለመቃብሪክሙ፡ እለ፡ ኮኖሆን፡ አብያተ፨</t:l>
                  <t:l n="2">ለበድነ፡ ሥጋክሙ፡ ሕሩም፡ ዘእምዕፄያት፨</t:l>
                  <t:l n="3">ውዳሴክሙ፡ ፈጸምኩ፡ ማኅበረ፡ ክርስቶስ፡ ነቢያት፨</t:l>
                  <t:l n="4">ጸግዉኒ፡ ንዋየ፡ ጽድቅ፡ በዘዚአክሙ፡ ሠናይት፨</t:l>
                  <t:l n="5">ዘመስጠቶ፡ ኢይክል፡ ዲያብሎስ፡ ፈያት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="54">
                  <t:l n="1">ምንትኑ፡ እምዐሠይክዎ፡ ዕሤተ፨</t:l>
                  <t:l n="2">ለብእሲተ፡ ኤንዶር፡ ጠባብ፡ እንተ፡ ታነሥእ፡ ዘሞተ፨</t:l>
                  <t:l n="3">በኅቡእ፡ ዘይከውን፡ ወዘይትገበር፡ ክሡተ፨</t:l>
                  <t:l n="4">ይዜንወኒ፡ ምሥጢረ፡ ወይንግረኒ፡ ትንቢተ፨</t:l>
                  <t:l n="5">አሐደ፡ እምነቢያት፡ ከመ፡ ታንቅሕ፡ ሊተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="55">
                  <t:l n="1">በእግዚአብሔር፡ አምላክ፡ እንዘ፡ እፀንስ፡ ኅሊና፨</t:l>
                  <t:l n="2">ለልሳንየ፡ እምሐቌሁ፡ ወለከናፍርየ፡ እማሕፀና፨</t:l>
                  <t:l n="3">ናሁ፡ ወለድኩ፡ ዘማኅበረ፡ ነቢያት፡ ዜና፨</t:l>
                  <t:l n="4">ለወላድ፡ ብእሲት፡ እምድኅረ፡ ወሊድ፡ ስእና፨</t:l>
                  <t:l n="5">ከመ፡ ወለደቶ፡ ለሳሙኤል፡ ሐና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="56">
                  <t:l n="1">እምዝንቱ፡ ቃለ፡ መጽሐፍክሙ፡ ዘአሰሰለ፡ ሐአሐተ፨</t:l>
                  <t:l n="2">እንዘ፡ ትትቤ፡ ተልዎ፡ ነቢያት፡ ወትትመዐዑ፡ መዐተ፨</t:l>
                  <t:l n="3">አሰስልዎ፡ እምዕፀ፡ ሕይወት፡ ወረስይዎ፡ እቱተ፨</t:l>
                  <t:l n="4">ወለእመ፡ ቦቱ፡ ወሰከ፡ ንስትአ፨</t:l>
                  <t:l n="5">እግዚአብሔር፡ ላዕሌሁ፡ ይወስክ፡ መቅሠፍተ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>         
      </t:body>
