      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><t:forename>Augustine</t:forename><t:surname>Dickinson</t:surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note></t:bibl>
               <t:bibl corresp="http://zotero.org/groups/358366/items/7WA33SUX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Chaine1913Rep"/><title level="a">Répertoire des Salam et Malkeʾe contenus dans les manuscrits éthiopiens des bibliothèques d’Europe</title><title level="j">Revue de l’Orient Chrétien</title><author><t:forename>Marius</t:forename><t:surname>Chaîne</t:surname></author><date>1913</date><biblScope unit="volume">18</biblScope><biblScope unit="issue">2 and 18/4 (Deuxième série, 8/2 and 8/4)</biblScope><biblScope unit="page">183–203 and 337–357</biblScope><note type="url">http://catholicapedia.net/Documents/Revue-de-l.Orient-chretien/18-1913_revue-de-l.orient-ch_paris.pdf</note><t:citedRange unit="item">169</t:citedRange></t:bibl>
            </t:listBibl>
         </t:div>
         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ገብረ፡ ኢየሱስ፡ ብሂል፨</t:l>
                  <t:l n="2">ወለሥእርተ፡ ርእስከ፡ ጸሊም፡ ዘቈናዝዒሁ፡ ፍቱል፨</t:l>
                  <t:l n="3">መርቆሬዎስ፡ ሰማዕት፡ ገባሬ፡ ተአምር፡ ወኃይል፨</t:l>
                  <t:l n="4">ለዮሐንስ፡ ፍና፡ ድኂን፡ ከመ፡ መራሕኮ፡ በሐቅል፨</t:l>
                  <t:l n="5">መርሐኒ፡ ለወልድከ፡ ፍና፡ ጽድቅ፡ ወሣህል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ምስለ፡ ገጽከ፡ በአኅብሮ፨</t:l>
                  <t:l n="2">ቅድመ፡ ገጸ፡ መምህር፡ ባስልዮስ፡ ዘአድነነ፡ ለተናግሮ፨</t:l>
                  <t:l n="3">መርቆሬዎስ፡ ሰማዕት፡ ምሉዓ፡ ጥበብ፡ ወአእምሮ፨</t:l>
                  <t:l n="4">ጹረኒ፡ በፈረስከ፡ ወሰውረኒ፡ ሰውሮ፨</t:l>
                  <t:l n="5">እምገጸ፡ ዓለም፡ ዘይከብድ፡ ጾሮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ ለህላዌከ፡ መካኑ፨</t:l>
                  <t:l n="2">ወለሥጋከ፡ ቀይጠኑ፨</t:l>
                  <t:l n="3">መርቆሬዎስ፡ ከማከ፡ ኢተንሥአ፡ በበ፡ ዘመኑ፨</t:l>
                  <t:l n="4">መኑ፡ መኑ፡ ዘይትማስለከ፡ መኑ፨</t:l>
                  <t:l n="5">እንበለ፡ ጊዮርጊስ፡ ሰማዕት፡ ዘአዳም፡ ሥኑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">እምተአምሪከ፡ አሐዱ፡ ስእለ፡ ዚአከ፡ ኀበ፡ ሀሎ፨</t:l>
                  <t:l n="2">መምህር፡ ባስዮስ፡ ለእግዚአብሔር፡ ሶበ፡ ሰቀሎ፨</t:l>
                  <t:l n="3">ለጎልያኖስ፡ ዕልው፡ እንዘ፡ ግብረ፡ ፀብዕ፡ ይመስሎ፨</t:l>
                  <t:l n="4">ዝኩ፡ ሥዕልከ፡ በገሐድ፡ በኴናተ፡ በቅል፡ ቀተሎ፨</t:l>
                  <t:l n="5">እስከ፡ ሥልጣኖ፡ አግሃደ፡ ወአርአየ፡ ኀይሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ካልዕ፡ ተአምሪከ፡ ዕፁብ፡ ወመድምም፨</t:l>
                  <t:l n="2">ሶበ፡ ስመከ፡ ጸውዓ፡ በውሳጤ፡ መፍርህ፡ ገዳም፨</t:l>
                  <t:l n="3">አሐዱ፡ ወሬዛ፡ ዘቤተ፡ ሙላዱ፡ መስጥም፨</t:l>
                  <t:l n="4">መርቆሬዎስ፡ በከመ፡ ጾርኮ፡ በፈረስከ፡ ጸሊም፨</t:l>
                  <t:l n="5">ይጹረኒ፡ ረድኤትከ፡ ለብእሲ፡ ድኵም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሣልስ፡ ተአምሪከ፡ ለፈረስከ፡ በአምሳሉ፨</t:l>
                  <t:l n="2">ፍቁራኒከ፡ ለዝክር፡ እምድኅረ፡ ሰአሉ፨</t:l>
                  <t:l n="3">መርቆሬዎስ፡ ሰማዕት፡ ለክርስቶስ፡ መልአከ፡ ኃይሉ፨</t:l>
                  <t:l n="4">ሐንጸፍጸፍከ፡ ሐፍ፡ ከመ፡ ማይ፡ እስከነ፡ ርኅሰ፡ አባሉ፨</t:l>
                  <t:l n="5">ከመ፡ ጎልያኖስ፡ ሞተ፡ ወሕዝቡ፡ ተኃጕሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ተዘኪረከ፡ ክርስቶስ፡ ፍቅረ፡ ዚአየ፡ ለአብድ፨</t:l>
                  <t:l n="2">ከመ፡ አፍቀሮሙ፡ ጥቀ፡ ለዘዚአከ፡ ነገድ፨</t:l>
                  <t:l n="3">ሞገሰ፡ ስም፡ ሀበኒ፡ በዘይመጽእ፡ ትውልድ፨</t:l>
                  <t:l n="4">ነፍስየ፡ ለተቤዝዎ፡ እንዘ፡ ይእኅዝ፡ በእድ፨</t:l>
                  <t:l n="5">መርቆሬዎስ፡ ያርብሐዊ፡ ወቡሩክ፡ ወልድ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ መርቆሬዎስ፡ ተስፋየ፨</t:l>
                  <t:l n="2">በዓፀደ፡ ከሀ፡ ወዝየ፨</t:l>
                  <t:l n="3">ታንቅሐኒ፡ ነዓ፡ ጊዜ፡ ሐኬትየ፨</t:l>
                  <t:l n="4">መዓልተ፡ ወለያልየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከ፡ ረድኤትከ፡ ፍቅርት፡ ነበልባለ፡ እሳት፡ ከዊና፨</t:l>
                  <t:l n="2">ለዘይትቃወሙኒ፡ ሕዝብ፡ ኢታትርፍ፡ ለዜና፨</t:l>
                  <t:l n="3">ትብልዖሙ፡ በውስተ፡ ፍና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ ምስለ፡ ጊዮርጊስ፡ ዘልዳ፨</t:l>
                  <t:l n="2">ተፀዓኔ፡ ፈረስ፡ ፀዓዳ፨</t:l>
                  <t:l n="3">ለምሕረት፡ ፍቅርት፡ ዘትፈቅዳ፨</t:l>
                  <t:l n="4">መርቆሬዎስ፡ ነዓ፡ በዕለተ፡ ፍዳ፨</t:l>
                  <t:l n="5">ከመ፡ ትሰልጥ፡ ዘዚአየ፡ ዕዳ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
