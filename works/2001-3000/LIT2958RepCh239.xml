         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ቅዱስ፡ ቅዱስ፡ ቅዱስ፡ በቅዳሴ፨</t:l>
                  <t:l n="2">ከመ፡ ውስተ፡ ሰማይ፡ ትብል፡ ምስለ፡ መላእክት፡ ቅድመ፡ ሥላሴ፨</t:l>
                  <t:l n="3">ተውላጠ፡ ውስተ፡ ምድር፡ ኮንከ፡ መናኔ፡ ምድር፡ ብእሴ፨</t:l>
                  <t:l n="4">እጽሐፍ፡ ለከ፡ አምኃ፡ ወሰላመ፡ መልክእ፡ ውዳሴ፨</t:l>
                  <t:l n="5">ስቡሕ፡ ራእይ፡ ፊቅጦር፡ ዳግማይ፡ ሙሴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘኢየሐፅፅ፡ በፍቅድ፨</t:l>
                  <t:l n="2">እምአርባዕቱ፡ እንስሳ፡ መናብርቲሁ፡ ለወልድ፨</t:l>
                  <t:l n="3">ንጹሕ፡ ኵለንታ፡ ፊቅጦር፡ እክለ፡ ብዕለ፡ ጻድቃን፡ ዓውድ፨</t:l>
                  <t:l n="4">ለገብርከ፡ ላዕለ፡ ነፍስየ፡ ደብረ፡ ሰልሞን፡ ዐፀድ፨</t:l>
                  <t:l n="5">እምደመና፡ ገድልከ፡ ይዝንም፡ ጸጋከ፡ በረድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ዘኢተጸፍራ፡ ለሐውዝ፨</t:l>
                  <t:l n="2">በዘውስተ፡ ዓለም፡ ግዕዝ፨</t:l>
                  <t:l n="3">ያቁም፡ ፊቅጦር፡ ዘመደ፡ አቦሊ፡ በለዝ፨</t:l>
                  <t:l n="4">አልቦ፡ ከማከ፡ እግዚኦ፡ በዓቂበ፡ ሐዲስ፡ ትእዛዝ፨</t:l>
                  <t:l n="5">ዘከዓውከ፡ ደመ፡ ፍዳ፡ ከመ፡ ማይ፡ ውኂዝ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ጌራ፡ አካልከ፡ ርእስ፨</t:l>
                  <t:l n="2">ወዘወርቅ፡ አክሊሉ፡ ለክሳድከ፡ ንጉሥ፨</t:l>
                  <t:l n="3">ጸናጽለ፡ ወርቅ፡ ፊቅጦር፡ ወጥዑመ፡ ዜማ፡ ናብሊስ፨</t:l>
                  <t:l n="4">በድምፅከ፡ ኦስካለ፡ ወይን፡ ማእከለ፡ ባሕር፡ ወየብስ፨</t:l>
                  <t:l n="5">ልቡና፡ ይትፌሣሕ፡ ወትትኃሠይ፡ ነፍስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለገጽከ፡ ዘያስተፌሥሕ፡ በሥኑ፨</t:l>
                  <t:l n="2">እምሥነ፡ ከዋክብት፡ ዕዱላን፡ እለ፡ ገጸ፡ ሰማይ፡ ከደኑ፨</t:l>
                  <t:l n="3">መኑ፡ ፊቅጦር፡ እንዘ፡ ኅዳጥ፡ ዘመኑ፨</t:l>
                  <t:l n="4">ከማከ፡ ዘተጋደለ፡ እምአለ፡ እመሬት፡ ኮኑ፨</t:l>
                  <t:l n="5">ዘበእንተ፡ ክርስቶስ፡ ገድልከ፡ የዓፅብ፡ አኮኑ</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለቀራንብቲከ፡ እለ፡ የዓውዳ፡ ብንተ፨</t:l>
                  <t:l n="2">ከመ፡ ሕንጻ፡ ቅጽሮ፡ ቤተ፨</t:l>
                  <t:l n="3">ፍና፡ ትሩፋት፡ ፊቅጦር፡ እስመ፡ ኢሖርኩ፡ ንስቲተ፨</t:l>
                  <t:l n="4">በርስትከ፡ ደብረ፡ ጽዮን፡ አመ፡ ትሔድስ፡ ውርዙተ፨</t:l>
                  <t:l n="5">እግዚኦ፡ ማኅጸንተከ፡ ንሥአኒ፡ ዓሥራተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአዕይንቲከ፡ ከዋክብተ፡ ገጽ፡ ጠፈር፨</t:l>
                  <t:l n="2">እለ፡ ነጽሮቶን፡ ገብራ፡ ውስተ፡ ምዕራበ፡ ሕግ፡ ወፍቅር፨</t:l>
                  <t:l n="3">በኅድረትከ፡ ፊቅጦር፡ ውሳጤ፡ ቅፅር፡ ምዝቡር፨</t:l>
                  <t:l n="4">አነከር፡ ምስለ፡ ብሄል፡ ገድለ፡ ሰማዕታቲከ፡ በር፨</t:l>
                  <t:l n="5">ዕፁብ፡ እፎ፡ ወእፎ፡ መንከር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለአእዛኒከ፡ በአስተሐውዞ፡ አለ፡ ኢሰምዓ፨</t:l>
                  <t:l n="2">ምክረ፡ ህርማኖስ፡ አቡከ፡ ዘለክብረ፡ አጵሎን፡ ሦዓ፨</t:l>
                  <t:l n="3">ዓስበ፡ ፃማከ፡ ፊቅጦር፡ ወህየንተ፡ ገድልከ፡ ጸንዓ፨</t:l>
                  <t:l n="4">ነፈርዓፀ፡ ትግብር፡ በህየ፡ ወበዓለ፡ ዓቢይ፡ ፍግዓ፨</t:l>
                  <t:l n="5">መንግሥተ፡ ሰማያት፡ ለከ፡ ተደለወት፡ መርዓ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለመላትሒከ፡ እለ፡ ሐማ፡ በሠውጥ፨</t:l>
                  <t:l n="2">ህየንተ፡ ጸፍዖ፡ ሐራዊ፡ ለወልደ፡ ማርያም፡ ሥሉጥ፨</t:l>
                  <t:l n="3">ወሬዛ፡ ፊቅጦር፡ ወሕፃነ፡ ዕድሜ፡ ኅዳጥ፨</t:l>
                  <t:l n="4">እምብዝኃ፡ ገድልከ፡ ሥርናየ፡ አንከሮ፡ ሥውጥ፨</t:l>
                  <t:l n="5">ውስተ፡ ከርሠ፡ መርዓት፡ ልቡና፡ ሕዝብ፡ ዘአፍአ፡ ወውሥጥ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰሳም፡ ለአእናፊከ፡ ከመ፡ ሰሎሞን፡ አግሃደ፨</t:l>
                  <t:l n="2">እለ፡ ተመስሎ፡ አርትዓ፡ ሊባኖሳዌ፡ ማኅፈደ፨</t:l>
                  <t:l n="3">ግብረ፡ ተጋድሎ፡ ፊቅጦር፡ ዓቅመ፡ ልብከ፡ ፈቀደ፨</t:l>
                  <t:l n="4">በእንተ፡ ክርስቶስ፡ ዘእምህላዌ፡ አብ፡ ተወልደ፨</t:l>
                  <t:l n="5">ውስተ፡ ብሔረ፡ ግብጽ፡ እምአንጾኪያ፡ አፍጠንከ፡ ወሪደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለከናፍሪከ፡ ቅድመ፡ ገጸ፡ ንጉሥ፡ ዓላዊ፨</t:l>
                  <t:l n="2">እለ፡ በኢፍርሃት፡ ነበባ፡ ሃይማኖተ፡ ክርስቶስ፡ ማሕየዊ፨</t:l>
                  <t:l n="3">ካህን፡ ፊቅጦር፡ አልአዛር፡ ዘመደ፡ ሌዊ፨</t:l>
                  <t:l n="4">መሥዋዕተ፡ ግበር፡ እግዚኦ፡ በመጥባሕተ፡ ረድኤት፡ ሀላዊ፨</t:l>
                  <t:l n="5">በግዓ፡ ዓመት፡ ነጽሮትየ፡ ለብእሲ፡ ባሕታዊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለአፉከ፡ ዘአዋመዎ፡ ልጓም፨</t:l>
                  <t:l n="2">አመ፡ ተድላ፡ ዓለም፡ ኃደገ፡ በፍቅረ፡ ዳግማይ፡ ዓለም፨</t:l>
                  <t:l n="3">ዕንቈ፡ ባሕርይ፡ ፊቅጦር፡ ዘመደ፡ ገላውዴዎስ፡ ሶም፨</t:l>
                  <t:l n="4">አኅልፈኒ፡ በብርሃንከ፡ እምዓፀደ፡ ጽልመት፡ ድካም፨</t:l>
                  <t:l n="5">በፍኖተ፡ ገድልከ፡ እሑር፡ ኅበ፡ ይምን፡ ወጽግም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለአስናኒከ፡ ለለ፡ አሐዱ፡ አሐዱ</t:l>
                  <t:l n="2">ዘአስተላጸቆሙ፡ አምላክ፡ ዓቅመ፡ አገበሮ፡ ፈቃዱ፨</t:l>
                  <t:l n="3">ሃይማኖታዊ፡ ፊቅጦር፡ እምአለ፡ እግዚኦሙ፡ ክህዱ፨</t:l>
                  <t:l n="4">መንክር፡ ተገፍዖትከ፡ ለሄርሜንዮስ፡ በዓውዱ፨</t:l>
                  <t:l n="5">ቤዛ፡ ነፍስ፡ ዚአየ፡ ይቁም፡ ቅድመ፡ አብ፡ ወወልዱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰላም፡ ለልሳንከ፡ ዘኢያኅደጎ፡ ፍርሃት፨</t:l>
                  <t:l n="2">እንዘ፡ ሃይማኖቶ፡ ይነብብ፡ ቅድመ፡ ዓላውያን፡ ነገሥት፨</t:l>
                  <t:l n="3">ኃያል፡ ፊቅጦር፡ ወመስተጋድል፡ ሰማዕት፨</t:l>
                  <t:l n="4">ዕድዋንየ፡ ቅትል፡ እግዚኦ፡ በጾታ፡ ብዙኅ፡ ረድኤት</t:l>
                  <t:l n="5">ከመ፡ ለጎልያድ፡ ቅድመ፡ ቀተሎ፡ ዳዊት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለቃልከ፡ እምግርማ፡ ነጐድጓድ፡ ድምፁ፨</t:l>
                  <t:l n="2">ዘበአንጾኪያ፡ ሠራዊተ፡ ጣዖት፡ ደንገፁ፨</t:l>
                  <t:l n="3">አመ፡ አንበብኮ፡ ፊቅጦር፡ በበ፡ አንቀጹ፡ ወገጹ፨</t:l>
                  <t:l n="4">ለመጽሐፈ፡ ገድል፡ እስመ፡ ለጊዮርጊስ፡ ቢጹ፨</t:l>
                  <t:l n="5">መላእክተ፡ ሰማይ፡ ኪያከ፡ እምሰማይ፡ ሐወፁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለእስትንፋስከ፡ ነፋሰ፡ ሃይማኖት፡ በጸጋ፨</t:l>
                  <t:l n="2">እንበለ፡ ሕፀፅ፡ ዘነፍሐ፡ ቅድመ፡ ብዙኃን፡ እንግልጋ፨</t:l>
                  <t:l n="3">ምሉእ፡ ፊቅጦር፡ ዘአልብከ፡ ሥርዓተ፡ ንትጋ፨</t:l>
                  <t:l n="4">ያግዕዘኒ፡ ለፍቁርከ፡ እምቅንዋተ፡ እግዚእ፡ ሥጋ፨</t:l>
                  <t:l n="5">ለመንፈሳዊት፡ ገድልከ፡ ሥርዓታ፡ ወሕጋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለጕርዔከ፡ ዘስቲ፡ ወይነ፡ ምድር፡ ኢሠምረ፨</t:l>
                  <t:l n="2">ጣዕመ፡ ወይነ፡ ፍቅሩ፡ ለወልድ፡ እስመ፡ ውሣጤሁ፡ ኃደረ፨</t:l>
                  <t:l n="3">መኑ፡ ፊቅጦር፡ ዘይትዔረየከ፡ ክብረ፨</t:l>
                  <t:l n="4">ፊላታዎስ፡ ጥቀ፡ አኮኑ፡ ጊዜ፡ መንገለ፡ ገድል፡ አንጸረ፨</t:l>
                  <t:l n="5">መጽሐፈ፡ ብዙኅ፡ ክብርከ፡ እምአምላክ፡ ተምህረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለከሳድከ፡ በሰይፈ፡ ሐራዊ፡ ዘተፅዕረ፨</t:l>
                  <t:l n="2">እስከ፡ ይፌጽም፡ ሆሮዮን፡ በትእዛዘ፡ መልአከ፡ ድኅረ፨</t:l>
                  <t:l n="3">በእንተ፡ ዝንቱ፡ ባሕቱ፡ ብካየ፡ ማርታ፡ መሪረ፨</t:l>
                  <t:l n="4">ፊቅጦር፡ ተዘኪረከ፡ ኢትትሃየደኒ፡ ምዕረ፨</t:l>
                  <t:l n="5">እስመ፡ እግዚእየ፡ አንተ፡ ወኮንኩከ፡ ገብረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ሰላም፡ ለመትከፍትከ፡ ዘጸዊሮቶ፡ አቅለለ፨</t:l>
                  <t:l n="2">ለአርዑተ፡ ክርስቶስ፡ ቤዛ፡ ዘበቀራንዮ፡ ተሰቅለ፨</t:l>
                  <t:l n="3">ምስለ፡ ሰማዕታት፡ ፊቅጦር፡ እንዘ፡ ትግብር፡ መድበለ፨</t:l>
                  <t:l n="4">ሐውፀኒ፡ በረድኤትከ፡ ወተሣሃለኒ፡ ሣህለ፨</t:l>
                  <t:l n="5">ከመ፡ ጊዜ፡ ድካም፡ እንሣእ፡ አምኃይልከ፡ ኃይለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="20">
                  <t:l n="1">ሰላም፡ ለዘባንከ፡ ተቀሥፎተ፡ ክርስቶስ፡ አምላከ፨</t:l>
                  <t:l n="2">ዘበተዝክሮ፡ ተቀሥፈ፡ እመኰንነ፡ ጋዕዝ፡ ወሀውከ፨</t:l>
                  <t:l n="3">እንዘ፡ ሥጋዊ፡ ፊቅጦር፡ እስመ፡ መንፈሳዊ፡ መልአክ፨</t:l>
                  <t:l n="4">መፍትው፡ ያስተብፅዑከ፡ ልሳናተ፡ ጽባሕ፡ ወሰርክ፨</t:l>
                  <t:l n="5">ብፅዓን፡ ትዕግሥቱ፡ ለኢዮብ፡ ብእሲ፡ ቡሩክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="21">
                  <t:l n="1">ሰላም፡ ለአንግድዓከ፡ ዘበጽንዓ፡ ረኃብ፡ ደግደገ፨</t:l>
                  <t:l n="2">አመ፡ ብዕለ፡ ሥጋ፡ ኃደገ፨</t:l>
                  <t:l n="3">ሰማዕተ፡ ወንጌል፡ ፊቅጦር፡ ከመ፡ ትረስየኒ፡ ዘውገ፨</t:l>
                  <t:l n="4">መንገሌከ፡ እስመ፡ ቀረብኩ፡ ምስለ፡ ሥርወ፡ ልብየ፡ ደርገ፨</t:l>
                  <t:l n="5">ዘብዝኃ፡ መንክር፡ ገድልከ፡ መሀረኒ፡ ሕግ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="22">
                  <t:l n="1">ሰላም፡ ለሕፅንከ፡ ሕፅነ፡ ወልደ፡ ቡርክት፡ ድንግል፨</t:l>
                  <t:l n="2">ምርፋቀ፡ ዮሐንስ፡ ገድል፨</t:l>
                  <t:l n="3">ኦፊቅጦር፡ ትዌድስከ፡ በቃል፨</t:l>
                  <t:l n="4">ማርታ፡ ኪያከ፡ በአፍቅሮ፡ እንዘ፡ ትኬልሕ፡ ወትብል፨</t:l>
                  <t:l n="5">መንክር፡ መዓዛሁ፡ ለፊቅጦር፡ ኮል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለአእዳዊከ፡ እለ፡ ድኅሪተ፡ ተዓሥራ፨</t:l>
                  <t:l n="2">ወክቡደ፡ እብነ፡ መልዕልተ፡ ዝንቱ፡ ዘጾራ፡ ዘ</t:l>
                  <t:l n="3">በግዓ፡ ፋሲካ፡ ፊቅጦር፡ ክርስቶስ፡ ዘሊቶስጥራ፨</t:l>
                  <t:l n="4">እፎ፡ እምኮነ፡ ሶበ፡ ርእየ፡ ዘላዕሌከ፡ መከራ፨</t:l>
                  <t:l n="5">ገላውዴዎስ፡ ፍቁርከ፡ ሊቆሙ፡ ለሐራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለመዛርዒከ፡ እለ፡ ተወከፋ፡ ሕማመ፨</t:l>
                  <t:l n="2">እስመ፡ እግረ፡ ልብከ፡ ምዕረ፡ ዓውደ፡ አምልኮ፡ ዕፅ፡ ኢቆመ፨</t:l>
                  <t:l n="3">ማርታ፡ ፊቅጦር፡ ትበክየከ፡ ግሩመ፨</t:l>
                  <t:l n="4">ዘሰተይከ፡ ሕምዘ፡ ቀታሊ፡ ሶበ፡ ትዜከር፡ ፍጹመ፨</t:l>
                  <t:l n="5">እንዘ፡ ትብል፡ አነ፡ አምሰተይኡ፡ ደመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለኵርናዕከ፡ እንዘ፡ ይፄዓር፡ በለፈ፨</t:l>
                  <t:l n="2">ዘበኅበ፡ ለፌ፡ ተረክበ፡ ሐመረ፡ ኃይል፡ ኃዳፌ፨</t:l>
                  <t:l n="3">እንዘ፡ ትቀንት፡ ፊቅጦር፡ አምሳለ፡ ክርስቶስ፡ መክፈ፨</t:l>
                  <t:l n="4">በጸጋከ፡ ማየ፡ ንብቲራ፡ ከመ፡ ኢይቁም፡ ጸናፌ፨</t:l>
                  <t:l n="5">ሕፅበኒ፡ ለረድእከ፡ እኩንከ፡ ሱታፌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለእመትከ፡ ህለተ፡ ወርቅ፡ ቀይሕ፨</t:l>
                  <t:l n="2">አቡቀለምሲስ፡ ዘነሥኦ፡ እምእደ፡ መልአከ፡ ንጹሕ፨</t:l>
                  <t:l n="3">ጠቢብ፡ ፊቅጦር፡ ወከመ፡ ርግብ፡ የዋሕ፨</t:l>
                  <t:l n="4">መስቀረ፡ በተመስሎ፡ እማየ፡ ኃጢአት፡ አይኅ፨</t:l>
                  <t:l n="5">ኅብአኒ፡ እግዚእየ፡ ለገብርከ፡ ኖን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለአራኅከ፡ ዘሃመወ፡ በፀሪብ፨</t:l>
                  <t:l n="2">ከመ፡ ሊቀ፡ ፀረብት፡ ጠቢብ፨</t:l>
                  <t:l n="3">ዘአልህቀከ፡ ፊቅጦር፡ ጸጋ፡ መንፈስ፡ ቀዱስ፡ ሐሊብ፨</t:l>
                  <t:l n="4">ተሳተፍከ፡ ትግብረ፡ ቅዳሴ፡ ምስለ፡ ሰማያዊ፡ ኪሩብ፨</t:l>
                  <t:l n="5">ህየንተ፡ እምአብ፡ ተፈለጥከ፡ በፍቅሩ፡ ለአብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለአፃብዒከ፡ አዕጹቀ፡ አራዳ፡ ጕንድ፨</t:l>
                  <t:l n="2">ዘኍሳቌሆን፡ የውጣ፡ ሕንጻ፡ ደብረ፡ ሲና፡ ማኅፈድ፨</t:l>
                  <t:l n="3">ሐመረ፡ ጸጋ፡ ፊቅጦር፡ ዘኃጢአት፡ ሞገድ፨</t:l>
                  <t:l n="4">ኢያሥጥመኒ፡ ለገብርከ፡ አምሳለ፡ እብን፡ ክቡድ፨</t:l>
                  <t:l n="5">አብጽሐኒ፡ ኀበ፡ መርሶ፡ ንስሐ፡ ዓፀድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እዴከ፡ እለ፡ ይመስላ፡ ሰበነ፨</t:l>
                  <t:l n="2">አርእስተ፡ አፃብዕ፡ ዓሥር፡ እስመ፡ ግብረቶን፡ ከደነ፨</t:l>
                  <t:l n="3">ብዕለ፡ ነገሥተ፡ ምድር፡ መነነ፨</t:l>
                  <t:l n="4">መንግሥተ፡ ሰማይ፡ ዘታስተጋብእ፡ ጻድቃነ፨</t:l>
                  <t:l n="5">ኮነተከ፡ ብዕለ፡ ወክብረ፡ እውነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለገቦከ፡ በአፍሐመ፡ እሳት፡ ፯፨</t:l>
                  <t:l n="2">ሐራ፡ መኰንን፡ ዓላዊ፡ ዘአፃመውም፡ ሎቱ፨</t:l>
                  <t:l n="3">እንበይነ፡ ግኒ፡ ፊቅጦር፡ ለወይነ፡ ሥቃይ፡ ዓፀደ፡ ርስቱ፨</t:l>
                  <t:l n="4">ክርስቶስ፡ አስተርአየከ፡ ምስለ፡ መኃትው፡ ዓሥርቱ፨</t:l>
                  <t:l n="5">ትእምርተ፡ መንግሥትከ፡ በሐዳስ፡ ሕይወቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለከርሥከ፡ ሥውጢ፡ ሥርናይ፡ ሥርዓት፨</t:l>
                  <t:l n="2">ወሕፀር፡ በጽጌ፡ ጸጋ፡ መንፈስ፡ ቅዱስ፡ ሕይወት</t:l>
                  <t:l n="3">መንክረ፡ ፀዳል፡ ፊቅጦር፡ ዘተቅዋመ፡ ሥቃይ፡ ማኅቶት፨</t:l>
                  <t:l n="4">ታንሶሱ፡ በብርሃንከ፡ እንዘ፡ አልባቲ፡ ጽልመት፨</t:l>
                  <t:l n="5">ሃይማኖታዊት፡ ነፍስየ፡ በሉ፡ ሰዓት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለልብከ፡ ዘለአጵሎን፡ ኢሠምሮ፨</t:l>
                  <t:l n="2">እስመ፡ እደ፡ ሰብእ፡ ኢገብሮ፨</t:l>
                  <t:l n="3">እዌድሰከ፡ ፊቅጦር፡ እንዘ፡ አበዝኅ፡ ዘምሮ፨</t:l>
                  <t:l n="4">ለክርስቶስ፡ ቀዳሜ፡ ጸጋ፡ እስመ፡ ኢኃደገ፡ ፍቅሮ፨</t:l>
                  <t:l n="5">በከመ፡ ይቤ፡ ጳውሎስ፡ በሐዋዝ፡ ዘምሮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለኵልያቲከ፡ እለ፡ በትዕግሥት፡ ተገሠጻ፨</t:l>
                  <t:l n="2">ከመ፡ ቃለ፡ ዳዊት፡ ነገረ፡ እንዘ፡ የኃድግ፡ ዓመፃ፨</t:l>
                  <t:l n="3">ማኅፈደ፡ ምግባር፡ ፊቅጦር፡ ወዘሃይማኖት፡ ሕንጻ፨</t:l>
                  <t:l n="4">ከመ፡ ተሰደት፡ ታውክልያ፡ እምርስተ፡ አቡሃ፡ ኀበ፡ ___ፃ፨</t:l>
                  <t:l n="5">ህየንተ፡ ሮስተ፡ አብ፡ ስደት፡ ኮነተከ፡ ዕፃ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">ሰላም፡ ለሕሊናከ፡ እስራኤላዊ፡ ሕሊና፨</t:l>
                  <t:l n="2">ዘተሴሰየ፡ ፍጹመ፡ ዓቂበ፡ ሃይማኖት፡ ኅብስተ፡ መና፨</t:l>
                  <t:l n="3">ወልደ፡ ማርታ፡ ፊቅጦር፡ ሠናየ፡ ዝክር፡ ወዜና፨</t:l>
                  <t:l n="4">ቍልቍሊተ፡ በተሰቅሎ፡ እመንገለ፡ ብዙኅ፡ ፍና፨</t:l>
                  <t:l n="5">። ፍጹመ፡ ተመሰልከ፡ ለጴጥሮስ፡ ዘዮና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">ሰላም፡ ለአማዑቲከ፡ ዘኢተቈጽረ፡ በቂም፨</t:l>
                  <t:l n="2">እስመ፡ ኵለንታሁ፡ ሰላም፨</t:l>
                  <t:l n="3">ምዑዝ፡ ፊቅጦር፡ ኮለ፡ ማርታ፡ ገዳም፨</t:l>
                  <t:l n="4">ምስለ፡ ጊዮርጊስ፡ ወመርቆሬዎስ፡ ዘሮም፨</t:l>
                  <t:l n="5">መንገሌየ፡ ለሐውዖ፡ አስተፋጥን፡ ዮም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="36">
                  <t:l n="1">ሰላም፡ ለንዋየ፡ ውሥጥከ፡ ዘልብሰ፡ ትሕትና፡ ተዓፅፈ፨</t:l>
                  <t:l n="2">ወአምተከሥቶ፡ ለኵሉ፡ ዘርቤተ፡ ተኃብአ፡ ነጸፈ፨</t:l>
                  <t:l n="3">እምሰማዕታት፡ ፊቅጦር፡ ዘተጋደልክ፡ ትሩፈ፨</t:l>
                  <t:l n="4">ከመ፡ እንብብ፡ ቅድመ፡ አእላፍ፡ ዜና፡ ክብርከ፡ መጽሐፈ፨</t:l>
                  <t:l n="5">ምሕረትከ፡ ወጽድቅከ፡ ይርከባኒ፡ ዘልፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ሰላም፡ ለዓንብርትከ፡ ዘይመስል፡ በተርእዮ፨</t:l>
                  <t:l n="2">መረግደ፡ መትከፍ፡ ዓርወ፡ ወዘዲበ፡ ኤፉድ፡ ክበበ፡ ጥውዮ፨</t:l>
                  <t:l n="3">ለክርስቶስ፡ ፊቅጦር፡ እስመ፡ አጥባዕከ፡ ተቀንዮ፨</t:l>
                  <t:l n="4">ለሥጋከ፡ በአነዳ፡ ላህም፡ ለዘዕሡረ፡ ረሰዮ፨</t:l>
                  <t:l n="5">ዘመደ፡ እለ፡ ዳታን፡ ይኩን፡ ውስተ፡ ሲኦል፡ ደዮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="38">
                  <t:l n="1">ሰላም፡ ለሐቌከ፡ ኃይለ፡ መንፈስ፡ ቅዱስ፡ ዘቀነተ፨</t:l>
                  <t:l n="2">እስመ፡ ቅናተ፡ ወርቅ፡ አስተተ፨</t:l>
                  <t:l n="3">በአንተ፡ ክርስቶስ፡ ፊቅጦር፡ አመ፡ ሠለጥከ፡ መዊተ፨</t:l>
                  <t:l n="4">ህየንተ፡ ብካይ፡ ዝበኅበ፡ ዘመድ፡ ተከሥተ</t:l>
                  <t:l n="5">መላእክተ፡ ሰማይ፡ ለከ፡ ኃለዩ፡ ማኅሌተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="39">
                  <t:l n="1">ሰላም፡ ለአቍያጺከ፡ እለ፡ ከመ፡ ሠርዌ፡ ተተክላ፨</t:l>
                  <t:l n="2">ቀመረ፡ ሥጋ፡ ይጹራ፡ በፍጽም፡ ወበከዋሳ፨</t:l>
                  <t:l n="3">መጽሐፈ፡ ራዕይ፡ ፊቅጦር፡ ለክስብኡል፡ ወለዑ፡ መሐላ፨</t:l>
                  <t:l n="4">ኍልቈ፡ ዜነውከ፡ ለኵሉ፡ ለድንግለ፡ ሀገር፡ ገሊላ፨</t:l>
                  <t:l n="5">ከመ፡ ዜነዋ፡ ገብርኤል፡ ብስራተ፡ ዘተድላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="40">
                  <t:l n="1">ሰላም፡ ለአብራኪከ፡ አለ፡ ሰጊደ፡ አብዝኁ፨</t:l>
                  <t:l n="2">ለከርስቶስ፡ ወለአቡሁ፨</t:l>
                  <t:l n="3">ዘትትባየጾ፡ ፊቅጦር፡ ለቶማስ፡ በአነዳሁ፨</t:l>
                  <t:l n="4">ጣዖቶሙ፡ ሶበ፡ መነንከ፡ ለመኰንን፡ ሐራሁ፨</t:l>
                  <t:l n="5">ከመ፡ ሥርወ፡ ዕፅ፡ ሥረዊከ፡ መልሑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="41">
                  <t:l n="1">ሰላም፡ ለአእጋሪከ፡ እለ፡ ረዊጸ፡ አፍቀራ</t:l>
                  <t:l n="2">በእንተ፡ ሃይማኖት፡ ርትዕት፡ ውስተ፡ ፍና፡ ብዙኅ፡ መከራ፨</t:l>
                  <t:l n="3">ጽዋዓ፡ ልቡና፡ ፊቅጦር፡ ከመ፡ ኡርኤል፡ ለእዝራ፨</t:l>
                  <t:l n="4">አስትየኒ፡ ለሰላምከ፡ ከመ፡ ኢይትሀከይ፡ ግብራ፨</t:l>
                  <t:l n="5">አምጣነ፡ ብዙኅ፡ ውእቱ፡ ዕበያ፡ ወክብራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="42">
                  <t:l n="1">ሰላም፡ ለሰኰናከ፡ ዘአንሶሰወ፡ ውስቴቱ፨</t:l>
                  <t:l n="2">ለዕቶነ፡ እሳት፡ ነዳዲ፡ ከመ፡ ደቂቅ፡ ሠለስቱ፨</t:l>
                  <t:l n="3">በቋዒ፡ ፊቅጦር፡ በዘበቍዔት፡ አልቦቱ፨</t:l>
                  <t:l n="4">መሀረኒ፡ ሕገ፡ ንጽሕና፡ እመንገለ፡ ጸጋ፡ በከንቱ፨</t:l>
                  <t:l n="5">እስመ፡ ስግረትየ፡ ኢመፍትው፡ ውእቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="43">
                  <t:l n="1">ሰላም፡ ለመከየድከ፡ እንተ፡ ተዓገሠ፡ ገድለ፨</t:l>
                  <t:l n="2">እንበለ፡ አሣዕን፡ ዘወርቅ፡ በጊዜ፡ ኬደ፡ ፀበለ፨</t:l>
                  <t:l n="3">ነዳየ፡ መንፈስ፡ ፊቅጦር፡ ከመ፡ ውስተ፡ ወንጌል፡ ተብህለ፨</t:l>
                  <t:l n="4">ብፁዕ፡ አንተ፡ እግዚኦ፡ እስመ፡ ኢያፍቀርከ፡ ብዕለ፨</t:l>
                  <t:l n="5">በምክረ፡ ህርማኖስ፡ አቡከ፡ ዘርእስ፡ ቀተለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="44">
                  <t:l n="1">ሰላም፡ ለአጻብኢከ፡ እለ፡ ህልዋት፡ እማንቱ፨</t:l>
                  <t:l n="2">ዲበ፡ ርእሰ፡ ስፉሕ፡ መከየድ፡ ዘአእጋሪከ፡ ክልኤቱ፨</t:l>
                  <t:l n="3">ለክርስቶስ፡ ፊቅጦር፡ እስመ፡ ተአመንከ፡ ቦቱ፨</t:l>
                  <t:l n="4">፷፡ ሀብታተ፡ መኒነከ፡ ውስተ፡ ሰማያዊት፡ መንግሥቱ፨</t:l>
                  <t:l n="5">ተደለዉ፡ ለከ፡ አክሊላት፡ ሠለስቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="45">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እግርከ፡ ዘፅዕዳዌሆን፡ ኢተወለጠ፨</t:l>
                  <t:l n="2">ለእሳተ፡ እቶን፡ ጢሱ፡ አመ፡ ላዕሌሆን፡ ተሠልጠ፨</t:l>
                  <t:l n="3">እምተጋድሎ፡ ፊቅጦር፡ ኢተድኅርከ፡ ኅዳጠ፨</t:l>
                  <t:l n="4">ሰማየ፡ ሐልዮ፡ እስመ፡ ልብከ፡ ተመሥጠ፨</t:l>
                  <t:l n="5">ከመ፡ ለ፴፡ ብሩር፡ መለኮት፡ ተሠይጠ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="46">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ ዘልብሰ፡ ሰማይ፡ ለብሰ፨</t:l>
                  <t:l n="2">ወተሠርገወ፡ ሞገሰ፨</t:l>
                  <t:l n="3">ሊቀ፡ ካህናት፡ ክርስቶስ፡ እስመ፡ ፍናከ፡ ሐደሰ፨</t:l>
                  <t:l n="4">ፊቅጦር፡ አስተፋጠንከ፡ ውስተ፡ ፍኖተ፡ ገድል፡ ገይሰ፨</t:l>
                  <t:l n="5">እንዘ፡ በልቡና፡ ትሔሊ፡ ምስሌሁ፡ ነጊሡ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="47">
                  <t:l n="1">ሰላም፡ ለመልክዕከ፡ መልክዓ፡ ክርስቶስ፡ ሕያው፨</t:l>
                  <t:l n="2">ከመ፡ ውስተ፡ መዝሙር፡ ተብህለ፡ ዘሥነ፡ ላህዩ፡ ፍትው፨</t:l>
                  <t:l n="3">እንዘ፡ በሥነ፡ ወርቅ፡ ፊቅጦር፡ ጽርሐ፡ ቤትከ፡ ሥርግው፨</t:l>
                  <t:l n="4">እፎ፡ ኃደርከ፡ እግዚኦ፡ አምሳለ፡ ነዳያን፡ አኃው፨</t:l>
                  <t:l n="5">መ፡ ማእከለ፡ ገዳም፡ መፍርህ፡ ወስፉሕ፡ በድው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="48">
                  <t:l n="1">ሰላም፡ ለፀአተ፡ ነፍስከ፡ እንበለ፡ ድንጋፄ፡ ወተሀውኮ፨</t:l>
                  <t:l n="2">እስመ፡ ሞተ፡ ኃጥእ፡ አነ፨</t:l>
                  <t:l n="3">ፊቅጦር፡ ሄኖክ፡ ዘለአምላከ፡ ጽድቅ፡ አሥመርኮ፨</t:l>
                  <t:l n="4">ለነፍስከ፡ ጊዜ፡ ፀአታ፡ መላእክተ፡ ክቡር፡ አምልኮ፨</t:l>
                  <t:l n="5">ዘመሩ፡ እንዘ፡ ይብሉ፡ ስብሐተ፡ ከለልኮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="49">
                  <t:l n="1">ሰላም፡ ለበድነ፡ ሥጋከ፡ በእደ፡ ሆርዮን፡ ዘተገንዘ፨</t:l>
                  <t:l n="2">ከመ፡ ቃልከ፡ አዘዘ፨</t:l>
                  <t:l n="3">ፀሓይ፡ ፊቅጦር፡ እንተ፡ ትመልከ፡ አብያዘ፨</t:l>
                  <t:l n="4">አነክር፡ ላዕለ፡ በድንከ፡ አንክሮ፡ ልቡና፡ ሐዋዘ፨</t:l>
                  <t:l n="5">እስመ፡ ከመ፡ ዕፍረት፡ ፄነወ፡ ወሠናየ፡ ምዕዘ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="50">
                  <t:l n="1">ሰላም፡ እብል፡ ለግንዘተ፡ ክቡር፡ ሥጋከ፨</t:l>
                  <t:l n="2">እምድኅረ፡ ሠለጥከ፡ በድረ፡ ወሃይማኖተ፡ ዓቀብከ፨</t:l>
                  <t:l n="3">ኦፊቅጦር፡ አስተበቍዐከ፨</t:l>
                  <t:l n="4">ትርድአኒ፡ ቅድመ፡ አጽራር፡ ወትሬስየኒ፡ ዓርከ፨</t:l>
                  <t:l n="5">እስመ፡ እግዚእየ፡ አንተ፡ ወአነ፡ ገብርከ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="51">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ በስብሐተ፡ ልሳን፡ ወአፍ፨</t:l>
                  <t:l n="2">እስመ፡ ክብርከ፡ ትሩፍ፨</t:l>
                  <t:l n="3">መዓረ፡ ፀደና፡ ፊቅጦር፡ ሲሳየ፡ ዮሐንስ፡ ሰይፍ፨</t:l>
                  <t:l n="4">ይገብሩ፡ በሰማያት፡ መላእክተ፡ ሰማይ፡ አአላፍ፨</t:l>
                  <t:l n="5">በዓለ፡ ሞትከ፡ ዘአከበሮ፡ ነባቢ፡ መጽሐፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ ውስተ፡ አንጾኪያ፡ ሀገር፨</t:l>
                  <t:l n="2">በጻህቀ፡ ማርታ፡ እምከ፡ እምውሣጤ፡ ባርቆን፡ ቅፅር፨</t:l>
                  <t:l n="3">በፍልሰትከ፡ ፊቅጦር፡ በዓለ፡ ሐዲስ፡ መንክር፨</t:l>
                  <t:l n="4">ዘመሩ፡ ቅድመ፡ እምከ፡ ካህናተ፡ ሐዋዝ፡ መዝሙር፨</t:l>
                  <t:l n="5">ወከመ፡ ሐራጊት፡ በበዓልከ፡ አንፈርዓፀት፡ ምድር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ናሁ፡ አቅረብኩ፡ እንዘ፡ ጽንዓ፡ ሕማም፡ ተዓጋሢ፨</t:l>
                  <t:l n="2">አምኃ፡ ሰላም፡ እከለ፡ ዘያጸንዕ፡ ኃይለ፡ ብእሲ፨</t:l>
                  <t:l n="3">ባሕቱ፡ ፊቅጦር፡ ዓስበ፡ ግብርከ፡ አባሲ፨</t:l>
                  <t:l n="4">ለኰንኖ፡ ኵሉ፡ አመ፡ ይመጽእ፡ ነጋሢ፨</t:l>
                  <t:l n="5">ጥቃ፡ ማኅደርከ፡ ማኅደርየ፡ ረሲ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke" corresp="https://betamasaheft.eu/LIT2785RepCh69">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ ወልደ፡ ማርታ፡ ፊቅጦር፡ እዌድሰከ፡ ህልወ፨</t:l>
                  <t:l n="2">በፍቅረ፡ ዘተሰቅለ፡ ወልድ፡ ድኅረ፡ ተሠገወ፨</t:l>
                  <t:l n="3">ደምከ፡ ፍዳ፡ ተክዕወ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ ተዓሥርትከ፡ ከሳደ፡ በጋጋ፡ ሐፂን፡ ከቡድ፨</t:l>
                  <t:l n="2">በእንተ፡ ሃይማኖት፡ ፊቅጦር፡ ማእከለ፡ ዓውድ፨</t:l>
                  <t:l n="3">አውረስከ፡ መንግሥተ፡ ወልድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለከ፡ በፍና፡ እልዋሪቆን፡ ገድል፡ ኢረከበከ፡ ድካም፨</t:l>
                  <t:l n="2">ልሳነ፡ ዕፍረት፡ ፊቅጦር፡ አምጣነ፡ ሕማም፨</t:l>
                  <t:l n="3">ቅድሜከ፡ አምሳለ፡ ሕልም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለከ፡ ፀሐይ፡ ፊቅጦር፡ ንዋየ፡ ማርታ፡ ምሥራቅ፨</t:l>
                  <t:l n="2">ዝክረ፡ ስብሐቲከ፡ ልብስ፡ እምአፈ፡ ደቂቅ፨</t:l>
                  <t:l n="3">ፃዕደወ፡ ከመ፡ መብረቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለከ፡ ምሳሐ፡ ፋሲካ፡ ሐዲሰ፡ ሰይፈ፡ ሐራዊ፡ ኮነከ፨</t:l>
                  <t:l n="2">በተሰፍዎ፡ ፊቅጦር፡ ትንሣኤ፡ ነፍስከ፨</t:l>
                  <t:l n="3">ዓውደ፡ ገድል፡ በጊዜ፡ ቆምከ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከ፡ ሶበ፡ ዜና፡ ሞትከ፡ ሰምዓት፡ በሰይፈ፡ ሐራዊ፡ ስሑል፨</t:l>
                  <t:l n="2">ማርታ፡ በከየት፡ ብካየ፡ ራሄል፨</t:l>
                  <t:l n="3">ፊቅጦር፡ መንክረ፡ ገድል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ ብዝኃ፡ ተጋድሎ፡ ዘለከ፡ እመንገለ፡ ብዙኅ፡ ጾታ፨</t:l>
                  <t:l n="2">ኦፊቅጦር፡ ወልደ፡ ማርታ፨</t:l>
                  <t:l n="3">አንጾኪያ፡ ታነከር፡ ለለሳኒታ፨</t:l>
                  <t:l n="4">ወክብረከ፡ ትሰብክ፡ ባሕቲታ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>

      </t:body>
   </t:text></TEI>