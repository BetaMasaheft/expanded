         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2741RepCh25">
            <t:note>The following text reproduced after <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለሕማምከ፡ ቤተ፡ አይሁድ፡ ዘአንደደ፨</t:l>
                  <t:l n="2">ወረሰዮሙ፡ ሐመደ፨</t:l>
                  <t:l n="3">ማርያምሃ፡ እለ፡ ቦሙ፡ ካሕደ፨</t:l>
                  <t:l n="4">ተማኅፀነ፡ በሕማምከ፡ መጥወነ፡ እደ፨</t:l>
                  <t:l n="5">አጽራሪነ፡ ወትረ፡ ረሲ፡ ብድብደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለሕማምከ፡ ቤተ፡ አይሁድ፡ ዘአመዝበረ፨</t:l>
                  <t:l n="2">ወረሰዮሙ፡ ዝርዙረ፨</t:l>
                  <t:l n="3">ዘሤሬቅ፡ ወይን፡ እምነ፡ ዕጕስታር፡ መረ፨</t:l>
                  <t:l n="4">ተማሕፀነ፡ በሕማምከ፡ እግዚአብሔር፡ ወትረ፨</t:l>
                  <t:l n="5">እምአምልኮ፡ ሰይጣን፡ አድኅን፡ ዛተ፡ ሀገረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰላም፡ ለከተማ፡ ርእስከ፡ አክሊለ፡ ሦክ፡ ዘተመልአ፨</t:l>
                  <t:l n="2">በእደ፡ ዕብራይ፡ በበትረ፡ ሕለት፡ ተኰርዐ፨</t:l>
                  <t:l n="3">ኢየሱስ፡ ክርስቶስ፡ ምሥዋዒነ፡ ነዓ፨</t:l>
                  <t:l n="4">በእንተ፡ ርእስከ፡ አቅንተነ፡ ጽንዐ፨</t:l>
                  <t:l n="5">ማኅበረነ፡ ለባርኮ፡ አፍጥን፡ መጺአ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ጸዓዳ፡ ከመ፡ በረድ፨</t:l>
                  <t:l n="2">ቍርባነ፡ ወንጌል፡ ወልድ፨</t:l>
                  <t:l n="3">ጥብሕከ፡ ነድ፡ ሰዓሬ፡ ብድብድ፨</t:l>
                  <t:l n="4">እስመ፡ ቀሪበ፡ ቍርባን፡ ይከልእ፡ መንሱተ፨</t:l>
                  <t:l n="5">በከመ፡ ይቤ፡ ጴጥሮስ፡ በሲኖዶስ፡ ዘንተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="40">
                  <t:l n="1">ሰላም፡ ለርግዘተ፡ ገቦከ፡ ኲናተ፡ ሐራዊ፡ ዘረገዞ፨</t:l>
                  <t:l n="2">በአጽልእቲከ፡ ለቍስልየ፡ አምዕዞ፨</t:l>
                  <t:l n="3">ኢይደቅ፡ ርእስየ፡ መድኃኔ፡ ዓለም፡ አኀዞ፨</t:l>
                  <t:l n="4">ተማሕፀነ፡ በርግዘትከ፡ ለጉባኤነ፡ ናዝዞ፨</t:l>
                  <t:l n="5">በረምኀ፡ መስቀል፡ ለሰይጣን፡ ርግዞ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለኵሎን፡ መልክእከ፨</t:l>
                  <t:l n="2">አነ፡ ገብርከ፡ ወልደ፡ አምላክ፡ ወወልደ፡ ማርያም፡ ኪያከ፨</t:l>
                  <t:l n="3">ተማሕፀና፡ መልክእየ፡ በመልክእከ፨</t:l>
                  <t:l n="4">እምእደ፡ ሰይጣን፡ ያምስጣ፡ ነግሀ፡ ወሰርከ፨</t:l>
                  <t:l n="5">ወበኵሎን፡ ሳዕ፡ ዕቀቦን፡ እንከ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         
         <t:div type="edition" xml:id="div3LIT2741RepCh25">
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab>
                  ሰላም፡ ለሕማምከ፡ ቤተ፡ አይሁድ፡ ዘአመዝበረ።
               </t:ab>
            </t:div>

            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab>
                  ሰላም፡ ለሕማምከ፡ ቤተ፡ አይሁድ፡ ዘአንደደ።
               </t:ab>
            </t:div>
            
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab>
                  ሰላም፡ ለዝክረ፡ ስምከ፡ ቤተ፡ አይሁድ፡ ዘአዓደደ።
                  ወረሰዮሙ፡ ሐመደ።
                  ማርያምሃ፡ እለ፡ ቦሙ፡ ክህደ።
                  ተማኅፀነ፡ በሕማምከ፡ መጥወነ፡ እደ።
                  አጽራሪነ፡ ወትረ፡ ረሲ፡ ብድብደ።
               </t:ab>
            </t:div>
         </t:div>

         
      </t:body>
   </t:text></TEI>