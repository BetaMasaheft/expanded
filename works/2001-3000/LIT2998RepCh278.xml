         <t:div type="edition" xml:lang="gez" xml:id="div3LIT2998RepCh278">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በስመ፡ እግዚአብሔር፡ እምግብጽ፡ ፍናዋተ፡ ግዕዛን፡ ዘመርሖ፨</t:l>
                  <t:l n="2">ለእግረ፡ እስራኤል፡ ሙቁሕ፡ እማእሰረ፡ ቅንየት፡ እንዘ፡ ይፈትሖ፨</t:l>
                  <t:l n="3">አረጋዊ፡ ክቡር፡ መምህረ፡ ሰላም፡ ወተአምኆ፨</t:l>
                  <t:l n="4">ከመ፡ እንግር፡ ዜና፡ ጽድቅከ፡ ለልሳንየ፡ አብሖ፨</t:l>
                  <t:l n="5">ወለኅሊናየ፡ ካዕበ፡ እምሀኬት፡ አንቅሖ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ቀዋሚ፨</t:l>
                  <t:l n="2">ለዓለመ፡ ዓለም፡ ዘይሄሉ፡ ከመ፡ ተብህለ፡ ቀዳሚ፨</t:l>
                  <t:l n="3">አረጋዊ፡ የዋህ፡ ተመሳሌ፡ ዳዊት፡ ኢተቀያሚ፨</t:l>
                  <t:l n="4">ላዕሌየ፡ በተሀብሎ፡ እመ፡ ተንሥአ፡ ረጋሚ፨</t:l>
                  <t:l n="5">በሰዓተ፡ በቀል፡ ይብጽሖ፡ መክፈልቱ፡ ለሳሚ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለአካለ፡ ቆምከ፡ ዘኵለንታሁ፡ ፍትው፨</t:l>
                  <t:l n="2">ወለመልክእከ፡ ልሁይ፡ በትርሲተ፡ ጽጌ፡ ሥርግው፨</t:l>
                  <t:l n="3">አረጋዊ፡ እብለከ፡ ውስተ፡ ባሕረ፡ መንሱት፡ ድልው፨</t:l>
                  <t:l n="4">አሥጥሞሙ፡ ለጸላእትየ፡ ዘመደ፡ አራዊት፡ ዘበድው፨</t:l>
                  <t:l n="5">ከመ፡ ቀዳሚ፡ ተሠጥሙ፡ አኅርው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለተከብቶትከ፡ አምሳለ፡ ነቢያት፡ ክልኤቱ፨</t:l>
                  <t:l n="2">እስመ፡ ኪያከ፡ ኀረየ፡ እግዚአብሔር፡ በሥነ፡ ኂሩቱ፨</t:l>
                  <t:l n="3">ገብር፡ ኄር፡ ወምእመን፡ መጋቤ፡ ቤቱ፨</t:l>
                  <t:l n="4">አንተኑ፡ በዓለ፡ መካልይ፡ ኀምስቱ፨</t:l>
                  <t:l n="5">እንተ፡ ተሠየምከ፡ አረጋዊ፡ በአህጉር፡ ዓሠርቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለተኀብኦትከ፡ ኀበ፡ ኢያእመረ፡ መኑ፨</t:l>
                  <t:l n="2">ለእግዚአብሔር፡ አምላክ፡ በምክረ፡ ጥበቡ፡ ወኪዳኑ፨</t:l>
                  <t:l n="3">አረጋዊ፡ ኢታንትግ፡ ሐውጾትየ፡ በበ፡ ዘመኑ፨</t:l>
                  <t:l n="4">ወሠውረኒ፡ እግዚኦ፡ ለመልአከ፡ ሞት፡ እምዐይኑ፨</t:l>
                  <t:l n="5">ከመ፡ ለማኅበር፡ ዐቢይ፡ ጽድቀከ፡ እዜኑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ናሁ፡ አቅረብኩ፡ አምኃ፡ ማሕሌት፡ ንስቲተ፨</t:l>
                  <t:l n="2">ለዕበየ፡ መልክእከ፡ ክቡር፡ እንዘ፡ አወፈ፡ ዘንተ፨</t:l>
                  <t:l n="3">አረጋዊ፡ አውቅየ፡ ወማእምረ፡ ነፍስየ፡ አንተ፨</t:l>
                  <t:l n="4">እንበለ፡ ታጥፍእ፡ ባሕቱ፡ ዘተመነይኩ፡ ዕሤተ፨</t:l>
                  <t:l n="5">በዓለመ፡ ተድላ፡ ዘይመጽእ፡ ሀበኒ፡ ትፍሥሕተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ተረፈ፡ እንጦና፡ ውዱስ፡ ወተልሚደ፡ መቃርስ፡ ጻማዊ፨</t:l>
                  <t:l n="2">ሰማያዊ፡ ብእሲ፡ ወመልአክ፡ ምድራዊ፨</t:l>
                  <t:l n="3">ብሔረ፡ አግዓዚ፡ ነጺራ፡ ብዙኀ፡ መንክራቲከ፡ ተኣምራዊ፨</t:l>
                  <t:l n="4">ትቤ፡ ትቤ፡ በቃለ፡ ማሕሌት፡ ስንዓዊ፨</t:l>
                  <t:l n="5">ፀሓየ፡ ኮነ፡ አረካዊ፡ ኮከበ፡ ኮነ፡ አረጋዊ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ ዐምደ፡ ጳዝዮን፡ ትኩል፨</t:l>
                  <t:l n="2">ወደብተራ፡ ብርሃን፡ ጽዱል፨</t:l>
                  <t:l n="3">አረጋዊ፡ ጴጥሮስ፡ ሱታፌ፡ ወንጌል፨</t:l>
                  <t:l n="4">ኀያል፡ መስተጋድል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ ለለ፡ ንብለከ፡ ሰላም፡ ሰላመ፡ ዳኅና፡ ሀበነ፨</t:l>
                  <t:l n="2">አረጋዊ፡ መምህርነ፨</t:l>
                  <t:l n="3">ወህየንተ፡ ሰላም፡ ካዕበ፡ ዘየዐቅበነ፨</t:l>
                  <t:l n="4">ጸሎትከ፡ የሀሉ፡ ምስሌነ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
      </t:body>
