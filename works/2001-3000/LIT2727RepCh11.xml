         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2727RepCh11">
            <t:note>The following text reproduced after <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">መዓልተ፡ ዓመታት፡ አርብዓ፡ በደመና፡ ሰማይ፡ ልዑል፨</t:l>
                  <t:l n="2">ወምግበ፡ ለያልይ፡ ካዕበ፡ በብርሃነ፡ እሳት፡ ጽዱል፨</t:l>
                  <t:l n="3">ከመ፡ ለእስራኤል፡ መርሖሙ፡ ብርሃነ፡ ቅዱሳን፡ ቃል</t:l>
                  <t:l n="4">አባዲር፡ ምርሐኒ፡ ለገብርከ፡ ፍና፡ ዝክረ፡ ስምከ፡ ሐቅል፨</t:l>
                  <t:l n="5">ምስለ፡ እኅትከ፡ ኤራኢ፡ ድንግል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ተማሕፀንኩ፡ በድካምከ፡ እምጸዊረ፡ ማይ፡ በፃሕብ፨</t:l>
                  <t:l n="2">እለ፡ ውስተ፡ ሞቅሕ፡ ትርዳእ፡ እስመ፡ ምእመናን፡ ሕዝብ፨</t:l>
                  <t:l n="3">እንዘ፡ ይረድአከ፡ ክርስቶስ፡ ብዕለ፡ ሰሎሞን፡ ጥበብ፨</t:l>
                  <t:l n="4">ዘመደ፡ ኤራኢ፡ አባዲር፡ እመንገለ፡ እም፡ ወእብ፨</t:l>
                  <t:l n="5">ኩነኒ፡ ኃይለ፡ እምድካም፡ ዕፁብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ተማሕፀንኩ፡ በፍልሰትክሙ፡ ኤራኢ፡ ወአባዲር፨</t:l>
                  <t:l n="2">ውስተ፡ መካነ፡ ገድል፡ ስፉሕ፡ እምአንጾኪያ፡ ሀገር፨</t:l>
                  <t:l n="3">ከመ፡ አምክረክሙ፡ በሕልም፡ ፋሲለደስ፡ ክቡር፨</t:l>
                  <t:l n="4">ጸውዑኒ፡ መንገሌክሙ፡ በቃለ፡ ምዕዳን፡ ወምክር፨</t:l>
                  <t:l n="5">እስመ፡ ፅሩይ፡ ልብ፡ አነ፡ ወሀካይ፡ ገብር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ተማሕፀኩ፡ በከዊኖትክሙ፡ አናግደ፡ ብሔረ፡ እስሙናይን፨</t:l>
                  <t:l n="2">አመ፡ ምግበ፡ ሄሮድስ፡ ባቲ፡ ዘተአንገደ፡ መድኅን፡ ድኅረ፨</t:l>
                  <t:l n="3">አይድዓክሙ፡ ግብረ፡ አቡከረዙን፨</t:l>
                  <t:l n="4">አባዲር፡ ወኤራኢ፡ ቤተ፡ ፍቅርክሙ፡ ወይን፨</t:l>
                  <t:l n="5">አብኡኒ፡ ከመ፡ ይቤ፡ ሰሎሞን፡ ምእመን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ተማሕፀንኩ፡ በዑደትክሙ፡ መቅይሳ፡ ምሕራኤል፡ ኀበ፡ ሀሎ፨</t:l>
                  <t:l n="2">ከመ፡ እምኔሃ፡ ትርአዩ፡ መንክረ፡ ትሩፋት፡ ወተጋድሎ፨</t:l>
                  <t:l n="3">አባዲር፡ ወኤራኢ፡ ሥርግዋነ፡ ንጽሕ፡ ወተደንግሎ፨</t:l>
                  <t:l n="4">ሐውፁ፡ እለ፡ በደይን፡ ወበውስተ፡ ግሩም፡ ተኃጕሎ፨</t:l>
                  <t:l n="5">እስመ፡ ኪዳነ፡ ሣህል፡ ወሀበክሙ፡ ዘይኰንን፡ ኵሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ተማሕፀንኩ፡ በኅድረትክሙ፡ ሰዱሰ፡ መዋዕለ፨</t:l>
                  <t:l n="2">ውስተ፡ ምድረ፡ ጻድቅ፡ ሳሙኤል፡ ዘበምድረ፡ ጌላ፡ ተልዕለ፨</t:l>
                  <t:l n="3">አባዲር፡ ወኤራኢ፡ እለ፡ ኃበርክሙ፡ ገድለ፨</t:l>
                  <t:l n="4">አኅድሩኒ፡ በጥቃክሙ፡ እንዘ፡ ትገብሩ፡ ሣህለ፨</t:l>
                  <t:l n="5">ወአስተሳትፉኒ፡ ምስሌክሙ፡ ዕበየ፡ ወብዕለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ተማሕፀንኩ፡ በዕርገትከ፡ ዲበ፡ ምክያደ፡ ገድል፡ ስፉሕ፨</t:l>
                  <t:l n="2">ወበተሰትሮትካ፡ ካዕበ፡ ለመስትረ፡ ሐፂን፡ በሊሕ፨</t:l>
                  <t:l n="3">ሥቃየ፡ ኤራኢ፡ ቅድስት፡ በውጠ፡ ኵነኔ፡ መፍርህ፨</t:l>
                  <t:l n="4">አባዲር፡ ተዘኪረከ፡ በሰዓተ፡ ብካይ፡ ወላህ፨</t:l>
                  <t:l n="5">ትፍሥሕተ፡ ልቡና፡ ኵነኒ፡ በረድኤት፡ ብዙኅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ተማሕፀንኩ፡ በሙቃሔከ፡ ውስተ፡ ቤተ፡ ሞቅሕ፡ እንበለ፡ ነውር፨</t:l>
                  <t:l n="2">ከመ፡ ተሞቅሐ፡ ዮሴፍ፡ እንዘ፡ ውስተ፡ ሠናይ፡ ግብር፨</t:l>
                  <t:l n="3">አባዲር፡ ሰማዕት፡ ወልደ፡ በክራጥስ፡ ፍቁር፨</t:l>
                  <t:l n="4">ኪያከ፡ ሶበ፡ ነጸሩ፡ ምስለ፡ ኤራኢ፡ በክብር፨</t:l>
                  <t:l n="5">ሕዝበ፡ መኰንን፡ አንከሩ፡ ወተሀውከት፡ ምድር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ተማሕፀንኩ፡ በተቀንዎትከ፡ ምስለ፡ ፅፅ፡ ዐቢይ፨</t:l>
                  <t:l n="2">ከመ፡ ዲበ፡ መስቀል፡ አይሁድ፡ ለዘእም፡ ባሕርይ፡ ባሕርይ፨</t:l>
                  <t:l n="3">ምስለ፡ ኤራኢ፡ ድንግል፡ ሠናይተ፡ ላህይ፨</t:l>
                  <t:l n="4">ከመ፡ አንጸሕ፡ እምጌጋይየ፡ በደመ፡ ስምዕከ፡ ማይ፨</t:l>
                  <t:l n="5">በአዛበ፡ ጸጋ፡ ንዝኃኒ፡ አባዲር፡ ኅሩይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ተማሕፀንኩ፡ በተወድዮትከ፡ ውስተ፡ ከርሠ፡ ጤገን፨</t:l>
                  <t:l n="2">መጠነ፡ ዕለታት፡ ሠላስ፡ እንዘ፡ ታሕቴሁ፡ እሳት፨</t:l>
                  <t:l n="3">አባዲር፡ ንጉሥ፡ እኅወ፡ ኤራኢ፡ ንግሥት፨</t:l>
                  <t:l n="4">ማኅፀንተከ፡ ተራድአኒ፡ በዕለተ፡ ግሩም፡ ግሩም፡ ቅስት፨</t:l>
                  <t:l n="5">እስመ፡ ለከ፡ ኃይል፡ ወለከ፡ ረድኤት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ተማሕፀንኩ፡ በቀዊሞትክሙ፡ ውስተ፡ ምክያደ፡ ብርት፡ በሰንዕ፨</t:l>
                  <t:l n="2">ከመ፡ አስካለ፡ ወይን፡ ጥዑም፡ እስከ፡ ዓፀሩክሙ፡ ሰብእ፨</t:l>
                  <t:l n="3">ኤራኢ፡ አግዝአት፡ ወአበዲር፡ እግዚእ፨</t:l>
                  <t:l n="4">ነፍስየ፡ አስተፃ፡ ንዑ፡ እስመ፡ ነፍሰ፡ ብእሲ፡ ኃጥእ፨</t:l>
                  <t:l n="5">አመ፡ በደብረ፡ ጽዮን፡ ድኅረ፡ ይቀውም፡ በግዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ተማሕፀንኩ፡ በተመትሮታ፡ ለክሳድከ፡ ዳግመ፨</t:l>
                  <t:l n="2">በሰይፈ፡ ሐራዊ፡ ኤራኢ፡ እምድኅረ፡ መትረት፡ ቅድመ፨</t:l>
                  <t:l n="3">አባዲር፡ እምገድል፡ እስመ፡ ልብከ፡ ኢደክመ፨</t:l>
                  <t:l n="4">ክርስቶስ፡ ተካየደከ፡ ወወሀበከ፡ ሰላመ፨</t:l>
                  <t:l n="5">አመ፡ ለአጽንዖ፡ ኪያከ፡ በጥቃከ፡ ቆመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ተማሕፀንኩ፡ በደምክሙ፡ ድኅረ፡ ከመ፡ ማይ፡ ተክዕወ፨</t:l>
                  <t:l n="2">ዘአስተጋብአ፡ ሳሙኤል፡ አስተጋብኦ፡ ፍትወ፨</t:l>
                  <t:l n="3">አባዲር፡ ወኤራኢ፡ ዘአሥመሮክሙ፡ ሕያወ፨</t:l>
                  <t:l n="4">አንብሩ፡ ዲበ፡ ርእስከ፡ አክሊለ፡ በረከት፡ ፅዕድወ፨</t:l>
                  <t:l n="5">እስመ፡ ለክብርክሙ፡ ዘንተ፡ መውኩ፡ ድልወ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ አባዲር፡ ሠርዌሃ፡ ለመቅደሰ፡ ገድል፡ ዓባይ፨</t:l>
                  <t:l n="2">ህየንተ፡ ዘበምድር፡ አድማዕከ፡ መንግሥተ፡ ሰማይ፨</t:l>
                  <t:l n="3">ወመዝገበ፡ ዘአዶናይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ ምክረ፡ ፋሲለደስ፡ አቡከ፡ ሶበ፡ ኣጽማዕከ፡ በእዝን፨</t:l>
                  <t:l n="2">ከመ፡ ጽላሎት፡ ረሰይከ፡ ግርማ፡ መኰንን፨</t:l>
                  <t:l n="3">አባዲር፡ ወሬዛ፡ ስን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለከ፡ ዘኢይጠፍእ፡ እሳተ፡ ከመ፡ ኢትርአይ፡ ግሙራ፨</t:l>
                  <t:l n="2">በእሳተ፡ ጤገን፡ ፈጸምካ፡ ብዝኃ፡ መከራ፨</t:l>
                  <t:l n="3">አባዲር፡ መስፍነ፡ ሐራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለካ፡ ለእኅትከ፡ ኤራኢ፡ አባዲር፡ እንዘ፡ ትሜህራ፡ ምሥጢረ፨</t:l>
                  <t:l n="2">ለተወክፎ፡ ሥቃይ፡ ፈለስከ•እምብሔር፡ ብሔረ፨</t:l>
                  <t:l n="3">ገድልከ፡ እስከ፡ ተነክረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለከ፡ ዘኢይትበተካ፡ ንስቲተ፡ ዜና፡ ምሕራኤል፡ ኃብል፨</t:l>
                  <t:l n="2">እስመ፡ ሰሐበከ፡ ጾርከ፡ አርዑተ፡ መስቀል፨</t:l>
                  <t:l n="3">አባዲር፡ መስተጋድል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከ፡ ብዕለ፡ በካራጥስ፡ እንዘ፡ ትሬሲ፡ ቀትለ፨</t:l>
                  <t:l n="2">አባዲር፡ ፃመውከ፡ ወአብዝኅከ፡ ገድለ፨</t:l>
                  <t:l n="3">በወንጌል፡ ከመ፡ ተብህለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ በዕለተ፡ ምንዳቤየ፡ አጽምአ፡ እዝነ፡ ዚአከ፡ ኀቤየ</t:l>
                  <t:l n="2">አባዲር፡ ክቡር፡ እግዚእየ፨</t:l>
                  <t:l n="3">አምጣነ፡ ጽኑዕ፡ ብከ፡ ትውክልተ፡ ዚአየ፨</t:l>
                  <t:l n="4">ወላዕሌከ፡ አስመከት፡ ነፍስየ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>