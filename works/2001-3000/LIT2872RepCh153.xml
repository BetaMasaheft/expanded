         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2872RepCh153">
            <t:div type="textpart" xml:id="masgabiya">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለተፈጥሮትክሙ፡ እምነፋስ፡ ወነድ፨</t:l>
                  <t:l n="2">ምስለ፡ ሰማያት፡ ወምድር፡ በዕለተ፡ እሑድ፨</t:l>
                  <t:l n="3">ዘታጸንዑ፡ እንስሳ፡ መንበረ፡ ሥላሴ፡ በእድ፨</t:l>
                  <t:l n="4">ክፍሉኒ፡ ለገብርክሙ፡ ለዘለክሙ፡ ጸማድ፨</t:l>
                  <t:l n="5">ከመ፡ እቁም፡ ምስሌክሙ፡ ድርገተ፡ በዐውድ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="malke" corresp="https://betamasaheft.eu/LIT2905RepCh186">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ ዘተለዐለ፡ ዕበዩ፨</t:l>
                  <t:l n="2">እምዝክረ፡ ከዋክብት፡ አርባዕ፡ መዋዕለ፡ ዓመታት፡ ዘይሌልዩ፨</t:l>
                  <t:l n="3">እንስሳ፡ አርባዕ፡ ለእግዚአብሔር፡ ጸወርተ፡ ሰማዩ፨</t:l>
                  <t:l n="4">ለዝክረ፡ ስምክሙ፡ ቦቱ፡ ከመ፡ ይሰንቀው፡ ማሕልዩ፨</t:l>
                  <t:l n="5">ነገረ፡ ጥበብ፡ በአፉየ፡ ደዩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስክሙ፡ አርአያ፡ በረድ፡ ንጹሕ፨</t:l>
                  <t:l n="2">ወዘሕብረ፡ ያክንት፡ ቀይሕ፨</t:l>
                  <t:l n="3">ሰረገላቲሁ፡ ኪሩቤል፡ ለአምላክ፡ ስቡሕ፨</t:l>
                  <t:l n="4">ጸግዉኒ፡ አጋእዝትየ፡ እምጸጋክሙ፡ ብዙኅ፨</t:l>
                  <t:l n="5">ናህየ፡ በሰርክ፡ ወሣህለ፡ በነግህ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="45">
                  <t:l n="1">ሰላም፡ ለቆምክሙ፡ ዘጥቀ፡ ሠናይ፨</t:l>
                  <t:l n="2">እምነ፡ ዓምደ፡ ወርቅ፡ ጽሩይ፨</t:l>
                  <t:l n="3">እንስሳ፡ አርባዕ፡ ጸወርተ፡ ሰማይ፨</t:l>
                  <t:l n="4">በከመ፡ ጽሑፍ፡ እንበለ፡ ይዕርብ፡ ፀሐይ፨</t:l>
                  <t:l n="5">ዐስበ፡ አስበ፡ ማሕሌትየ፡ አኃሥሥ፡ ነዳይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="46">
                  <t:l n="1">ሰላም፡ እብል፡ ለመልክእክሙ፡ መክብበ፨</t:l>
                  <t:l n="2">እንተ፡ ይሠረጎ፡ ላህበ፨</t:l>
                  <t:l n="3">እንስሳ፡ አርባዕ፡ ዘትሰመዩ፡ ኪሩበ፨</t:l>
                  <t:l n="4">ማሕሌትየ፡ በቅድሜክሙ፡ እመ፡ ሞገሰ፡ ረከበ፨</t:l>
                  <t:l n="5">ኑኀ፡ መዋዕል፡ ጸግዉኒ፡ ዓስበ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="47">
                  <t:l n="1">ኦመናብርተ፡ አምላክ፡ አርባዕቱ፡ እንስሳ፨</t:l>
                  <t:l n="2">ገጸ፡ ላህም፡ ወንስር፡ ገጸ፡ ሰብእ፡ ወገጸ፡ አንበሳ፨</t:l>
                  <t:l n="3">ዲበ፡ ፍጥረትክሙ፡ አልቦ፡ ዘለሞት፡ አበሳ፨</t:l>
                  <t:l n="4">ረስዩ፡ ፍሬ፡ ዐስብየ፡ ህየንተ፡ አሐዱ፡ ሠላሳ፨</t:l>
                  <t:l n="5">ወተውሳኩ፡ ምስለ፡ ምእት፡ ወስሳ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         
         
      </t:body>
