         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2953RepCh234">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ስብሐት፡ ለአብ፡ ወስብሐት፡ ለወልድ፡</t:l>
                  <t:l n="2">ምስለ፡ መንፈስ፡ ቅዱስ፡ ዋሕድ፨</t:l>
                  <t:l n="3">ከመ፡ እንዘ፡ እብል፡ እጽሐፍ፡ ሰማዕተ፡ አክሚም፡ ዐጸድ፨</t:l>
                  <t:l n="4">ዜና፡ ገድልክሙ፡ ዘእምተጋድሎ፡ ብዑድ፨</t:l>
                  <t:l n="5">መንፈሰ፡ ጥበብ፡ ምልኡኒ፡ እስመ፡ አነ፡ አብድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ተማኅጸንኩ፡ በደምክሙ፡ ከመ፡ ማየ፡ ፈለፍ፡ ዘተክዕወ፨</t:l>
                  <t:l n="2">በዕለተ፡ ልደቱ፡ እምድንግል፡ ለዘተሠገወ፨</t:l>
                  <t:l n="3">ሰማዕታተ፡ አክሚም፡ በገድል፡ ዘአሥመርክሙ፡ ሕያወ፨</t:l>
                  <t:l n="4">ክብረክሙ፡ ለተሳትፎ፡ ከመ፡ እትረከብ፡ ድልወ፨</t:l>
                  <t:l n="5">በሀብተ፡ ትሩፋት፡ ወገድል፡ ኩነኒ፡ አበወ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ተማኅፀንኩ፡ በኅድረትክሙ፡ ውሣጤ፡ ዓባይ፡ ፈለግ፨</t:l>
                  <t:l n="2">ለፈጽሞ፡ መፍቅድ፡ ዘነፍስ፡ እንዘ፡ አልብክሙ፡ ጹግ፨</t:l>
                  <t:l n="3">ዲዮስቆሮስ፡ ሥርዓት፡ ወሰከላስዮስ፡ ሕግ፡</t:l>
                  <t:l n="4">ምስሌክሙ፡ ወቢጽክሙ፡ አማዕታተ፡ አክሚም፡ አእሩግ፨</t:l>
                  <t:l n="5">ረስዩኒ፡ ቢጸ፡ አሀሉ፡ በደርግ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ተማኅጸንኩ፡ በሑረትክሙ፡ እንዘ፡ ቃለ፡ ራእይ፡ ትሰምዑ፨</t:l>
                  <t:l n="2">መንገለ፡ አረጋይ፡ ሙሴ፡ ሥርዓተ፡ እንጦኒ፡ ትንሥኡ፨</t:l>
                  <t:l n="3">ሰከላስዮስ፡ ፩ወዲዮስቆሮስ፡ ካልኡ፨</t:l>
                  <t:l n="4">ኪያየ፡ እምኃጢአት፡ መንገለ፡ ንስሐ፡ ጸውዑ፨</t:l>
                  <t:l n="5">ከመ፡ ቀዳሚ፡ ኤልያስ፡ ጸውዖ፡ ለረድኡ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ተማኅፀንኩ፡ በፍልሰትክሙ፡ ከመ፡ እምድራር፡ ኀበ፡ ድራር፨</t:l>
                  <t:l n="2">ውስተ፡ ዓፀደ፡ ሞት፡ እሞት፡ በአምልኮ፡ ዋሕድ፡ ወበኵር፨</t:l>
                  <t:l n="3">ኦሰማዕታት፡ ከዋክብተ፡ አክሚም፡ ጠፈር፨</t:l>
                  <t:l n="4">ኮከብ፡ ከመ፡ መርሖሙ፡ ለነገሥተ፡ ርኁቅ፡ ብሔር፨</t:l>
                  <t:l n="5">ምርሑኒ፡ ፍናሆሙ፡ ለጥበብ፡ ወምክር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ተማኅጸንኩ፡ በገድልክሙ፡ ኮርዮን፡ ወፊልሞን፨</t:l>
                  <t:l n="2">ምስለ፡ ሕዝበ፡ አክሚም፡ ሀገር፨ ሰማዕተ፡ ክርስቶስ፡ መድኅን፨</t:l>
                  <t:l n="3">ደመ፡ አዕሩግ፡ አንትሙ፡ ለገብርክሙ፡ ሕፃን፨</t:l>
                  <t:l n="4">ይኩነኒ፡ ልብሰ፡ ብርሃናዊ፡ አመምግበ፡ ጽልመት፡ ዕርቃን፨</t:l>
                  <t:l n="5">እስመ፡ ደምክሙ፡ ውእቱ፡ ብርሃን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ተማኅጸንኩ፡ አጋእዝትየ፡ ሰማዕታተ፡ አክሚም፡ ብክሙ፨</t:l>
                  <t:l n="2">እምገድልክሙ፡ ኅዳጠ፡ እንዘ፡ አነብብ፡ ለክሙ፨</t:l>
                  <t:l n="3">ባሕቱ፡ ኅዳጠ፡ ኢትበልዎ፡ አንትሙ፨</t:l>
                  <t:l n="4">ነጽሩ፡ አፍቅሮትየ፡ ወቀድሱኒ፡ ዳእሙ፨</t:l>
                  <t:l n="5">በዘቅዱሳን፡ አንትሙ፡ ኮንክሙ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke" corresp="https://betamasaheft.eu/LIT2818RepCh102">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለክሙ፡ ለርስትክሙ፡ አክሚም፡ ልሳናተ፡ ኵሉ፡ መካን፨</t:l>
                  <t:l n="2">ሰማዕታቲሃ፡ አንትሙ፡ እስመ፡ ኅሩያን፨</t:l>
                  <t:l n="3">ሰመይዋ፡ ደብረ፡ ጽዮን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለክሙ፡ ሥጋክሙ፡ ልብሰ፡ ሰማዕታተ፡ ሀገር፡ አክሚም፨</t:l>
                  <t:l n="2">በየማነ፡ መንግሥት፡ ትቁሙ፡ እምነ፡ ፀጋም፨</t:l>
                  <t:l n="3">ሐፀብክሙ፡ በማየ፡ ደም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለክሙ፡ ጥብሐ፡ በግዕ፡ ወላህም፡ በይነ፡ ክብረ፡ በዓል፡ ልማድ፨</t:l>
                  <t:l n="2">ህየንተ፡ ዝንቱሰ፡ ዮም፡ ሰማዕታተ፡ ወልድ፨</t:l>
                  <t:l n="3">ከዓውክሙ፡ ደመ፡ ክሳድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለክሙ፡ መንግሥተ፡ ሰማያት፡ ለክሙ፡ እስመ፡ ይእቲ፡ ድሉት፨</t:l>
                  <t:l n="2">ትግርምተ፡ መኰንን፡ ወሰይፍ፡ ከመ፡ ኢምንት፨</t:l>
                  <t:l n="3">ኮነክሙ፡ ሰማዕታት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለክሙ፡ ለእሳተ፡ ምድር፡ መግርህ፡ አእንተ፡ ፍቅረ፡ አብ፡ ወወልዱ፨</t:l>
                  <t:l n="2">ሰማዕታተ፡ አክሚም፡ አንትሙ፡ ለለ፩፨</t:l>
                  <t:l n="3">ቆምክሙ፡ ውስተ፡ ዓፀዱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለክሙ፡ ሰማዕታተ፡ አክሙም፡ ጥዑም፡ ለተናግሮ፡ በአፍ፨</t:l>
                  <t:l n="2">ዜና፡ ገድልክሙ፡ ጥቀ፡ ፍካሬ፡ መጽሐፍ፨</t:l>
                  <t:l n="3">ክብርክሙ፡ እስመ፡ ትሩፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለክሙ፡ አዕባነ፡ ህንደኬ፡ አክሚም፡ ሰማዕታተ፡ ክርስቶስ፡ ሥሉጥ፨</t:l>
                  <t:l n="2">በኃፍረት፡ ኢይሑር፡ ውስተ፡ ምሥራጥ፨</t:l>
                  <t:l n="3">ማኅቶተ፡ ብርሃን፡ ይኩነኒ፡ እንበለ፡ ተውላጥ፨</t:l>
                  <t:l n="4">ገድልክሙ፡ ዘአፍአ፡ ወውሥጥ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>