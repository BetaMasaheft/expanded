         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2965RepCh246">
            <t:div type="textpart" xml:id="malke"><t:note><t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላመ፡ ገብርኤል፡ መልአክ፡ በላዕለ፡ ማርያም፡ ዘአዕረፈ፨</t:l>
                  <t:l n="2">ከመ፡ እዜኑ፡ ሕዳጠ፡ ወአኮ፡ ትሩፈ፨</t:l>
                  <t:l n="3">እግዚአብሔር፡ ሀበኒ፡ ሲሳየ፡ ልቡና፡ መጽሐፈ፨</t:l>
                  <t:l n="4">ወአፉየ፡ ሙሴ፡ ለእመ፡ ኮነ፡ ጸያፈ፨</t:l>
                  <t:l n="5">ጰራቅሊጦስ፡ አሮን፡ ይኩነኒ፡ አፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለተፈጥሮትከ፡ በሌሊተ፡ አሑድ፡ ቀዳሙ፨</t:l>
                  <t:l n="2">እምኀበ፡ ወኢምንት፡ ግብር፡ ዘኢይጤየቅ፡ ትርጓሜ፡ ስሙ፨</t:l>
                  <t:l n="3">ሐዋርያ፡ ልደት፡ ገብርኤል፡ ለበለዓለም፡ ኮከበ፡ ሕልሙ፨</t:l>
                  <t:l n="4">እንተ፡ ተሥዕለ፡ በላዕሌከ፡ መልክአ፡ ሕፃን፡ ወእሙ፨</t:l>
                  <t:l n="5">ንጉሠ፡ አይሁድ፡ ዝንቱ፡ ዘይቤ፡ ማሕተሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘኢይተርጐም፡ ምሥጢር፨</t:l>
                  <t:l n="2">ባሕቱ፡ ይመስል፡ ብሂለ፡ እግዚእ፡ ወገብር፨</t:l>
                  <t:l n="3">ገብርኤል፡ ኪሩብ፡ ጸዋሬ፡ ዐቢይ፡ መንበር፨</t:l>
                  <t:l n="4">ሕዝቅኤል፡ ዘነጸረከ፡ በአምሳለ፡ ብእሲ፡ ክቡር፨</t:l>
                  <t:l n="5">ምስለ፡ ገጸ፡ ላሕም፡ ወአንበሳ፡ ወቀሊል፡ ንስር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ወለርእስከ፡ በአምኃ፨</t:l>
                  <t:l n="2">ዘአስተቀጸሎ፡ አምላክ፡ አክሊለ፡ ቅዳሴ፡ ስቡሐ፨</t:l>
                  <t:l n="3">ገብርኤል፡ ፀሓይ፡ እንተ፡ ትሠርቅ፡ ጽባሐ፨</t:l>
                  <t:l n="4">ብርሃነ፡ ቃልከ፡ እስከ፡ አጽናፈ፡ ምድር፡ በጽሐ፨</t:l>
                  <t:l n="5">ወውስተ፡ ኵሉ፡ ዓለም፡ ጸዳልከ፡ ሰፍሐ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ አካለ፡ ፍሥሓ፡ ወኑዛዜ፨</t:l>
                  <t:l n="2">ወለመልክእከ፡ ሕያው፡ እምጥንተ፡ ዓለም፡ እስከ፡ ይእዜ፨</t:l>
                  <t:l n="3">አለብወኒ፡ ገብርኤል፡ ሐሳበ፡ መዋዕል፡ ዘበበ፡ ጊዜ፨</t:l>
                  <t:l n="4">እስራኤል፡ ልብየ፡ ጼዋ፡ ፋርስ፡ እስከ፡ ይከውን፡ አግኣዜ፨</t:l>
                  <t:l n="5">ውስተ፡ ምድረ፡ ርስት፡ ዳግመ፡ እገብእ፡ ማእዜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">አልቦእምሰብእ፡ ዘከማየ፡ ዘይቴክዝ፡ ነግሀ፡ ወሰርከ፨</t:l>
                  <t:l n="2">ወአልቦ፡ እመላእክት፡ ናዛዜ፡ ሕዙናን፡ ዘከማከ፨</t:l>
                  <t:l n="3">ወበእንተ፡ ዝ፡ ኀሠሥኩ፡ አእሚርየ፡ ኪያከ፨</t:l>
                  <t:l n="4">ኦገብርኤል፡ ናዝዘኒ፡ ወአስምዐኒ፡ ቃለከ፨</t:l>
                  <t:l n="5">ዕሤተ፡ ጸሎትየ፡ ዝንቱ፡ ዘአቅረብኩ፡ ለከ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         <t:div type="edition" xml:lang="gez" xml:id="div3LIT2965RepCh246">
            <t:div type="textpart" xml:id="div3div1LIT2965RepCh246"><t:note><t:bibl corresp="http://zotero.org/groups/358366/items/36J4KMXD"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Makweriya1976DersanaGabriel"/><title level="m">ድርሳነ፡ ገብርኤል። ከግዕዝ ወደአማርኛ፡ ተተርጓምና ተዘጋጅቶ (Dǝrsāna Gabrǝʾel, kagǝʿǝz wadaʾamārǝññā tatargʷǝmǝnnā tazagāǧǧǝto, ’Homiliary of Gabriel, translated from Gǝʿǝz to Amharic’)</title><author><name>Makʷǝriyā ʾAbyehoy</name></author><pubPlace>Addis Ababa</pubPlace><date>1976</date><note type="accessed">2026-01-14</note><note type="url">https://betamasaheft.eu/manuscripts/EMIP01281/</note><note type="tags"><note type="tag">bm:Makweriya1976DersanaGabriel</note></note><note type="tag">bm:Makweriya1976DersanaGabriel</note><t:citedRange unit="page">12–13</t:citedRange></t:bibl></t:note>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለከ፡ ሊቀ፡ መላእክት፡ ገብርኤል፡ ዘተልእከ፡ በልዕልና፡</t:l>
                  <t:l n="2">ኀበ፡ ማርያም፡ ድንግል፡ ለሐዲስ፡ ዜና።</t:l>
                  <t:l n="3">ከመ፡ ትስብክ፡ ጥንተ፡ ዳኅና።</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለከ፡ ገብርኤል፡ ለኤልሳቤጥ፡ ድኅረ፡ ተጸንሰ፡ እጓላ፡</t:l>
                  <t:l n="2">ለወለተ፡ ዳዊት፡ ትዜኑ፡ ብሥራተ፡ ተድላ፡</t:l>
                  <t:l n="3">ተፈኖከ፡ ምድረ፡ ገሊላ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለከ፡ ገብርኤል፡ ለማርያም፡ ሶበ፡ ቃልከ፡ አምኃ።</t:l>
                  <t:l n="2">ሰብአ፡ ኮነ፡ መለኮት፡ አሜሃ።</t:l>
                  <t:l n="3">ተዋሐደ። ምስለ፡ ሥጋሃ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለከ፡ ገብርኤል፡ ለማርያም፡ ኃይለ፡ ልዑል፡ ጸለላ፡</t:l>
                  <t:l n="2">መንፈስ፡ ቅዱስ፡ አንጽሐ፡ ሥጋ፡ አባላ፡</t:l>
                  <t:l n="3">ተፈሥሒ፡ ሶበ፡ ትቤላ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለከ፡ ለሰብአ፡ ሰገል፡ ዘመራኅኮሙ፡ በርእየተ፡ ኰከብ፡ እንግዳ።</t:l>
                  <t:l n="2">ኀበ፡ ማርያም፡ ድንግል፡ ወሕፃን፡ ወልዳ፡</t:l>
                  <t:l n="3">እስከ፡ በጽሑ፡ ምድረ፡ ይሁዳ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለከ፡ እንዘ፡ ትትሜሰል፡ ገብርኤል፡ ለወልደ፡ ድንግል፡ አርአያ።</t:l>
                  <t:l n="2">አመ፡ ማዕከለ፡ ነድ፡ ህልው፡ ለአናንያ፡</t:l>
                  <t:l n="3">ዘአቁረርከ፡ ከመ፡ አስሐትያ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለከ፡ ገብርኤል፡ በነደ፡ እሳት፡ ሥዑል።</t:l>
                  <t:l n="2">ሰላም፡ ለከ፡ ገብርኤል፡ በጌራ፡ ብርሃን፡ ክሉል።</t:l>
                  <t:l n="3">ሰላም፡ ለከ፡ ገብርኤል፡ መልአከ፡ መዊዕ፡ ወኃይል።</t:l>
                  <t:l n="4">ሰላም፡ ለከ፡ ገብርኤል፡ እንተ፡ ክንፍከ፡ ቀሊል።</t:l>
                  <t:l n="5">ጸልለኒ፡ በክንፍከ፡ እመንሱት፡ ወኀጉል።</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">በተአምኖ፡ እሴፎ፡ ትንባሌ፡ ዚአከ።</t:l>
                  <t:l n="2">መዓልተ፡ ወሌሊተ፡ ዕቀበኒ፡ አንተ፡ እመከራ፡ ሥጋ፡ ወነፍስ፡ ለገብርከ።</t:l>
               </t:lg>
            </t:div>
         </t:div>

         <t:div type="edition" xml:id="div4LIT2965RepCh246">
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab> በሰላመ፡ ገብርኤል፡ መልአክ፡ በላዕለ፡ ማርያም፡ ዘአዕረፈ። ከመ፡ እዜኑ፡ ኅዳጠ፡ ወአኮ፡ ትሩፈ። እግዚአብሔር፡ ሀበኒ፡ ልቡና፡
                  መጸሐፈ። </t:ab>
            </t:div>
           
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:note>This incipit is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/MNC008">Veroli, Monumento Nazionale Abbazia di Casamari, MNC-008</t:ref>.</t:note>
               <t:ab>ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተፀውዓ፡ ቀዲሙ። ለፀሐይ፡ እምዝክረ፡ ስሙ። ገብርኤል፡ ኅሩይ፡ ለእግዚአብሔር፡ መልአከ፡ አርያሙ።
                  እምጠባይአ፡ ሥጋከ፡ ካልዕ፡ ለጠባይ<t:supplied reason="omitted" resp="SH">ዕ</t:supplied>ከ፡ አቅሙ።
                  ነፋስ፡ ረቂቅ፡ ወእሳት፡ ቀለሙ። በሰላመ፡ ገብርኤል፡ መልአክ፡ በላዕለ፡ ማርያም፡ ዘአእረፈ። ከመ፡ እዜኑ፡ ኅዳጠ፡ ወአኮ፡ ትሩፈ።
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>