            <t:div type="textpart" subtype="incipit">
               <t:note>The source was previously not indicated. However, due to similarities in the beginning, it was possibly taken from 
                  <t:ref type="mss" corresp="https://betamasaheft.eu/BLorient557#ms_i1.8.2">London, British Library, BL Oriental 557: </t:ref>.</t:note>
