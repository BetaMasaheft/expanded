         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2932RepCh213">
            <t:div type="textpart" xml:id="masgabiya">
               <t:lg type="stanza" n="1">
                  <t:l>ሰላም፡ ለኪ፡ ማርያም፡ እምነ፨</t:l>
                  <t:l>መግመሪተ፡ ነድ፡ ርስነ፨</t:l>
                  <t:l>ዐምደ፡ ባሕርይ፡ ዘኢተእምሪ፡ ጸኒነ፨</t:l>
                  <t:l>ድንግልናተ፡ ክሌተ፡ ምልአ፡ ሥጋኪ፡ ተከድነ፨</t:l>
                  <t:l>አፍለሰኪ፡ ወልድ፡ ሉዓሌ፡ መካነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l>ምንተ፡ ኣዐሥዮ፡ ለእግዚአብሔር፡ አሐተ፨</t:l>
                  <t:l>በእንተ፡ ኵሉ፡ ዘገብረ፡ ሊተ፨</t:l>
                  <t:l>ረስዪኒ፡ እሙ፡ አሥምሮ፡ ግብተ፨</t:l>
                  <t:l>ማርያም፡ እግዝእትየ፡ ዘሜጥኪ፡ እሳተ፨</t:l>
                  <t:l>ድኅረ፡ በጽሐ፡ ልሳኑ፡ ዘለኪ፡ ቤተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l>አፉየ፡ አስተንፈሰ፡ ወልሳንየ፡ አልኆሰሰ፨</t:l>
                  <t:l>ለክብረ፡ ፍልሰትኪ፡ ድንግል፡ ሶበ፡ ኣቄርብ፡ ተውዳሰ፨</t:l>
                  <t:l>ማርያም፡ ዘኮንኪ፡ ቅድስተ፡ ቅዱሳን፡ መቅደሰ፨</t:l>
                  <t:l>በቅሜኪ፡ እግዝእትየ፡ እመ፡ ረከብኩ፡ ሞገሰ፨</t:l>
                  <t:l>በየማንኪ፡ ባርክኒ፡ ሥልሰ፨</t:l>
               </t:lg>

            </t:div>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ምስለ፡ ነፍስኪ፡ ኢመዋቲ፨</t:l>
                  <t:l>በተሰናእዎ፡ አሐቲ፨</t:l>
                  <t:l>ድንግል፡ በክልኤ፡ ማርያም፡ ወለተ፡ ማቲ፨</t:l>
                  <t:l>ሐመረ፡ ተርሴስ፡ ዘሰሎሞን፡ አንቲ፨</t:l>
                  <t:l>እንተ፡ አእተዉ፡ ጠቢባን፡ ወርቀ፡ አፌዝ፡ ባቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ መካነ፡ ፍሥሓ፡ ወኑዛዜ፨</t:l>
                  <t:l>ኀበ፡ ይረስዕዎ፡ ለላሕ፡ ወኢይሔልይዎ፡ ለትካዜ፨</t:l>
                  <t:l>ማርያም፡ ህሉት፡ ውስተ፡ ልበ፡ አምላክ፡ እምቅድመ፡ ጊዜ፨</t:l>
                  <t:l>ትፍሥሕተሰ፡ ተፈሣሕኩ፡ በፍልሰትኪ፡ ይእዜ፨</t:l>
                  <t:l>ገጸ፡ ዚአኪ፡ እሬኢ፡ ማእዜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ እግዚአብሔር፡ ዘባረካ፨</t:l>
                  <t:l>ወአልዐለ፡ ክብራ፡ እምፍልሰተ፡ ሄኖክ፡ ወልደ፡ ባረካ፨</t:l>
                  <t:l>ማርያም፡ ስብሕት፡ ወቡርክት፡ ዕለተ፡ ዋካ፨</t:l>
                  <t:l>ይገብሩ፡ በእንቲአኪ፡ ውስተ፡ ሰማያዊት፡ ታዕካ፨</t:l>
                  <t:l>ነገደ፡ መላእክት፡ አእላፍ፡ ሱባዔ፡ ፋሲካ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ውስተ፡ ልበ፡ ሰብእ፡ ዘኢተኀለየ፨</t:l>
                  <t:l>እንዘ፡ ትትዐጸፊ፡ ጸጋ፡ ወትለብሲ፡ ዕበየ፨</t:l>
                  <t:l>ማርያም፡ ሥጋኪ፡ ዘተመሰለ፡ ባሕርየ፨</t:l>
                  <t:l>ተኀፍረ፡ ሞት፡ አኮኑ፡ ሶበ፡ ነጸረ፡ ወርእየ፨</t:l>
                  <t:l>አመ፡ በደመና፡ ብሩህ፡ የዐርግ፡ ሰማየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ዘኢየኀልቅ፡ ሞገሱ፨</t:l>
                  <t:l>ወዘኢይነጽፍ፡ ባሕረ፡ ተውዳሱ፨</t:l>
                  <t:l>ማርያም፡ ታዕካ፡ ለእግዚአብሔር፡ ጽርሐ፡ መቅደሱ፨</t:l>
                  <t:l>ተበሀሉ፡ በሰማያት፡ እለ፡ ኪያኪ፡ አፍለሱ፨</t:l>
                  <t:l>ማርያምሰ፡ እንተ፡ በምድር፡ ታንሶሱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ዘአፈድፈደ፡ ስባሔ፨</t:l>
                  <t:l>እምፍልሰተ፡ ያዕቆብ፡ ዐርከ፡ ኤሎሄ፨</t:l>
                  <t:l>ማርያም፡ ቀንሞስ፡ ማርያም፡ አፈወ፡ ርሔ፨</t:l>
                  <t:l>እለ፡ ብርሃነ፡ ይለብሱ፡ ወይትዐጸፉ፡ ሱራሔ፨</t:l>
                  <t:l>በዓለ፡ ፍልሰትኪ፡ ማርያም፡ ሰበኩ፡ ኵለሄ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ስቡሓ፡ ዘተሰብሐ፨</t:l>
                  <t:l>እምሥነ፡ ፀሓይ፡ ወወርኅ፡ ሥነ፡ ስብሐቲሁ፡ አብርሀ፨</t:l>
                  <t:l>ዘእንበሌኪ፡ ማርያም፡ ወዘእንበለ፡ ወልድኪ፡ በኵረ፡ ፍሥሓ፨</t:l>
                  <t:l>አልቦ፡ ለሞት፡ ማእሰሪሁ፡ ዘፈትሓ፨</t:l>
                  <t:l>ወሙታነ፡ እምሲኦል፡ አንቅሐ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ለሊቀ፡ ካህናት፡ ዘአደሞ፨</t:l>
                  <t:l>መሥዋዕተ፡ መድኃኒት፡ ያዕርግ፡ ቅድስተ፡ ቅዱሳን፡ ቀዊሞ፨</t:l>
                  <t:l>ለመልአከ፡ ሞት፡ ፀዋግ፡ መልአከ፡ በቀል፡ ወተቀይሞ፨</t:l>
                  <t:l>ሚመጠነ፡ አድወዮ፡ ወሚመጠነ፡ አሕመሞ፨</t:l>
                  <t:l>በዓለ፡ ፍልሰትኪ፡ ማርያም፡ ዘአምላክ፡ ሐተሞ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ እምዓለመ፡ መትሕት፡ ኀላፊ፨</t:l>
                  <t:l>ውስተ፡ ዐውደ፡ ቡሩክ፡ ወሱራፊ፨</t:l>
                  <t:l>ማርያም፡ ምዕዝት፡ እምሥነ፡ ጽጌያት፡ ዘወርኀ፡ ታውፊ፨</t:l>
                  <t:l>ናሁ፡ ተሠጠምኩ፡ ውስተ፡ ባሕረ፡ ስሕተት፡ ጽነፊ፨</t:l>
                  <t:l>በሐመረ፡ ንጽሕኪ፡ ወትረ፡ ኪያየ፡ ሐድፊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ዘአጥናን፡ ኀይሉ፨</t:l>
                  <t:l>ወዘአኤናዎን፡ መዝራዕተ፡ ብዕሉ፨</t:l>
                  <t:l>ማርያም፡ ዝክርኪ፡ ለትውልደ፡ ትውልድ፡ ዘይሄሉ፨</t:l>
                  <t:l>አምጻኢተ፡ ምሕረት፡ ማርያም፡ ለኃጥኣነ፡ ምድር፡ ኵሉ፨</t:l>
                  <t:l>ወቡርክት፡ ማርያም፡ ለክርስቶስ፡ አባሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ እግዚአብሔር፡ ዘአልዐሎ፨</t:l>
                  <t:l>እምፍልሰተ፡ ኤልያስ፡ ነቢየ፡ ሲሎ፨</t:l>
                  <t:l>ውስተ፡ ብሔረ፡ ፍግዕ፡ ስድኒ፡ ማርያም፡ በክነፈ፡ ዐውሎ፨</t:l>
                  <t:l>ለምንት፡ ሊተ፡ በፍግዓ፡ ወበጥዒና፡ እዴሎ፨</t:l>
                  <t:l>እንዘ፡ ይዴግነኒ፡ ሞት፡ ዘይኴንን፡ ኵሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ እግዚአብሔር፡ ዘተዋሐዳ፨</t:l>
                  <t:l>ወተካፈለ፡ ክበዳ፨</t:l>
                  <t:l>ለፍልሰትኪ፡ ማርያም፡ እምኢየሩሳሌም፡ ምድረ፡ ይሁዳ፨</t:l>
                  <t:l>ስኂነ፡ ተዝካር፡ ወአፈወ፡ ዕጣን፡ ጸዐዳ፨</t:l>
                  <t:l>ነገሥተ፡ ተርሴስ፡ ወደስያት፡ ያበውኡ፡ ጋዳ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ በሰዋስወ፡ ብርሃን፡ ምጡቅ፨</t:l>
                  <t:l>ከመ፡ ትኩኒዮሙ፡ እመ፡ ለኅሩያን፡ ደቂቅ፨</t:l>
                  <t:l>ተሣየጥኒ፡ ማርያም፡ በንዋየ፡ ሣህልኪ፡ ጽድቅ፨</t:l>
                  <t:l>ከመ፡ ይሣየጡ፡ አመ፡ ዕለተ፡ ፍዳ፡ ወጻዕቅ፨</t:l>
                  <t:l>ዘመደ፡ አዕዋፍ፡ ኀምስ፡ በክልኤ፡ ጸሪቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l>ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ውስተ፡ ብሔር፡ ስዑር፨</t:l>
                  <t:l>እንተ፡ ኬንያ፡ ወገባሪሃ፡ እግዚአብሔር፨</t:l>
                  <t:l>ማርያም፡ ፍትሕኒ፡ እምግብርናተ፡ ሞት፡ መሪር፨</t:l>
                  <t:l>ለኪሰ፡ ንግሥተ፡ ሰማይ፡ ወምድር፨</t:l>
                  <t:l>ኢይሰአነኪ፡ አግዕዞቱ፡ ለኃጥእ፡ ገብር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l>ሰላም፡ ለትንሣኤ፡ ሥጋኪ፡ ከመ፡ ትንሣኤ፡ ክርስቶስ፡ መንታ፨</t:l>
                  <t:l>ርእሶ፡ ሕያወ፡ እምድኅረ፡ ኀብአ፡ ውስቴታ፨</t:l>
                  <t:l>በጽላሎትኪ፡ ክድንኒ፡ ማርያም፡ ርግበ፡ ኤፍራታ፨</t:l>
                  <t:l>ሰውርኒ፡ በአክናፍኪ፡ አመ፡ ይከውን፡ ሐተታ፨</t:l>
                  <t:l>ወአመ፡ ታገብእ፡ ምድር፡ ዘነሥአት፡ ማሕፀንታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l>ሰላም፡ ለዕርገተ፡ ሥጋኪ፡ ዘተወጥነ፡ ቦቱ፨</t:l>
                  <t:l>ዕርገተ፡ ቅዱሳን፡ ሰብእ፡ እለ፡ ፈድፋደ፡ ተአኵቱ፨</t:l>
                  <t:l>ለሊቀ፡ ካህናት፡ አሮን፡ ማርያም፡ ሠርጐ፡ ትርሲቱ፨</t:l>
                  <t:l>ሥዑለ፡ ይኩን፡ በልብስኪ፡ እንተ፡ ላዕሉ፡ ወታሕቱ፨</t:l>
                  <t:l>ፍሬ፡ ከናፍር፡ ወአፍ፡ ውዳሴኪ፡ ዝንቱ፨</t:l>
               </t:lg>
            </t:div>

         </t:div>
      </t:body>
   </t:text></TEI>