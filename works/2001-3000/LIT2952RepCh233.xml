         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2952RepCh233">
            <t:note>The following incipit and explicit are based on <t:ref type="mss" corresp="https://betamasaheft.eu/EMML6251#ms_i3.71">Addis ʿAläm, ʾAddis ʿĀlam Māryām, MS EMML no. 6251: Hymn to Jesus Christ (in ms_i3.71)</t:ref>.</t:note>
            
            <t:div type="textpart" xml:lang="gez" xml:id="Twilight" corresp="https://betamasaheft.eu/LIT4286Hymn">
               <t:label>First salutation, for the twilight (ዘሠርክ፡)</t:label>                
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ ሀበነ፡ ሰላመከ፡ መምሕረ፡ ትሕትና፡ ክርስቶስ፡ ወልደ፡ አምላክ፡ ወሰብዕ።</t:l>
                     <t:l n="2">ጊዜ፡ ፍና፡ ሠርክ፡ በዓውደ፡ ምብልዕ፡</t:l>
                     <t:l n="3">ዘረፈቀ፡ ምስለ፡ አርዳእ።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ከከ፡ ዘንተ፡ ኵሎ፡ በእንተ፡ ፍቅረ፡ ስብዕ፡ ዘኮንከ።</t:l>
                     <t:l n="2">ለሕማም፡ ወሞት፡ እስከ፡ በጻሕከ።</t:l>
                     <t:l n="3">ይእዜኒ፡ ተወከፍ፡ ነግሃ፡ ወሠርከ።</t:l>
                     <t:l n="4"> ስብሐታት፡ ዘናቀርብ፡ ለከ።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Compline">
               <t:label>Second salutation, for the compline (ዘንዋም፡)</t:label>                
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ ስምዓነ፡ አምላክነ፡ ወሰላመከ፡ ሀበነ፡ እስመ፡ ወሀብከነ፡ ኵሎ።</t:l>
                     <t:l n="2">ስብሐተ፡ ዚአከ፡ ንንግር፡ እምትካት፡ ዘሀሎ።</t:l>
                     <t:l n="3">በመዓርግ፡ ወበበመትሎ።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ ዕቀበነ፡ ዘልፈ፡ እግዚኦ፡ በዛቲ፡ ዘዓት።</t:l>
                     <t:l n="2">እምእለ፡ ይብሕቱ፡ አጋንንት።</t:l>
                     <t:l n="3">ዓውደነ፡ ሕፅር፡ በሃይለ፡ መላእክት።</t:l> 
                     <t:l n="4">እስመ፡ ናሁ፡ ሰፈነ፡ ሌሊት።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Midnight">
               <t:label>Third salutation, for midnight (ዘመንፈቀ፡ ሌሊት፡)</t:label>                
               <t:lg type="stanza" n="1">
                     <t:l n="1"> ስብሐት፡ ለከ፡ ተዘከርኩ፡ በሌሊት፡ ብዝኃ፡ ትሕትናከ፡ ኵሎ፡ እንተ፡ የዓዱ፡ እምዓቅም። </t:l>
                     <t:l n="2">ጊዜ፡ አኃዙከ፡ ሠገራተ፡ ሮም፡ </t:l>
                     <t:l n="3">ኢየሱስ፡ ወልደ፡ ማርያም። </t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ መንፈቀ፡ ሌሊት፡ ድኅረ፡ ጊዜ፡ ይከውን፡ ወውዖ። </t:l>
                     <t:l n="2">ቤተከ፡ ነሃሉ፡ በተጋብኦ። </t:l>
                     <t:l n="3">ሶበ፡ ሰአልናከ፡ በአስተብቍዖ። </t:l>
                     <t:l n="4">አርኁ፡ ለነ፡ እግዚኦ፡ እግዚኦ።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Morning">
               <t:label>Fourth salutation, for the morning (ዘነግህ፡)</t:label>               
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ ከመ፡ ንንግር፡ ኵሎ፡ ስብሐቲከ፡ በአናቅጺሃ፡ ለጽዮን፡ ማኅደረ፡ ብዙኅ፡ ሰላም።</t:l>
                     <t:l n="2">ዘአንቃሕከነ፡ እምነ፡ ንዋም።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ አኰቴተ፡ ስብሐት፡ ወትረ፡ ለመንግሥትከ፡ ስቡሕ።</t:l>
                     <t:l n="2">ጊዜ፡ እምንዋምነ፡ ንነቅሕ። </t:l>
                     <t:l n="3">ናቀርብ፡ ለከ፡ በቃለ፡ ክላህ።</t:l>
                     <t:l n="4">ወንፌኑ፡ ስብሐተ፡ ዘነግህ።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Third">
               <t:label>Fifth salutation, for the third hour (ዘ፫፡ ሰዓት፡)</t:label>            
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ እኤምኅ፡ አእጋሪከ፡ በጊዜ፡ ሰለስቱ፡ ሰዓት፡ ቅድመ፡ ጲላጦስ፡ ዘቆማ።</t:l>
                     <t:l n="2">ኢየሱስ፡ ጠቢብ፡ ወንጉሥ፡ ፌማ።</t:l>
                     <t:l n="3">ዘአድከምከ፡ ኃይለ፡ መስቴማ።</t:l>
                  </t:lg>  
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ ኀበ፡ ሐዋርያት፡ ገብሩ፡ በጽርሐ፡ ጽዮን፡ እንግልጋ፡</t:l>
                     <t:l n="2">ዘፈኖከ፡ ሎሙ፡ መንፈሰ፡ ጸጋ።</t:l>
                     <t:l n="3">ፈኑ፡ ለነ፡ እንበለ፡ ንትጋ። </t:l>
                     <t:l n="4">ያኅድገነ፡ ምግባረ፡ ዘሥጋ።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Sixth">
               <t:label>Sixth salutation, for the sixth hour (ዘ፮፡ ሰዓት፡)</t:label>                  
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ ኦዘተቀኖከ፡ ኢየሱስ፡ ጻድቅ፡ ማዕከለ፡ ፪፡ ፈያት፡</t:l>
                     <t:l n="2">እንዘ፡ ኢትከውን፡ አንተ፡ ገባሬ፡ ዕኪት።</t:l>
                     <t:l n="3">ከመ፡ ትሥዓር፡ ቀኖተ፡ ሞት።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ ሕፅረነ፡ ወትረ፡ እግዚኦ፡ ለደቂቀ፡ ዛቲ፡ ማኅበር።</t:l>
                     <t:l n="2">በመስቀልከ፡ መግረሬ፡ ፀር።</t:l>
                     <t:l n="3">እምድድቅ፡ ወእምጋኔነ፡ ቀትር።</t:l>
                     <t:l n="4">ወእምኵሉ፡ ዘይመጽእ፡ ግብር።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Ninth" corresp="https://betamasaheft.eu/LIT4518Hymn">
               <t:label>Seventh salutation, for the ninth hour (ዘ፱፡ ሰዓት፡)</t:label>                    
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ አምላኪየ፡ አምላኪየ፡ ነጽረኒ፡ ወትረ፡ ወኢትኅድገኒ፡ ዘልፈ።</t:l>
                     <t:l n="2">እስመ፡ አንተ፡ ትቤ፡ ከሢተከ፡ አፈ።</t:l>
                     <t:l n="3">ትፈጽም፡ ሕገ፡ ተጽሕፈ።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="7">
                     <t:l n="1">ስብሐት፡ ለከ፡ ተወከፍ፡ ሊተ፡ እግዚኦ፡ ከመ፡ ቍርባን፡ ጥሉል። </t:l>
                     <t:l n="2">በበሱባዔ፡ እንዘ፡ እክፍል።</t:l>
                     <t:l n="3">ዘአቅረብኩ፡ ለከ፡ ኍልቈ፡ ኢዮቤል፡</t:l>
                     <t:l n="4">ስብሐታተ፡ በዘአንሰ፡ እክል።</t:l>
               </t:lg>   
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="AllHours">
               <t:label>Eighth salutation, for all the hours (ዘኵሎን፡ ጊዜያት፡)</t:label>
               <t:lg type="stanza" n="1">
                     <t:l n="1">ስብሐት፡ ለከ፡ ዘበሰማያት፡ አቡነ፡ ዘበምድር፡ ዓዲ።</t:l>
                     <t:l n="2">ግብተ፡ እንበለ፡ ታጐንዲ።</t:l>
                     <t:l n="3">ዘታብዕል፡ ወዘታነዲ።</t:l>
                  </t:lg>   
               <t:lg type="stanza" n="11">
                     <t:l n="1">ስብሐት፡ ለከ፡ ዘመሐረኒ፡ ወልድከ፡ ጸሎተ፡ ብዙኃን፡ እንግልጋ።</t:l>
                     <t:l n="2">ሶበ፡ ንጼሊ፡ ነበለ፡ ንትጋ።</t:l>
                     <t:l n="3">እግዚኦ፡ ሀበነ፡ መንፈሰ፡ ጸጋ፡</t:l>
                     <t:l n="4">ዘይሤኒ፡ ላዕለ፡ ነፍስ፡ ወሥጋ።</t:l>
               </t:lg>   
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>