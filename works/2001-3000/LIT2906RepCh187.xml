         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2906RepCh187">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ ዘአልባስጥሮስ፡ አፈው፨</t:l>
                  <t:l n="2">ወለሥዕርትክሙ፡ ሰላም፡ ዘድላሌሁ፡ ፍትው፨</t:l>
                  <t:l n="3">ምቱረ፡ ክሳድ፡ ጳውሎስ፡ ወጴጥሮስ፡ ቅንው፨</t:l>
                  <t:l n="4">ተራወጸ፡ ውስተ፡ ልብየ፡ ምስለ፡ መዐዛሁ፡ ቅድው፨</t:l>
                  <t:l n="5">ቃለ፡ ደምክሙ፡ ሐዋርያ፡ ዘእግሩ፡ ከዋው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለርእስክሙ፡ ጌራ፡ መድኃኒት፡ ዘተረሰያ፨</t:l>
                  <t:l n="2">ወለገጽክሙ፡ ስቡሕ፡ እምሥነ፡ ኦርያሬስ፡ ወአሶንያ፨</t:l>
                  <t:l n="3">ኰኵሐ፡ ሃይማኖት፡ ጴጥሮስ፡ ወጳውሎስ፡ ሐዋርያ፨</t:l>
                  <t:l n="4">ይትነዛኅ፡ ዲበ፡ ርእስየ፡ ወበልብስየ፡ ትብልያ፨</t:l>
                  <t:l n="5">ነቅዐ፡ ደምክሙ፡ ከመ፡ ማይ፡ ዘውሕዘ፡ በሮምያ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋክሙ፡ በሰንዶናት፡ ወአፈዋት፨</t:l>
                  <t:l n="2">ወለዝኅርክሙ፡ ሐዲስ፡ ምድረ፡ ሮምያ፡ ቅድስት፨</t:l>
                  <t:l n="3">ጳውሎስ፡ ወጵጥሮስ፡ ባሕረ፡ ጥበባት፨</t:l>
                  <t:l n="4">ዑድዎ፡ ለሕይወትየ፡ ዘምስለ፡ ኅሩያን፡ አርድእት፨</t:l>
                  <t:l n="5">ከመ፡ የዐውድዎ፡ ሠራዊት፡ ለዐቢይ፡ በቀልት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለአልባሲክሙ፡ ወለቅናቲክሙ፡ በበ፡ ገጹ፨</t:l>
                  <t:l n="2">ለአክሊልክሙ፡ ብሩህ፡ ወለሰበንክሙ፡ ቢጹ፨</t:l>
                  <t:l n="3">ጳውሎስ፡ ወጴጥሮስ፡ ለክርስቶስ፡ አቀብተ፡ አንቀጹ፨</t:l>
                  <t:l n="4">ኪያየ፡ ትሑተ፡ እምሰማያት፡ ሐውጹ፨</t:l>
                  <t:l n="5">ወዲበ፡ ርእስየ፡ ዘመዊእ፡ አቅርንተ፡ አስርጹ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ እብል፡ ለአዕጽምቲክሙ፡ በበ፡ ጾታ፨</t:l>
                  <t:l n="2">እለ፡ ይጸንሐ፡ ትንሣኤ፡ እስከ፡ ዕለተ፡ ፍትሕ፡ ወሐተታ፨</t:l>
                  <t:l n="3">ጳውሎስ፡ ወጴጥሮስ፡ ጸወርተ፡ መስቀል፡ ዘጎልጎታ፨</t:l>
                  <t:l n="4">ምድረ፡ ሮምያ፡ ዝኅርክሙ፡ ለኢየሩሳሌም፡ ካልእታ፨</t:l>
                  <t:l n="5">እምነ፡ ብሩር፡ ወወርቅ፡ ይክብር፡ መሬታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለበትረ፡ እዴክሙ፡ ዘውገ፡ በትረ፡ ኤርምያስ፡ ለውዝ፨</t:l>
                  <t:l n="2">ወለአሣእኒክሙ፡ ዘእግር፡ እንተ፡ ይትበደር፡ እምቤዝ፨</t:l>
                  <t:l n="3">አመ፡ ሃይማኖት፡ ጴጥሮስ፡ ወጳውሎስ፡ አርዝ፨</t:l>
                  <t:l n="4">ሶበ፡ ሰተይክዎ፡ ለፍቅርክሙ፡ ወይነ፡ ፍሥሓ፡ ሐዋዝ፨</t:l>
                  <t:l n="5">እምድረ፡ ልብየ፡ ወሥጋየ፡ ተሥዕረ፡ ትካዝ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለመስቀል፡ በደመ፡ ጴጥሮስ፡ ዘተቀደሰ፨</t:l>
                  <t:l n="2">ወሰይፍ፡ በሊኅ፡ እምደመ፡ ጳውሎስ፡ ዘርኅሰ፨</t:l>
                  <t:l n="3">ሐዋርያተ፡ ክርስቶስ፡ አንትሙ፡ ዘነሣእክሙ፡ ሞገሰ፨</t:l>
                  <t:l n="4">ትቅሥሙ፡ ቅሥመ፡ እምአፉየ፡ ማሕሌተክሙ፡ ሐዲሰ፨</t:l>
                  <t:l n="5">እስመ፡ ጊዜ፡ ገሚድ፡ በጽሐ፡ ነጽሩ፡ በለሰ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ኦጴጥሮስ፡ ወጳውሎስ፡ ዘነሣእክሙ፡ ትእዛዘ፨</t:l>
                  <t:l n="2">ማሕሌተ፡ ዝክርክሙ፡ ባርኩ፡ ወረሰይዎ፡ ሐዋዘ፨</t:l>
                  <t:l n="3">ለዘሰአለክሙ፡ ብእሲ፡ ከመ፡ ኢይርከብ፡ ትካዘ፨</t:l>
                  <t:l n="4">ሀብዎ፡ ኀይለ፡ ወመዊአ፡ ለእመ፡ አርዌ፡ ምድር፡ አኀዘ፨</t:l>
                  <t:l n="5">ወለእመኒ፡ ሰረበ፡ ዘይቀትል፡ ሕምዘ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">መጽሐፈ፡ ዜና፡ ያንብሩ፡ ጸሐፍተ፡ እስራኤል፡ ወይሁዳ፨</t:l>
                  <t:l n="2">እንተ፡ ተክዕወ፡ ደሞሙ፡ ለኢየሩሳሌም፡ መንገለ፡ ዐውዳ፨</t:l>
                  <t:l n="3">እንዘ፡ ደመ፡ ጴጥሮስ፡ ቀለም፡ ወደመ፡ ጳውሎስ፡ ጽጌ፡ ረዳ፨</t:l>
                  <t:l n="4">ይግበሩ፡ ረቀ፡ እምፈተውኩ፡ ዘዚአየ፡ አነደ፨</t:l>
                  <t:l n="5">ወአዕጽምትየ፡ ይረስዩ፡ ስፉሐ፡ ሰሌዳ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ እብል፡ ብርሃናተ፡ ክልኤተ፨</t:l>
                  <t:l n="2">በዐውደ፡ ንጉሥ፡ ኔሮን፡ እለ፡ አድምዑ፡ ሩጸተ፨</t:l>
                  <t:l n="3">ጳውሎስ፡ ወጴጥሮስ፡ እንዘ፡ ያጸንዑ፡ ጸበርተ፨</t:l>
                  <t:l n="4">አሐዱ፡ በመስቀል፡ ተሰቀለ፡ ቍልቍሊተ፨</t:l>
                  <t:l n="5">ወአሐዱ፡ ተመትረ፡ ክሳዶ፡ ክብርተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ተዘኪረከ፡ ክርስቶስ፡ ለሐዋርያት፡ ኵሎሙ፨</t:l>
                  <t:l n="2">ህየንተ፡ ክቡር፡ ደምከ፡ እንተ፡ ተክዕወ፡ ደሞሙ፨</t:l>
                  <t:l n="3">አክሊለ፡ ስምዕ፡ ሀበኒ፡ ከመ፡ እሳተፍ፡ ስምዖሙ፨</t:l>
                  <t:l n="4">ወደምስስ፡ ለአፅራርየ፡ እመጽሐፈ፡ ሕይወት፡ ዝክሮሙ፨</t:l>
                  <t:l n="5">ከመ፡ ለይሁዳ፡ ረሲዕ፡ ተደምሰሰ፡ ስሙ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>