         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2851RepCh133">
            <t:div type="textpart" xml:id="masgabiya">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ዕጹብ፡ ገድልከ፡ ወመንክርከ፡ ኀያል፨</t:l>
                  <t:l n="2">እምእለ፡ አድባራት፡ ዔሉ፡ ስሙዓነ፡ ዜና፡ ወገድል፨</t:l>
                  <t:l n="3">አቡነ፡ ኪሮስ፡ ተወካፌ፡ ኪዳን፡ ወቃል፨</t:l>
                  <t:l n="4">ለዘተአመነ፡ በጸሎትከ፡ ኢትዮጵያዊ፡ ባዕል፨</t:l>
                  <t:l n="5">እስመ፡ አድኀንኮ፡ እመንሱት፡ ወሀጕል፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ኀበ፡ ዐምደ፡ ወርቅ፡ ዘተጽሐፈ፨</t:l>
                  <t:l n="2">ምስለ፡ ስመ፡ አበው፡ ኄራን፡ እንዘ፡ ይከውን፡ ሱቱፈ፨</t:l>
                  <t:l n="3">ጻድቅ፡ ኪሮስ፡ እንተ፡ ታገኒ፡ አእላፈ፨</t:l>
                  <t:l n="4">አባ፡ ሀበኒ፡ ለወልድከ፡ ሰማያዊተ፡ ምዕራፈ፨</t:l>
                  <t:l n="5">ወዘመላእክት፡ አስኬማ፡ ወዐጽፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ወለርእስከ፡ በእማኄ፨</t:l>
                  <t:l n="2">ወለገጽከ፡ ጽዱል፡ እንተ፡ ተሳተፈ፡ ሥነ፡ ሱራሔ፨</t:l>
                  <t:l n="3">ጻድቅ፡ ኪሮስ፡ ወምዑዘ፡ ምግባር፡ እምነ፡ ርሔ፨</t:l>
                  <t:l n="4">እምግብረ፡ ሰይጣን፡ ዘኢለመደ፡ ርኅራኄ፨</t:l>
                  <t:l n="5">ኀይለ፡ ጸሎትከ፡ ይኩነኒ፡ ባላሔ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ መዐዛ፡ ክርስቶስ፡ ወሜዐ፨</t:l>
                  <t:l n="2">ወለመቃብሪከ፡ ሰላም፡ በሥምረተ፡ ክርስቶስ፡ ንጉሠ፡ መርዓ፨</t:l>
                  <t:l n="3">ጻድቅ፡ ኪሮስ፡ ጊዜ፡ ይደምፅ፡ ቀርነ፡ ውውዐ፨</t:l>
                  <t:l n="4">ያኅቱ፡ መኃትውየ፡ ዘዚአከ፡ ቅብዐ፨</t:l>
                  <t:l n="5">አርአያ፡ አብዳት፡ ኢይቁም፡ በአፍአ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ስብሐተ፡ መልክእከ፡ ኅዳጠ፡ አምጣነ፡ ብየ፡ አቅረብኩ፨</t:l>
                  <t:l n="2">እምአመ፡ ንእስየ፡ አበ፡ እስመ፡ ኪያከ፡ ረሰይኩ፨</t:l>
                  <t:l n="3">ጻድቅ፡ ኪሮስ፡ ለሕይወትየ፡ በሳን፡ ሰርኩ፨</t:l>
                  <t:l n="4">አድኅነኒ፡ ወባልሐኒ፡ በጽንዐ፡ እዴከ፡ ዝኩ፨</t:l>
                  <t:l n="5">ቅድመ፡ ይንሥአኒ፡ ለዓለም፡ መልአኩ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ በእንቲአከ፡ ተብህለ፡ እመድሎተ፡ ሰማይ፡ ወምድር፨</t:l>
                  <t:l n="2">ይፈደፍድ፡ ጥቀ፡ ዘእግርከ፡ ጽፍር፨</t:l>
                  <t:l n="3">ኪሮስ፡ ምሉአ፡ ክብር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለከ፡ እግዚአብሔር፡ ይብለከ፡ እምኑኀ፡ ሰማይ፡ ወሪዶ፨</t:l>
                  <t:l n="2">በስምከ፡ ኪሮስ፡ ዘይሰሚ፡ ወልዶ፨</t:l>
                  <t:l n="3">እምበረከትከ፡ ኢያውሕዶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለከ፡ ነፍስየ፡ ኪሮስ፡ አወፈይኩከ፡ ዕጣነ፨</t:l>
                  <t:l n="2">ማዕኰት፡ ብከ፡ ወሥልጣነ፨</t:l>
                  <t:l n="3">ለሰሚዐ፡ ገድል፡ እለ፡ ተጋባእነ፨</t:l>
                  <t:l n="4">ዘብሩር፡ ክንፈከ፡ ክድነነ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         <t:div type="edition" xml:id="div3LIT2851RepCh133">
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab>
                  ሰላም፡ ለዝክረ፡ ስምከ፡ ኀበ፡ ዓምደ፡ ወርቅ፡ ዘተጽሕፈ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="incipit" xml:lang="gez">
               <t:ab>
                  ሰላም፡ ለዝክረ፡ ስምከ፡ ዐምደ፡ ወርቅ፡ ዘተጽሕፈ።
               </t:ab>
            </t:div>
         </t:div>
         
