         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2765RepCh49">
            <t:note>The following text reproduced after <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ ሰዳዴ፡ ሰይጣናት፡ ፋኑኤል፡ ለእግዚአብሔር፡ እምጽርሑ፨</t:l>
                  <t:l n="2">ከመ፡ ኢይስክዩ፡ ሰብአ፡ እለ፡ ይኔስሑ፨</t:l>
                  <t:l n="3">ገቤጋይ፡ ዘዘዚአሁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ ሰዳዴ፡ አጋንንት፡ ፋኑኤል፡ እምገጸ፡ ፈጣሪ፡ ልዑል፨</t:l>
                  <t:l n="2">ኢያስተዋድዩ፡ ሰብአ፡ በነገረ፡ ሐጕል፨</t:l>
                  <t:l n="3">እስመ፡ አንተ፡ መልአከ፡ ሣህል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለከ፡ ሰይጣናተ፡ ስድድ፡ እምላዕሌየ፡ እግዚኦ፨</t:l>
                  <t:l n="2">ፋኑኤል፡ ትጉህ፡ መልአከ፡ አልፋ፡ ወኦ፨</t:l>
                  <t:l n="3">እስመ፡ ብየ፡ ሕገ፡ ተሰብኦ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለከ፡ ፋኑኤል፡ ግበር፡ ትእምርተ፡ ሠናየ፡ ላዕሌየ፨</t:l>
                  <t:l n="2">በኲናት፡ ጸሊም፡ ኢይርግዝ፡ ገቦየ፨</t:l>
                  <t:l n="3">ዘአንሀበ፡ በእንቲአየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለከ፡ ለስምከ፡ ነሀብ፡ ለለ፡ ጽባሑ፡ ስብሐተ፨</t:l>
                  <t:l n="2">ፋኑኤል፡ ግበር፡ ኵሎ፡ ዕለተ፨</t:l>
                  <t:l n="3">ተራድኦ፡ ወአድኅኖተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከ፡ ፋኑኤል፡ ጴጥሮስ፡ ካህነ፡ ውሳጤ፡ ወአፍአ፨</t:l>
                  <t:l n="2">እመ፡ በበ፡ ዕለት፡ አበስኩ፡ በበ፡ ስብዕ፡ ስብዓ፨</t:l>
                  <t:l n="3">ፍት፡ሐኒ፡ ከመ፡ ተሠርዐ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ ሰይፈከ፡ ምላህ፡ ዲበ፡ ጽርየ፡ ማስቴማ፨</t:l>
                  <t:l n="2">በዲበ፡ ትእዛዝ፡ ዘይፈጥር፡ ጻማ፨</t:l>
                  <t:l n="3">ፋኑኤል፡ መልአከ፡ ራማ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለከ፡ ዕቀበኒ፡ ዘልፈ፡ እግዚኦ፡ ወኢትኅድገኒ፡ እምዮም፨</t:l>
                  <t:l n="2">ፋኑኤል፡ ትጉህ፡ መልአከ፡ ሰላም፨</t:l>
                  <t:l n="3">እስመ፡ በጽኑዕ፡ ኀይልከ፡ ይድኅን፡ ድኩም፨</t:l>
                  <t:l n="4">ወበፈውስከ፡ ይጥዒ፡ ሕሙም፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
