         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2894RepCh175">
            <t:note>The following text reproduced after <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ በመጽሐፈ፡ ሕይወት፡ ልኩእ፨</t:l>
                  <t:l n="2">ወለሥዕርትኪ፡ ጸሊም፡ ከመ፡ ሕብረ፡ ቋዕ፨</t:l>
                  <t:l n="3">ፈላሲተ፡ ቍስቋም፡ ማርያም፡ ተስፋ፡ ፈላስያን፡ ሰብእ፨</t:l>
                  <t:l n="4">ቤዛ፡ ይኩነኒ፡ ለገብርኪ፡ ተሰዶትኪ፡ በግፍዕ፨</t:l>
                  <t:l n="5">ወእምዐይነ፡ ርግብ፡ ዐይንኪ፡ ዘወፅኣ፡ አንብዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለርእስኪ፡ ወለሥነ፡ ገጽኪ፡ ኮከብ፨</t:l>
                  <t:l n="2">ለዐውደ፡ ቅርነ፡ ብኪ፡ ሥርግው፡ ወለዐይንኪ፡ ዘርግብ፨</t:l>
                  <t:l n="3">ማርያም፡ ደክታም፡ በሞተ፡ እም፡ ወአብ፨</t:l>
                  <t:l n="4">ሚመንክር፡ ኀዘንኪ፡ ወገዐርኪ፡ ዕፁብ፨</t:l>
                  <t:l n="5">እስከ፡ ደብረ፡ ቍስቋም፡ ሰደዱኪ፡ መሪራን፡ ሕዝብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለአእዛንኪ፡ ሰማዕያተ፡ ሕጉ፡ ለአምላክ፨</t:l>
                  <t:l n="2">ለሥነ፡ መላትሕኪ፡ ጽጌ፡ ወለጼና፡ አንፍኪ፡ ምስክ፨</t:l>
                  <t:l n="3">ማርያም፡ ቡርክት፡ ወላዲተ፡ ሕፃን፡ ቡሩክ፨</t:l>
                  <t:l n="4">ባላሔ፡ ይኩነኒ፡ እመንሱት፡ ወእምነ፡ ኵሉ፡ ሀከክ፨</t:l>
                  <t:l n="5">ውስተ፡ ፍኖተ፡ ቍስቋም፡ ምስሌኪ፡ ዘሖረ፡ መልአክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለከናፍርኪ፡ ወለአፉኪ፡ ነቅዐ፡ ከርቤ፨</t:l>
                  <t:l n="2">ለአስናንኪ፡ አዕናቍ፡ ምስለ፡ ልሳንኪ፡ ቀርነ፡ ይባቤ፨</t:l>
                  <t:l n="3">ውስተ፡ ደብረ፡ ቍስቋም፡ ማርያም፡ እንዘ፡ ዕርቅተ፡ ገጽ፡ እምግልባቤ፨</t:l>
                  <t:l n="4">ሚመጠነ፡ ተሰደድኪ፡ ወተመንደብኪ፡ ምንዳቤ፨</t:l>
                  <t:l n="5">ባሕቱ፡ መንፈስ፡ ቅዱስ፡ ኮነኪ፡ ዐቃቤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለቃልኪ፡ ወለእስትንፋስኪ፡ ምስለ፡ ጕርዔ፨</t:l>
                  <t:l n="2">ለክሳድኪ፡ አሐቲ፡ ወለመከፍትኪ፡ ክልኤ፨</t:l>
                  <t:l n="3">ውስተ፡ ደብረ፡ ቍስቋም፡ ማርያም፡ ጊዜ፡ ባርኮትኪ፡ ላዕለ፡ ጉባኤ፨</t:l>
                  <t:l n="4">ባርክኒ፡ በንባብኪ፡ ወጸውዕኒ፡ ጽዋዔ፨</t:l>
                  <t:l n="5">እስመ፡ ልደ፡ ቤትኪ፡ አነ፡ ወዘለኪ፡ ቍልዔ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለዘባንኪ፡ ወለእንግድዓኪ፡ ምስለ፡ ሕፅኑ፨</t:l>
                  <t:l n="2">ለአእዳውኪ፡ ቅዱሳት፡ ወለመዛርዕኪ፡ ዘበበ፡ በይኑ፨</t:l>
                  <t:l n="3">ማርያም፡ በሊዮ፡ ለብርሃነ፡ ቍስቋም፡ ምሥራቀ፡ ስኑ፨</t:l>
                  <t:l n="4">አንብዐ፡ ገብርከ፡ ዘኢይትዌሰን፡ ኀዘኑ፨</t:l>
                  <t:l n="5">ፈጣሬ፡ አዕይትን፡ ወልድየ፡ ኢትሬኢ፡ ቦኑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለኵርናዕኪ፡ ወለእመታትኪ፡ ዘኢይትጋወሩ፨</t:l>
                  <t:l n="2">ለእራኃትኪ፡ ክልኤ፡ ወለአጻብዕኪ፡ መጠነ፡ ዓሥሩ፨</t:l>
                  <t:l n="3">ማርያም፡ ፃማዊት፡ ወንድፍት፡ በሐጸ፡ ፍቅሩ፨</t:l>
                  <t:l n="4">ኣስተበፅዕ፡ አንሰ፡ ለበኵርኪ፡ አእባነ፡ ቍስቋም፡ ደብሩ፨</t:l>
                  <t:l n="5">ወመሬተ፡ ዘኬደ፡ በእግሩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እዴኪ፡ ወለገቦኪ፡ ልፁቀ፡ ከርሥ፨</t:l>
                  <t:l n="2">ለልብኪ፡ ንጹሕ፡ ዘኢይቀርቦ፡ ደነስ፨</t:l>
                  <t:l n="3">አመ፡ ጐየይኪ፡ ማርያም፡ ውስተ፡ ደብረ፡ ቍስቋም፡ ሐዳስ፨</t:l>
                  <t:l n="4">ቤዛ፡ ኮንዎ፡ ሕፃናት፡ ለሕፃንኪ፡ ክርስቶስ፨</t:l>
                  <t:l n="5">ወህየንተ፡ ደሙ፡ ደሞሙ፡ ከዐወ፡ ሄሮድስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለኵልያትኪ፡ ወለኅሊናኪ፡ ቀዲሙ፨</t:l>
                  <t:l n="2">ለአማዑትኪ፡ ድኅረ፡ ወለንዋየ፡ ውሥጥኪ፡ በኍልቈ፡ ስሙ፨</t:l>
                  <t:l n="3">ማርያም፡ ሐዳስ፡ ለብሉየ፡ መዋዕል፡ እሙ፨</t:l>
                  <t:l n="4">ናሁ፡ ምስሌኪ፡ ኅሊናየ፡ በፍኖተ፡ ቍስቋም፡ ይፃሙ፨</t:l>
                  <t:l n="5">ከመ፡ ሰሎሜ፡ ወዮሴፍ፡ ፃመዉ፡ ወደክሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ ለኅንብርትኪ፡ ወለድንግልናኪ፡ ስኑጽ፨</t:l>
                  <t:l n="2">ለሐቌኪ፡ ሰላም፡ ቀዳሜ፡ አብራክ፡ አቍያጽ፨</t:l>
                  <t:l n="3">ማርያም፡ ኅድሪ፡ ውስተ፡ ቤትየ፡ ሕኑጽ፨</t:l>
                  <t:l n="4">አኮኑ፡ ኀደርኪ፡ በቍስቋም፡ ወአንሶሰውኪ፡ በግብጽ፨</t:l>
                  <t:l n="5">እንዘ፡ በውስቴታ፡ ጣዖት፡ ዘብሩር፡ ወዕፅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለአእጋርኪ፡ ወለሰኰናኪ፡ ምስለ፡ ቢጹ፨</t:l>
                  <t:l n="2">ለመከየድኪ፡ ሰላም፡ ወለአፃብዕኪ፡ በበ፡ አንቀጹ፨</t:l>
                  <t:l n="3">ሥዕለ፡ መንፈስ፡ ቅዱስ፡ ማርያም፡ ለእግዚአብሔር፡ ማሕተመ፡ ገጹ፨</t:l>
                  <t:l n="4">መርቆሬዎስ፡ ወጊዮርጊስ፡ በመዐዛ፡ ፍቅርኪ፡ ሮጹ፨</t:l>
                  <t:l n="5">ወማኅደረ፡ ስምዕ፡ ሎሙ፡ በቍስቋም፡ ሐነጹ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እግርኪ፡ ወለቆምኪ፡ ቤተ፡ ሥጋ፨</t:l>
                  <t:l n="2">ለዐቅመ፡ መልክእኪ፡ ሰላም፡ ወለፀአተ፡ ነፍስኪ፡ እመንሰጋ፨</t:l>
                  <t:l n="3">ነጋዲተ፡ ቍስቋም፡ ማርያም፡ እንተ፡ ተሰመይኪ፡ ምልእተ፡ ጸጋ፨</t:l>
                  <t:l n="4">ይትካፈሉ፡ በኂሩትኪ፡ ሕዋሳትየ፡ እንግልጋ፨</t:l>
                  <t:l n="5">በረከተኪ፡ ዘምሉእ፡ እምንትጋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለበድነ፡ ሥጋኪ፡ ወለግንዘትኪ፡ ዘአሜሃ፨</t:l>
                  <t:l n="2">ለመቃብርኪ፡ ሕትምት፡ ወለፍልሰትኪ፡ ዘእምኔሃ፨</t:l>
                  <t:l n="3">ምክሐ፡ ደብረ፡ ቍስቋም፡ ማርያም፡ ወለጌቴሴማን፡ ሥነ፡ ተድላሃ፨</t:l>
                  <t:l n="4">አዕርጊ፡ ነፍሰ፡ ዚአየ፡ ኀበ፡ ብዕለ፡ ነፍስኪ፡ ሰፍሐ፨</t:l>
                  <t:l n="5">ወኀበ፡ ሥጋኪ፡ አፍልሲ፡ ሥጋሃ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">በኍልቈ፡ ክልኤቱ፡ ሱባዔያት፡ ዘአቅረብኩ፡ ለኪ፡ ማሕሌተ፨</t:l>
                  <t:l n="2">ወእግረ፡ ኅሊናየ፡ ኦደ፡ እስከ፡ ደብረ፡ ቍስቋም፡ ፍኖተ፨</t:l>
                  <t:l n="3">ኢያሕፅፅኒ፡ ማርያም፡ እምነ፡ ጋድያን፡ ዕሤተ፨</t:l>
                  <t:l n="4">ወኢትበልኒ፡ ድኅረ፡ እሁበከ፡ እንተ፡ ንእስ፡ መክፈልተ፨</t:l>
                  <t:l n="5">እስመ፡ ከማሆሙ፡ በሥጋ፡ ኢጻመውከ፡ አንተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ፈላሲተ፡ ቍስቋም፡ ማርያም፡ ጸወነ፡ መድኃኒት፡ ኩኒ፨</t:l>
                  <t:l n="2">ለገብርኪ፡ እምእኩየ፡ ግዕዝ፡ ዘይትቃረነኒ፨</t:l>
                  <t:l n="3">ፈድፋደሰ፡ እምልሳን፡ ዘይፈቅድ፡ ይሳነነኒ፨</t:l>
                  <t:l n="4">ከድንኒ፡ ወሰውርኒ፤ ዕቀብኒ፡ ወተማሕፀንኒ፨</t:l>
                  <t:l n="5">አድኅንኒ፡ ወባልሕኒ፤ እስመ፡ ኪያኪ፡ እትአመን፡ ወለኪ፡ እገኒ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለኪ፡ ማርያም፡ ንጽሕት፡ በአፈ፡ ኵሉ፡ ውድስት፨</t:l>
                  <t:l n="2">ታቦት፡ አንቲ፡ ዘሙሴ፡ ጽላት፨</t:l>
                  <t:l n="3">ዘሕግ፡ ወዘሥርዓት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለኪ፡ ገይበ፡ ብሩር፡ ጽሪት፡ ወመቅድሐ፡ ጽሩይ፡ ሐሊብ፨</t:l>
                  <t:l n="2">ማርያም፡ መሶብ፡ ዘመና፡ ልጉብ፨</t:l>
                  <t:l n="3">እንተ፡ ጾርኪ፡ ሲሳየ፡ ሕዝብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለኪ፡ ትርሲተ፡ ቤቱ፡ ሠናይት፡ ዘነቢይ፡ ሐጌ፨</t:l>
                  <t:l n="2">ወወለት፡ አንቲ፡ ዘሰሎሞን፡ ሐርጌ፨</t:l>
                  <t:l n="3">ማርያም፡ ዘመነ፡ ጽጌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለኪ፡ እመ፡ ቅድው፡ በግዕ፡ ዘቀተልዎ፡ በግፍዕ፨</t:l>
                  <t:l n="2">ለደብተራ፡ ስምዕ፨</t:l>
                  <t:l n="3">ዘጳውሎስ፡ ረድእ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለኪ፡ ኦርያሬስ፡ ሰማይ፡ ልብስኪ፡ ወአሣእንኪ፡ እብላ፨</t:l>
                  <t:l n="2">ጽጌ፡ ደንጐላት፡ ቀይሕ፡ ዘምድረ፡ ቈላ፨</t:l>
                  <t:l n="3">ማርያም፡ ዘመነ፡ ተድላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለኪ፡ በመድበለ፡ ማኅበር፡ ጽፉቅ፨</t:l>
                  <t:l n="2">እዌድሰኪ፡ በጻሕቅ፨</t:l>
                  <t:l n="3">ከመ፡ ትምዓድኒ፡ ነገራተ፡ ጽድቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለኪ፡ ተደንግሎ፡ ሥጋ፡ ወነፍስ፡ ለባሕቲትኪ፡ ኮነ፨</t:l>
                  <t:l n="2">አመኒ፡ ወለድኪ፡ ሕፃነ፨</t:l>
                  <t:l n="3">ኢረስሐ፡ ወኢማሰነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለኪ፡ እሙ፡ በሊዮ፡ በእንቲአየ፡ ለፍሬ፡ ከርሥኪ፡ እብኖዲ፨</t:l>
                  <t:l n="2">ላዕሌሁ፡ ምሕረተከ፡ ኢታጐንዲ፨</t:l>
                  <t:l n="3">እመ፡ አኅዘነከ፡ ብእሲ፡ አባዲ፨</t:l>
                  <t:l n="4">ቤዛ፡ ነፍሱ፡ በጺሕየ፡ ፍዲ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         
         
      </t:body>
   </t:text></TEI>