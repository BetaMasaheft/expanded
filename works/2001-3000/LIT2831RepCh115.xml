         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2831RepCh115">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ መልዕልተ፡ ኵሉ፡ ዘኮነ፨</t:l>
                  <t:l n="2">ወበግርማሁ፡ ግሩም፡ እንተ አጥፍን፡ ኢጣሊያነ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢትዮጵያ፡ መድኅነ፨</t:l>
                  <t:l n="4">ቀተልኮ፡ ለአላዊ፡ በምድረ፡ ትግሬ፡ መካነ፨</t:l>
                  <t:l n="5">ምስለ፡ ባሺ፡ ብዙቂሁ፡ ዘርዘርኮ፡ ወረሰይኮ፡ በድነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለስእርተ፡ ርእስከ፡ አምሳለ፡ ኀሪር፡ ፍቱል፨</t:l>
                  <t:l n="2">ወስእነ፡ አርአያሁ፡ ጸሊም፡ አርአያ፡ ኵህል፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ፈጻሜ፡ ቃላተ፡ ወንጌል፨</t:l>
                  <t:l n="4">እስመ፡ ተማኅጸንኩ፡ አነ፡ በዘዚአከ፡ ሳህል፨</t:l>
                  <t:l n="5">ታከብርሂ፡ ወፍጡነ፡ ታብዕል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ዘበላዕሌሁ፡ ዘውደ፨</t:l>
                  <t:l n="2">ዘይመስል፡ ቀስተ፡ ደመና፡ ወእንቈ፡ ጳዝዮን፡ ክቡደ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘተክለ፡ ገነት፡ ዓጸደ፨</t:l>
                  <t:l n="4">መንግሥትከሰ፡ እምነ፡ ሰሎሞን፡ ፈድፈደ፨</t:l>
                  <t:l n="5">ከፋ፡ ወባሕር፡ ረሰይከ፡ አሐደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለገጽከ፡ ከመ፡ ገጸ፡ አንበሳ፡ ዘገዳም፨</t:l>
                  <t:l n="2">ወጽዱል፡ ንጻሬሁ፡ ከመ፡ እንቈ፡ ሰም፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘመንበርከ፡ ግሩም፨</t:l>
                  <t:l n="4">ቀተልከ፡ አላዌ፡ ዘመጽአ፡ እምብሔረ፡ ሮም፨</t:l>
                  <t:l n="5">ወነፍሱሂ፡ ተወድየ፡ ውስተ፡ ገሃነም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለቀራንብቲከ፡ ከመ፡ ሜላት፡ ርሱይ፨</t:l>
                  <t:l n="2">ጥቀ፡ አዳም፡ ወጥቀ፡ ሠናይ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢትዮጵያ፡ ፀሐይ፨</t:l>
                  <t:l n="4">አጥፋዕኮ፡ ለባሺ፡ ብዙቅ፡ በምክረ፡ ዚአከ፡ ጊጉይ፨</t:l>
                  <t:l n="5">ሥጋሁ፡ ለመጥባሕት፡ ወነፍሱ፡ ለእሳተ፡ ሰማይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለአዕይንቲከ፡ ከመ፡ ዐይነ፡ ጳውሎስ፡ ሐዋርያ፨</t:l>
                  <t:l n="2">አምሳለ፡ ብረሌ፡ ጽዱል፡ ወመንክር፡ ለአርአያ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ለኢትዮጵያ፡ ፀሐያ፨</t:l>
                  <t:l n="4">ሶበ ተፈጸመ፡ ወሞተ፡ አይሁዳዊ፡ ኢጣልያ፨</t:l>
                  <t:l n="5">ወይሌ፡ ወላህ፡ ኮነ፡ በሮምያ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአዕዛኒከ፡ ስዕለተ፡ ነዳይ፡ ዘያጽምዓ፨</t:l>
                  <t:l n="2">ሶበ፡ ይሰዕል፡ ኀቤከ፡ ወይጸርሕ፡ በውውዓ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢትዮጽያ፡ እግዚኣ፨</t:l>
                  <t:l n="4">ዘይገርምሰ፡ ዘማዕድከ፡ መብልዓ፨</t:l>
                  <t:l n="5">ዘይትሃረጽ፡ የፈ፡ ወለፈ፡ ገንዓ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለመላትኒከ፡ ከመ፡ ጽጌ፡ ሮማን፡ ቀይህ፨</t:l>
                  <t:l n="2">ዘይዔድም፡ ጥቀ፡ እምነ፡ ፀሐይ፡ ወወርኅ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ኮከበ፡ ጽባሕ፡ ብሩኅ፨</t:l>
                  <t:l n="4">ሶበ፡ ተንሣእከ፡ አንተ፡ ምስለ፡ ሠራዊትከ፡ ብዙኅ፨</t:l>
                  <t:l n="5">ጀነራል፡ ጠፍን፡ ወደምሰሰ፡ አይኅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለአዕናፊከ፡ ከመ፡ ፄና፡ ገነት፡ ምዑዝ፨</t:l>
                  <t:l n="2">ሱራሬሆን፡ ሠናይ፡ ወጥቀ፡ ሐዋዝ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢትዮጵያ፡ አርዝ፡</t:l>
                  <t:l n="4">ሶበ፡ ተለቅሃ፡ ኢጣሊያ፡ ወርቀ፡ አይሁደዊ፡ እንግሊዝ፨</t:l>
                  <t:l n="5">ዘይከፍል፡ ስዕነ፡ አሐዞ፡ ትካዝ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ ለከናፍሪከ፡ እለ፡ ሰብሑ፡ ለእግዚአብሔር፨</t:l>
                  <t:l n="2">ሤመከ፡ ትኩን፡ እግዚአ፡ ኵሉ፡ ፍጡር፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ መሐሪ፡ ወኄር፨</t:l>
                  <t:l n="4">ሶበ፡ ተባረቀ፡ ፉዚግራ፡ ወተዘርአ፡ ዓረር፡</t:l>
                  <t:l n="5">ኢጣሊያ፡ ደንገፀ፡ ወውሕጠቶ፡ ምድር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለአፉከ፡ ለፈጣሪ፡ ዘየአኵቶ፨</t:l>
                  <t:l n="2">ኢይትናገር፡ ስላቀ፡ ወኢይነብብ፡ ከንቶ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ለኢትዮጵያ፡ ማኅቶቶ፨</t:l>
                  <t:l n="4">ሐልቀ፡ ማንጆር፡ ወስዕነ፡ ፍኖቶ፨</t:l>
                  <t:l n="5">ጀነራል፡ ባራቴሪ፡ ሶበ፡ ገብዓ፡ ደንገፀ፡ ዖምበርቶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለአስናኒከ፡ እለ፡ ይጸአድዋ፡ እምበረድ፨</t:l>
                  <t:l n="2">ሠናይ፡ ፍጥረቶን፡ ወጥቀ፡ ብዑድ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ሥዩመ፡ ክርስቶስ፡ ወልድ፨</t:l>
                  <t:l n="4">ሶበ፡ ተባረቀ፡ ፉዚግራ፡ ከመ፡ ነጐድጓድ፨</t:l>
                  <t:l n="5">ኢጣሊያ፡ ፈርሃ፡ ወአሐዞ፡ ረዓድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለልሳንከ፡ እንተ፡ ምዕዝት፡ ይእቲ፨</t:l>
                  <t:l n="2">ሠናይ፡ ትትናገር፡ ወእኩይ፡ አልባቲ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ሃይማኖትከ፡ አሐቲ፨</t:l>
                  <t:l n="4">አጥፋዕኮ፡ ለኢጣሊያ፡ እህው፡ ሰይጣን፡ መስሐቲ፨</t:l>
                  <t:l n="5">ጐየ፡ ግብጣን፡ ወሞተ፡ ትልንቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰላም፡ ለቃልከ፡ እንተ፡ ኢይነብብ፡ ጽርፈተ፨</t:l>
                  <t:l n="2">እንበለ፡ ዳዕሙ፡ ዘአምላክ፡ ስብሐተ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ወልደ፡ ሰሎሞን፡ አንተ፨</t:l>
                  <t:l n="4">ሶበ፡ ሖርከ፡ ትግሬ፡ ሰሰለ፡ ጽልመተ፨</t:l>
                  <t:l n="5">ተኃጕለ፡ ሰይጣን፡ ወጀነራል፡ ሞተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለእስትንፋስከ፡ እስትንፋሰ፡ መልአክ፡ አምሳሉ፨</t:l>
                  <t:l n="2">ዘአድኅኖ፡ ለድውይ፡ ዘሐመ፡ አባሉ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ እግዚአ፡ ኵሉ፨</t:l>
                  <t:l n="4">ተበቀልኮሙ፡ ለአይሁድ፡ ሶበ፡ እግዚኦሙ፡ ሰቀሉ፨</t:l>
                  <t:l n="5">ተፈጸመ፡ ኢተርፈ፡ ፩ደ፡ እምእሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለጉርዔከ፡ መዓርዔር፡ ጣዕሙ፨</t:l>
                  <t:l n="2">ዘኢይፈርሁ፡ ሞተ፡ ሠራዊትከ፡ ኵሎሙ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ለአዕላፈ፡ አእላፋት፡ ሊቆሙ፨</t:l>
                  <t:l n="4">አሐደ፡ ዕስላም፡ ማንጆር፡ ገልያኖ፡ ዘስሙ፨</t:l>
                  <t:l n="5">ሠናየ፡ ፉዚግራ፡ ኮነ፡ ወተክእው፡ ደሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለክሣድከ፡ ከመ፡ አርማስቆስ፡ ስኑ፨</t:l>
                  <t:l n="2">ቃማ፡ ወርቅ፡ ጽሩይ፡ ዘኮነ፡ ክዳኑ፨</t:l>
                  <t:l n="3">ወልደ፡ሰሎሞን ምኒልክ ሰዳዴ፡ሰይጣናት በሥልጣኑ።</t:l>
                  <t:l n="4">ሶበ፡ አተብከ፡ ሠይፈከ፡ አውአዮሙ፡ ርስኑ፨</t:l>
                  <t:l n="5">ተዘርዉ፡ ከመ፡ ጢስ፡ ወአብድንተ፡ ኮኑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለመትከፍትከ፡ ዓርዑተ፡ ወንጌል፡ ዘፆረ፡</t:l>
                  <t:l n="2">ኢያዕመረ፡ ከልዓ፡ እምአመ፡ ተፈጥረ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዕንቈ፡ ኢያሴጲድ፡ ክቡረ፨</t:l>
                  <t:l n="4">ለጸብዕ፡ ሶበ፡ ኃለየ፡ ፈረሰ፡ እሳት፡ ሠረረ፨</t:l>
                  <t:l n="5">አውአዮሙ፡ ነዱ፡ ወኮነ፡ ሐሠረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ሰላም፡ ለዘባንከ፡ ሜላተ፡ ወርቅ፡ ልብሱ፨</t:l>
                  <t:l n="2">ጥቀ፡ ሠናይ፡ ወአዳም፡ ሞገሱ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘነደ፡ እሳት፡ ፈረሱ፨</t:l>
                  <t:l n="4">ዘመጽኡ፡ እምሮሜ፡ ሶበ፡ ኪያሁ፡ ኃሡሡ፨</t:l>
                  <t:l n="5">አክልብተ፡ አድዋ፡ በልዕዎሙ፡ ወደሞሙ፡ ለሐሱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="20">
                  <t:l n="1">ሰላም፡ ለእንግድኣከ፡ ዘይትሞጣሕ፡ ልብሰ፡ መንግሥት፨</t:l>
                  <t:l n="2">ዘወሀበከ፡ ለሊሁ፡ እግዚአብሔር፡ ጸባዖት፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ወልደ፡ ወልዱ፡ ለዳዊት፡</t:l>
                  <t:l n="4">ዘመጽኡ፡ ኀቤከ፡ ዓረማውያን፡ ጸላዕት፨</t:l>
                  <t:l n="5">አውአዮሙ፡ ፉዚግራ፡ ወበልዖሙ፡ እሳት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="21">
                  <t:l n="1">ሰላም፡ ለሕጽንከ፡ ከመ፡ ስሂን፡ ወርሄ፨</t:l>
                  <t:l n="2">ዘይትዓኰት፡ እምኵሉ፡ ወይሴባሕ፡ ስባሔ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ንጉሠ፡ ርኅራኄ፨</t:l>
                  <t:l n="4">ዘመጽኡ፡ ጸላዕትከ፡ ተሰጥሙ፡ ኵለሄ፨</t:l>
                  <t:l n="5">እስመ፡ ፈጻሜ፡ ፈቃዱ፡ አንተ፡ ለአምላክ፡ ዔሎሄ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="22">
                  <t:l n="1">ሰላም፡ ለአዕደዊከ፡ እንተ፡ አኃዛ፡ ሰይፈ፨</t:l>
                  <t:l n="2">ከመ ይምትራ፡ለባሺ፡ብዙቅ አምነፉዚግራ፡ዘተርፈ።</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ እንተ፡ ትኵንን፡ አዕላፈ፨</t:l>
                  <t:l n="4">አፍቀረከ፡ አምላክ፡ ወጸሎተከ፡ ተወክፈ፨</t:l>
                  <t:l n="5">ተፈጸሙ፡ ጸላዕትከ፡ አሐዱ፡ ኢተርፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለመዘርዒከ፡ ከመ፡ መዘርዓ፡ አንበሳ፡ ወድብ፨</t:l>
                  <t:l n="2">በፈትለ፡ ወርቅ፡ ርሱይ፡ ወበልብሰ፡ ሜላት፡ ግልቡብ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ኰናኔ፡ ሕዝብ፡ ወአሕዛብ፨</t:l>
                  <t:l n="4">በዘመንከ፡ ትፍሥሕት፡ ወጥቀ፡ ጽጋብ፨</t:l>
                  <t:l n="5">ውኂዘ፡ መዓር፡ ወመልዓ፡ ሐሊብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለኵርናዕከ፡ ኃይለ፡ ኢጣልያ፡ ዘአድከመ፨</t:l>
                  <t:l n="2">ሶበ፡ ሰበሮ፡ ለሐመሩ፡ በከመ፡ ፈርዖን፡ ተሰጥመ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ አንተ፡ ትኵንን፡ ዓለመ፨</t:l>
                  <t:l n="4">አጥፋዕኮ፡ ለዓላዊ፡ ዘአርአያ፡ ገጹ፡ ኅሡመ፨</t:l>
                  <t:l n="5">እስከ፡ አውአዮ፡ ፉዚግራ፡ ወአንደደ፡ ፍህመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለእመትከ፡ አምሳለ፡ መባርቅት፡ ኅብሩ፨</t:l>
                  <t:l n="2">ጥቀ፡ ሠናይ፡ ወአዳም፡ ምሥጢሩ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ለእግዚአብሔር፡ ፍቁሩ፨</t:l>
                  <t:l n="4">ርኁባነ፡ ከዊኖሙ፡ ሶበ፡ ርእዮሙ፡ ለፀሩ፨</t:l>
                  <t:l n="5">አረረ፡ መጠዎሙ፡ ፉዚግራ፡ ተጻሩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለእራኅከ፡ ኃይለ፡ ኃጥዓን፡ መቅሰሌ፨</t:l>
                  <t:l n="2">ለፀሩ፡ ይትቤቀል፡ ወለፍቁራኒሁ፡ ከሃሌ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ፅዱል፡ ከመ፡ ብረሌ፨</t:l>
                  <t:l n="4">አይቴ፡ እግብእ፡ አነ፡ ሰዓተ፡ ብካይ፡ ወወይሌ፨</t:l>
                  <t:l n="5">እንዘ፡ ይብል፡ አስቆቀወ፡ ማንጆር፡ ወመቀሌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለአፃብኢከ፡ ህልቀተ፡ ወርቅ፡ ዘላዕሌሁ፨</t:l>
                  <t:l n="2">ዘግሩም፡ ለራእዩ፡ ወመንክር፡ ለንጻሬሁ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ወልደ፡ ሰሎሞን፡ ለሊሁ፨</t:l>
                  <t:l n="4">ሶበ፡ ርእዮሙ፡ ሰይፈ፡ እሳት፡ እኂዞ፡ ውስተ፡ እዴሁ፨</t:l>
                  <t:l n="5">ሰብአ፡ ሮሜ፡ ጥቀ፡ ደንገፁ፡ ወፈርሁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እዴከ፡ ዘጥቀ፡ ሠናያን፨</t:l>
                  <t:l n="2">ዘይዔድማ፡ ለእዝን፡ ወይጌርማ፡ ለዓይን፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ከመ፡ ዕንቍራ፡ ማይ፡ ዘልብን።</t:l>
                  <t:l n="4">ሶበ፡ ሖርከ፡ ትግሬ፡ እኂዘከ፡ መስቀለ፡ ብርሃን፨</t:l>
                  <t:l n="5">ጐየ፡ ሰይጣን፡ ምስለ፡ ባሺ፡ ብዙቂሁ፡ ጸዋጋን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለገቦከ፡ ዲበ፡ ዓራተ፡ ወርቅ፡ ዘሰከበ፨</t:l>
                  <t:l n="2">ነቢሮ፡ ላዕሌሁ፡ ከመ፡ ይኴንን፡ አሕዛበ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ለእጓለ፡ ማውታ፡ አበ፨</t:l>
                  <t:l n="4">ፍቁር፡ በኀበ፡ ማርያም፡ ወፍቁረ፡ ጊዮርጊስ፡ ካዕበ፨</t:l>
                  <t:l n="5">ረሰየ፡ ትኩን፡ ዘመና፡ መሶበ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለከርስከ ኃዳጌ፡ በቀል፡ ውእቱ፨</t:l>
                  <t:l n="2">ዘእንበለ፡ ምሕረት፡ ለአባስያን፡ ወካዕበ አልቦቱ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ፍቁረ ኪሩባውያን፡ ፬ቱ፨</t:l>
                  <t:l n="4">እምባሕረ፡ ወዳሴከ፡ አይኅ፡ ዘቶሳህኩ፡ ዝንቱ፨</t:l>
                  <t:l n="5">ጸሐፌ፡ ትእዛዝ፡ ያንብቦ፡ ኢይኩን፡ ለክንቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለልብከ፡ ዘኢየአምር፡ ተቀይሞ፨</t:l>
                  <t:l n="2">እንበለ፡ ዳዕሙ፡ አርመሞ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ርኄ፡ አፈው፡ ዘቀናንሞ፨</t:l>
                  <t:l n="4">ፈጸሞ፡ ለኢጣልያ፡ ወከዓዉ፡ ደሞ፨</t:l>
                  <t:l n="5">ወለባሺ፡ ብዙቅኒ፡ በአፈ፡ መጥባሕት፡ ገዘሞ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለኵልያቲከ፡ ኵልያተ፡ መንፈስ፡ ቅብዓ፨</t:l>
                  <t:l n="2">በፍቅረ፡ ክርስቶስ፡ ወይን፡ ዘኮነ፡ ጥብአ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ንጉሠ፡ ውሳጤ፡ ወአፈአ፨</t:l>
                  <t:l n="4">አሐዱ፡ ቃል፡ እምአፉከ፡ ሶበ፡ ወጽአ፨</t:l>
                  <t:l n="5">አይሁዳዊ፡ ተፈጸመ፡ ወጠፍአ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለሕሊናከ፡ ሕሊና፡ ሠናይ፡ ማኅየዊ፨</t:l>
                  <t:l n="2">አረማውያነ፡ ይጽልእ፡ ወለክርስቲያን፡ ጸጋዊ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ፍቁረ፡ ኢየሱስ፡ ናዝራዊ፨</t:l>
                  <t:l n="4">አጥፋእኮ፡ ለሰይጣን፡ ወቀጥቀጥከ፡ አርዊ፨</t:l>
                  <t:l n="5">እስመ፡ ያፈቅረከ፡ ጥቀ፡ አምላክከ፡ ሰማያዊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">ሰላም፡ ለሕንብርትከ፡ ከመ፡ ዓይነ፡ ማኅተም፡ አምሳሉ፨</t:l>
                  <t:l n="2">ዘፈጠሮ፡ በጥበቢሁ፡ ጸባዖት፡ እግዚአ፡ ኵሉ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ለኢትዮጵያ፡ ፀዳሉ፨</t:l>
                  <t:l n="4">ሶበ፡ ተባረቀ፡ ፉዚግራ፡ ከመ፡ ነጐድጓድ፡ ቃሉ፨</t:l>
                  <t:l n="5">ተሰብረ፡ ወጨፎ፡ ወተክዕወ፡ አባሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">ሰላም፡ ለሐቌከ፡ ቅናተ፡ ወርቅ፡ ዘአጠቀ፨</t:l>
                  <t:l n="2">ዘይኤድም፡ ለንጻሬሁ፡ እንዘ፡ ሀሎ፡ ርኁቀ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ወእግዚአ፡ፉዚግራ፡መብረቀ፨</t:l>
                  <t:l n="4">ኀልቀ፡ እደዊሁ፡ ምስለ፡ ባሺ፡ ብዙቂሁ፡ ጥዩቀ፨</t:l>
                  <t:l n="5">ወጀነራልኒ፡ እንዘ፡ ይጐይይ፡ ወድቀ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="36">
                  <t:l n="1">ሰላም፡ ለአቈያጺካ፡ ከመ፡ አምደ፡ ወርቅ፡ ፍሉጠ፨</t:l>
                  <t:l n="2">ኣይዴምን፡ ስኑ፡ ወኢየአምር፡ ተውላጠ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢየሩሳሌም፡ ሠግላጠ፨</t:l>
                  <t:l n="4">ዘፉዚግራ፡ ቅብዕ፡ ዲበ፡ ርእሰ፡ ኢጣልያ፡ ሶበ፡ ተሠጠ፨</t:l>
                  <t:l n="5">ተሰብረ፡ ናሁ፡ ወጥቀ፡ ተቀጥቀጠ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ሰላም፡ እብል፡ ወዘዚአከ፡ አብራክ፨</t:l>
                  <t:l n="2">በትሕትና፡ ሕሊና፡ ዘልፈ፡ እንተ፡ ትሰግዶ፡ ለአምላክ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ መሐሪ፡ ወቡሩክ፨</t:l>
                  <t:l n="4">ተፈጸመ፡ አረማዊ፡ በሰንበተ፡ ጽባህ፡ ወሰርክ፨</t:l>
                  <t:l n="5">ሶበ፡ ረድአከ፡ ለሊሁ፡ ልዳዊ፡ መልኣክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="38">
                  <t:l n="1">ሰላም፡ ለአእጋረከ፡ ብሔረ፡ ትግሬ፡ ዘሖራ፨</t:l>
                  <t:l n="2">ከመ ይፈጽማ ለኢጣልያ፡ ወአእጋራ፡ ባሺ ብዙቅ ይመትራ።</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ወሊቀ፡ አዕላፍ፡ ሐራ፨</t:l>
                  <t:l n="4">ዘደረስኩ፡ አነ፡ ለመልአክከ፡ ክብራ፨</t:l>
                  <t:l n="5">ያንብባ፡ በቅድሜከ፡ ጸሓፌ፡ ትእዛዝ፡ ዕብራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="39">
                  <t:l n="1">ሰላም፡ ለሰኳንዊከ፡ እንተ፡ ይመስላ፡ አእማደ፡ ወርቅ፨</t:l>
                  <t:l n="2">ዘህበሪሆን፡ ሠናይ፡ ወጥቀ፡ ጥንቁቅ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ እግዚአ፡ ፉዚግራ፡ መብረቅ፨</t:l>
                  <t:l n="4">ሶበ፡ ሰአልከ፡ በይዋሄ፡ ለጊዮርጊስ፡ ጻድቅ፨</t:l>
                  <t:l n="5">ፈጸሞሙ፡ ለጸላዕትከ፡ ዘመጽኡ፡ እምርሁቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="40">
                  <t:l n="1">ሰላም፡ ለመኪየድከ፡ አሣእነ፡ ወርቅ፡ ተረሰየ፨</t:l>
                  <t:l n="2">ዘያሐውር፡ በርትዕ፡ ወኢየአምር፡ ጌጋየ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ዘኢትዮጽያ፡ ፀሐየ፨</t:l>
                  <t:l n="4">ተሐውከት፡ እምሮምያ፡ እንዘ፡ ሀሎከ፡ ዝየ፨</t:l>
                  <t:l n="5">ሶበ፡ ሰምአት፡ በእዝና፡ ዘዚአከ፡ ዕበየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="41">
                  <t:l n="1">ሰላም፡ ለአጻብኢከ፡ በፍቅረ፡ ክርስቶስ፡ ቅብእ፨</t:l>
                  <t:l n="2">ዘይመስል፡ ሮማነ፡ ወዕንቈ፡ ጳዝዮን፡ ስኩዕ፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ፈጻሜ፡ ኢጣልያ፡ በሰንእ፨</t:l>
                  <t:l n="4">ዘመጽኡ፡ በሐመር፡ አረማውያን፡ ሰብእ፨</t:l>
                  <t:l n="5">ማየ፡ ኢትዮጵያ፡ ውኅጦሙ፡ በኃይልከ፡ ጽኑዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="42">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እግርከ፡ መጽሔተ ብርሃን ዘይመስላ።</t:l>
                  <t:l n="2">ለመንግሥትከ፡ ሰላም፡ ዘኢይደመን፡ ጸዳላ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ ኰናኔ፡ ዓላማት፡ ኵላ፨</t:l>
                  <t:l n="4">ፈጸምኮ፡ ለኢጣልያ፡ ለብሔረ፡ ትግሬ፡ በማእከላ፨</t:l>
                  <t:l n="5">ተፈሥሐት፡ ኢትዮጵያ፡ ወገብረት፡ ተድላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="43">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ እምስነ፡ በቀልት፡ ዘይሰኒ፨</t:l>
                  <t:l n="2">ሠናይ፡ ውእቱ፡ ወአልቦቱ፡ ምንትኒ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ አጽናፈ፡ ዓለም፡ ኰናኒ፨</t:l>
                  <t:l n="4">ከመ፡ አድኅንከ፡ ለኢትዮጵያ፡ እምደመ፡ ሰይጣን ተቃራኒ፨</t:l>
                  <t:l n="5">ፉዚግራከ፡ ጽኑዕ፡ ወልታ፡ ይኵነኒ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="44">
                  <t:l n="1">ሰላም፡ ለመልክእከ፡ ዘስነ፡ ራእዩ፡ ፍትው፨</t:l>
                  <t:l n="2">መአድም፡ ስኑ፡ ወጥቀ፡ ቅድው፨</t:l>
                  <t:l n="3">ወልደ፡ ሰሎሞን፡ ምኒልክ፡ ፍቁረ፡ ክርስቶስ፡ ሕያው ፡</t:l>
                  <t:l n="4">ቦአ፡ ኢጣልያ፡ ውስተ፡ ሀገረ፡ ኅማም፡ ወበድው፨</t:l>
                  <t:l n="5">ኀበ፡ አልቦቱ፡ እክል፡ ወአልቦቱ፡ ጼው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="45">
                  <t:l n="1">ለዘአቅረብኩ፡ አምኃ፡ ከሢትየ፡ አፈ፨</t:l>
                  <t:l n="2">በክብረ፡ ንግሥከ፡ ይጽሐፍ፡ ከመ፡ ይትነበብ፡ ዘልፈ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ነገሥት፡ ምኒልክ፡ እግዚአ፡ ፉዚግራ፡ አእላፈ፨</t:l>
                  <t:l n="4">በከመ፡ አፍቀርከ፡ እግዚእ፡ ወጸሎትከ፡ ተወክፈ፨</t:l>
                  <t:l n="5">ተወከፍ፡ ጸሎትየ፡ ኢይኪን፡ ግዱፈ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>