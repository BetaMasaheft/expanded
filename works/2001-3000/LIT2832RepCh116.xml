      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/7WA33SUX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Chaine1913Rep"/><title level="a">Répertoire des Salam et Malkeʾe contenus dans les manuscrits éthiopiens des bibliothèques d’Europe</title><title level="j">Revue de l’Orient Chrétien</title><author><t:forename>Marius</t:forename><t:surname>Chaîne</t:surname></author><date>1913</date><biblScope unit="volume">18</biblScope><biblScope unit="issue">2 and 18/4 (Deuxième série, 8/2 and 8/4)</biblScope><biblScope unit="page">183–203 and 337–357</biblScope><note type="url">http://catholicapedia.net/Documents/Revue-de-l.Orient-chretien/18-1913_revue-de-l.orient-ch_paris.pdf</note><t:citedRange unit="item">116</t:citedRange></t:bibl>
               <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><t:forename>Augustine</t:forename><t:surname>Dickinson</t:surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note></t:bibl>
               
            </t:listBibl>
         </t:div>
         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘመፍቀሬ፡ አምላክ፡ ተብህለ፨</t:l>
                  <t:l n="2">ወለሥዕርትከ፡ ዖፍ፡ ዘገዳመ፡ መትከፍ፡ ዔለ፨</t:l>
                  <t:l n="3">ፊላታዎስ፡ ሐረግ፡ እንተ፡ ትጸውር፡ አስካለ፨</t:l>
                  <t:l n="4">ከመ፡ እስብከ፡ ውስተ፡ ዓለም፡ ዝክረ፡ ስምከ፡ ወንጌለ፨</t:l>
                  <t:l n="5">ልብሰ፡ ተራድኦ፡ ከድነኒ፡ ወኩነኒ፡ ኃይለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ዘበኀበ፡ ኵሉ፡ ውዱስ፨</t:l>
                  <t:l n="2">ወለመንክረ፡ ስን፡ ገጽከ፡ ገጸ፡ ማሕየዊ፡ ክርስቶስ፨</t:l>
                  <t:l n="3">ፊላታዎስ፡ ዛኅን፡ ፊላታዎስ፡ መርስ፨</t:l>
                  <t:l n="4">እግዚኦ፡ ኩነኒ፡ ለገብርከ፡ ምዕራፈ፡ ሥጋ፡ ወነፍስ፨</t:l>
                  <t:l n="5">እምነ፡ ማዕበላ፡ ጌጋይ፡ ለዓለም፡ ተርሴስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ በእደ፡ ቅዱሳን፡ አኃው፨</t:l>
                  <t:l n="2">ወለመቃብሪከ፡ ሰላም፡ በቃለ፡ ዝማሬ፡ ፍትው፨</t:l>
                  <t:l n="3">ፊላታዎስ፡ ሰማዕት፡ ማእከለ፡ ሰማዕታት፡ ዕደው፨</t:l>
                  <t:l n="4">አርፍቀኒ፡ ፍዳ፡ ፃመውኩ፡ ለማሕሌትከ፡ ህልው፨</t:l>
                  <t:l n="5">አመ፡ በደብረ፡ ጽዮን፡ ሎሙ፡ ይነግሥ፡ ሕያው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">______ ውሑደ፡ ለሰላምከ፡ ሥሉጥ፨</t:l>
                  <t:l n="2">ፊላታዎስ፡ ምዑዝ፡ ዘሐይቀ፡ ባሕረ፡ ገድል፡ ስግላጥ፨</t:l>
                  <t:l n="3">ቅድመ፡ ገጸ፡ ዚአከ፡ ይኩን፡ ዕጹበ፡ ተውላጥ፡ ወሤጥ፨</t:l>
                  <t:l n="4">አኮኑ፡ ተኣምር፡ እግዚኦ፡ መኰንነ፡ አፍአ፡ ወውሥጥ፨</t:l>
                  <t:l n="5">ከመ፡ ለማርያ፡ ይቤላ፡ የአክል፡ ኅዳጥ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke" corresp="https://betamasaheft.eu/LIT2768RepCh52">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ ብርሃነ፡ ልቡና፡ ሀበኒ፡ ወፈውስ፡ ደዌ፡ ዘነፍስ፨</t:l>
                  <t:l n="2">በከመ፡ ወሀብኮ፡ ብርሃነ፡ ለአውስፍዮስ፨</t:l>
                  <t:l n="3">ወልደ፡ ሣህል፡ ፊላታዎስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ በክብረ፡ አብሎሲስ፡ ዐቢይ፡ ወካልኣኒሁ፡ ዐበይት፨</t:l>
                  <t:l n="2">ኢያኅደገኮ፡ ገድለ፡ ኂጣነ፡ ነገሥት፨</t:l>
                  <t:l n="3">ፊላታዎስ፡ ቢጸ፡ ሰማዕት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከ፡ አልቦ፡ ከማከ፡ ለንጉሥ፡ ዘበአእባን፡ ወገሮ፨</t:l>
                  <t:l n="2">እምእለ፡ ሰማዕታት፡ ተለዉ፡ ለክርስቶስ፡ ፍቅሮ፨</t:l>
                  <t:l n="3">ፊላታዎስ፡ ወልደ፡ አንክሮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ ፀሓይ፡ ወወርኅ፡ ወከዋክብት፡ ኵሎሙ፨</t:l>
                  <t:l n="2">ፊላታዎስ፡ አንተ፡ ኢትእመኖሙ፨</t:l>
                  <t:l n="3">አይድዑከ፡ ተፈጥሮቶሙ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
