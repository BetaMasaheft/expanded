      <t:body>
         
         
         
         
         <t:div type="edition" xml:id="div1LIT2422Tarika">
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="Gen" corresp="https://betamasaheft.eu/LIT3854KingList">
               <t:label>Genealogy and History of the kings of Ethiopia from <t:persName ref="https://betamasaheft.eu/PRS1386Adam">Adam</t:persName> to 
                  <t:persName ref="https://betamasaheft.eu/PRS9142TaklaGi">Takla Giyorgis I</t:persName>/ʾAdbǝʾal, successor of Fǝre Śannāy</t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="Yared">
               <t:label>Vita of <t:persName ref="https://betamasaheft.eu/PRS10245Yared">Yāred</t:persName>
               </t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="Christianization">
               <t:label>On the Christianization in Ethiopia</t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="ExtractYamaranWag">
               <t:label>Extract of <t:ref type="work" corresp="https://betamasaheft.eu/LIT2341serata">Śǝrʿāta mangǝśt (general record)</t:ref>
               </t:label>
               
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="Chronicle">
               <t:label>Chronicle of the kings from <t:persName ref="https://betamasaheft.eu/PRS10303Yekunno">Yǝkunno ʾAmlāk</t:persName> to <t:persName ref="https://betamasaheft.eu/PRS5636IyoasI">ʾIyoʾas</t:persName>
               </t:label>
               
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="GenealogyMonks">
               <t:label>Genealogical list of the main Ethiopian monks starting with <t:persName ref="https://betamasaheft.eu/PRS1962Anthony">Antony</t:persName>
               </t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="GenealogyApostels" corresp="https://betamasaheft.eu/LIT5849GenealogyApostles">
               <t:label>Genealogy of the twelve apostles</t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="HistoryGran">
               <t:label>History of  <t:persName ref="https://betamasaheft.eu/PRS1522Ahmadb">ʾAḥmad</t:persName>
               </t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="Oromo">
               <t:label>Extract of <t:ref type="work" corresp="https://betamasaheft.eu/LIT2341serata">Śǝrʿāta mangǝśt (general record)</t:ref> concerning the <t:persName ref="https://betamasaheft.eu/ETH1973Oromo">Oromo</t:persName>
               </t:label>
            </t:div>
            
            <t:div type="textpart" subtype="chapter" xml:lang="am" xml:id="HistoryDavid">
               <t:label>History of <t:persName ref="https://betamasaheft.eu/PRS3417David">David</t:persName>, king of Ethiopia</t:label>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>