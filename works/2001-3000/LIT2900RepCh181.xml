      <t:div type="edition" xml:lang="gez">

        <t:lg type="stanza" n="1">
          <t:l n="1">
            <t:pb corresp="#A" n="167v"/><t:cb corresp="#A" n="b"/>
            <t:pb corresp="#B" n="125v"/><t:cb corresp="#B" n="c"/>
            ሰላም፡ ለዝክረ፡ ስምኪ፡ <t:choice><t:corr resp="AD">ዘሆህያቲሁ፡</t:corr><t:sic>ዘኆኅያቲሁ፡</t:sic></t:choice> አርባዕ፨
          </t:l>
          <t:l n="2">ከመ፡ ግጻዌሁ፡ ግቡር፡ ለመስቀለ፡ ክርስቶስ፡ እግዚእ፨</t:l>
          <t:l n="3">አርሲማ፡ <t:app type="orthographic"><t:lem wit="#A">ብፅዕት፡</t:lem><t:rdg wit="#B" type="orthographic">ብፅእት፡</t:rdg></t:app> ዕግሥተ፡ መከራ፡ <t:app type="orthographic"><t:lem wit="#A">ወስምዕ፨</t:lem><t:rdg wit="#B">ወስምእ፨</t:rdg></t:app></t:l>
          <t:l n="4">ውግዕኒ፡ እምአጥባትኪ፡ ሐሊበ፡ ፍሥሐ፡ ወፍግዕ፨</t:l>
          <t:l n="5">ነገረ፡ ውዳሴኪ፡ እንብብ፡ በልሳን፡ <t:choice><t:corr resp="AD">ጥእጡእ፨</t:corr><t:sic>ጥዕጡዕ፨</t:sic></t:choice></t:l>
        </t:lg>
        
        <t:lg type="stanza" n="2">
          <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስኪ፡ ወለርእስኪ፡ ክሉል፨</t:l>
          <t:l n="2">ወለገጽኪ፡ ቀይሕ፡ ከመ፡ ጽጌ፡ ሮማን፡ ወኮል፨</t:l>
          <t:l n="3">አርሲማ፡ <t:app type="orthographic"><t:lem wit="#A">መዋኢት፡</t:lem><t:rdg wit="#B">መዋዒት፡</t:rdg></t:app> መኳንንተ፡ ስሕተት፡ ወሐጕል፨</t:l>
          <t:l n="4">ጸግወኒ፡ ዝቀ፡ አእምሮ፡ እምውዳሴኪ፡ <t:app type="orthographic"><t:lem wit="#A">ምዕቃል፨</t:lem><t:rdg wit="#B">ምእቃል፨</t:rdg></t:app></t:l>
          <t:l n="5">ንስቲተ፡ እቅዳሕ፡ <t:choice><t:corr resp="AD">ወእክዐው፡</t:corr><t:sic>ወእክዓው፡</t:sic></t:choice> <t:app><t:lem wit="#B">በዔል፨</t:lem><t:rdg wit="#A">በዒል፨</t:rdg></t:app></t:l>
        </t:lg>
        
        <t:lg type="stanza" n="3">
          <t:l n="1">ሰላም፡ ለቀራንብትኪ፡ ወለአዕይንትኪ፡ <t:choice><t:corr resp="AD">ወርኀ፡</t:corr><t:sic>ወርኃ፡</t:sic></t:choice> <t:app type="orthographic"><t:lem wit="#A">ገሃህ፨</t:lem><t:rdg wit="#B">ገሐህ፨</t:rdg></t:app></t:l>
          <t:l n="2">ወለአእዛ<t:pb corresp="#A" n="168r"/><t:cb corresp="#A" n="a"/>ንኪ፡ ጽልዋት፡ ኀበ፡ ቃለ፡ መልአክ፡ ፍሡሕ፨</t:l>
          <t:l n="3">ገሊላዊት፡ አርሲማ፡ ለባሲተ፡ አ<t:pb corresp="#B" n="126r"/><t:cb corresp="#B" n="a"/>ሚን፡ ስቡሕ፨</t:l>
          <t:l n="4">እፎ፡ <t:choice><t:corr resp="AD">ኢያፍርሀኪ፡</t:corr><t:sic>ኢያፍርሃኪ፡</t:sic></t:choice> <t:app type="orthographic"><t:lem wit="#A">እቶነ፡</t:lem><t:rdg wit="#B">ዕቶነ፡</t:rdg></t:app> ነበልባል፡ መፍርህ፨</t:l>
          <t:l n="5"><t:app type="orthographic"><t:lem wit="#A">ወኢያደንገፀኪ፡</t:lem><t:rdg wit="#B">ወኢያደንገጸኪ፡</t:rdg></t:app> ምንተ፡ ጤገኑ፡ ፍሉሕ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="4">
          <t:l n="1">ሰላም፡ ለመላትሕኪ፡ እለ፡ ተጸፍዓ፡ ወተሰትራ፨</t:l>
          <t:l n="2">ሶበ፡ በአእናፍኪ፡ ቦአ፡ <t:app><t:lem wit="#A">ለመርዓተ፡</t:lem><t:rdg wit="#B">በመርዓተ፡</t:rdg></t:app> ቍስቋም፡ መዓዛ፡ ፍቅራ፨</t:l>
          <t:l n="3">ርእሰ፡ ፀርየ፡ ምትሪ፡ አርሲማ፡ ወስቅሊ፡ ውስተ፡ ደብተራ፨</t:l>
          <t:l n="4">ወለተ፡ <t:app><t:lem wit="#B">ሜራራ፡</t:lem><t:rdg wit="#A">ሚራራ፡</t:rdg></t:app> ለሆሎፎርኒስ፡ ፀራ፨</t:l>
          <t:l n="5">ዲበ፡ ርእሰ፡ ተድባብ፡ ከመ፡ ሰቀለት፡ <t:app type="orthographic"><t:lem wit="#A">ክሳዶ፡</t:lem><t:rdg wit="#B">ክሣዶ፡</t:rdg></t:app> መቲራ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="5">
          <t:l n="1">ሰላም፡ ለከናፍርኪ፡ ወለአፉኪ፡ ወለአስናንኪ፡ <t:app type="orthographic"><t:lem wit="#A">ሥነ፡</t:lem><t:rdg wit="#B">ስነ፡</t:rdg></t:app> እብላ፨</t:l>
          <t:l n="2"><t:app><t:lem wit="#A">ለልሳንኪኒ፡</t:lem><t:rdg wit="#B">ለልሳኒኪኒ፡</t:rdg></t:app> ምስለ፡ እስትንፋሳ፡ ወቃላ፨</t:l>
          <t:l n="3">ተመየጥኒ፡ አርሲማ፡ ለነዳይ፡ <t:choice><t:corr resp="AD">ኀሣሤ፡</t:corr><t:sic>ኃሣሤ፡</t:sic></t:choice> ተድላ፨</t:l>
          <t:l n="4">ከመ፡ ተሀብኒ፡ <t:app type="orthographic"><t:lem wit="#A">ለኅብ<t:cb corresp="#A" n="b"/>ስተ፡</t:lem><t:rdg wit="#B">ለሕብስተ፡</t:rdg></t:app> ጸጋኪ፡ ክፍላ፨</t:l>
          <t:l n="5"><t:app type="orthographic"><t:lem wit="#B">ወኂሩትኪ፡</t:lem><t:rdg wit="#A">ወለሂሩትኪ፡</t:rdg></t:app> ከዋኒት፡ ብዕላ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="6">
          <t:l n="1">ሰላም፡ <t:app><t:lem wit="#A">እብል፡</t:lem><t:rdg wit="#B"/></t:app> <t:app type="orthographic"><t:lem wit="#A">ለጕርዔኪ፡</t:lem><t:rdg wit="#B">ለጉርዔኪ፡</t:rdg></t:app> <t:app type="orthographic"><t:lem wit="#A">ወለክሳድኪ፡</t:lem><t:rdg wit="#B">ወለክሣ<t:cb corresp="#B" n="b"/>ድኪ፡</t:rdg></t:app> <t:app><t:lem wit="#A">እሳለማ፨</t:lem><t:rdg wit="#B">አርሲማ፨</t:rdg></t:app></t:l>
          <t:l n="2">ለመታክፍትኪ፡ ሰላም፡ ወለዘባንኪ፡ <t:app type="orthographic"><t:lem wit="#B">ዑጽፍተ፡</t:lem><t:rdg wit="#A">ዑፅፍተ፡</t:rdg></t:app> ግርማ፨</t:l>
          <t:l n="3">ለድክምት፡ ወለትኪ፡ ለባሲተ፡ አጥናን፡ አርሲማ፨</t:l>
          <t:l n="4">ንጽሒ፡ ፀረ፡ ነፍስየ፡ ውስተ፡ <t:app type="orthographic"><t:lem wit="#A">ጸድፈ፡</t:lem><t:rdg wit="#B">ፀድፈ፡</t:rdg></t:app> ሕማም፡ <t:app type="orthographic"><t:lem wit="#A">ወጻማ፨</t:lem><t:rdg wit="#B">ወፃማ፨</t:rdg></t:app></t:l>
          <t:l n="5">ከመ፡ አስቴር፡ እመንበሩ፡ ነጽሐቶ፡ <t:app type="orthographic"><t:lem wit="#A">ለሓማ፨</t:lem><t:rdg wit="#B">ለሐማ፨</t:rdg></t:app></t:l>
        </t:lg>
        
        <t:lg type="stanza" n="7">
          <t:l n="1">ሰላም፡ ለእንግድዓኪ፡ <t:choice><t:corr resp="AD">ወለሕፅንኪ፡</t:corr><t:sic><t:app type="orthographic"><t:rdg wit="#A">ወለኅፅንኪ፡</t:rdg><t:rdg wit="#B">ወለሕጽንኪ፡</t:rdg></t:app></t:sic></t:choice> ክቡር፨</t:l>
          <t:l n="2"><t:app><t:lem wit="#A">ወለአእዳውኪኒ፡</t:lem><t:rdg wit="#B">ወለአእዳዊኪኒ፡</t:rdg></t:app> ምስለ፡ መዛርዒሁ፡ ጽዑር፨</t:l>
          <t:l n="3"><t:app type="orthographic"><t:lem wit="#A">ዓዲ፡</t:lem><t:rdg wit="#B">አዲ፡</t:rdg></t:app> አርሲማ፡ ለእግዝእትኪ፡ መጾር፨</t:l>
          <t:l n="4">ሰላም፡ ለንግደታ፡ ወዜና፡ <t:choice><t:corr resp="AD">ግፍዐታ፡</t:corr><t:sic>ግፍዓታ፡</t:sic></t:choice> መንክር፨</t:l>
          <t:l n="5">እንዘ፡ ንግሥት፡ ይእቲ፡ በሰማይ፡ ወምድር፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="8">
          <t:l n="1">ሰላም፡ ለኵርናዕኪ፡ ወለእመታትኪ፡ ወለእ<t:pb corresp="#A" n="168v"/><t:cb corresp="#A" n="a"/>ራኅኪ፡ ሰላም፡ እብሎን፨</t:l>
          <t:l n="2">ለአፃብዕኪ፡ <t:choice><t:corr resp="AD">ዐሥሮን፡</t:corr><t:sic>አሥሮን፡</t:sic></t:choice> <t:app><t:lem wit="#A">ወለአጽፋሪሆን፨</t:lem><t:rdg wit="#B">ወአጽፋሪሆን፨</t:rdg></t:app></t:l>
          <t:l n="3">አርሲማ፡ ለድንግል፡ በእንተ፡ ንግደታ፡ ማኅዝን፨</t:l>
          <t:l n="4">ሐድሲ፡ ላዕሌየ፡ መ<t:cb corresp="#B" n="c"/>ዋዕለ፡ ዝንቱ፡ አዝማን፨</t:l>
          <t:l n="5">እስመ፡ በኀቤየ፡ አኀዞ፡ ርስዓን፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="9">
          <t:l n="1">ሰላም፡ ለአጥባትኪ፡ ወለገቦኪ፡ ዘሐመልማለ፡ ወርቅ፡ ትርሲቱ፨</t:l>
          <t:l n="2">ለከርሥኪኒ፡ ዘምስለ፡ ልቡ፡ ወኵልያቱ፨</t:l>
          <t:l n="3">በእንተ፡ ንግደታ፡ ለማርያም፡ ወስደተ፡ ወልዳ፡ ባሕቱ፨</t:l>
          <t:l n="4">ኪያየ፡ ኃጥአ፡ ወምኑነ፡ <t:app><t:lem wit="#B">ከመ፡</t:lem><t:rdg wit="#A"/></t:app> ታጽድቂ፡ በከንቱ፨</t:l>
          <t:l n="5">አርሲማ፡ ለአምላክኪ፡ ሰአሊዮ፡ ሎቱ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="10">
          <t:l n="1">ሰላም፡ <t:choice><t:corr resp="AD">ለኅሊናኪ፡</t:corr><t:sic>ለሕሊናኪ፡</t:sic></t:choice> እንተ፡ <t:choice><t:corr resp="AD">ይኄሊ፡</t:corr><t:sic>ይሔሊ፡</t:sic></t:choice> ሠናየ፨</t:l>
          <t:l n="2">ወአማዑትኪኒ፡ ወለንዋየ፡ <t:app type="orthographic"><t:lem wit="#B">ውስጥኪ፡</t:lem><t:rdg wit="#A">ውሥጥኪ፡</t:rdg></t:app> ዕሩየ፨</t:l>
          <t:l n="3">ንቅሒ፡ እንከ፡ ለንስሐ፡ ከመ፡ ታ<t:cb corresp="#A" n="b"/>ንቅሂ፡ ልብየ፨</t:l>
          <t:l n="4">እፎ፡ ይደፍን፡ አርሲማ፡ ጽልመተ፡ <t:choice><t:corr resp="AD">ኀጢአት፡</t:corr><t:sic>ኃጢአት፡</t:sic></t:choice> ኪያየ፨</t:l>
          <t:l n="5">እንዘ፡ ማኅቶትኪ፡ የሐውር፡ ቅድሜየ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="11">
          <t:l n="1">ሰላም፡ <t:app type="orthographic"><t:lem wit="#B">ለሕንብርትኪ፡</t:lem><t:rdg wit="#A" type="orthographic">ለኅንብርትኪ፡</t:rdg></t:app> ወለድንግልናኪ፡ <t:app type="orthographic"><t:lem wit="#B">ሕቱም፨</t:lem><t:rdg wit="#A">ኅቱም፨</t:rdg></t:app></t:l>
          <t:l n="2"><t:app><t:lem wit="#A">ለሐቌኪኒ፡</t:lem><t:rdg wit="#B">ለሐውቌኪኒ፡</t:rdg></t:app> ወለአቍያጽኪ፡ አዳም፨</t:l>
          <t:l n="3"><t:pb corresp="#B" n="126v"/><t:cb corresp="#B" n="a"/>ሰላም፡ <t:app><t:lem wit="#B">እብለኪ፡</t:lem><t:rdg wit="#A">እብል፡</t:rdg></t:app> አርሲማ፡ ዘበሐዋዝ፡ ስዒም፨</t:l>
          <t:l n="4">ዓዲ፡ ማኅደራ፡ ለቅድስት፡ <t:app><t:lem wit="#A">ማርያም፡</t:lem><t:rdg wit="#B"/></t:app> ሰላም፨</t:l>
          <t:l n="5">ሰላም፡ ሰላም፡ ለኪ፡ <t:app type="orthographic"><t:lem wit="#A">ቍስቋም፨</t:lem><t:rdg wit="#B">ቁስቋም፨</t:rdg></t:app></t:l>
        </t:lg>
        
        <t:lg type="stanza" n="12">
          <t:l n="1">ሰላም፡ ለአብራክኪ፡ በሰጊድ፡ ለልዑል፡ ዘጻመዋ፨</t:l>
          <t:l n="2">ምስለ፡ አእጋር፡ ወሰኰና፡ ዘቅሩቦን፡ ሀለዋ፨</t:l>
          <t:l n="3">አርሲማ፡ ክፍልኒ፡ ምስሌኪ፡ ውስተ፡ ፍናዋ፨</t:l>
          <t:l n="4">ለገነተ፡ ጽባሕ፡ <t:app type="orthographic"><t:lem wit="#B">እትለሀይ፡</t:lem><t:rdg wit="#A">እትለሐይ፡</t:rdg></t:app> <t:app><t:lem wit="#A">ወአንፈርዕፅ፡</t:lem><t:rdg wit="#B">እንፈርዕጽ፡</t:rdg></t:app> <t:app><t:lem wit="#A">በነሶሳዋ፨</t:lem><t:rdg wit="#B">በአንሶሳዋ፨</t:rdg></t:app></t:l>
          <t:l n="5">ከመ፡ <t:app type="orthographic"><t:lem wit="#A">እጕለ፡</t:lem><t:rdg wit="#B">እጉለ፡</t:rdg></t:app> ላህም፡ ዘይሰመይ፡ ጣዕዋ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="13">
          <t:l n="1">ሰላም፡ ለመከየድኪ፡ ወለአፃብ<t:pb corresp="#A" n="169r"/><t:cb corresp="#A" n="a"/>ዕኪ፡ <t:app type="orthographic"><t:lem wit="#A">በመዐርይ፨</t:lem><t:rdg wit="#B">በመዓርይ፨</t:rdg></t:app></t:l>
          <t:l n="2"><t:app type="orthographic"><t:lem wit="#A">ወለአጽፋርኪኒ፡</t:lem><t:rdg wit="#B">ወለአጽፋሪኪኒ፡</t:rdg></t:app> <t:app><t:lem wit="#B">ዘጽዕዳዌሆን፡</t:lem><t:rdg wit="#A">ዘፅዕዳዊሆን፡</t:rdg></t:app> ባሕርይ፨</t:l>
          <t:l n="3">ሞቅሒ፡ ሊተ፡ አርሲማ፡ በልጓመ፡ መንፈስ፡ ሠናይ፨</t:l>
          <t:l n="4">ኢይቅትለኒ፡ <t:app type="orthographic"><t:lem wit="#A">አሥጋሪሃ፡</t:lem><t:rdg wit="#B" type="orthographic">አስጋሪሃ፡</t:rdg></t:app> <t:app type="orthographic"><t:lem wit="#B">በሕምዘ፡</t:lem><t:rdg wit="#A">በኅምዘ፡</t:rdg></t:app> <t:app><t:lem wit="#B">ንባባ፡</t:lem><t:rdg wit="#A">ንባብ፡</t:rdg></t:app> እኩይ፨</t:l>
          <t:l n="5">ንስቲት፡ እምአባልየ፡ <t:app type="orthographic"><t:lem wit="#B">ወድምፃ፡</t:lem><t:rdg wit="#A">ወድምጻ፡</t:rdg></t:app> ዐባይ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="14">
          <t:l n="1">ሰላም፡ ለቆምኪ፡ ዘይ<t:cb corresp="#B" n="b"/>መስል፡ በቀልተ፨</t:l>
          <t:l n="2"><t:choice><t:corr resp="AD">ወለመልክእኪ፡</t:corr><t:sic>ወለመልክዕኪ፡</t:sic></t:choice> ኵሉ፡ <t:app><t:lem wit="#A">እንበለ፡</t:lem><t:rdg wit="#B"/></t:app> እኅድግ፡ አሐተ፨</t:l>
          <t:l n="3">አርሲማ፡ ሀብኒ፡ አምጣነ፡ ብየ፡ ተምኔተ፨</t:l>
          <t:l n="4">ለክርስቶስ፡ በቋዔ፡ ተድላ፡ ምስለ፡ <t:app type="orthographic"><t:lem wit="#A">አሥምሮቱ፡</t:lem><t:rdg wit="#B">አስምሮቱ፡</t:rdg></t:app> ሕይወተ፨</t:l>
          <t:l n="5">እስመ፡ ፈድፋደ፡ እፈርህ፡ መዊተ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="15">
          <t:l n="1">ሰላም፡ <t:app type="orthographic"><t:lem wit="#A">ለፀአተ፡</t:lem><t:rdg wit="#B">ለፀዓተ፡</t:rdg></t:app> ነፍስኪ፡ በዕለተ፡ መተሩኪ፡ ርእሰ፨</t:l>
          <t:l n="2">ለበድነ፡ ሥጋኪ፡ ወለግንዘትኪ፡ <t:choice><t:corr resp="AD">ኅውሠ፨</t:corr><t:sic><t:app type="orthographic"><t:rdg wit="#B">ኅውሰ፨</t:rdg><t:rdg wit="#A">ሕውሰ፨</t:rdg></t:app></t:sic></t:choice></t:l>
          <t:l n="3">አርሲማ፡ <t:app><t:lem wit="#A">ብዕልት፡</t:lem><t:rdg wit="#B">ብጽዕት፡</t:rdg></t:app> ኢታርእይኒ፡ <t:choice><t:corr resp="AD">ተጽናሰ፨</t:corr><t:sic>ተፅናሰ፨</t:sic></t:choice></t:l>
          <t:l n="4"><t:app><t:lem wit="#A">ሴስይኒ፡</t:lem><t:rdg wit="#B">ሴስየኒ፡</t:rdg></t:app> እመዝገብኪ፡ እስመ፡ ኢይክል፡ ሐሪሰ፨</t:l>
          <t:l n="5">ወስኢለሂ፡ <t:choice><t:corr resp="AD">አኀፍር፡</t:corr><t:sic>አኃፍር፡</t:sic></t:choice> አንሰ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="16">
          <t:l n="1">ሰላም፡ ለመቃብርኪ፡ ወለፍልሰትኪ፡ ኅቡረ፨</t:l>
          <t:l n="2">ከመ፡ እለ፡ አሳፍ፡ ሎቱ፡ እንዘ፡ አቄርብ፡ መዝሙረ፨</t:l>
          <t:l n="3">አርሲማ፡ እግዝእት፡ እንተ፡ <t:app type="orthographic"><t:lem wit="#B">ትሰረገዊ፡</t:lem><t:rdg wit="#A">ትሠረገዊ፡</t:rdg></t:app> ክብረ፨</t:l>
          <t:l n="4">ኢትሰድኒ፡ ፄዋ፡ እምኀበ፡ ፈጣሪ፡ ኢሠምረ፨</t:l>
          <t:l n="5">ዘሕሊናየ፡ ሞቅሒ፡ አእጋረ፨</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="17">
          <t:l n="1">እም<t:cb corresp="#B" n="c"/>ንዴትየ፡ ዘአቅረብኩ፡ ንዋየ፡ <t:choice><t:corr resp="AD">ማሕሌትኪ፡</t:corr><t:sic>ማኅሌትኪ፡</t:sic></t:choice> ዝንቱ፨</t:l>
          <t:l n="2">ስብሐተ፡ <t:choice><t:corr resp="AD">መልክእኪ፡</t:corr><t:sic>መልክዕኪ፡</t:sic></t:choice> ኵሉ፡ እንተ፡ ሀለወ፡ ውስቱ፨</t:l>
          <t:l n="3">አርሲማ፡ <t:app><t:lem wit="#A">ብፅዕት፡</t:lem><t:rdg wit="#B">ብዕልት፡</t:rdg></t:app> ለእግዚአብሔር፡ ሰማዕቱ፨</t:l>
          <t:l n="4">አዕርጊ፡ ቅድመ፡ ገጽኪ፡ ወተወከፊዮ፡ ሎቱ፨</t:l>
          <t:l n="5">ኀበ፡ ቅድመ፡ አምላክ፡ <t:app type="orthographic"><t:lem wit="#B">ዘዐርገ፡</t:lem><t:rdg wit="#A">ዘዓርገ፡</t:rdg></t:app> ለአቤል፡ መሥዋዕቱ፨</t:l>
        </t:lg>

        <t:app>
          <t:lem wit="#A">

            <t:ab><t:supplied resp="AD" reason="explanation">ተረፈ፡ መልክእ፡</t:supplied></t:ab>

            <t:lg type="stanza" n="A">
              <t:l n="1"><t:pb corresp="#A" n="169v"/><t:cb corresp="#A" n="a"/>ሰላም፡ ለኪ፡ አርሲማ፡ ኅሪት፨</t:l>
              <t:l n="2">አመተ፡ ማርያም፡ ቡርክት፨</t:l>
              <t:l n="3"><t:choice><t:corr resp="AD">ዘኢያፍርሀኪ፡</t:corr><t:sic>ዘኢያፍርሃኪ፡</t:sic></t:choice> እቶነ፡ እሳት፨</t:l>
              <t:l n="4">ፅዕዱት፡ ዖፈ፡ ገነት፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="B">
              <t:l n="1">ሰላም፡ ለኪ፡ መዋግደ፡ ጽኑዕ፡ አዝማን፨</t:l>
              <t:l n="2">አመ፡ አንሥአ፡ ሰይጣን፨</t:l>
              <t:l n="3"><t:choice><t:corr resp="AD">ዘኢያፍርሀኪ፡</t:corr><t:sic>ዘኢያፍርሃኪ፡</t:sic></t:choice> እሳተ፡ እቶን፨</t:l>
              <t:l n="4">አርሲማ፡ ሰማዕተ፡ መድኅን፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="C">
              <t:l n="1">ሰላም፡ ለኪ፡ ለብፅዕት፡ አርሲማ፨</t:l>
              <t:l n="2">ሰማዕተ፡ ኢየሱስ፡ ፌማ፨</t:l>
              <t:l n="3">እቶነ፡ እሳት፡ ዘኢያሕመማ፨</t:l>
              <t:l n="4">ክልልት፡ በአክሊለ፡ ግርማ፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="D">
              <t:l n="1">ሰላም፡ ለኪ፡ ለንጉሠ፡ ስሕተት፡ <t:choice><t:corr resp="AD">በዐውዱ፨</t:corr><t:sic>በዓውዱ፨</t:sic></t:choice></t:l>
              <t:l n="2">እንተ፡ ላዕሌኪ፡ ዕልዋን፡ ሥቃየ፡ ኵነኔ፡ አክበዱ፨</t:l>
              <t:l n="3">እስከ፡ አባልኪ፡ በእሳት፡ አንደዱ፨</t:l>
              <t:l n="4">ምዕዝት፡ እምናርዱ፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="E">
              <t:l n="1">ሰላም፡ ለኪ፡ አርሲማ፡ ሥጋኪ፡ ሶበ፡ ሰተሩ፨</t:l>
              <t:l n="2"><t:choice><t:sic>ወአዕፅምትኪ፡</t:sic><t:corr resp="AD">ወአዕፅምተኪ፡</t:corr></t:choice> ሰበሩ፨</t:l>
              <t:l n="3">ክሳደኪኒ፡ መጦኪ፡ በ<t:cb corresp="#A" n="b"/>መጥባሕት፡ ይምትሩ፨</t:l>
              <t:l n="4">ለክርስቶስ፡ በእንተ፡ ፍቅሩ፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="F">
              <t:l n="1">ሰላም፡ ለኪ፡ አርሲማ፡ ባሕርይ፨</t:l>
              <t:l n="2">ለነፍሰ፡ ኵሉ፡ ምስካይ፨</t:l>
              <t:l n="3">ከማኪ፡ አልቦ፡ እምታሕተ፡ ሰማይ፨</t:l>
              <t:l n="4">በሥን፡ ወበላሕይ፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="G">
              <t:l n="1">ሰላም፡ ለኪ፡ ሶበ፡ መተሩ፡ ክሳዳ፨</t:l>
              <t:l n="2"><t:choice><t:corr resp="AD">ለስምዐ፡</t:corr><t:sic>ለስምዓ፡</t:sic></t:choice> ኵነኔ፡ <t:choice><t:corr resp="AD">በዐውዳ፨</t:corr><t:sic>በዓውዳ፨</t:sic></t:choice></t:l>
              <t:l n="3">ደም፡ ውሕዘ፡ ወሐሊብ፡ ፀዓዳ፨</t:l>
              <t:l n="4">ምዕዝት፡ እምጽጌ፡ ረዳ፨</t:l>
            </t:lg>

            <t:lg type="stanza" n="H">
              <t:l n="1">ሰላም፡ ለኪ፡ መጠነ፡ አማኅኩኪ፡ ሊተ፡ አርሲማ፡ እምየ፨</t:l>
              <t:l n="2">ልበ፡ መዋቲ፡ ዘኢሐለየ፨</t:l>
              <t:l n="3"><t:choice><t:corr resp="AD">ወዐይነ፡</t:corr><t:sic>ወዓይነ፡</t:sic></t:choice> ሰብእ፡ ዘኢርእየ፨</t:l>
              <t:l n="4">ለፍቁርኪ፡ <t:hi rend="rubric">ዘድንግል፡</t:hi> ድልዊ፡ <t:choice><t:corr resp="AD">ዐስብየ፨</t:corr><t:sic>ዓስብየ፨</t:sic></t:choice></t:l>
            </t:lg>

          </t:lem>
          <t:rdg wit="#B"/>
        </t:app>

      </t:div>

      <t:div type="translation" xml:lang="en">

        <t:lg type="stanza" n="1">
          <t:l n="1">Salutation to the memory of your name which has four letters</t:l>
          <t:l n="2">Like the four fashioned parts of the Cross of Christ the Lord.</t:l>
          <t:l n="3">Blessed Hripsime, patient through trial and martyrdom,</t:l>
          <t:l n="4">Feed me from your breasts with the milk of joy and gladness</t:l>
          <t:l n="5">So that I may read the words of your praise with an eloquent tongue.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="2">
          <t:l n="1">Salutation to your hair and your crowned head</t:l>
          <t:l n="2">And to your face, red like a pomegranate or an apple.</t:l>
          <t:l n="3">Hripsime, victorious over the judges of error and perdition,</t:l>
          <t:l n="4">Give me a waterskin of knowledge from the pool (of) your praise</t:l>
          <t:l n="5">So that I may draw a little and pour out a fountain.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="3">
          <t:l n="1">Salutation to your eyelashes and your eyes (which are like) a full moon,</t:l>
          <t:l n="2">And to your ears which were inclined to the words of the glad angel.</t:l>
          <t:l n="3">Galilean Hripsime, dressed in glorious faith,</t:l>
          <t:l n="4">How were you not afraid of the frightening furnace of flames?</t:l>
          <t:l n="5">And how were you not terrified at all by its boiling pot?</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="4">
          <t:l n="1">Salutation to your cheeks which were beaten and lacerated</t:l>
          <t:l n="2">When the fragrance of the Bride of Koskam's love entered your nostrils.</t:l>
          <t:l n="3">Cut off the head of my enemy, Hripsime, and hang it in the tent</t:l>
          <t:l n="4">(Like) the daughter of Merari did to Holofernes, her enemy,</t:l>
          <t:l n="5">When, having cut his neck, she hung his head upon the top of his bed's canopy.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="5">
          <t:l n="1">Salutation to your lips, your mouth and your teeth, the beauty of ʾƎblā,</t:l>
          <t:l n="2">Also to your tongue with its breath and voice.</t:l>
          <t:l n="3">Hripsime, turn to me, a poor seeker of happiness,</t:l>
          <t:l n="4">So that you will give me a portion of the bread of your grace</t:l>
          <t:l n="5">And the richness of your existing goodness.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="6">
          <t:l n="1">‘Salutation,’ I say to your throat and your neck I salute;</t:l>
          <t:l n="2">Salutation to your shoulders and your back, clothed in magnificence.</t:l>
          <t:l n="3">For your weakened daughter you are a wearer of strength, Hripsime.</t:l>
          <t:l n="4">Toss the enemy of my soul into a chasm of pain and toil</t:l>
          <t:l n="5">Like Esther threw Haman from his couch.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="7">
          <t:l n="1">Salutation to your chest and your honoured bosom</t:l>
          <t:l n="2">And to your hands, also, with their tormented arms.</t:l>
          <t:l n="3">Hripsime, a litter for your Lady,</t:l>
          <t:l n="4">Salutation to her flight and the story of her wondrous oppression,</t:l>
          <t:l n="5">As she is Queen in heaven and on earth.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="8">
          <t:l n="1">Salutation to your elbows, your forearms and your palms; ‘Salutation,’ I say</t:l>
          <t:l n="2">To your ten fingers and their nails.</t:l>
          <t:l n="3">Hripsime, on account of the sorrowful flight of the Virgin,</t:l>
          <t:l n="4">Renew the days of this season for me,</t:l>
          <t:l n="5">For impiety has seized them from me.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="9">
          <t:l n="1">Salutation to your breasts and your sides which are adorned with a verdure of gold</t:l>
          <t:l n="2">And to your belly with its heart and kidneys.</t:l>
          <t:l n="5">Hripsime, intercede with your God</t:l>
          <t:l n="3">On account of the flight of the Virgin and the exile of her only Son</t:l>
          <t:l n="4">That you might freely make me, a worthless sinner, righteous.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="10">
          <t:l n="1">Salutation to your mind which ponders good things</t:l>
          <t:l n="2">And to your intestines and your equal bowels.</t:l>
          <t:l n="3">Be vigilant, that you might awaken my heart to repentance!</t:l>
          <t:l n="4">O how the shadow of sin conceals me, Hripsime,</t:l>
          <t:l n="5">As your lamp goes before me.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="11">
          <t:l n="1">Salutation to your navel and your sealed virginity</t:l>
          <t:l n="2">And to your hips and your pleasant thighs.</t:l>
          <t:l n="3">‘Salutation,’ I say to you, Hripsime, with a sweet kiss.</t:l>
          <t:l n="4">Salutation, also, to holy Mary's dwelling place:</t:l>
          <t:l n="5">Salutation, salutation to you, (Mount) Koskam.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="12">
          <t:l n="1">Salutation to your knees which laboured in prostrating to the Most High,</t:l>
          <t:l n="2">With (your) feet and heels which are adjacent to them.</t:l>
          <t:l n="3">Hripsime, grant that I may traverse with you the paths</t:l>
          <t:l n="4">To the Eastern Paradise and leap for joy in wandering it</t:l>
          <t:l n="5">Like the young of an ox, which is called a heifer.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="13">
          <t:l n="1">Salutation to the soles of your feet and your toes equally</t:l>
          <t:l n="2">And to your toenails, whose whiteness (is like) a pearl.</t:l>
          <t:l n="3">Bind me, Hripsime, with a cord of good spirit</t:l>
          <t:l n="4">Lest (my tongue's) ensnarer kill me with the poison of its evil utterance,</t:l>
          <t:l n="5">(For it is) a small (part) of my flesh (yet) its sound (is) loud.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="14">
          <t:l n="1">Salutation to your stature which resembles a date palm</t:l>
          <t:l n="2">And to your entire image, lest I should forget a single part.</t:l>
          <t:l n="3">Hripsime, give me, as much as I want,</t:l>
          <t:l n="4">A life pleasing to Christ, the benefactor of delight,</t:l>
          <t:l n="5">For I am exceedingly afraid to die.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="15">
          <t:l n="1">Salutation to the departure of your soul on the day that they cut off your head</t:l>
          <t:l n="2">And to the remains of your body and your shrouding together.</t:l>
          <t:l n="3">Wealthy Hripsime, lest poverty come upon me,</t:l>
          <t:l n="4">Feed me from your storehouse, for I am unable to cultivate (anything for myself)</t:l>
          <t:l n="5">And I am ashamed to beg.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="16">
          <t:l n="1">Salutation to your sepulchre together with the translation of your body,</t:l>
          <t:l n="2">As I bring a psalm for it like those of Asaph.</t:l>
          <t:l n="3">Hripsime, the lady adorned with honour,</t:l>
          <t:l n="4">Do not cast me into exile from the Creator (because) He is displeased;</t:l>
          <t:l n="5">Fetter the feet of my mind.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="17">
          <t:l n="1">Out of my poverty I have offered you the wealth of this song</t:l>
          <t:l n="2">In which is the praise of your entire image.</t:l>
          <t:l n="3">Blessed Hripsime, martyr of the Lord,</t:l>
          <t:l n="4">Make it ascend before your face and receive it</t:l>
          <t:l n="5">In the place where the offering of Abel rose before God.</t:l>
        </t:lg>

        <t:ab>[Tarafa Malkǝʾ]</t:ab>
        
        <t:lg type="stanza" n="A">
          <t:l n="1">Salutation to you, chosen Hripsime:</t:l>
          <t:l n="2">Handmaiden of blessed Mary,</t:l>
          <t:l n="3">You who did not fear the furnace of fire,</t:l>
          <t:l n="4">A white bird of paradise.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="B">
          <t:l n="1">Salutation to you! When Satan aroused</t:l>
          <t:l n="2">The waves of strong time,</t:l>
          <t:l n="3">You were not afraid of a fiery furnace,</t:l>
          <t:l n="4">Hripsime, the Saviour's martyr.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="C">
          <t:l n="1">Salutation to you, blessed Hripsime:</t:l>
          <t:l n="2">Martyr of Jesus the Creator</t:l>
          <t:l n="3">Whom a furnace of fire did not harm,</t:l>
          <t:l n="4">Crowned with a crown of awesomeness.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="D">
          <t:l n="1">Salutation to you, Hripsime! In the king of error's court,</t:l>
          <t:l n="2">The unbelievers burdened you with a torturous judgement</t:l>
          <t:l n="3">Until they burned your flesh with fire,</t:l>
          <t:l n="4">More fragrant than nard.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="E">
          <t:l n="1">Salutation to you, Hripsime! When they lacerated your flesh</t:l>
          <t:l n="2">And broke your bones</t:l>
          <t:l n="3">You surrendered your neck that they might cut it with a sword</t:l>
          <t:l n="4">For the sake of the love of Christ.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="F">
          <t:l n="1">Salutation to you, Hripsime, a pearl</t:l>
          <t:l n="2">For the soul of every desolate person.</t:l>
          <t:l n="3">There is no one like you below heaven</t:l>
          <t:l n="4">In splendour and beauty.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="G">
          <t:l n="1">Salutation to you! When they cut her neck</t:l>
          <t:l n="2">In the arena of martyrdom’s suffering</t:l>
          <t:l n="3">Blood flowed with white milk</t:l>
          <t:l n="4">More fragrant than a rose.</t:l>
        </t:lg>
        
        <t:lg type="stanza" n="H">
          <t:l n="1">Salutation to you! As much as I have greeted you, Hripsime my mother,</t:l>
          <t:l n="4">Prepare for me, your beloved Zadǝngǝl, a reward</t:l>
          <t:l n="2">Of which the heart of mortals cannot conceive</t:l>
          <t:l n="3">And which the eye of men cannot see. </t:l>
        </t:lg>

      </t:div>

      

    </t:body>
  </t:text></TEI>