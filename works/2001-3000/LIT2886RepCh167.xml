         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2886RepCh167">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">እኁዛነ፡ አርማሕ፡ ወማእፀድ፨</t:l>
                  <t:l n="2">ማኅበረ፡ ሚካኤል፡ ተስዓ፡ ወትስዐቱ፡ ነገድ፨</t:l>
                  <t:l n="3">_____</t:l>
                  <t:l n="4">_____ ዐጽፍክሙ፡ ዘነጐድጓድ፨</t:l>
                  <t:l n="5">_____ በነድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">_____</t:l>
                  <t:l n="2">_____ ፈ፡ መልክእከ፡ እጽሐፍ፡ መጽሐፈ፡ ብርሃን፨</t:l>
                  <t:l n="3">ሚካኤል፡ ዜናዊ፡ ጸአተ፡ እስራኤል፡ እምዖን፨</t:l>
                  <t:l n="4">ነዓኒ፡ ከመ፡ እንግርከ፡ እንተ፡ ዘብየ፡ ኀዘን፨</t:l>
                  <t:l n="5">መፍትው፡ ይንግርዎ፡ ለአርክ፡ ምእመን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘጥቀ፡ ተሞገሰ፨</t:l>
                  <t:l n="2">እስከ፡ በኀይላት፡ ከብረ፡ ወበሊቃናት፡ ረአሰ፨</t:l>
                  <t:l n="3">ጊዜ፡ ተከዝኩ፡ ትካዘ፡ ወጊዜ፡ ኀጣዕኩ፡ ፈውሰ፨</t:l>
                  <t:l n="4">ቅድመ፡ ሥዕልከ፡ ሚካኤል፡ ሶበ፡ እትመሀላል፡ አንሰ፨</t:l>
                  <t:l n="5">እንዘ፡ ይብል፡ ነየ፡ ንበበኒ፡ ሥልሰ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለድምድማከ፡ የማነ፡ ልዑል፡ ዘደለላ፨</t:l>
                  <t:l n="2">ሚካኤል፡ ቀዋሚ፡ በመቅደሰ፡ ሰማይ፡ ጌርጌላ፨</t:l>
                  <t:l n="3">ይእተ፡ ጊዜ፡ በጺሐከ፡ በሰረገላ፨</t:l>
                  <t:l n="4">ለኀይድ፡ ወለመሢጥ፡ ሶበ፡ ይትኤገለኒ፡ ተኵላ፨</t:l>
                  <t:l n="5">በመርብረቀ፡ አሕፃከ፡ ሚካኤል፡ ተድላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ዘይትቄጸል፡ ጽድቀ፡</t:l>
                  <t:l n="2">አኮ፡ አኮ፡ ብሩር፡ ወወርቀ፨</t:l>
                  <t:l n="3">ሚካኤል፡ አውቅየ፡ ወማእምርየ፡ ጥዩቀ፨</t:l>
                  <t:l n="4">ከመ፡ ታደንግፆ፡ ለአበ፡ ደምየ፡ ሕቀ፨</t:l>
                  <t:l n="5">ቅድመ፡ ገጽየ፡ አንጦልዕ፡ መብረቀ።</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለስእርተ፡ ርእስከ፡ ዘኢይትከሀል፡ ለኈልቆ፨</t:l>
                  <t:l n="2">ወዕፁብ፡ ካዕበ፡ ለርእዪ፡ ወለጠይቆ፨</t:l>
                  <t:l n="3">ሚካኤል፡ ነዓ፡ ፀረ፡ ሕይወትየ፡ ለተዳድቆ፨</t:l>
                  <t:l n="4">ሰማይ፡ እንከ፡ ለይጽብቦ፡ ወስፍሐ፡ ዓለም፡ ታጽእቆ፨</t:l>
                  <t:l n="5">አፍሓመ፡ ገጽከ፡ ያኅቱ፡ እምሰማይ፡ በሪቆ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለፍጽምከ፡ እምስዕለ፡ እሳት፡ ዘተቀልመ፡</t:l>
                  <t:l n="2">ቃለ፡ መፍርሃ፡ ወኅቡአ፡ ስመ፨</t:l>
                  <t:l n="3">ሚካኤል፡ ግሩም፡ እንተ፡ ትትአጸፍ፡ አፍሓም፨</t:l>
                  <t:l n="4">ሀቦ፡ ለፀርየ፡ ዘይነብበኒ፡ ሕሠመ፨</t:l>
                  <t:l n="5">ልሳነ፡ ፍጹመ፡ ወአፈ፡ በሀመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ እብል፡ ለገጽከ፡ ሥኖ፨</t:l>
                  <t:l n="2">ዘየኀቱ፡ ጥቀ፡ እምዕንቈ፡ ኢያስጲድ፡ ወሰርዲኖ፨</t:l>
                  <t:l n="3">ሚካኤል፡ ስመረኒ፡ በኢመንኖ፨</t:l>
                  <t:l n="4">ዘተገደፍኩ፡ ላዕሌከ፡ ኀበ፡ ዘትክል፡ አድኅኖ፨</t:l>
                  <t:l n="5">ሚላዕሌየ፡ ዘኮነ፡ ከዊኖ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለአክናፊከ፡ እለ፡ ሥርግዋት፡ በርስን፨</t:l>
                  <t:l n="2">ዖፈ፡ ነደ፡ እሳት፡ ዘሑረትከ፡ በሥን፨</t:l>
                  <t:l n="3">ሚካኤል፡ ዐቢይ፡ መልአከ፡ ብርሃን፨</t:l>
                  <t:l n="4">ተናበበኒ፡ እምድኅሬየ፡ ከመ፡ ድምፀ፡ መጥቅዕ፡ ወቃርን፨</t:l>
                  <t:l n="5">በቃለ፡ ነጐድጓድ፡ ገዚፍ፡ ወፋጻ፡ ቀጢን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለአክናፊከ፡ ከመ፡ መብረቅ፡ እለ፡ ነጠራ፨</t:l>
                  <t:l n="2">ለድምሳሴ፡ ወለገሞራ፨</t:l>
                  <t:l n="3">ሚካኤል፡ ዘሖርከ፡ ቅድመ፡ ትዕይንቶሙ፡ ለድዮስጶራ፨</t:l>
                  <t:l n="4">ኀይለከ፡ ርእያ፡ ወትእምርተከ፡ ኀጺራ፨</t:l>
                  <t:l n="5">ተከፍለት፡ ባሕር፡ ወፈርሀት፡ ኤርትራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለሕንጋዛቲከ፡ አፈዋተ፡ ብርሃን፡ ምሉእ፨</t:l>
                  <t:l n="2">ዘይሔውዝ፡ ፈድፉደ፡ እምገነተ፡ ከርካዕ፨</t:l>
                  <t:l n="3">መኑ፡ ከማከ፡ ከመ፡ ከማከ፡ ካልእ፨</t:l>
                  <t:l n="4">ሚካኤል፡ ብሂል፡ ዕፁብ፡ ነገር፡ ሳቡእ፨</t:l>
                  <t:l n="5">ገብርኤል፡ ብሂል፡ አምላክ፡ ወሰብእ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ ለስብሐተ፡ ልዑል፡ ክዳና፨</t:l>
                  <t:l n="2">ወአክሊለ፡ ብእሲ፡ አዳም፡ ኢኮነ፡ ከመ፡ መጠና፨</t:l>
                  <t:l n="3">ሚካኤል፡ አዕርግ፡ ቍርባነ፡ አፉየ፡ መና፨</t:l>
                  <t:l n="4">እንተ፡ አቅረብት፡ ለከብርከ፡ ንስቲተ፡ መሀና፨</t:l>
                  <t:l n="5">ሰማየ፡ ሰማያተ፡ እሕልፍ፡ ወአእዱ፡ ደመና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ሰላም፡ ለመልክእከ፡ ነበልባለ፡ እሳት፡ በሐቢ፨</t:l>
                  <t:l n="2">ዘበኵሕ፡ ፈድፉደ፡ እምአፍሓመ፡ እሳት፡ ዘነሃቢ፨</t:l>
                  <t:l n="3">ሚካኤል፡ አንተ፡ በዲበ፡ አእላፍ፡ ኀቢ፨</t:l>
                  <t:l n="4">ዐቃቢ፡ ለነፍስ፡ ኵሉ፡ ፍጥረት፡ ዐቃቢ፨</t:l>
                  <t:l n="5">አማን፡ ረቢ፡ እመላእክት፡ ሚካኤል፡ የዐቢ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="54">
                  <t:l n="1">ሰላም፡ ለመልክእከ፡ ነደ፡ እሳት፡ ዘያውዒ፨</t:l>
                  <t:l n="2">መልአከ፡ ኀያላን፡ አንተ፡ ወሥልጣነ፡ ሞት፡ ጸባኢ፨</t:l>
                  <t:l n="3">ሚካኤል፡ ረሲ፡ ላዕለ፡ ፀርየ፡ ገፉዒ፨</t:l>
                  <t:l n="4">አፈ፡ ከለባት፡ ወልሳነ፡ አርዌ፡ ጸላኢ፨</t:l>
                  <t:l n="5">በአፈ፡ ኲናት፡ በሊሕ፡ ወእሳት፡ በላዒ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="55">
                  <t:l n="1">ሰላም፡ እብል፡ ለኵሎን፡ መልክእከ፡ በውዳሴ፨</t:l>
                  <t:l n="2">ዘመራሕኮሙ፡ ሚካኤል፡ ጊዜ፡ ፀአቶሙ፡ ለሕዝበ፡ ራምሴ፨</t:l>
                  <t:l n="3">ለዝ፡ መልአክ፡ መልአከ፡ ቅዳሴ፨</t:l>
                  <t:l n="4">ንግሩ፡ ኀይሎ፡ ቤተ፡ ያዕቆብ፡ ወአውሴ፨</t:l>
                  <t:l n="5">ወመንከሮሂ፡ አሮን፡ ወሙሴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="56">
                  <t:l n="1">ውዳሴ፡ መልክእከ፡ ዘንተ፡ እንበይነ፡ ዘአቅረብኩ፡ ለከ፡ በግናይ፨</t:l>
                  <t:l n="2">ተኀፊርየ፡ ኢይግባእ፡ ዘሰአልኩከ፡ ነዳይ፨</t:l>
                  <t:l n="3">አስምዐኒ፡ እስኩ፡ ቃለ፡ ፍትሕከ፡ ዐባይ፨</t:l>
                  <t:l n="4">እሰብከከ፡ ሚካኤል፡ በኀይለ፡ ሠለስቱ፡ ፀሓይ፨</t:l>
                  <t:l n="5">ወበስመ፡ ማርያም፡ ድንግል፡ ዳግሚት፡ ሰማይ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>