         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2857RepCh139">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ወለሥዕርተ፡ ርእስከ፡ ውዱስ፨</t:l>
                  <t:l n="2">በልሳነ፡ ኵሎ፡ ዘነፍስ፨</t:l>
                  <t:l n="3">ጥንተ፡ ዕጉሣን፡ ኢዮብ፡ ዘሥርጋዌከ፡ ተጽናስ፨</t:l>
                  <t:l n="4">አምረኒ፡ ፍና፡ ትዕግሥት፡ አመ፡ ዕለተ፡ ቅስት፡ ወሒስ፨</t:l>
                  <t:l n="5">ከመ፡ ኢያስርሐኒ፡ ኤልፋዝ፡ ዐመፃ፡ ወርኵስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ወለገጽከ፡ ካልኡ፨</t:l>
                  <t:l n="2">እምነ፡ ላህይ፡ አፍአዊ፡ ዘበውሳጣዊ፡ ተኀብኡ፨</t:l>
                  <t:l n="3">መሠረተ፡ ትዕግሥት፡ ኢዮብ፡ ለያዕቆብ፡ ዘርአ፡ ዘርኡ፨</t:l>
                  <t:l n="4">አድኅነኒ፡ እምአፅራርየ፡ እለ፡ ያስሕቱኒ፡ መጽኡ፨</t:l>
                  <t:l n="5">ሶበ፡ ሕማምየ፡ እምርኁቅ፡ ስምዑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ወለማቅብሪከ፡ በኁባሬ፨</t:l>
                  <t:l n="2">ዘያቄርቡ፡ ሎቱ፡ ጸባሕተ፡ አኰቴት፡ ስብአ፡ ዝማሬ፨</t:l>
                  <t:l n="3">ኅሩይ፡ ኢዮብ፡ ወልደ፡ ወልደ፡ ያዕቆብ፡ ኅሬ፨</t:l>
                  <t:l n="4">ግቡር፡ ሰብእናየ፡ እስከ፡ የአምር፡ ገባሬ፨</t:l>
                  <t:l n="5">ኪዳነ፡ ዚአከ፡ ይኩኖ፡ መሓሬ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለትንሣኤከ፡ በዕለተ፡ ይምጽእ፡ ቃል፨</t:l>
                  <t:l n="2">ለውሂበ፡ ዕሤት፡ ሠናይ፡ ወውሂበ፡ ሐጕል፨</t:l>
                  <t:l n="3">ነዳየ፡ አፍአ፡ ኢዮብ፡ ወውሳጤከ፡ ባዕል፨</t:l>
                  <t:l n="4">ዘትረክበ፡ በባሕቲትከ፡ ነገረ፡ መደንግፅ፡ መስቀል፨</t:l>
                  <t:l n="5">እምቅድመ፡ ለአግብርቲከ፡ ይስብክ፡ ግዕዛን፡ ወንጌል፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>