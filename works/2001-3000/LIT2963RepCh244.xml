         <t:div type="edition" xml:lang="gez" xml:id="div2LIT2963RepCh244">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በመሠረተ፡ ቃል፡ አንበርኩ፡ ለማኅፈደ፡ ዝክርከ፡ ስሞ፨</t:l>
                  <t:l n="2">ላዕላዐ፡ ልሳን፡ ወልድከ፡ በጽሂቅ፡ አስተሐምሞ፨</t:l>
                  <t:l n="3">ተራድአኒ፡ አሮን፡ ዘልማድከ፡ ተርጕሞ፨</t:l>
                  <t:l n="4">ኢይበል፡ አፈ፡ በሀሊ፡ ለለ፡ ይኔጽር፡ ቀዊሞ፨</t:l>
                  <t:l n="5">አኀዘ፡ ይሕንጽ፡ ወስእነ፡ ፈጽሞ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ምስለ፡ ስመ፡ ነቢይ፡ ዘተሳተፈ፨</t:l>
                  <t:l n="2">ለአምላከ፡ ፈርዖን፡ ሙሴ፡ እንተ፡ ይሰምይዎ፡ አፈ፨</t:l>
                  <t:l n="3">ሐረሳዊ፡ መስቀል፡ አሮን፡ ከመ፡ ዜናከ፡ ተጽሕፈ፨</t:l>
                  <t:l n="4">በገራህተ፡ ገድል፡ እምአመ፡ አኀዝከ፡ ዕርፈ፨</t:l>
                  <t:l n="5">ኢያጽነንከ፡ ትልመ፡ አሐተ፡ ምዕራፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ አስከሬነ፡ ኅቡእ፡ መዝገብ፨</t:l>
                  <t:l n="2">ንፍቀ፡ ደብረ፡ ፋራን፡ ዛቲ፡ ወግረ፡ ጎልጎታ፡ ዘዐርብ፨</t:l>
                  <t:l n="3">ጊዜ፡ ነቂሆትከ፡ አሮን፡ እምዐራተ፡ ዛቲ፡ ምስካብ፨</t:l>
                  <t:l n="4">ኢታቁመኒ፡ በአፍአ፡ እምአፀድከ፡ ከብካብ፨</t:l>
                  <t:l n="5">ምስለ፡ አብያጽየ፡ ኀምስቱ፡ አክላብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">አመ፡ ወርኀ፡ ማእረር፡ አልጸቀ፡ አብድንቲሆሙ፡ አውያን፨</t:l>
                  <t:l n="2">ሶበ፡ ክምረ፡ ከምር፡ ኮነ፡ በማዕፀደ፡ ሞት፡ ፈጣን፨</t:l>
                  <t:l n="3">ዘዘ፡ ገበቶሙ፡ ፈራን፡ በአምሳለ፡ ኅቡእ፡ መድፍን፨</t:l>
                  <t:l n="4">ሰላም፡ ሰላም፡ ለመምህርከ፡ አሮን፨</t:l>
                  <t:l n="5">ወሰላም፡ ካዕበ፡ ለእሉ፡ ኄራን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለትንሣኤከ፡ እንተ፡ ኮነቶ፡ አእጋረ፨</t:l>
                  <t:l n="2">ለትንሣኤ፡ ክርስቶስ፡ ርእስ፡ ከመ፡ ቃለ፡ ምጽሐፍ፡ ነገረ፨</t:l>
                  <t:l n="3">መከየደ፡ ፍቅርከ፡ አሮን፡ ጊዜ፡ ፈቀደ፡ ወሠምረ፨</t:l>
                  <t:l n="4">አረፍተ፡ ልብየ፡ ከመ፡ ይኩኖ፡ ምሕዋረ፨</t:l>
                  <t:l n="5">በቆብዐ፡ አባ፡ ሣሉሲ፡ ፍጹመ፡ ተሰቍረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለዕርገትከ፡ መንግሥተ፡ ሰማያት፡ ትትዋረሱ፨</t:l>
                  <t:l n="2">ዘዐይነ፡ መዊት፡ ኢርእያ፡ ወዘኢኀለያ፡ መንፈሱ፨</t:l>
                  <t:l n="3">አበ፡ አእላፍ፡ አሮን፡ ምስለ፡ ወልድከ፡ ኢያሱ፨</t:l>
                  <t:l n="4">ወምስለ፡ ኵሎሙ፡ እለ፡ ጻማከ፡ ኀሠሡ፨</t:l>
                  <t:l n="5">ወእለ፡ ምስሌከ፡ ህላዌ፡ ቀደሱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለማሕሌተ፡ ዝክርከ፡ አባ፡ ሶበ፡ ሐወጸት፡ ተቅራማ፨</t:l>
                  <t:l n="2">ዘሲሳየ፡ ዕለት፡ ነሥአት፡ በስራሐ፡ ድካም፡ ወሐፈ፡ ጻማ፨</t:l>
                  <t:l n="3">አሮን፡ ብእስ፡ ታስተበቍዐከ፡ አስተሐሚማ፨</t:l>
                  <t:l n="4">ሩት፡ አፈ፡ ነፍስየ፡ ታሕተ፡ እግርከ፡ ነዊማ፨</t:l>
                  <t:l n="5">አረፍተ፡ ቤታ፡ ታሤኒ፡ ወታሰርር፡ ጥቅማ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">እመ፡ ኢፈደዮሙ፡ ሰርከ፡ ለገባእተ፡ ወፍር፡ ወሐቅል፨</t:l>
                  <t:l n="2">እስመ፡ ይከውኖ፡ ኀፍረተ፡ ለበዓለ፡ ገራህት፡ ባዕል፨</t:l>
                  <t:l n="3">ጸግወኒ፡ አሮን፡ ዕሴተ፡ ቡራኬ፡ በቃል፨</t:l>
                  <t:l n="4">ተዘኪረከ፡ እግዚኦ፡ በመጽሐፈ፡ ዳግም፡ ክፍል፨</t:l>
                  <t:l n="5">ለዐሳብ፡ ዐስቦ፡ ኢታቢት፡ ዘይክል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">እኵት፡ እግዚአብሔር፡ ዘክብረ፡ አኰቴት፡ ይደልዎ፨</t:l>
                  <t:l n="2">በአንቀጸ፡ አፉየ፡ ዝንቱ፡ እንበለ፡ አብእ፡ ሐስዎ፨</t:l>
                  <t:l n="3">ጽድቀ፡ ትሩፋቲከ፡ አሮን፡ ዘከፈለኒ፡ ለተዜያንዎ፨</t:l>
                  <t:l n="4">ለአድግኒ፡ ቀዲሙ፡ ዘኢየአምር፡ ለብዎ፨</t:l>
                  <t:l n="5">ስሕተተ፡ ነቢይ፡ ይገሥጽ፡ ንባበ፡ ጸገዎ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>