         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/KTK2J7HH"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Bachmann1892Obadiah"/><title level="m">Dodekapropheton Aethiopum oder die zwölf kleinen Propheten der aethiopischen Bibelübersetzung nach handschriftlichen Quellen herausgegeben und mit text-kritischen Anmerkungen versehen von Dr. Johannes Bachmann&lt;hi rend="italics"&gt;, Heft I:&lt;/hi&gt; Der Prophet Obadia</title><author><forename>Johannes</forename><surname>Bachmann</surname></author><pubPlace>Halle (Saale)</pubPlace><publisher>Max Niemeyer</publisher><date>1892</date><note type="tags"><note type="tag">Bible</note><note type="tag">Minor Prophets</note><note type="tag">Obadiah</note><note type="tag">Old Testament</note><note type="tag">bm:Bachmann1892Obadiah</note></note><note type="tag">Bible</note><note type="tag">Minor Prophets</note><note type="tag">Obadiah</note><note type="tag">Old Testament</note><note type="tag">bm:Bachmann1892Obadiah</note></t:bibl>
            </t:listBibl>
