         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3147Obadiah">
            <t:note>Text of the EOTC printed Bible</t:note>
            <t:ab>
               <t:l n="1">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=1"/>ራእይ፡ ዘርእየ፡ አብድዩ። ከመዝ፡ ይቤ፡ እግዚአብሔር፡ በእንተ፡ ኤዶምያስ፡ ሰሚዐ፡ ሰማዕኩ፡ እምኀበ፡ እግዚአብሔር፡ ወፈነወ፡ ማዕገተ፡ ላዕለ፡ አሕዛብ፡ ታንስኡ፡ ወንትነሳእ፡ ላዕሌሃ፡ ወንትቃተላ።</t:l>
               <t:l n="2">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=2"/>ናሁ፡ ውሑድ፡ ልብከ፡ አስተዐበይከ፡ ዘይነብር፡ ስተ፡ ግበበ፡ ኰኲሕ፡ ወአንኀ፡ ቤቶ፡ ወይበል፡ በልቡ፡ መኑ፡ ያወርደኒ፡ ውስተ፡ ምድር።</t:l>
               <t:l n="4">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=4"/>ወእመሂ፡ ሰረርከ፡ ከመ፡ ንስር፡ ወአንበርከ፡ እጎሊከ፡ ማእከለ፡ ላካዋክብት፡ እምህየ፡ አጸድፈከ፡ ይቤ፡ እግዚአብሔር።</t:l>
               <t:l n="5">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=5"/>እመሂ፡ ሰረቅት፡ ቦኡ፡ ላዕሌከ፡ ወእመኒ፡ ጒሕልያ፡ በሌሊት፡ አይቴኒ፡ ወረዉከ፡ እምኢሰረቁኒ፡ ዘየአክሎሙ፡ ወሶበሂ፡ ቀሳም፡ ቦኡ፡ ላዕሌከ፡ እምኢያትርፋ፡ ለከ፡ ተቅራመ።</t:l>
               <t:l n="6">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=6"/>እፎኑ፡ ፈተንዎ፡ ለዔሳው፡ ዋናስእዎ፡ ዘየኀብዑእ።</t:l>
               <t:l n="7">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=7"/>ወደዱከ፡ እስከ፡ ወሰንከ፡ ወተቃተሉከ፡ እደው፡ እለ፡ ተማሐሉከ፡ ወጸብኡከ፡ ስንእከ፡ ዋሞኡከ፡ ዋዓጋቱከ፡ እምታሕቴከ፡ እለ፡ ላኢይምሕኩከ።</t:l>
               <t:l n="8">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=8"/>ይእተ፡ አሚረ፡ ይቤ፡ እግዚአብሔር፡ አጠፍኦሙ፡ ለጠቢባን፡ እምኤዶምያስ፡ ወእስዕር፡ ምክረ፡ እብብሔር፡ ዔሳው።</t:l>
               <t:l n="9">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=9"/>ወይደነግፁ፡ መስተቃትላኒከ፡ እለ፡ ቴማን፡ ከመ፡ ይጥፋእ፡ ሳብእ፡ እምደወለ፡ ኤሳው።</t:l>
               <t:l n="10">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=10"/>በእንተ፡ ኃጢአተ፡ ቀትሉ፡ ዘምስለ፡ ያዕቆብ፡ እኁሁ፡ ይደፍነከ፡ ኃፍረት፡ ዋትደመሰስ፡ ለዓለመ፡ ዓለም።</t:l>
               <t:l n="11">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=11"/>እስመ፡ ተቃወምከ፡ ፍጽመ፡ አመ፡ ይፄውውዎሙ፡ ካእ፡ ሕዝብ፡ አመ፡ ኀየሉ፡ ወቦኡ፡ ፀር፡ ውስተ፡ አናቅ፡ ጺሃ፡ ወተካፈልዋ፡ ለኢየሩሳሌም፡ ወአንተሂ፡ ከመ፡ ለሐዱ፡ እንኔሆሙ።</t:l>
               <t:l n="12">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=12"/>ወኢምሕኮ፡ ለእኅከ፡ ይእተ፡ አሚረ፡ በዕለተ፡ ፀር፡ ዋኢተፈሳሕክ፡ ላዕለ፡ ደቂቀ፡ ይሁዳ፡ አመ፡ አጥፍእዎሙ፡ ወኢታዕቢ፡ አፋከ፡ በዕለተ፡ ምንዳቤከ።</t:l>
               <t:l n="13">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=13"/>ወኢቦእከ፡ አንቀጸ፡ ህዝብየ፡ አመ፡ ሐፀሮሙ፡ ወኢምሕከ፡ አንተሂ፡ ተዓይኒሆሙ፡ አመ፡ ሠረውዎሙ፡ ወኢወሰከ፡ ዲበ፡ ሠራዊቶመሙአመ፡ አህለቅሙ።</t:l>
               <t:l n="14">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=14"/>ወኢተበቀልካሆሙ፡ ለእለ፡ አምሠጡ፡ ታጥፍኦሙ፡ ላዋኢዐገትኮሙ፡ ለእለ፡ ድኁ፡ ከመ፡ ታመንድቦሙ፡ በዕለተ፡ ተሰብሩ።</t:l>
               <t:l n="15">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=15"/>እስመ፡ አልጸቀት፡ ዕለተ፡ እግዚአብሔር፡ ላዕለ፡ ኰሉ፡ አሕዛብ፡ ወበከመ፡ ገበርከ፡ ከማሁ፡ ይከውን፡ ፍዳከ፡ ዘእፈድየከ፡ ዲበ፡ ርእስከ።</t:l>
               <t:l n="16">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=16"/>ወበከመ፡ ሰተይኮ፡ በደብረ፡ መቅደስየ፡ ከማሁ፡ ይሰትዩ፡ ኲሎሙ፡ አሕዛብ፡ ዋይነ፡ ወይሰትዩ፡ ወይወርዱ፡ ወይከውኑ፡ ከመ፡ ዘኢተፈጥሩ።</t:l>
               <t:l n="17">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=17"/>ወይከውን፡ መድኃኒተ፡ በደብረ፡ ጽዩን፡ ወይከውን፡ ቅድሱ፡ ወይወርስዎሙ፡ ቤተ፡ ያዕቆብ፡ ለእለ፡ ወረስዎሙ።</t:l>
               <t:l n="18">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=18"/>ወይከውን፡ እሳተ፡ ቤተ፡ ያዕቆብ፡ ወቤተ፡ ዩሴፍ፡ ነበልባ፡ ወቤተ፡ ዔሳው፡ ብርዐ፡ ወይነድዱ፡ ዋይበልዕዎሙ፡ ወአልቦ፡ ዜተርፍ፡ በቤ፡ ዔሳው፡ እስመ፡ እግዚአብሔር፡ ነበበ።</t:l>
               <t:l n="19">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=19"/>ወይወርስዎ፡ ለሰብአ፡ ናጌብ፡ ለደብረ፡ ዔሳው፡ ወለእለ፡ ሴፌላ፡ ዘኢሎፍ፡ ወይወርስዎ፡ ለደብረ፡ እፍሬም፡ ወአሕቃላተ፡ ሳማርያ፡ ወብንያም፡ ወገለአድ፡ ወበሐውርቲሆሙ።</t:l>
               <t:l n="20">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=20"/>ወዛቲ፡ ቀዳሚት፡ ፍልሰቶሙ፡ ለደቂቀ፡ እስራኤል፡ በምድረ፡ ከናአን፡ እስከ፡ ሰራጵጣ፡ ወፍልሰተ፡ ኢየሩሳም፡ እስከ፡ ኤፍራ፡ ወይወርሱ፡ አህጉረ፡ ናጌብ።</t:l>
               <t:l n="21">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=Oba&amp;chapter=1&amp;verse=21"/>ወእለ፡ ድኀኑ፡ የዐርጉ፡ እምደብረ፡ ጽዩን፡ ከመ፡ ይትበቀልዎ፡ ለደብረ፡ ዔሳው፡ ወይከውን፡ መንግስት፡ ለእግዚአብሔር።</t:l>
            </t:ab>
         </t:div>
      </t:body>
   </t:text></TEI>