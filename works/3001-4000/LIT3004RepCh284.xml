               <t:bibl corresp="http://zotero.org/groups/358366/items/7X73H4I5"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Pereira1907Acta"/><title level="m">Acta Martyrum</title><title level="s">Corpus Scriptorum Christianorum Orientalium</title><author><t:forename>Franciscus Maria</t:forename><t:surname>Esteves Pereira</t:surname></author><pubPlace>Romae</pubPlace><publisher>Excudebat Karolus de Luigi</publisher><date>1907</date><series><t:title level="s">Corpus Scriptorum Christianorum Orientalium</t:title><t:biblScope unit="volume">Series Altera 28</t:biblScope></series><biblScope unit="volume">Series Altera 28</biblScope><note type="url">https://archive.org/details/actamartyrum01este</note><t:citedRange>68-78</t:citedRange></t:bibl>
