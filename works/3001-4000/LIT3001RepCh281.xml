         <t:div type="edition" xml:lang="gez" xml:id="div3LIT3001RepCh281">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በስመ፡ እግዚአብሔር፡ ዘሀሎ፡ አመ፡ ኢሀሎ፡ ዘመን፨</t:l>
                  <t:l n="2">ወኢቀደሞ፡ ሰዓት፡ መጠነ፡ ቅጽበታ፡ ለዐይን፨</t:l>
                  <t:l n="3">እሰንቁ፡ ለኪ፡ አውታረ፡ ነባቤ፡ ድርሳን፨</t:l>
                  <t:l n="4">ያብርህ፡ ውስተ፡ ልብየ፡ ለወለተ፡ ጴጥሮስ፡ ምእመን፨</t:l>
                  <t:l n="5">ጸዳለ፡ አእምሮ፡ ንስቲት፡ ሲኖዳ፡ ካህን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ ዘቀጸላ፡ ሞገስ፡ ትርሲቱ፨</t:l>
                  <t:l n="2">ወለሥዕርትኪ፡ ሥዉጥ፡ ዘቅብአ፡ ቅዳሴ፡ ውስቴቱ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ እምነ፡ ትንብልናኪ፡ ንፈቱ፨</t:l>
                  <t:l n="4">ከመ፡ ያድኅነነ፡ እምትንሣኤ፡ አፅራር፡ ሠለስቱ፨</t:l>
                  <t:l n="5">እስመ፡ መሪራን፡ ፈድፋደ፡ እሙንቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለርእስኪ፡ ወለገጽኪ፡ ስቡሐ፨</t:l>
                  <t:l n="2">እምብርሃናቲሁ፡ ለሰማይ፡ ዘአስተርአየ፡ ብዙኃ፨</t:l>
                  <t:l n="3">ሥርጉተ፡ ኵለንታ፡ ለጴጥሮስ፡ ወለቱ፡ ዘሃይማኖት፡ እልታኃ፨</t:l>
                  <t:l n="4">አዕርጊ፡ ስእለተነ፡ ሠርከ፡ ወነግሀ፨</t:l>
                  <t:l n="5">ኀበ፡ አምላክኪ፡ ማዕሠሮ፡ ለሰይጣን፡ ዘፈትሐ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለቀራንብትኪ፡ ሕማማተ፡ አንብዕ፡ እለ፡ ጾሩ፨</t:l>
                  <t:l n="2">ወለአዕይንትኪ፡ ሥነ፡ እንተ፡ ኀበ፡ አምላክ፡ ነጸሩ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ፍትሕኒ፡ ለጌጋይ፡ እማዕሠሩ፨</t:l>
                  <t:l n="4">ወአርትዒ፡ አእጋርየ፡ ፍኖተ፡ ንስሐ፡ ይሑሩ፨</t:l>
                  <t:l n="5">ቅድመ፡ ይዳደቀኒ፡ ሞት፡ ዘፀዋግ፡ ኅብሩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለአዕዛንኪ፡ ሰማዕያተ፡ ዜና፡ በቋዒ፨</t:l>
                  <t:l n="2">ወለመላትሕኪ፡ ሱቱፍ፡ ጽፍዐተ፡ አምላክ፡ ተሰበኢ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ኀቤነ፡ ሶበ፡ ንጼውዐኪ፡ ንዒ፨</t:l>
                  <t:l n="4">አጋንንተ፡ ወመናፍስተ፡ ኢይጽብኡነ፡ ትጽብኢ፨</t:l>
                  <t:l n="5">በሰይፈ፡ አፉኪ፡ ሱራፌል፡ ሠዋዒ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለአእናፍኪ፡ አብያተ፡ ቅታሬ፡ ዘአንክሮ፨</t:l>
                  <t:l n="2">ወለከናፍርኪ፡ አቅመ፡ እለ፡ ሠርዑ፡ ለተናግሮ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ በረዊጽ፡ ዮሐንስ፡ ዘበደሮ፨</t:l>
                  <t:l n="4">ይትፋለስ፡ መንገሌየ፡ እመንገሌኪ፡ አእምሮ፨</t:l>
                  <t:l n="5">ለአእምሮትየሰ፡ ዝንጋዔ፡ ሠወሮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአፉኪ፡ መፈክረ፡ ሐዲስ፡ ቀኖና፨</t:l>
                  <t:l n="2">ወለአስናንኪ፡ ሰሐቀ፡ ዘመስተሣልቃን፡ መነና፨</t:l>
                  <t:l n="3">መስተፍሥሒ፡ አልባብ፡ ድምፅኪ፡ ፈድፋደ፡ እምወይነ፡ ቃና፨</t:l>
                  <t:l n="4">ሶበ፡ ተኀትመ፡ ጊዜ፡ ሞት፡ ወለተ፡ ጴጥሮስ፡ ዘዮና፨</t:l>
                  <t:l n="5">ቤተ፡ ክርስቲያን፡ በልብሰ፡ ላሕ፡ ገልበበት፡ ኅሊና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለልሳንኪ፡ ዘኢያንተገ፡ ጸልዮ፨</t:l>
                  <t:l n="2">ወለመዓርዒር፡ ቃልኪ፡ አርጋኖነ፡ ስብሐት፡ ወተጋንዮ፨</t:l>
                  <t:l n="3">በእንተ፡ ኢየሱስ፡ ክርስቶስ፡ ዘተሦዓ፡ በቀራንዮ፨</t:l>
                  <t:l n="4">ኢኃሠሥኪ፡ ወርቀ፡ ወብሩረ፡ ወለተ፡ ጴጥሮስ፡ አጥርዮ፨</t:l>
                  <t:l n="5">እስከ፡ ለመስሐቲ፡ መልአክ፡ ድንጋፄ፡ አድወዮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለእስትንፋስኪ፡ ዘመዓዛሁ፡ ስሒነ፨</t:l>
                  <t:l n="2">ወለጕርዔኪ፡ ዘየብሳ፡ እምአጥልሎተ፡ ማይ፡ ወወይን፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ይብሉኪ፡ መላእክተ፡ ሰማይ፡ ኄራን፨</t:l>
                  <t:l n="4">ሚይሤኒ፡ እኅትነ፡ ዘተውህበኪ፡ ብፅዓን፨</t:l>
                  <t:l n="5">ወዕሤትኒ፡ ዘኢርእየ፡ ዓይን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ ለክሳድኪ፡ በሀብለ፡ ትሕትና፡ ዘተስሕበ፨</t:l>
                  <t:l n="2">ወለመታክፍትኪ፡ ዘጾረ፡ አርዑተ፡ ምንዳቤ፡ ዕጹበ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ምልዒ፡ ውስተ፡ ልብየ፡ ጥበበ፨</t:l>
                  <t:l n="4">እንበለ፡ ጥበብሰ፡ ሶበ፡ ተመሰልኩ፡ ርግበ፨</t:l>
                  <t:l n="5">ኢያበውሐኒ፡ አምላክኪ፡ እትዋረስ፡ መዝገበ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለዘባንኪ፡ መዋጥሐ፡ ትፍግዕት፡ ዘመነነ፨</t:l>
                  <t:l n="2">ወለእንግድዓኪ፡ ምርፋቅ፡ ለምስኪናን፡ ዘኮነ፨</t:l>
                  <t:l n="3">መፍቀሪተ፡ ጸሎት፡ ወጾም፡ ወለተ፡ ጴጥሮስ፡ እምነ፨</t:l>
                  <t:l n="4">ትተንብሊ፡ ቅድመ፡ አምላክ፡ ስርየተ፡ ኃጢአት፡ ለነ፨</t:l>
                  <t:l n="5">ናስተበቍዓኪ፡ እሊአኪ፡ ንሕነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለሕፅንኪ፡ ሕፅነ፡ ምንኵስና፡ ክቡር፨</t:l>
                  <t:l n="2">ወለአእዳውኪ፡ ዘሰፍሓ፡ ለምሒረ፡ ኵሉ፡ ግዩር፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ አክሊላ፡ ለያዕቆባዊት፡ ማኅበር፨</t:l>
                  <t:l n="4">ይዌድሱኪ፡ አእላፍ፡ ተዓይነ፡ ሰማይ፡ ወምድር፨</t:l>
                  <t:l n="5">በጽምፀ፡ ማኅሌት፡ ሠናይ፡ ወሐዋዝ፡ ምዝሙር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለመዛርእኪ፡ ወለኵርናዕኪ፡ ምስማክ፨</t:l>
                  <t:l n="2">ዘኢተእኅዙ፡ ፍጹመ፡ በማእሰረ፡ ጌጋይ፡ ድሩክ፨</t:l>
                  <t:l n="3">ወለጥተ፡ ጴጥሮስ፡ ማርታ፡ መፍቀሪተ፡ ክርስቶስ፡ አምላክ፨</t:l>
                  <t:l n="4">ተከድነ፡ ልብሰ፡ ኀፍረት፡ በዕብሬትኪ፡ መልአክ፨</t:l>
                  <t:l n="5">ለአዳም፡ ዘአውደቆ፡ እምሣልስ፡ ፈለክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰላም፡ ለእመታትኪ፡ ለተገብሮ፡ ጽድቅ፡ ዘተኃየላ፨</t:l>
                  <t:l n="2">ወለእራኅኪ፡ ብሩህ፡ እምስነ፡ ኦርያሬስ፡ ወእብላ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ተንብሊ፡ ኀበ፡ ማርያም፡ ርግበ፡ ገሊላ፨</t:l>
                  <t:l n="4">ትተንብል፡ በእንቲአነ፡ እመድኃኔ፡ ዓለም፡ እጓላ፨</t:l>
                  <t:l n="5">ከመ፡ ይዕቀበነ፡ እመርቅያን፡ ተኵላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለአፃብዕኪ፡ አዕጹቀ፡ ተቅዋም፡ እድ፨</t:l>
                  <t:l n="2">ወለአርእስቲሆን፡ አጽፋር፡ ዘኅብረ፡ እማንቱ፡ በረድ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ወራውሬ፡ ወዕብነ፡ መረግድ፨</t:l>
                  <t:l n="4">ጥበበ፡ እምተግሣፅኪ፡ አጥረየ፡ አብድ፨</t:l>
                  <t:l n="5">ወሀብተ፡ ሚጠት፡ ብዙኃን፡ እምካህድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለአጥባትኪ፡ ዘሐሊበ፡ ጽጋ፡ አንቅዕት፨</t:l>
                  <t:l n="2">ወኢይውኅዶን፡ ምሕረት፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ መበይን፡ በከፈረ፡ ሞት፨</t:l>
                  <t:l n="4">ጊዜ፡ ተስወርኪ፡ ማኅቶትነ፡ መብርህት፨</t:l>
                  <t:l n="5">ውስተ፡ ገጸ፡ የማን፡ ወፀጋም፡ ሰፈነ፡ ጽልመት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለገቦኪ፡ ሥርግወ፡ ዘወርቅ፡ ሐመልማል፨</t:l>
                  <t:l n="2">ወለከርሥኪ፡ መዝገቡ፡ ለባሕርየ፡ ወንጌል፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ እምሰራ፡ ልዕልተ፡ ዝክር፡ ወገድል፨</t:l>
                  <t:l n="4">ይጸልላኒ፡ አክናፍኪ፡ ከመ፡ ጸለላ፡ በሐቅል፨</t:l>
                  <t:l n="5">ለደብተራ፡ ስምዕ፡ ደመና፡ ቀሊል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለልብኪ፡ ወለኵልያትኪ፡ ንስቲተ፨</t:l>
                  <t:l n="2">ዘኢያሥረጹ፡ ዐመፃ፡ ወኢዘገቡ፡ ጽልሑተ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ፈትቲ፡ ኅብስተ፡ በረከት፡ ሊተ፨</t:l>
                  <t:l n="4">ህየንተ፡ አቅረብኩ፡ ፍሬ፡ ከናፍር፡ ማኅሌተ፨</t:l>
                  <t:l n="5">ለዕበይኪ፡ ዘአልቦ፡ መስፈርተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ሰላም፡ ለሕሊናኪ፡ ስቅለተ፡ ፈጣሪ፡ ዘሐለየ፨</t:l>
                  <t:l n="2">ወለአማዑትኪ፡ ህቀ፡ ዘኢቈጸረ፡ እከየ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ በልኒ፡ እንዘ፡ ይሰምዑ፡ ሕዝብየ፨</t:l>
                  <t:l n="4">ማኅደረ፡ በሰማያት፡ ከመ፡ ተሀሉ፡ ምስሌየ፨</t:l>
                  <t:l n="5">እስመ፡ አስተዳለውኩ፡ ለከ፡ ኢትኅዝን፡ ወልድየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="20">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለንዋየ፡ ውስጥኪ፡ ኅቡእ፨</t:l>
                  <t:l n="2">ወለኅንብርትኪ፡ ዘአፍአ፡ ከመ፡ ዓይነ፡ ማኅተም፡ ልኩዕ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ኤልሳቤጥ፡ ወላዲተ፡ መጥምቅ፡ ብፁዕ፨</t:l>
                  <t:l n="4">ያስተበፅዑኪ፡ ነገደ፡ መላእክት፡ ወሰብእ፨</t:l>
                  <t:l n="5">እለ፡ ሡሩራን፡ እምጾታ፡ አርባዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="21">
                  <t:l n="1">ሰላም፡ ለማኅፀንኪ፡ ከመ፡ አስካለ፡ ወይን፡ ዘሐረግ፨</t:l>
                  <t:l n="2">ዘፈረየ፡ ፍሬ፡ እንተ፡ ቅድስና፡ ወሕግ፨</t:l>
                  <t:l n="3">ለርኡስ፡ ርኡሳን፡ ጴጥሮስ፡ ወለቱ፡ እንበለ፡ ነቲግ፨</t:l>
                  <t:l n="4">አንቲ፡ ወሲኖዳ፡ ወጻድቃነ፡ ወጺፍ፡ አዕሩግ፨</t:l>
                  <t:l n="5">መጽርየ፡ በረከት፡ ላዕሌነ፡ ነስንሱ፡ በደርግ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="22">
                  <t:l n="1">ሰላም፡ ለሐቌኪ፡ በአብዝኆ፡ ጸዊም፡ ዘደግደገ፨</t:l>
                  <t:l n="2">ወለአቍያጽኪ፡ አዕማድ፡ እለ፡ ይትሌለያ፡ ዘውገ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ አብርሂ፡ ዓይነ፡ ልቡናየ፡ ሕሙገ፨</t:l>
                  <t:l n="4">ከመ፡ እነጽርኪ፡ እንዘ፡ ይቀውሚ፡ ደርገ፨</t:l>
                  <t:l n="5">ምስለ፡ ማኅበረ፡ በኵር፡ ፍሡሓን፡ ዘሠለጡ፡ ሕገ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለአብራክኪ፡ እለ፡ አዝለፋ፡ አስተብርኮ፨</t:l>
                  <t:l n="2">ወለሐዋርያት፡ ሰላም፡ አእጋርኪ፡ ፍና፡ ተልእኮ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ዕቀቢ፡ ማኅበረ፡ ደቂቅኪ፡ እምተሐውኮ፨</t:l>
                  <t:l n="4">ለሰይጣንሰ፡ ዘኢያፈቅር፡ ተዓርኮ፨</t:l>
                  <t:l n="5">መሣግሪሁ፡ ብትኪ፡ ወስብሪ፡ ሦኮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለሰኳንውኪ፡ ምስለ፡ መከየድ፡ ዘቆሙ፨</t:l>
                  <t:l n="2">ኅብስተ፡ አሰርፎ፡ እምጻማ፡ እንዘ፡ ይጸውሙ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ጥቅዒ፡ መጥቅዓ፡ ስእለት፡ ለለጌሠሙ፨</t:l>
                  <t:l n="4">ለእለ፡ አመነ፡ ያዕቆባውያን፡ በስሙ፨</t:l>
                  <t:l n="5">ቤዛ፡ ኃጣውኢነ፡ ይኩን፡ ለክርስቶስ፡ በደሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለአፃብዓ፡ እግርኪ፡ ኃምስ፡ ክዑባት፡ በኈልቆ፨</t:l>
                  <t:l n="2">ወለአጽፋርኪ፡ ዐሥር፡ እለ፡ ይነብራ፡ በተላጽቆ፨</t:l>
                  <t:l n="3">ወለተ፡ አረጋይ፡ ጴጥሮስ፡ ቅረቢ፡ እምተራኅቆ፨</t:l>
                  <t:l n="4">ለትኩዝ፡ ብእሲ፡ ከመ፡ ትፈጽሚ፡ ጻሕቆ፨</t:l>
                  <t:l n="5">ወለጻድቅ፡ ትባርኪ፡ ጽድቆ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለቆምኪ፡ ሥነ፡ ቄድሮስ፡ ኅሩይ፨</t:l>
                  <t:l n="2">ወለመልክእኪ፡ ሰላም፡ ወላዲ፡ ፍሥሐ፡ ፀሓይ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ሀቢ፡ ተውላጠ፡ ዝንቱ፡ ንዋይ፨</t:l>
                  <t:l n="4">ፍተ፡ በረከት፡ በቅድመ፡ ጉባኤ፡ ዓባይ፨</t:l>
                  <t:l n="5">እምበረከትኪ፡ ዘጥቀ፡ ሠናይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለፀአተ፡ ነፍስኪ፡ በጣዕመ፡ ዝማሬ፡ ሐዋዝ፨</t:l>
                  <t:l n="2">ወለበድነ፡ ሥጋኪ፡ ጽዱል፡ እምጸዳለ፡ ባሕርይ፡ እንቡዝ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ጠባብ፡ ወሠናይተ፡ ግዕዝ፨</t:l>
                  <t:l n="4">ለለይሠርቁ፡ ምዕዛራተ፡ ዝክርኪቤዝ፨</t:l>
                  <t:l n="5">እምልበ፡ ብእሲ፡ ኅዙን፡ ይትረሣዕ፡ ትካዝ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋኪ፡ ዘትሩፈ፡ ትሩፍ፡ ዕበዩ፨</t:l>
                  <t:l n="2">ወለመቃብርኪ፡ ምስካይ፡ ለእለ፡ ቦቱ፡ ሰከዩ፨</t:l>
                  <t:l n="3">ወለተ፡ ጴጥሮስ፡ ቢረሌ፡ ለዕፍረተ፡ አሚን፡ ሙዳዩ፨</t:l>
                  <t:l n="4">ቅድሑ፡ ፈልፈለ፡ ሣህል፡ አባግዕኪ፡ ይርወዩ፨</t:l>
                  <t:l n="5">ጊዜ፡ አንበልበላ፡ ለመርቄ፡ ዋዕዩ፡</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ለቆብዕኪ፡ አክሊለ፡ ሦክ፡ ዲበ፡ ርእሰ፡ ክርስቶስ፡ ዘተሠይመ፨</t:l>
                  <t:l n="2">አመ፡ ሰቀልዎ፡ አይሁድ፡ ከመ፡ ይቤዙ፡ ዓለመ፨</t:l>
                  <t:l n="3">ወዓጽፈ፡ ንጽሕና፡ ዓጽፍኪ፡ ወአስኬማኪ፡ ቅድመ፨</t:l>
                  <t:l n="4">ለቅናትኒ፡ ወቀሚስ፡ ወለተ፡ ጴጥሮስ፡ ዳግመ፨</t:l>
                  <t:l n="5">ሰላም፡ ሰላም፡ እንዘ፡ እብል፡ ረሰይኩ፡ ማኅተመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ይትባረኩ፡ እግዚአብሔር፡ አምላከ፡ አማልክት፡ መላኪ፨</t:l>
                  <t:l n="2">ዘባሕርይሁ፡ ብርሃን፡ ዘመልዕልተ፡ ብርሃናት፡ ያዋኪ፨</t:l>
                  <t:l n="3">እስመ፡ ዐቀበኒ፡ ሊተ፡ እመሥገርተ፡ ሰይጣን፡ ሐዋኪ፨</t:l>
                  <t:l n="4">ወአፈጸመኒ፡ ወለተ፡ ጴጥሮስ፡ ወልድኪ፨</t:l>
                  <t:l n="5">ማኅሌተ፡ ዝክርኪ፡ ዘወጠንኩ፡ ለኪ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለኪ፡ ወለተ፡ ጴጥሮስ፡ ገነት፡ ክልልተ፡ መዓዛ፡ ጥዑም፨</t:l>
                  <t:l n="2">ወምጽላለ፡ አርጋብ፡ አንቲ፡ እመርቁ፡ ሕማም፨</t:l>
                  <t:l n="3">ዘሰፈነት፡ ውስተ፡ ዓለም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለኪ፡ ወለተ፡ ጴጥሮስ፡ መጽሒት፡ ሃይማኖተ፡ ሥሉስ፡ ቅዱስ፨</t:l>
                  <t:l n="2">ዘተከሥተ፡ ልኪ፡ ለዘነብ፡ ወርእስ፨</t:l>
                  <t:l n="3">ኅዱራን፡ መልዕልተ፡ የብስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለኪ፡ ወለተ፡ ጴጥሮስ፡ ብርሃን፡ ስብከትከ፡ አመ፡ ውስተ፡ ጽልመት፡ አብርሃ፨</t:l>
                  <t:l n="2">ለመክፈልተ፡ አብዳን፡ ዓለም፡ አእርክቲሃ፨</t:l>
                  <t:l n="3">ተባደሩ፡ ኀበ፡ ንስሐ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለኪ፡ ዘዓይን፡ ኢርእየ፡ ወእዝን፡ ኢሰምዓ፨</t:l>
                  <t:l n="2">ከመ፡ ትረስዪ፡ ትርሲተ፡ መርዓ፨</t:l>
                  <t:l n="3">ገደፍኪ፡ ሠርጐ፡ ፍግዓ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለኪ፡ ምስለ፡ ሲኖዳ፡ አቡኪ፡ ሥርግወ፡ ሎግዮን፡ ድንጋሌ፨</t:l>
                  <t:l n="2">ለናዝዞትየ፡ ንዒ፡ እምኀዘን፡ ወይሌ፨</t:l>
                  <t:l n="3">ወሐውጺ፡ ከመ፡ ውላውሌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለኪ፡ ወለተ፡ ጴጥሮስ፡ እምነ፡ ተኃየልኪ፡ ለበዊአ፡ ጽባብ፡ ምሕላፍ፨</t:l>
                  <t:l n="2">ከመ፡ ተኃየሉ፡ ቅድመ፡ ሰማዕታት፡ አእላፍ፨</t:l>
                  <t:l n="3">ወጻድቃን፡ እለ፡ ወጺፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለኪ፡ ሞገሰ፡ ረድኤትኪ፡ ኃይል፡ ወለተ፡ ጴጥሮስ፡ ሱላሜ፨</t:l>
                  <t:l n="2">እመከራ፡ ሰይጣን፡ ወሰብእ፡ በኢፍጻሜ፨</t:l>
                  <t:l n="3">ይክድነኒ፡ አምሳለ፡ ጊሜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለኪ፡ ረድኤትኪ፡ ፀወን፡ እንዘ፡ ንሬስዮ፡ አረፍተ፨</t:l>
                  <t:l n="2">መራዕየ፡ ረሲዓን፡ አጽራር፡ ኢንፈርህ፡ ምንተ፨</t:l>
                  <t:l n="3">ጊዜ፡ ሠርዑ፡ ተቃውሞተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለደቂቅኪ፡ አኃው፡ ወለኵሎን፡ አሐት፨</t:l>
                  <t:l n="2">ቅድመ፡ ገጸ፡ አምላክ፡ ተንብሊ፡ እንበለ፡ ጽርዓት፨</t:l>
                  <t:l n="3">ኢይባኡ፡ ውስተ፡ መንሱት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ ለኪ፡ እመሣግሪሁ፡ አምሰጥኪ፡ ለአርዌ፡ ዓመፃ፡ መስገሪ፨</t:l>
                  <t:l n="2">አረቦን፡ መዊእ፡ መስቀለ፡ እንዘ፡ ትጸውሪ፨</t:l>
                  <t:l n="3">ዘጾርዎ፡ እለ፡ መቃሪ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለኪ፡ ወለተ፡ ጴጥሮስ፡ አዕርሂ፡ ዕጣነ፡ ማኅሌተነ፡ ዝንቱ፨</t:l>
                  <t:l n="2">እምእንስሳ፡ ሰማይ፡ አርባዕቱ፨</t:l>
                  <t:l n="3">ኀበ፡ ይትቄደሱ፡ አካላት፡ ሠለስቱ፨</t:l>
                  <t:l n="4">በማዕጠንት፡ ዘብርሃን፡ ግብረቱ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>         
      </t:body>
   </t:text></TEI>