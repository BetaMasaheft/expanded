            <t:div type="textpart" xml:id="Epistle">
               <t:label>Epistle</t:label>
               
               <t:note>Text of the EOTC printed Bible</t:note>
               <t:div type="textpart" subtype="chapter" n="1" xml:id="ch1">
                  <t:label>ምዕራፍ 1</t:label>
                  <t:ab>
                     <t:l>በከመ፡ ይደሉ፡ ከዊነ፡ አርአያ፡ ለአኀው</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=1"/>እምጳውሎስ፡ ወስልዋኖስ፡ ወጢሞቴዎስ፡ ለቤተ፡ ክርስቲያን፡ ዘተሰሎንቄ። ምእመናን፡ በእግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=2"/>ነአኵቶ፡ ለእግዚአብሔር፡ ዘልፈ፡ በእንቲኣክሙ፡ ወንዜክረክሙ፡ ወትረ፡ በጸሎትነ።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=3"/>ወንዜክር፡ በቅድመ፡ እግዚአብሔር፡ አቡነ፡ ግብረ፡ ሃይማኖትክሙ። ወጽንዐ፡ ፍቅርክሙ፡ ወትዕግሥተ፡ ተስፋክሙ፡ በእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=4"/>ወነአምር፡ አኀዊነ፡ ፍቁራን፡ ዘከመ፡ ኀረየክሙ፡ እግዚአብሔር።</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=5"/>እስመ፡ ኢኮነ፡ ትምህርትነ፡ ኀቤክሙ፡ በነገር፡ ባሕቲቱ። ዓዲ፡ በኀይልኒ፡ ወበመንፈስ፡ ቅዱስ፡ ወበስኢል፡ ምእመን። ወአንትሙሂ፡ ተአምሩ፡ ዘከመ፡ ኮነ፡ በኀቤክሙ፡ በእንቲኣክሙ።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=6"/>ወናሁ፡ ኪያነ፡ ተመሰልክሙ፡ ወተወከፍክሙ፡ ቃለ፡ እግዚአብሔር። በብዙኀ፡ ሕማም፡ ምስለ፡ ፍሥሓ፡ በመንፈስ፡ ቅዱስ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=7"/>ወኮንክምዎሙ፡ አርአያ፡ ለእለ፡ አምኑ፡ ኵሎሙ፡ እለ፡ በመቄዶንያ፡ ወአካይያ።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=8"/>እስመ፡ እምኀቤክሙ፡ ተምህሩ፡ ቃለ፡ እግዚእነ፡ ወሰምዑ። ወአኮ፡ በመቄዶንያ፡ ወአካይያ፡ ባሕቲቱ። ዓዲ፡ በኵሉ፡ በሓውርት፡ ተሰምዐት፡ ሃይማኖትክሙ፡ በእግዚአብሔር። ወኢንፈቅድ፡ ንሕነ፡ ምንተኒ፡ ንንግር፡ በእንቲኣክሙ።</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=9"/>ለሊሆሙ፡ የአምሩ፡ ዘከመ፡ ቦእነ፡ ኀቤክሙ። ወዘከመ፡ ተመየጥክሙ፡ ኀበ፡ እግዚአብሔር፡ እምአምልኮ፡ ጣዖት። ከመ፡ ትትቀነዩ፡ ለአምላክ፡ ሕያው፡ ወጻድቅ።</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=1&amp;verse=10"/>እንዘ፡ ትሴፈውዎ፡ ለወልዱ፡ እምሰማያት። ዘተንሥአ፡ እምዉታን፡ ኢየሱስ፡ ክርስቶስ። ወውእቱ፡ ያድኅነነ፡ እመንሱት፡ ዘይመጽእ።</t:l>
                  </t:ab>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="2" xml:id="ch2">
                  <t:label>ምዕራፍ 2</t:label>
                  <t:ab>
                     <t:l>በእንተ፡ ምሂር፡ በተየውሆ</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=1"/>ለሊክሙ፡ ተአምሩ፡ አኀዊነ፡ ዘከመ፡ ገበርነ፡ ለክሙ። ወኢኮነ፡ በከንቱ፡ በዊኦትነ፡ ኀቤክሙ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=2"/>ዳእሙ፡ ሐመምነ፡ ወተጽእልነ፡ ዘከመ፡ ተአምሩ፡ በፊልጵስዩስ። ወአሜሃ፡ ነገርናክሙ፡ በብዙኅ፡ ጻማ፡ ትምህርተ፡ ክርስቶስ፡ በሞገሱ፡ ለአምላክነ።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=3"/>እስመ፡ ኢኮነ፡ ትምህርትነ፡ ዘስሒት፡ ወኢ፡ ዘርኩስ፡ ወኢኮነ፡ ዘጽልሑት።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=4"/>ዳእሙ፡ በዘአመከረነ፡ እግዚአብሔር፡ ወተአመነነ፡ በትምህርተ፡ ወንጌሉ። ከማሁ፡ ንነግር፡ ወአኮ፡ ከመ፡ ዘለሰብእ፡ ያደሉ። ዘእንበለ፡ ለእግዚአብሔር፡ ዘአመከረነ፡ ልበነ።</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=5"/>ወእምአመ፡ ኮነ፡ ኢየዋህናክሙ፡ በቃል፡ በከመ፡ ተአምሩ። ወኢተዐገልናክሙ፡ በምክንያት፡ ስምዕነ፡ እግዚአብሔር፡ በዝንቱ።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=6"/>ወኢንፈቅድ፡ ያድሉ፡ ለነ፡ ሰብእ፡ ኢ፡ አንትሙ፡ ወኢ፡ ባዕድ። እንዘ፡ ንክል፡ አክብዶ፡ ከመ፡ ሐዋርያተ፡ ክርስቶስ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=7"/>ዳእሙ፡ ኮነ፡ ከመ፡ ሕፃናት፡ በማእከሌክሙ። ወከመ፡ ሐፃኒት፡ እንተ፡ ተሐዝል፡ ደቂቃ።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=8"/>ከማሁ፡ ንሕነኒ፡ ናፈቅረክሙ፡ ወንጽሕቅ፡ ለክሙ፡ ከመ፡ ንመጡክሙ። ወአኮ፡ ባሕቲቶ፡ ወንጌለ፡ እግዚአብሔር፡ ዓዲ፡ ነፍሰነሂ፡ እስመ፡ ፍቁራነ፡ ኮንክሙነ።</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=9"/>ወተዘከሩ፡ አኀዊነ፡ ጻማነ፡ ወሥራሐነ፡ መዓልተ፡ ወሌሊተ። ኮነ፡ ንትጌበር፡ ከመ፡ ኢናክብድ፡ ላዕለ፡ አሐዱሂ፡ እምውስቴትክሙ።</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=10"/>ወለሊክሙ፡ ሰማዕትነ፡ ወእግዚአብሔር፡ ዘከመ፡ ሰበክነ፡ ለክሙ፡ ትምህርተ፡ ወንጌሉ፡ ለእግዚአብሔር፡ በጽድቅ። ወበርትዕ፡ ወበንጽሕ፡ በኀበ፡ ኵሎሙ፡ እለ፡ የአምኑ።</t:l>
                     <t:l n="11">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=11"/>ዘከመ፡ ተአምሩ፡ ለለ፡ አሐዱ፡ እምውስቴትክሙ። ከመ፡ አብ፡ ለወልዱ፡ ናስተበቊዐክሙ፡ ወንናዝዘክሙ።</t:l>
                     <t:l n="12">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=12"/>ወናሰምዕ፡ ለክሙ፡ ከመ፡ ትሑሩ፡ ወትሩጹ፡ በዘይደልወክሙ፡ ለኀበ፡ እግዚአብሔር። ዘጸውዐክሙ፡ ውስተ፡ መንግሥተ፡ ስብሐቲሁ።</t:l>
                     <t:l>በእንተ፡ ተወክፎተ፡ ቃል፡ ዘእግዚአብሔር</t:l>
                     <t:l n="13">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=13"/>በእንተ፡ ዝ፡ ንሕነሂ፡ ዘልፈ፡ ነአኵቶ፡ ለእግዚአብሔር። እስመ፡ ተወከፍክሙ፡ ቃለ፡ ትእዛዙ፡ ለእግዚአብሔር። ወአኮ፡ ቃለ፡ ዜና፡ ሰብእ፡ አላ፡ አማን፡ ከማሁ፡ ቃለ፡ እግዚአብሔር። ወይረድአክሙሂ፡ በገቢር፡ ለእለ፡ ተአመንክሙ።</t:l>
                     <t:l n="14">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=14"/>ወአንትሙ፡ አኀዊነ፡ ተመሰልክሙ፡ በቤተ፡ ክርስቲያኑ፡ ለእግዚአብሔር። እለ፡ በይሁዳ፡ ምእመናን፡ በኢየሱስ፡ ክርስቶስ። እስመ፡ ሐመምክሙ፡ አንትሙሂ፡ እምሕዝብክሙ። በከመ፡ ሐሙ፡ እሙንቱሂ፡ እምአይሁድ። እለ፡ ቀተልዎ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="15">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=15"/>ወለነቢያቲሂ፡ እለ፡ እምውስቴቶሙ፡ ሰደድዎሙ። ወኪያነሂ፡ ወኢያሠምርዎ፡ ለእግዚአብሔር፡ ወይትቃረኑ፡ ምስለ፡ ኵሉ፡ ሰብእ።</t:l>
                     <t:l n="16">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=16"/>ወይከልኡነ፡ ኢንንግር፡ ለአሕዛብ፡ በዘየሐይዉ፡ ከመ፡ ይትፈጸሞሙ፡ ኀጢአቶሙ፡ ለዝሉፉ። ወናሁ፡ በጽሖሙ፡ መቅሠፍቶሙ፡ ዘለዓለም።</t:l>
                     <t:l>በእንተ፡ አዘክሮተ፡ ፍቅር</t:l>
                     <t:l n="17">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=17"/>ወንሕነሰ፡ አኀዊነ፡ ከመ፡ ዕጓለ፡ ማውታ፡ ኮነ፡ እምኔክሙ፡ በዝ፡ መዋዕል፡ ለገጽ፡ ዳእሙ፡ ወአኮሰ፡ እምልብ። ወፈድፋደ፡ ጽሕቅነ፡ ንርአይ፡ ገጸክሙ።</t:l>
                     <t:l n="18">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=18"/>ወብዙኀ፡ ፈቀድኩ፡ እምጻእ፡ ኀቤክሙ፡ ለልየ፡ ጳውሎስ፡ ምዕረ። ወካዕበ፡ ወአዕቀፈኒ፡ ሰይጣን።</t:l>
                     <t:l n="19">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=19"/>መኑ፡ ተስፋነ፡ ወፍሥሓነ፡ ወአክሊለ፡ ምክሕነ። አኮኑ፡ አንትሙ፡ በቅድመ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በምጽአቱ።</t:l>
                     <t:l n="20">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=2&amp;verse=20"/>እስመ፡ አንትሙ፡ ክብርነ፡ ወፍሥሓነ።</t:l>
                  </t:ab>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="3" xml:id="ch3">
                  <t:label>ምዕራፍ 3</t:label>
                  <t:ab>
                     <t:l>ዘከመ፡ ኢይደሉ፡ ቀቢጸ፡ ተስፋ</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=1"/>ወስኢነነ፡ ተዐግሦ፡ አብደርነ፡ ንንበር፡ አቴና፡ አሐተኔ፡ ባሕቲተነ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=2"/>ወፈነውናሁ፡ ለጢሞቴዎስ፡ እኁነ፡ ላእከ፡ እግዚአብሔር፡ ወረድኤትነ፡ በትምህርተ፡ ክርስቶስ። ከመ፡ ያጽንዕክሙ፡ ወያስተብቊዕክሙ፡ በእንተ፡ ሃይማኖትክሙ።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=3"/>ከመ፡ ኢታንቀልቅሉ፡ ወኢይቅብጽ፡ አሐዱሂ፡ እምውስቴትክሙ፡ በዛቲ፡ ሕማምክሙ። ተአምሩ፡ ለሊክሙ፡ ከመ፡ ዝንቱ፡ ዳእሙ፡ ይጸንሐነ።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=4"/>ወአመ፡ ሀሎኩ፡ ኀቤክሙ፡ ዘንተ፡ ክመ፡ አቅደምኩ፡ ወነገርኩክሙ። ከመ፡ ሀለወነ፡ ንሕምም፡ ወይሣቅዩነ። ወበከመ፡ አመርናክሙ፡ ኮነ፡ ውእቱ።</t:l>
                     <t:l>በእንተ፡ ሐውጾ፡ አርድእት፡ በላእካን</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=5"/>ወበእንተ፡ ዝ፡ አነሂ፡ ስኢንየ፡ ተዐግሦ፡ ፈነውኩ፡ ጢሞቴዎስሃ። ከመ፡ አእምር፡ ሃይማኖተክሙ። እመ፡ ቦ፡ ከመ፡ አመከርክሙ፡ ዘያሜክር። ወለከንቱ፡ ይከውን፡ ጻማነ፡ ዘበእንቲኣክሙ።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=6"/>ወይእዜሰ፡ እምአመ፡ በጽሐ፡ ጢሞቴዎስ፡ ኀቤነ፡ እምኀቤክሙ። ወዜነወነ፡ ሃይማኖተክሙ፡ ወተፋቅሮተክሙ፡ ወከመሂ፡ ትዜክሩነ፡ በሠናይ፡ ዘልፈ። ወትፈትዉ፡ ትርአዩነ፡ በከመ፡ ንፈቱ፡ ንሕነሂ፡ ርእዮተክሙ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=7"/>በእንተ፡ ዝ፡ ተፈሣሕነ፡ አኀዊነ፡ በእንተ፡ ኵሉ፡ ሕማምነ፡ ወምንዳቤነ፡ ዘበእንተ፡ ሃይማኖትክሙ።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=8"/>እስመ፡ ይእዜ፡ ነሐዩ፡ እምከመ፡ አንትሙ፡ ቆምክሙ፡ በእግዚእነ።</t:l>
                     <t:l>ጸሎተ፡ መምህራን፡ ኵሎ፡ ጊዜ</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=9"/>አየ፡ አኰቴተ፡ ንክል፡ ዐስዮቶ፡ ለእግዚአብሔር። ህየንተ፡ ኵሉ፡ ፍሥሓነ፡ ዘተፈሣሕነ፡ በእንቲኣክሙ። ዘእንበለ፡ ከመ፡ ንጸሊ፡ ኀበ፡ አምላክነ፡ መዓልተ፡ ወሌሊተ።</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=10"/>ወፈድፋደሰ፡ ንጼሊ፡ ከመ፡ ንርአይ፡ ገጸክሙ፡ ወይትፈጸም፡ ሕጸጸ፡ ሃይማኖትክሙ።</t:l>
                     <t:l n="11">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=11"/>ወእግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ያርትዕ፡ ፍኖተነ፡ ኀቤክሙ።</t:l>
                     <t:l n="12">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=12"/>ወለክሙሂ፡ ያብዝኅ፡ ወያፈድፍድ፡ ተፋቅሮተክሙ፡ በበይናቲክሙ፡ ወምስለ፡ ኵሉ፡ ለለ፡ አሐዱ። በከመ፡ ንሕነ፡ ናፈቅረክሙ፡ ለክሙ።</t:l>
                     <t:l n="13">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=3&amp;verse=13"/>ወይጽናዕ፡ ልብክሙ፡ በንጽሕ፡ ወበቅድሳት፡ ለቅድመ፡ እግዚአብሔር፡ አቡነ። አመ፡ ምጽአተ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ምስለ፡ ኵሎሙ፡ ቅዱሳን።</t:l>
                  </t:ab>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="4" xml:id="ch4">
                  <t:label>ምዕራፍ 4</t:label>
                  <t:ab>
                     <t:l>በእንተ፡ ርኂቅ፡ እምዘዘ፡ ዚኣሁ፡ ፈቃደ፡ ሥጋ</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=1"/>ወይእዜኒ፡ አኀዊነ፡ ንነግረክሙ፡ ወናስተበቊዐክሙ፡ በእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ከመ፡ ተአዘዝክሙ፡ በኀቤነ፡ በዘይደሉ። ከመ፡ ትሑሩ፡ ወታሥምርዎ፡ ለእግዚአብሔር፡ ወበከመ፡ ሖርክሙ። ዓዲ፡ ከመ፡ ታብዝኁ፡ ወታፈድፍዱ፡ በዝንቱ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=2"/>ወተአምሩ፡ ዘከመ፡ አዘዝናክሙ፡ በእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=3"/>እስመ፡ ዝ፡ ውእቱ፡ ትእዛዙ፡ ለእግዚአብሔር። ወፈቃዱ፡ ተቀድሶትክሙ፡ ውእቱ፡ ወከመ፡ ትትዐቀቡ፡ ወትርሐቁ፡ እምዝሙት።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=4"/>ወያእምር፡ ኵሉ፡ ለለ፡ አሐዱ፡ ንዋዮ፡ ወያጥርዮ፡ በቅድሳት፡ ወክብር።</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=5"/>ወኢትትመንሰዉ፡ በፍትወት፡ ከመ፡ አረሚ፡ እለ፡ ኢየአምርዎ፡ ለእግዚአብሔር።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=6"/>ወኢትትሃበሉ፡ ትግበሩ፡ ዘንተ፡ ወኢትትዐበዩ፡ ወኢትትዐገሉ፡ ቢጸክሙ፡ በኵሉ። እስመ፡ መስተበቅል፡ እግዚአብሔር፡ በእንተ፡ ዝንቱ፡ ኵሉ። በከመ፡ አቅደምኩ፡ ነጊሮተክሙ፡ ወአስማዕኩ፡ ለክሙ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=7"/>እስመ፡ ኢጸውዐነ፡ እግዚአብሔር፡ ለርኩስ፡ ዘእንበለ፡ ለቅድሳት።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=8"/>ወይእዜኒ፡ ዘክሕደሰ፡ ለያእምር፡ ከመ፡ አኮ፡ ለሰብእ፡ ዘይክሕድ። ዘእንበለ፡ ለእግዚአብሔር፡ ዘወሀበክሙ፡ መንፈሰ፡ ቅዱሰ።</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=9"/>ወበእንተሰ፡ አፍቅሮ፡ ቢጽክሙ፡ ኢትፈቅዱ፡ ንጽሐፍ፡ ለክሙ። ለሊክሙ፡ ምሁራን፡ በኀበ፡ እግዚአብሔር፡ ከመ፡ ትትፋቀሩ፡ በበይናቲክሙ።</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=10"/>ወከማሁ፡ ትግበሩ፡ ዓዲ፡ ምስለ፡ ኵሎሙ፡ አኀዊክሙ፡ እለ፡ በኵሉ፡ መቄዶንያ።</t:l>
                     <t:l n="11">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=11"/>ወናስተበቊዐክሙ፡ አኀዊነ፡ ትብዝኁ፡ ወትፈድፍዱ፡ ከመ፡ ትኩኑ፡ የዋሃነ። ወትትገበሩ፡ ተግባረክሙ፡ ወትትቀነዩ፡ በእደዊክሙ፡ ዘከመ፡ አዘዝናክሙ።</t:l>
                     <t:l n="12">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=12"/>ከመ፡ ትሑሩ፡ በኂሩት፡ ለቅድመ፡ እለ፡ አፍኣ። ወኢ፡ ትጽሐቁ፡ ወኢ፡ ኀበ፡ መኑሂ።</t:l>
                     <t:l>ዘከመ፡ ኢይደሉ፡ ሐዘን፡ ዘቀቢጸ፡ ተስፋ</t:l>
                     <t:l n="13">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=13"/>ወንፈቅድ፡ ታእምሩ፡ አኀዊነ፡ በእንተ፡ እለ፡ ኖሙ። ከመ፡ ኢይደሉ፡ ትተክዙ፡ በላዕሌሆሙ፡ ከመ፡ ኵሉ፡ ሰብእ፡ እለ፡ ቅቡጻን፡ ተስፋሆሙ።</t:l>
                     <t:l n="14">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=14"/>ወእምከመሰ፡ ንትአመን፡ ከመ፡ ሞተ፡ ክርስቶስ፡ ወተንሥአ። ከማሁ፡ ያነሥኦሙ፡ እግዚአብሔር፡ ለምዉታን፡ በኢየሱስ፡ ወያመጽኦሙ፡ ምስሌሁ።</t:l>
                     <t:l n="15">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=15"/>ወዘንተ፡ ንነግረክሙ፡ በቃለ፡ እግዚአብሔር፡ ንሕነ፡ ሕያዋን። እለ፡ ንተርፍ፡ አመ፡ ምጽአተ፡ እግዚእነ፡ ኢንበጽሖሙ፡ ለምዉታን።</t:l>
                     <t:l n="16">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=16"/>እስመ፡ ይኤዝዝ፡ እግዚእነ፡ ምስለ፡ ሊቀ፡ መላእክት። ወንፍኀተ፡ ቀርን፡ ዘእግዚአብሔር፡ ዘይወርድ፡ እምሰማይ። ወይትነሥኡ፡ ምዉታን፡ መቅድመ፡ እለ፡ ሞቱ፡ በሃይማኖተ፡ ክርስቶስ።</t:l>
                     <t:l n="17">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=17"/>ወእምዝ፡ ንሕነ፡ እለ፡ ሕያዋን፡ እለ፡ ንተርፍ፡ ንትመሠጥ፡ በደመና፡ ምስሌሆሙ፡ ኅቡረ። ከመ፡ ንትቀበሎ፡ ለእግዚእነ፡ ውስተ፡ አየር። ወንሄሉ፡ እንከ፡ ዘልፈ፡ ኀበ፡ እግዚእነ።</t:l>
                     <t:l n="18">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=4&amp;verse=18"/>ወይእዜኒ፡ መሀሩ፡ ቢጸክሙ፡ ዘንተ፡ ነገረ።</t:l>
                  </t:ab>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="5" xml:id="ch5">
                  <t:label>ምዕራፍ 5</t:label>
                  <t:ab>
                     <t:l>በእንተ፡ ነገረ፡ ምጽአት</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=1"/>ወበእንተሰ፡ ዕድሜሁ፡ ወዕለቱ፡ ወጊዜሁ፡ አኀዊነ፡ ኢትፈቅዱ፡ ንጽሐፍ፡ ለክሙ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=2"/>ለሊክሙ፡ ተአምሩ፡ ጥዩቀ፡ ከመ፡ ዕለተ፡ እግዚእነ፡ ከመ፡ ምጽአተ፡ ሰራቂ፡ ሌሊተ። ከማሁ፡ ይከውን፡ ምጽአቱ።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=3"/>አመ፡ ይብሉ፡ እለ፡ ይክሕዱ፡ ኪያሁ፡ ከመ፡ ውስተ፡ ዳኅን፡ ወሰላም፡ እሙንቱ። ወህየ፡ ግብተ፡ ይመጽኦሙ፡ ተሠርዎ። ከመ፡ ፅንስት፡ እንተ፡ ይመጽኣ፡ ማሕምም፡ ወኢይክሉ፡ አምስጦ።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=4"/>ወአንትሙሰ፡ አኀዊነ፡ ኢሀለውክሙ፡ ውስተ፡ ጽልመት። ከመ፡ ይርከብክሙ፡ ውእቱ፡ ዕለት፡ ከመ፡ ሰራቂ።</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=5"/>እስመ፡ ኵልክሙ፡ ውሉደ፡ ብርሃን፡ አንትሙ፡ ወውሉደ፡ መዓልት። ወኢኮንክሙ፡ ውሉደ፡ ሌሊት፡ ወኢ፡ ውሉደ፡ ጽልመት።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=6"/>ወኢንኑም፡ እንከ፡ ከመ፡ እልኩ። አላ፡ ንንቃሕ፡ በኅሊናነ፡ ወንትጋህ፡ ወንጥበብ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=7"/>እስመ፡ እለ፡ ይነውሙ፡ ሌሊተ፡ ይነውሙ። ወእለሂ፡ ይሰክሩ፡ ሌሊተ፡ ይሰክሩ።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=8"/>ወንሕነሰ፡ እንዘ፡ ውሉደ፡ መዓልት፡ ንሕነ። ንንቃሕ፡ ወንልበስ፡ ልብሰ፡ ኀጺን፡ ዘሃይማኖት፡ ወዘተፋቅሮ። ወንትቀጸል፡ ጌራ፡ ተስፋ፡ መድኀኒት።</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=9"/>እስመ፡ ኢረሰየነ፡ እግዚአብሔር፡ ለመንሱት፡ ዘእንበለ፡ ለሕይወት፡ ወለመድኀኒት። በእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘሞተ፡ ለነ፡ ቤዛነ።</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=10"/>እመኒ፡ ንቁሓን፡ ንሕነ፡ ወእመኒ፡ ንዉማን፡ ምስሌሁ፡ ነሐዩ፡ ኵልነ።</t:l>
                     <t:l>በእንተ፡ ናዝዞተ፡ ቢጽ</t:l>
                     <t:l n="11">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=11"/>ወይእዜኒ፡ አስተፍሥሑ፡ ቢጸክሙ፡ በእንተ፡ ዝ። ወይሕንጽ፡ አሐዱ፡ ካልኦ፡ ዘከመ፡ ትገብሩ፡ ዓዲ።</t:l>
                     <t:l n="12">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=12"/>ወናስተበቊዐክሙ፡ አኀዊነ፡ ዑቅዎሙ፡ ለእለ፡ ይጻምዉ፡ በውስቴትክሙ። ወለእለ፡ ይቀውሙ፡ ለክሙ፡ በእንተ፡ እግዚእነ፡ ወይሜህሩክሙ።</t:l>
                     <t:l n="13">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=13"/>አክብርዎሙ፡ ፈድፋደ፡ ወአፍቅርዎሙ፡ በእንተ፡ ምግባሮሙ፡ ወተአምኅዎሙ።</t:l>
                     <t:l n="14">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=14"/>ወናስተበቊዐክሙ፡ አኀዊነ፡ ገሥጽዎሙ፡ ለዝሉፋን፡ ናዝዝዎሙ፡ ለሕዙናን። ጹርዎሙ፡ ለድኩማን፡ ወተዐገሡ፡ ላዕለ፡ ኵሉ።</t:l>
                     <t:l n="15">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=15"/>ዑቁ፡ ኢትግበሩ፡ እኩየ፡ ህየንተ፡ እኪት። አላ፡ ተባደሩ፡ ዘልፈ፡ ለሠናይ፡ በበይናቲክሙ፡ ወለኵሉሂ።</t:l>
                     <t:l>ዘከመ፡ ይደሉ፡ ጸልዮ፡ ለአኀው</t:l>
                     <t:l n="16">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=16"/>ተፈሥሑ፡ በኵሉ፡ ጊዜ፡ ወጸልዩ፡ ወትረ።</t:l>
                     <t:l n="17">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=17"/>አእኵትዎ፡ ለእግዚአብሔር፡ አብ፡ በእንተ፡ ኵሉ፡ ግብር።</t:l>
                     <t:l n="18">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=18"/>እስመ፡ ዝ፡ ውእቱ፡ ፈቃዱ፡ ለእግዚአብሔር፡ እምውስቴትክሙ፡ በኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="19">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=19"/>መንፈሰ፡ ኢታጥፍኡ።</t:l>
                     <t:l n="20">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=20"/>ወተነብዮ፡ ኢትመንኑ።</t:l>
                     <t:l n="21">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=21"/>ወኵሎ፡ አመክሩ፡ ወዘሠናይ፡ አጽንዑ።</t:l>
                     <t:l n="22">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=22"/>ወተገሐሡ፡ እምኵሉ፡ ምግባር፡ እኩይ።</t:l>
                     <t:l n="23">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=23"/>ወእግዚአብሔር፡ አምላከ፡ ሰላም፡ ይቀድስክሙ፡ ፍጹመ። ወያጥዒክሙ፡ ነፍሰክሙ፡ ወመንፈሰክሙ፡ ወሥጋክሙ፡ በንጽሕ። እስከ፡ ምጽአተ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="24">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=24"/>ወዘጸውዐክሙ፡ ጻድቅ፡ ውእቱ፡ ይግበር፡ ለክሙ፡ ዘንተ።</t:l>
                     <t:l n="25">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=25"/>ኦ፡ አኀዊነ፡ ጸልዩ፡ ለነ።</t:l>
                     <t:l n="26">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=26"/>አምኁ፡ ኵሎ፡ አኀዊነ፡ በአምኃ፡ ቅድሳት፡ ወተአምኁ፡ በበይናቲክሙ።</t:l>
                     <t:l n="27">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=27"/>አምሕለክሙ፡ በእግዚእነ፡ ታንብብዋ፡ ለዛቲ፡ መጽሐፍ፡ ላዕለ፡ ኵሎሙ፡ አኀዊነ፡ ቅዱሳን።</t:l>
                     <t:l n="28">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=1Th&amp;chapter=5&amp;verse=28"/>ጸጋሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ምስሌክሙ፡ አሜን።</t:l>
                  </t:ab>
               </t:div>
               
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>