         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3512Epistle">
            <t:note>Text of the EOTC printed Bible</t:note>
            <t:div type="textpart" subtype="chapter" n="1" xml:id="ch1">
               <t:label>ምዕራፍ 1</t:label>
               <t:ab>
                  <t:l>በእንተ፡ ትዕግሥት</t:l>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=1"/>እምያዕቆብ፡ ገብረ፡ እግዚአብሔር፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ለዐሠርቱ፡ ወክልኤቱ፡ ሕዝበ፡ ድዮስጶራ፡ ሰላም፡ ለክሙ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=2"/>ኦ፡ አኀው፡ ኩኑ፡ በኵሉ፡ ፍሥሓ። ሶበ፡ መንሱት፡ ይመጽአክሙ፡ ዘዘ፡ ዚኣሁ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=3"/>እንዘ፡ ተአምሩ፡ ከመ፡ መከራሃ፡ ለሃይማኖትክሙ፡ ትዕግሥተ፡ ይገብር፡ ለክሙ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=4"/>ወትዕግሥትሰ፡ ግብር፡ ፍጹም፡ ባቲ። ከመ፡ ትኩኑ፡ ፍጹማነ፡ ወጥዑያነ፡ እንዘ፡ አልቦ፡ ዘተኀጥኡ።</t:l>
                  <t:l>በእንተ፡ ሥርዐተ፡ ጸሎት</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=5"/>ወእመሰ፡ ቦ፡ ዘኀጥኣ፡ ለጥበብ፡ ለይስአል፡ ኀበ፡ ወሃቢ፡ እግዚአብሔር። ዘይሁብ፡ ለኵሉ፡ በስፉሕ፡ እንዘ፡ ኢይትዔየር፡ ወኢይዘረኪ፡ ወይትወሀብ፡ ሎቱ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=6"/>ወይስአል፡ እንዘ፡ ይትአመን፡ ወኢይናፍቅ፡ እስመ፡ ዘይናፍቅሰ፡ ይከውን፡ ከመ፡ ሞገደ፡ ባሕር። እንተ፡ ይዘብጣ፡ ነፋስ፡ ወያነውኃ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=7"/>ወኢይምሰሎ፡ ለውእቱ፡ ብእሲ፡ ከመ፡ ዘይነሥእ፡ ምንተኒ፡ እምኀበ፡ እግዚአብሔር።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=8"/>እስመ፡ ብእሲ፡ ዘክልኤ፡ ልቡ፡ ህዉክ፡ ውእቱ፡ በኵሉ፡ ፍኖቱ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=9"/>ለይትመካሕ፡ እኁነ፡ ነዳይ፡ በተልዕሎቱ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=10"/>ወባዕልሰ፡ በተትሕቶቱ፡ እስመ፡ ከመ፡ ፍሬ፡ ሣዕር፡ የኀልፍ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=11"/>ወእምከመ፡ ሠረቀ፡ ፀሓይ፡ ምስለ፡ ላህቡ። ያየብሶ፡ ለሣዕር፡ ወፍሬሁኒ፡ ይወድቅ፡ ወሥነ፡ ራእዩኒ፡ ይትሀጐል። ከማሁኬ፡ ባዕልኒ፡ በፍናዊሁ፡ ይጸመሒ።</t:l>
                  <t:l>በእንተ፡ ትዕግሥት፡ ወመከራ</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=12"/>ወብፁዕ፡ ብእሲ፡ ዘይትዔገሣ፡ ለእኪት። እስመ፡ ተመኪሮ፡ ይነሥእ፡ አክሊለ፡ ሕይወት። ዘአሰፈዎሙ፡ እግዚአብሔር፡ ለእለ፡ ያፈቅርዎ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=13"/>ወእመ፡ ቦ፡ ዘይትሜከር፡ ኢይበል፡ እግዚአብሔር፡ ያሜክረኒ። እስመ፡ እግዚአብሔር፡ ኢያሜክር፡ ለእኪት። ወውእቱሰ፡ ኢያሜክር፡ ወኢ፡ መነሂ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=14"/>አላ፡ አሐዱ፡ አሐዱ፡ ይትሜከር፡ በፍትወተ፡ እንቲኣሁ። ወይወፅእ፡ ኀቤሃ፡ ወይደነግፅ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=15"/>ወፍትወትሰ፡ እምከመ፡ ፀንሰት፡ ትወልዳ፡ ለኀጢአት። ወኀጢአትኒ፡ እምከመ፡ ተፈጸመት፡ ትወልዳ፡ ለሞት።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=16"/>ኢያስሕቱክሙ፡ አኀዊነ፡ ፍቁራን።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=17"/>ኵሉ፡ ሀብት፡ ሠናይ፡ ወኵሉ፡ ፍት፡ ፍጹም። እምላዕሉ፡ ይእቲ፡ ትወርድ፡ እምኀበ፡ አቡሃ፡ ለብርሃን። ውእቱ፡ ዘአልቦ፡ ተውላጥ፡ ኀቤሁ፡ ወአልቦ፡ ምንትኒ፡ ዘያመሥጥ፡ እምእዴሁ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=18"/>እስመ፡ በፈቃዱ፡ ወለደነ፡ በቃለ፡ ጽድቁ፡ ከመ፡ ንኩን፡ ቀደምተ፡ ለፍጥረቱ።</t:l>
                  <t:l>በእንተ፡ ትዕግሥት፡ ወዐቂበ፡ ሕግ</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=19"/>ወይእዜኒ፡ አኀዊነ፡ ኩኑ፡ ወይኩን፡ ኵሉ፡ ብእሲ፡ ፍጡነ፡ ለሰሚዕ። ወጕንዱየ፡ ለነቢብ፡ ወጕንዱየ፡ ለመዓት።</t:l>
                  <t:l n="20">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=20"/>እስመ፡ መዓቱ፡ ለብእሲ፡ ጽድቀ፡ እግዚአብሔር፡ ኢያገብሮ።</t:l>
                  <t:l n="21">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=21"/>ወይእዜኒ፡ ኅድግዋ፡ ለኵላ፡ ርስሐት፡ ወለኵላ፡ እኪት። ወበየውሀት፡ ተቀበልዎ፡ ለቃል፡ ዘተዘርዐ፡ ውስተ፡ ልብክሙ። ዘይክል፡ አድኅኖታ፡ ለነፍስክሙ።</t:l>
                  <t:l n="22">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=22"/>ወኩኑ፡ ገባርያኒሃ፡ ለሕግ፡ ወአኮ፡ ለአጽምዖ። ባሕቲቱ፡ ኀልይዎ፡ እስኩ፡ ለሊክሙ።</t:l>
                  <t:l n="23">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=23"/>እመ፡ ቦ፡ ዘያጸምዖ፡ ለቃል፡ ወኢይገብሮ። ይመስል፡ ከመ፡ ብእሲ፡ ዘይሬኢ፡ ፍጥረተ፡ ገጹ፡ በመጽሔት።</t:l>
                  <t:l n="24">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=24"/>ወጠይቆ፡ ርእሶ፡ ኀለፈ፡ ወረስዐ፡ ዘከመ፡ እፎ፡ ውእቱ።</t:l>
                  <t:l n="25">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=25"/>ወዘሰ፡ ሐወጸ፡ ውስተ፡ ሕግ፡ ፍጹም፡ ዘያግዕዝ፡ ወተዐገሠ። ኢኮነ፡ ራስዐ፡ ዘሰምዐ፡ አላ፡ ገባሬ፡ ሕግ፡ ውእቱ። ብፁዕ፡ ዝንቱ፡ በምግባሩ።</t:l>
                  <t:l>በእንተ፡ ሥርዐተ፡ ሕርመት</t:l>
                  <t:l n="26">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=26"/>ወእመ፡ ቦ፡ ዘይመስሎ፡ ከመ፡ ዘይትሔረም፡ ለእግዚአብሔር። ወኢያለጕሞ፡ ለልሳኑ፡ ወአስሐቶ፡ ለልቡ። ለዘከማሁ፡ ከንቱ፡ ሕርመቱ።</t:l>
                  <t:l n="27">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=1&amp;verse=27"/>ወሕርመትሰ፡ ንጽሕት፡ እንተ፡ እምኀበ፡ እግዚአብሔር፡ አብ። ዛቲ፡ ይእቲ፡ ከመ፡ ትዕቀቡ፡ ዕጓለ፡ ማውታ፡ ወዕቤራተ፡ በተጽናሶሙ። ወትዕቀቡ፡ ርእሰክሙ፡ እምዓለም፡ ዘእንበለ፡ ሕብቃቄ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="2" xml:id="ch2">
               <t:label>ምዕራፍ 2</t:label>
               <t:ab>
                  <t:l>በእንተ፡ ተዐቅቦ፡ እምአድልዎ</t:l>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=1"/>አኀዊነ፡ ኢትኩን፡ ለገጸ፡ ሰብእ፡ ሃይማኖትክሙ። እንተ፡ በእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘሎቱ፡ ስብሐት።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=2"/>ከመ፡ እመ፡ ቦአ፡ ውስተ፡ ማኅበርክሙ፡ ብእሲ፡ ዘኅልቀተ፡ ወርቅ፡ ወዘአልባስ፡ ንጹሕ። ወቦአ፡ ነዳይ፡ በአልባስ፡ ርሱሕ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=3"/>ወትኔጽርዎ፡ ለዘይለብስ፡ ንጹሐ፡ ወትብልዎ፡ አንተሰ፡ ንበር፡ ዝየ፡ ውስተ፡ ምሥናይ። ወለነዳይሰ፡ ትብልዎ፡ ቁም፡ ከሃከ፡ አንተሰ። ወእመ፡ አኮ፡ ንበር፡ ታሕተ፡ መከየደ፡ እገሪነ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=4"/>አኮኑ፡ እንከ፡ አድሎክሙ፡ ለሊክሙ፡ ወኮንክሙ፡ መደልዋነ፡ ለኅሊና፡ እኩይ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=5"/>ስምዑ፡ አኀዊነ፡ ፍቁራን፡ አኮኑ፡ እግዚአብሔር፡ ኀረዮሙ፡ ለነዳያነ፡ ዝ፡ ዓለም። ወአብዕልትሰ፡ ከመ፡ በሃይማኖቶሙ፡ ይወርስዋ፡ ለመንግሥት። እንተ፡ አሰፈዎሙ፡ ለእለ፡ ያፈቅርዎ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=6"/>ወአንትሙሰ፡ አስተሐቀርክምዎሙ፡ ለነዳያን። አኮኑ፡ እሙንቱ፡ አብዕልት፡ እለ፡ ይትዔገሉክሙ፡ ወይስሕቡክሙ፡ ውስተ፡ ተስናናት፡ ወአዕዋዳት።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=7"/>ወእሙንቱ፡ ይፀርፉ፡ ላዕለ፡ ስሙ፡ ዐቢይ፡ ዘተሰምየ፡ ላዕሌክሙ።</t:l>
                  <t:l>በእንተ፡ ፍቅር</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=8"/>ወእመሰ፡ ትፌጽሙ፡ ሕገ፡ በከመ፡ ይብል፡ መጽሐፍ። አፍቅር፡ ቢጸከ፡ ከመ፡ ነፍስከ፡ ሠናየ፡ ትገብሩ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=9"/>ወእመሰ፡ ገጸ፡ ትነሥኡ፡ ኀጢአተ፡ ትገብሩ። ወይዛለፍክሙ፡ ሕግ፡ ከመ፡ ከሓዲ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=10"/>ወዘሰ፡ ይገብሮ፡ ለኵሉ፡ ሕግ፡ ወይስሕት፡ በአሐቲ፡ ኮነ፡ መአብሰ፡ በኵሉ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=11"/>እስመ፡ ዘይቤ፡ ኢትሑር፡ ኀበ፡ ብእሲተ፡ ብእሲ፡ ይቤ፡ ኢትቅትል፡ ነፍሰ። ወእመሰ፡ ኢተሐውር፡ ኀበ፡ ብእሲተ፡ ብእሲ፡ ወባሕቱ፡ ትቀትል፡ ነፍሰ፡ ኮንከ፡ ውፁአ፡ እምሕግ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=12"/>ከመ፡ ዝ፡ ንግሩ፡ ወከመ፡ ዝ፡ ግበሩ፡ ከመ፡ ዘበሕገ፡ ግዕዛን፡ ሀለውክሙ፡ ትትኰነኑ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=13"/>እስመ፡ በደይንሰ፡ አልቦ፡ ምሒር፡ ለዘኢገብረ፡ ምሕረተ። ወይትሜካሕ፡ ባሕቱ፡ በዕለተ፡ ደይን፡ ዘገብረ፡ ምሕረተ።</t:l>
                  <t:l>በእንተ፡ ሃይማኖት፡ ወምግባር</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=14"/>ምንተ፡ ይበቊዕ፡ አኀዊነ፡ ለእመ፡ ቦ፡ ዘይብል፡ ሃይማኖት፡ ብየ፡ ወምግባረ፡ ሠናይ፡ አልብየ። ቦኑ፡ ትክል፡ ሃይማኖቱ፡ አድኅኖቶ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=15"/>ለእመ፡ ቦ፡ እምአኀዊነ፡ አው፡ እምአኃቲነ። እለ፡ ዕሩቃን፡ እሙንቱ፡ አው፡ ኅጡኣን፡ ለሲሳየ፡ ዕለቶሙ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=16"/>ወቦ፡ ዘይቤሎሙ፡ እምኔክሙ፡ ሑሩ፡ በሰላም፡ ሰኀኑ፡ ወትጸግቡ። ወኢወሀቦሙ፡ ዘይፈቅዱ፡ ለተጽናሶሙ፡ ምንተ፡ ይበቊዖሙ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=17"/>ከማሁ፡ ሃይማኖትኒ፡ እንተ፡ አልባቲ፡ ምግባረ፡ ሠናይ፡ ምዉት፡ ይእቲ፡ ለሊሃ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=18"/>እመ፡ ቦ፡ ዘይቤለከ፡ አንተ፡ ሃይማኖት፡ ብከ፡ ወአነ፡ ምግባረ፡ ሠናይ፡ ብየ። አርእየኒኬ፡ ሃይማኖተከ፡ ዘእንበለ፡ ምግባሪከ። ወአንሰ፡ አርእየከ፡ እምነ፡ ምግባርየ፡ ሃይማኖትየ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=19"/>አንተሰ፡ ተአምን፡ ከመ፡ አሐዱ፡ ውእቱ፡ እግዚአብሔር፡ ሠናየ፡ ትገብር። ከማሁሰ፡ አጋንንትኒ፡ የአምኑ፡ ወይደነግፁ።</t:l>
                  <t:l n="20">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=20"/>ትፈቅድኑ፡ ታእምር፡ ኦ፡ ብእሲ፡ አብድ። ከመ፡ ሃይማኖት፡ ዘእንበለ፡ ምግባር፡ ምዉት፡ ይእቲ።</t:l>
                  <t:l n="21">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=21"/>አኮኑ፡ አብርሃም፡ አቡነ፡ በምግባሩ፡ ጸድቀ። ሶበ፡ አዕረጎ፡ ለይስሐቅ፡ ወልዱ፡ ውስተ፡ ምሥዋዕ።</t:l>
                  <t:l n="22">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=22"/>ትሬኢኑ፡ ከመ፡ ሃይማኖት፡ ትረድኦ፡ ለገቢር። ወበምግባሩ፡ መልአት፡ ወፍጽምተ፡ ኮነት፡ ሃይማኖቱ።</t:l>
                  <t:l n="23">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=23"/>ወተፈጸመ፡ ዘይብል፡ መጽሐፍ፡ አምነ፡ አብርሃም፡ በእግዚአብሔር። ወተኈለቈ፡ ጽድቀ፡ ወፍቁረ፡ እግዚአብሔር፡ ተሰምየ።</t:l>
                  <t:l n="24">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=24"/>ትሬኢኑ፡ ከመ፡ በምግባሩ፡ ይጸድቅ፡ ሰብእ። ወአኮ፡ በሃይማኖቱ፡ ባሕቲታ።</t:l>
                  <t:l n="25">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=25"/>ወከማሁ፡ ረአብኒ፡ ዘማ፡ በምግባሪሃ፡ ጸድቀት፡ ሶበ፡ ተቀበለቶሙ፡ ለሰብአ፡ ዐይን። ወእንተ፡ ካልእት፡ ፍኖት፡ አውፅአቶሙ።</t:l>
                  <t:l n="26">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=2&amp;verse=26"/>በከመ፡ ሥጋ፡ ዘአልቦ፡ መንፈስ፡ ምዉት፡ ውእቱ። ከማሁ፡ ሃይማኖትኒ፡ እንተ፡ አልባቲ፡ ምግባረ፡ ሠናይ፡ ምዉት፡ ይእቲ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="3" xml:id="ch3">
               <t:label>ምዕራፍ 3</t:label>
               <t:ab>
                  <t:l>በእንተ፡ ተዐቅቦ፡ እምነ፡ ስሒት</t:l>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=1"/>ወኢይኩኑ፡ እምውስቴትክሙ፡ ብዙኃን፡ መምህራን፡ አኀዊነ። ተአምሩ፡ ከመ፡ እንተ፡ ተዐቢ፡ ደይነ፡ ንነሥእ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=2"/>እስመ፡ ብዙኀ፡ ንስሕት፡ ኵልነ። ወዘሰ፡ ኢይስሕት፡ በቃሉ፡ ፍጹም፡ ውእቱ፡ ወይክል፡ ወድየ፡ ልጓም፡ ለኵሉ፡ ሥጋሁ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=3"/>ወናሁ፡ ለአፍራስኒ፡ ንወዲ፡ ሎቶን፡ ልጓመ፡ ውስተ፡ አፉሆን። ከመ፡ ኦሆ፡ ይበላነ፡ ወንመይጦን፡ ኵሎ፡ ሥጋሆን።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=4"/>ወናሁ፡ ለአሕማርኒ፡ ዘመጠነ፡ ዝ፡ አካሎን። ወበኀይለ፡ ነፋስ፡ ሶበ፡ ይትነድኣ፡ ወይትመየጣ። ይመይጦን፡ ብእሲ፡ በኀዳፍ፡ እንዘ፡ መጠነ፡ ዝ፡ ናእሱ። ወያበውኦን፡ ውስተ፡ መርሶ፡ ኀበ፡ ፈቀደ።</t:l>
                  <t:l>በእንተ፡ አግርሮተ፡ ልሳን</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=5"/>ከማሁ፡ ልሳንኒ፡ ንስቲት፡ አባል፡ ይእቲ፡ ወታመጽእ፡ ዐቢያተ። ወናሁ፡ እሳትኒ፡ ንስቲት፡ ጥቀ፡ ዘመጠነ፡ ዝ፡ ዖመ፡ ታውዒ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=6"/>ወልሳንኒ፡ እሳት፡ ይእቲ፡ ለዓለም፡ ዘዐመፃ። ወናሁ፡ ልሳንኒ፡ ንስቲት፡ ተፈጥረት፡ ውስተ፡ ነፍስትነ። ወታረምፆ፡ ለሥጋነ፡ ወትሎሉ፡ ክቡተ፡ ፍጥረተነ፡ ወታውዒ፡ ጥቀ፡ እምገሃነም።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=7"/>እስመ፡ ኵሉ፡ ፍጥረተ፡ አራዊትኒ፡ አዕዋፍኒ። ወዘይትሐወስኒ፡ ውስተ፡ ባሕር፡ ወእንስሳኒ፡ ይገርር፡ ለፍጥረተ፡ ዕጓለ፡ እመሕያው።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=8"/>ወለልሳነ፡ ዕጓለ፡ እመሕያውሰ፡ አልቦ፡ ዘይክል፡ አግርሮታ። እኪት፡ ይእቲ፡ ወአልባ፡ ዐቅም። ወምልእት፡ ይእቲ፡ ሕምዘ፡ ዘይቀትል።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=9"/>ባቲ፡ ንባርኮ፡ ለእግዚአብሔር፡ አብ። ወባቲ፡ ንረግሞ፡ ለዕጓለ፡ እመሕያው፡ ዘበአርአያ፡ እግዚአብሔር፡ ተፈጥረ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=10"/>እምአሐዱ፡ አፍ፡ ይፃእ፡ ቡራኬ፡ ወመርገም። ኢይረትዕ፡ ከመ፡ ዝ፡ አኀዊነ፡ ይኩን።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=11"/>ይትከሀልኑ፡ ይፃእ፡ እምአሐዱ፡ ዐይን። ወእምውስተ፡ አሐቲ፡ ዐዘቅት፡ ይነቅዕኑ፡ ማይ፡ መሪር፡ ወማይ፡ ጥዑም።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=12"/>ይክልኑ፡ አኀዊነ፡ በለስ፡ ዘይተ፡ ፈርየ። ወእመ፡ አኮ፡ ወይን፡ በለሰ፡ ፈርየ። ከማሁኬ፡ ማይኒ፡ መሪር፡ ኢይከውን፡ ጥዑመ። ወማይኒ፡ ጥዑም፡ ኢይከውን፡ መሪረ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=13"/>ወመኑ፡ ጠቢብ፡ እምኔክሙ፡ ወምኩር። ከመ፡ ያርኢ፡ ምግባሮ፡ በየውሀት፡ ወበጥበብ፡ እምሥነ፡ ግዕዙ።</t:l>
                  <t:l>በእንተ፡ ጥበብ፡ ዘእምላእሉ</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=14"/>ወእመሰ፡ ተቃንኦ፡ መሪር፡ ወካሕድ፡ ብክሙ፡ ውስተ፡ ልብክሙ። ኢትትመክሑ፡ ወኢተሐስውዋ፡ ለጽድቅ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=15"/>ኢኮነት፡ ዛቲ፡ ጥበብ፡ እንተ፡ እምላዕሉ፡ ትወርድ። አላ፡ እምድር፡ እንተ፡ እምነፍሰ፡ አጋንንት።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=16"/>እስመ፡ ኀበ፡ ሀለወ፡ ተቃንኦ። ህየ፡ ሀለወ፡ ሀውክ፡ ወካሕድ፡ ወኵሉ፡ እከየ፡ ምግባር።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=17"/>ወእንተሰ፡ እምላዕሉ፡ ጥበብ፡ ቀዳሚሃ፡ ንጽሕት፡ ይእቲ። እንተ፡ ታስተሰናኡ፡ ወእንተ፡ በዐቅም። ኦሆ፡ በሃሊት፡ ወምልእት፡ ምሕረተ። ወፍሬሃ፡ ሠናይ፡ ዘእንበለ፡ ኑፋቄ፡ አማኒት።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=3&amp;verse=18"/>ወፍሬሃኒ፡ ዘጽድቅ፡ በሰላም፡ ይዘራዕ፡ ለእለ፡ ይገብርዋ፡ ለሰላም።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="4" xml:id="ch4">
               <t:label>ምዕራፍ 4</t:label>
               <t:ab>
                  <t:l>በእንተ፡ ፍቁሩ፡ ለዓለም፡ ጸላኢሁ፡ ለእግዚአብሔር</t:l>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=1"/>እምአይቴ፡ ለክሙ፡ ጸብእ፡ ወቀትል። አኮኑ፡ እም፡ ዝየ፡ እምአፍቅሮ፡ ዝሙት፡ ዘይትገበር፡ ውስተ፡ አንጒዕክሙ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=2"/>ትፈትዉሂ፡ ወኢትረክቡ፡ ትትቃንኡሂ፡ ወትትቃተሉሂ። ወበእንተዝ፡ ኢትክሉ፡ ድኂነ፡ ትትበአሱሂ፡ ወትጻብኡሂ። ወኢትረክቡ፡ ዘተኀሥሡ፡ እስመ፡ ኢትስእሉ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=3"/>ትስእሉሂ፡ ወኢይሁቡክሙ፡ እስመ፡ ለእኪት፡ ትስእሉ፡ ለዝሙትክሙ፡ ከመ፡ ተሀቡ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=4"/>ኦ፡ ዘማውያን፡ ኢተአምሩኑ፡ ከመ፡ ፍቁሩ፡ ለዝ፡ ዓለም፡ ጸላኢሁ፡ ውእቱ፡ ለእግዚአብሔር። እስመ፡ ዘአብደረ፡ ፍቅሮ፡ ለዝ፡ ዓለም፡ ጸላኢሁ፡ ለእግዚአብሔር፡ ይከውን።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=5"/>ወሚመ፡ ይመስለክሙኑ፡ ዘሐሰተ፡ ይብል፡ መጽሐፍ። ከመ፡ ተቃንኦ፡ ያፈቅር፡ መንፈስ፡ ዘየኀድር፡ ላዕሌክሙ።</t:l>
                  <t:l>በእንተ፡ ሞገስ፡ እንተ፡ ተዐቢ</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=6"/>ወባሕቱ፡ አምላክነ፡ እንተ፡ ተዐቢ፡ ሞገሰ፡ ይሁበነ። ወበእንተ፡ ዝንቱ፡ ይቤ፡ እስመ፡ ለዕቡያን፡ ይትሄየዮሙ፡ እግዚአብሔር። ወለእለሰ፡ ያቴሕቱ፡ ርእሶሙ፡ ይሁቦሙ፡ ሞገሰ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=7"/>ኦሆ፡ በልዎ፡ ለእግዚአብሔር፡ ወእንብየ፡ በልዎ፡ ለጋኔን፡ ወይጐይይ፡ እምኔክሙ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=8"/>ቅረብዎ፡ ለእግዚአብሔር፡ ወይቀርበክሙ። አንጽሑ፡ እደዊክሙ፡ ኃጥኣን፡ ወአንጽሑ፡ ልበክሙ፡ እለ፡ ትናፍቁ፡ ግነዩ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=9"/>ላሕዉ፡ ወብክዩ፡ ወለሠሐቅክሙኒ፡ ሚጥዎ፡ ውስተ፡ ላሕ። ወትፍሥሕትክሙኒ፡ ውስተ፡ ትካዝ፡ አግብእዎ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=10"/>አትሕቱ፡ ርእሰክሙ፡ ወያሌዕለክሙ፡ እግዚአብሔር።</t:l>
                  <t:l>በእንተ፡ ተዐቅቦ፡ እምነ፡ ሐሜት</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=11"/>ወኢትትሐመዩ፡ በበይናቲክሙ፡ አኀዊነ። እስመ፡ ዘሐመዮ፡ ለካልኡ፡ ሐመዮ፡ ለሕገ፡ እግዚአብሔር። ወዘይግእዝ፡ ካልኦ፡ ሕገ፡ እግዚአብሔር፡ ገአዘ። ወእመሰ፡ ሕጎ፡ ትግእዝ፡ ኢኮንከ፡ ገባሬ፡ ሕግ፡ አላ፡ ኮንከ፡ ገኣዚሃ፡ ለሕግ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=12"/>እስመ፡ አሐዱ፡ ውእቱ፡ ወሃቢሃ፡ ለሕግ። ወመኰንና፡ ለሕግ፡ ዘውእቱ፡ ይክል፡ አማስኖሂ፡ ወአድኅኖሂ። አንተኬ፡ ምንትኑ፡ አንተ፡ ዘትግእዞ፡ ለካልእከ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=13"/>ከመ፡ እለ፡ ይብሉ፡ ዮም፡ አው፡ ጌሠመ፡ ነሐውር፡ ውስተ፡ እንታክቲ፡ ሀገር። ወንነብር፡ ውስቴታ፡ ወንትጌበር፡ ወንረብሕ። ወኢየአምሩ፡ ዘይከውን፡ ጌሠመ።</t:l>
                  <t:l>በእንተ፡ ተአምኖ፡ በእግዚአብሔር</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=14"/>ምንትኑመ፡ ሕይወትክሙ፡ አኮኑ፡ ጢስ፡ አንትሙ። ዘለምዕር፡ ያስተርኢ፡ ወእምድኅሬሁ፡ ይማስን።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=15"/>ዘእምትቤሉ፡ እመ፡ ሠምረ፡ እግዚአብሔር። ወሐየውነ፡ ንገብር፡ ዘንተ፡ አው፡ ዝክተ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=16"/>ወይእዜሰ፡ ትትሜክሑ፡ በምግባሪክሙ። ወኵላ፡ ትምክሕት፡ እንተ፡ ከመ፡ ዝ፡ እኪት፡ ይእቲ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=4&amp;verse=17"/>ወዘየአምር፡ ገቢሮታ፡ ለሠናይት፡ ወኢይገብራ፡ ኀጢአተ፡ ትከውኖ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="5" xml:id="ch5">
               <t:label>ምዕራፍ 5</t:label>
               <t:ab>
                  <t:l>በእንተ፡ ተግሣጽ፡ ለአብዕልት</t:l>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=1"/>ንዑ፡ ይእዜኒ፡ አብዕልት፡ ወብክዩ። እንዘ፡ ትግዕሩ፡ ላዕለ፡ ሕርትምናክሙ፡ እንተ፡ ሀለዋ፡ ትምጻእክሙ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=2"/>ብዕልክሙኒ፡ ነቅዘ፡ ወአልባሲክሙኒ፡ ቈንቈነ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=3"/>ወርቅክሙኒ፡ ወብሩርክሙኒ፡ ዝሕለ፡ ወዛሕሉኒ፡ ስምዐ፡ ይከውን፡ ላዕሌክሙ። ወይበልዖ፡ ለሥጋክሙ፡ ከመ፡ እሳት፡ በእንተ፡ ዘገበርክሙ፡ ለደኃሪ፡ መዋዕል።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=4"/>ናሁ፡ ዐስቦሙ፡ ለገባር፡ ለእለ፡ ሐረስዋ፡ ለምድርክሙ። ሄድክምዎሙ፡ ወዐመፅክምዎሙ፡ ዐስቦሙ፡ ወእለኒ፡ ሄድክምዎሙ፡ የዐወይዉ። ወገዓሮሙኒ፡ ለዐጸድ፡ ቦአ፡ ውስተ፡ እዘኒሁ፡ ለእግዚአብሔር፡ ጸባኦት፡ ወበጽሐ፡ ግፍዕክሙ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=5"/>ወፈጋዕክሙ፡ ላዕለ፡ ምድር፡ ወአስተትክሙ፡ ወተደለውክሙ፡ ወአሥባሕክሙ፡ ልበክሙ። ከመ፡ ዘያሥብሕ፡ ላሕመ፡ ለዕለተ፡ ጥብሐት።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=6"/>ወተዐደውክሙ፡ ወቀተልክምዎ፡ ለጻድቅ፡ ዘእንበለ፡ ይትቃወመክሙ፡ ወኦሆ፡ ይብለክሙ።</t:l>
                  <t:l>በእንተ፡ ትዕግሥት፡ ብፅዕት</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=7"/>ተዐገሡ፡ እንከ፡ አኀዊነ፡ እስከ፡ ደኃሪት፡ ዕለት። አመ፡ ይመጽእ፡ እግዚእክሙ፡ ከመ፡ ሐረሳዊ፡ ዘይጸንሕ፡ ፍሬሃ፡ ለምድር፡ ክብርት። እንዘ፡ ይትዔገሣ፡ ሠርከ፡ ወነግሀ፡ እስከ፡ ትሠዊ፡ ወትፈሪ፡ ሎቱ፡ ወትትዐጸድ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=8"/>ተዐገሡኬ፡ አንትሙ፡ ወአጽንዑ፡ ልበክሙ። እስመ፡ ቀርበ፡ ምጽአቱ፡ ለእግዚእክሙ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=9"/>ወኢትግዐሩ፡ አኀዊነ፡ ላዕለ፡ ቢጽክሙ፡ ከመ፡ ኢትትኰነኑ። እስመ፡ ናሁ፡ መኰንን፡ ኀበ፡ መድረከ፡ ኆኅትክሙ፡ ይቀውም፡ ወይጸንሕ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=10"/>አርአያሃሰ፡ አኀዊነ፡ ለትዕግሥተ፡ ተጽናስክሙ። ብክሙ፡ ነቢያት፡ እለ፡ ተናገሩ፡ በቃሉ፡ ለእግዚአብሔር። ናሁ፡ ናስተበፅዖሙ፡ ለእለ፡ ተዐገሡ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=11"/>ወሰማዕክሙ፡ ትዕግሥቶ፡ ለኢዮብ። ወርኢክሙ፡ ዘከመ፡ ፈጸመ፡ ሎቱ፡ እግዚአብሔር። እስመ፡ ብዙኅ፡ ምሕረቱ፡ ለእግዚአብሔር፡ ወመስተሣህል፡ ውእቱ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=12"/>ወእምኵሉሰ፡ ዘይቀድም፡ አኀዊነ፡ ኢትምሐሉ፡ ኢ፡ በሰማይ፡ ወኢ፡ በምድር። ወኢ፡ በካልእ፡ መሐላ፡ ኢትምሐሉ፡ ግሙራ፡ ወኢ፡ በምንትኒ፡ አላ፡ አሐደ፡ ይኩን፡ ቃልክሙ። እመኒ፡ እወ፡ እወ፡ ወእመኒ፡ አልቦ፡ አልቦ። ከመ፡ ኢትትኰነኑ፡ ወኢትባኡ፡ ውስተ፡ ደይን።</t:l>
                  <t:l>በእንተ፡ ጸሎተ፡ ጻድቅ</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=13"/>እመ፡ ቦ፡ ዘይቴክዝ፡ ለይጸሊ፡ ወእመ፡ ቦ፡ ዘተፈሥሐ፡ ለይዘምር።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=14"/>ወእመ፡ ቦ፡ ዘይደዊ፡ እምኔክሙ፡ ለይጸውዕ፡ ቀሳውስተ፡ እለ፡ ውስተ፡ ቤተ፡ ክርስቲያን። ወይጸልዩ፡ ላዕሌሁ፡ ወይቅብዕዎ፡ ቅብዐ፡ ጸሎት፡ በስሙ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=15"/>ወጸሎተ፡ ሃይማኖት፡ ያሐይዎ፡ ለድዉይ፡ ወያነሥኦ፡ እግዚአብሔር። ወእመኒ፡ ቦቱ፡ ኀጢአት፡ ይትኀደግ፡ ሎቱ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=16"/>ተኣመኑ፡ በበይናቲክሙ፡ ኀጢአትክሙ፡ ወጸልዩ፡ ላዕለ፡ ቢጽክሙ፡ ከመ፡ ትሕየዉ። ብዙኀ፡ ትረድእ፡ ጸሎቱ፡ ለጻድቅ፡ ትክል፡ ወታሰልጥ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=17"/>ኤልያስ፡ ዘከማነ፡ ሰብእ፡ ውእቱ፡ ወዘከመ፡ ነሐምም፡ የሐምም። ወጸሎተ፡ ጸለየ፡ ከመ፡ ኢይዝንም፡ ዝናም። ወኢዘንመ፡ ውስተ፡ ምድር፡ ሠለስተ፡ ዓመተ፡ ወስድስተ፡ አውራኀ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=18"/>ወካዕበ፡ ጸለየ፡ ከመ፡ ይዝንም። ወወሀበ፡ ሰማይ፡ ዝናሞ፡ ወምድርኒ፡ አብቈለት፡ ፍሬሃ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=19"/>አኀዊነ፡ እመ፡ ቦ፡ ዘስሕተ፡ እምኔክሙ፡ እምጽድቅ። ወእመ፡ ቦ፡ ዘሜጦ፡ እምነ፡ ጌጋዩ።</t:l>
                  <t:l n="20">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Jam&amp;chapter=5&amp;verse=20"/>ለያእምር፡ ከመ፡ አድኀነ፡ ርእሶ፡ እምነ፡ ሞት፡ ወከደኖን፡ ለብዙኃት፡ ኀጣውኢሁ።</t:l>
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>