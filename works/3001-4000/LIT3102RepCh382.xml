         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3102RepCh382">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ክርስቶስ፡ አምላኪየ፡ ወተስፋየ፡ አንተ፨</t:l>
                  <t:l n="2">ወእግዝእትየ፡ ማርያም፡ ትስአል፡ ሊተ፨</t:l>
                  <t:l n="3">እምዘ፡ ሐለይኩ፡ ብዙኅ፡ እስከ፡ እጽሕፍ፡ ንስቲተ፨</t:l>
                  <t:l n="4">ከመ፡ ይትኀፈር፡ ርእዮ፡ ድርሳነ፡ መስቀልከ፡ ዘንተ፨</t:l>
                  <t:l n="5">ዘመንፈሰ፡ ቃል፡ ያጠፍእ፡ ወያሜንን፡ ትንቢተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">በእንተ፡ ሞገሱ፡ ለመስቀልከ፡ ዘተሳተፈ፨</t:l>
                  <t:l n="2">በለኒ፡ ክርስቶስ፡ እንዘ፡ ትከሥት፡ አፈ፨</t:l>
                  <t:l n="3">እምትትፈሣሕ፡ በብዕል፡ እንተ፡ ያፈጥን፡ ኀሊፈ፨</t:l>
                  <t:l n="4">ተፈሣሕሰ፡ ወተኀሠይ፡ ዘልፈ፨</t:l>
                  <t:l n="5">እስመ፡ በሰማይ፡ ስምከ፡ ተጽሕፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘኢየኀብር፡ ግዕዘ፨</t:l>
                  <t:l n="2">ምስለ፡ ግዕዘ፡ ባዕዳን፡ ዕፀው፡ እለ፡ ይወልዱ፡ ነቀዘ፨</t:l>
                  <t:l n="3">ለጽሒፈ፡ መስቀል፡ ማሕሌተከ፡ ሐዋዘ፨</t:l>
                  <t:l n="4">ብርዐ፡ ወቀለመ፡ እዴየ፡ አኀዘ፨</t:l>
                  <t:l n="5">ሶበ፡ ከመ፡ ንጉሥ፡ ኪያየ፡ ጻሕቀ፡ ልብየ፡ አዘዘ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘአስተርአየ፡ ዕበያ፨</t:l>
                  <t:l n="2">በቅድመ፡ ሰብአ፡ ፅርዕ፡ ወግብጽ፡ ወቅድመ፡ ሰብአ፡ ሮም፡ ወአፍራግያ፨</t:l>
                  <t:l n="3">ዕፀ፡ ለውዝ፡ መስቀል፡ ዘኢይትማሰለከ፡ ዕፀ፡ ኢጡያ፨</t:l>
                  <t:l n="4">ሃሌ፡ ሉያ፡ ሃሌ፡ ሉያ፡ ሃሌ፡ ሉያ፨</t:l>
                  <t:l n="5">እስከ፡ ትቤ፡ ንግሥት፡ ታውዶክስያ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘነኪር፡ ግብሩ፨</t:l>
                  <t:l n="2">እሞገሰ፡ ነቢይ፡ ሙሴ፡ ወለአሮን፡ እምነ፡ ክብሩ፨</t:l>
                  <t:l n="3">ንጉሠ፡ ዕፀዋት፡ መስቀል፡ እለ፡ ኪያከ፡ ነጸሩ፨</t:l>
                  <t:l n="4">ለሳብዕ፡ ወርኅ፡ አመ፡ ዓሡሩ፨</t:l>
                  <t:l n="5">በጸናጽል፡ ፍጹመ፡ ዘመሩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘያስተፌሥሕ፡ እምወይን፨</t:l>
                  <t:l n="2">ወዘያጸንዕ፡ እምእክል፡ ኀይለ፡ ድኩማን፨</t:l>
                  <t:l n="3">እሴፈወከ፡ መስቀል፡ ማዕተበ፡ ኪዳን፨</t:l>
                  <t:l n="4">ከመ፡ ንርከብ፡ መክፈልተ፡ ወርስተ፡ ውስተ፡ በአቶሙ፡ ለቅዱሳን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለሞገስከ፡ ዘይሤኒ፨</t:l>
                  <t:l n="2">እሞገሰ፡ ቄድሮስ፡ ወዕፀ፡ አቃኒ፨</t:l>
                  <t:l n="3">ረድኤተ፡ ቈስጠንጢኖስ፡ መስቀል፡ ወዘወላዲቱ፡ እሌኒ፨</t:l>
                  <t:l n="4">ጽብኦሙ፡ ለጸላእትየ፡ እለ፡ ይጽብኡኒ፨</t:l>
                  <t:l n="5">ከመ፡ ጸባእኮ፡ ለፈርዖን፡ በጣኒ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ እንተ፡ ነጸሮ፡ ወንዕዶ፨</t:l>
                  <t:l n="2">ዐርከ፡ ገጣሪ፡ አብርሃም፡ በዕለተ፡ ሦዐ፡ ወልዶ፨</t:l>
                  <t:l n="3">ተቅዋመ፡ ማኅቶቱ፡ መስቀል፡ ለዘካርያስ፡ ዘሐዶ፨</t:l>
                  <t:l n="4">ዘክሕደ፡ ኪያከ፡ ሶበ፡ ምክረ፡ ሰይጣን፡ አዕበዶ፨</t:l>
                  <t:l n="5">በሥላሴሁ፡ ለክርስቶስ፡ ክሕዶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ማኅበረ፡ እስራኤል፡ በኍልቍ፨</t:l>
                  <t:l n="2">እንተ፡ ነጸርዎ፡ በወርኀ፡ ኃምስ፡ ኵርያቍ፨</t:l>
                  <t:l n="3">ዕፀ፡ ሥን፡ መስቀል፡ ቢጸ፡ ሰንሰሪቍ፨</t:l>
                  <t:l n="4">ይሤኒ፡ ሞገስከ፡ እምዕፀ፡ ጳውቄና፡ ወህቍ፨</t:l>
                  <t:l n="5">እምነ፡ አእባን፡ ከመ፡ ይሤኒ፡ ዕንቍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘእግዚአብሔር፡ አዕበዮ፨</t:l>
                  <t:l n="2">ኀበ፡ ኢይበጽሕ፡ እግረ፡ ኀልዮ፨</t:l>
                  <t:l n="3">ዕፀ፡ መድኃኒት፡ ወቤዛ፡ መስቀል፡ ዘቀራንዮ፨</t:l>
                  <t:l n="4">ረድኤትከ፡ ያስተርኢ፡ ከመ፡ ለዳዊት፡ ተርእዮ፨</t:l>
                  <t:l n="5">በዓመተ፡ ሞተ፡ ውስተ፡ ጸብእ፡ ኦርዮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ በአምሳለ፡ ሥሙር፡ ወልታ፨</t:l>
                  <t:l n="2">ዘይኬልላ፡ በስብሐት፡ ለለ፡ ይጸብሕ፡ ሳኒታ፨</t:l>
                  <t:l n="3">ያፈቅረከ፡ ልብየ፡ መስቀል፡ ዘጎልጎታ፨</t:l>
                  <t:l n="4">ከመ፡ ያፈቅሮን፡ ክርስቶስ፡ ለአሐተ፡ አልዐዛር፡ መንታ፨</t:l>
                  <t:l n="5">ዘአስማቲሆን፡ ማርያ፡ ወማርታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘእደ፡ ሳሙኤል፡ ገለፋ፨</t:l>
                  <t:l n="2">መልዕልተ፡ አቤኔዜር፡ እብነ፡ መሴፋ፨</t:l>
                  <t:l n="3">መስቀለ፡ ኢየሱስ፡ ክርስቶስ፡ ሞገሰ፡ መስቀሉ፡ ለኬፋ፨</t:l>
                  <t:l n="4">ኢያጠፍእዋ፡ እምኅሊናየ፡ ማያተ፡ አቦና፡ ወፈርፋ፨</t:l>
                  <t:l n="5">በላህበ፡ ፍቅርከ፡ ዘእሳት፡ ክንፋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ወለክብርከ፡ ሱታፉ፨</t:l>
                  <t:l n="2">ዘአስተብፅዖ፡ ጳውሎስ፡ መምህረ፡ ቂልቅያ፡ ወጳፉ፨</t:l>
                  <t:l n="3">ኪያከ፡ መስቀል፡ ለመልክአ፡ ብእሲ፡ በጽንፉ፨</t:l>
                  <t:l n="4">ሶበ፡ ይኔጽር፡ ሰይጣን፡ ከመ፡ የሐምም፡ ለዝሉፉ፨</t:l>
                  <t:l n="5">በሲኖዶሶሙ፡ ሐዋርያት፡ ጸሐፉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="36">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለሞገስከ፡ ኮቶሊካ፨</t:l>
                  <t:l n="2">እምኀያላነ፡ ሞት፡ ወሲኦል፡ እንተ፡ ትትካፈል፡ ምህርካ፨</t:l>
                  <t:l n="3">ጸግወኒ፡ መስቀል፡ እንዘ፡ ትብል፡ ህንካ፨</t:l>
                  <t:l n="4">ሞገስከ፡ ሞገሰ፡ ጽድቅ፡ ወረድኤትከ፡ ተውሳካ፨</t:l>
                  <t:l n="5">ለቀትረ፡ ሕይወትየ፡ ዛቲ፡ ቅድመ፡ ይብጻሕ፡ ሰርካ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ለእግዚአብሔር፡ ዐተባ፨</t:l>
                  <t:l n="2">ለዘመነ፡ ትንቢት፡ ዐባይ፡ በዕለተ፡ ተፈጸመ፡ ምግባ፨</t:l>
                  <t:l n="3">በዓርበ፡ ፋሲካ፡ መስቀል፡ አመ፡ ቆምከ፡ ውስተ፡ መርኅባ፨</t:l>
                  <t:l n="4">በከየት፡ ፈድፋደ፡ ምስለ፡ እስራኤል፡ ሕዝባ፨</t:l>
                  <t:l n="5">ርስተ፡ ኃጢአት፡ ዘስማ፡ ሐሊባ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="38">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለሞገስከ፡ እብላ፨</t:l>
                  <t:l n="2">እሞገሰ፡ ጻድቃን፡ ኵሉ፡ ዘእግዚአብሔር፡ አልዐላ፨</t:l>
                  <t:l n="3">ኦመስቀል፡ ዕፀ፡ ፍሥሓ፡ ወተድላ፨</t:l>
                  <t:l n="4">መነኑከ፡ እፎ፡ ከመ፡ ይሜንኑ፡ ገደላ፨</t:l>
                  <t:l n="5">ቀተልተ፡ ነቢያት፡ ሐሊባ፡ ወሐላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="39">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ለገራህተ፡ ዓለም፡ በምልኡ፨</t:l>
                  <t:l n="2">በአምሳለ፡ ኅጠት፡ ዘልህቀ፡ ወዘተለዐለ፡ ዘርኡ፨</t:l>
                  <t:l n="3">ዕፀ፡ ቅድሳት፡ መስቀል፡ ለቍርባነ፡ ወንጌል፡ ምሥዋዑ፨</t:l>
                  <t:l n="4">ጥቀ፡ ገፍዕዎሙ፡ ለእለ፡ ኪያከ፡ ገፍዑ፨</t:l>
                  <t:l n="5">አስባስያኖስ፡ ወጢጦስ፡ ካልኡ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ በሠርቀ፡ ወርኀ፡ ጽርዕ፡ ኤጳፍሊ፨</t:l>
                  <t:l n="2">ዘእግዚአብሔር፡ ይቤላ፡ ብሔረ፡ ግብጽ፡ ፍክሊ፨</t:l>
                  <t:l n="3">በትረ፡ ኀይል፡ መስቀል፡ ሞገሰ፡ ዐዚዝ፡ ቴዎፍሊ፨</t:l>
                  <t:l n="4">ሠርዎሙ፡ ለአፅራርየ፡ እንበለ፡ ትፍልጥ፡ ወትፍሊ፨</t:l>
                  <t:l n="5">በከመ፡ ሠረውዎ፡ ምስለ፡ ወልዱ፡ ለሳኦል፡ ኢሎፍሊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘኢይፌጽሞ፡ ፍካሬ፨</t:l>
                  <t:l n="2">ከመ፡ ሱራሬሃ፡ ሐዋዝ፡ ለዐባይ፡ ድብታሬ፨</t:l>
                  <t:l n="3">ሠናየ፡ መዐዛ፡ መስቀል፡ እመዐዛ፡ ቀንሞስ፡ ወዕፀ፡ ፐፒሬ፨</t:l>
                  <t:l n="4">አህጕሎሙ፡ ለአፅራርየ፡ እንተ፡ ኢያድምዑ፡ ኅሬ፨</t:l>
                  <t:l n="5">ከመ፡ እስራኤል፡ ተሀጕሉ፡ በካሕዱ፡ ለቆሬ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="68">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ በስብሐተ፡ አፍአ፡ ወውሣጤ፨</t:l>
                  <t:l n="2">እምኀበ፡ መላእክት፡ አእላፍ፡ ዘይሴባሕ፡ በፊልሙንጤ፨</t:l>
                  <t:l n="3">ዕፀ፡ ፋሲካ፡ መስቀል፡ ሞገሰ፡ በዓላት፡ ጰንጠቈስጤ፨</t:l>
                  <t:l n="4">ይሤኒ፡ ሥነ፡ ሞገስከ፡ እምሥነ፡ ዕንቍ፡ አካጤ፨</t:l>
                  <t:l n="5">ወእምሥነ፡ ሐዋዝ፡ ዕፀ፡ ትንቢት፡ ዘስሙ፡ ኤላጤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="69">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ለእሌኒ፡ ዘአጽሀቃ፨</t:l>
                  <t:l n="2">እስከ፡ ረከበተከ፡ መስቀል፡ ተነ፡ ጢስ፡ ዕጣን፡ ኀበ፡ አጠየቃ፨</t:l>
                  <t:l n="3">ወማዕተበ፡ አርባዕ፡ ከዋክብት፡ ጽላሎተ፡ ዚአከ፡ ማእከለ፡ ጣቃ፨</t:l>
                  <t:l n="4">ቈስጠንጢኖስ፡ ርእየ፡ ነዊሞ፡ ለማየ፡ ባዶስ፡ በሐይቃ፨</t:l>
                  <t:l n="5">ምስለ፡ ዘላዕሌሆን፡ መጽሐፍ፡ እንተ፡ ይብል፡ ጦንጢቃ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="70">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለሞገስከ፡ ትሩፍ፨</t:l>
                  <t:l n="2">እሞገሰነገድ፡ ዘቦኡ፡ ባሕረ፡ ሳፍ፨</t:l>
                  <t:l n="3">በአምሳለ፡ ዚአከ፡ መስቀል፡ ተንከተመ፡ ሰኑይ፡ አጽዳፍ፨</t:l>
                  <t:l n="4">በርእስ፡ ወበዘነብ፡ ወክልኤ፡ አክናፍ፨</t:l>
                  <t:l n="5">እንበለ፡ ይትመስቀል፡ ኢይሰርር፡ ዖፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="71">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘኢይትዔረዮ፡ ሐኖስ፨</t:l>
                  <t:l n="2">ወዘየሐፅፅ፡ ቅድሜሁ፡ ባሕረ፡ ውቅያኖስ፨</t:l>
                  <t:l n="3">ኢይትማሰለከ፡ መስቀል፡ ጽጌ፡ ሴፎኖስ፨</t:l>
                  <t:l n="4">ወዘይሄሉ፡ ካዕበ፡ ላዕለ፡ ደብረ፡ ራእይ፡ ማኖስ፨</t:l>
                  <t:l n="5">ምሥⷃዐ፡ በግዕ፡ እሑር፡ ዕፀ፡ ሥን፡ አብኖስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="72">
                  <t:l n="1">ሰላም፡ ለሞገስከ፡ ዘእግዚአብሔር፡ ባረኮ፨</t:l>
                  <t:l n="2">በከመ፡ ዜነዉነ፡ ዜና፡ እለ፡ ርእዩ፡ ሕዝበ፡ አምልኮ፨</t:l>
                  <t:l n="3">እንዘ፡ በአየራት፡ ትቀውም፡ መስቀለ፡ አምላክ፡ እንበለ፡ አስምኮ፨</t:l>
                  <t:l n="4">በደሴተ፡ ቆጵሮስ፡ ዘየዐውዳ፡ ባሕረ፡ ኢያሪኮ፨</t:l>
                  <t:l n="5">ታስተርኢ፡ እስከ፡ ዮም፡ ወትሴወር፡ አኮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="73">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለሞገስከ፡ መራን፨</t:l>
                  <t:l n="2">ዘይነብር፡ ቦቱ፡ ሞገሰ፡ መስቀል፡ ብርሃን፨</t:l>
                  <t:l n="3">ይደልወከ፡ መስቀል፡ ጠረጴዛ፡ ክርስቶስ፡ ቍርባን፨</t:l>
                  <t:l n="4">እምአፈ፡ እሊአከ፡ ኵሉ፡ በውስተ፡ ኵሉ፡ መካን፨</t:l>
                  <t:l n="5">ስብሐት፡ ወክብር፡ ወሰጊድ፡ ወአሚን፨</t:l>
                  <t:l n="6">ለዓለም፡ ወለዓለመ፡ ዓለም፡ አሜን፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>