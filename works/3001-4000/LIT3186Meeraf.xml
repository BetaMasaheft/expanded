         <t:div type="edition" xml:id="div2LIT3186Meeraf">
            <t:div type="textpart" xml:id="Feasts">
               <t:label>Chants for the office for the vigils and for selected holy days (<t:foreign xml:lang="gez">ዋዜማ፡ ዘሰናበት፡ ወዘበዓላት።</t:foreign>)</t:label>
               <t:div type="textpart" xml:id="JohnTheBaptistVigil">
                  <t:label>Hymn for the vigil of the feast of John the Baptist</t:label>
               </t:div>
               <t:div type="textpart" xml:id="JohnTheBaptist">
                  <t:label>Hymn for the feast of John the Baptist (<t:foreign xml:lang="gez">ዘዮሐንስ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Fruits">
                  <t:label>Hymn for the feast of the Fruits (<t:foreign xml:lang="gez">ዘፍሬ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Cross">
                  <t:label>Hymn for the feast of the Cross (<t:foreign xml:lang="gez">ዘመስቀል፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Flowers">
                  <t:label>Hymn for the feast of the Flowers (<t:foreign xml:lang="gez">ዘጽጌ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="FourBeasts">
                  <t:label>Hymn for the feast of the Four Beasts (<t:foreign xml:lang="gez">ዘ፬እንስሳ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Angels">
                  <t:label>Hymn for the feast of St Michael and the Angels (<t:foreign xml:lang="gez">ዘመላእክት፡ ወዘሚካኤል፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="HeavenlyPriests">
                  <t:label>Hymn for the feast of the Heavenly Priests (<t:foreign xml:lang="gez">ዘካህናት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Righteous1">
                  <t:label>Hymn for the feast of the Righteous (<t:foreign xml:lang="gez">ዘጻድቃን፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Martyrs">
                  <t:label>Hymn for the feast of the Martyrs (<t:foreign xml:lang="gez">ዘሰማዕት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Preach">
                  <t:label>Hymn for the preaching (<t:foreign xml:lang="gez">ዘስብከት፡</t:foreign>), for the first Sunday of Advent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Light">
                  <t:label>Hymn for the feast of the Light (<t:foreign xml:lang="gez">ዘብርሃን፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Shepherd">
                  <t:label>Hymn for the feast of the Shepherd (<t:foreign xml:lang="gez">ዘኖላዊ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Christmas">
                  <t:label>Hymn for Christmas (<t:foreign xml:lang="gez">ዘልደት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="BaptismHymn">
                  <t:label>Hymn for the feast of Baptism (<t:foreign xml:lang="gez">ዘጥምቀት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Fast">
                  <t:label>Hymn for the Beginning of the Fast (<t:foreign xml:lang="gez">ዘቀበላ፡ [ጾም፡]</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="HolySunday">
                  <t:label>Hymn for the Holy Sunday (<t:foreign xml:lang="gez">ዘቅድስት፡</t:foreign>), i.e. the second of Lent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Temple">
                  <t:label>Hymn for the Sunday of the Temple (<t:foreign xml:lang="gez">ዘምኵራብ፡</t:foreign>), i.e. the third of Lent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Paralytic">
                  <t:label>Hymn for the Sunday of the Paralytic (<t:foreign xml:lang="gez">ዘመፃጕዕ፡</t:foreign>), i.e. the fourth of Lent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="MountOfOlives">
                  <t:label>Hymn for the Sunday of the Mount of Olives (<t:foreign xml:lang="gez">ዘደብረ፡ ዘይት፡</t:foreign>), i.e. the fifth of Lent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="GoodServantNicodemus">
                  <t:label>Hymn for the Sunday of the Good Servant and Nicodemus (<t:foreign xml:lang="gez">ዘገብር፡ ኄር፡ ወዘኒቆዲሞስ፡</t:foreign>), i.e. the sixth and seventh Sundays of Lent</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Palm">
                  <t:label>Hymn for the Palm Sunday (<t:foreign xml:lang="gez">ዘሆሳዕና፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Resurrection">
                  <t:label>Hymn for the feast of Resurrection (<t:foreign xml:lang="gez">ዘትንሣኤ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="BirthOfMary">
                  <t:label>Hymn for the feast of the Birth of Mary (<t:foreign xml:lang="gez">ዘልደታ [ለማርያም]፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="AscensionDay">
                  <t:label>Hymn for the Ascension Day (<t:foreign xml:lang="gez">ዘዕርገት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Paraclete">
                  <t:label>Hymn for the feast of the Paraclete (<t:foreign xml:lang="gez">ዘጰራቅሊጦስ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Apostles">
                  <t:label>Hymn for the feast of the Apostles (<t:foreign xml:lang="gez">ዘሐዋርያት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Winter">
                  <t:label>Hymn for the feast of winter (<t:foreign xml:lang="gez">ዘክረምት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Cyriacus">
                  <t:label>Hymn for the feast of St Cyriacus (<t:foreign xml:lang="gez">ዘቂርቆስ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="AbbaSalama">
                  <t:label>Hymn for the feast of ʾAbbā Salāmā (<t:foreign xml:lang="gez">ዘአባ፡ ሰላማ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Women">
                  <t:label>Hymn for the feast of the Women (<t:foreign xml:lang="gez">ዘአንስት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Congregation">
                  <t:label>Hymn for the feast of the congregation on Mount Tabor (<t:foreign xml:lang="gez">ዘማኅበር፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Firstborn">
                  <t:label>Hymn for the feast of the firstborn </t:label>
               </t:div>
               <t:div type="textpart" xml:id="Transfiguration">
                  <t:label>Hymn for the feast of the Transfiguration on Mount Tabor (<t:foreign xml:lang="gez">ዘደብረ፡ ታቦር፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="DeathOfMary">
                  <t:label>Hymn for the feast of the Death of Mary (<t:foreign xml:lang="gez">ዘፍልሰታ፡ [ለማርያም፡]</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Virgins">
                  <t:label>Hymn for the feast of the Virgins (<t:foreign xml:lang="gez">ዘማርያም፡ ወደናግል፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Abraham">
                  <t:label>Hymn for the feast of Abreham (<t:foreign xml:lang="gez">ዘአብርሃም፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Sabbath">
                  <t:label>Hymn for the sabbaths and the common feasts (<t:foreign xml:lang="gez">ዘሰንበት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Christmas2">
                  <t:label>Hymn for the vigil of Christmas (<t:foreign xml:lang="gez">ጌና፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Righteous2">
                  <t:label>Hymn for the feast of the Righteous</t:label>
               </t:div>
            </t:div>
            <t:div type="textpart" xml:id="Weekdays">
               <t:label>Chants for the office for the vigils of the weekdays (<t:foreign xml:lang="gez">ዋዜማ፡ ዘዘወትር።</t:foreign>)</t:label>
               <t:div type="textpart" xml:id="Monday">
                  <t:label>Chants for Monday evening (<t:foreign xml:lang="gez">ዘሰኑይ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Tuesday">
                  <t:label>Chants for Tuesday evening (<t:foreign xml:lang="gez">ዘሠሉስ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Wednesday">
                  <t:label>Chants for Wednesday evening (<t:foreign xml:lang="gez">ዘረቡዕ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Thursday">
                  <t:label>Chants for Thursday evening (<t:foreign xml:lang="gez">ዘኀኑስ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Friday">
                  <t:label>Chants for Friday evening (<t:foreign xml:lang="gez">ዘዐርብ፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="SaturdayM">
                  <t:label>Chants for Saturday morning (<t:foreign xml:lang="gez">ዘቀዳሚት፡ ሰንበት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="SaturdayE">
                  <t:label>Chants for Saturday evening (<t:foreign xml:lang="gez">ዘቀዳሚት፡ ሰንበት፡</t:foreign>)</t:label>
               </t:div>
               <t:div type="textpart" xml:id="Sunday">
                  <t:label>Chants for Sunday evening</t:label>
               </t:div>
            </t:div>

            <t:div type="textpart" xml:id="Mastabeqwe">
               <t:label>
                  <t:foreign xml:lang="gez">ዘዘወትር፡ ዕዝል፡ መስተብቍዕ፡</t:foreign>
               </t:label>
            </t:div>
            <t:div type="textpart" xml:id="MawaddesS" corresp="https://betamasaheft.eu/LIT1989mawadd">
               <t:label>Chants for the office of Sundays <t:foreign xml:lang="gez">መወድስ፡</t:foreign>
               </t:label>
            </t:div>
            <t:div type="textpart" xml:id="Kestat" corresp="https://betamasaheft.eu/LIT1714Kestat">
               <t:label>Chants of the Revelation of ʾaryām <t:foreign xml:lang="gez">ክሥተት፡ ዘአርያም፡</t:foreign>
               </t:label>
            </t:div>
            <t:div type="textpart" xml:id="Sebhat" corresp="https://betamasaheft.eu/LIT2301Sebhat">
               <t:label>Chants for the office of the Morning Praise <t:foreign xml:lang="gez">ስብሐተ፡ ነግህ፡</t:foreign>
               </t:label>
            </t:div>

            <t:div type="textpart" xml:id="Lent">
               <t:label>Chants for the office of Lent <t:foreign xml:lang="gez">ዘመዋዕለ፡ አጽዋም፡</t:foreign></t:label>
               <t:div type="textpart" xml:id="FirstWeekLent">
                  <t:label>Chants for the first week of Lent (of Moses)</t:label>
                  <t:div type="textpart" xml:id="FirstWeekMo">
                     <t:label>Chant for the first Monday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="FirstWeekTu">
                     <t:label>Chant for the first Tuesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="FirstWeekWe">
                     <t:label>Chant for the first Wednesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="FirstWeekTh">
                     <t:label>Chant for the first Thursday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="FirstWeekFr">
                     <t:label>Chant for the first Friday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="FirstWeekSa">
                     <t:label>Chant for the first Saturday of Lent</t:label>
                  </t:div>
               </t:div>
               <t:div type="textpart" xml:id="SecondWeekLent">
                  <t:label>Chants for the second week of Lent (of the Holy [Day])</t:label>
                  <t:div type="textpart" xml:id="SecondWeekMo">
                     <t:label>Chant for the second Monday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="SecondWeekTu">
                     <t:label>Chant for the second Tuesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="SecondWeekWe">
                     <t:label>Chant for the second Wednesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="SecondWeekTh">
                     <t:label>Chant for the second Thursday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="SecondWeekFr">
                     <t:label>Chant for the second Friday of Lent</t:label>
                  </t:div>
               </t:div>
               <t:div type="textpart" xml:id="ThirdWeekLent">
                  <t:label>Chants for the third week of Lent (of the Temple)</t:label>
                  <t:div type="textpart" xml:id="ThirdWeekMo">
                     <t:label>Chant for the third Monday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="ThirdWeekTu">
                     <t:label>Chant for the third Tuesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="ThirdWeekWe">
                     <t:label>Chant for the third Wednesday of Lent</t:label>
                  </t:div>
                  <t:div type="textpart" xml:id="ThirdWeekTh">
