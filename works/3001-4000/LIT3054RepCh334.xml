         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">እምዮሐንስ፡ እስከ፡ ዮሐንስ፡ ለለ፡ ይገውሕ፡ ብሔር፨</t:l>
                  <t:l n="2">አንብብዋኬ፡ ተዐይነ፡ ሰማይ፡ ወምድር፨</t:l>
                  <t:l n="3">ለማሕሌተ፡ ጻድቃን፡ ዛቲ፡ ከመ፡ ስንክሳር፨</t:l>
                  <t:l n="4">አኮኑ፡ ይኄይስ፡ ወጥቀ፡ ይትበደር፨</t:l>
                  <t:l n="5">ዘልፋ፡ ክሡት፡ እምክቡት፡ ፍቅር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ለጻድቃን፡ ዕደው፡ ንወድሶሙ፡ በእሪና፨</t:l>
                  <t:l n="2">እለ፡ አሥመዩ፡ ስመ፡ በበ፡ መዋዕሊሆሙ፡ መዋዕለ፡ ዜና፨</t:l>
                  <t:l n="3">እንዘ፡ አልቦቱ፡ አእጋረ፡ ወጽንፈ፡ መልክእ፡ ሰኰና፨</t:l>
                  <t:l n="4">ለወድሶቶሙሰ፡ በአምሳለ፡ ቀሊል፡ ደመና፨</t:l>
                  <t:l n="5">ይረውጽ፡ ልብ፡ ወየዐውድ፡ ኅሊና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">በስመ፡ እግዚአብሔር፡ አምላክ፡ እንተ፡ አምጽአ፡ ብርሃነ፨</t:l>
                  <t:l n="2">ለአርእዮ፡ ሥርዓት፡ ዐቢይ፡ ወለከሢተ፡ ግብር፡ ዘኮነ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ እስመ፡ ሥመርኩክሙ፡ አነ፨</t:l>
                  <t:l n="4">በሉኒ፡ ነዓ፡ ወትሉ፡ ኪያነ፨</t:l>
                  <t:l n="5">ኅድጎሙ፡ ለሙታን፡ ይቅብሩ፡ ሙታነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለፅንሰትክሙ፡ በሩካቤ፡ ሰብሳብ፡ ንጹሕ፨</t:l>
                  <t:l n="2">ለረኪበ፡ ተስፋ፡ ድልው፡ ወለዕሤተ፡ ጽድቅ፡ ጽኑሕ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ዘክፍልክሙ፡ ስቡሕ፨</t:l>
                  <t:l n="4">ይስርቅ፡ በልብየ፡ ዘሕገ፡ ጽድቅክሙ፡ በርህ፨</t:l>
                  <t:l n="5">መንፈቀ፡ ሳብዕ፡ እድ፡ ከመ፡ ይስርቅ፡ ወርኅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለልደትክሙ፡ መንታ፨</t:l>
                  <t:l n="2">ዘሥጋ፡ አሐቲ፡ ወዘመንፈስ፡ ቅዱስ፡ ካልእታ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ብዙኃን፡ ሐሳብ፡ ወጾታ፨</t:l>
                  <t:l n="4">አቅሙኒ፡ ኀበ፡ ቆምክሙ፡ አመ፡ ይከውን፡ ሐተታ፨</t:l>
                  <t:l n="5">በዕለተ፡ ዕለታት፡ ዋሕድ፡ ዘአልቦ፡ ሳኒታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለአስማቲክሙ፡ እንበለ፡ ተፈልጦ፡ ወኵፋሌ፨</t:l>
                  <t:l n="2">እለ፡ ተጽሕፋ፡ ኅቡረ፡ ውስተ፡ አርያማዊት፡ ጽሌ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ እለ፡ እገሊት፡ ወእለ፡ እገሌ፨</t:l>
                  <t:l n="4">አዕድው፡ ኪያየ፡ እምባሕረ፡ ትካዝ፡ ወወይሌ፨</t:l>
                  <t:l n="5">በአስተምሕሮታት፡ ዓሥር፡ ወአርባዕ፡ ትንባሌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለሥዕርትክሙ፡ ለለ፡ አሐቲ፡ አሐቲ፨</t:l>
                  <t:l n="2">ዘኢትወድቅ፡ ለዝሉፉ፡ ውስተ፡ ምድር፡ ዛቲ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ አዝዝዋ፡ ላቲ፨</t:l>
                  <t:l n="4">ለነፍስየ፡ ፍቅርትክሙ፡ ለባሲተ፡ ሥጋ፡ መዋቲ፨</t:l>
                  <t:l n="5">ፍሬ፡ ምግባረ፡ ጽድቅ፡ ትለድ፡ ወአኮ፡ ትበስቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="51">
                  <t:l n="1">ሰላም፡ ለመልክእክሙ፡ ለለ፡ አሐዱ፡ አሐዱ፨</t:l>
                  <t:l n="2">በበ፡ ኍላቌሁ፡ ወፍቅዱ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ለኂሩትክሙ፡ ከመ፡ ልማዱ፨</t:l>
                  <t:l n="4">ቅድሳተክሙ፡ ለከለባት፡ ኢተሀቡ፡ ይኂዱ፨</t:l>
                  <t:l n="5">ወባሕርየክሙ፡ አኅርው፡ ይኪዱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለኵሎን፡ መልክእክሙ፨</t:l>
                  <t:l n="2">በበ፡ መሌሊቱ፡ ወስሙ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ወዘማርያም፡ እሙ፨</t:l>
                  <t:l n="4">እክለ፡ ማሕሌት፡ እንተ፡ አቅረብኩ፡ ለክሙ፨</t:l>
                  <t:l n="5">እንበለ፡ ትሕትቱ ኅቡረ፡ ጣዕሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለመልክእክሙ፡ ዘተከድነ፨</t:l>
                  <t:l n="2">ገርዜነ፡ ንጽሕ፡ ጽጉየ፡ ወዘቅድስና፡ ሰንዱነ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ጻድቃን፡ በሉኒ፡ ድሜጥሮስ፡ ወልድነ፨</t:l>
                  <t:l n="4">ለምንትኑ፡ እንዘ፡ ሀሎናከ፡ ንሕነ፨</t:l>
                  <t:l n="5">ውስተ፡ ትፍሥሕትከ፡ ታበውዕ፡ ኀዘነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="56">
                  <t:l n="1">ሰላም፡ ለግንዘትክሙ፡ በዘዘ፡ ዚአሁ፡ አልባስ፨</t:l>
                  <t:l n="2">እንዘ፡ ይላህውክሙ፡ ላሐ፡ ደቂቀ፡ ክርስቶስ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ጻድቃን፡ ንዑ፡ ኀበ፡ ትጸንሐክሙ፡ ነፍስ፨</t:l>
                  <t:l n="4">ተጽዒነክሙ፡ መልዕልተ፡ ጸዐድው፡ አፍራስ፨</t:l>
                  <t:l n="5">እማኅደርክሙ፡ ማኅደር፡ ቅዱስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="58">
                  <t:l n="1">ሰላም፡ ለትንሣኤክሙ፡ በዘይትፈቀድ፡ ጊዜ፨</t:l>
                  <t:l n="2">ለነሢአ፡ ትፍሥት፡ ክቡድ፡ ዘኢይቀርቦ፡ ትካዜ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ዘትካት፡ ወዘይእዜ፨</t:l>
                  <t:l n="4">አይድዑኒኬ፡ ለአይ፡ ወለማእዜ፨</t:l>
                  <t:l n="5">ዘሰማዕክሙ፡ ሊተ፡ ይውሕዝ፡ ተከዜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="59">
                  <t:l n="1">ሰላም፡ ለቀዊሞትክሙ፡ ሶበ፡ ተጸዋዕክሙ፡ ስመ፨</t:l>
                  <t:l n="2">እምድኅረ፡ ተንሣእክሙ፡ በሥጋ፡ ኀበ፡ በድንክሙ፡ ኖመ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ጻድቃን፡ አባግዕ፡ ዘአልብክሙ፡ ድካመ፨</t:l>
                  <t:l n="4">ክፍሉኒኬ፡ ምስሌክሙ፡ በየማነ፡ ንጉሥ፡ ቀዊመ፨</t:l>
                  <t:l n="5">አመ፡ ይቀውሙ፡ አጣሌ፡ ፀጋመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="60">
                  <t:l n="1">ሰላም፡ ለዕሤትክሙ፡ ዘዐይን፡ ኢርእዮ፨</t:l>
                  <t:l n="2">እዝን፡ ኢስምዖ፡ ወኅሊና፡ ልብ፡ ዘኢኀለዮ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ኪያሁ፡ እስከ፡ ትሁቡኒ፡ በኢያንክዮ፨</t:l>
                  <t:l n="4">ነዮ፡ ነዮ፡ እስእለክሙ፡ ነዮ፨</t:l>
                  <t:l n="5">ከመ፡ ብእሲ፡ ርኁብ፡ ይስእል፡ ሲሳዮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="61">
                  <t:l n="1">ሰላም፡ ለኍልቌክሙ፡ ዘእጓለ፡ እመሕያው፡ ኢይክሎ፨</t:l>
                  <t:l n="2">ከመ፡ ይንግር፡ በተሀብሎ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ጻድቃን፡ ኅቡረ፡ በኢታንትሎ፨</t:l>
                  <t:l n="4">ተራኅርኁ፡ ሊተ፡ በኵሉ፡ ተረፈ፡ ሕይወትየ፡ ኵሎ፨</t:l>
                  <t:l n="5">እስመ፡ ልበ፡ ክርስቶስ፡ ርኅሩኅ፡ ላዕሌክሙ፡ ሀሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="62">
                  <t:l n="1">ሰላም፡ ለረድኤትክሙ፡ ውስተ፡ ቤተ፡ ባዕል፡ ወነዳይ፨</t:l>
                  <t:l n="2">ዘይሔውጽ፡ ዘልፈ፡ ከመ፡ እግረ፡ ጽዱል፡ ፀሓይ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ አብዕልተ፡ ሰማይ፨</t:l>
                  <t:l n="4">ኅድጉሰ፡ በዘመጠነ፡ ዝ፡ ንዋይ፨</t:l>
                  <t:l n="5">ብዕለ፡ ጽድቅ፡ ብዙኅ፡ ይትረከብ፡ በሰማይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="63">
                  <t:l n="1">ሰላም፡ ለተኣምሪክሙ፡ ለሕዝበ፡ አረሚ፡ ወአይሁድ፨</t:l>
                  <t:l n="2">ዘይመይጦሙ፡ ወትረ፡ መንገለ፡ አሚን፡ እምካሕድ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ ውስተ፡ ፍና፡ ኄራን፡ ዘመድ፨</t:l>
                  <t:l n="4">እንዘ፡ የሐውር፡ ኵሉ፡ ኀበ፡ መካነ፡ ሞት፡ ዋሕድ፨</t:l>
                  <t:l n="5">ምንት፡ ፍድፉዴሁ፡ ለጠቢብ፡ እምአብድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="64">
                  <t:l n="1">ሰላም፡ ለህላዌክሙ፡ በኢየሩሳሌም፡ ዘላዕሉ፨</t:l>
                  <t:l n="2">ዐይነ፡ አንስርት፡ ኀበ፡ አንጽሮቶ፡ ኢይክሉ፨</t:l>
                  <t:l n="3">ማኅበረ፡ ኢየሱስ፡ ክርስቶስ፡ ጻድቃን፡ ክሉ፨</t:l>
                  <t:l n="4">በሉኒ፡ ለለ፡ አሐዱ፡ እስመ፡ ይረትዕ፡ ወይደሉ፨</t:l>
                  <t:l n="5">በከዊነ፡ ዐርከ፡ ወቢጽ፡ ምስሌነ፡ ተሀሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="65">
                  <t:l n="1">ማኅበረ፡ ክርስቶስ፡ ጻድቃን፡ አልቦ፡ አልቦ፨</t:l>
                  <t:l n="2">ለውዳሴክሙ፡ ኆፃ፡ እንተ፡ ይፌጽም፡ መክብቦ፨</t:l>
                  <t:l n="3">ዘይፈቅድ፡ ብእሲ፡ በአስተሐምሞ፡ ወበአስተርክቦ፨</t:l>
                  <t:l n="4">እመሰ፡ አእምሮ፡ ተውህቦ፨</t:l>
                  <t:l n="5">ከዋክብተ፡ ሰማይ፡ ኍልቈ፡ ወለዝናም፡ ነጥቦ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>