         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3067RepCh347">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">እስመ፡ ብዙኃን፡ እሙንቱ፡ እለ፡ አኀዙ፡ ይጽሐፉ፨</t:l>
                  <t:l n="2">ሃይማኖተ፡ ቅድስት፡ ሥላሴ፡ እንተ፡ ተሳተፉ፨</t:l>
                  <t:l n="3">መጽሐፈ፡ ማሕሌት፡ ሠናየ፡ ዘእለ፡ አትረፉ፨</t:l>
                  <t:l n="4">ከመ፡ እስብክ፡ አንሰ፡ ወእንግር፡ ለዝሉፉ፨</t:l>
                  <t:l n="5">አናቅጸ፡ ስብሐት፡ አርባዕ፡ ቅድሜየ፡ ይኅልፉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለህላዌክሙ፡ ዘኢይትዐወቅ፡ ጥንቱ፨</t:l>
                  <t:l n="2">ወዘኢይትአመር፡ ተፍጻሜቱ፨</t:l>
                  <t:l n="3">ሥሉስ፡ ቅዱስ፡ ዘኢትመውቱ፨</t:l>
                  <t:l n="4">እንዘ፡ ሠለስቱ፡ አሐዱ፡ ወእንዘ፡ አሐዱ፡ ሠለስቱ፨</t:l>
                  <t:l n="5">ለዕበይክሙ፡ ፍጻሜ፡ አልቦቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እግዚአብሔር፡ አብ፨</t:l>
                  <t:l n="2">ወላዴ፡ ወልድ፡ ዋሕድ፡ እንበለ፡ ካዕብ፨</t:l>
                  <t:l n="3">እምቅድመ፡ ሰማያት፡ ርቡብ፡ ወእምቅድመ፡ ዓለም፡ ርኂብ</t:l>
                  <t:l n="4">ይገኒ፡ ለዝክረ፡ ስምከ፡ ኀልዮተ፡ ኵሉ፡ አልባብ፨</t:l>
                  <t:l n="5">ወበአፈ፡ ኵሉ፡ ፍጥረት፡ ዘሀሎ፡ ንባብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እግዚአብሔር፡ ወልድ፨</t:l>
                  <t:l n="2">ለእግዚአብሔር፡ አቡከ፡ ወአኮ፡ ለባዕድ፨</t:l>
                  <t:l n="3">ልደትከሰ፡ ዘምነደ፡ እሳት፡ ነድ፨</t:l>
                  <t:l n="4">በምሥጢር፡ ሐዲስ፡ እንበለ፡ ሕገ፡ እም፡ ዘልማድ፨</t:l>
                  <t:l n="5">ለዝክረ፡ ስምከ፡ ይደሉ፡ ሰጊድ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እግዚአብሔር፡ ጰራቅሊጦስ፨</t:l>
                  <t:l n="2">ኅሊና፡ ልቡ፡ ለክርስቶስ፨</t:l>
                  <t:l n="3">ወዘነበርከ፡ በርእሱ፡ ርግበ፡ ዮርዳኖስ፨</t:l>
                  <t:l n="4">ይገንዩ፡ ለስብሐቲከ፡ ወለስምከ፡ ቅዱስ፨</t:l>
                  <t:l n="5">ከናፍረ፡ ኵሉ፡ መንፈስ፡ ወኵሉ፡ ዘነፍስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ በበ፡ ህላዌሁ፡ ወገጹ፨</t:l>
                  <t:l n="2">አስማተ፡ ቅድስት፡ ሥላሴ፡ ዘኢተሐፅፁ፨</t:l>
                  <t:l n="3">ለሰይጣን፡ ዕድውየ፡ ወለመልአከ፡ ሞት፡ ቢጹ፨</t:l>
                  <t:l n="4">ዘይበረብሮሙ፡ ስረተ፡ ግርማሁ፡ ወድምፁ፨</t:l>
                  <t:l n="5">እምቀስተ፡ አፉየ፡ ኢይሰስል፡ ሐፁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለሥዕርትክሙ፡ ዘይመስል፡ ጸዐድዒዶ፨</t:l>
                  <t:l n="2">ብዙተ፡ ፀምረ፡ እንበለ፡ ተብዕዶ፨</t:l>
                  <t:l n="3">ሥሉስ፡ ቅዱስ፡ ህልዋን፡ በተዋሕዶ፨</t:l>
                  <t:l n="4">ለሥዕርተ፡ ርእስየ፡ ዘተከልክሙ፡ ወፈጠርክሙ፡ ሙላዶ፨</t:l>
                  <t:l n="5">እንዘ፡ ትዌስኑ፡ ኍልቆሁ፡ ወፍቅዶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="54">
                  <t:l n="1">ሰላም፡ ለመልክእክሙ፡ አምሳሉ፡ ወራእዩ፨</t:l>
                  <t:l n="2">ለቤተ፡ ምጥማቅ፡ አሐዱ፡ ዘሠላስ፡ ሙሐዘ፡ ማዩ፨</t:l>
                  <t:l n="3">ሥሉስ፡ ቅዱስ፡ ለእጓለ፡ እመሕያው፡ ዕበዩ፨</t:l>
                  <t:l n="4">ውስተ፡ ዮርዳኖስ፡ ለነቅዐ፡ ጥምቀት፡ ሙዳዩ፨</t:l>
                  <t:l n="5">ለሥላሴክሙ፡ ተዐውቀ፡ አያዩ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="55">
                  <t:l n="1">ሰላም፡ ለመልክእክሙ፡ መልክአ፡ ኵሉ፡ መዋኢ፨</t:l>
                  <t:l n="2">ወዘባሕርዪሁ፡ እንዳዒ፨</t:l>
                  <t:l n="3">ሥላሴክሙ፡ አብርሃም፡ እንዘ፡ በትንቢቱ፡ ያርኢ፨</t:l>
                  <t:l n="4">ይቤላ፡ ለሳራ፡ ተንሥኢ፡ ተንሥኢ፨</t:l>
                  <t:l n="5">መሣልሰ፡ መስፈርት፡ ዘስንዳሌ፡ ሠለስተ፡ አብሕኢ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="56">
                  <t:l n="1">ሰላም፡ ለመልክእክሙ፡ እምአፈ፡ ቀሳውስት፡ ዘተሰብከ፨</t:l>
                  <t:l n="2">ጊዜ፡ ይሴብሑ፡ ወይብሉ፡ ንሤልስ፡ ለከ፨</t:l>
                  <t:l n="3">ዘንተ፡ ስብሐተ፡ እምአፉነ፡ ዘምስለ፡ መንግሥትከ፨</t:l>
                  <t:l n="4">ሥሉስ፡ ቅዱስ፡ በሉኒ፡ እንከ፨</t:l>
                  <t:l n="5">ኪያነ፡ ጸልአ፡ ዘጸልአ፡ ኪያከ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="57">
                  <t:l n="1">ሰላም፡ ለባሕርይክሙ፡ እንዘ፡ ይነብር፡ አርያመ፨</t:l>
                  <t:l n="2">በተዋሕዶ፡ ወትሥልስት፡ እንተ፡ ይኴንን፡ ዓለመ፨</t:l>
                  <t:l n="3">ሥሉስ፡ ቅዱስ፡ በሥምረትክሙ፡ ክመ፨</t:l>
                  <t:l n="4">ሥላሴክሙ፡ ለኵሉ፡ ተዐውቀ፡ ፍጽሙ፨</t:l>
                  <t:l n="5">በምድረ፡ ዮርዳኖስ፡ ቅድመ፡ ወበታቦር፡ ዳግመ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="58">
                  <t:l n="1">ሰላም፡ ለመለኮክሙ፡ ዘውእቱ፡ ንግሥ፨</t:l>
                  <t:l n="2">አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፨</t:l>
                  <t:l n="3">እንዘ፡ ሀሎ፡ አብርሃም፡ ታሕተ፡ ዕፀ፡ ድርስ፨</t:l>
                  <t:l n="4">አስተርአይክምዎ፡ በሰዓተ፡ ዕለት፡ ሳድስ፨</t:l>
                  <t:l n="5">በሠርቀ፡ ራብዕ፡ ወርኅ፡ ወአኮ፡ ኃምስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="59">
                  <t:l n="1">ሰላም፡ ለምሕረትክሙ፡ በከመ፡ መጻሕፍት፡ ይነቡ፨</t:l>
                  <t:l n="2">እስከ፡ ይትፌሣሕ፡ ቦቱ፡ ለብእሴ፡ ኃጢአት፡ ልቡ፨</t:l>
                  <t:l n="3">በላዕለ፡ ኵሉ፡ ሥላሴ፡ አክናፈ፡ ምሕረት፡ ትረቡ፨</t:l>
                  <t:l n="4">አኮኑ፡ ኦሪት፡ ሥላሴክሙ፡ ታሌቡ፨</t:l>
                  <t:l n="5">ማኅበረ፡ አይሁድ፡ አብዳን፡ ማእዜኑ፡ ይበጡ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="60">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለተዋሕዶ፡ ቅድስት፡ ሥላሴ፨</t:l>
                  <t:l n="2">ቀዊምየ፡ ቅድመ፡ ሥላሴ፨</t:l>
                  <t:l n="3">እንበለ፡ ናፍቆ፡ ኣአምን፡ ህላዌ፡ ሥላሴ፨</t:l>
                  <t:l n="4">ግጻዌሆሙ፡ ሥላሴ፡ ወአካሎሙ፡ ሥላሴ፨</t:l>
                  <t:l n="5">ወቅዳሴሆሙ፡ ከማሁ፡ ሥላሴ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>