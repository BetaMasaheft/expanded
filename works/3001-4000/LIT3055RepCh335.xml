      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl>
               <t:bibl corresp="http://zotero.org/groups/358366/items/7WA33SUX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Chaine1913Rep"/><title level="a">Répertoire des Salam et Malkeʾe contenus dans les manuscrits éthiopiens des bibliothèques d’Europe</title><title level="j">Revue de l’Orient Chrétien</title><author><forename>Marius</forename><surname>Chaîne</surname></author><date>1913</date><biblScope unit="volume">18</biblScope><biblScope unit="issue">2 and 18/4 (Deuxième série, 8/2 and 8/4)</biblScope><biblScope unit="page">183–203 and 337–357</biblScope><note type="url">http://catholicapedia.net/Documents/Revue-de-l.Orient-chretien/18-1913_revue-de-l.orient-ch_paris.pdf</note><note type="tags"><note type="tag">bm:Chaine1913Rep</note></note><note type="tag">bm:Chaine1913Rep</note><t:citedRange unit="item">335</t:citedRange></t:bibl>
            </t:listBibl>
         </t:div>
         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3055RepCh335"><t:note>from <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">እሰግድ፡ ለመለኮትከ፡ እንተ፡ ፈጠርከ፡ ጽልመተ፨</t:l>
                  <t:l n="2">እምቀድመ፡ ብርሃነ፡ ትግበር፡ ወታሰተባሪ፡ መዓልተ፨</t:l>
                  <t:l n="3">እግዚአብሔር፡ አሐዱ፡ እንተ፡ ኢኮንከ፡ ክልኤተ፨</t:l>
                  <t:l n="4">በስምዕ፡ ይሰምዩከ፡ ሠለስተ፨</t:l>
                  <t:l n="5">እንዘ፡ በመለኮት፡ ዋሕድ፡ ወብሁት፡ አንተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">እሰግድ፡ ለመለኮትከ፡ ዘሣረርከ፡ ምድረ፨</t:l>
                  <t:l n="2">ለእጓለ፡ እመሕያው፡ ይኩን፡ ወለእንስሳ፡ ማኅደረ፨</t:l>
                  <t:l n="3">እግዚአብሔር፡ ገባሪ፡ ዘእንበለ፡ ትኅሥሥ፡ ምክረ፨</t:l>
                  <t:l n="4">ትጸውር፡ ድደ፡ በኀይልከ፡ እንዘ፡ ትነብር፡ ጠፈረ፨</t:l>
                  <t:l n="5">ወእንዘ፡ ተሐንጽ፡ መሠረተ፡ ትፄዐን፡ ቀመረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="99">
                  <t:l n="1">ስብሐት፡ ለከ፡ እግዚአብሔር፡ ለለ፡ ሠርቀ፡ ዕለት፡ ወለያልይ፨</t:l>
                  <t:l n="2">ስብሐት፡ ለከ፡ እግዚአብሔር፡ በተባርዮ፡ ክረምት፡ ወሐጋይ፨</t:l>
                  <t:l n="3">ስብሐት፡ ለከ፡ እግዚአብሔር፡ በወርኀ፡ መጸው፡ ወጸደይ፨</t:l>
                  <t:l n="4">ስብሐት፡ ለከ፡ እግዚአብሔር፡ በኍልቈ፡ ኵሉ፡ ዘይትረአይ፡ ወኢይትረአይ፨</t:l>
                  <t:l n="5">ስብሐተ፡ ቅድምናከ፡ ዘልፈ፡ ይነግር፡ ሰማይ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
         <t:div type="edition" xml:id="add16215">
            <t:note>The text of the first stanza is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/BLadd16215">London, British Library, BL Additional 16215</t:ref>,
               the first two verses of the remaining stanzae are taken from <t:ref type="mss" corresp="https://betamasaheft.eu/ESmr001">Gulo Maḵadā, Mǝdra Rubā Sǝllase, MR-001</t:ref>.</t:note>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza1">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ለዘፈጠርከ፡ ጽልመተ።
                  <t:lb n="2"/>እምቅድመ፡ ብርሃን፡ ትግበር፡ ወታስተባሪ፡ መዓልተ።
                  <t:lb n="3"/>እግዚአብሔር፡ ፩እንተ፡ ኮንከ፡ ፪ተ።
                  <t:lb n="4"/>በስምሰ፡ ይሰመዩ፡ ፫ተ።
                  <t:lb n="5"/>እንዘ፡ በመለኮት፡ ዋህድ፡ ወብሁት፡ አንተ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza2">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘሠረርከ፡ ምድረ፡ 
                  <t:lb n="2"/>ለእጓለ፡ እመሕያው፡ ትኩን፡ ወለእንስሳ፡ ማኅደረ፡
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza3">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘፈጠርከ፡ ነፋስ፡ 
                  <t:lb n="2"/>ወቦቱ፡ ረሰይከ፡ ለጠባይዓ፡ ማይ፡ ቅዱስ፡
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza4">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ገባሬ፡ መላእክት፡ ለተደሞ፡ 
                  <t:lb n="2"/>ወምስሌሆሙ፡ ፯ተ፡ እንበለ፡ ነቢብ፡ ወአርምሞ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza5">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እንተ፡ ገበርከ፡ ቀዳሚ፡
                  <t:lb n="2"/>አርኣያ፡ ኅቡዓ፡ ወባሕርየ፡ ምሥጢር፡ ኢተተርጓሚ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza6">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ኅቡዓት፡ ድኅረ፡ ተፈጥሩ።
                  <t:lb n="2"/>ብርሃነ፡ ይኩኑ፡ ዘትቤ፡ ወይጻእ፡ እማኅደሩ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza7">
               <t:note>The first version is the one found in <t:ref type="mss" corresp="https://betamasaheft.eu/ESmr001">Gulo Maḵadā, Mǝdra Rubā Sǝllase, MR-001</t:ref>, 
               the second one the one found in <t:ref type="mss" corresp="https://betamasaheft.eu/FSUor133">Frankfurt, Universitätsbibliothek Johann Christian Senckenberg, Frankfurt Ms. or. 133</t:ref>, which seems more correct.</t:note>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ በሰዓተ፡ ሌሊት፡ ዘፈጠረ፡ ይኩን፡ ዘትቤ፡ እንዘ፡ ትከፍሎ፡ ለማይ።
           </t:ab>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ በሰዓተ፡ ሌሊት፡ ዘሰኑይ፡
                  <t:lb n="2"/>ጠፈረ፡ ይኩን፡ ዘትቤ፡ እንዘ፡ ትከፍሎ፡ ለማይ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza8">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘአስተጋባዕኮ፡ ከመ፡ ዝቅ፡ 
                  <t:lb n="2"/>ለማይ፡ ውቅያኖስ፡ እምድር፡ ውስተ፡ ምዕላዲሁ፡ እሙቅ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza9">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡  ከመ፡ ቅጽበተ፡ ዓይን፡ ዘፈጠረ።
                  <t:lb n="2"/>አስተጋብአ፡ ማይ፡ ስፉሐ፡ ድኅረ፡ አጽናፊ፡ ምድር፡ እስጠመ፡
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza10">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘበኂሩትከ፡ በቈሉ፡ 
                  <t:lb n="2"/>ዘመደ፡ ዕፀዋት፡ ወሣዕር፡ ምግቦተ፡ ሥጋ፡ ዘይክሉ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza11">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እንተ፡ ተከልካ፡ በምሥራቅ፡
                  <t:lb n="2"/>ኤዶምሃ፡ ገነተ፡ ተድላ፡ ወጽድቅ።
               </t:ab> 
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza12"> 
               <t:ab> 
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ በሚሰተ፡ ረቡዕ፡ ዘአርአየ።
                  <t:lb n="2"/>መንገለ፡ ወርኃ፡ ገኃኅ፡ ወመንገለ፡ ምዕራብ፡ ፀሐየ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza13">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘለሊከ፡ ሣረርከ፡ 
                  <t:lb n="2"/>እምነ፡ ማይ፡ ወነፋስ፡ ዘከዋክብት፡ ፈለይከ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza14">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ገብርከ፡ ወርኃ፡ በዕድሜሁ።
                  <t:lb n="2"/>ፀሐይነ፡ አዕመረ፡ ምዕራቢሁ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza15">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘፈጠርከ፡ በሐሙስ፡ 
                  <t:lb n="2"/>እምርጥበተ፡ ማይ፡ ዓሣተ፡ ወእምነ፡ ቈሪር፡ ነፋስ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza16">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ፈጣሬ፡ ንዑሳን፡ ዘይርሐወሱ።
                  <t:lb n="2"/>ወገባሬ፡ ዓበይት፡ እንስሳ፡ ለባሕር፡ ውቅያኖስ፡ ማዕከለ፡ ከርሡ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza17">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እንተ፡ ወሀብከ፡ ለምስካብ፡ 
                  <t:lb n="2"/>ለግሩመ፡ ራዕይ፡ አርዌ፡ ሳብዕተ፡ እድማይ፡ ርጡብ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza18"> 
               <t:note>The first version is the one found in <t:ref type="mss" corresp="https://betamasaheft.eu/ESmr001">Gulo Maḵadā, Mǝdra Rubā Sǝllase, MR-001</t:ref>, 
                  the second one the one found in <t:ref type="mss" corresp="https://betamasaheft.eu/FSUor133">Frankfurt, Universitätsbibliothek Johann Christian Senckenberg, Frankfurt Ms. or. 133</t:ref>.</t:note>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ በዕለተ፡ ዓርብ፡ ዘፈጠረ፡ 
                  <t:lb n="2"/>ዓባግዓ፡ ብሔር፡ ኵሎ፡ ወእንስሳ፡ ገዳም፡ ኅቡረ። 
               </t:ab>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ በዕለተ፡ ሰዱስ፡ ዘፈጠረ፡ 
                  <t:lb n="2"/>አባግዓ፡ ብሔር፡ ኵሎ፡ ወእንስሳ፡ ገዳም፡ ኅቡረ። 
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza19">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እምቀለመ፡ መሬት፡ ፀንዳ፡ 
                  <t:lb n="2"/>ለአካለ፡ አዳም፡ ሰዓልኮ፡ አለካዕኮ፡ ውስተ፡ ሰሌዳ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza20">
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እምገቦ፡ አዳም፡ ድኅረ፡
                  <t:lb n="2"/>እንተ፡ አውጻእካ፡ ለሔዋን፡ ከመ፡ ትትራድኦ፡ ተግባረ፡
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza21"> 
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ዘአዕረፎሙ፡ ለአይሁድ፡ 
                  <t:lb n="2"/>አመ፡ ዕለተ፡ ሰንበተ፡ ሳብዕት። እምተግባረ፡ አእጋር፡ ወእድ።
                  <t:lb n="3"/>እግዚአብሔር፡ አንተ፡ ሰንበተ፡ ክርስቲያን፡ እኁድ።
                  <t:lb n="4"/>አግሰዘኒ፡ እምቅኔ፡ ሥጋ፡ ለአብርዮ፡ ንስቲት፡ ሰጊድ።
                  <t:lb n="5"/>ኀበ፡ ኍልቈ፡ ፸ወ፪ስሙያን፡ አንጋድ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza22"> 
               <t:note>This stanza is not present in <t:ref type="mss" corresp="https://betamasaheft.eu/ESmr001">Gulo Maḵadā, Mǝdra Rubā Sǝllase, MR-001</t:ref>, the text is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/FSUor133">Frankfurt, Universitätsbibliothek Johann Christian Senckenberg, Frankfurt Ms. or. 133</t:ref>.</t:note>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ እንበለ፡ አርምሞ፡ እንበለ፡ ድምዕ።
                  <t:lb n="2"/>ዘጠባይዓ፡ ማይ፡ አምጻእከ፡ እምኀበ፡ ወኢ፡ ምንት፡ አንቀጽ።
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="stanza" xml:lang="gez" xml:id="Stanza23"> 
               <t:note>This stanza is not present in <t:ref type="mss" corresp="https://betamasaheft.eu/ESmr001">Gulo Maḵadā, Mǝdra Rubā Sǝllase, MR-001</t:ref>, the text is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/FSUor133">Frankfurt, Universitätsbibliothek Johann Christian Senckenberg, Frankfurt Ms. or. 133</t:ref>.</t:note>
               <t:ab>
                  <t:lb n="1"/>እሰግድ፡ ለመለኮትከ፡ ፈጣሬ፡ እሳት፡ ውሁይ።
                  <t:lb n="2"/>እንበለ፡ እሳት፡ ካልእ፡ ውስተ፡ ከርሠ፡ ቈሪር፡ ማይ።
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>