         <t:div type="edition" xml:id="div2LIT3058RepCh338">
            <t:div type="textpart" subtype="incipit" xml:lang="gez" xml:id="Preamble">
               <t:ab>
                  እሰግድ፡ ለኪ፡ ወእዌድሰኪ፡ ኦእግዝእትነ፡ ማርያም።
               </t:ab>
            </t:div>
            <t:div type="textpart" xml:lang="gez" xml:id="Hymn">
               <t:ab>
                  ተፈሥሒ፡ ኦእግዝእትየ፡ ማርያም፡
               </t:ab>
            </t:div>
         </t:div>

         <t:div type="edition" xml:id="div3LIT3058RepCh338">
            <t:note>text from <t:ref type="mss" corresp="https://betamasaheft.eu/ESam003">Bǝḥerāwi Kǝllǝlāwi Mangǝśti Tǝgrāy, ʾAsir Matirā, AM-003</t:ref>
            </t:note>

            <t:div type="textpart" subtype="incipit" xml:lang="gez" xml:id="incipit">
               <t:ab>
                  እሰግድ፡ ለኪ፡ እሰግድ፡ ለኪ፡ እሰግድ፡ ለኪ፡ ወእዌድሰኪ፡
                  ኦእግዝእትየ፡ ቅድስት፡ ድንግል፡ በ፪ማርያም፡ ወላዲተ፡ አምላክ፡ ለፀሐየ፡ ጽድቅ፡ ሠረገላሁ። ...
               </t:ab>
            </t:div>

            <t:div type="textpart" subtype="explicit" xml:lang="gez" xml:id="explicit">
               <t:ab>
                  ሰላም፡ ለኪ፡ ኦእግዝእትየ፡ ማርያም፡ ወላዲተ፡
                  አምላክ፡ እስመ፡ ረከብኪ፡ ክብረ፡ ወሞገሰ፡ እግዚአብሔር፡ ምስሌኪ፡ ሰአሊ፡ ወጸልዪ፡ ኀበ፡ ፍቁር፡ ወልድኪ፡ ከመ፡
                  ይሥረይ፡ ለነ፡ ኃጣውኢነ።።
               </t:ab>
            </t:div>




