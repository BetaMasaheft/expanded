         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3022RepCh302">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ለአዳም፡ ፋሲካሁ፨</t:l>
                  <t:l n="2">ወማዕዶታ፡ ለሔዋን፡ እንተ፡ ይእቲ፡ አፅመ፡ ገቦሁ፨</t:l>
                  <t:l n="3">እስመ፡ ግዕዛኖሙ፡ ኮነ፡ ለወልድኪ፡ በትንሣኤሁ፨</t:l>
                  <t:l n="4">በወርኀ፡ ዕብሬትኪ፡ እግዝእትየ፡ ዘኢይትረከብ፡ ከማሁ፨</t:l>
                  <t:l n="5">መኑ፡ ዘይቴክዝ፡ ወመኑ፡ ዘይላሑ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ወለተ፡ አሮን፡ ወሙሴ፨</t:l>
                  <t:l n="2">ዘትትቄጸሊ፡ አብያዘ፡ ወትሴአኒ፡ ብናሴ፨</t:l>
                  <t:l n="3">ለኀይለ፡ ተአምርኪ፡ ዝንቱ፡ ሶበ፡ ናቄርብ፡ ውዳሴ፨</t:l>
                  <t:l n="4">ሕትሚ፡ ፍጽመ፡ ዚአየ፡ በማኅተመ፡ ቅድስት፡ ሥላሴ፨</t:l>
                  <t:l n="5">አርእስተ፡ አቃርብት፡ ንኪድ፡ ወንቀጥቅጥ፡ ከይሴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ወለተ፡ ዳዊት፡ ወወልዱ፨</t:l>
                  <t:l n="2">ጽጌ፡ መዐዛ፡ ዘዐርገ፡ ለአብርሃም፡ እምሥርወ፡ ጕንዱ፨</t:l>
                  <t:l n="3">ያስተፌሥሐኒ፡ ጥቀ፡ ዜና፡ ተአምርኪ፡ ለለአሀዱ፨</t:l>
                  <t:l n="4">አይሁድሰ፡ ሶበ፡ መንክራተኪ፡ ክሕዱ፨</t:l>
                  <t:l n="5">ሕያዋኒሆሙ፡ ሲኦለ፡ ወረዱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ነአኵተኪ፡ ማርያም፡ ወንሴብሐኪ፡ ወትረ፨</t:l>
                  <t:l n="2">ሰርከ፡ ወነግሀ፡ ኵሎ፡ አሚረ፨</t:l>
                  <t:l n="3">ለኀይለ፡ ተኣምርኪ፡ ዝንቱ፡ ሶበ፡ ንሬኢ፡ ኅቡረ፨</t:l>
                  <t:l n="4">ለልበ፡ ጠቢባን፡ መላእክት፡ ዘያረስዖሙ፡ ምክረ፨</t:l>
                  <t:l n="5">ወለሐፃናት፡ ይከሥት፡ ሥዉረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ኣአኵተኪ፡ ማርያም፡ ወሀቢተ፡ ጸጋ፡ በከንቱ፨</t:l>
                  <t:l n="2">እስመ፡ አልዐልክኒ፡ ሊተ፡ እመሬተ፡ ምድር፡ እስከነ፡ ታሕቱ፨</t:l>
                  <t:l n="3">አንሥኦተ፡ ነዳይሰ፡ ወአልዕሎ፡ ምስኪን፡ ጊዜ፡ ድቀቱ፨</t:l>
                  <t:l n="4">እወ፡ እወ፡ ለልብኪ፡ ከመ፡ ከማሁ፡ ሥምረቱ፨</t:l>
                  <t:l n="5">እወ፡ ለዘኒ፡ ፈቀድኪ፡ ታሤንዪ፡ ሎቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ጽብኢ፡ ማርያም፡ ለእለ፡ ይጸብኡኒ፡ በተሀብሎ፨</t:l>
                  <t:l n="2">ወግፍዒ፡ ካዕበ፡ ለእለ፡ ይገፍዑኒ፡ ኵሎ፨</t:l>
                  <t:l n="3">ተኣምረኪ፡ ታርኢ፡ ወለወልድኪ፡ በቀሎ፨</t:l>
                  <t:l n="4">ይብል፡ አብድ፡ አኮኑ፡ እግዚአብሔር፡ ኢሀሎ፨</t:l>
                  <t:l n="5">ሶበ፡ ላዕሌሁ፡ ፍጡነ፡ ኢያርአየ፡ ኀይሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ንዒ፡ ማርያም፡ ምስለ፡ ወልድኪ፡ መዋኢ፨</t:l>
                  <t:l n="2">ከመ፡ ታውድቂ፡ ፍጡነ፡ ርእሰ፡ ፀር፡ ወጸላኢ፨</t:l>
                  <t:l n="3">እስመ፡ ፈታሒት፡ አንቲ፡ ማዕከለ፡ ግፉዕ፡ ወገፋዒ፨</t:l>
                  <t:l n="4">ብጹዕ፡ ብእሲ፡ ድቀተ፡ ፀሩ፡ ዘይሬኢ፨</t:l>
                  <t:l n="5">ወብፁዕ፡ ካዕበ፡ ፍትሐኪ፡ ሰማዒ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ዝ፡ ውእቱ፡ እድሜ፡ ሣህልኪ፡ ወዘተኣምርኪ፡ ጊዜ፨</t:l>
                  <t:l n="2">ማርያም፡ ድንግል፡ ምልእተ፡ ምሕረት፡ ከመ፡ ተከዜ፨</t:l>
                  <t:l n="3">እስከ፡ ማእዜኑ፡ እሄሉ፡ ማዕከለ፡ ብካይ፡ ወእንባዜ፨</t:l>
                  <t:l n="4">ኦናዛዚት፡ እንተ፡ ወለድኪ፡ ናዛዜ፨</t:l>
                  <t:l n="5">ኦንግሥት፡ በቋዒት፡ ብቊዕኒ፡ ይእዜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሙሴ፡ ነቢይ፡ አመ፡ ሕዘቢሁ፡ ቈስሉ፨</t:l>
                  <t:l n="2">ተኣምረ፡ ገብረ፡ ለአርዌ፡ ብርት፡ በምስሉ፨</t:l>
                  <t:l n="3">እምዝኒ፡ የዐቢ፡ ኀይለ፡ ተኣምርኪ፡ ንግሥተ፡ ኵሉ፨</t:l>
                  <t:l n="4">ወኀበ፡ ተተክለ፡ ለዋሕድኪ፡ መስቀሉ፨</t:l>
                  <t:l n="5">ሠራዊተ፡ ደዌ፡ ወሞት፡ ቀሪበ፡ ኢይክሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ፈሪሆትኪ፡ ማርያም፡ ቀዳሜ፡ ኵሉ፡ ተዐውቆ፨</t:l>
                  <t:l n="2">ወአፍቅሮትኪ፡ ካዕበ፡ መሠረተ፡ ጥበብ፡ ወአጠይቆ፨</t:l>
                  <t:l n="3">ተኣምረኪ፡ እሴብሕ፡ በቃለ፡ መዝሙር፡ ወመሰንቆ፨</t:l>
                  <t:l n="4">በውስተ፡ ተኣምርኪ፡ እግዝእትየ፡ ለዘአብአ፡ ናፍቆ፨</t:l>
                  <t:l n="5">አፍቲዎ፡ መዊተ፡ ወሲኦለ፡ አጽሐቆ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ምንተ፡ ረከቡ፡ ካህናተ፡ ሐሊባ፡ ወሐላ፨</t:l>
                  <t:l n="2">መንክራተ፡ አምላክ፡ ዘርእዩ፡ እምሰኪኖን፡ እስከ፡ ገልገላ፨</t:l>
                  <t:l n="3">ካህናተ፡ ቤትኪሰ፡ ማርያም፡ ርግበ፡ ገሊላ፨</t:l>
                  <t:l n="4">እንዘ፡ ይትአመኑ፡ ለተአምርኪ፡ ኀይላ፨</t:l>
                  <t:l n="5">ያፈልሱ፡ ደብረ፡ ወይመልሑ፡ ሰግላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ይቴክዝ፡ አብድ፡ ሶበ፡ ልበ፡ ጥበብ፡ ውሕዶ፨</t:l>
                  <t:l n="2">በኢያእምሮቱ፡ አብዝኀ፡ ሕማመ፡ ዘይፈድፍዶ፨</t:l>
                  <t:l n="3">ፍሡሕሰ፡ ለፍቅርኪ፡ ዘይፀመዶ፨</t:l>
                  <t:l n="4">በቅድመ፡ ሥዕልኪ፡ እግዝእትየ፡ ለለጊዜ፡ ያነሥእ፡ እዶ፨</t:l>
                  <t:l n="5">ተስፋሁ፡ ይረክብ፡ ወይፌጽም፡ መፍቅዶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ዕቀብኒ፡ በተኣምርኪ፡ ወአድኅንኒ፡ እምማቴ፨</t:l>
                  <t:l n="2">በከመ፡ አድኀኖ፡ ወልድኪ፡ ለዮናስ፡ ወልደ፡ አማቴ፨</t:l>
                  <t:l n="3">መዋዕለ፡ ዕረፍት፡ አንቲ፡ ማርያም፡ ጰንጠቈስቴ፨</t:l>
                  <t:l n="4">እምኀይለ፡ ድካም፡ ያጸንዕ፡ መዋቴ፨</t:l>
                  <t:l n="5">ኅብስት፡ ስብሐትኪ፡ ወፍቅርኪ፡ ስቴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሴስይኒ፡ ማርያም፡ ለጸማድኪ፡ ዐሳብ፨</t:l>
                  <t:l n="2">ኅብስተ፡ አእምሮ፡ ሠናየ፡ ወወይነ፡ ጥበብ፨</t:l>
                  <t:l n="3">እመኒ፡ ፈድፈደ፡ ኃጢአትየ፡ እምሕዝብ፨</t:l>
                  <t:l n="4">ተዘከሪ፡ እግዝእትየ፡ በርኅራኄኪ፡ ዕጹብ፨</t:l>
                  <t:l n="5">ከመ፡ አስተኪዮ፡ ማየ፡ ለጽሙእ፡ ከልብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ወላዲተ፡ አምላክ፡ ማርያም፡ እንበለ፡ ሰብሳብ፡ ወሩካቤ፨</t:l>
                  <t:l n="2">በይነ፡ ዘአቅረብኩ፡ ለኪ፡ ንስቲተ፡ ቃለ፡ ይባቤ፨</t:l>
                  <t:l n="3">ፈትቲ፡ እሙ፡ በረከተ፡ አፉኪ፡ ሙሐዘ፡ ከርቤ፨</t:l>
                  <t:l n="4">ለነዳይ፡ ብእሲ፡ ወለዘረከቦ፡ ምንዳቤ፨</t:l>
                  <t:l n="5">ኅብስተከ፡ ፈትት፡ ኢሳይያስ፡ ይቤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">አፍጣኒተ፡ ረድኤት፡ ማርያም፡ በጊዜ፡ ምንዳቤ፡ ወዐጸባ፨</t:l>
                  <t:l n="2">ለዐይን፡ እምቀራንባ፨</t:l>
                  <t:l n="3">አንቲ፡ ይእቲ፡ ረዳኢተ፡ ያዕቆብ፡ በቤተ፡ ላባ፨</t:l>
                  <t:l n="4">በኵሉ፡ ኅሊናሃ፡ ወበኵሉ፡ አልባባ፨</t:l>
                  <t:l n="5">ዘኢታፈቅረኪ፡ ነፍስ፡ ትሠሮ፡ እምሕዝባ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>         
      </t:body>
   </t:text></TEI>