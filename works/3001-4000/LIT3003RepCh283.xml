               <t:bibl corresp="http://zotero.org/groups/358366/items/E2ZANERE"><seg type="encyclopediaArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Brita2010Sehma"/><title level="a">Ṣǝḥma</title><title type="short">EAe</title><title level="m">Encyclopaedia Aethiopica</title><author><forename>Antonella</forename><surname>Brita</surname></author><editor><forename>Siegbert</forename><surname>Uhlig</surname></editor><editor><forename>Alessandro</forename><surname>Bausi</surname></editor><pubPlace>Wiesbaden</pubPlace><publisher>Harrassowitz Verlag</publisher><date>2010</date><biblScope unit="volume">IV</biblScope><biblScope unit="page">596a-597a</biblScope><note type="tags"><note type="tag">bm:Brita2010Sehma</note></note><note type="tag">bm:Brita2010Sehma</note><t:citedRange unit="item">596a</t:citedRange></t:bibl>
