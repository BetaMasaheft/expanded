         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በስመ፡ እግዚአብሔር፡ ጠቢብ፡ ለሰማይ፡ ዘሰቀሎ፨</t:l>
                  <t:l n="2">ወሣረረ፡ ምድረ፡ እምኀበ፡ ኢሀሎ፨</t:l>
                  <t:l n="3">አባ፡ ጽሕማ፡ እስእለከ፡ በተሐብሎ፨</t:l>
                  <t:l n="4">ከመ፡ ታርኁ፡ ማዕፆ፡ ልብየ፡ ወለነባብየ፡ ቃሎ፨</t:l>
                  <t:l n="5">ውዳሴ፡ መልክእከ፡ እውጥን፡ ወእፈጽም፡ ኵሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እንተ፡ ፍጹመ፡ ተንዕደ፨</t:l>
                  <t:l n="2">እምሥዋሬ፡ ሥጋ፡ ንጹሕ፡ ቅድመ፡ ታስተርኢ፡ ገሀደ፨</t:l>
                  <t:l n="3">እስእለከ፡ ጽሕማ፡ ወአስተበቍዐከ፡ ፈድፉደ፨</t:l>
                  <t:l n="4">ምስሌከ፡ በዕለተ፡ መርዐ፡ እንዘ፡ ዕረፍቅ፡ ማዕደ፨</t:l>
                  <t:l n="5">በቅድመ፡ ጉባኤ፡ በለኒ፡ ዘዚአየ፡ ወልደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአእናፊከ፡ ዘመሳክዊሆን፡ መንታ፨</t:l>
                  <t:l n="2">እለ፡ ያጼንዋ፡ ወትረ፡ መዐዛ፡ ማርያም፡ ርግበ፡ ኤፍራታ፨</t:l>
                  <t:l n="3">አባ፡ ጽሕማ፡ ዐሪገከ፡ ደብረ፡ ሐተታ፨</t:l>
                  <t:l n="4">ቀዊመከአ፡ ምስለ፡ ሱራፌል፡ ውስቴታ፨</t:l>
                  <t:l n="5">ስብሐተ፡ ቅዳሴ፡ ትዜምር፡ በሠላስ፡ ጾታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ እስከ፡ ዕለተ፡ ዐባይ፡ ጉባኤ፨</t:l>
                  <t:l n="2">ውስተ፡ መቃብር፡ ክዱን፡ ዘይጸንሕ፡ ተስፋ፡ ትንሣኤ፨</t:l>
                  <t:l n="3">አባ፡ ጽሕማ፡ ጊዜ፡ ትሰምዕ፡ ቀርነ፡ ጸዋዔ፨</t:l>
                  <t:l n="4">ንሥአኒ፡ በየማንከ፡ እንዘ፡ ትከውን፡ ረዳኤ፨</t:l>
                  <t:l n="5">አመ፡ ይነሥኡ፡ ድኅረ፡ አሐዱ፡ እምክልኤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ቀዊሞን፡ ደርገ፡ ለመካነ፡ ዝኅርከ፡ በልባ፨</t:l>
                  <t:l n="2">መለያልያትየ፡ ኵሉ፡ ዕበያቲከ፡ ይነባ፨</t:l>
                  <t:l n="3">አባ፡ ጽሕማ፡ ዘመዶሙ፡ ለእለ፡ ጉባ፨</t:l>
                  <t:l n="4">አባ፡ አባ፡ መምህረ፡ ሥርዓት፡ አባ፨</t:l>
                  <t:l n="5">አባ፡ በረከተከ፡ ለነፍስየ፡ ሀባ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ብሩረ፡ ዘአቅረብኩ፡ ወአዕባነ፡ ወርቅ፡ ቀይሕ፨</t:l>
                  <t:l n="2">እለ፡ ኅዳጠ፡ መሥዋዕተ፡ ማሕሌት፡ ንጹሕ፨</t:l>
                  <t:l n="3">ለዕበየ፡ መልክእከ፡ ክቡር፡ ጽሕማ፡ ስቡሕ፨</t:l>
                  <t:l n="4">ተወከፍ፡ ሊተ፡ እግዚእየ፡ ለለ፡ ጊዜ፡ ምሴት፡ ወነግህ፨</t:l>
                  <t:l n="5">ከመ፡ ይትዌከፎ፡ ለወልድ፡ አቡሁ፡ ርኅሩኅ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
