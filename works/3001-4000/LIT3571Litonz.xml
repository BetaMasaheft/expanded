         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/Y6CW7FBU"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:1957Qeddase"/><title level="m">መጽሐፈ፡ ቅዳሴ፡ &lt;hi rend="italics"&gt;(&lt;/hi&gt;Maṣḥafa qǝddāse&lt;hi rend="italics"&gt;, ‘Book of the Missal')&lt;/hi&gt;</title><author><name>Anon.</name></author><pubPlace>ʾAśmarā</pubPlace><publisher>ba-māḫbara ḥawāryāt fǝre hāymānot ba-kokaba ṣǝbāḥ māttamiyā bet tāttama</publisher><date>1957</date><note type="tags"><note type="tag">bm:1957Qeddase</note></note><note type="tag">bm:1957Qeddase</note><t:citedRange unit="page">187</t:citedRange></t:bibl>
            </t:listBibl>
         </t:div>
         
         <t:div type="edition" xml:id="div2LIT3571Litonz">
            <t:note>The following text is taken from <t:bibl corresp="http://zotero.org/groups/358366/items/Y6CW7FBU"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:1957Qeddase"/><title level="m">መጽሐፈ፡ ቅዳሴ፡ &lt;hi rend="italics"&gt;(&lt;/hi&gt;Maṣḥafa qǝddāse&lt;hi rend="italics"&gt;, ‘Book of the Missal')&lt;/hi&gt;</title><author><name>Anon.</name></author><pubPlace>ʾAśmarā</pubPlace><publisher>ba-māḫbara ḥawāryāt fǝre hāymānot ba-kokaba ṣǝbāḥ māttamiyā bet tāttama</publisher><date>1957</date><note type="tags"><note type="tag">bm:1957Qeddase</note></note><note type="tag">bm:1957Qeddase</note><t:citedRange unit="page">187</t:citedRange></t:bibl>.</t:note>
            <t:div type="textpart" xml:lang="gez" xml:id="div2div1LIT3571Litonz">
               <t:ab>ይ፡ ካ፡ ሶበ፡ አኮ፡ እግዚአብሔር፡ ምስሌነ፡ ይብል፡ እስራኤል፡ ሶበ፡ አኮ፡ እግዚአብሔር፡ ምስሌነ። እንተ፡ ጊዜ፡
                  ተንሥአ፡ ሰብእ፡ ላዕሌነ፡ አሐዝብ፡ ሕያዋኒነ፡ እምውኅጡነ፡ በከመ፡ አንሥኡ፡ ቍጥዐ፡ መዓቶሙ፡ ላዕሌነ። አሐዝብ፡ በማይ፡
                  እምአስጠሙነ። እምውኂዝ፡ አምሰጠት፡ ነፍስነ፡ አምሰጠት፡ ነፍስነ፡ እማየ፡ ሀከክ፡ ይትባረክ፡ እግዚአብሔር፡ አምላክነ፡
                  ዘኢያግብአነ፡ ውስተ፡ መሥገርተ፡ ማዕገቶሙ። ነፍስነሰ፡ አምሠጠት፡ ከመ፡ ዖፍ፡ እመሥገርት፡ ነዓዊት። መሥገርትሰ፡
                  ተቀጥቀጠት፡ ወንሕነሰ፡ ድኅነ። ረድኤትነሰ፡ በስመ፡ እግዚአብሔር፡ አምላክነ። ይ፡ ዲ፡ ጸልዩ። ይ፡ ሕ፡ አቡነ፡
                  ዘበሰማያት። ይ፡ ካ፡ ዘገብረ፡ ሰማየ፡ ወምድረ። ዘገብረ፡ ሰማየ፡ ወምድረ። ዘገብረ፡ ሰማየ፡ ወምድረ፡ ለዓለም፡
                  ወለዓለመ፡ ዓለም። ይ፡ ሕ፡ አሜን።</t:ab>
            </t:div>
         </t:div>
      </t:body>
