         <t:div type="edition" xml:lang="gez">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ናሁ፡ ተወጥነ፡ ለመልክእከ፡ ሰላሙ፨</t:l>
                  <t:l n="2">እንዘ፡ መንፈስ፡ ቅዱስ፡ ይረድእ፡ ወያበጽሕ፡ እስከ፡ ተፍጸሙ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ባርክ፡ መንግሥተ፡ ገላውዴዎስ፡ ለለጌሠሙ፨</t:l>
                  <t:l n="4">ምስለ፡ መንግሥትከ፡ ንግሡ፡ ወምስለ፡ ስምከ፡ ስሙ፨</t:l>
                  <t:l n="5">እስመ፡ ተሳተፈ፡ እምፀሐይ፡ ቀዲሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝከረ፡ ስምከ፡ ውስተ፡ አፈ፡ ኵሎሙ፡ መሃይምናን፨</t:l>
                  <t:l n="2">ዘጥዑም፡ ፈድፋደ፡ እምዘትረ፡ ጸቃውዕ፡ ወወይን፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ መሥዋዕት፡ ወመዓዛ፡ ቀዱስ፡ ቍርባን፨</t:l>
                  <t:l n="4">እስከ፡ እሤልጥ፡ ቃለ፡ ሰላም፡ ዘመልክእከ፡ ኵሎን፨</t:l>
                  <t:l n="5">ውስተ፡ እዝነ፡ ልብየ፡ ይድምፅ፡ ረድኤትከ፡ ቀርን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ እንተ፡ በዲቤሁ፡ ነፍነፈ፨</t:l>
                  <t:l n="2">ጠለ፡ መንፈስ፡ ቅዱስ፡ ቀዳሲ፡ ከመ፡ ሰሎሞን፡ ጸሐፈ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ ዘተጋደልከ፡ ትሩፈ፨</t:l>
                  <t:l n="4">ኦወሬዛ፡ ትዕግሥተ፡ ገድልከ፡ ዘልፈ፨</t:l>
                  <t:l n="5">ጽጌ፡ ብሩር፡ ይመስል፡ ወወርቀ፡ ንጡፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለርእስከ፡ ዘቅብዓ፡ መስኮት፡ አጥለሎ፨</t:l>
                  <t:l n="2">በአከሊለ፡ ሞገስ፡ ወክብር፡ አምሳለ፡ ወልታ፡ ጽድቅ፡ ዘይኬልሎ፨</t:l>
                  <t:l n="3">ገላውድዎስ፡ ሥርግው፡ በትርሲተ፡ ንጽሕ፡ ወተደንግሎ፨</t:l>
                  <t:l n="4">ዘይገዝም፡ ጕንደ፡ ወእም፡ አበሳየ፡ ኵሎ፨</t:l>
                  <t:l n="5">ጕድበ፡ ምሕረት፡ ይሩጽ፡ በእዴከ፡ ዘዘሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለገጽከ፡ ብርሃነ፡ ቅድስት፡ ሥላሴ፨</t:l>
                  <t:l n="2">ዘተሠውጠ፡ ቦቱ፡ ከመ፡ ገጸ፡ ነቢይ፡ ሙሴ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፀሐይ፡ ወንጉሠ፡ ሌሊት፡ ብናሴ፨</t:l>
                  <t:l n="4">በዓፀደ፡ ተድላ፡ አመ፡ ትከውን፡ ነጋሤ፨</t:l>
                  <t:l n="5">ረስየኒ፡ ግብረ፡ ወምእመነ፡ ብእሲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለቀራንብቲከ፡ መንታ፨</t:l>
                  <t:l n="2">ነገረ፡ ጥበብ፡ ሥውረ፡ እንተ፡ ለዘልፍ፡ የሐታ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ኃያል፡ ተወልታዊ፡ መስቀል፡ ዘጎልጎታ፨</t:l>
                  <t:l n="4">ሴስየኒ፡ እከለ፡ መንፈስ፡ ስለ፡ ይጸብሕ፡ ሳኒታ፨</t:l>
                  <t:l n="5">ሰብሐተ፡ ከብርከ፡ እንብብ፡ በብዙኅ፡ ጾታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአዕይንቲከ፡ እለ፡ ኢኮና፡ ሐማሜ፨</t:l>
                  <t:l n="2">እመ፡ ተደለወ፡ ለገባአት፡ ዲናረ፡ ዐስበ፡ ጽድቅ፡ ዲድርክሜ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ኅሩይ፡ እምሳለ፡ ጳውሎስ፡ ዘብሔረ፡ ሮሜ፨</t:l>
                  <t:l n="4">አይድዐኒ፡ ምክረ፡ ጥበብ፡ ወነገረ፡ ሕይወት፡ ቀጥሜ፨</t:l>
                  <t:l n="5">እምገነተ፡ ስምከ፡ እኩን፡ አፈወ፡ ቀሳሜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለአእዛኒከ፡ ዘያጸምኣ፡ ስእለቶ፨</t:l>
                  <t:l n="2">ለነዳይ፡ ብእሲ፡ ዘጥቅመ፡ ምንዳቤ፡ ዓገቶ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ነዓ፡ ሶበ፡ ጸዋዕኩከ፡ በተሐግርቶ፨</t:l>
                  <t:l n="4">ከመ፡ ትምርሐኒ፡ ወታርአየኒ፡ ፍኖቶ፨</t:l>
                  <t:l n="5">ለዘብእሲ፡ ጥበብ፡ ሐነጸ፡ ዲበ፡ ኰነሕ፡ ቤቶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለመላትሒከ፡ ከመ፡ ቃለ፡ መጽሐፍ፡ ዚነወ፨</t:l>
                  <t:l n="2">ዘርኄ፡ ወረዳ፡ እለ፡ ይፈርያ፡ አፈወ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ እንተ፡ ደምከ፡ ተክዕወ፨</t:l>
                  <t:l n="4">በላህበ፡ ጌጋይ፡ አመ፡ ፈድፋደ፡ መጽለወ፨</t:l>
                  <t:l n="5">ላዕለ፡ መላትሕየ፡ ንዛን፡ ላህየከ፡ ቅድወ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ በአእናፊከ፡ ዕፍረተ፡ ስምዓ፡ ጽድቅ፡ ወገድል፨</t:l>
                  <t:l n="2">ዘአፄነዋ፡ ፈድፋደ፡ አምሳለ፡ አበሜ፡ ወኮል፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፍሡሕ፡ ወወሬዛ፡ መንግሥት፡ ኃያል፨</t:l>
                  <t:l n="4">ናዝዘኒ፡ በፍሥሓከ፡ እምብካየ፡ ብዙ፡ ኃጕል፨</t:l>
                  <t:l n="5">አመ፡ ለቃለ፡ አብ፡ ይሰፋሕ፡ ሞጣሕቱ፡ በቀል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለከናፍሪከ፡ እለ፡ ያፈቅራ፡ ነቢበ፨</t:l>
                  <t:l n="2">ነገረ፡ የውሃት፡ ዘርግብ፡ ወዘአርዌ፡ ምድር፡ ጥበበ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ ዘተጋደልከ፡ ዕፁበ፨</t:l>
                  <t:l n="4">ምስለ፡ አብያጺከ፡ ጊዜ፡ ትገብር፡ ከብካበ፨</t:l>
                  <t:l n="5">ፍርፋየ፡ ስብሐቲከ፡ አጽግብ፡ ከርሥየ፡ ርኁበ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለአፉከ፡ ዘጣዖታተ፡ ዝሰፈ፨</t:l>
                  <t:l n="2">እለ፡ ኢይነቡ፡ ሕቀ፡ እንዘ፡ ቦሙ፡ አፈ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ባሕርይ፡ ዘኢትትከደን፡ ሰይፈ፨</t:l>
                  <t:l n="4">ነኰርኳርከ፡ ዝዋካ፡ አመ፡ ምድረ፡ ጽልመት፡ ኃለፈ፨</t:l>
                  <t:l n="5">ብርሃነ፡ ሕይወት፡ በሴድራ፡ ተርፈ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለአስናኒከ፡ በኆኅተ፡ ሥጋከ፡ ሕንጻ፨</t:l>
                  <t:l n="2">ማዕዎ፡ ጽድቀ፡ ቃል፡ ዝኮና፡ እምነቢበ፡ ኵሉ፡ ዓመፃ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ ወትሩፈ፡ ገድል፡ አምኆፃ፨</t:l>
                  <t:l n="4">ኵነኒ፡ ቀስተ፡ መዊዕ፡ ወዘረድኤት፡ አሕዋ፨</t:l>
                  <t:l n="5">አምነ፡ ልሳን፡ ቀታሊት፡ ዘግሩም፡ ድምፃ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰባም፡ ለልሳንከ፡ ድኅረ፡ እምሕሊና፡ ሠረፀ፨</t:l>
                  <t:l n="2">ዘቃለ፡ ሐሤት፡ ይወልድ፡ ወመስተፍሥሔ፡ ልብ፡ ድምፀ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ አንተ፡ ሠለጥከ፡ ምርዋፀ፨</t:l>
                  <t:l n="4">ላዕሌየ፡ ሲዘቈጸሩ፡ ምስለ፡ አማዑቶሙ፡ ገጸ፨</t:l>
                  <t:l n="5">በክሳደ፡ ነፍሶሙ፡ ስቅል፡ ዘአድግ፡ ማኅረፀ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለቃልከ፡ ዘጣዕመ፡ ድምፁ፡ ነከራ፨</t:l>
                  <t:l n="2">ዘይኄይስ፡ እምድምፀ፡ አርጋኖን፡ ወእንዚራ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ መክብብ፡ ዘሰማዕታተ፡ ጽድቅ፡ እለ፡ መርቆራ፨</t:l>
                  <t:l n="4">እንዘ፡ ያነክሩ፡ ዘተዓግሥከ፡ መከራ፨</t:l>
                  <t:l n="5">በዓለ፡ ስምከ፡ በሰማይ፡ ይገብሩ፡ ሐራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለእስትንፋስከ፡ እንተ፡ ይነፍሕ፡ መዓዛ፨</t:l>
                  <t:l n="2">መሳከወ፡ ልብከ፡ ቅቡዕ፡ በደመ፡ መስኮት፡ ከመ፡ ራግዛ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ኃያል፡ በአርማኃ፡ በቀል፡ ተረጊዛ፨</t:l>
                  <t:l n="4">እምጽንዕከ፡ ወእምትብዕከ፡ መዋዒ፡ ወሬዛ፨</t:l>
                  <t:l n="5">አድያመ፡ ቍዝ፡ ቀትረ፡ ተበርበረት፡ ጋዛ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለጕርዔከ፡ ዘዝክሩ፡ መዓርዒር፨</t:l>
                  <t:l n="2">እምዝክረ፡ ወይን፡ ሥሙር፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፌማ፡ ፍጹመ፡ አእምሮ፡ ወምክር፨</t:l>
                  <t:l n="4">እንዘ፡ አንተ፡ ወልደ፡ ንጉሥ፡ ወዘመደ፡ ፍጥረት፡ ክቡር፨</t:l>
                  <t:l n="5">እፎኑ፡ ተዳደቀከ፡ ምናኔ፡ ኀሡር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለክሳድከ፡ ዘአርማስቆስ፡ አምሳሉ፨</t:l>
                  <t:l n="2">በዝግና፡ ባሕርይ፡ ከቡረ፡ ዘተሠርገወ፡ እምላዕሉ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፍቁር፡ ሰልበ፡ ፍጥረታት፡ ኵሉ፨</t:l>
                  <t:l n="4">አምረኒ፡ ፍኖተ፡ ጽድቅ፡ እንዘ፡ ታቀድም፡ ወታተሉ፨</t:l>
                  <t:l n="5">አመ፡ መሠገርተ፡ ሞት፡ ቅድሜየ፡ ተከሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ሰላም፡ ለመትከፍትከ፡ እንተ፡ ተፅዕነ፡ ዲቤሁ፨</t:l>
                  <t:l n="2">አርዑተ፡ ኢየሱስ፡ ሠናይ፡ ወቀሊል፡ ጾረ፡ ዚአሁ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሐሊ፡ ሲሳየ፡ መፍቅድየ፡ ለለጽባሑ፨</t:l>
                  <t:l n="4">ሀካይስ፡ እንተ፡ ኃዋፈ፡ እዴሁ፨</t:l>
                  <t:l n="5">ደሞ፡ ይሰቲ፡ ወይበልዕ፡ ሥጋሁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="20">
                  <t:l n="1">ሰላም፡ ለዘባንከ፡ እንተ፡ አፍቀረ፡ ተመይጦ፨</t:l>
                  <t:l n="2">እምኅራመ፡ ጣዖት፡ ዘወርቅ፡ ዘእደ፡ ነሀቢ፡ ዘበጦ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፍንው፡ መልእከተ፡ ክርስቶስ፡ ለአሥልጦ፨</t:l>
                  <t:l n="4">ከመ፡ እኩን፡ ገብረ፡ ዚአከ፡ እንዘ፡ አልብየ፡ ተፈልጦ፨</t:l>
                  <t:l n="5">ለደመ፡ ስምዕከ፡ ረስየኒ፡ ሤጦ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="21">
                  <t:l n="1">ሰላም፡ ለእንግድዓከ፡ ምዕላደ፡ ልቡና፡ ዘኮነ፨</t:l>
                  <t:l n="2">ወረሰየ፡ ዓዲ፡ ሎግ፡ ምክር፡ ከዳነ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ዕፍረት፡ አንተ፡ ትምዕዝ፡ ዕጣነ፨</t:l>
                  <t:l n="4">አድኅነኒ፡ እምአፈ፡ ፀር፡ እንተ፡ የሐቂ፡ አስናነ፨</t:l>
                  <t:l n="5">አመ፡ ላዕሌየ፡ አንሥአ፡ ዓቢየ፡ ተስናነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="22">
                  <t:l n="1">ሰላም፡ ለሕፅንከ፡ ምርፋቀ፡ ጥበብ፡ ኅሪት፨</t:l>
                  <t:l n="2">ዘሕገጊሃ፡ ወንጌል፡ ወሥርዓታቲሃ፡ ኦሪት፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ግሥ፡ እምአፍቅሮ፡ ጥሪት፨</t:l>
                  <t:l n="4">ውስተ፡ ዓፀድከ፡ ወግነትከ፡ መፍሪት፨</t:l>
                  <t:l n="5">ትምርሐኒ፡ ለበዊአ፡ ልብከ፡ ጽሪት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለአእዳዊከ፡ እለ፡ ሠረዋ፡ አፅራረ፨</t:l>
                  <t:l n="2">ንጉሡ፡ አረሚ፡ ዘቍዝ፡ አመ፡ ማዕሌተ፡ ገብረ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሠርዌ፡ ወርእሰ፡ አእላፍ፡ ወትረ፨</t:l>
                  <t:l n="4">ጊዜ፡ ቀተሉከ፡ ምስለ፡ ፊቅጦር፡ ኅቡረ፨</t:l>
                  <t:l n="5">ሰብአ፡ አንጾኪያ፡ ወግብጽ፡ በከዩ፡ መሪረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለመዛርዒከ፡ በሥምረተ፡ ክርስቶስ፡ ሊቅ፨</t:l>
                  <t:l n="2">እምአጕናደ፡ አባል፡ ዘዓርጋ፡ አምሳለ፡ ሠናያን፡ አዕጹቅ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ጽጌ፡ ወሕንባበ፡ ዛ ረዳ፡ ዘሐይቅ፨</t:l>
                  <t:l n="4">ይኄይሰኒ፡ ለገብርከ፡ ሕግ፡ አፉከ፡ ዘጽድቅ፨</t:l>
                  <t:l n="5">እምነ፡ አእላፍ፡ ብሩር፡ ወቀይሕ፡ ወርቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ሰላም፡ ለዘዚአከ፡ ኲርናዕ፨</t:l>
                  <t:l n="2">አመ፡ ዕለተ፡ ዐብዕ፡ ዘጸንዓ፡ አምሳለ፡ አርዌ፡ ብርት፡ ጽኑዕ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፍሡሕ፡ ወያርብታዊ፡ ተባዕ፨</t:l>
                  <t:l n="4">ይኩነኒ፡ ማየ፡ ጥምቀት፡ ለብእሲ፡ ኃጥእ፨</t:l>
                  <t:l n="5">ነ፡ እምዓይነ፡ በቅጥር፡ እኁከ፡ ዘውኅዘ፡ አንብዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለእመትከ፡ ከመ፡ አዘዘ፡ ክርስቶስ፨</t:l>
                  <t:l n="2">እንተ፡ አምጣኒሃ፡ ሠፈረ፡ ለኢየሩሳሌም፡ መቅደስ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ንጉሥ፡ በዕለተ፡ ኵነኔ፡ መብዕስ፨</t:l>
                  <t:l n="4">ጸግወኒ፡ ሐመረ፡ ተድላ፡ ዘኢየሀውኮ፡ ነፋስ፨</t:l>
                  <t:l n="5">ምስሌከ፡ ለኃዲር፡ ኀበ፡ ዘዓን፡ ወመርስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለእራኃቲከ፡ እለ፡ ይሰፍሓ፡ ለዘልፍ፨</t:l>
                  <t:l n="2">ለውሂበ፡ ሀብታት፡ ብዙኅ፡ ወጸግዎ፡ ጸጋ፡ ትሩፍ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ መልአክ፡ ወዘውግ፡ ትጉሃን፡ አእላፍ፨</t:l>
                  <t:l n="4">ዘአስተርኢ፡ ቅድመ፡ ገጽየ፡ እንዘ፡ ትሠርር፡ በክንፍ፨</t:l>
                  <t:l n="5">አመ፡ ቀርነ፡ ጽራሕ፡ ይነፍሕ፡ ሚካኤል፡ ዖፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለአጻብኢከ፡ ዘኍላቌሆን፡ ዓሥር፨</t:l>
                  <t:l n="2">እለ፡ ሥርግዋት፡ እማንቱ፡ በኅልቀተ፡ ሰላም፡ ወፍቅር፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ አዚዝ፡ መኰንነ፡ ዕበይ፡ ወክብር፨</t:l>
                  <t:l n="4">እስመ፡ አሥጠመኒ፡ ፈለግ፡ ኃጢአት፡ ወነውር፨</t:l>
                  <t:l n="5">በሰሪቦቱ፡ ትርድአኒ፡ ምድር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እዴከ፡ ዘኑባሬሆን፡ ሉዓሌ፨</t:l>
                  <t:l n="2">በከተማ፡ አጽባዕት፡ ዓሥር፡ እንዘ፡ ያበርሃ፡ ከመ፡ ቢረሌ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ተቅዋም፡ ወወጾረ፡ ትእዛዝ፡ ጽሌ፨</t:l>
                  <t:l n="4">እንዘ፡ ይትአመኑ፡ አድኅኖተከ፡ ከሀሌ፨</t:l>
                  <t:l n="5">ሙሴ፡ ወአሮን፡ ጸሐፉ፡ ኩፋሌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለገቦከ፡ ዘተዓገሠ፡ ርግዘተ፨</t:l>
                  <t:l n="2">በአፈ፡ ኲናት፡ በሊሕ፡ እስከ፡ ሠለጥከ፡ መዊተ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ንጹሕ፡ ዘኢተአምር፡ ርስሐተ፨</t:l>
                  <t:l n="4">ርእዮሙ፡ ጸላእትነ፡ ከመ፡ ይትኃፈሩ፡ ግብተ፨</t:l>
                  <t:l n="5">ግበር፡ ላዕሌነ፡ ሠናየ፡ ትእምርተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለከርሥከ፡ መብልዓ፡ ጣዖታት፡ ዘከደ፨</t:l>
                  <t:l n="2">ረኃበ፡ ኵነኔ፡ ማሕምም፡ እንዘ፡ ይገብር፡ ማዕደ፨</t:l>
                  <t:l n="3">ፀባኢተ፡ አርማን፡ ወቍዝ፡ አመ፡ አንሥኡ፡ መራደ፨</t:l>
                  <t:l n="4">ገላውዴዎስ፡ ጽንዓ፡ ኃይልከ፡ ጊዜ፡ ከመ፡ እሳት፡ ነደ፨</t:l>
                  <t:l n="5">አምሳለ፡ ትንታጋት፡ ጤሱ፡ ወኮኑ፡ ሐመደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለልብከ፡ ዘተመሰለ፡ በአብ፨</t:l>
                  <t:l n="2">ሕሊና፡ አእምሮ፡ ዘይወልድ፡ ወምክረ፡ ጥበብ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ጸልል፡ በአክናፊከ፡ ዘላህብ፨</t:l>
                  <t:l n="4">መልዕልተ፡ ርእስየ፡ እምሐሩረ፡ ጌጋይ፡ ዕፁብ፨</t:l>
                  <t:l n="5">እስመ፡ መልአከ፡ ምክር፡ እንተ፡ ዘስሙ፡ ኪሩብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለኵልያቲከ፡ ከመ፡ መዘምራን፡ ነበቡ፨</t:l>
                  <t:l n="2">እንተ፡ ፈተኖን፡ ልዑል፡ በማኅቶተ፡ ፅዱል፡ ጥበቡ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሙሴ፡ ለእግዚአብሔር፡ መጋቤ፡ ሕዝቡ፨</t:l>
                  <t:l n="4">ገዳማት፡ በእንቲአከ፡ ጠላተ፡ በረከት፡ ጸግቡ፨</t:l>
                  <t:l n="5">ዕንጐታትኒ፡ መዓዛ፡ ወሀቡ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">ሰላም፡ ለሕሊናከ፡ እምሥርወ፡ ልብ፡ ዘዓርገ፨</t:l>
                  <t:l n="2">ምሕረተ፡ ነዳያን፡ የሐሊ፡ ወፍትሐ፡ ምስኪናን፡ ደርገ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ አንግፍ፡ እምከሳዴ፡ ነፍስየ፡ ጋገ፨</t:l>
                  <t:l n="4">ሶበ፡ አክበደ፡ ላዕሌየ፡ አርዑተ፡ ቅኔሁ፡ ጸዋግ፨</t:l>
                  <t:l n="5">አርዌ፡ ሕማም፡ ጸዋግ፡ ዘይልሕስ፡ ምስሐገ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">ሰላም፡ ለአማዑቲከ፡ ቅድመ፡ ገጸ፡ ኵሉ፡ ተዓይን፨</t:l>
                  <t:l n="2">በእሳተ፡ ሃይማኖት፡ ዘነደ፡ ከመ፡ ደርሳይን፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ጽጌ፡ ወአስካለ፡ ተድላ፡ ዘወይን፨</t:l>
                  <t:l n="4">ጊዜ፡ ቀሰሙከ፡ ባ ወዓልተ፡ ኵነኔ፡ ወደይን፨</t:l>
                  <t:l n="5">መላእክተ፡ ሰማይ፡ አውኃዙ፡ አንብዓ፡ እምዓይን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="36">
                  <t:l n="1">ሰላም፡ ለንዋየ፡ ውሥጥከ፡ ዘኑባሬሆን፡ አንግዳ፨</t:l>
                  <t:l n="2">ከመ፡ ቀርነ፡ ነጌ፡ ሐዋዝ፡ ውስተ፡ ከርሥከ፡ ሰሌዳ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሥርግው፡ በአክሊለ፡ ሞገስ፡ ፀዓዳ፨</t:l>
                  <t:l n="4">ኢትትሐየይ፡ ሐወዖትየ፡ ምስለ፡ ጊዮርጊስ፡ ዘልዳ፨</t:l>
                  <t:l n="5">እመእደ፡ ጸላኢ፡ ወፀር፡ ለነፍስየ፡ ሮዳ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ሰላም፡ ለዓንብርትከ፡ አምሳለ፡ ማዕከከ፡ ፍሑቅ፨</t:l>
                  <t:l n="2">ወአርአያ፡ ማኅተም፡ ኅርው፡ እንተ፡ ተግበረ፡ እምወርቅ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ አብላ፡ ወብርሃነ፡ ሰማይ፡ ምጡቅ፨</t:l>
                  <t:l n="4">ይደምሰሱ፡ ቅድመ፡ ገጽየ፡ በጸዳልከ፡ መብረቅ፨</t:l>
                  <t:l n="5">አጋንንተ፡ ጽልመት፡ ዘቀትር፡ ወጸዋግ፡ ድድቅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="38">
                  <t:l n="1">ሰላም፡ ለሐቌከ፡ እንዘ፡ ይቀንት፡ መዊአ፨</t:l>
                  <t:l n="2">ውስተ፡ ከብካበ፡ ወልድ፡ መርዓዊ፡ ምስለ፡ ሥነ፡ ብርሃን፡ ዘቦአ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ቅቱል፡ እምድረ፡ ሙላድከ፡ አፍአ፨</t:l>
                  <t:l n="4">ጽድቅከ፡ ወኂሩትከ፡ አመ፡ ርኅበ፡ ዓለም፡ መልአ፨</t:l>
                  <t:l n="5">አምዐይነ፡ ሞት፡ ወሲኦል፡ ፍሥሓ፡ ተኀብአ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="39">
                  <t:l n="1">ሰላም፡ ለአቍያጺከ፡ ዘተመሰላ፡ ድንባዘ፨</t:l>
                  <t:l n="2">ታቦተ፡ ሥጋ፡ ይጹራ፡ አንዘ፡ የዓቅባ፡ ትአዛዘ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ቅቡዕ፡ ዕፍረተ፡ ቅዳሴ፡ ምዑዘ፨</t:l>
                  <t:l n="4">ኲናተ፡ ሕማም፡ ጊዜ፡ ሥጋከ፡ ረገዘ፨</t:l>
                  <t:l n="5">አንብዐ፡ መላእከት፡ ወሰብእ፡ ከመ፡ ማይ፡ ውኅዘ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="40">
                  <t:l n="1">ሰላም፡ ለአብራኪከ፡ ዘኢፈቀዳ፡ አስተብርኮ፨</t:l>
                  <t:l n="2">ለምስል፡ ዘወርቅ፡ ዘእደ፡ ነሀቢ፡ ሰበኮ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ሰማዕት፡ ለአምላከ፡ ሰማይ፡ ዘታመልኮ፨</t:l>
                  <t:l n="4">ባርከኒ፡ ለጽሙድከ፡ አመ፡ ጊዜ፡ ንጹሕ፡ ተልእኮ፨</t:l>
                  <t:l n="5">ከመ፡ ለወልዱ፡ ይሁዳ፡ ያዕቆብ፡ ባረኮ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="41">
                  <t:l n="1">ሰላም፡ ለአእጋሪከ፡ ከመ፡ ሩጸተ፡ ዖፍ፡ ወሐፅ፨</t:l>
                  <t:l n="2">ውስተ፡ ዓውደ፡ ስምዕ፡ ይሥርራ፡ ዘአስተፋጠና፡ ሰረዊጽ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ እኩት፡ ውስተ፡ አናቅጽ፨</t:l>
                  <t:l n="4">ሶበ፡ ይቀርቡኒ፡ መላእክተ፡ ላኳ፡ ወድንጽ፨</t:l>
                  <t:l n="5">መድኃኔ፡ ገጽየ፡ ይኰን፡ ዘዚአከ፡ ገጽ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="42">
                  <t:l n="1">ሰላም፡ ለሰኰናከ፡ ዘስዒሞቱ፡ ከሠተ፨</t:l>
                  <t:l n="2">ለብእሲት፡ አሐቲ፡ ዘኣዕይንቲሃ፡ ዑረተ፨</t:l>
                  <t:l n="3">ገላውዎዴስ፡ ጸጉ፡ ዘጌጋይዳ፡ ስርየተ፨</t:l>
                  <t:l n="4">ለጸድቃንሰ፡ አመ፡ ሰአልከ፡ ምሕረተ፨</t:l>
                  <t:l n="5">ጸሎትከ፡ በቋዒት፡ ኢኮነት፡ መንክርተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="43">
                  <t:l n="1">ሰላም፡ ለመከየድከ፡ መከየደ፡ ብሩር፡ ጽሩይ፨</t:l>
                  <t:l n="2">ዘመልዕልቴሆን፡ ተተከላ፡ አዕማደ፡ ጠባይዕ፡ ሰኑይ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ መስፍን፡ ወሠርዐ፡ መንግሥት፡ ኅሩይ፨</t:l>
                  <t:l n="4">ተብህል፡ በእንቲአከ፡ በአፈ፡ ሆሴዕ፡ ራአይ፨</t:l>
                  <t:l n="5">ለኢይዝራኤል፡ ዕለቱ፡ ዐባይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="44">
                  <t:l n="1">ሰላም፡ ለአፃብዓ፡ እግርከ፡ እንዘ፡ ይትወሀቦን፡ አካል፨</t:l>
                  <t:l n="2">እምድረ፡ መከየድ፡ ዘዓርጋ፡ አምሳለ፡ ሰዊት፡ ወሰብል፨</t:l>
                  <t:l n="3">ገላውዎዴስ፡ ሰማዕት፡ ሰባኬ፡ ቅዱስ፡ ወንጌል፨</t:l>
                  <t:l n="4">ይስቅየኒ፡ ጠለ፡ ሣህልከ፡ አሥር፡ ዘይት፡ ዘይክል፨</t:l>
                  <t:l n="5">ለአውልዓ፡ ገዳም፡ መሪር፡ ወይቡስ፡ ተከል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="45">
                  <t:l n="1">ሰላም፡ ለአጽፋረ፡ እግርከ፡ እምርእሰ፡ አፃብዕ፡ ዘዐርጋ፨</t:l>
                  <t:l n="2">ፅዕዳዊ፡ በረድ፡ ወስን፡ እንዘ፡ ይዛወጋ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ውዱስ፡ ማእከለ፡ ብዙኃን፡ አንግልጋ፨</t:l>
                  <t:l n="4">ያስተበፅዑከ፡ ትዝምደ፡ ኵሉ፡ ዘሥጋ፨</t:l>
                  <t:l n="5">በረድኤትከ፡ ረኪቦሙ፡ ጸጋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="46">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ ዘይመስል፡ አርዘ፨</t:l>
                  <t:l n="2">ዘሠምራተ፡ ምድር፡ ለብሰ፡ ወዘዓየራት፡ ሐዋዘ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ፀሐይ፡ እንተ፡ ትኳንን፡ አብያዘ፨</t:l>
                  <t:l n="4">በሐብለ፡ ፍቅርከ፡ ዘኢሕሊናሁ፡ ተእኅዘ፨</t:l>
                  <t:l n="5">በአፈ፡ ኬፋ፡ ወሳውል፡ ለይኩን፡ ውጉዘ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="47">
                  <t:l n="1">ሰላም፡ ለመልከዕከ፡ ድኅረ፡ በናት፡ ተቀትለ፨</t:l>
                  <t:l n="2">ኅብረ፡ አርአያ፡ ወርቅ፡ ዘይመስል፡ ወዕንቈ፡ ቢረሌ፡ ዕዱለ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ክቡር፡ እስእለከ፡ ስኢለ፨</t:l>
                  <t:l n="4">እስመ፡ ተዘርወ፡ በድነ፡ ሥጋየ፡ ወኮነ፡ ወበለ፨</t:l>
                  <t:l n="5">ስብሐተ፡ ትንሣኤ፡ ምልኦ፡ ወጸግዎ፡ ኀይለ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="48">
                  <t:l n="1">ሰላም፡ ለአተ፡ ነፍስከ፡ በዕለት፡ ዛቲ፨</t:l>
                  <t:l n="2">ቅዱሳነ፡ ሰማይ፡ ወምድር፡ እንተ፡ ይትፌሥሑ፡ ባቲ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ መልአከ፡ ዑቃቤ፡ ሕይወት፡ ለመዋቲ፨</t:l>
                  <t:l n="4">አምሕለከ፡ እግዚኦ፡ በዕበይከ፡ እንታከቲ፨</t:l>
                  <t:l n="5">ጊዜ፡ ተወፅአ፡ ነፍስየ፡ ኢትመንና፡ ላቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="49">
                  <t:l n="1">ሰላም፡ ለበድነ፡ ሥጋከ፡ ዘጥቀ፡ የሐቱ፨</t:l>
                  <t:l n="2">የሐውዕዎ፡ መላእከት፡ ዘያፈትዎሙ፡ ሥነ፡ ርእየቱ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ቡሩክ፡ ለእግዚአብሔር፡ መከፈልተ፡ ርስቱ፨</t:l>
                  <t:l n="4">ሚጠኒ፡ በምሕረትከ፡ እምፍኖተ፡ ጌጋይ፡ ዝንቱ፨</t:l>
                  <t:l n="5">አሥዋከ፡ ደዌ፡ ወሞት፡ ዘተሐፅረ፡ ቦቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="50">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ዘእደ፡ ምእመናን፡ ገንዞ፨</t:l>
                  <t:l n="2">በልብሰ፡ ቅዳሴ፡ ንጹሕ፡ ድኅረ፡ አፈ፡ ኲናት፡ ረገዞ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ስቡሕ፡ ሕገ፡ ጽድቅ፡ ወተአዝዞ፨</t:l>
                  <t:l n="4">ሠውረኒ፡ በምሕረትክ፡ ወናዝዘኒ፡ ናዝዞ፨</t:l>
                  <t:l n="5">እምብካየ፡ ወይሴ፡ መሥጥም፡ ወዓቢይ፡ ተከዞ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="51">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ መካነ፡ ገቦ፡ ደብር፡ ልዑል፨</t:l>
                  <t:l n="2">ድኅረ፡ ሠሰጥከ፡ መዊተ፡ በናተ፡ ሕማም፡ ስሑል፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ተባዕ፡ ወወሬዛ፡ መንግሥት፡ አዛል፨</t:l>
                  <t:l n="4">ትበክየከ፡ አንጾኪያ፡ እንዘ፡ ትኬልሕ፡ ወትብል፨</t:l>
                  <t:l n="5">እፎኑ፡ ታሕተ፡ ከፈር፡ ተኃብአ፡ ጸዳል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="52">
                  <t:l n="1">ናሁ፡ ተግህደ፡ ዘመልክእክ፡ ፍጻሜ፨</t:l>
                  <t:l n="2">እንተ፡ ያረውፅ፡ ፈድፋደ፡ ፄና፡ መዓዛሁ፡ አበሜ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ነፍኒፍ፡ በርእሰ፡ ገላውዴዎስ፡ አምሳለ፡ ጊሜ፨</t:l>
                  <t:l n="4">ጽባሐ፡ በረከተ፡ ወሰዓተ፡ ምሴት፡ ሱላሜ፨</t:l>
                  <t:l n="5">ዘይዌስከ፡ መዋዕለ፡ ወያነውን፡ ዕድሜ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="53">
                  <t:l n="1">ዓፀደ፡ መልክእከ፡ እግዚኦ፡ እንዘ፡ አኃሥሥ፡ ተግባረ፨</t:l>
                  <t:l n="2">ጊዜ፡ ፍና፡ ምሴት፡ ወነግህ፡ እስመ፡ እግረ፡ ልብየ፡ ሖረ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ምክር፡ ወአስተሐይፅ፡ ነገረ፨</t:l>
                  <t:l n="4">ከመ፡ ትጸግወኒ፡ ዕሤተ፡ ተስፋ፡ ጽድቅ፡ ወትረ፨</t:l>
                  <t:l n="5">ምስለ፡ ብእሴ፡ ቅንየት፡ ለዕለት፡ ከበዳ፡ ዘጾረ፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ አሐዱ፡ ሰማዕት፡ መዋዒ፡ እምነ፡ ኅሩያን፡ አእላፍ፨</t:l>
                  <t:l n="2">አንታዔ፡ ፲፻፡ ወሰዳዴ፡ እልፍ፨</t:l>
                  <t:l n="3">ዘገብርኤል፡ ጸዋሬ፡ ሰይፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ውእቱ፡ ሰይፍከ፡ ለሰብእ፡ ቍዝ፡ አምሰትየ፡ ደሞሙ፡ ሰክረ፨</t:l>
                  <t:l n="2">ወእግረ፡ ፈረስከ፡ ኬደ፡ ርእሶ፡ ምቱረ፨</t:l>
                  <t:l n="3">በዜናከ፡ ከመ፡ ተነግረ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ደምሰስክሙ፡ እንተ፡ እምነ፡ አርማን፡ ለእለ፡ ተጋብኡ፡ ፀር፨</t:l>
                  <t:l n="2">በብሔር፡ ዘስሙ፡ ፈለገ፡ ከቦር፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ጥዑመ፡ ዝክር፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ መንግሥተ፡ ምድር፡ መነንከ፡ ዘኖላዌ፡ ጠሲ፡ ወረሶ፨</t:l>
                  <t:l n="2">መንግሥተ፡ ሰማያት፡ ትርከብ፡ በተጸንሶ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ከናፍረ፡ ፍሕሶ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለእኅትከ፡ ተፋስየ፡ ነበልባለ፡ ኃዘን፡ አውዐያ፨</t:l>
                  <t:l n="2">አመ፡ ንግደትከ፡ እምአንጾኪያ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ምክሀ፡ ሮምያ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ከመ፡ አምላክከ፡ ኄር፡ ወጻድቅ፡ በዓመፃ፡ ዘአልቦ፨</t:l>
                  <t:l n="2">በአፈ፡ ኲናት፡ ክላሌ፡ አንተቦ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ርጉዘ፡ ገቦ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ እስመ፡ እፈቱ፡ ርእየ፡ ስነ፡ ገጽከ፡ ልሑየ፨</t:l>
                  <t:l n="2">ምስለ፡ እኁከ፡ ፊቅጦር፡ እግዚእየ፨</t:l>
                  <t:l n="3">ገላውዴዎስ፡ ነዓ፡ በስዓ፡ ሞትየ፨</t:l>
                  <t:l n="4">ትንብብ፡ ሰላመከ፡ ለኃጥአት፡ ነፍስየ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>