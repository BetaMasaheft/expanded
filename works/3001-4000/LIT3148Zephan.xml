         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3148Zephan">
            <t:note>Text of the EOTC printed Bible</t:note>
            <t:div type="textpart" subtype="chapter" n="1" xml:id="chapter1">
               <t:label>Chapter 1</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=1"/>ቃለ፡ እግዚአብሔር፡ ዘኮነ፡ ኀበ፡ ሰፎንያስ፡ ወልደ፡ ኲስ፡ ወልደ፡ ጎዶልያ፡ አሞራዊ፡ ዘሴዴቅያ፡ በመዋዕለ፡ ኢዮሰያስ፡ ወልደ፡ አሞጽ፡ ንጉሠ፡ ይሁዳ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=2"/>ኀሊቀ፡ የኀልቅ፡ እግገጸ፡ ምድር፡ ይቤ፡ እግዚአብሔር።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=3"/>የኀልቅ፡ ሰብእ፡ ወእንስሳ፡ ወየኀልቁ፡ አዕዋፈ፡ ሰማይ፡ ወዓሳተ፡ ባሕር፡ ዋይደክሙ፡ ኃጥኦነ፡ ወአጠፍኦሙ፡ ለዓማፅያን፡ ምገጸ፡ ምድር፡ ይቤ፡ እግዚአብሔር።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=4"/>ወአነስእ፡ እዴየ፡ ላዕለ፡ ይሁዳ፡ ወላዕለ፡ ኲሎሙ፡ እለ፡ ይነብሩ፡ ለኢየሩሳሌም፡ ወእስዕሮሙ፡ እምዝንቱ፡ ብሔር፡ አስማሆሙ፡ ለበዓል፡ ዋኣስማተ፡ ማርያን።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=5"/>ወእለ፡ ይሰግዱ፡ ለሰገዱ፡ ለከከዋክበተ፡ ሰማይ፡ በአንሕስት፡ ወእለ፡ ይምሕሉ፡ በስመ፡ እግዚአብሔር፡ ንጉሶሙ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=6"/>ወእለ፡ ይትገሐሱ፡ እምግዚአብሔር፡ ወእለ፡ ኢይትኤዘዙ፡ ለእግዚአብሔር።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=7"/>ፍርሁ፡ እምቅድመ፡ ገጹ፡ ለእግዚአብሔር፡ አምላከ፡ እስመ፡ አልጸቀት፡ ዕለተ፡ እግዚአብሔር፡ እስመ፡ አስተዳወ፡ አግዚአበሔር፡ መስዋዕቶ፡ ወቀደሶሙ፡ ለኀሩያኒሁ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=8"/>ወይከውን፡ በእለተ፡ መስዋዕቱ፡ ለእግዚአብሔር፡ ውትቤቀሎሙ፡ ለመላክት፡ ወለቤተ፡ ነጉስ፡ ወልኲሎሙ፡ እለ፡ ለብሱ፡ አልባሰ፡ ነኪር።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=9"/>ወእትቤቀሎሙ፡ ለኲሎሙ፡ ገሀደ፡ ባውስተ፡ አናቅጽ፡ ይእተ፡ አሚረ፡ እለ፡ የመልኡ፡ ቤተ፡ እግዚአብሔር፡ አምላኮሙ፡ ዓመፃ፡ ወጽልሑተ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=10"/>ወይከውን፡ ይእቲ፡ እለት፡ ይበ፡ እግዚአብሔር፡ ቃለ፡ አውያት፡ ምአናቅጽ፡ እምእለ፡ ይወግኡ፡ ወውውዓ፡ እምውስተጥ፡ ወቀትል፡ ዓቢይ፡ ውስተ፡ አውግር።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=11"/>ብክዩ፡ እለ፡ ትነብሩ፡ ውስተ፡ ቅትል፡ እስመ፡ ይመስሉ፡ ኲሉ፡ ሕዝበ፡ ከናን፡ ወተሠረዉ፡ ኰሎሙ፡ እለ፡ ይትዔበዩ፡ በወርቅ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=12"/>ወይከውነ፡ ይእተ፡ ዕለተ፡ ይቤ፡ እግዚአብሔር፡ እፈትና፡ ለኢየሩሳሌም፡ በምሀቶተ፡ ጥበብ፡ ወእትቤቀለሙ፡ ለዕደው፡ እለ፡ ያስተሐቅሩ፡ ሕጎሙ፡ እንዘ፡ ይብሉ፡ ኢያሤኒ፡ ወኢያሐስም፡ እግዚአብሔር።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=13"/>ወየኀስር፡ ኃይሎሙ፡ ወይትበረበራ፡ አብያቲሆሙ። ወየሐንጹጹ፡ እብያተ፡ ወኢይነብርዎን፡ ወይተክሉ፡ ወይነ፡ ወኢይሰትይዎ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=14"/>እስመ፡ አልጸቀት፡ ዕለተ፡ እግዚአብሔር፡ ዓባይ፡ ቀርበት፡ ወአፍጠነት፡ ጥቀ፡ ድምፃ፡ ለዕለተ፡ እግዚአብሔር፡ መራር፡ ውእኪት።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=15"/>ጽንዕት፡ ይእቲ፡ ዕለተ፡ መንሱት፡ ዕለተ፡ ሕማም፡ ወምንዳቤ፡ ዕለተ፡ ምምዓ፡ ወሙስና፡ ዕለተ፡ ጽልመት፡ ወቆባር፡ ዕለተ፡ ደመና፡ ወጊሜ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=16"/>ዕለተ፡ ቀርን፡ ወውውዓ፡ ላዕለ፡ አህጉር፡ ጽኑዓት፡ ወላዕለ፡ በሐውርት፡ ልዑላት።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=17"/>ወአመነድቦሙ፡ ለሰብእ፡ ወየሐውሩ፡ ከመ፡ ዕውራን፡ እስመ፡ አበሱ፡ ለእግዚአብሔር፡ ወይክዕዉ፡ ደሞሙ፡ ከመ፡ ጸበል፡ ወይከዕዉ፡ ደሞሙ፡ ከመ፡ ጸበል፡ ወስጋሆሙ፡ ከመ፡ ጽፍፅ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=1&amp;verse=18"/>ወኢያድኀኖሙ፡ ወርቆሙ፡ ወብሩሮሙ፡ እምዕለተ፡ ማዓቱ፡ ለእግዚአብሔር፡ ወእምእሳተ፡ ቅንአቁ፡ ትጠፍእ፡ ኲላ፡ ምድር፡ እስመ፡ ፍጡነ፡ ያኀልቆሙ፡ ለእለ፡ ይነብሩ፡ ውስተ፡ ምድር።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="2" xml:id="chapter2">
               <t:label>Chapter 2</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=1"/>ተጋብኡ፡ ወተጋነዩሕዝብ፡ አብዳን።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=2"/>ዘእንበለ፡ ትኩኑ፡ ከመ፡ ጽጌ፡ ይቡስ፡ ዘወድቀ፡ ዘእንበለ፡ ትብጽ፡ ሕክሙ፡ ዕለት፡ መዐቱ፡ ለእግዚአብሔር።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=3"/>ኀሥዋ፡ ለእግዚአብሔር፡ ኩልክሙ፡ ትሑታነ፡ ምድር፡ ተገበሩ፡ ጽድቀ፡ ወኀሥዋ፡ ለርትዕ፡ ወአዉሥእዋ፡ ከመ፡ ትትከደኑ፡ እምዕለተ፡ መዐቱ፡ ለእግዚአብሔር።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=4"/>እስመ፡ ትትበረበር፡ ጋዛ፡ ወትጠፍእ፡ አስቃሎን፡ ወይገፈትዕዋ፡ ለአዛጦን፡ ቀተረ፡ ወይሤርዉዋ፡ ለአቃሮን።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=5"/>አሌሉሙ፡ ለእለ፡ ይነብር፡ ጥቃ፡ ባሕር፡ ፈላስያነ፡ ቀርጠዉ። ቃለ፡ እግዚአብሔር፡ ላዕሌክሙ፡ ከናአን፡ ምድረ፡ ኢሎፍሊ፡ ወአጠፍአክሙ፡ እምበዐዉርቲክሙ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=6"/>ወትክዉን፡ ቀርጤ፡ ጺኦተ፡ መራዕይ፡ ወምርዓየ፡ አባግዕ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=7"/>ወይከዉን፡ በሐዉርተ፡ ባሕር፡ ልለ፡ ተርፉ፡ ይሁዳ፡ ወይትረዐይዋሙ፡ በዉሰተ፡ አብያተ፡ አስቃሎን፡ ዱንጉፃኒሆሙ፡ ይነብሩ፡ ምቅዱመ፡ ገጾሙ፡ ለደቂቀ፡ ይሁዳ፡ እሰመ፡ ተሠሀሎሙ፡ እግዚአብሔር፡ አምላኮሙ፡ ወሜጠ፡ ፄዋሆሙ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=8"/>ወስምዐ፡ እግዚአብሔር፡ ጹዕለተ፡ ሞአብ፡ ወኩርዓቶሙ፡ ለደቀቀ፡ አሞን፡ ዘከመ፡ አኀሠርዎሙ፡ ለሕዝብየ፡ ወተዝሀኀሩ፡ ላዕለ፡ ብሔርየ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=9"/>በእንተ፡ ዝንቱ፡ ሕያዉነ፡ የቤ፡ እግዚአብሔር፡ ኃያል፡ አምላክ፡ እስራኤል፡ እስመ፡ ሞአብኒ፡ ከመ፡ ሰዶም፡ ትከዉን፡ ወደቂቀ፡ አሞን፡ ከመ፡ ገሞራ፡ ወደማስቆኒ፡ ተኀልቅ፡ ከመ፡ ክምረ፡ እክል፡ ወትማስን፡ ለዓለም፡ ወእለ፡ ተርፉ፡ ሕዝብየ፡ ይበረብርዎሙ፡ ወይወርሰዎሙ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=10"/>ወዛቲ፡ ትክዉኖሙ፡ ህየንተ፡ ጽዕለቶሙ፡ እስመ፡ አመ፡ ነስሐ፡ ወተዐበዩ፡ ላዕለ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=11"/>ወይመጽእ፡ እግዚአብሔር፡ ላዕሌሆሙ፡ ወየሤርዎሙ፡ ለኩሉሙ፡ አማልክተ፡ አሕዛበ፡ ምድር፡ ወይስግዱ፡ ሎቱ፡ ዱሉሙ፡ በበበሐዉርቲሆሙ፡ ኩሉ፡ ደስያተ፡ አሕዛብ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=12"/>ወአንትሙሂ፡ ኢትዮጽያ፡ ቱላን፡ በኩናትየ፡ አንትሙ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=13"/>ወአነሥእ፡ እዴየ፡ ላዕለ፡ ደቡብ፡ ወአጠፍአሙ፡ ለፋርስ፡ ወእሬስያ፡ መዝብረ፡ ለነነዌ፡ ከመ፡ በዱዉ፡ ዘልቦ፡ ማየ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=14"/>ወይትረዐይ፡ መራዕይ፡ በማእከላ፡ ወሉሉ፡ አርዌ፡ ገዳም፡ ወአርዌ፡ ምድር፡ ወይነብሩ፡ ዕቃርብ፡ ዉስተ፡ ጺኦታ፡ ወይነቅዉ፡ አራዊተ፡ ገዳም፡ ዉስተ፡ አፍላጊሃ፡ ወቋዓት፡ ዉስተ፡ አናቅጺሃ፡ እስመ፡ ከመ፡ አርዝ፡ ኑኃ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=2&amp;verse=15"/>ዛቲ፡ ሀገር፡ ዓማፂት፡ እንተ፡ ትነብር፡ ተአሚና፡ እንተ፡ ትብል፡ በልባ፡ እነ፡ ክመ፡ ወአልቦ፡ እንተ፡ ከማየ። እፎ፡ ማስነት፡ ወኮት፡ ምርዓየ፡ ለአርዌ፡ ገዳም፡ ኩሉ፡ ዘየኀል፡ እንተ፡ ላዕሌሃ፡ ይትፋጽይ፡ ወይጠፍሕ፡ በእደዊሁ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="3" xml:id="chapter3">
               <t:label>Chapter 3</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=1"/>አላህይተ፡ ወሠናይት፡ ርግብ፡ ሀገር፡ እንተ፡ ኢትሰምዕ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=2"/>ወእትትዌክፍ፡ ተግሣጽ፡ ወእትትዌክል፡ በእግዚአብሔር፡ ወኢቀርበት፡ ኀበ፡ አምላክ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=3"/>ወመላእክቲኒ፡ በዉስቴታ፡ ይጥሕሩ፡ ከመ፡ አንበሳ፡ ወዓበይታኒ፡ ከመ፡ ተኩላተ፡ ዐረብ፡ እለ፡ ኢያበይቱ፡ ሌሙ፡ ለነግህ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=4"/>ነበያቲሃኒ፡ ዕዱ፡ መስተአብዳን፡ ወካህናቲሃኒ፡ ያረኩስ፡ መቅደስ፡ ወየዐልዉ፡ ሕገ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=5"/>ወእግዚአብሔርስ፡ ጻድቅ፡ በማእከላ፡ ኢይገብር፡ ዓመፃ፡ ወበጹባሕ፡ ይሁብ፡ ኩነኔሁ፡ ወእተኀብአ፡ ወኢየአምር፡ ዓመፃ፡ ዉሰተ፡ ሐተታ፡ ወኢዉሰተ፡ ተሰናን፡ ግፍዐ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=6"/>ወነሕክዎሙ፡ ለዕብያን፡ በሞት፡ ወማስነ፡ በሐዉርቲሆሙ፡ ወአበዲ፡ ፍኖቶሙ፡ ለግዉራ፡ ለመኢይክሀሉ፡ ኀሊፈ፡ ወኀልቃ፡ አህሉሪሆሙ፡ ወአልቦ፡ ዘተርፈ፡ ዘይነብሮን።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=7"/>ወእቤፍርሁኒ፡ ወተወክፉ፡ ተግሣጽየ፡ ወኢትሤረዉ፡ እምቅድመ፡ አዕይንትየ፡ በኩሉ፡ ዘተበቀልክዋ፡ ትደሎ፡ ትጊሥ፡ እስመ፡ ማሰነ፡ ኩሉ፡ ሠርፆሙ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=8"/>በእንተ፡ ዝንቱ፡ ተዐገሠኒ፡ መ፡ እትነሣእ፡ ይቤ፡ እግዚአብሔር፡ ከመ፡ አስምዕ፡ እስመ፡ ኩነኔየ፡ ላዕለ፡ ማኅቨረ፡ አሕዛብ፡ ከመ፡ ይትመየጡ፡ ነገሥት፡ ወእከሁ፡ ላዕሌሆሙ፡ መቅሠፍተ፡ መዐትየ፡ አስመ፡ ታጠፍአ፡ ለኩላ፡ ምር፡ አሳተ፡ ቅንአትየ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=9"/>እስመ፡ ይአተ፡ አሚረ፡ እመይጥ፡ ልሳኖሙ፡ ለአሕዛብ፡ በመዋዕሊሃ፡ ከመ፡ ኩሉ፡ ይጽዉዕ፡ ስመ፡ እግዚአብሔር፡ ከመ፡ ይትቀነዩ፡ ሎቱ፡ በአሐዱ፡ አርዑት።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=10"/>ይእተ፡ አሚረ፡ እትትኀፈር፡ ምኩሉ፡ ጌጋይከ፡ ዘአበስከ፡ ሊተ፡ የእተ፡ አሚረ፡ አአትት፡ ኃሣረ፡ ጽዕለትክ፡ ወኢትደግም፡ እንክ፡ አዕብዩ፡ አፉክ፡ ላዕለ፡ ደብረ፡ መቅደስየ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=11"/>ወአተርፍ፡ ሕዝበ፡ የዋሐ፡ ወትሑተ፡ ለከ፡ ወይፈርሁ፡ ስመ፡ እግዚአብሔር።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=12"/>እለ፡ ተርፉ፡ እምእስራኤል፡ ወኢይገብሩ፡ እንክ፡ ዓመፃ፡ ወኢይነቡ፡ ከንቶ፡ ወኢይትረከብ፡ ዉስተ፡ አፉሆሙ፡ ልሳነ፡ ጽልሑት፡ ወይነብሩ፡ ወይትረዐዩ፡ ወአልቦ፡ ዘይጌረሞሙ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=13"/>ተፈሥሒ፡ ወለተ፡ ጽዮን፡ ወስብኪ፡ ወለተ፡ ኢየሩሳሌም፡ ተፈሥሒ፡ ወተኀሠዩ፡ በኩሉ፡ ልብኪ፡ ወለተ፡ እየሩሳሌም።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=14"/>አእተተ፡ እግዚአብሔር፡ ግፍዐኪ፡ ወባልሐኪ፡ እምእይ፡ እኩይ፡ ወይነግሥ፡ እግዚአብሔር፡ በማእኬኪ፡ ወኢትሬእዩ፡ እንክ፡ እኪተ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=15"/>ይእተ፡ አሚረ፡ ይቤላ፡ እግዚአብሔር፡ ለእየሩሳሌም፡ አጥብዒ፡ ጹዮን፡ ወአይድክማ፡ እደዉኪ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=16"/>እግዚአብሔር፡ አምላክኪ፡ ምስሌኪ፡ ወይክል፡ አድኅኖተኪ፡ ወያመጽእ፡ ላዕሌኪ፡ ፍሥሐ፡ ወይሔድስኪ፡ በፍቅሩ፡ ወይትፌሣሕ፡ ብኪ፡ በኃሤት፡ ከመ፡ ዕለተ፡ በዓል።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=17"/>ወአስተጋብኦሙ፡ ለቅጥቁጣንኪ፡ አሌሎ፡ ለዘአንሥአ፡ ጽዕለተ፡ ላዕሌሃ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=18"/>ናሁ፡ አነ፡ እንብር፡ በዉስቴትኪ፡ ይእተ፡ አሚረ፡ ይቤ፡ እግዚአብሔር፡ ወአድኀና፡ ለግድፍት፡ ወእትዌክፉ፡ ለምንዱብት፡ ወእትዌክፉ፡ ለምንዱብት፡ ወእሬስዩሙ፡ ለምክሕ፡ ስሙያን፡ በኩሉ፡ ምድር፡ ወኢይትኀፍሩ፡ ብኪ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Zep&amp;chapter=3&amp;verse=19"/>ይእተ፡ አሚረ፡ አመ፡ አሠነይኩ፡ ወእመ፡ ተወከፍኩክሙ፡ ወእሩስየክሙ፡ ስሙያነ፡ ወምክሐ፡ ለአሕዛቢያ፡ አመ፡ ሜጥኩ፡ ፄዋክሙ፡ በቅድሜክሙ፡ ይቤ፡ እግዚአብሔር።</t:l>
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>