         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3045RepCh325">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">አአኵተከ፡ ክርስቶስ፡ ዘከፈልከኒ፡ ለወጢነ።</t:l>
                  <t:l n="2">ለአፈጽሞ፡ ርድአኒ፡ ባሕቱ፡ በዘዚአከ፡ ሥልጣን፨</t:l>
                  <t:l n="3">ማሕሌተ፡ መልክኡ፡ እዜኑ፡ ለሰረባሞን፨</t:l>
                  <t:l n="4">ወምላእ፡ ማየ፡ አእምሮ፡ ውስተ፡ ልብየ፡ አይገን፨</t:l>
                  <t:l n="5">ዘያሌ፡ ብወኒ፡ ኀይለ፡ ቃል፡ ዘቦቱ፡ ብፅዓን፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘኆኅያቲሁ፡ ልክዕ፨</t:l>
                  <t:l n="2">በኢየሩሳሌም፡ ዘላዕሉ፡ ኀበ፡ ዓምደ፡ ብርሃን፡ ርትዕ፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ሰማዕቱ፡ ለርጉዘ፡ ገቦ፡ በግዕ፨</t:l>
                  <t:l n="4">ከመ፡ እዜኑ፡ ውዳሴሁ፡ ለዘዚአከ፡ መልክዕ፨</t:l>
                  <t:l n="5">ጸጋ፡ መንፈስ፡ ቅዱስ፡ ሀበኒ፡ ለብእሲ፡ ኅጡእ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለሥዕርትከ፡ በሕሊና፡ አምላክ፡ ኍልቍ፨</t:l>
                  <t:l n="2">ወለርእስከ፡ ክሉል፡ በአክሊለ፡ ግርማ፡ ዘዕንቍ፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ኅሩይ፡ ወጽኑዕ፡ እምህቍ፨</t:l>
                  <t:l n="4">አብሐኒ፡ አምሥጥ፡ በጽድከ፡ እመሥገርተ፡ ሰይጣን፡ ጕሑቍ፨</t:l>
                  <t:l n="5">ከመ፡ እመሥገርት፡ ታመሥጥ፡ ምዳቍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ ለኒቅዩስ፡ በአዕፃዲሃ፨</t:l>
                  <t:l n="2">ድኅረ፡ ከመ፡ መርዓት፡ ነበረት፡ ኪያከ፡ እንዘ፡ ትጻንሕ፡ ጸኒሐ፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ፍሡሕ፡ ለቤተ፡ ክርስቲያን፡ መርዓዊሃ፨</t:l>
                  <t:l n="4">በድነ፡ ሥጋከ፡ ኀቤሃ፡ በጊዜ፡ በጽሐ፡ ኣሜሃ፨</t:l>
                  <t:l n="5">ተፈሥሑ፡ አፍሕርቲሃ፡ ዐቢየ፡ ፍሥሓ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለትንሣኤከ፡ ድኅረ፡ ግብር፡ ተመስወ፡ ወውዕየ፨</t:l>
                  <t:l n="2">እለ፡ በክርስቶስ፡ ትንሣኤ፡ አመ፡ ይቀድሙ፡ በዝየ፨</t:l>
                  <t:l n="3">እስመ፡ አሰፈወከ፡ ክርስቶስ፡ ተስፋ፡ ሠናየ፨</t:l>
                  <t:l n="4">ወይቤለከ፡ ሰረባሞን፡ እንዘ፡ ይነብብ፡ ሰደየ፨</t:l>
                  <t:l n="5">አነ፡ አነሥኦ፡ ምስሌየ፡ በትንሣኤየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ናሁ፡ ነገርኩ፡ ስመከ፡ ለሰብእ፨</t:l>
                  <t:l n="2">ወማሕሌተከ፡ ፈጸምኩ፡ በቃለ፡ ሰላም፡ ጥዕጡዕ፨</t:l>
                  <t:l n="3">እንዘ፡ ትቀድሕ፡ ቀለመ፡ እምደምከ፡ ርጉዕ፨</t:l>
                  <t:l n="4">ጸሐፍ፡ ዘንተ፡ ሰረባሞን፡ በጸፍጸፈ፡ ሰማይ፡ ሳብዕ፨</t:l>
                  <t:l n="5">ከመ፡ ያንብብዎ፡ እለ፡ ርእዩ፡ መላእክት፡ ወሰብእ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">አመ፡ ዕሥራሁ፡ ለወርኀ፡ ሰኔ፡ ወሰሙኑ፡ እምዕለታት፨</t:l>
                  <t:l n="2">ለቅዳሴ፡ ቤትከ፡ ዮም፡ ዘበኒቅዩስ፡ ሕንጽት፨</t:l>
                  <t:l n="3">እለ፡ ተጋብኡ፡ ደርገ፡ ሰረባሞን፡ ማኅቶት፤</t:l>
                  <t:l n="4">ባሕርየ፡ ሥጋከ፡ ሶበ፡ አብኡ፡ ካህናት፨</t:l>
                  <t:l n="5">ከመ፡ ቀስተ፡ ደመና፡ ዘክረምት፡ ኦደከ፡ ስብሐት፤</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለከ፡ ሰረባሞን፡ ሰማዕት፡ በረድኤትከ፡ ከሃሊ፨</t:l>
                  <t:l n="2">ዘአኅሠርከ፡ አንተ፡ ለመልአክ፡ ማሕጐሊ፨</t:l>
                  <t:l n="3">ወቀነይከ፡ ከመ፡ ጳውሊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ ዘተዐገሥከ፡ ፈድፉደ፡ ሥቃየ፡ ኵነኔ፡ ዕፁብ፨</t:l>
                  <t:l n="2">እንዘ፡ ይረድአከ፡ መንፈሰ፡ ጥበብ፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ልሳነ፡ ዘርብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለከ፡ ወዕረፍትከ፡ ዘኮነ፡ ምስለ፡ እለ፡ አብርሃም፡ ዘይት፨</t:l>
                  <t:l n="2">ወምስለ፡ ሊቃኖስ፡ ጻድቅ፡ ብእሴ፡ ትዕግሥት፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ጽጌ፡ ገነት፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለከ፡ ለሐውጾትነ፡ ንዑ፡ ከመ፡ ሐውጸ፡ ቢጽ፡ ወዓርክ፨</t:l>
                  <t:l n="2">ለለ፡ ጊዜ፡ ጽባሕ፡ ወጊዜ፡ ሰርክ፨</t:l>
                  <t:l n="3">ሰረባሞን፡ ምእመን፡ ወሊቃኖስ፡ ቡሩክ፨</t:l>
                  <t:l n="4">ውስተ፡ ዓውዳ፡ ለዛቲ፡ ምስማክ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>