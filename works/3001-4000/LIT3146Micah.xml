      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/P5DUDEHE"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Fuhs1968Micah"/><title level="m">Die äthiopische Übersetzung des Propheten Micha: Edition und textkritischer Kommentar nach den Handschriften in Oxford, London, Paris, Cambridge, Wien und Frankfurt am Main</title><title level="s">Bonner biblische Beiträge</title><author><t:forename>Hans Ferdinand</t:forename><t:surname>Fuhs</t:surname></author><pubPlace>Bonn</pubPlace><publisher>Peter Hanstein Verlag</publisher><date>1968</date><series><t:title level="s">Bonner biblische Beiträge</t:title><t:biblScope unit="volume">28</t:biblScope></series><biblScope unit="volume">28</biblScope></t:bibl>
            </t:listBibl>
