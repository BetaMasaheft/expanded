         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3023RepCh303">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ድንግልተ፡ ሥጋ፡ ወኅሊና፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ወለተ፡ ኢያቄም፡ ወሐና፨</t:l>
                  <t:l n="3">ጳጦስ፡ አንቲ፡ ዘአስተርአይኪ፡ በደብረ፡ ሲና፨</t:l>
                  <t:l n="4">ጎሞረ፡ ወርቅየ፡ መስፈርቱ፡ ለመና፨</t:l>
                  <t:l n="5">ማርያም፡ ለዕበይኪ፡ ይደሉ፡ መሐና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ድንግልተ፡ ኅሊና፡ ወሥጋ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ እንበለ፡ ሕፀት፡ ወንትጋ፨</t:l>
                  <t:l n="3">ተፈሥሒ፡ አንቀጽ፡ ዘኢተርኅወ፡ መንስጋ፨</t:l>
                  <t:l n="4">ለነፍሰ፡ ዚአየ፡ ውስተ፡ ሲኦል፡ ኢይኅድጋ፨</t:l>
                  <t:l n="5">ፍሬ፡ ማሕፀንኪ፡ ወልድ፡ ይክፍለኒ፡ ጸጋ፨</t:l>
                  <t:l n="6">ኀበ፡ ይገብሩ፡ ኅሩያን፡ እንግልጋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ይደልወኪ፡ ተፍሥሖ፨</t:l>
                  <t:l n="2">ተራኅርኂ፡ ድንግል፡ ዘልማድኪ፡ ተራኅርኆ፨</t:l>
                  <t:l n="3">ገብርኪ፡ ኃጥእ፡ ሶበ፡ ጸራኅኩ፡ በክልሖ፨</t:l>
                  <t:l n="4">ለቃለ፡ አፉየ፡ ተወኪፈኪ፡ ጽራሖ፨</t:l>
                  <t:l n="5">ኦሆ፡ ኦሆ፡ በልኒ፡ ኦሆ፨</t:l>
                  <t:l n="6">ለቤተ፡ መርዐ፡ እሁበከ፡ መርኆ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ተፈሥሒ፡ ማርይማ፡ ወለተ፡ ሳራ፡ ወርብቃ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ለደወለ፡ ርስት፡ ማዕንቃ፨</t:l>
                  <t:l n="3">ለረዲኦትየ፡ ፍጡነ፡ እንዘ፡ ትሰወጢ፡ ከመ፡ ባዜቃ፨</t:l>
                  <t:l n="4">ብጽሒ፡ በኢጐንድዮ፡ ኀበ፡ ሀሎኩ፡ ጥቃ፨</t:l>
                  <t:l n="5">ከመ፡ ትፈጽሚ፡ ለልብየ፡ ጻሕቃ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ እንተ፡ አልብኪ፡ ምሳሌ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ታቦተ፡ ሕርመት፡ ዘጽሌ፨</t:l>
                  <t:l n="3">ተፈሥሒ፡ ጽሪት፡ ዘዕፍረትየ፡ ቢረሌ፨</t:l>
                  <t:l n="4">አስተበፅዕ፡ አንሰ፡ በጉባኤ፡ ዘለኪ፡ ድንጋሌ፨</t:l>
                  <t:l n="5">በኢውልዋሌ፡ እንዘ፡ እብል፡ ሃሌ፨</t:l>
                  <t:l n="6">አንግፍኒ፡ በትንባሌ፡ እምብካይ፡ ወወይሌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ በአክናፈ፡ ንጽሕኪ፡ ምንታዌ፨</t:l>
                  <t:l n="2">ዘአምሠጥኪ፡ ቅድመ፡ እምቂአተ፡ ሕምዙ፡ ለአርዌ፨</t:l>
                  <t:l n="3">መጽሐፈ፡ ብስራት፡ ይብሉኪ፡ ለእለ፡ ሀለዉ፡ ምድረ፡ ፄዋዌ፨</t:l>
                  <t:l n="4">መክፈልተ፡ ርስትየ፡ አንቲ፡ ማርያም፡ እንተ፡ አልብኪ፡ ምንሳዌ፨</t:l>
                  <t:l n="5">ዘፈለጠ፡ ሊተ፡ ኢያሱ፡ ዘነዌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ወለተ፡ አዳም፡ ወሔዋ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ሐዳስዩ፡ ጣዕዋ፨</t:l>
                  <t:l n="3">ርጢነ፡ መድኀኒት፡ ወልድኪ፡ ለቍስልየ፡ ዘየሐይዋ፨</t:l>
                  <t:l n="4">አውቅይዮ፡ በሰይፍኪ፡ ሐርየ፡ ነዋ፨</t:l>
                  <t:l n="5">ሰይጣን፡ ስሙ፡ ለንፍስየ፡ ዕድዋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ በከመ፡ ገብርኤል፡ መልአክ፨</t:l>
                  <t:l n="2">ቡርክት፡ አንቲ፡ እምአንስት፡ ወፍሬ፡ ከርሥኪ፡ ቡሩክ፨</t:l>
                  <t:l n="3">ለዕበየ፡ ንግሥኪ፡ ዘልፈ፡ እንዘ፡ እሰድግ፡ በብረክ፨</t:l>
                  <t:l n="4">አመሥጥ፡ አንሰ፡ በጽንዕኪ፡ ዘእምፀርየ፡ ድሩክ፨</t:l>
                  <t:l n="5">ዘይፈቅድ፡ ይንዐወን፡ በጽባሕ፡ ወሰርክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ሠርጐ፡ አሮን፡ ሌዋዊ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ወለተ፡ ዳዊት፡ ሰንቃዊ፨</t:l>
                  <t:l n="3">ሙካፈ፡ ስእለቱ፡ ለኢዮብ፡ አመ፡ በቍስሉ፡ ይደዊ፨</t:l>
                  <t:l n="4">ከመ፡ ትሂጵዮ፡ ለፀርየ፡ ነፍሳተ፡ ብዙኃን፡ ነዓዊ፨</t:l>
                  <t:l n="5">በዲበ፡ አብትር፡ ቅስተኪ፡ ቅስትዊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ተፈሥሒ፡ ማርያም፡ ዘኢየሐልቅ፡ ትፍሥሕትኪ፨</t:l>
                  <t:l n="2">ተፈሥሒ፡ ማርያም፡ ዘኢይቀብል፡ መዝገብኪ፨</t:l>
                  <t:l n="3">ተፈሥሒ፡ ማርያም፡ ዘኢይትፌጸም፡ ውዳሴኪ፨</t:l>
                  <t:l n="4">ኢትመንንኒ፡ ለገብርኪ፡ ዘአጥረየኒ፡ ወልድኪ፨</t:l>
                  <t:l n="5">እስመ፡ አንቲ፡ ሊተ፡ ወአነ፡ ዘለኪ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">በመኑ፡ እትሜካሕ፡ ማርያም፡ ዘእንበሌኪ፡ ምክሕየ፨</t:l>
                  <t:l n="2">ቀርነ፡ መድኀኒትየ፨</t:l>
                  <t:l n="3">ብኪ፡ ጸናዕኩ፡ እምከርሠ፡ እምየ፨</t:l>
                  <t:l n="4">ማርያም፡ ጠረጴዛሁ፡ ለቍርባነ፡ ወንጌል፡ ብልዕየ፨</t:l>
                  <t:l n="5">ውስተ፡ እዴኪ፡ ገደፍኩ፡ ነፍስየ፡ ወሥጋየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">በመኑ፡ እከብር፡ ማርያም፡ ዘእንበሌኪ፡ ክብረ፡ ኵሉ፨</t:l>
                  <t:l n="2">ነቅዐ፡ መድር፡ ለኪ፡ ወጠለ፡ ሰማይ፡ ዘላዕሉ</t:l>
                  <t:l n="3">አንቲ፡ ውእቱ፡ ለዳዊት፡ ሠርጐ፡ አክሊሉ፨</t:l>
                  <t:l n="4">ብኪ፡ ኤለ፡ ተወከሉ፡ ኢተኀፍሩ፡ ወኢትኀጕሉ?</t:l>
                  <t:l n="5">መገቦሙ፡ ወመርሖሙ፡ ለወልድኪ፡ ሣህሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">በመኑ፡ እትፌሣሕ፡ ማርያም፡ ዘእንበሌኪ፡ ፍሥሓ፨</t:l>
                  <t:l n="2">እንተ፡ ወለድኪ፡ መሲሐ፨</t:l>
                  <t:l n="3">ከመ፡ እኅሊ፡ ለኪ፡ ምሕረተ፡ ወፍትሐ፨</t:l>
                  <t:l n="4">ሶበ፡ እዜከር፡ ርኅራኄኪ፡ ንኅኑኀ፡ ወዝኅዙኀ፨</t:l>
                  <t:l n="5">እምሀኬቱ፡ ኅሊናየ፡ ነቅሀ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ምንተኑ፡ ኣዐሥየኪ፡ ዕሤተ፨</t:l>
                  <t:l n="2">በእንተ፡ ኵሉ፡ ዘገበርኪ፡ ሊተ፨</t:l>
                  <t:l n="3">ማርያም፡ ሠናይት፡ ዘታፈቅሪ፡ ምሕረተ፨</t:l>
                  <t:l n="4">ሶበሰ፡ ትትዐቀቢ፡ ዘዚአየ፡ ኃጢአተ፨</t:l>
                  <t:l n="5">እመ፡ ኢሐየውኩ፡ አሐተ፡ ሰዓተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">በሰላመ፡ ገብርኤል፡ መልአክ፡ እግዝእትየ፡ ማርያም፡ ሰላም፡ ለኪ፨</t:l>
                  <t:l n="2">ድንግልት፡ በኅሊናኪ፡ ወድንግልት፡ በሥጋኪ፨</t:l>
                  <t:l n="3">እመ፡ እግዚአብሔር፡ ጸባኦት፡ ሰላም፡ ለኪ፨</t:l>
                  <t:l n="4">ቡርክት፡ አንቲ፡ እምአንስት፡ ወቡሩክ፡ ፍሬ፡ ከርሥኪ፨</t:l>
                  <t:l n="5">ተፈሥሒ፡ ፍሥሕት፡ ኦምልእተ፡ ጸጋ፡ እግዚአብሔር፡ ምስሌኪ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>         
      </t:body>
      </t:text></TEI>