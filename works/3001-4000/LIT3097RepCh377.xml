         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3097RepCh377">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">በስመ፡ እግዚአብሔር፡ ሕያው፡ ዘኢትመውት፡ አምላክ፨</t:l>
                  <t:l n="2">ወበስመ፡ ማርያም፡ ድንግል፡ ሰዓሪተ፡ መርገም፡ ወሀውክ፨</t:l>
                  <t:l n="3">ውዳሴ፡ መልክእከ፡ እጽሕፍ፡ እንዘ፡ አተሉ፡ በተውሳክ፨</t:l>
                  <t:l n="4">ባርከኒ፡ አባ፡ በመስቀልከ፡ ቡሩክ፨</t:l>
                  <t:l n="5">በዘወሀበከ፡ ገብርኤል፡ መልአክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ኦክርስቶስ፡ ዘተወለድከ፡ እምድንግል፨</t:l>
                  <t:l n="2">መድኃኒተ፡ ነፍሶሙ፡ ትኩን፡ ለሕዝበ፡ ሙስና፡ ወሀጕል፨</t:l>
                  <t:l n="3">ስብሐተ፡ ሊባኖስ፡ ገብርከ፡ ሐዋርያ፡ ቅዱስ፡ ወንጌል፨</t:l>
                  <t:l n="4">ባርክ፡ በየማንከ፡ ወበእዴከ፡ መስቀል፨</t:l>
                  <t:l n="5">አኮኑ፡ ለሊከ፡ ባርኮተ፡ ትክል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተበጽዐ፡ ፈድፋደ፨</t:l>
                  <t:l n="2">ወለሥዕርትከ፡ ጸሊም፡ ዘድላሌሁ፡ ተንእደ፨</t:l>
                  <t:l n="3">ሊባኖስ፡ በለኒ፡ ወአብስረኒ፡ ገሀደ፨</t:l>
                  <t:l n="4">ዘበምድር፡ ወድሶትየ፡ ዐቅመ፡ ልብከ፡ ፈቀደ፨</t:l>
                  <t:l n="5">በዓለመ፡ ጻድቃን፡ ምስሌየ፡ ትከውን፡ አሐደ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለቆምከ፡ ሐመልማለ፡ ገነት፡ ዘኮነ፨</t:l>
                  <t:l n="2">ወለመልክእከ፡ ሐሤት፡ እንተ፡ ያረስዕ፡ ሐዘነ፨</t:l>
                  <t:l n="3">ሊባኖስ፡ ፀሓይ፡ ዘተረሰይከ፡ ብርሃነ፨</t:l>
                  <t:l n="4">ነዓ፡ ነዓ፡ እንበለ፡ ጐንድዮ፡ ፍጡነ፨</t:l>
                  <t:l n="5">ወበላ፡ ለነፍስየ፡ ረዳኢኪ፡ አነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለመቃብሪከ፡ እንተ፡ በውስቴቱ፡ ተወድየ፨</t:l>
                  <t:l n="2">ወርቀ፡ ሰብእናከ፡ ንጹሕ፡ ዘተመሰለ፡ ባሕርየ፨</t:l>
                  <t:l n="3">ሊባኖስ፡ ፍቁሩ፡ ለዘሰቀለ፡ ሰማየ፨</t:l>
                  <t:l n="4">በለኒ፡ በንባብከ፡ ጊዜ፡ ትወፅእ፡ ነፍስየ፨</t:l>
                  <t:l n="5">እንዘ፡ ሀለውኩከ፡ አነ፡ ኢትፍራህ፡ ወልድየ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ከመ፡ ገብረ፡ ክርስቶስ፡ ብፁዕ፡ እምቤተ፡ መርዓ፡ ወፃእከ፨</t:l>
                  <t:l n="2">ወከመ፡ ዮሐንስ፡ ኅሩይ፡ ገዳመ፡ ትሩፋት፡ ዔልከ፨</t:l>
                  <t:l n="3">እምነ፡ ቅዱሳን፡ ሊባኖስ፡ መኑ፡ ከማከ፨</t:l>
                  <t:l n="4">እንዘ፡ እብል፡ ዘልፈ፡ ለለ፡ ጊዜ፡ አነ፡ ገብርከ፨</t:l>
                  <t:l n="5">በጽርሐ፡ መቅደስከ፡ አባ፡ እገኒ፡ ለክብርከ፨</t:l>
                  <t:l n="6">አባ፡ እሴብሕ፡ ለስምከ፡ ወእዜምር፡ ለከ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ናሁ፡ ጸሐፍኩ፡ ስብሐተ፡ መልክእከ፡ ኵሉ፨</t:l>
                  <t:l n="2">በበ፡ መዓርጊሁ፡ ወክፍሉ፨</t:l>
                  <t:l n="3">አባ፡ ሊባኖስ፡ ለዓለመ፡ ድካም፡ መጽንዔ፡ ኀይሉ፨</t:l>
                  <t:l n="4">አስተምሕር፡ በኢያርምሞ፡ ከመ፡ ምስሌየ፡ የሀሉ፨</t:l>
                  <t:l n="5">ለንጉሠ፡ ሰላም፡ ክርስቶስ፡ ምሕረቱ፡ ወሣህሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ስብሐት፡ ለእግዚአብሔር፡ ለፈጽሞ፡ ዝንቱ፡ ድርሳን፨</t:l>
                  <t:l n="2">ዘጸገወነ፡ ሥልጣነ፡ እምዘዚአሁ፡ ሥልጣን፨</t:l>
                  <t:l n="3">ባርከነ፡ አባ፡ ለደቂቅከ፡ ኄራን፨</t:l>
                  <t:l n="4">ነጺሮሙ፡ ባርኮተከ፡ ወሰሚዖሙ፡ በእዝን፨</t:l>
                  <t:l n="5">ቅዱሳን፡ መላእክት፡ ይበሉ፡ አሜን፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ቅድመ፡ መንበረ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ዘይትዐጸፉ፡ ስብሐተ፨</t:l>
                  <t:l n="2">ሊባኖስ፡ ዘትቀውም፡ ኵሎ፡ ዕለተ፨</t:l>
                  <t:l n="3">ወታቄርብ፡ ቅዳሴያተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለከ፡ ሊባኖስ፡ አሐዱ፡ እምነ፡ ቅዱሳን፡ ተስዓቱ፨</t:l>
                  <t:l n="2">ለክርሶትስ፡ ዋሕድ፡ ወአኮ፡ ክልኤቱ፨</t:l>
                  <t:l n="3">እንተ፡ ጾርከ፡ መስቀለ፡ ሞቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለከ፡ በአምኃ፡ ዝንቱ፡ ማሕሌት፡ ለዘረሰየ፡ ትውክልቶ፨</t:l>
                  <t:l n="2">ሊባኖስ፡ ጳውሎስ፡ መምህረ፡ ቲቶ፨</t:l>
                  <t:l n="3">ሥሙረ፡ ረሲ፡ መሥዋዕቶ፨</t:l>
                  <t:l n="4">ወፍጡነ፡ ተወከፍ፡ ጸሎቶ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>
         
      </t:body>
   </t:text></TEI>