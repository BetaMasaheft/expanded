      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/JQ8WXBQV"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Uhlig1993Katholischen"/><title level="m">Novum Testamentum Aethiopice: Die katholischen Briefe</title><title level="s">Aethiopistische Forschungen</title><editor><forename>Josef</forename><surname>Hofmann</surname></editor><editor><forename>Siegbert</forename><surname>Uhlig</surname></editor><pubPlace>Stuttgart</pubPlace><publisher>Franz Steiner</publisher><date>1993</date><series><title level="s">Aethiopistische Forschungen</title><biblScope unit="volume">29</biblScope></series><biblScope unit="volume">29</biblScope><note type="tags"><note type="tag">New Testament</note><note type="tag">bm:Uhlig1993Katholischen</note></note><note type="tag">New Testament</note><note type="tag">bm:Uhlig1993Katholischen</note></t:bibl>
            </t:listBibl>
         </t:div>
         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3511Epistle">
            <t:ab>
               <t:l>በእንተ፡ ጋይዮስ፡ እኁነ</t:l>
               <t:l n="1">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=1"/>እምነ፡ ቀሲስ፡ ለጋይዮስ፡ ለእኁነ፡ ዘአነ፡ አፈቅሮ፡ በጽድቅ።</t:l>
               <t:l n="2">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=2"/>ኦ፡ እኁየ፡ እስመ፡ አነ፡ በእንተ፡ ኵሉ፡ እጼሊ፡ ለከ። ከመ፡ ትሠራሕ፡ ፍኖትከ፡ ወትሕዮ፡ በዘይኤድማ፡ ለነፍስከ።</t:l>
               <t:l n="3">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=3"/>ተፈሣሕኩ፡ ጥቀ፡ ሶበ፡ መጽኡ፡ አኀዊነ። ወስምዐ፡ ኮኑ፡ ላዕለ፡ ተፋቅሮትከ፡ ከመ፡ በጽድቅ፡ ተሐውር።</t:l>
               <t:l n="4">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=4"/>እምዛቲ፡ ትፍሥሕት፡ እንተ፡ ተዐቢ፡ አልብየ። ከመ፡ እስማዕ፡ እንዘ፡ በጽድቅ፡ የሐውሩ፡ ደቂቅየ።</t:l>
               <t:l n="5">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=5"/>ኦ፡ እኁየ፡ እሙን፡ ግብር፡ ዘገበርከ፡ ለአኀዊነ።</t:l>
               <t:l n="6">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=6"/>ወከመ፡ ዝንቱ፡ ግብር፡ ለነኪራን። እለ፡ ይከውኑ፡ ለከ፡ ስምዐ፡ ላዕለ፡ ተፋቅሮትከ፡ በቅድመ፡ ቤተ፡ ክርስቲያን። ወዘንተ፡ ግብረ፡ ሠናየ፡ ፈኖከ፡ ቅድሜከ፡ ዘይደሉ፡ ለእግዚአብሔር።</t:l>
               <t:l>በእንተ፡ ተወክፎ፡ ቅዱሳን</t:l>
               <t:l n="7">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=7"/>እስመ፡ በእንተ፡ ስሙ፡ ወፅኡ፡ ወአልቦ፡ ዘነሥኡ፡ እምነ፡ አሕዛብ።</t:l>
               <t:l n="8">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=8"/>ወንሕነሰ፡ አኀዊነ፡ ይደልወነ፡ ንትቀበሎሙ፡ ለእለ፡ ከመ፡ ዝ። ከመ፡ ንኩን፡ ሱታፎ፡ ለጽድቅ።</t:l>
               <t:l n="9">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=9"/>ወጸሐፍኩ፡ ዘንተ፡ ለቤተ፡ ክርስቲያን፡ ወአቅደምኩ። ወባሕቱ፡ ዲዮጥራስስ፡ ዘይፈቅድ፡ ይኩን፡ ሊቀ፡ ላዕሌሆሙ፡ ኢይሰጠወነ።</t:l>
               <t:l n="10">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=10"/>ወበእንተ፡ ዝንቱ፡ አመ፡ መጻእኩ፡ አነ፡ አዜክር፡ ሎሙ፡ ምግባሮ፡ ዘይገብር። እስመ፡ ኢየአክሎ፡ ዘይነብብ፡ ንባበ፡ እኩየ፡ ላዕሌነ። እስከ፡ ኢይትቄበሎሙ፡ ለአኀዊነ፡ ወለእለኒ፡ ይፈቅዱ፡ ተቀብሎቶሙ፡ ይከልእ። ወያወፅኦሙ፡ ዓዲ፡ እምቤተ፡ ክርስቲያን።</t:l>
               <t:l n="11">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=11"/>ኦ፡ እኁየ፡ ኢትኩን፡ ከመ፡ ገባሬ፡ እኪት፡ አላ፡ ከመ፡ ገባሬ፡ ሠናይት። እስመ፡ ገባሬ፡ ሠናይት፡ እምእግዚአብሔር፡ ውእቱ። ወገባሬ፡ እኪትሰ፡ ኢይሬእዮ፡ ለእግዚአብሔር።</t:l>
               <t:l n="12">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=12"/>ወበእንተ፡ ድሜጥሮስኒ፡ ስምዐ፡ ኮነ፡ ኵሉ። ወለሊሃኒ፡ ጽድቅ፡ ስምዐ፡ ኮነት፡ ሎቱ፡ ወንሕነኒ፡ ስምዐ፡ ኮነ፡ ሎቱ። ወተአምሩ፡ ከመ፡ ርትዕት፡ ይእቲ፡ ስምዕነ።</t:l>
               <t:l n="13">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=13"/>ወብዙኅ፡ ብየ፡ ዘእጽሕፍ፡ ለከ። አላ፡ ኢይፈቀድኩ፡ በማየ፡ ሕመት፡ ወበቀለም፡ እጽሐፍ፡ ለከ።</t:l>
               <t:l n="14">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=14"/>አላ፡ እትአመን፡ ባሕቱ፡ ከመ፡ ፍጡነ፡ እሬእየከ፡ ወእትናገረከ፡ አፈ፡ በአፍ።</t:l>
               <t:l n="15">
                  <t:ref target="http://classic.net.bible.org/verse.php?book=3Jo&amp;chapter=1&amp;verse=15"/>ሰላም፡ ለከ፡ ወይኤምኁከ፡ አኀዊነ፡ ወአምኅ፡ ቢጸነ፡ በበ፡ አስማቲሆሙ።</t:l>
            </t:ab>
         </t:div>
      </t:body>
