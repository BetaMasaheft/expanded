            <t:div type="textpart" xml:id="Epistle">
               <t:label>Epistle</t:label>               
                  <t:note>Text of the EOTC printed Bible</t:note>
                  <t:div type="textpart" subtype="chapter" n="1" xml:id="ch1">
                     <t:label>ምዕራፍ 1</t:label>
                     <t:ab>
                        <t:l>ዘከመ፡ ይደሉ፡ ጸልዮ፡ በእንተ፡ ቢጽ</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=1"/>እምጳውሎስ፡ ሐዋርያሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ በፈቃደ፡ እግዚአብሔር፡ ወጢሞቴዎስ፡ እኁነ። ለቅዱሳን፡ እለ፡ ውስተ፡ ቈላስይስ፡ ወምእመናን፡ አኀዊነ፡ በክርስቶስ።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=2"/>ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=3"/>ነአኵቶ፡ ለእግዚአብሔር፡ አቡሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ዘልፈ፡ በእንቲኣክሙ፡ ወንጼሊ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=4"/>እምአመ፡ ሰማዕነ፡ ሃይማኖትክሙ፡ በኢየሱስ፡ ክርስቶስ። ወዘከመ፡ ታፈቅርዎሙ፡ ለኵሎሙ፡ ቅዱሳን።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=5"/>በእንተ፡ ተስፋክሙ፡ ዘሥዩም፡ ለክሙ፡ በሰማያት። ዘአቅደምክሙ፡ ሰሚዐ፡ በቃለ፡ ጽድቅ፡ ትምህርተ፡ ወንጌል።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=6"/>ዘበጽሐ፡ ኀቤክሙ፡ ከመ፡ በኵሉ፡ ዓለም፡ ይፍረይ፡ ወይሥመር፡ በላዕሌክሙ። እምአመ፡ ሰማዕክሙ፡ ወርኢክሙ፡ ጸጋ፡ እግዚአብሔር፡ በጽድቅ።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=7"/>ዘተመሀርክሙ፡ በኀበ፡ ኤጳፍራስ፡ እኁነ። ላእከ፡ ዚኣነ፡ ምእመን፡ በክርስቶስ፡ ዘይትለአክ፡ በእንቲኣክሙ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=8"/>ወውእቱ፡ ነገረነ፡ ተፋቅሮተክሙ፡ በመንፈስ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=9"/>ወበእንተ፡ ዝ፡ ንሕነሂ፡ እምአመ፡ ሰማዕነ፡ ዜናክሙ፡ ኢኀደግነ፡ ጸልዮ፡ በእንቲኣክሙ። ወስኢለ፡ ከመ፡ ትፈጽሙ፡ አእምሮ፡ ፈቃዱ፡ ለእግዚአብሔር። በኵሉ፡ ጥበብ፡ ወበኵሉ፡ ምክረ፡ መንፈስ።</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=10"/>ከመ፡ ትሑሩ፡ በዘይደልወክሙ፡ ለኀበ፡ እግዚአብሔር። ወበኵሉ፡ ታድልዉ፡ ሎቱ፡ በምግባረ፡ ሠናይ። እንዘ፡ ትፈርዩ፡ ወትሠምሩ፡ በጥበበ፡ አእምሮ፡ እግዚአብሔር።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=11"/>እንዘ፡ ትጸንዑ፡ በኵሉ፡ ኀይል። በበ፡ ጽንዐ፡ ስብሐቲሁ፡ በኵሉ፡ ትዕግሥት፡ ወበተስፋ፡ ወበፍሥሓ።</t:l>
                        <t:l>በእንተ፡ አኰቴት</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=12"/>አእኵትዎ፡ ለእግዚአብሔር፡ አብ፡ ዘረሰየነ፡ ድልዋነ። ለመክፈልተ፡ ርስቶሙ፡ ለቅዱሳን፡ በብርሃን።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=13"/>ወአድኀነነ፡ እምኵነኔ፡ ጽልመት። ወአግብአነ፡ ውስተ፡ መንግሥተ፡ ወልዱ፡ ፍቁሩ።</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=14"/>ዘቦቱ፡ ረከብነ፡ መድኀኒተ፡ ወተኀድገ፡ ለነ፡ ኀጢአትነ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=15"/>ዘውእቱ፡ አምሳሊሁ፡ ለእግዚአብሔር፡ ዘኢያስተርኢ፡ በኵሩ፡ ዘላዕለ፡ ኵሉ፡ ተግባሩ።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=16"/>እስመ፡ ቦቱ፡ ኵሎ፡ ፈጠረ፡ ዘበሰማይኒ፡ ወዘበምድርኒ፡ ዘያስተርኢ፡ ወዘኢያስተርኢ። እመኒ፡ መናብርት፡ ወእመኒ፡ አጋእዝት፡ ወእመኒ፡ መኳንንት፡ ወእመኒ፡ ቀደምት። ኵሉ፡ ዘኮነ፡ በእዴሁ፡ ወኵሉ፡ ቦቱ፡ ተፈጥረ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=17"/>ወውእቱ፡ ህልው፡ እምቅድመ፡ ኵሉ፡ ወኵሉ፡ ቦቱ፡ ቆመ።</t:l>
                        <t:l>በእንተ፡ ሰላም</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=18"/>ወውእቱ፡ ርእሳ፡ ለቤተ፡ ክርስቲያን። እስመ፡ ውእቱ፡ በኵር፡ ቀደመ፡ እምኵሎሙ፡ ምዉታን፡ ተንሥኦ። ከመ፡ ይኩን፡ ውእቱ፡ ርእሰ፡ ለኵሉ።</t:l>
                        <t:l n="19">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=19"/>እስመ፡ ሠምረ፡ ቦቱ፡ ፍጹመ፡ ኵሉ፡ ይኅድር፡ ላዕሌሁ። ወቦቱ፡ ይሣሀል፡ ለኵሉ።</t:l>
                        <t:l n="20">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=20"/>ወገብረ፡ ሰላመ፡ በደመ፡ መስቀሉ፡ ለዘበሰማይ፡ ወለዘበምድር።</t:l>
                        <t:l n="21">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=21"/>ወአንትሙሂ፡ ትካት፡ ፀሩ፡ ወነኪሩ፡ በልብክሙ፡ ወበእከየ፡ ምግባሪክሙ።</t:l>
                        <t:l n="22">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=22"/>ወይእዜሰ፡ ተሣሀለክሙ፡ በነፍስተ፡ ሥጋሁ፡ ወበሞቱ። ከመ፡ ይረሲክሙ፡ ቅዱሳነ፡ ወንጹሓነ፡ ወኅሩያነ፡ ለቅድሜሁ።</t:l>
                        <t:l>በእንተ፡ መልእክት፡ ሐዋርያዊት</t:l>
                        <t:l n="23">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=23"/>ለእመ፡ ጸናዕክሙ፡ እንከ፡ በሃይማኖት፡ እንዘ፡ ታጠብዑ። ወኢያንቀለቅል፡ ድደ፡ መሠረትክሙ፡ እምተስፋ፡ ትምህርተ፡ ወንጌል፡ ዘሰማዕክሙ። ከመ፡ ተሰብከ፡ በኵሉ፡ ዓለም፡ ዘመትሕተ፡ ሰማይ። ዘሎቱ፡ ተሠየምኩ፡ አነ፡ ጳውሎስ፡ ዐዋዴ፡ ወላእክሂ።</t:l>
                        <t:l n="24">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=24"/>ወይእዜኒ፡ እትፌሣሕ፡ በሕማምየ። ወእፌጽም፡ ታሕጻጸ፡ ሕማሙ፡ ለክርስቶስ፡ በሥጋየ። በእንተ፡ ሥጋሁ፡ እንተ፡ ይእቲ፡ ቤተ፡ ክርስቲያኑ።</t:l>
                        <t:l n="25">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=25"/>እንተ፡ ላቲ፡ ተሠየምኩ፡ አነ፡ ላእከ፡ በሥርዐተ፡ እግዚአብሔር። ዘወሀበኒ፡ በእንቲኣክሙ፡ ከመ፡ እፈጽም፡ ቃለ፡ እግዚአብሔር።</t:l>
                        <t:l n="26">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=26"/>ወምክሮ፡ ዘኅቡእ፡ እምቅድመ፡ ዓለም፡ ወዘእንበለ፡ ይትፈጠር፡ ሰብእ።</t:l>
                        <t:l n="27">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=27"/>ወይእዜሰ፡ አስተርአዮሙ፡ ለቅዱሳኒሁ። ለእለ፡ ፈቀደ፡ እግዚአብሔር፡ ይክሥት፡ ሎሙ፡ ብዕለ፡ ስብሐቲሁ፡ ለዝንቱ፡ ምክሩ፡ በላዕለ፡ አሕዛብ። እስመ፡ ውእቱ፡ ክርስቶስ፡ ዘየኀድር፡ ላዕሌክሙ፡ ተስፋ፡ ስብሐቲነ።</t:l>
                        <t:l n="28">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=28"/>ዘንሜህር፡ ንሕነ፡ ወንጼውዕ፡ ኀቤሁ፡ ወንጌሥጽ፡ ኵሎ፡ ሰብአ። ወንነግሮ፡ ግብሮ፡ በኵሉ፡ ጥበብ። ከመ፡ ይቁም፡ ኵሉ፡ ሰብእ፡ ፍጹመ፡ በሃይማኖተ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="29">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=1&amp;verse=29"/>ዘበእንቲኣሁ፡ እሠርሕ፡ ወእትጋደል፡ በከመ፡ ረድኤቱ፡ ዘይረድአኒ፡ በኀይሉ።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="2" xml:id="ch2">
                     <t:label>ምዕራፍ 2</t:label>
                     <t:ab>
                        <t:l>ዘከመ፡ ይደሉ፡ ተጋድሎ፡ በእንተ፡ አኀው</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=1"/>ወእፈቅድ፡ ታእምሩ፡ መጠነ፡ እትጋደል፡ በእንቲኣክሙ፡ ወበእንተ፡ እለ፡ በሎዶቅያ። ወበእንተ፡ ኵሎሙ፡ እለ፡ ኢርእዩኒ፡ ገጽየ፡ በሥጋየ።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=2"/>ከመ፡ ይትፈሥሖሙ፡ ልቦሙ። ወይጽናዕ፡ ትምህርቶሙ፡ በተፋቅሮ፡ ወበኵሉ፡ ብዕለ፡ ፍጻሜ፡ በጥበብ፡ ወበሃይማኖት። ወበአእምሮ፡ ምክሩ፡ ለእግዚአብሔር፡ ዘበእንተ፡ ክርስቶስ።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=3"/>ዘኀቤሁ፡ ሀሎ፡ ኵሉ፡ መዝገበ፡ ጥበብ፡ ወምክር፡ ኅቡእ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=4"/>ወዘኒ፡ ዘእብለክሙ፡ ከመ፡ አልቦ፡ ዘያስሕተክሙ፡ በኂጣነ፡ ነገር።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=5"/>አንሰ፡ ለእመ፡ ኢሀሎኩ፡ በሥጋየ፡ ኀቤክሙ፡ በመንፈስየ፡ ምስሌክሙ፡ አነ። ወናሁ፡ እትፌሣሕ፡ በዘእሬኢ፡ ግዕዘክሙ፡ ወሥርዐተክሙ፡ ወጽንዐ፡ ሃይማኖትክሙ፡ ዘበክርስቶስ።</t:l>
                        <t:l>በእንተ፡ ጽንዐ፡ ሃይማኖት</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=6"/>ወበከመ፡ ተወከፍክምዎ፡ ለክርስቶስ፡ እግዚእነ፡ ቦቱ፡ ሑሩ።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=7"/>ወተሣረሩ፡ ወተሐነጹ፡ ቦቱ። ወጽንዑ፡ በሃይማኖት፡ ዘተመሀርክሙ፡ ከመ፡ ትብዝኁ፡ በአኰቴቱ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=8"/>ዑቁ፡ ኢይኂጡክሙ፡ በጥበበ፡ ነገር፡ ዘይዬውሁ፡ ለከንቱ። በሥርዐተ፡ ትምህርተ፡ ሰብእ፡ ለስሒተ፡ ዝንቱ፡ ዓለም።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=9"/>ወአኮ፡ በሕገ፡ ክርስቶስ፡ ዘላዕሌሁ፡ ኀደረ፡ ኵሉ፡ መለኮቱ፡ በሥጋ፡ ሰብእ።</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=10"/>ወአንትሙሂ፡ ኩኑ፡ ፍጹማነ፡ ቦቱ። እስመ፡ ውእቱ፡ ርእሱ፡ ለኵሉ፡ መኰንን፡ ወለኵሉ፡ መንግሥት።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=11"/>ዘቦቱ፡ ተገዘርክሙ፡ ግዝረተ፡ ዘኢኮነ፡ ግብረ፡ እደ፡ ሰብእ። በስልበተ፡ ሥጋ፡ ነፍስተ፡ ኀጢአት፡ በግዝረተ፡ ክርስቶስ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=12"/>ወተቀበርክሙ፡ ምስሌሁ፡ በጥምቀት፡ ወባቲ፡ ተንሣእክሙ፡ ምስሌሁ፡ በሃይማኖት። በረድኤተ፡ እግዚአብሔር፡ ዘአንሥኦ፡ እምዉታን።</t:l>
                        <t:l>በእንተ፡ ድምሳሴ፡ መጽሐፈ፡ ዕዳ</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=13"/>ወአንትሙሂ፡ እለ፡ ነበርክሙ፡ ምዉታነ፡ በኀጢአትክሙ፡ ወበቊልፈተ፡ ነፍስትክሙ። አሕየወክሙ፡ ምስሌሁ፡ ወጸገወክሙ፡ ኵሎ፡ ኀጢአተክሙ።</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=14"/>ወደምሰሰ፡ ለነ፡ መጽሐፈ፡ ዕዳነ፡ በሥርዐቱ፡ እምእደውነ። ወአእተቶ፡ እማእከሌነ፡ ወቀነዎ፡ በመስቀሉ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=15"/>ወበሰሊቦቱ፡ አስተኀፈሮሙ፡ ለቀደምት፡ ወለመኳንንት። ወአስተኀፈሮሙ፡ በተከሥቶ፡ ህላዌሁ።</t:l>
                        <t:l>በእንተ፡ መብልዕ፡ ወመስቴ፡ ወካልኣን፡ ሕርመታት</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=16"/>ዑቁ፡ እንከ፡ አልቦ፡ ዘይግእዘክሙ፡ ኢ፡ በመብልዕ፡ ወኢ፡ በመስቴ። ወኢ፡ በመክፈልተ፡ በዓላት፡ ወኢ፡ በአሥኅርት፡ ወኢ፡ በሰናብት።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=17"/>እስመ፡ ዝንቱ፡ ውእቱ፡ ጽላሎቱ፡ ለዘሀለዎ፡ ይምጻእ።</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=18"/>ወአልቦ፡ ዘያስተአብድክሙ፡ በእንተ፡ ሥጋሁ፡ ለክርስቶስ። ፈቂዶ፡ በተየውሆ፡ ወበተናሕስዮ፡ ርእስ። ከመ፡ ትትአዘዙ፡ ለሕርመተ፡ መላእክት፡ በዘኢርእየ። ወይትሜካሕ፡ በከንቱ፡ በምክረ፡ ሥጋሁ።</t:l>
                        <t:l n="19">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=19"/>ወኢይጸንዕ፡ በርእስ፡ ዘቦቱ፡ የኀድር፡ ኵሉ፡ ሥጋ። ወይትዋደድ፡ በአሥራወ፡ ወመሌሊት። ወይልህቅ፡ ወይጸንዕ፡ ወይበዝኅ፡ ወይመልእ፡ በእግዚአብሔር።</t:l>
                        <t:l n="20">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=20"/>ወእመ፡ ሞትክሙ፡ ምስለ፡ ክርስቶስ፡ እምንብረተ፡ ዝ፡ ዓለም። በእፎ፡ ካዕበ፡ ከመ፡ ዘሕያዋን፡ ውስተ፡ ዓለም፡ ትገብሩ።</t:l>
                        <t:l n="21">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=21"/>ወይቤሉክሙ፡ ኢትግስስ፡ ወኢትልክፍ፡ ወኢትጥዐም፡ ዘንተ። እስመ፡ ዝንቱ፡ ኵሉ፡ ለሙስና፡ በከመ፡ ትእዛዘ፡ ሰብእ።</t:l>
                        <t:l n="22">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=22"/>ዘያመስልዎ፡ ጥበበ፡ በእንተ፡ ትሕትና፡ ልብ፡ ወፍርሀተ፡ እግዚአብሔር።</t:l>
                        <t:l n="23">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=2&amp;verse=23"/>ወኢ፡ ምሂከ፡ ሥጋ፡ አልቦቱ፡ ክብር፡ ምንተኒ። አላ፡ ውእቱ፡ ዘመልዕልተ፡ ሥጋ።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="3" xml:id="ch3">
                     <t:label>ምዕራፍ 3</t:label>
                     <t:ab>
                        <t:l>በእንተ፡ ትንሣኤ፡ ልቡና</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=1"/>ወእመሰ፡ ተንሣእክሙ፡ ምስለ፡ ክርስቶስ፡ ዘላዕለ። ኅሡ፡ ኀበ፡ ሀሎ፡ ክርስቶስ፡ በየማነ፡ እግዚአብሔር፡ ይነብር።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=2"/>ዘላዕሉ፡ ኀልዩ፡ ወአኮ፡ ዘበምድር።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=3"/>እስመ፡ ወዳእክሙ፡ ሞትክሙ። ወኅብእት፡ ሕይወትክሙ፡ ምስለ፡ ክርስቶስ፡ በኀበ፡ እግዚአብሔር።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=4"/>ወአመ፡ ይመጽእ፡ ክርስቶስ፡ ይትዐወቅ፡ ሕይወትክሙ። ይእተ፡ አሚረ፡ ታስተርእዩ፡ ምስሌሁ፡ በስብሐት፡ ዐቢይ።</t:l>
                        <t:l>በእንተ፡ መዊት፡ እምኀጢአት</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=5"/>አሙትዎ፡ ለነፍስትክሙ፡ ዘዲበ፡ ምድር፡ እምዝሙት፡ ወርኩስ፡ ወመንሱት። ወፍትወት፡ እኪት፡ ወትዕግልት፡ ዘውእቱ፡ አምልኮ፡ ጣዖት።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=6"/>ዘበእንቲኣሁ፡ ይመጽእ፡ መቅሠፍተ፡ እግዚአብሔር፡ ላዕለ፡ ውሉደ፡ ዐላውያን።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=7"/>ዘቦቱ፡ ሖርክሙ፡ አንትሙሂ፡ ትካት፡ አመ፡ ሐየውክሙ፡ በዝንቱ፡ ግብር።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=8"/>ወይእዜሰ፡ ኅድግዋ፡ ለመዓት፡ ወለቊጥዓ፡ ወለእከይ፡ ወለፅርፈት፡ ወለነገረ፡ ኀፍረት። ወነገረ፡ ከንቱ፡ ኢይፃእ፡ እምአፉክሙ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=9"/>ወኢተሐስዉ፡ ቢጸክሙ፡ ዳእሙ፡ ኅድግዎ፡ ለብሉይ፡ ብእሲ፡ ምስለ፡ እኩይ፡ ምግባሩ።</t:l>
                        <t:l>በእንተ፡ ሐዲስ፡ ብእሲ</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=10"/>ወልበስዎ፡ ለሐዲስ፡ ብእሲ፡ ዘይትሔደስ፡ በአእምሮ፡ አምሳለ፡ ፈጣሪሁ።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=11"/>ዘአልቦ፡ በኀቤሁ፡ አይሁዳዊ፡ ወኢ፡ አረማዊ። ኢ፡ ግዙር፡ ወኢ፡ ቈላፍ፡ ኢ፡ ሐቃል፡ ወሀገሪት። ኢ፡ ነባሪ፡ ወኢ፡ አግዓዚ፡ ዘእንበለ፡ በኵሉ፡ ወበኀበ፡ ኵሉ፡ ክርስቶስ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=12"/>ልበስዎ፡ እንከ፡ ከመ፡ ኅሩያነ፡ እግዚአብሔር፡ ቅዱሳን። ወፍቁራን፡ በምሕረት፡ ወበተሣህሎ፡ ወበኂሩት፡ ወትሑት፡ ልብ፡ በየውሀት፡ ወበትዕግሥት።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=13"/>ጹርዎሙ፡ ለቢጽክሙ፡ ወተጻገዉ፡ በበይናቲክሙ። ኅድጉ፡ ለቢጽክሙ፡ ዘተኀየስክምዎሙ፡ ከመ፡ ክርስቶስ፡ ጸገወክሙ። ከማሁ፡ አንትሙሂ፡ ግበሩ።</t:l>
                        <t:l>በእንተ፡ ተፋቅሮ</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=14"/>ወምስለ፡ ዝንቱ፡ ኵሉ፡ ተፋቀሩ፡ ዘልፈ። እስመ፡ ማእሰረ፡ ተፍጻሜቱ፡ ውእቱ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=15"/>ወሰላሙ፡ ለክርስቶስ፡ ይጽናዕ፡ በልብክሙ። ዘሎቱ፡ ተጸዋዕክሙ፡ በአሐዱ፡ ሥጋ።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=16"/>ወሀልዉ፡ በአኰቴተ፡ ክርስቶስ፡ ወአንብቡ፡ መዝሙረ፡ ወስብሐተ፡ ወማሕሌተ፡ ቅድሳት። ወቃለ፡ እግዚአብሔር፡ ይጽናዕ፡ በኀቤክሙ፡ ከመ፡ ትብዐሉ፡ በኵሉ፡ ጥበብ። ወመሀሩ፡ ነፍሰክሙ፡ ወገሥጹ፡ በመንፈስ። ዘምሩ፡ ለእግዚአብሔር፡ በልብክሙ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=17"/>ወኵሎ፡ ዘትገብሩ፡ በስመ፡ እግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ግበርዎ። ወአእኵትዎ፡ ለእግዚአብሔር፡ አብ፡ በእንቲኣሁ።</t:l>
                        <t:l>በእንተ፡ ሠሪዐ፡ ቤት</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=18"/>ወአንስትኒ፡ ተአዘዛ፡ ለአምታቲክን፡ ከመ፡ ዘለእግዚአብሔር።</t:l>
                        <t:l n="19">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=19"/>ዕደውኒ፡ አፍቅሩ፡ አንስቲያክሙ፡ ወኢትግእዝዎን።</t:l>
                        <t:l n="20">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=20"/>ውሉድኒ፡ ተአዘዙ፡ ለአዝማዲክሙ፡ በኵሉ። እስመ፡ ከማሁ፡ ርቱዕ፡ ወይሠምር፡ እግዚአብሔር።</t:l>
                        <t:l n="21">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=21"/>አበውኒ፡ ኢታስተቈጥዑ፡ ውሉደክሙ፡ ከመ፡ ኢይሕዝኑ።</t:l>
                        <t:l n="22">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=22"/>ነባሪኒ፡ ተአዘዙ፡ ለአጋእዝቲክሙ፡ በስፉሕ፡ ልብ። ወአኮ፡ በአድልዎ፡ ለገጸ፡ ሰብእ፡ አላ፡ በፍርሀተ፡ እግዚአብሔር።</t:l>
                        <t:l n="23">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=23"/>ተአምሩ፡ ከመ፡ እምኀበ፡ እግዚአብሔር፡ ትትዐሰዩ፡ እስመ፡ ለክርስቶስ፡ ትትቀነዩ።</t:l>
                        <t:l n="24">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=3&amp;verse=24"/>ወዘሰ፡ ዐመፀ፡ ይረክብ፡ ፍዳሁ፡ ወኢያደሉ፡ ሎቱ።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="4" xml:id="ch4">
                     <t:label>ምዕራፍ 4</t:label>
                     <t:ab>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=1"/>አጋእዝትኒ፡ ዕሩየ፡ ግበሩ፡ ሎሙ፡ ለነባሪክሙ፡ ወፍትሑ፡ ጽድቀ። ተአምሩ፡ ከመ፡ ብክሙ፡ እግዚእ፡ በሰማያት።</t:l>
                        <t:l>በእንተ፡ ተፀምዶ፡ ለጸሎት</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=2"/>ወተፀመዱ፡ ለጸሎት፡ እንዘ፡ ትተግሁ፡ በአኰቴት።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=3"/>ጸልዩ፡ ወሰአሉ፡ ለነሂ፡ ከመ፡ ያርኁ፡ ለነ፡ እግዚአብሔር፡ አናቅጸ፡ ቃል። ከመ፡ ንንግር፡ ምክረ፡ ዘእምኀበ፡ እግዚአብሔር፡ ዘበእንቲኣሁ፡ ተሞቃሕኩ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=4"/>ከመ፡ እክሥቶ፡ በከመ፡ ይደልወኒ፡ እንግር።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=5"/>ሑሩ፡ በልቡና፡ በኀበ፡ ባዕዳን፡ እምሃይማኖት።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=6"/>ወይኩን፡ ነገርክሙ፡ በጸጋ፡ ወቅሱመ፡ በጼው። ከመ፡ ታእምሩ፡ ዘትትዋሥኡ፡ ለለ፡ አሐዱ፡ አሐዱ።</t:l>
                        <t:l>ዜና፡ መምህር፡ በረድእ</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=7"/>ወኵሎ፡ ዜናየ፡ ይዜንወክሙ፡ ጢኪቆስ፡ እኁነ፡ ምእመን፡ ዘነኀብር፡ ተቀንዮ። ዘውእቱ፡ እኁክሙ፡ በእግዚአብሔር።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=8"/>ዘፈነውክዎ፡ ኀቤክሙ፡ በእንተ፡ ዝንቱ፡ ግብር። ከመ፡ ታእምሩ፡ ዜናየ፡ ወያስተፍሥሕክሙ፡ ልበክሙ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=9"/>ምስለ፡ አናሲሞስ፡ እኁነ፡ ምእመን፡ ዘናፍቅር፡ ዘውእቱ፡ ብእሲ፡ እምኔክሙ። ወእሙንቱ፡ ያጤይቁክሙ፡ ግብረነ፡ ወዘሀሎነ፡ ቦቱ።</t:l>
                        <t:l>አምኃ፡ ለአርድእት</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=10"/>አምኁክሙ፡ አርስጥሮኮስ፡ ዘተፄወወ፡ ምስሌየ። ወማርቆስ፡ ወልደ፡ እኅወ፡ አቡሁ፡ ለበርናባስ፡ ዘበእንቲኣሁ፡ አዘዝኩክሙ።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=11"/>ከመ፡ አመ፡ መጽአ፡ ኀቤክሙ፡ ትትወከፍዎ። ወኢያሱ፡ ዘተሰምየ፡ ኢዩስጦስ፡ እለ፡ እምሰብአ፡ ግዝረት። ወእሉ፡ ዳእሙ፡ ረድኤትየ፡ በግብረ፡ መንግሥተ፡ እግዚአብሔር፡ ወአስተፍሥሑኒ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=12"/>አምኀክሙ፡ ኤጳፍራስ፡ ዘእምኀቤክሙ፡ ውእቱ፡ ገብረ፡ ክርስቶስ። ወዘልፈ፡ ይጼሊ፡ በእንቲኣክሙ፡ ወይስእል፡ ከመ፡ ትኩኑ፡ ፍጹማነ፡ ወምሉኣነ፡ በኵሉ፡ ሥምረተ፡ እግዚአብሔር።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=13"/>ወአነ፡ ሰማዕቱ፡ ከመ፡ ፈድፋደ፡ ያፈቅረክሙ፡ ወይቴክዝ፡ በእንቲኣክሙ። ወለእለ፡ በሎዶቅያ፡ ወሀገረ፡ ኢያራ።</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=14"/>አምኀክሙ፡ ሉቃስ፡ ዐቃቤ፡ ሥራይ፡ ፍቁርነ፡ ወዴማስ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=15"/>አምኅዎሙ፡ ለአኀዊነ፡ እለ፡ በሎዶቅያ፡ ወንምፋን። ወእለ፡ ሀለዉ፡ ቤተ፡ ክርስቲያን።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=16"/>ወአንቢበክሙ፡ ዛተ፡ መጽሐፈ፡ ፈንውዋ፡ ሎዶቅያ፡ ያንብብዋ፡ በቤተ፡ ክርስቲያን። ወካዕበ፡ አንብብዋ፡ አንትሙ፡ ለመልእክት፡ እንተ፡ ጸሐፍኩ፡ እምሎዶቅያ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=17"/>ወበልዎ፡ ለአክርጳ፡ ዑቅአ፡ መልእክተከ፡ ዘተሠየምከ፡ እምኀበ፡ እግዚአብሔር፡ ከመ፡ ትፈጽም።</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=Col&amp;chapter=4&amp;verse=18"/>ወአማኅኩክሙ፡ ጽሒፍየ፡ በእዴየ፡ አነ፡ ጳውሎስ። ተዘከሩ፡ መዋቅሕትየ፡ ጸጋ፡ ምስሌክሙ፡ አሜን።</t:l>
                     </t:ab>
                  </t:div>
               
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>