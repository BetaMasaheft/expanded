         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3082RepCh362">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">እግዚአብሔር፡ ወሃቤ፡ ብርሃን፡ ዘይሤለስ፡ በአካሉ፨</t:l>
                  <t:l n="2">እንዘ፡ ተዋሕዶ፡ ያጸንዕ፡ በመለኮቱ፡ ወኀይሉ፨</t:l>
                  <t:l n="3">ዐይነ፡ ልቡናየ፡ ያብርህ፡ በማኅቶተ፡ ጥበብ፡ ሥነ፡ ጸዳሉ፨</t:l>
                  <t:l n="4">ከመ፡ እርአይ፡ ገጸ፡ ነገር፡ ለኪዳንኪ፡ ዘይደሉ፨</t:l>
                  <t:l n="5">ማርያም፡ እግዝእተ፡ ኵሉ፡ ዘታሕቱ፡ ወላዕሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ ዘአስተማሰልዎ፡ በኮከብ፨</t:l>
                  <t:l n="2">ሶበ፡ ብርሃኖ፡ ተከድኑ፡ ጽልሙታነ፡ ራእይ፡ ሕዝብ፨</t:l>
                  <t:l n="3">ኪዳነ፡ አምላክ፡ ማርያም፡ ወተስፋ፡ መድኀኒት፡ ዘዐርብ፨</t:l>
                  <t:l n="4">ተናዘዘ፡ ብኪ፡ አኮኑ፡ ኅሊና፡ ቀዳማይ፡ አብ፨</t:l>
                  <t:l n="5">አመ፡ እምገነቱ፡ ተሰደ፡ በሐዘን፡ ዕጹብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስኪ፡ ዘፈትለ፡ ሜላት፡ ዘውጋ፨</t:l>
                  <t:l n="2">ወምልእት፡ ይእቲ፡ እምጠለ፡ ሠናይት፡ እንበለ፡ ንትጋ፨</t:l>
                  <t:l n="3">ለዘተካየድኪ፡ ማርያም፡ ቅድመ፡ ማኅበር፡ ወእንግልጋ፨</t:l>
                  <t:l n="4">ሰአልዮ፡ ሕይወተ፡ ነፍስ፡ ይጸግወኒ፡ በጸጋ፨</t:l>
                  <t:l n="5">አምሳለ፡ ኤልያስ፡ አኮ፡ ያሐይወኒ፡ በሥጋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለርእስኪ፡ ዘሀሎ፡ ወይሄሉ፨</t:l>
                  <t:l n="2">ዲበ፡ ጠባይዓት፡ ኵሉ፨</t:l>
                  <t:l n="3">ተካየድኒ፡ ማርያም፡ ኪዳነ፡ ምሕረት፡ ዘይደሉ፨</t:l>
                  <t:l n="4">ምስለ፡ ሞትሰ፡ ተካየድነ፡ ወተማሐልነ፡ ዘይብሉ፨</t:l>
                  <t:l n="5">ከንቶ፡ ነበቡ፡ ወነፍሶሙ፡ ሀጕሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለገጽኪ፡ ገጸ፡ ቅድስና፡ ስቡሕ፨</t:l>
                  <t:l n="2">ዘይበርህ፡ ሥኑ፡ እምጸዳለ፡ ፀሓይ፡ ወወርኅ፨</t:l>
                  <t:l n="3">ትእምርተ፡ ኪዳን፡ ማርያም፡ ወቀስተ፡ ደመና፡ ብሩህ፨</t:l>
                  <t:l n="4">እምኀበ፡ አምላክ፡ መሓሪ፡ እምአመ፡ ነሥአኪ፡ ኖኅ፨</t:l>
                  <t:l n="5">አማስኖታ፡ ለምድር፡ ኢደገመ፡ አይኅ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለቀራንብትኪ፡ ንጻሬ፡ አዕይንት፡ ለዑቃቤ፨</t:l>
                  <t:l n="2">እለ፡ ሥዩማት፡ እማንቱ፡ ህየንተ፡ ምስዋር፡ ወግልባቤ፨</t:l>
                  <t:l n="3">ማርያም፡ በሊዮ፡ ለዘወለድኪዮ፡ በኢሩካቤ፨</t:l>
                  <t:l n="4">አይቴኑ፡ ቃልከ፡ እግዚኦ፡ እምሕር፡ ለከ፡ ዘይቤ፨</t:l>
                  <t:l n="5">እመ፡ ኃጥኣን፡ ጸውዑ፡ ስመኪ፡ ነባቤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለአዕይንትኪ፡ አምሳለ፡ ክልኤቱ፡ ቀናዲል፨</t:l>
                  <t:l n="2">እንተ፡ ሰቀሎን፡ ኬንያ፡ በማኅፈደ፡ ሥጋ፡ ልዑል፨</t:l>
                  <t:l n="3">ማርያም፡ አንቲ፡ ነቅዐ፡ ተራኅርኆ፡ ወሣህል፨</t:l>
                  <t:l n="4">አድኅነኒ፡ በኪዳንኪ፡ ወባልሕኒ፡ እምሀጕል፨</t:l>
                  <t:l n="5">እስመ፡ ዘእንበሌኪ፡ አልቦ፡ አድኅኖ፡ ዘይክል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="8">
                  <t:l n="1">ሰላም፡ ለአእዛንኪ፡ እለ፡ ተበስራ፡ ኪዳነ፨</t:l>
                  <t:l n="2">እምአፈ፡ ፈጣሪ፡ ወልድኪ፡ ዘበባሕርይኪ፡ ተከድነ፨</t:l>
                  <t:l n="3">ኣምሕለኪ፡ ማርያም፡ ከመ፡ ኢታርእይኒ፡ ደይነ፨</t:l>
                  <t:l n="4">እንበለ፡ ምግባር፡ ባሕቱ፡ ለእመ፡ ኢይጸድቅ፡ አነ፨</t:l>
                  <t:l n="5">ቦኑ፡ ለከንቱ፡ ኪዳንኪ፡ ኮነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="9">
                  <t:l n="1">ሰላም፡ ለመላትሕኪ፡ ጽጌያተ፡ ሮማን፡ እለ፡ ይመስላ፨</t:l>
                  <t:l n="2">ባሕቱ፡ መጽለዋ፡ በእሳተ፡ አንብዕ፡ በነበልባላ፨</t:l>
                  <t:l n="3">በኪዳንኪ፡ ማርያም፡ አዕርግኒ፡ ዐጸደ፡ ተድላ፨</t:l>
                  <t:l n="4">ወይ፡ ለነ፡ አሌ፡ ለነ፡ አመ፡ ውስተ፡ ደይን፡ ይብላ፨</t:l>
                  <t:l n="5">ነፍሳተ፡ ክልኤቲ፡ አኃት፡ ሀሊባ፡ ወሀላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="10">
                  <t:l n="1">ሰላም፡ ለአእናፍኪ፡ መሳክወ፡ ሕይወት፡ ምንታዌ፨</t:l>
                  <t:l n="2">ዘአስተዋደዶን፡ አምላክ፡ በአጽባዕተ፡ ጥበብ፡ ወልባዌ፨</t:l>
                  <t:l n="3">ማርያም፡ ሕጽርኒ፡ በኀይለ፡ ኪዳንኪ፡ እምንሳዌ፨</t:l>
                  <t:l n="4">ወቀጥቅጢ፡ ርእሶ፡ በበትረ፡ ሕማም፡ ወደዌ፨</t:l>
                  <t:l n="5">ለእመ፡ አፋሁ፡ አብቀወ፡ የኀጠኒ፡ አርዌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="11">
                  <t:l n="1">ሰላም፡ ለከናፍርኪ፡ በእንተ፡ ኃጥኣን፡ እለ፡ ሰአላ፨</t:l>
                  <t:l n="2">እምኀበ፡ አምላክ፡ መሓሪ፡ ኪዳነ፡ ምሕረት፡ ወመሐላ፨</t:l>
                  <t:l n="3">ውስተ፡ ጎልጎታ፡ ማርያም፡ አመ፡ ገይሶትኪ፡ እምገሊላ፨</t:l>
                  <t:l n="4">ለጽድቀ፡ ዛቲ፡ ኪዳንኪ፡ ለለ፡ ጊዜ፡ ይከውን፡ በዓላ፨</t:l>
                  <t:l n="5">ዲበ፡ ርእሰ፡ ኃጥእ፡ ገብርከ፡ አንብሪ፡ አክሊላ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="12">
                  <t:l n="1">ሰላም፡ ለአፉኪ፡ አፈ፡ በረከት፡ ትሩፍ፨</t:l>
                  <t:l n="2">አንቀጸ፡ ቅዱስ፡ መጽሐፍ፨</t:l>
                  <t:l n="3">ተማሕፀንኒ፡ ማርያም፡ በኪዳንኪ፡ ውኩፍ፨</t:l>
                  <t:l n="4">ኢይትኀፈር፡ ቅድመ፡ ወልድኪ፡ ወመላእክቲሁ፡ አእላፍ፨</t:l>
                  <t:l n="5">አመ፡ ሥርወ፡ ልሳን፡ ይትመተር፡ ወይትኀተም፡ አፍ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="13">
                  <t:l n="1">ሰላም፡ ለአስናንኪ፡ ከመ፡ መራዕይ፡ እለ፡ ተቀርፃ፨</t:l>
                  <t:l n="2">እለ፡ ወፅኣ፡ እምኅፃብ፡ እንዘ፡ ይትባየጻ፨</t:l>
                  <t:l n="3">ማርያም፡ ንሥእኒ፡ ኪዳንኪ፡ ህየንተ፡ ሞፃ፨</t:l>
                  <t:l n="4">ወለዕድውየ፡ ግብጻዊ፡ ዘፍትወተ፡ ልቡ፡ ዐመፃ፨</t:l>
                  <t:l n="5">መዝራዕተ፡ ጸሎትኪ፡ ሙሴ፡ ይድፍኖ፡ በኆጻ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="14">
                  <t:l n="1">ሰላም፡ ለልሳንኪ፡ ዘአፈድፈደ፡ ቅዳሴ፨</t:l>
                  <t:l n="2">እምካህናተ፡ ሰማይ፡ ሱራፌል፡ እለ፡ ይቀውሙ፡ ቅድመ፡ ሥላሴ፨</t:l>
                  <t:l n="3">አዘክሪ፡ ሊተ፡ ማርያም፡ ተዝካረ፡ ኪዳንኪ፡ አመ፡ ድምሳሴ፨</t:l>
                  <t:l n="4">በእንተ፡ እስራኤል፡ በገዳም፡ ከመ፡ አዘከረ፡ አውሴ፨</t:l>
                  <t:l n="5">ኪዳነ፡ አብርሃም፡ ይስሐቅ፡ ወያዕቆብ፡ ወጽድቆ፡ ለሙሴ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="15">
                  <t:l n="1">ሰላም፡ ለቃልኪ፡ ተሰጣዌ፡ ቃል፡ ለቃሉ፨</t:l>
                  <t:l n="2">ለመልአከ፡ ብስራት፡ ገብርኤል፡ ዘጸዳለ፡ ብርሃን፡ መንዲሉ፨</t:l>
                  <t:l n="3">ማርያም፡ ቅድስት፡ ለእግዚአብሔር፡ መካነ፡ ኀይሉ፨</t:l>
                  <t:l n="4">እንቋዕ፡ ተውህበኪ፡ ኪዳነ፡ ምሕረቱ፡ ወሣህሉ፨</t:l>
                  <t:l n="5">በዘቦቱ፡ ጸዲቀ፡ ኃጥኣን፡ ይክሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="16">
                  <t:l n="1">ሰላም፡ ለእስትንፋስኪ፡ ነፋሰ፡ ጥዒና፡ ፈዋሲ፨</t:l>
                  <t:l n="2">ነፍሳተ፡ ብዙኃን፡ ሰብእ፡ እለ፡ ቈስሉ፡ በሕምዘ፡ ከይሲ፨</t:l>
                  <t:l n="3">በኪዳንኪ፡ ማርያም፡ ኀጣውእየ፡ ደምስሲ፨</t:l>
                  <t:l n="4">እንበለ፡ ኪዳንኪሰ፡ ወመስቀለ፡ ክርስቶስ፡ ወራሲ፨</t:l>
                  <t:l n="5">አልቦ፡ እምሲኦል፡ ዘይድኅን፡ ብእሲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="17">
                  <t:l n="1">ሰላም፡ ለጕርዔኪ፡ ሠናይ፡ ወአዳም፨</t:l>
                  <t:l n="2">እንተ፡ ይትፈለጡ፡ ቦቱ፡ ጸዋትወ፡ መሪር፡ ወጣዕም፨</t:l>
                  <t:l n="3">ምንተ፡ እግበር፡ ማርያም፡ እስመ፡ ኀይልየ፡ ድኩም፨</t:l>
                  <t:l n="4">ሐጸኒ፡ ግብር፡ እምኵለሄ፡ ወጸበኒ፡ ዓለም፨</t:l>
                  <t:l n="5">ባሕቱ፡ በኪዳንኪ፡ ናዝዝኒ፡ እም፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="18">
                  <t:l n="1">ሰላም፡ ለክሳድኪ፡ ዘማኅፈደ፡ ዳዊት፡ ርእዮታ፨</t:l>
                  <t:l n="2">ዲበ፡ ተልፍዮስ፡ ጠቢባን፡ ዘአስተናደፉ፡ መሠረታ፨</t:l>
                  <t:l n="3">ማርያም፡ በልዮ፡ ውስተ፡ እዝነ፡ ነፍስየ፡ ለናዝዞታ፨</t:l>
                  <t:l n="4">ለምንት፡ ብዙኀ፡ ትሰርሒ፡ ነፍስ፡ ዚአየ፡ ማርታ፨</t:l>
                  <t:l n="5">እስመ፡ ኅዳጥ፡ የአክል፡ እምብዙኅ፡ ሐተታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="19">
                  <t:l n="1">ሰላም፡ ለመታክፍትኪ፡ ግዕዛነ፡ በረከት፡ እለ፡ ተወክፋ፨</t:l>
                  <t:l n="2">ህየንተ፡ መርገም፡ ወዘልፋ፨</t:l>
                  <t:l n="3">ማርያም፡ ጹርኒ፡ ለጽድቀ፡ ኪዳንኪ፡ ዲበ፡ መትከፋ፨</t:l>
                  <t:l n="4">ወንሥእኒ፡ ዐሥራተ፡ እድ፡ እመሬተ፡ ወልድኪ፡ አልፋ፨</t:l>
                  <t:l n="5">እስመ፡ ሃይማኖትየ፡ አንቲ፡ ወዘብየ፡ ተስፋ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="20">
                  <t:l n="1">ሰላም፡ ለዘባንኪ፡ በወርኀ፡ ተሰዶ፡ ቀዲሙ፨</t:l>
                  <t:l n="2">ምዕራፈ፡ አምላክ፡ ዘኮነ፡ ውስተ፡ ፍኖተ፡ ቍስቋም፡ ጊዜ፡ ድካሙ፨</t:l>
                  <t:l n="3">ማርያም፡ ስመኪ፡ ለዘጾረ፡ መልዕልተ፡ ስሙ፨</t:l>
                  <t:l n="4">በዕለተ፡ ኵነኔ፡ እመ፡ ኢያስለጠ፡ ደሙ፨</t:l>
                  <t:l n="5">በዕለተ፡ ኵነኔ፡ እመ፡ ኢያስለጠ፡ ደሙ፨</t:l>
                  <t:l n="6">ዐሥራተ፡ ኪዳንኪ፡ ንሥእዮ፡ መሓሪት፡ እሙ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="21">
                  <t:l n="1">ሰላም፡ ለእንግድኣኪ፡ ወለሕፅንኪ፡ ካልእታ፨</t:l>
                  <t:l n="2">ወለአእዳውኪ፡ መንታ፨</t:l>
                  <t:l n="3">አምሕለኪ፡ ማርያም፡ በነጸፍጻፈ፡ ደም፡ ዘጎልጎታ፨</t:l>
                  <t:l n="4">ለነፍስየ፡ ምስለ፡ ነፍስኪ፡ ታስተዳልዊ፡ መክፈልታ፨</t:l>
                  <t:l n="5">አመ፡ መሬታዊት፡ ሥጋየ፡ ትትከደን፡ መሬታ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="22">
                  <t:l n="1">ሰላም፡ ለመዛርዒኪ፡ ወለኵርናዕኪ፡ ምፅንጋዕ፨</t:l>
                  <t:l n="2">ዘሐቀፋሁ፡ ለክርስቶስ፡ ባሕርየ፡ መለኮት፡ ኅቡእ፨</t:l>
                  <t:l n="3">ማርያም፡ ኅሪት፡ እመላእክት፡ ወሰብእ፨</t:l>
                  <t:l n="4">ተዝካረኪ፡ ለእመ፡ ገብረ፡ በተአምኖ፡ ጽኑዕ፨</t:l>
                  <t:l n="5">በመንግሥተ፡ ሰማይ፡ ምስሌኪ፡ ይነግሥ፡ ኃጥእ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="23">
                  <t:l n="1">ሰላም፡ ለእመታትኪ፡ ለቤተ፡ መቅደስ፡ ቀዋሚ፨</t:l>
                  <t:l n="2">እለ፡ አሠነያ፡ ወርቀ፡ ፈትለ፡ ሜላት፡ ግብረ፡ አናሚ፨</t:l>
                  <t:l n="3">ማርያም፡ ላዕሌየ፡ ኪዳነ፡ ምሕረትኪ፡ ፈጽሚ፨</t:l>
                  <t:l n="4">ወቅትሊ፡ ዕድወ፡ ነፍስየ፡ እስመ፡ ውእቱ፡ ረጋሚ፨</t:l>
                  <t:l n="5">ከመ፡ በጥበቡ፡ ሰሎሞን፡ ቀተሎ፡ ለሳሚ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="24">
                  <t:l n="1">ሰላም፡ ለእራሓትኪ፡ ተመጣዌ፡ ኅብስት፡ ወማይ፨</t:l>
                  <t:l n="2">ሶበ፡ ያመጽኡ፡ ለኪ፡ መላእክተ፡ ሰማይ፨</t:l>
                  <t:l n="3">እንዘ፡ ሀሎኪ፡ ማርያም፡ በመቅደሰ፡ ኦሪት፡ ዐባይ፨</t:l>
                  <t:l n="4">ይትወከፍ፡ ሊተ፡ ኪዳንኪ፡ ከመ፡ መሥዋዕተ፡ ሰርክ፡ ኅሩይ፨</t:l>
                  <t:l n="5">እመ፡ ሕፍነ፡ ማይ፡ አስተይኩ፡ ለጽሙእ፡ ነዳይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="25">
                  <t:l n="1">ሰላም፡ ለአጻብዕኪ፡ ወለአጽፋርኪ፡ ጽዕድው፨</t:l>
                  <t:l n="2">ወለአጥባትኪ፡ ክልኤ፡ አንቅዕተ፡ ሐሊብ፡ ፍትው፨</t:l>
                  <t:l n="3">ማርያም፡ ጽጌ፡ ዘዘመንኪ፡ መፀው፨</t:l>
                  <t:l n="4">ተማሕፀንኩ፡ በአጥባትኪ፡ ወበሥንኪ፡ ምጽልው፨</t:l>
                  <t:l n="5">በኀይለ፡ ጸሎትኪ፡ እድኅን፡ እምእሳት፡ ድልው፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="26">
                  <t:l n="1">ሰላም፡ ለገቦኪ፡ መንፈለ፡ ለፌ፡ ወለፌ፨</t:l>
                  <t:l n="2">እለ፡ ተረሰያ፡ ደርገ፡ ሐመልማለ፡ ወርቅ፡ ኢኀላፌ፨</t:l>
                  <t:l n="3">ማርያም፡ ምጥቅኒ፡ በገቦ፡ ኪዳንኪ፡ ምስለ፡ ሑቃፌ፨</t:l>
                  <t:l n="4">ሶበ፡ ይወርዱ፡ ኃጥኣን፡ ብሔረ፡ ጽልመት፡ ጸናፌ፨</t:l>
                  <t:l n="5">እለ፡ በሕይወቶሙ፡ ጸልኡ፡ ዘጻድቃን፡ ሱታፌ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="27">
                  <t:l n="1">ሰላም፡ ለከርሥኪ፡ ለከርሠ፡ መላእክት፡ ዘውጉ፨</t:l>
                  <t:l n="2">ኅብስተ፡ ሰማይ፡ ውትረ፡ ዘይሴሰይ፡ ዐቅመ፡ ምዕራጉ፨</t:l>
                  <t:l n="3">ማርያም፡ በጽዮን፡ ለእግዚአብሔር፡ ታቦተ፡ ሕጉ፨</t:l>
                  <t:l n="4">ያንጽሐኒ፡ እምፍቅረ፡ ወይን፡ ለማየ፡ ኪዳንኪ፡ ዐይጉ፨</t:l>
                  <t:l n="5">እስመ፡ ፍቅረ፡ ወይን፡ ተብህለ፡ ለሰይጣን፡ ዔረጉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="28">
                  <t:l n="1">ሰላም፡ ለልብኪ፡ ስንእወ፡ ኵልያት፡ ወኅሊና፨</t:l>
                  <t:l n="2">ወለአማዑትኪ፡ ሰላም፡ ምስለ፡ ንዋየ፡ ውስጥኪ፡ በዕሪና፨</t:l>
                  <t:l n="3">ውስተ፡ ምድረ፡ ርስት፡ አብእኒ፡ ማርያም፡ ዐምደ፡ ደመና፨</t:l>
                  <t:l n="4">በብርሃነ፡ እሳት፡ ኪዳንኪ፡ እንዘ፡ ትመርሐኒ፡ ፍና፨</t:l>
                  <t:l n="5">ወትሴስይኒ፡ እምፍቅርኪ፡ መና፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="29">
                  <t:l n="1">ሰላም፡ ለሕንብርትኪ፡ ምሳሌ፡ ፍሑቅ፡ ማዕከክ፨</t:l>
                  <t:l n="2">ወለማሕፀንኪ፡ ንጹሕ፡ ምስለ፡ ሐቌኪ፡ ቡሩክ፨</t:l>
                  <t:l n="3">ማርያም፡ ቅድስት፡ ወላዲተ፡ ቅዱስ፡ አምላክ፨</t:l>
                  <t:l n="4">ተዐየኒ፡ ዐውደ፡ ነፍስየ፡ እስከ፡ ሣልሳዊ፡ ፈለክ፨</t:l>
                  <t:l n="5">አመ፡ ተቃወማ፡ በአየር፡ ቀናኢ፡ መልአክ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="30">
                  <t:l n="1">ሰላም፡ ለድንግልናኪ፡ መክብበ፡ ሕዋሳት፡ ኀምስ፨</t:l>
                  <t:l n="2">ወለአቍያጽኪ፡ ክልኤ፡ አዕማደ፡ ነባቢት፡ መቅደስ፨</t:l>
                  <t:l n="3">ማርያም፡ ታቦት፡ ወጽላተ፡ ኪዳን፡ ሐዲስ፨</t:l>
                  <t:l n="4">ቅብእኒ፡ ርጢነ፡ ጾም፡ እስከ፡ ሰኰና፡ እግር፡ ወርእስ፨</t:l>
                  <t:l n="5">እስመ፡ ጾም፡ ትፌውስ፡ ሕማማ፡ ለነፍስ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="31">
                  <t:l n="1">ሰላም፡ ለአብራክኪ፡ ጊዜ፡ አስተርእዮ፡ ወተንብሎ፨</t:l>
                  <t:l n="2">ምስለ፡ አእጋርኪ፡ ደርገ፡ እለ፡ ይሰግዳ፡ በኢያብጥሎ፨</t:l>
                  <t:l n="3">ማርያም፡ በቃልኪ፡ እስመ፡ ተሳተፍኪ፡ ቃሎ፨</t:l>
                  <t:l n="4">ሰአልዮ፡ ለወልድኪ፡ ይጸግወኒ፡ ሣህሎ፨</t:l>
                  <t:l n="5">አመ፡ ውስተ፡ እሳት፡ ይወዲ፡ ኃጥኣነ፡ ምድር፡ ኵሎ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="32">
                  <t:l n="1">ሰላም፡ ለሰኰናኪ፡ ወለመከየድኪ፡ እለ፡ ሖራ፨</t:l>
                  <t:l n="2">ውስተ፡ ደብረ፡ ቍስቋም፡ ለደቂቅ፡ አመ፡ ቀተልዎሙ፡ ሐራ፨</t:l>
                  <t:l n="3">ለአምላከ፡ ሰማይ፡ በሊዮ፡ ማርያም፡ ወለተ፡ ዕዝራ፨</t:l>
                  <t:l n="4">አማንኑ፡ ትኴንና፡ በእንተ፡ ፴ነገራ፨</t:l>
                  <t:l n="5">ለዘ፡ ታፈቅረኪ፡ ነፍስ፡ በኵሉ፡ ምግባራ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="33">
                  <t:l n="1">ሰላም፡ ለአጻብዕኪ፡ አቅርንተ፡ አእጋር፡ ክልኤቲ፨</t:l>
                  <t:l n="2">ወለአጽፋሪሆን፡ ለለአሐቲ፨</t:l>
                  <t:l n="3">በኪዳንኪ፡ ማርያም፡ ኀጢአትየ፡ ክብቲ፨</t:l>
                  <t:l n="4">ሰብእሰ፡ ካልእየ፡ እንዘ፡ ከማየ፡ መዋቲ፨</t:l>
                  <t:l n="5">በጽውዐ፡ ልሳን፡ ደምየ፡ ቀዲሖ፡ ይሰቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="34">
                  <t:l n="1">ሰላም፡ ለቆምኪ፡ አየረ፡ ትሩፋት፡ ዘሐፀኖ፨</t:l>
                  <t:l n="2">ወዐውሎ፡ ኀጢአት፡ ዘኢያጽነኖ፨</t:l>
                  <t:l n="3">በክንፈ፡ ኪዳንኪ፡ ክድንኒ፡ ማርያም፡ እምተኰንኖ፨</t:l>
                  <t:l n="4">ሶበ፡ ኪዳንኪ፡ ምክንያተ፡ ድኂን፡ ኢኮኖ፨</t:l>
                  <t:l n="5">ነፍሰ፡ በላዔ፡ ሰብእ፡ መኑ፡ እምክህለ፡ አድኅኖ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="35">
                  <t:l n="1">ሰላም፡ ለመልክአ፡ ሐና፡ ወኤልሳቤጥ፨</t:l>
                  <t:l n="2">ዘብዑድ፡ ሥኑ፡ ወልምላሜሁ፡ ፍሉጥ፨</t:l>
                  <t:l n="3">ማርያም፡ ድንግል፡ ድንግልተ፡ አፍኣ፡ ወውስጥ፨</t:l>
                  <t:l n="4">ቤዛ፡ ይኩነኒ፡ ኪዳንኪ፡ በገጸ፡ ፈጣሪ፡ ሥሉጥ፨</t:l>
                  <t:l n="5">አመ፡ ወርኀ፡ ንግድ፡ ዮኀልቅ፡ ወይፀራዕ፡ በሤጥ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="36">
                  <t:l n="1">ሰላም፡ ለፀአተ፡ ነፍስኪ፡ በነጽሮ፡ ብርሃን፡ ዘየኀቱ፨</t:l>
                  <t:l n="2">መልአከ፡ አፍርሆ፡ ጸሊም፡ እንበለ፡ ያደንግፅኪ፡ በጽላሎቱ፨</t:l>
                  <t:l n="3">ኣምሕለኪ፡ ማርያም፡ ለእግዚአብሔር፡ በመለኮቱ፨</t:l>
                  <t:l n="4">ከመ፡ ያድኅነኒ፡ በኪዳንኪ፡ እመደንግፃን፡ ሠለስቱ፨</t:l>
                  <t:l n="5">አመ፡ ይፈልጠኒ፡ ሞት፡ እምሥጋየ፡ ዝንቱ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="37">
                  <t:l n="1">ሰላም፡ ለበድነ፡ ሥጋኪ፡ ዘኢጐንደየ፡ በምስካብ፨</t:l>
                  <t:l n="2">እስመ፡ አንሥኦ፡ ፍጡነ፡ መንፈሰ፡ ሕይወቱ፡ ለአብ፨</t:l>
                  <t:l n="3">ኢይትነከር፡ ለኪ፡ ማርያም፡ አድኅኖተ፡ ጻድቃን፡ ሕዝብ፨</t:l>
                  <t:l n="4">እስመ፡ አድኀንኪ፡ ኃጥኣነ፡ በኪዳንኪ፡ ጥበብ፨</t:l>
                  <t:l n="5">ዝኬ፡ መንክር፡ ወዝኬ፡ ዕጹብ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="38">
                  <t:l n="1">ሰላም፡ ለግንዘተ፡ ሥጋኪ፡ በመዋጥሐ፡ ክታን፡ ወከርቤ፨</t:l>
                  <t:l n="2">ላዕለ፡ እደ፡ ጴጥሮስ፡ ብእሴ፡ ይባቤ፨</t:l>
                  <t:l n="3">ተሣሀልኒ፡ ማርያም፡ ወኢትበልኒ፡ አመ፡ ምንዳቤ፨</t:l>
                  <t:l n="4">ለምንት፡ ታአኵት፡ ኪዳንየ፡ ወረድኤትየ፡ ዐቃቤ፨</t:l>
                  <t:l n="5">ቅብአ፡ ኃጥኣን፡ አኮኑ፡ ኢይትቀባእ፡ እቤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="39">
                  <t:l n="1">ሰላም፡ ለመቃብርኪ፤ እለ፡ ይትጋብኡ፡ ባቲ፨</t:l>
                  <t:l n="2">ለአሕዛብ፡ ኵሎሙ፡ እስመ፡ ምክሖሙ፡ አንቲ፨</t:l>
                  <t:l n="3">ማርያም፡ ብጽሕኒ፡ ለሰዐተ፡ ሞትየ፡ ለመዋቲ፨</t:l>
                  <t:l n="4">እምነፍሰ፡ ክርስቲያን፡ አኮኑ፡ ሶበ፡ ይመውት፡ አሐቲ፨</t:l>
                  <t:l n="5">ለናዝዞታ፡ ፍጡነ፡ ትበጽሒ፡ አንቲ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="40">
                  <t:l n="1">ሰላም፡ ለትንሣኤኪ፡ ለትንሣኤ፡ ክርስቶስ፡ አምሳሊሁ፨</t:l>
                  <t:l n="2">አንቀጸ፡ መቃብር፡ ዝጉሐ፡ እንዘ፡ ኢያርኁ፨</t:l>
                  <t:l n="3">ማርያም፡ አንቲ፡ ለአዳም፡ ጥንተ፡ ተስፋሁ፨</t:l>
                  <t:l n="4">ሶበ፡ አኮ፡ ጸሎትኪ፡ ወኪዳንኪ፡ ምስሌሁ፨</t:l>
                  <t:l n="5">ውስተ፡ ዕመቀ፡ ሀጕል፡ እምኮነ፡ በነፍሱ፡ ወሥጋሁ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="41" xml:id="chaine3">
                  <t:l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋኪ፡ ኀበ፡ መካነ፡ ሕይወት፡ ዘተሐደሰ፨</t:l>
                  <t:l n="2">እምቅድመ፡ ዝኒ፡ ኀቤሁ፡ ሥጋ፡ ወልድኪ፡ ፈለሰ፨</t:l>
                  <t:l n="3">ቤዛዊተ፡ ዓለም፡ ማርያም፡ ኣስተበቍዐኪ፡ አንሰ፨</t:l>
                  <t:l n="4">ትቤዝዊ፡ በኪዳንኪ፡ ዘጸላእትየ፡ ነፍሰ፨</t:l>
                  <t:l n="5">እስመ፡ በሥራይኪ፡ ለቍስልየ፡ ቀባእክኒ፡ ፈውሰ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="42">
                  <t:l n="1">ኣአኵቶ፡ ለእግዚአብሔር፡ ለዘጸውዐኒ፡ ጽዋዔ፨</t:l>
                  <t:l n="2">ተዝካረ፡ ኪዳንኪ፡ ንግበር፡ ማእከለ፡ ምንዱባን፡ ጉባኤ፨</t:l>
                  <t:l n="3">ተመጠዊዮ፡ ባሕቱ፡ ማርያም፡ አመ፡ ትንሣኤ፨</t:l>
                  <t:l n="4">ወአንብሪ፡ በርእሰ፡ ነፍሱ፡ አክሊላተ፡ መንግሥት፡ ሱባዔ፨</t:l>
                  <t:l n="5">ለነባቤ፡ ዝንቱ፡ ድርሰት፡ አርብዓ፡ ወክልኤ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="43">
                  <t:l n="1">ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ አድባር፡ ወአውግር፨</t:l>
                  <t:l n="2">ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ ዕፀዋት፡ ወሣዕር፨</t:l>
                  <t:l n="3">ስብሐት፡ ለኪ፡ ማርያም፡ በኈልቈ፡ ቀላያት፡ ወባሕር፨</t:l>
                  <t:l n="4">ስብሐት፡ ለኪ፡ ማርያም፡ በኍልቈ፡ ኵሉ፡ ፍጡር፨</t:l>
                  <t:l n="5">ምሉእ፡ ስብሐትኪ፡ በሰማይ፡ ወምድር፨</t:l>
               </t:lg>
            </t:div>
            <t:div type="textpart" xml:id="tarafa-malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለኪ፡ ኪዳነ፡ ምሕረት፡ ትስፋየ፡ ዘታጸድቂ፡ ኃጥአ፨</t:l>
                  <t:l n="2">ወዘተኀሥሢ፡ አሐደ፡ በግዐ፨</t:l>
                  <t:l n="3">ዘተገድፈ፡ እምነ፡ ተስዓ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለኪ፡ ኪዳነ፡ ምሕረት፡ ሐውልት፡ ዘተከለኪ፡ እግዚእ፨</t:l>
                  <t:l n="2">ትእምርተ፡ አድኅኖ፡ ትኩኒ፡ ለኵሉ፡ ኃጥእ፨</t:l>
                  <t:l n="3">ፍቅርኪ፡ ዘያጸንዕ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለኪ፡ ኪዳነ፡ ምሕረት፡ በማይ፡ ዘታጸንኒ፡ መድሎተ፨</t:l>
                  <t:l n="2">ተአምኖተኒ፡ ብኪ፡ ረስዪ፡ ሊተ፨</t:l>
                  <t:l n="3">ገድልኪ፡ ወትሩፋተ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="4">
                  <t:l n="1">ሰላም፡ ለኪዳነ፡ ምሕረት፡ ወርቅ፡ ወመዝገበ፡ ኵሉ፡ ንዋይ፨</t:l>
                  <t:l n="2">አንቲ፡ ውእቱ፡ ምስካበ፡ ነዳይ፨</t:l>
                  <t:l n="3">ወብዕል፡ ዘበሰማይ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለኪ፡ ሶበ፡ ስእንኩ፡ ጸዲቀ፡ በምግባረ፡ ሠናይ፡ ወገድል፨</t:l>
                  <t:l n="2">አስመኩ፡ ብኪ፡ ኪዳነ፡ ድንግል፨</t:l>
                  <t:l n="3">መድኀኒተ፡ ነፍስየ፡ እምነ፡ ሀጕል፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለኪ፡ ኪዳነ፡ ምሕረት፡ አንቲ፡ አረቦነ፡ መንፈስ፡ ዘላዕሉ፨</t:l>
                  <t:l n="2">ዘያፈቅረኪ፡ በተስፋ፡ ይሄሉ፨</t:l>
                  <t:l n="3">እስከ፡ አመ፡ ይከውን፡ ትንሣኤ፡ ኵሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="7">
                  <t:l n="1">ሰላም፡ ለኪ፡ በስመ፡ ኪዳንኪ፡ ቤተ፡ ለዘሐነጸ፡ ገብርኪ፨</t:l>
                  <t:l n="2">ወለእመ፡ ጸለይነ፡ በስምኪ፨</t:l>
                  <t:l n="3">ማርያም፡ ፈትቲ፡ እምበረከትኪ፨</t:l>
                  <t:l n="4">ሰአሊ፡ ኀበ፡ ኄር፡ ወልድኪ፨</t:l>
               </t:lg>
            </t:div>
         </t:div>

      </t:body>
   </t:text></TEI>