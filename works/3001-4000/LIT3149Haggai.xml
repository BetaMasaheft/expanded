         <t:div type="edition" xml:lang="gez" xml:id="div2LIT3149Haggai">
            <t:note>Text of the EOTC printed Bible</t:note>
            <t:div type="textpart" subtype="chapter" n="1" xml:id="chapter1">
               <t:label>Chapter 1</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=1"/>በካልእ፡ ዓመተ፡ መንግሥቱ፡ ለዳርዩስ፡ ንጉሥ፡ በሳድስ፡ ወርኃ፡ አመ፡ ሠርቅ፡ ኮነ፡ ቃለ፡ እግዚአብሔር፡ በእደ፡ ሐጌ፡ ነቢይ፡ ወይቤ፡ በሎ፡ ለዘሩባቤል፡ ወልደ፡ ሳላያል፡ ዘሕዝብ፡ ይሁዳ፡ ወለዮሴዕለ፡ ወልደ፡ ዮሴዴቅ፡ ካህን፡ ዓቢይ፡ ወበሎም።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=2"/>ከመዝ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ፡ ዝንቱ፡ ሕዝብ፡ ይብሉ፡ ኢብጽሐ፡ ጊዜ፡ ለሐኒፆ፡ ቤተ፡ እግዚአብሔር።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=3"/>ወኮነ፡ ቃለ፡ እግዚአብሔር፡ በእዶ፡ ሐጌ፡ ነብይ፡ ወይበሌ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=4"/>እመ፡ ጊዜሁ፡ ለክሙ፡ ትንበሩ፡ ዉስተ፡ ልገታተ፡ ቀላያት፡ ወዝኒ፡ ቤትየ፡ ይመዘብር።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=5"/>ወይእዜኒ፡ ከመዝ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሎ፡ ይመልክ፡ ሐልዩ፡ እስኩ፡ በልብክሙ፡ ፍናዊክሙ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=6"/>ዘሪኩም፡ ብዙኀ፡ ወአእተዉክሙ፡ ኀዳጠ፡ ትበልዑ፡ ወኢትጸግቡ፡ ትስትዩ፡ ወኢትረዉዩ፡ ትትከደኑ፡ ወኢትመዉቅ፡ ወዘያስተጋብዕ፡ ዓስቦ፡ አስተጋብኦ፡ ዉሰተ፡ ዕቁር፡ ስቁር።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=7"/>ከመዝ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ፡ ሐልዩ፡ ፍናዊክሙ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=8"/>ዕርጉ፡ ደብረ፡ ወግዝሙ፡ ዕፀወ፡ ወሕንጹ፡ ቤተ፡ ወእሠምሮ፡ ወእሴባሕ፡ ይቤ፡ እግዚአብሔር።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=9"/>ርኢክሙ፡ ብዙኀ፡ ወኮነ፡ ኀዳጠ፡ ወአባእከሙ፡ ቤተ፡ ወነፈኀክዋ፡ በእንተ፡ ዝንቱ፡ ከመዝ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሎ፡ ይመልክ፡ እስመ፡ ቤትየ፡ መዝበረ፡ ወአንትሙስ፡ ታጸንዑ፡ አብያቲክሙ፡ ኩልከሙ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=10"/>በእንተ፡ ዝንቱ፡ ታቀዉም፡ ሰማይ፡ ዝናመ፡ ምላዕሉ፡ ወምድርኒ፡ ኢትሁብ፡ ፍሬሃ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=11"/>ወአመጽእ፡ ኩናተ፡ ላዕለ፡ በሐዉርት፡ ወላዕለ፡ አድባር፡ ወላዕለ፡ እክለ፡ ወወይን፡ ወቅብአ፡ ወላዕለ፡ ሰብእ፡ ወእንስሳ፡ ወላዕለ፡ ኩሉ፡ ተግባረ፡ እደዊሆም።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=12"/>ወስምዐ፡ ዘሩባቤል፡ ወልደ፡ ሰላትያል፡ ዘሕዝበ፡ ይሁዳ፡ ወዬሴዕ፡ ወልደ፡ ዬሴዴቅ፡ ካህን፡ ዓቢይ፡ ወኩሉኦም፡ ሕዝብ፡ እለ፡ ተርፉ፡ ቃለ፡ እግዚአብሔር፡ አምላኮሙ፡ ወቃለ፡ ሐጌ፡ ነቢይ፡ ዘከመ፡ ለአኮ፡ እግዚአብሔር፡ እምላኮሙ፡ ኀቤሆሙ፡ ወፈርሁ፡ ሕዝብ፡ እምቅድም፡ ገጹ፡ ለእግዚአብሔር።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=13"/>ወይቤ፡ ሐጌ፡ መልክ፡ እግዚአብሔር፡ ለሕዝብ፡ አነ፡ ምስሌክሙ፡ ይቤ፡ እግዝያብሔር።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=1&amp;verse=14"/>ወአንሥአ፡ እግዚአብሔር፡ መንፈስ፡ ዘሩባቤል፡ ዋልደ፡ ሰላትያል፡ ዘሕዝበ፡ ይሁዳ፡ ወመንፈሰ፡ የሴዕ፡ ወልደ፡ ዩሴዴቅ፡ ካህን፡ ዓቢይ፡ ወመንፈሶሙ፡ ለኩሉም፡ እለ፡ ተርፉ፡ ሕዝብ፡ ወቦኦ፡ ይግበሩ፡ ግብረ፡ ቤተ፡ እግዚአብሔር፡ አምላክሙ፡ ዘኩሎ፡ ይመልክ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="2" xml:id="chapter2">
               <t:label>Chapter 2</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=1"/>አመ፡ ዕሥራ፡ ወአርባዕቱ፡ ለሳድስ፡ ወርኀ፡ በሰዱስ፡ ዓመት።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=2"/>በሳብዕ፡ ወርኀ፡ በሰዱስ፡ ለጽልበት፡ ነበበ፡ እግዚአብሔር፡ በእደ፡ ሐጌ፡ ነቢይ፡ ወይቤሎ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=3"/>በሎ፡ ለዘሩባቤል፡ ወልደ፡ ሰላትያል፡ ዘሕዝበ፡ ይሁዳ፡ ወለዩሴዕ፡ ወልደ፡ ዩሴዴቅ፡ ካህን፡ ዓቢይ፡ ወለኩሎሙ፡ እለ፡ ተርፉ፡ ሕዝብ፡ ወይቤ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=4"/>መኑ፡ እምኔክሙ፡ ዘርአዩ፡ ለዝንቱ፡ ቤት፡ ትርሲቶ፡ ዘትካት፡ ወእፎ፡ ትሬእይዎ፡ ይእዜ፡ እንትሙከመ፡ ዘኢሀሎ፡ ቅድሜክሙ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=5"/>ወይአዜኒ፡ ጽናዕ፡ ዘሩባቤል፡ ይቤ፡ እግዚአብሔር፡ ወይጽናዕ፡ ዩሴዕ፡ ወልደ፡ ዩሴዴቅ፡ ካህን፡ ዓቢይ፡ ወይጽንዑ፡ አሕዛብ፡ ምድር፡ ይቤ፡ እግዚአብሔር፡ ወግብሩ፡ ወአነ፡ ሀሎኩ፡ ምስሌክሙ፡ ይቤ፡ እግዚአቤሔር፡ ዘኩሉ፡ ይመልክ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=6"/>ወመንፈስየ፡ ይቀዉም፡ ምእከሌክሙ፡ ተአመኑ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=7"/>ከመዝ፡ የቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ፡ ዓዲ፡ ምዕረ፡ ወአነ፡ አድለቀልቃ፡ ለሰማይ፡ ወለምድር፡ ወለባሕር፡ ወለየብሰ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=8"/>ወድለቀልቆም፡ ለኩሎሙ፡ አሕዛብ፡ ወየመጹእ፡ ኀሩሆሙ፡ ለኩሎሙ፡ አሕዛብ፡ ወእመልሎ፡ ለዝንቱ፡ ቤት፡ ትርሲተ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=9"/>ዚአየ፡ ዉእቱ፡ ወርቅ፡ ዉብሩር፡ ይቤ፡ እግዚአብሄር፡ ዘኩሉ፡ ይመልክ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=10"/>ወይኄይስ፡ ትርሲቱ፡ ላዝንቱ፡ ቤት፡ ደኃሪቱ፡ ምቀዳሚቱ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ። ወእሁብ፡ ስላመ፡ ለዝንቴ፡ ብሔር፡ ይቤ፡ እዚአብሔር፡ ዘኩሉ፡ ይመልክ፡ ወሰላመ፡ ለኩሉ፡ ነፍስ፡ እንተ፡ ትትጌበር፡ ወየትነሣእ፡ ዝንቱ፡ ቤት።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=11"/>አመ፡ ዕሥራ፡ ወአርባዕቱ፡ ለታስዕ፡ ወርኀ፡ በካልእት፡ ዓመተ፡ መንግሥቱ፡ ለዳርዩስ፡ ኮነ፡ ቃለ፡ እግዚአብሔር፡ ኀበ፡ ሐጌ፡ ነቢይ፡ ወይቤሉ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=12"/>ከመዝ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ያማልክ፡ ታስአሎሙአ፡ ለካህናቲክ፡ ሕገ፡ ወበሎሙ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=13"/>እመአ፡ ለከፎ፡ ለሰብአ፡ ሥጋ፡ ቅዱስ፡ ጽንፈ፡ ልብሱ፡ ወለከፎ፡ በዘፈረ፡ ልብሱ፡ እመሂ፡ ኀብስተ፡ ወእመሂ፡ ወይነ፡ ወእመሂ፡ ብሱለ፡ ወእመሂ፡ ዛኮነ፡ እክል፡ ወእመሂ፡ ቅብእ፡ ቅዱስ፡ ይትቄደሰኑ፡ ዋይቤሉ፡ ካህናት፡ ኢይትቄደስ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=14"/>ወይሌሎሙ፡ ሐጌ፡ ከማሁ፡ እመኬ፡ ለክፎ፡ ርኩስ፡ ወሥኡ፡ በነፍስ፡ ይረኩሰኑአ፡ እምኩሉ፡ ዝንቱ፡ ወይቤሉ፡ ካህናት፡ ይረኩስ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=15"/>ወይቤሎሙ፡ ሐጌ፡ ከማሁኬአ፡ ዝንቱ፡ ሕዝብ፡ ወነገደ፡ ቅድመየ፡ ይቤ፡ እግዚአቤሔር፡ ወከማሁ፡ ኩሉ፡ ግብረ፡ እደዊሆሙ፡ ወኩሉ፡ ግብረ፡ እደዊሆሙ፡ ወኩሉ፡ ዘቀረቦሙ፡ ይረኩስ፡ በአንተ፡ ዘተረፎሙ፡ በጽባሕ፡ ይሣቀዩ፡ በቅድመ፡ ሕማሞሙ፡ ወይጸልእዎሙ፡ ለእለ፡ ይጌሥጽዎሙ፡ በኅበ፡ አናቅጽ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=16"/>ወይእዘኒ፡ ሐልዩ፡ በልብክሙ፡ ዘእምአሜ፡ ቀዳሚት፡ ዕለት፡ ወዘእምቅድሜሁ፡ ዘእንበለ፡ ያንብሩ፡ እብነ፡ ዲበ፡ እብን፡ ዉስተ፡ ቤተ፡ እግዚአብሔር፡ መኑ፡ አንትሙ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=17"/>አመ፡ ትዘርኡ፡ ዕሥራ፡ ሰገመ፡ ወታትዉ፡ ዐሠርተ፡ ሰገመ፡ ወትበዉኡ፡ ኀበ፡ ምክያድ፡ ትቅድሑ፡ ኃምሳ፡ ጻሕበ፡ ወትቀድሑ፡ ዕሥራ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=18"/>ቀሠፍኩክሙ፡ በዓባር፡ ወበበረድ፡ በኩሉ፡ ተግባረ፡ እደዊክሙ፡ ወኢነሳሕክሙ፡ ወኢተመየጥክሙ፡ ኀቤየ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=19"/>ሐልዩ፡ በልብክም፡ ዘእምአሜ፡ ቀዳሚት፡ ዕለት፡ ወዘእምድኀሬሃ፡ ዘእመ፡ ተሱዑ፡ ለጽልመት፡ ታስዕ፡ ወርኀ፡ ዘእምአመ፡ ሣረሩ፡ ቤተ፡ እግዚአብሔር፡ ተዘከርዎ፡ ብልክሙ።</t:l>
                  <t:l n="20">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=20"/>ወትሬእዩ፡ በዉሰተ፡ ምክያደ፡ ክል፡ ወወይን፡ ወበለስ፡ ወሮማን፡ ወዘይት፡ ወኩሉ፡ ዕፅ፡ ዘኢያፈሪ፡ እባርኮሙ፡ እምዩም።</t:l>
                  <t:l n="21">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=21"/>ወኮነ፡ ቃለ፡ እግዚአብሔር፡ በዳግም፡ ኀበ፡ ሐጌ፡ ነቢይ፡ አመ፡ ዕሥራ፡ ወአርባዕቱ፡ ለጋስዕ፡ ወርኀ፡ ወይቤሎ።</t:l>
                  <t:l n="22">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=22"/>በሎ፡ ለዘሩባቤል፡ ወልደ፡ ሰላትያል፡ ዘሕዝበ፡ ይሁዳ፡ ናሁ፡ አነ፡ አድለቀልቃ፡ ለሰማይ፡ ለምድር፡ ወለበህር፡ ወለየብስ።</t:l>
                  <t:l n="23">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=23"/>ወእገፈትዕ፡ መናብርተ፡ ነገሥ፡ ወእገፈትዕ፡ ሠረገላ፡ ወመስተጽዕናነ፡ ወይወርዱ፡ መስተጽዕናን፡ በአፍራሲሆሙ፡ ምስለ፡ አስይፍቲሆሙ፡ ኀበ፡ ቢጾሙ።</t:l>
                  <t:l n="24">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hag&amp;chapter=2&amp;verse=24"/>ይእተ፡ አሚረ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ፡ አነሥአከ፡ ዘሩባቤል፡ ወልደ፡ ሰላትያል፡ ውሬስየክ፡ ከመ፡ ማዕተብ፡ እስመ፡ ኪያክ፡ ኀረይኩ፡ ይቤ፡ እግዚአብሔር፡ ዘኩሉ፡ ይመልክ።</t:l>
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>