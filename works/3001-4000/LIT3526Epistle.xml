            <t:div type="textpart" xml:id="Epistle">
               <t:label>Epistle</t:label>
               
                  <t:note>Text of the EOTC printed Bible</t:note>
                  <t:div type="textpart" subtype="chapter" n="1" xml:id="ch1">
                     <t:label>ምዕራፍ 1</t:label>
                     <t:ab>
                        <t:l>በእንተ፡ ጢሞቴዎስ፡ ወሃይማኖቱ</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=1"/>እምጳውሎስ፡ ሐዋርያሁ፡ ለኢየሱስ፡ ክርስቶስ፡ በፈቃደ፡ እግዚአብሔር። ወበተስፋ፡ ሕይወት፡ እንተ፡ በኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=2"/>ለጢሞቴዎስ፡ ወልድየ፡ ዘአፈቅር፡ ሰላም፡ ለከ። ወሣህል፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=3"/>አአኵቶ፡ ለእግዚአብሔር፡ ዘኪያሁ፡ አመልክ፡ በልብ፡ ንጹሕ፡ እምፍጥረትየ። ወዘልፈ፡ እዜከረከ፡ በጸሎትየ፡ መዓልተ፡ ወሌሊተ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=4"/>ወእፈቱ፡ እርአይከ፡ ወእዜከር፡ አንብዐከ።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=5"/>ወእትፌሣሕ፡ ተዘኪርየ፡ ሃይማኖተከ፡ ዘአልቦ፡ ኑፋቄ። እንተ፡ ኀደረት፡ ላዕለ፡ እምከ፡ ኤውንቄ፡ ወእምሔውትከ፡ ሎይድ። ወእፌጽም፡ ፍሥሓየ፡ ወእትአመን፡ ከመ፡ ላዕሌከኒ።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=6"/>ወበእንተ፡ ዝ፡ እዜከረከ፡ ከመ፡ ይትሐደስ፡ ጸጋሁ፡ ለእግዚአብሔር። ዘረከብከ፡ በሢመተ፡ እዴየ፡ ላዕሌከ።</t:l>
                        <t:l>በእንተ፡ ዘኢይደሉ፡ ኀፍረት፡ በሃይማኖት</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=7"/>እስመ፡ አኮ፡ መንፈሰ፡ ፍርሀት፡ ዘወሀበነ፡ እግዚአብሔር። ዘእንበለ፡ መንፈሰ፡ ኀይል፡ ወንጽሕ፡ ወተፋቅሮ፡ ወጥበብ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=8"/>ወኢትኅፈር፡ እንከ፡ በእንተ፡ ስምዑ፡ ለእግዚእነ፡ ወኢታስተኀፍረኒ፡ ኪያየ፡ ሙቁሖ። ዳእሙ፡ ጻሙ፡ ለምህሮ፡ በኀይለ፡ እግዚአብሔር፡ ዘአድኀነነ፡ ወጸውዐነ፡ በጽዋዔሁ፡ ቅዱስ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=9"/>ወአኮ፡ በከመ፡ ምግባሪነ፡ ዳእሙ፡ በከመ፡ ፈቃዱ፡ ወጸጋሁ። ዘተውህበ፡ ለነ፡ በኢየሱስ፡ ክርስቶስ፡ እምቅድመ፡ ዓለም።</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=10"/>ወአስተርአየ፡ ይእዜ፡ በምጽአቱ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ መድኀኒነ። ዘሰዐሮ፡ ለሞት፡ ወአብርሃ፡ ለሕይወት፡ ወአሰሰለ፡ ሙስና፡ በትምህርተ፡ ወንጌሉ።</t:l>
                        <t:l>በእንተ፡ ስምዕ፡ ወማሕፀንት</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=11"/>ዘሎቱ፡ ተሠየምኩ፡ ሐዋርያ፡ ወዐዋዴ፡ ወመምህረ፡ ለአሕዛብ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=12"/>ወበእንቲኣሁ፡ አሐምም፡ ወኢይትኀፈር፡ እምዘአነ፡ ቦቱ። እስመ፡ አአምር፡ ዘተአመንኩ፡ ወእትአመንሂ። ከመ፡ ይክል፡ ዐቂበ፡ ሊተ፡ ዘአማሕፀነኒ፡ እስከ፡ ይእቲ፡ ዕለት።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=13"/>ወይኩን፡ ለከ፡ አርአያ፡ ውእቱ፡ ቃለ፡ ሕይወት። ዘሰማዕከ፡ በኀቤየ፡ በሃይማኖት፡ ወበፍቅረ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=14"/>ዕቀብ፡ ማሕፀንተከ፡ ሠናየ፡ በመንፈስ፡ ቅዱስ፡ ዘኅዱር፡ ላዕሌከ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=15"/>ወዘንተኒ፡ ተአምር፡ ከመ፡ ዐለዉኒ፡ ኵሎሙ፡ እለ፡ በእስያ፡ እለ፡ ፊሎጎስ፡ ወኤርዋኔጌስ።</t:l>
                        <t:l>በእንተ፡ ጸሎት፡ ወበረከት</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=16"/>ወየሀቦ፡ እግዚአብሔር፡ ሣህለ፡ ለቤተ፡ ሄኔሴፎሩ። እስመ፡ ብዙኀ፡ አዕረፈ፡ ወኢኀፈረ፡ በእንተ፡ መዋቅሕትየ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=17"/>ወበጺሖ፡ ኀበ፡ ሮሜ፡ ፍጡነ፡ ኀሠሠኒ፡ ወረከበኒ፡ ሙቁሕየ።</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=1&amp;verse=18"/>የሀቦ፡ እግዚአብሔር፡ ይርከብ፡ ሣህለ፡ በኀበ፡ እግዚእነ፡ በይእቲ፡ ዕለት። ወመጠነ፡ ተልእከኒ፡ ሠናየ፡ በኤፌሶን፡ ለሊከ፡ ተአምር።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="2" xml:id="ch2">
                     <t:label>ምዕራፍ 2</t:label>
                     <t:ab>
                        <t:l>በእንተ፡ ምክር፡ ወትእዛዝ</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=1"/>ወአንተኒ፡ ወልድየ፡ ጽናዕ፡ በጸጋሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=2"/>ወዘሰማዕከ፡ በላዕሌየ፡ በኀበ፡ ብዙኃን፡ ሰማዕት፡ ኪያሁ፡ መሀሮሙ፡ ለመሃይምናን፡ ሰብእ። እለ፡ ይደልዎሙ፡ ከመ፡ ይምሀሩ፡ ለባዕዳን።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=3"/>ወጻሙ፡ ከመ፡ ኄር፡ መስተጋድል፡ ላእከ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=4"/>እስመ፡ አልቦ፡ ዘይትቃተል፡ ወይኄሊ፡ ንብረተ፡ ዝ፡ ዓለም። ዘእንበለ፡ ከመ፡ ያድሉ፡ ለዘሤሞ።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=5"/>መስተጋድልኒ፡ ኢይከውኖ፡ ምዝጋና፡ ለእመ፡ በሕጉ፡ ኢተጋደለ።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=6"/>ወዘኒ፡ ይጻሙ፡ ሐረሳዊ፡ ግብረ፡ ይቀድም፡ ለረኪበ፡ ፍሬሁ።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=7"/>ወለቡ፡ ዘእቤለከ፡ የሀብከ፡ እግዚአብሔር፡ ጥበበ፡ በኵሉ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=8"/>ተዘከሮ፡ ለኢየሱስ፡ ክርስቶስ፡ ዘተንሥአ፡ እምዉታን፡ ዘእምዘርዐ፡ ዳዊት፡ ዘመሀርኩ፡ በስሙ።</t:l>
                        <t:l>በእንተ፡ ሙቃሔ፡ ወትዕግሥት</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=9"/>ዘበእንቲኣሁ፡ እሠርሕ፡ ወእትሞቃሕ፡ ከመ፡ ጕሕልያ። ወባሕቱ፡ ቃለ፡ እግዚአብሔርሰ፡ ኢይትአሰር።</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=10"/>በእንተ፡ ዝ፡ እትዔገሥ፡ በኵሉ፡ በእንተ፡ ኅሩያኒሁ። ከመ፡ እሙንቱሂ፡ ይርከቡ፡ ሕይወተ፡ ዘበኢየሱስ፡ ክርስቶስ። ወስብሐተ፡ ዘለዓለም፡ ዘበሰማያት።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=11"/>እሙን፡ ነገር፡ እምከመ፡ ዐረይነ፡ መዊተ፡ ንዔሪ፡ ሕይወተ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=12"/>ወእምከመ፡ ዐረይነ፡ ትዕግሥተ፡ ንዔሪ፡ ነጊሠ። ወእመሰ፡ ክሕድናሁ፡ ውእቱኒ፡ ይክሕደነ።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=13"/>ወእመኒ፡ ኢአመናሁ፡ ውእቱሰ፡ ምእመነ፡ ይነብር፡ ወኢይክል፡ ክሒደ፡ ርእሶ።</t:l>
                        <t:l>በእንተ፡ አስምዖ፡ ወአዕቅቦ</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=14"/>ከመ፡ ዝ፡ ዘክሮሙ፡ ወአስምዕ፡ ቅድመ፡ እግዚአብሔር፡ ኢትትላኰይ፡ በግብር። ዘኢይበቊዕ፡ በዘይትገፈትዑ፡ እለ፡ ይሰምዑ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=15"/>አስተፋጥን፡ ከመ፡ ትረሲ፡ ርእሰከ፡ ኅሩየ፡ ለኀበ፡ እግዚአብሔር። ከመ፡ ገባራዊ፡ ዘኢይትኀፈር፡ ዘርቱዐ፡ ይመትር፡ ቃለ፡ እግዚአብሔር፡ በጽድቅ።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=16"/>ወለነገረ፡ ርኩሳንሰ፡ ዘአልቦ፡ ባቊዕ፡ እበዮ። እስመ፡ ያዐብይዋ፡ ለኀጢአቶሙ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=17"/>ወነገሮሙኒ፡ ከንቱ፡ ከመ፡ ዘይትረዐይ፡ ወይልህቅ፡ በብዙኃን፡ እለ፡ ሄሜኔዎስ፡ ወፊሎጦስ።</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=18"/>እለ፡ አውከኩ፡ እምጽድቅ፡ ወይብሉ፡ ወድአ፡ ኮነ፡ ትንሣኤ፡ ምዉታን። ወይገፈትዑ፡ ሃይማኖቶሙ፡ ለብዙኃን።</t:l>
                        <t:l n="19">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=19"/>ወዘሰ፡ ጽኑዕ፡ በመሠረተ፡ እግዚአብሔር፡ ይቀውም፡ እንዘ፡ ቦ፡ ዘንተ፡ ማዕተበ። ወየአምሮሙ፡ እግዚአብሔር፡ ለእሊኣሁ፡ ወይርሕቅ፡ እምዐመፃ፡ ኵሉ፡ ዘይሰሚ፡ ስመ፡ እግዚአብሔር።</t:l>
                        <t:l n="20">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=20"/>ውስተ፡ ቤትኒ፡ ዐቢይ፡ አኮ፡ ባሕቲቱ፡ ንዋየ፡ ወርቅ፡ ወብሩር። ዓዲ፡ ቦ፡ ዘዕፅኒ፡ ወዘልሕኵትኒ፡ ቦ፡ ዘለክብርኒ፡ ወቦ፡ ዘለኀሳርኒ።</t:l>
                        <t:l n="21">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=21"/>ወእመ፡ ቦ፡ ዘአንጽሐ፡ ርእሶ፡ እምዝ፡ እኩይ፡ ይከውን፡ ንዋየ፡ ክብር፡ ቅዱሰ። ወባቊዐ፡ ለመልእክተ፡ እግዚኡ፡ ወድልወ፡ ለኵሉ፡ ምግባረ፡ ሠናይ።</t:l>
                        <t:l>በእንተ፡ ርኂቅ፡ እምኃጣውእ</t:l>
                        <t:l n="22">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=22"/>ጕየያ፡ ለፍትወተ፡ ውርዙት፡ ወዴግና፡ ለጽድቅ፡ ወለሃይማኖት።</t:l>
                        <t:l n="23">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=23"/>ተፋቅሮ፡ ወሰላም፡ ምስለ፡ ኵሎሙ፡ እለ፡ ይጼውዕዎ፡ ለእግዚአብሔር፡ በልብ፡ ንጹሕ።</t:l>
                        <t:l n="24">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=24"/>እበዮ፡ ለነገረ፡ እበድ፡ ወሥላቅ፡ ወተኃሥሦ፡ ከንቱ። ተኣምር፡ ከመ፡ መንሱተ፡ ያመጽእ።</t:l>
                        <t:l n="25">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=25"/>ወገብረ፡ እግዚአብሔርሰ፡ ኢይትገአዝ፡ አላ፡ ከመ፡ ሕፃን፡ የዋሀ፡ ይከውን፡ ምስለ፡ ኵሉ። ወመምህረ፡ ወመስተዓግሠ፡ እምኵሉ፡ ወይጌሥጽ፡ በየውሀት፡ ለእለ፡ ይትቃረኑ።</t:l>
                        <t:l n="26">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=26"/>እመ፡ ቦ፡ ከመ፡ የሀቦሙ፡ እግዚአብሔር፡ ይነስሑ፡ ወያእምርዋ፡ ለጽድቅ።</t:l>
                        <t:l n="27">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=2&amp;verse=27"/>ወያንቅሑ፡ ነፍሶሙ፡ እመሥገርተ፡ ሰይጣን፡ እስመ፡ ወድአ፡ አሥገሮሙ፡ ለተሊወ፡ ፈቃዱ።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="3" xml:id="ch3">
                     <t:label>ምዕራፍ 3</t:label>
                     <t:ab>
                        <t:l>በእንተ፡ ደኃሪ፡ መዋዕል</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=1"/>ወዘንተ፡ ባሕቱ፡ አእምር፡ ከመ፡ በደኃሪ፡ መዋዕል፡ ይመጽእ፡ ዓመታት፡ እኩያት።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=2"/>ወይከውኑ፡ ሰብእ፡ መፍቀርያነ፡ ርእሶሙ፡ ወመፍቀርያነ፡ ፈጊዕ፡ ወንዋይ። ነባብያን፡ ዐላውያን፡ ዝኁራን፡ ፅሩፋን፡ ዐላውያነ፡ አዝማዲሆሙ። እለ፡ አልቦሙ፡ አኰቴት፡ ውፁኣን፡ እምጽድቅ።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=3"/>እለ፡ አልቦሙ፡ ምሕረት፡ ሥሑጻን፡ ጸላእያነ፡ ሠናይ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=4"/>ዝሉፋን፡ ጽሉኣን፡ እለ፡ ያበድሩ፡ ሐውዘ፡ እምፍቅረ፡ እግዚአብሔር።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=5"/>ይትሜሰሉ፡ ጻድቃነ፡ ወይክሕድዎ፡ ለኀይለ፡ ጽድቅ። ወለእለ፡ ከመ፡ ዝ፡ ተገሐሦሙ።</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=6"/>እስመ፡ እሙንቱ፡ እለ፡ ይትባውኡ፡ አብያተ፡ ሰብእ። ወይፄውውዎን፡ ለአንስት፡ እለ፡ ፅፉራት፡ በኀጢአት፡ ወያወርዳ፡ ውስተ፡ ብዙኀ፡ ፍትወት።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=7"/>ወዘልፈ፡ ይትጌሠጹ፡ ወኢየአምርዋ፡ ግሙራ፡ ለጽድቅ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=8"/>ከመ፡ ኢያኔስ፡ ወኢያንበሬስ፡ እለ፡ ተቃወምዎ፡ ለሙሴ። ከማሁ፡ እሉሂ፡ ተቃወምዋ፡ ለጽድቅ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=9"/>ሰብእ፡ ሙሱናነ፡ ልብ፡ ወንፉቃነ፡ ሃይማኖት፡ ወኢይትሌዐሉ። እስመ፡ ፈድፈደት፡ እበዶሙ፡ ወተዐውቀት፡ ለኵሉ፡ ከመ፡ እበዶሙ፡ ለእልክቱ፡ ዓዲ።</t:l>
                        <t:l>በእንተ፡ ተሊዎተ፡ መምህራን</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=10"/>ወአንተሰ፡ ተለውከ፡ ትምህርትየ፡ ወተመሰል፡ በግዕዝየ። በዘመሀርኩከ፡ በሃይማኖት፡ ወበተፋቅሮ፡ ወበትዕግሥት፡ ወበኅድአት፡ ወበተሰዶ፡ ወበሕማም።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=11"/>ተኣምር፡ መጠነ፡ ረከበኒ፡ በአንጾኪያ፡ ወበኢቆንያ፡ ወበልስጥራን። መጠነ፡ ተዐገሥኩ፡ ተሰዶ።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=12"/>ወእምኵሉ፡ አድኀነኒ፡ እግዚአብሔር። ወኵሎሙ፡ እለ፡ ይፈቅዱ፡ ይሕየዉ፡ በጽድቀ፡ ኢየሱስ፡ ክርስቶስ፡ የሐምሙ።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=13"/>ወሰብእሰ፡ እኩያን፡ ይትሌዐሉ፡ ውስተ፡ እንተ፡ ተአኪ፡ ወይስሕቱ፡ ወያስሕቱ።</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=14"/>ወአንተሰ፡ ሀሉ፡ በዘተምህርከ፡ ወተአመንከ።</t:l>
                        <t:l>በእንተ፡ መጽሐፍ፡ ቅዱስ</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=15"/>ተኣምር፡ በኀበ፡ መኑ፡ ተምህርከ። እምን፡ እስከ፡ መጽሐፈ፡ ቅዱሰ። ዘይክል፡ አሕይዎተከ፡ በሃይማኖተ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=16"/>ወኵሉ፡ መጽሐፍ፡ ዘበመንፈሰ፡ እግዚአብሔር፡ ተጽሕፈ። ይበቊዕ፡ ለኵሉ፡ ትምህርት፡ ወተግሣጽ፡ ወአርትዖ፡ ወጥበብ፡ ወጽድቅ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=3&amp;verse=17"/>ከመ፡ ይትገሠጽ፡ ብእሴ፡ እግዚአብሔር፡ ውስተ፡ ኵሉ፡ ምግባረ፡ ሠናይ።</t:l>
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="chapter" n="4" xml:id="ch4">
                     <t:label>ምዕራፍ 4</t:label>
                     <t:ab>
                        <t:l>በእንተ፡ ትእዛዝ፡ ወትንቢት</t:l>
                        <t:l n="1">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=1"/>ወእኤዝዘከ፡ በቅድመ፡ እግዚአብሔር፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ። ዘሀለዎ፡ ይኰንን፡ ሕያዋነ፡ ወምዉታነ፡ አመ፡ ይመጽእ፡ በመንግሥቱ።</t:l>
                        <t:l n="2">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=2"/>ከመ፡ ትስብክ፡ ቃሎ፡ ቀዊመከ፡ በድቡት፡ በጊዜሁ፡ ወዘእንበለ፡ ጊዜሁ። ገሥጽ፡ ወተዛለፍ፡ ናዝዝ፡ ወየውህ፡ እንዘ፡ ትትዔገሥ፡ በኵሉ፡ ወትሜህር።</t:l>
                        <t:l n="3">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=3"/>እስመ፡ ይበጽሕ፡ ጊዜሁ፡ አመ፡ የአብይዋ፡ ለትምህርተ፡ ሕይወት። ወየሐውሩ፡ በፍትወቶሙ፡ ወያመጽኡ፡ መምህራነ፡ ለርእሶሙ፡ በሁከተ፡ እዘኒሆሙ።</t:l>
                        <t:l n="4">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=4"/>ወይመይጡ፡ እዘኒሆሙ፡ እምጽድቅ፡ ወያመጽኡ፡ ካልአ፡ ትምህርተ። ወይትመየጡ፡ ኀበ፡ መሐድምት።</t:l>
                        <t:l n="5">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=5"/>ወአንተሰ፡ ንቃሕ፡ ወጥበብ፡ በኵሉ፡ ወጻሙ፡ ወግበር፡ ምግባረ፡ ወንጌላዌ። ወኩን፡ ወፈጽም፡ መልእክተከ።</t:l>
                        <t:l>በእንተ፡ ፍጻሜ፡ ስምዑ፡ ለጳውሎስ</t:l>
                        <t:l n="6">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=6"/>ወአንሰ፡ ወዳእኩ፡ ወሠለጥኩ፡ ወበጽሐኒ፡ ዕድሜየ፡ ለአዕርፎ።</t:l>
                        <t:l n="7">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=7"/>ሠናየ፡ ገድለ፡ ተጋደልኩ፡ በድርየኒ፡ ፈጸምኩ፡ ወሃይማኖትየኒ፡ ዐቀብኩ።</t:l>
                        <t:l n="8">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=8"/>እንከሰ፡ ጽኑሕ፡ ሊተ፡ አክሊለ፡ ጽድቅ። ዘየዐስየኒ፡ እግዚአብሔር፡ ይእተ፡ ዕለተ፡ መኰንነ፡ ጽድቅ።</t:l>
                        <t:l n="9">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=9"/>ወአኮ፡ ለባሕቲትየ፡ አላ፡ ለኵሎሙ፡ እለ፡ ያፈቅሩ፡ ምጽአተ፡ ዚኣሁ። አስተፋጥን፡ ትምጻእ፡ ኀቤየ፡ ፍጡነ።</t:l>
                        <t:l n="10">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=10"/>ዴማስ፡ ኀደገኒ፡ ወአፍቀሮ፡ ለዝንቱ፡ ዓለም፡ ዘይእዜ፡ ወሖረ፡ ተሰሎንቄ። ወቆሬቄስኒ፡ ገላትያ፡ ወቲቶ፡ ድልማጥያ፡ ሉቃስ፡ ባሕቲቱ፡ ምስሌየ።</t:l>
                        <t:l n="11">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=11"/>ወአምጽኦ፡ ምስሌከ፡ ለማርቆስ፡ እስመ፡ ይበቊዐኒ፡ ለመልእክት።</t:l>
                        <t:l n="12">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=12"/>ወፈነውክዎ፡ ለጢኪቆስ፡ ኤፌሶን።</t:l>
                        <t:l n="13">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=13"/>ወፌሎነኒ፡ ዘመጽሐፍ፡ ዘኀደጉ፡ በጢሮአስ፡ ኀበ፡ አክርጳ። ተማላእ፡ ምስሌከ፡ ወዓዲ፡ መጻሕፍተ፡ ወረቀ።</t:l>
                        <t:l>ተግሣጽ፡ ወሥርየት</t:l>
                        <t:l n="14">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=14"/>እለ፡ እስክንድሮስ፡ ነሃቢ፡ ብዙኀ፡ ሣቀየኒ። ይፍድዮ፡ እግዚአብሔር፡ በከመ፡ ምግባሩ።</t:l>
                        <t:l n="15">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=15"/>ወአንተኒ፡ ወልድየ፡ ተዐቀቦ፡ እስመ፡ ፈድፋደ፡ ተቃወሞ፡ ለነገርነ።</t:l>
                        <t:l n="16">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=16"/>ወበቀዳሚ፡ ነገርየ፡ አልቦ፡ ዘኀብረ፡ ምስሌየ። ዳእሙ፡ ኵሎሙ፡ ኀደጉኒ፡ ወይሥረይ፡ ሎሙ፡ ዘንተ።</t:l>
                        <t:l n="17">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=17"/>እስመ፡ እግዚአብሔር፡ ቆመ፡ ሊተ፡ ወአጽንዐኒ፡ ከመ፡ ይእመኑ፡ በስብከተ፡ ዚኣየ። ወይስምዑ፡ ኵሎሙ፡ አሕዛብ፡ ከመ፡ ድኅንኩ፡ እምአፈ፡ አንበሳ።</t:l>
                        <t:l n="18">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=18"/>ወያድኅነኒ፡ እግዚአብሔር፡ እምኵሉ፡ ግብር፡ እኩይ። ወያሐይወኒ፡ ውስተ፡ መንግሥቱ፡ ዘበሰማያት፡ ውእቱ። ዘሎቱ፡ ስብሐት፡ ለዓለመ፡ ዓለም፡ አሜን።</t:l>
                        <t:l>ማኅተመ፡ መልእክት</t:l>
                        <t:l n="19">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=19"/>አምኀ፡ ጵርስቅላ፡ ወአቂላ፡ ወቤተ፡ ሄኔሴፎሩ።</t:l>
                        <t:l n="20">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=20"/>ኤርስጦስ፡ ነበረ፡ ቆሮንቶስ፡ ወለጥሮፊሞስ፡ ኀደግዎ፡ በሀገረ፡ መሊጡ፡ ይደዊ።</t:l>
                        <t:l n="21">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=21"/>አስተፋጥን፡ ትምጻእ፡ ኀቤየ፡ እምቅድመ፡ ክረምት። ይኤምኁከ፡ ኤውግሎስ፡ ወጱዴስ፡ ወሊኖስ፡ ወቀላውድያ፡ ወኵሎሙ፡ አኀዊነ።</t:l>
                        <t:l n="22">
                           <t:ref target="http://classic.net.bible.org/verse.php?book=2Ti&amp;chapter=4&amp;verse=22"/>ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ የሀሉ፡ ምስለ፡ መንፈስከ፡ ወጸጋሁ፡ ምስሌክሙ፡ አሜን።</t:l>
                     </t:ab>
                  </t:div>
               
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>