               <t:div type="textpart" subtype="chapter" n="1" xml:id="ch1">
                  <t:label>ምዕራፍ 1</t:label>
                  <t:ab>
                     <t:l>መልእክተ፡ ብፅዓን፡ ወአስተብቍዖ</t:l>
                     <t:l n="1">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=1"/>እምጳውሎስ፡ ሙቁሑ፡ ለኢየሱስ፡ ክርስቶስ፡ ወጢሞቴዎስ፡ እኁነ። ለፊልሞና፡ ዘናፈቅር፡ ዘየኀብር፡ ግብረ፡ ምስሌነ፡ ወለአብፍምያ፡ እኅትነ።</t:l>
                     <t:l n="2">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=2"/>ወለአክርጳ፡ ወልዱ፡ ዘይገብር፡ ምስሌነ። ወለእለ፡ ምስሌሆሙ፡ እለ፡ ውስተ፡ ቤተ፡ ክርስቲያን።</t:l>
                     <t:l n="3">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=3"/>ሰላም፡ ለክሙ፡ ወጸጋ፡ እግዚአብሔር፡ አቡነ፡ ወእግዚእነ፡ ኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="4">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=4"/>አአኵቶ፡ ለአምላክየ፡ ዘልፈ፡ ወእዜከረከ፡ በጸሎትየ።</t:l>
                     <t:l n="5">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=5"/>እምአመ፡ ሰማዕኩ፡ ሃይማኖተከ፡ ወፍቅረከ፡ ዘበእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ወዘኵሎሙ፡ ቅዱሳን።</t:l>
                     <t:l n="6">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=6"/>ከመ፡ ጽኑዐ፡ ይኩን፡ ሱታፌ፡ ሃይማኖትከ፡ በምግባረ፡ ሠናይ። ወበአእምሮ፡ ኵሉ፡ ሠናይ፡ ዘበኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="7">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=7"/>ተፈሣሕኩ፡ ወተሐሠይኩ፡ በእንተ፡ ተፋቅሮትከ። እስመ፡ አዕረፈት፡ ነፍሶሙ፡ ለቅዱሳን፡ በኀቤከ፡ እኁየ።</t:l>
                     <t:l n="8">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=8"/>ወብየ፡ በእንተ፡ ዝንቱ፡ ሞገስ፡ ዐቢይ፡ በክርስቶስ። ከመ፡ አአዝዝከ፡ ትእዛዘ፡ ጽድቅ።</t:l>
                     <t:l n="9">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=9"/>ወበተፋቅሮ፡ አስተበቊዐከ፡ አስተብቊዖተ፡ አነ፡ ጳውሎስ። እስመ፡ ልሂቅ፡ አነ፡ ዘከመ፡ ተአምር። ወይእዜኒ፡ ዓዲ፡ ሙቁሑ፡ ለኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l>በእንተ፡ አናሲሞስ</t:l>
                     <t:l n="10">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=10"/>አነ፡ አስተበቊዐከ፡ በእንተ፡ ወልድየ፡ ዘወለድክዎ፡ በመዋቅሕትየ፡ ዘውእቱ፡ አናሲሞስ።</t:l>
                     <t:l n="11">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=11"/>ዘቀዲሙሰ፡ ኢበቊዐከ፡ ወይእዜሰ፡ ለከሂ፡ ወሊተሂ፡ ባቍዐ፡ ኮነ፡ ጥቀ።</t:l>
                     <t:l n="12">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=12"/>ወናሁ፡ ፈነውክዎ፡ ኀቤከ፡ ተወከፎ፡ ከመ፡ ወልድየ።</t:l>
                     <t:l n="13">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=13"/>ወፈቀድኩሰ፡ አንብሮ፡ ኀቤየ፡ ከመ፡ ይትለአከኒ፡ ህየንቴከ፡ በመዋቅሕትየ፡ ዘበወንጌል።</t:l>
                     <t:l n="14">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=14"/>ወኢፈቀድኩ፡ ምንተኒ፡ እግበር፡ ዘእንበለ፡ ታእምር። ከመ፡ ኢይኩን፡ በአገብሮ፡ ሠናያቲከ፡ ዳእሙ፡ በፈቃደ፡ ልብከ።</t:l>
                     <t:l n="15">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=15"/>ወዮጊ፡ በበይነ፡ ዝንቱ፡ ኀደገከ፡ ለሰዓት፡ ከመ፡ ይኩንከ፡ ለዓለም።</t:l>
                     <t:l n="16">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=16"/>አኮ፡ እንከ፡ ከመ፡ ገብር፡ አላ፡ ዘይኄይስ፡ እምገብር። እመሰ፡ ኮነ፡ ሊተ፡ እኁየ፡ እፎ፡ ፈድፋደ፡ ይኄይስ፡ በኀቤከ። በሥጋሁኒ፡ በዘይደልዎ፡ ይርዳእከ፡ ወበሃይማኖትኒ፡ ዘበእግዚእነ።</t:l>
                     <t:l n="17">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=17"/>ወእመሰ፡ እኁየ፡ አንተ፡ ተወከፎ፡ ከማየ።</t:l>
                     <t:l n="18">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=18"/>ወእመሂ፡ ቦ፡ ዘአበሰ፡ ለከ፡ አው፡ እመ፡ ቦ፡ ዘይፈድየከ፡ ላዕሌየ፡ ረሲ።</t:l>
                     <t:l n="19">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=19"/>አነ፡ ጳውሎስ፡ ጸሐፍኩ፡ በእዴየ። አነ፡ እፈዲ፡ በእንቲኣሁ፡ ከመሰ፡ ኢይበልከ፡ ርእሰከኒ፡ ትመጡ። ይደልወኒ፡ እወ፡ እኁየ።</t:l>
                     <t:l n="20">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=20"/>እትፌሣሕ፡ ብከ፡ በእግዚእነ፡ አዕርፈኒ፡ ካዕበ። ወአስተፋስሓ፡ ለነፍስየ፡ በክርስቶስ።</t:l>
                     <t:l n="21">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=21"/>ወተአሚንየ፡ በተአዝዞትከ፡ ጸሐፍኩ፡ ለከ። አእሚርየ፡ ከመ፡ ትወስከ፡ እምዘአዘዝኩከ።</t:l>
                     <t:l n="22">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=22"/>ወምስለ፡ ዝኒ፡ አስተዳሉ፡ ሊተ፡ ማኅደረ። እስመ፡ እትአመን፡ በጸሎትክሙ፡ ከመ፡ ይሠርሐኒ፡ እግዚአብሔር፡ ወይጸግወኒ፡ ኪያክሙ።</t:l>
                     <t:l>ማኅተመ፡ መልእክት</t:l>
                     <t:l n="23">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=23"/>አምኀከ፡ ኤጳፍራስ፡ ዘተፄወወ፡ ምስሌየ፡ በኢየሱስ፡ ክርስቶስ።</t:l>
                     <t:l n="24">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=24"/>ወማርቆስ፡ ወአርስጥሮኮስ፡ ወዴማስ፡ ወሉቃስ፡ እለ፡ ነኀብር፡ ግብረ።</t:l>
                     <t:l n="25">
                        <t:ref target="http://classic.net.bible.org/verse.php?book=Phm&amp;chapter=1&amp;verse=25"/>ጸጋሁ፡ ለእግዚእነ፡ ኢየሱስ፡ ክርስቶስ፡ ምስለ፡ መንፈስክሙ፡ አሜን።</t:l>
                  </t:ab>
               </t:div>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>