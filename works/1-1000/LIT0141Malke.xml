         <div type="edition" xml:lang="gez" xml:id="div2LIT0141Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ ዘአንጸፍጸፈ፡ ጽሙና፨</l>
                  <l n="2">ወለልደትከ፡ ዓዲ፡ በብሥራተ፡ መልአክ፡ ወዜና፨</l>
                  <l n="3">በጸሎተ፡ ሚካኤል፡ ሀበኒ፡ ወጸግወኒ፡ ጥዒና፨</l>
                  <l n="4">ነፍስየ፡ ጊዜ፡ ዕረፍት፡ ከመ፡ ኢትርአይ፡ ሙስና፨</l>
                  <l n="5">በእደ፡ ሚካኤል፡ ሴስየኒ፡ አውሪደከ፡ መና፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ከመ፡ ስቴ፡ መዐር፡ ጥዑም፨</l>
                  <l n="2">ወለሥዕርትከ፡ ዓዲ፡ በቅብአ፡ መንፈስ፡ ልምሉም፨</l>
                  <l n="3">በጸሎተ፡ ሚካኤል፡ ጻድቅ፡ እንተ፡ አልብከ፡ ንዋም፨</l>
                  <l n="4">በጾም፡ ወበቀኖና፡ ከመ፡ እንተ፡ አብ፡ ወእም፨</l>
                  <l n="5">ለመነኰሳት፡ አበው፡ ዘኮንኮሙ፡ ዖም፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ መአድም፨</l>
                  <l n="2">እምውሳጤ፡ ገዳም፡ ዘቅድም፨</l>
                  <l n="3">በጸሎተ፡ ሚካኤል፡ ትጉህ፡ ዘተሐውር፡ በጊዜ፡ ንዋም፨</l>
                  <l n="4">ፍጹመ፡ ሶበ፡ በጻሕከ፡ ውስተ፡ ደብረ፡ ግሼ፡ ገዳም፨</l>
                  <l n="5">እንተ፡ ለምሕረት፡ ወሣህል፡ ወረደ፡ ዝናም፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ተወከፍ፡ ዘአቅረብኩ፡ ድርሳነ፡ በረከት፡ ሠናይ፨</l>
                  <l n="2">ለመልክኣቲከ፡ ኵሎን፡ በቃለ፡ ግናይ፨</l>
                  <l n="3">በጸሎተ፡ ሚካኤል፡ ሐዋርያ፡ ወዘበነቢያት፡ ነቢይ፨</l>
                  <l n="4">ከመ፡ ትኅድር፡ በላዕሌየ፡ ጸጋ፡ መንፈስ፡ ቅዱስ፡ ርሡይ፨</l>
                  <l n="5">እስመ፡ ተማሕፀንኩ፡ ገብርከ፡ ነዳይ፨</l>
               </lg>
               <lg type="stanza" n="35">
                  <l n="1">ዐምደ፡ ሃይማኖት፡ ግሩም፡ ውስተ፡ ቤተ፡ መቅደስ፡ ዘይቀውም፨</l>
                  <l n="2">በጸሎተ፡ ሚካኤል፡ ካህን፡ መክሥተ፡ አፉሁ፡ መዐር፡ ጥዑም፨</l>
                  <l n="3">አመ፡ አፍለሱ፡ አዕፅምቲሁ፡ በጕንዱይ፡ ዓም፨</l>
                  <l n="4">ሶበ፡ አዕጸፉ፡ አብራኪሁ፡ አንጸፍጸፈ፡ ደም፨</l>
               </lg>
            </div>
         </div>
      </body>
      
