      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0153</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0153Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ በዓለ፡ ሐዲስ፡ ፍካሬ፨</l>
                  <l n="2">ወለሥዕርትከ፡ ሰላም፡ ዐርዘ፡ ሊባኖስ፡ ምሉአ፡ ፍሬ፨</l>
                  <l n="3">አፈ፡ ወርቅ፡ ዮሐንስ፡ ወልሳነ፡ ዕንቍ፡ ወራውሬ፨</l>
                  <l n="4">ካህናት፡ በብርሃንከ፡ ያስተዋድዱ፡ ዝማሬ፨</l>
                  <l n="5">እስመ፡ ብርሃንከ፡ የሀይድ፡ ንጻሬ፨</l>
               </lg>
               <lg type="stanza" n="25">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ እምሀገረ፡ ራእይ፡ ፍጥሞ፨</l>
                  <l n="2">በእደ፡ ካህናት፡ ኄራን፡ ኀበ፡ ቀደምትከ፡ ተሰይሞ፨</l>
                  <l n="3">አፈ፡ ወርቅ፡ ዮሐንስ፡ ፍትወተ፡ ምግባር፡ እምቀናንሞ፨</l>
                  <l n="4">መሀርከ፡ ቃለ፡ ወንጌል፡ ወአጽናዕከ፡ ስሞ፨</l>
                  <l n="5">ለእግዚአብሔር፡ ተውላጠ፡ በክርስቶስ፡ ዓለሞ፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ገነተ፡ ማሕሌትከ፡ ኀበ፡ ገጽየ፡ ለኑኀ፡ ሰማይ፡ በታሕቱ፨</l>
                  <l n="2">ወሪደ፡ አፍጥን፡ እስመ፡ ጊዜ፡ ወሪድ፡ ውእቱ፨</l>
                  <l n="3">አፈ፡ ወርቅ፡ ዮሐንስ፡ ለእግዚአብሔር፡ መጋቤ፡ ቤቱ፨</l>
                  <l n="4">ትዌድሰከ፡ ብሂለ፡ ቃለ፡ ቤተ፡ ክርስቲያን፡ መርዓቱ፨</l>
                  <l n="5">ወልደ፡ እኁየ፡ ወሪዶ፡ ውስተ፡ ገነቱ፡ አፈዋተ፡ ምዑዞ፡ ልብሰቱ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
