      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0129</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0129Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ሠናይ፡ ወአዳም፨</l>
                  <l n="2">ውስተ፡ አድባራተ፡ ኵሉ፡ ወዘውስተ፡ ኵሉ፡ ዓለም፨</l>
                  <l n="3">አለብወኒ፡ ዳንኤል፡ ብእሴ፡ ጸሎት፡ ወጾም፨</l>
                  <l n="4">ከመ፡ እንግር፡ ዜና፡ ጽድቅከ፡ ማዕከለ፡ ዛቲ፡ ኤላም፨</l>
                  <l n="5">ኀበ፡ ተጋብኡ፡ ደቂቅከ፡ ዮም፨</l>
               </lg>
               <lg type="stanza" n="22">
                  <l n="1">ሰላም፡ ለቆምከ፡ በሀሊበ፡ ጸሎት፡ ዘልህቀ፨</l>
                  <l n="2">ወለመልክእከ፡ ይእቲ፡ እንተ፡ ኢሐፀት፡ ሕቀ፨</l>
                  <l n="3">ኢትትሐየኒ፡ ዳንኤል፡ ወኢትኅድገኒ፡ ጥቀ፨</l>
                  <l n="4">ኢይትሜነይ፡ አንሰ፡ አኮኑ፡ ተስፋ፡ መደልዋን፡ ወርቀ፨</l>
                  <l n="5">ባሕቱ፡ በረከትከ፡ እፈቱ፡ ጥዩቀ፨</l>
               </lg>
               <lg type="stanza" n="23">
                  <l n="1">ጊዜ፡ ትወጽእ፡ ነፍስከ፡ እምነ፡ ሥጋ፡ መካና፨</l>
                  <l n="2">በእደ፡ ገብርኤል፡ መልአከ፡ ብስራት፡ ወዜና፨</l>
                  <l n="3">ዳንኤል፡ መምህረ፡ ትዕግሥት፡ ወትሕትና፨</l>
                  <l n="4">አልቦ፡ ዘይትበየጸከ፡ በክብር፡ ወበልዕልና፨</l>
                  <l n="5">እንበለ፡ ፃና፡ ቤተ፡ ቂርቆስ፡ ወካልእታ፡ ሲና፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ አመ፡ አሚሩ፡ ለወርኀ፡ ታስዕ፨</l>
                  <l n="2">በእደ፡ አበው፡ አምኃ፡ ወታዴዎስ፡ ብፁዕ፨</l>
                  <l n="3">ዳንኤል፡ ነበልባላዊ፡ ነበሪ፡ ኀበ፡ እግረ፡ ዕፀ፡ ዐባይ፡ አውልዕ፨</l>
                  <l n="4">እብዕዎ፡ በይባቤ፡ ውስተ፡ ቤተ፡ መቅደስ፡ ምሥዋዕ፨</l>
                  <l n="5">በእደ፡ ማርያም፡ ንጉሥ፡ ወኖብ፡ እግዚእ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">አምኃ፡ ሰላም፡ አቅረብኩ፡ ለመልክእከ፡ ውዳሴ፨</l>
                  <l n="2">በሥምረተ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ሥላሴ፨</l>
                  <l n="3">ዳንኤል፡ መምህረ፡ ሥርዓት፡ ወክናሴ፨</l>
                  <l n="4">በከመ፡ ተወክፈ፡ እግዚእከ፡ ጸሎቶ፡ ለሙሴ፨</l>
                  <l n="5">ተወክፍ፡ አምኃየ፡ ለገብርከ፡ አውሴ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ዳንኤል፡ መምህረ፡ ሥርዓት፡ ወሕግ፨</l>
                  <l n="2">ያስተበፅዑከ፡ ኅሩያን፡ በደርግ፨</l>
                  <l n="3">እስከ፡ ደቂቅ፡ ወአእሩግ፨</l>
               </lg>
               <lg type="stanza" n="6">
                  <l n="1">ሰላም፡ ለከ፡ ዳንኤል፡ በዕለት፡ አሐቲ፨</l>
                  <l n="2">እምጋኔነ፡ ቀትር፡ ወእምሰይጣን፡ መስሓቲ፨</l>
                  <l n="3">አባ፡ አድኅና፡ ለነፍስየ፡ ዛቲ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
