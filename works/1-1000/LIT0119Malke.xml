      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0119</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0119Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ናሁ፡ ወጠንኩ፡ ለመልክእከ፡ ሰላሞ፨</l>
                  <l n="2">ወዜና፡ ኂሩትከ፡ እንግር፡ በብዙኅ፡ አስተሐምሞ፨</l>
                  <l n="3">ዘኢየሱስ፡ ርድአኒ፡ በነቢብ፡ ወበተርጕሞ፨</l>
                  <l n="4">ለሀኬተ፡ ሥጋ፡ ኢያእምር፡ ድካሞ፨</l>
                  <l n="5">እስከ፡ በትጋህ፡ እፌጽም፡ ወአበጽሕ፡ አቅሞ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ በጊዜ፡ ወፅአ፡ እምከርሥ፨</l>
                  <l n="2">ዘተጸውዐ፡ ፍጹመ፡ በስመ፡ ኢየሱስ፡ ክርስቶስ፨</l>
                  <l n="3">ኪያከ፡ ንሰብሕ፡ በቃለ፡ ማሕሌት፡ ሐዲስ፨</l>
                  <l n="4">እለ፡ ተጋባእነ፡ በዓለመ፡ ሥጋ፡ ወነፍስ፨</l>
                  <l n="5">ባርከነ፡ አባ፡ በመስቀል፡ ቅዱስ፨</l>
               </lg>
               <lg type="stanza" n="25">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ በእደ፡ ኅሩያን፡ አርድእት፨</l>
                  <l n="2">ወለመቃብሪከ፡ ሰላም፡ በዐጸደ፡ ተስፋ፡ ኅሪት፨</l>
                  <l n="3">ዘኢየሱስ፡ ንጹሕ፡ ዘውገ፡ መላእክት፨</l>
                  <l n="4">ጸግወኒ፡ በረከተከ፡ ምስለ፡ ፍጻሜ፡ ረድኤት፨</l>
                  <l n="5">ህየንተ፡ ጻመውከ፡ በዘቀዋሚ፡ መላእክት፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">አምኃ፡ ስብሐት፡ ሐዲስ፡ ሀወልተ፡ ወርቅ፡ ወብሩር፨</l>
                  <l n="2">እንተ፡ አቅረብኩ፡ ንስቲተ፡ ለመልክእከ፡ ንኩር፨</l>
                  <l n="3">ዘኢየሱስ፡ ትትወከፍ፡ ወትሠጠው፡ በፍቅር፨</l>
                  <l n="4">ነዓ፡ ነዓ፡ ምስለ፡ ሳሙኤል፡ መምህር፨</l>
                  <l n="5">ወእንጦንዮስ፡ ወላዲሁ፡ ፈላሲ፡ ክቡር፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ለመጽሐፈ፡ ብዙኅ፡ ተኣምሪከ፡ ናነብቦ፡ በልሳን፨</l>
                  <l n="2">ወንስምዖ፡ በእዝን፨</l>
                  <l n="3">ሃሌ፡ ሉያ፡ ሳሙኤል፡ አበ፡ ብዙኃን፨</l>
                  <l n="4">ነዓ፡ ሃቤነ፡ ለባርኮ፡ ምስለ፡ መኅበራኒከ፡ ቅዱሳን፨</l>
                  <l n="5">በሥምረተ፡ እሙ፡ ድንግል፡ ወወልዳ፡ መድኅን፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">መትልወ፡ እንጦኒ፡ እንጦንስ፡ ገብረ፡ መስቀል፡ ወገብረ፡ ክርስቶስ፨</l>
                  <l n="2">ዘሃሌ፡ ሉያ፡ ሳሙኤል፡ ወዘኢየሱስ፨</l>
                  <l n="3">ላእካነ፡ ማርያም፡ ድንግል፡ ወአግብርተ፡ ወልዳ፡ ክርስቶስ፨</l>
                  <l n="4">ለለ፡ ጸዋዕነ፡ ስመክሙ፡ በቃለ፡ ማሕሌት፡ ሐዲስ፨</l>
                  <l n="5">ለባርኮትነ፡ ንዑ፡ ውስተ፡ ዘመቅደስ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለክሙ፡ እንጦንዮስ፡ ወሳሙኤል፨</l>
                  <l n="2">ዘኢየሱስ፡ ወገብረ፡ ክርስቶስ፡ ወገብረ፡ መስቀል፨</l>
                  <l n="3">ዘሐውጸቶ፡ ፈተወ፡ ቀዳማ፡ ሕዝበ፡ እስራኤል፨</l>
                  <l n="4">በሞገስክሙ፡ ሞገሰ፡ ማርያም፡ ድንግል፨</l>
                  <l n="5">ንግሥተ፡ ስብሐት፡ አክሊል፨</l>
                  <l n="6">ነያ፡ ትትፌሣሕ፡ ወትትኀሠይ፡ ደብረ፡ ሃሌ፡ ሉያ፡ ቤቴል፨</l>
               </lg>
            </div>
         </div>
      </body>
      
