         <div type="edition" xml:lang="gez" xml:id="div2LIT0152Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ በደቃደ፡ አምላክ፡ ኬንያ፨</l>
                  <l n="2">ወለልደትከ፡ ሰላም፡ በዕለተ፡ ሐዳስ፡ ምርያ፨</l>
                  <l n="3">ዘዮሐንስ፡ ወልዱ፡ ለተክለ፡ ሃይማኖት፡ ሐዋርያ፨</l>
                  <l n="4">ለአቡከ፡ ዘካርያስ፡ ወለእምከ፡ ሶፍያ፨</l>
                  <l n="5">ደብረ፡ ሊባኖስ፡ ትዜምር፡ ወትየብብ፡ ነያ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ከመ፡ ስመ፡ ዮሐንስ፡ ከማ፨</l>
                  <l n="2">ዘምስለ፡ ብስራት፡ ተሰብከ፡ በአፈ፡ ገብርኤል፡ መልአከ፡ ራማ፨</l>
                  <l n="3">ወልደ፡ ሶፍያ፡ ዘዮሐንስ፡ ወወልደ፡ ዘካርያስ፡ መስግነ፡ ግርማ፨</l>
                  <l n="4">ለመቅደስከ፡ ባሕታዊት፡ ዘቤተ፡ ገብርኤል፡ ስማ፨</l>
                  <l n="5">ናሁ፡ ፈድፈደ፡ ወጸንዐ፡ ሕማማ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ውስተ፡ ብርሃናዊ፡ ሰሌዳሆሙ፨</l>
                  <l n="2">አጻብዐ፡ ሥሉስ፡ ቅዱስ፡ ዘጸሐፍዎ፡ ቀዲሙ፨</l>
                  <l n="3">ዘዮሐንስ፡ ሕቱም፡ ለተክለ፡ ሃይማኖት፡ በማሕተሙ፨</l>
                  <l n="4">ተፈሣሕነ፡ ሶበ፡ አእመርነ፡ ለአበዊከ፡ ስሞሙ፨</l>
                  <l n="5">ከመ፡ ለመልከ፡ ጼዴቅ፡ እሙራን፡ አቡሁ፡ ወእሙ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ለተአምኖታ፡ ሶበ፡ አድነኑ፨</l>
                  <l n="2">ሕሙማነ፡ ኵሎ፡ ዘትፌውስ፡ በበ፡ ዘመኑ፨</l>
                  <l n="3">ዘዮሐንስ፡ ጽዱል፡ ለገብርኤል፡ ዕንቈ፡ መካኑ፨</l>
                  <l n="4">በዲናር፡ ወመካልይ፡ ዘይሣየጠከ፡ መኑ፨</l>
                  <l n="5">እመካልየ፡ ወርቅ፡ ዐፅምከ፡ ይከብር፡ አኮኑ፨</l>
               </lg>
               <lg type="stanza" n="33">
                  <l n="1">እመንፈስ፡ ቅዱስ፡ አበ፡ ሰላም፡ ወእማሕፀና፡ ለዮርዳኖስ፨</l>
                  <l n="2">እለ፡ ተረከብክሙ፡ ውለድ፡ ሱቱፋነ፡ ልደት፡ ሐዲስ፨</l>
                  <l n="3">በአፈ፡ ቢጽክሙ፡ ትሑት፡ ወእኁክሙ፡ ንዑስ፨</l>
                  <l n="4">ዘንተ፡ ስብሐተ፡ መንፈሳዌ፡ እስመ፡ ነበበ፡ ክርስቶስ፨</l>
                  <l n="5">ወባረከ፡ ዓመተ፡ ኢያሱ፡ ንጉሥ፨</l>
                  <l n="6">ንዑ፡ ንትፈሣሕ፡ ዮም፡ በበዓሉ፡ ለዘዮሐንስ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
