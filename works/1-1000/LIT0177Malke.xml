      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0177</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0177Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ ሕያው፡ ለዕጓለ፡ እመሕያው፡ ዘሠምሮ፨</l>
                  <l n="2">እስመ፡ ይእዜ፡ ወጠንኩ፡ ስብሐተ፡ መልክእከ፡ ለተናግሮ፨</l>
                  <l n="3">ሠናየ፡ ዝብጠት፡ ቴዎድሮስ፡ ድምፀ፡ መክብዩ፡ ከበሮ፨</l>
                  <l n="4">ዘይነግር፡ ዜና፡ ጽድቅከ፡ ወዘያሤኒ፡ ዘምሮ፨</l>
                  <l n="5">እምአእምሮትከ፡ ክፍለኒ፡ አእምሮ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘጽሑፍ፡ ፊደሉ፨</l>
                  <l n="2">ዘያሜንን፡ ወይነ፡ ወዘያረስዕ፡ ነገረ፡ ኵሉ፨</l>
                  <l n="3">ቴዎድሮስ፡ ሆሴዕ፡ ለእግዚአብሔር፡ ነቢየ፡ ቃሉ፨</l>
                  <l n="4">ለእለ፡ ግብሩ፡ ተዝካረከ፡ ወበዓለከ፡ አብዐሉ፨</l>
                  <l n="5">ረድኤተ፡ ፈኑ፡ ወአኅድር፡ በእሉ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ እምውሳጤ፡ ክዳን፡ መሬት፨</l>
                  <l n="2">አመ፡ ዐሡሩ፡ ወሰኑዩ፡ ለወርኀ፡ የካቲት፨</l>
                  <l n="3">ቴዎድሮስ፡ ባኦስ፡ መፍቀሬ፡ ማርያም፡ ሩት፨</l>
                  <l n="4">ለደብርከ፡ ደብረ፡ ሰላም፡ ይሔውፅዋ፡ መላእክት፨</l>
                  <l n="5">ወይኬልልዋ፡ ብርሃናት፡ ዐበይት፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ይባቤ፡ ሚካኤል፡ ተለዐለ፡ በፍልሰትከ፡ ከብካብ፨</l>
                  <l n="2">ወሰማየ፡ ዜማ፡ አጽነነ፡ ድምፀ፡ ገብርኤል፡ ዕጹብ፨</l>
                  <l n="3">ምእላደ፡ ጥበብ፡ ቴዎድሮስ፡ ከመ፡ ሰሎሞን፡ መክበብ፨</l>
                  <l n="4">ጥበበ፡ ዐቅመ፡ ተመልኡ፡ ባስልኤል፡ ወኤልያብ፨</l>
                  <l n="5">ይምላእ፡ ላዕሌየ፡ ዘዚአከ፡ ጥበብ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ዐቅመ፡ ወሀብኩከ፡ ሰላመ፡ ከመ፡ ሰላማዊ፡ መልአክ፨</l>
                  <l n="2">በበ፡ አሐዱ፡ አሐዱ፡ ለመልክእከ፡ ቡሩክ፨</l>
                  <l n="3">ፍትወ፡ መዐዛ፡ ለኵሉ፡ ቴዎድሮስ፡ ሰሊክ፨</l>
                  <l n="4">ተወከፍ፡ ዘንተ፡ አምኃየ፡ እግዚአብሔር፡ አምላክ፨</l>
                  <l n="5">ከመ፡ እምቅዱሳን፡ ትትዌከፍ፡ መሥዋዕተ፡ ዘሠርክ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
