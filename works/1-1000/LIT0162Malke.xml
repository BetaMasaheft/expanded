      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0162</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0162Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ኦክርስቶስ፡ ዘኢታዐርብ፡ ፀሓይ፨</l>
                  <l n="2">በእንተ፡ ማርያም፡ እምከ፡ ዳግሚት፡ ሰማይ፨</l>
                  <l n="3">ድርሳነ፡ መልክኡ፡ እትናገር፡ ለፍሬ፡ ካህን፡ ኅሩይ፨</l>
                  <l n="4">አስተየኒ፡ ወይነ፡ ልቡና፡ በጽዋዐ፡ ሙሴ፡ ራእይ፨</l>
                  <l n="5">በከመ፡ አስተዮ፡ ዑራኤል፡ ለዕዝራ፡ ነቢይ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ በዓለ፡ ቀዋሚ፡ ኪዳን፨</l>
                  <l n="2">ወለሥዕርትከ፡ ሥርው፡ በጸጕረ፡ ብናሴ፡ ብርሃን፨</l>
                  <l n="3">ፍሬ፡ ካህን፡ አቡየ፡ መትልወ፡ ቶማስ፡ ካህን፨</l>
                  <l n="4">ኀቤየ፡ ትምጻእ፡ ለሐውጾ፡ ምስለ፡ ፊቅጦር፡ ምእመን፨</l>
                  <l n="5">ኢያዕቅፍከ፡ ውስተ፡ ፍና፡ ጌጋይየ፡ ዕብን፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ በልብስ፡ ሐዲስ፨</l>
                  <l n="2">ወለመቃብሪከ፡ ዓዲ፡ ደብረ፡ ማርያም፡ መቅደስ፨</l>
                  <l n="3">ፍሬ፡ ካህን፡ አቡየ፡ ንጹሐ፡ ሥጋ፡ ወመንፈስ፨</l>
                  <l n="4">ለኤልሳዕ፡ ከመ፡ ወሀቦ፡ ሐሜሌተ፡ ርእሱ፡ ኤልያስ፨</l>
                  <l n="5">ሐሜሌተከ፡ ሀበኒ፡ ለብእሲ፡ ፅኑስ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">መጠነ፡ አቅረብኩ፡ ዮም፡ ሰላመ፡ ሥላሴ፡ ማሕሌትየ፨</l>
                  <l n="2">በእሳተ፡ ፍቅርከ፡ አባ፡ እስመ፡ ሣዕረ፡ ልብየ፡ ውዕየ፨</l>
                  <l n="3">ፍሬ፡ ካህን፡ ለከ፡ ትብለከ፡ ነፍስየ፨</l>
                  <l n="4">አንተ፡ ዕሥየኒ፡ ዕሤተ፡ ሠናየ፨</l>
                  <l n="5">ዘእዝን፡ ኢሰምዐ፡ ወዘዐይን፡ ኢርእየ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለበአትከ፡ ውስተ፡ ደብረ፡ ማርያም፡ ዘሐይዳ፨</l>
                  <l n="2">በዕለተ፡ ዘሠራዕከ፡ ማዕዳ፨</l>
                  <l n="3">ፍሬ፡ ካህን፡ አባ፡ ለጥበብ፡ አበ፡ ወልዳ፨</l>
                  <l n="4">ፍሬ፡ በረከት፡ ዘሐጠብከ፡ በውስተ፡ ዐውዳ፨</l>
                  <l n="5">ሴሰይኮሙ፡ ለአበው፡ በበዳ፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለበአትከ፡ እምኢየሩሳሌም፡ ለአምጽኦ፡ መጻሕፍት፡ ወንዋየ፡ ቅዱሳት፨</l>
                  <l n="2">ምስለ፡ ወልደ፡ መኰንን፡ ዘአወፈየከ፡ ርስተ፡ ጕልት፨</l>
                  <l n="3">ፍሬ፡ ካህን፡ አባ፡ መክብበ፡ መነኮሳት፨</l>
                  <l n="4">አባ፡ አባ፡ አምሳሊሆሙ፡ ለመላእክት፨</l>
                  <l n="5">ዕቀበነ፡ በኵሉ፡ ጊዜ፡ ወበኵሉ፡ ሰዓት፨</l>
               </lg>
            </div>
         </div>
      </body>
      
