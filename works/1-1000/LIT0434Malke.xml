         <div type="edition" xml:lang="gez" xml:id="div2LIT0434Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘትርጓሜሁ፡ ጠቢብ፨</l>
                  <l n="2">ዐቃቤ፡ ሥራይ፡ ሉቃስ፡ መድኅነ፡ አሕዛብ፡ ወሕዝብ፨</l>
                  <l n="3">ሕሙማነ፡ ነፍስ፡ ትፌውስ፡ በሥራይከ፡ ዕጹብ፨</l>
                  <l n="4">ወዝሥራይ፡ ሃይማኖቱ፡ ውስተ፡ አንቀጸ፡ አፍ፡ ቅሩብ፨</l>
                  <l n="5">ከመ፡ እምብእሲት፡ ተወልደ፡ ከመ፡ ንህብ፡ እምንህብ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ ምሳሌ፡ ፀአትከ፡ አፍኣ፨</l>
                  <l n="2">እምነ፡ መቃብር፡ ሕያወ፡ ከመ፡ ለሙታን፡ ተሠርዐ፨</l>
                  <l n="3">በተስፋ፡ ትንሣኤ፡ ሉቃስ፡ ተቀሠፍከ፡ በበአርብዓ፨</l>
                  <l n="4">ወየኀዩ፡ እንበይነ፡ ዝንቱ፡ በከመ፡ ነጸረ፡ ዘርዐ፨</l>
                  <l n="5">መንገለ፡ ከዊን፡ መሬታዊ፡ ሥጋከ፡ ዘገብአ፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ኀበ፡ ተርኅወ፡ ገነት፡ በከመ፡ አተውከ፡ እአቱ፨</l>
                  <l n="2">ነባቤ፡ ሰላመከ፡ ሉቃስ፡ ምክዕቢተ፡ ዐሥር፡ ምስለ፡ ሰመንቱ፨</l>
                  <l n="3">እስመ፡ እንዘ፡ ይብል፡ አዘዘ፡ አምላክ፡ ውስተ፡ ኦሪቱ፨</l>
                  <l n="4">ኢይትርፍ፡ ድኅረ፡ ጻመወ፡ ለዘጻመወ፡ ዕሤቱ፨</l>
                  <l n="5">ወለዘተዐሰበ፡ ዐስበ፡ ኢይቢት፡ በቤቱ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ሠናየ፡ ተግባር፡ ሉቃስ፡ ማእከለ፡ ገዳም፡ ይቡስ፨</l>
                  <l n="2">ተከልከ፡ አንተ፡ ምግባራተ፡ ነፍስ፨</l>
                  <l n="3">ወአልሐቀከ፡ መንፈስ፡ ቅዱስ፨</l>
               </lg>
               <lg type="stanza" n="5">
                  <l n="1">ሰላም፡ ለክሙ፡ ይባርከነ፡ ክርስቶስ፡ ወሉቃስ፡ ውስተ፡ ቤትነ፡ እትዉ፨</l>
                  <l n="2">በዘሞተ፡ ቃል፡ ከመ፡ ታሕይዉ፨</l>
                  <l n="3">ወጌጋያቲነ፡ እንዘ፡ ትትዐደዉ፨</l>
                  <l n="4">ማእከሌነ፡ መምህራን፡ ኀልው፨</l>
               </lg>
            </div>
         </div>
      </body>
