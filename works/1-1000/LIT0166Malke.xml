      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0166</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0166Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">እጼውዐከ፡ በተአምኖ፡ ወእስእለከ፡ በተማሕፅኖ፨</l>
                  <l n="2">ክሳደ፡ ልብየ፡ በአጽንኖ፨</l>
                  <l n="3">ማርቆስ፡ አቡየ፡ ለእግዚአብሔር፡ አምላክ፡ አድኅኖ፨</l>
                  <l n="4">በሎ፡ በእንቲአየ፡ በምሕረትከ፡ ክድኖ፨</l>
                  <l n="5">ወሣህልከ፡ ወልታ፡ ጽድቅ፡ ይኩኖ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ ወለልደትከ፡ ቡሩክ፨</l>
                  <l n="2">በብስራተ፡ ቅዱስ፡ መልአክ፨</l>
                  <l n="3">ሰባኬ፡ ወንጌል፡ ማርቆስ፡ ሐዋርያ፡ ክርስቶስ፡ አምላክ፨</l>
                  <l n="4">እንዘ፡ ቃለ፡ ወንጌል፡ ትዜኑ፡ እምጊዜ፡ ጽባሕ፡ ወሰርክ፨</l>
                  <l n="5">ላዕለ፡ ጣዖታት፡ ዘግብጽ፡ ተፈነወ፡ ሀውክ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተጸውዐ፡ ቀዲሙ፨</l>
                  <l n="2">ለወልደ፡ መካን፡ በስሙ፨</l>
                  <l n="3">ማርቆስ፡ ሥዩም፡ ለእግዚአብሔር፡ ካህነ፡ አርያሙ፨</l>
                  <l n="4">ኵሎሙ፡ አባላትየ፡ አመ፡ በጌጋይ፡ ሐሙ፨</l>
                  <l n="5">ለአድኅኖ፡ ዚአየ፡ ዘልፈ፡ በጸሎት፡ ጻሙ፨</l>
               </lg>
               <lg type="stanza" n="50">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ዘሀሎ፡ ውስቴቱ፨</l>
                  <l n="2">ሥጋ፡ ዚአከ፡ ንጹሕ፡ እንተ፡ ኀጢአት፡ አልቦቱ፨</l>
                  <l n="3">ገባሬ፡ ተኣምር፡ ማርቆስ፡ ፈዋሴ፡ ድዉያን፡ በንፍሐቱ፨</l>
                  <l n="4">ከመ፡ ይእትት፡ እምቅድሜየ፡ ለአርዌ፡ ዐመፃ፡ መሥገርቱ፨</l>
                  <l n="5">ብርሃነከ፡ ፀሓየ፡ ግብጽ፡ በገጽየ፡ አኅቱ፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">ተወኪፈከ፡ ዘንተ፡ አምኃየ፡ ዘአቅረብኩ፡ በአስተሐምሞ፨</l>
                  <l n="2">ለመልክእከ፡ ሰላሞ፨</l>
                  <l n="3">ማርቆስ፡ ባሕርይ፡ ማርቆስ፡ አበሞ፨</l>
                  <l n="4">ኣአኵቶ፡ ለአምላክከ፡ ወአሌዕል፡ ስሞ፨</l>
                  <l n="5">እስመ፡ በኂሩቱ፡ ብዙኅ፡ ክህልኩ፡ ፈጽሞ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
