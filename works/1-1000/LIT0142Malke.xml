         <div type="edition" xml:lang="gez" xml:id="div2LIT0142Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ አብ፡ ንትነሣእ፡ ወልዶ፡ ዘፈነወ፡ ለነ፨</l>
                  <l n="2">ወበስመ፡ እግዚአብሔር፡ ወልድ፡ ንዌጥን፡ ዘተሰብአ፡ በእንቲአነ፨</l>
                  <l n="3">ወበስመ፡ እግዚአብሔር፡ መንፈስ፡ ቅዱስ፡ ንጽሕፍ፡ ከመ፡ ይፈጽም፡ ጻሕቀነ፨</l>
                  <l n="4">ስብሐት፡ በሰማያት፡ ለዘፈጠረ፡ ጻድቃን፨</l>
                  <l n="5">ወሰላም፡ በምድር፡ ለዘፈተወነ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ ዘአደንገጾ፡ ለማሪ፨</l>
                  <l n="2">ወለልደትከ፡ ሰላም፡ በይነ፡ ዘአፍቀሮ፡ ፈጣሪ፨</l>
                  <l n="3">ተክለ፡ ሐዋርያት፡ ብፁዕ፡ ለምሕሮ፡ አሚን፡ ሐዋሪ፨</l>
                  <l n="4">አስተብቍዕ፡ ኀበ፡ አምላክከ፡ ከመ፡ ኀጢአተነ፡ ያስተስሪ፨</l>
                  <l n="5">ወዘእንበሌሁሰ፡ ዘአልቦ፡ መሓሪ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ከመ፡ ጥዑመ፡ ስም፡ መዐር፨</l>
                  <l n="2">ከመ፡ ሐሊብ፡ ዘእጐልት፡ ወከመ፡ ጽጌ፡ ሥሙር፨</l>
                  <l n="3">ተክለ፡ ሐዋርያት፡ ኀያል፡ ልዑከ፡ አምላክ፡ ክቡር፨</l>
                  <l n="4">ሱቀነ፡ ለደቂቅከ፡ እምቅንየተ፡ አርዌ፡ ነኪር፨</l>
                  <l n="5">ከመ፡ ኢይቅኒ፡ ኪያነ፡ በሕምዙ፡ መሪር፨</l>
               </lg>
               <lg type="stanza" n="19">
                  <l n="1">ሰላም፡ ለክሳድከ፡ ልህኵተ፡ አምላክ፡ ፌማ፨</l>
                  <l n="2">ለዘአነቀ፡ ክብረ፡ ዘመላእክት፡ አስኬማ፨</l>
                  <l n="3">ወውእቱኒ፡ ተወክፈ፡ እምእደ፡ አባ፡ ዮሐንስ፡ ከማ፨</l>
                  <l n="4">ተክለ፡ ሐዋርያት፡ ጸጋከ፡ እንተ፡ ምሉእ፡ ግርማ፨</l>
                  <l n="5">ሰውረኒ፡ ዘልፈ፡ እምእኩይ፡ መስቴማ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ሰላም፡ ለልብከ፡ መዝገበ፡ ርኅራኄ፡ ወልቡና፨</l>
                  <l n="2">ወመዝገበ፡ ሣህል፡ ወዳኅና፨</l>
                  <l n="3">ተክለ፡ ሐዋርያት፡ ኀያል፡ ዘንብረትከ፡ ጽሙና፨</l>
                  <l n="4">ጸሎትከ፡ ለፀርነ፡ ነበልባለ፡ እሳት፡ ከዊና፨</l>
                  <l n="5">እምውስተ፡ ገሀነም፡ ትደዮ፡ ወበሲኦል፡ ፍና፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">ሰላም፡ እብል፡ ለበድነ፡ ሥጋከ፡ ዐዋዲ፨</l>
                  <l n="2">እንዘ፡ በሕይወቱ፡ ባረከ፡ ወእምድኅረ፡ አዕረፈ፡ ዓዲ፨</l>
                  <l n="3">ወአንበርዎ፡ በክብር፡ ኅሩያን፡ ውስተ፡ ድኂን፡ ወጋዲ፨</l>
                  <l n="4">ወይብራህ፡ በላዕሌነ፡ ብርሃነ፡ ጸጋከ፡ ነዳዲ፨</l>
                  <l n="5">ተክለ፡ ሐዋርያት፡ በርህ፡ ጽልመተ፡ ሰዳዲ፨</l>
               </lg>
               <lg type="stanza" n="52">
                  <l n="1">አምኃ፡ ሰላም፡ ኣቄርብ፡ ለመልክእከ፡ ኵሉ፨</l>
                  <l n="2">እምዘተጋድሎትከ፡ አኮ፡ ወእምብዝኀ፡ ገድልከ፡ ቃሉ፨</l>
                  <l n="3">በአምጣነ፡ ንስቲት፡ ባሕቱ፡ ወበሕጹጽ፡ ፊደሉ፨</l>
                  <l n="4">ተክለ፡ ሐዋርያት፡ መሐረኒ፡ በእንተ፡ ልብየ፡ ኵሉ፨</l>
                  <l n="5">እስመ፡ ኅሊናየ፡ ወልብየ፡ ኪያከ፡ ተወከሉ፨</l>
               </lg>
               <lg type="stanza" n="53">
                  <l n="1">አምኃ፡ ሰላም፡ ካዕበ፡ ለመልክእከ፡ ጽዱል፨</l>
                  <l n="2">አምጣነ፡ ናቄርብ፡ ሎቱ፡ በእደ፡ ልሳን፡ እንዘ፡ ንብል፨</l>
                  <l n="3">ተክለ፡ ሐዋርያት፡ ኅሩይ፡ ወሰባኬ፡ ወንጌል፨</l>
                  <l n="4">ወአንሶስዎትከ፡ ተባረኩ፡ አድባረ፡ ግብርማ፡ ወጎል፨</l>
                  <l n="5">ወብከ፡ ረከቡ፡ ፍሥሓ፡ ዘሣህል፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ተክለ፡ ሐዋርያት፡ ብእሲ፡ ሰማያዊ፨</l>
                  <l n="2">ወመልአክ፡ ምድራዊ፡ መልአክ፡ ሰማያዊ፨</l>
                  <l n="3">ወብእሲ፡ ምድራዊ፡ ማእምር፡ ወለባዊ፨</l>
                  <l n="4">ነፍሳተ፡ ኃጥኣን፡ ፄዋዊ፡ ፄውወነ፡ አባ፡ እምተኵላ፡ ፀራዊ፨</l>
               </lg>
               <lg type="stanza" n="12">
                  <l n="1">ሰላም፡ ለከ፡ ተክለ፡ ሐዋርያት፡ ክሡት፨</l>
                  <l n="2">በኀበ፡ መላእክት፡ ወዕዉቅ፡ በኀበ፡ ሰብእ፡ ወነገሥታት፨</l>
                  <l n="3">እንተ፡ ኀረየከ፡ ንጉሠ፡ ስብሐት፨</l>
                  <l n="4">ከመ፡ ትኩነነ፡ መራሔ፡ ፍኖት፡ አብአነ፡ ውስተ፡ ገነት፨</l>
               </lg>
            </div>
         </div>
      </body>
      
