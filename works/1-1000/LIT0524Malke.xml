      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0524</citedRange></bibl>
            </listBibl>
            
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0524Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሶበ፡ አብሳዲ፡ ፈለሰ፡ መንገለ፡ ሰማያት፡ ቤቱ፨</l>
                  <l n="2">ዘሡራሬሃ፡ አዳም፡ ወመንክር፡ ሥነ፡ ርእየቱ፨</l>
                  <l n="3">ነገደ፡ መላእክት፡ አእላፍ፡ ወረዱ፡ ለክብረ፡ ሞቱ፨</l>
                  <l n="4">እንዘ፡ ይዜምሩ፡ መኃልየ፡ ብስራት፡ ዝንቱ፨</l>
                  <l n="5">ሥርጉት፡ መርዓት፡ ኪያከ፡ ትፈቱ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">መኑ፡ ከማከ፡ መንክራቲሁ፡ ዘአርአየ፨በተፊአ፡ ምራቅ፡ ንስቲት፡ እንዘ፡ ያውሕዝ፡ ማየ፨</l>
                  <l n="2">አብሳዲ፡ ብዕል፡ ዘኢትሜንን፡ ነዳየ፨</l>
                  <l n="3">ተወኪፈከ፡ አምኃየ፡ እንበለ፡ ታእትት፡ ጻማየ፨</l>
                  <l n="4">በደመና፡ ኂሩት፡ ወፍቅር፡ የዐርግ፡ ሰማየ፨</l>
                  <l n="5"/>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተወደስ፡ ወተበፅዐ፨</l>
                  <l n="2">እምአስማተ፡ ጻድቃን፡ ዘኤሉ፡ ጸሎተ፡ ቅዱሳን፡ ምሥዋዐ፨</l>
                  <l n="3">አብሳዲ፡ ትጉህ፡ መሥዋዕተ፡ አምልኮ፡ በግዐ፨</l>
                  <l n="4">ምሕረትከ፡ ትሩጽ፡ እግዚኦ፡ ከመ፡ ኢንቁም፡ በአፍአ፨</l>
                  <l n="5">ኀበ፡ አምላክከ፡ ዘያፈቅር፡ ሰብአ፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ወለመቃብሪከ፡ ዝንቱ፨</l>
                  <l n="2">ዘያጸድቅ፡ ነፍሰ፡ እንበለ፡ ምግባር፡ በከንቱ፨</l>
                  <l n="3">አብሳዲ፡ ጻድቅ፡ ለፈለገ፡ አሚን፡ ደሴቱ፨</l>
                  <l n="4">ተተክሉ፡ ጊዜ፡ ሞትከ፡ ደባትረ፡ ብርሃን፡ ሰብዓቱ፨</l>
                  <l n="5">እስመ፡ ለጻድቅ፡ ክቡር፡ ሞቱ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ተወከፍ፡ አምኃየ፡ ህየንተ፡ ጽሪቅ፡ አሐዱ፨</l>
                  <l n="2">ኀበ፡ አንበረኒ፡ እንብብ፡ መንፈሰ፡ ወላዲ፡ ወወልዱ፨</l>
                  <l n="3">አብሳዲ፡ ጻድቅ፡ ለኤዎስጣቴዎስ፡ ምክሐ፡ ነገዱ፨</l>
                  <l n="4">እንበለ፡ ዝንቱ፡ አምኃየ፡ ወንዋያትየ፡ ውሕዱ፨</l>
                  <l n="5">ወለንዴትየ፡ ኆፃ፡ ኢይትዌሰን፡ ፍቅዱ፨</l>
               </lg>
            </div>
         </div>
      </body>
