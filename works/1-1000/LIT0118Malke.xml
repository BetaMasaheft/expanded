         <div type="edition" xml:lang="gez" xml:id="div2LIT0118Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ኦክርስቶስ፡ ባሕርየ፡ ባሕርዩ፡ ለአብ፨</l>
                  <l n="2">ዘይቄድስዎ፡ ዘልፈ፡ ቀዳስያኒሁ፡ አርጋብ፨</l>
                  <l n="3">መንፈሰ፡ አእምሮ፡ ምልአኒ፡ እመዝገብከ፡ ጥበብ፨</l>
                  <l n="4">ከመ፡ እንግር፡ ለኵሉ፡ መዝሙረ፡ ዮሐኒ፡ መክብብ፨</l>
                  <l n="5">ዘዐርገ፡ ሰማያተ፡ ኀበ፡ ቦ፡ ከብካብ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እምዝክረ፡ ቅዱሳን፡ ውዱስ፨</l>
                  <l n="2">ወለሥዕርትከ፡ ጥሉል፡ በቅብአ፡ ቅዳሴ፡ ርሑስ፨</l>
                  <l n="3">ዐምደ፡ ንጽሕና፡ ዮሐኒ፡ እምቤተ፡ መንፍሥት፡ ወንግሥ፨</l>
                  <l n="4">ዜናከ፡ እንግር፡ ለኵሉ፡ በልሳነ፡ መንፈስ፡ ቅዱስ፨</l>
                  <l n="5">ያንሥአኒ፡ እምውጺቅ፡ እዴከ፡ ክርስቶስ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ሰላም፡ ለመልክእከ፡ ሱራኄ፡ መብረቅ፡ ግሩም፨</l>
                  <l n="2">ዘየዐውዶ፡ ፍጹመ፡ እመልክአ፡ አዳም፡ ፍጹም፨</l>
                  <l n="3">ዮሐኒ፡ ክቡር፡ በብሔርከ፡ ሰላም፨</l>
                  <l n="4">ሐውጸነ፡ በበዓልከ፡ ለእለ፡ ተጋባእነ፡ ዮም፨</l>
                  <l n="5">ውስተ፡ ጽርሐ፡ ልዑል፡ ጽርሕከ፡ ሐፃኒት፡ እም፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ሰላም፡ ለዕርገትከ፡ እምብሔረ፡ ድካም፡ ወጻማ፨</l>
                  <l n="2">መንገለ፡ ተሠርዐ፡ ፍጹመ፡ ማዕደ፡ ዕረፍት፡ ዘራማ፨</l>
                  <l n="3">ዮሐኒ፡ ክቡር፡ ለመጽሐፈ፡ ግዕዛን፡ ግርማ፨</l>
                  <l n="4">ክብርከ፡ ማኅቶተ፡ ሌዊ፡ ትሬስዮ፡ ተቅዋማ፨</l>
                  <l n="5">ወበዐምደ፡ ወርቅ፡ ጸሐፍ፡ ለስምየ፡ ስማ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ሰላም፡ ለሑረትከ፡ በፍኖተ፡ ነቢይ፡ ዕዝራ፨</l>
                  <l n="2">እንዘ፡ ይመርሑከ፡ ደርገ፡ ሰማያውያን፡ ሐራ፨</l>
                  <l n="3">ዮሐኒ፡ ኤልያስ፡ ክሉለ፡ ሞገስ፡ ወጌራ፨</l>
                  <l n="4">መኒነከ፡ ተድላሃ፡ ወአስተሐቂረከ፡ ክብራ፨</l>
                  <l n="5">ለዛቲ፡ ዓለም፡ ዘምልዕልት፡ መከራ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ሰላም፡ ለህላዌከ፡ እምህላዌ፡ ነገሥት፡ ዘይሤኒ፨</l>
                  <l n="2">ወለትርሲትከ፡ ዕንቍ፡ ዘሥነ፡ ጸዳሉ፡ አዶኒ፨</l>
                  <l n="3">ረድአ፡ ምሥጢሩ፡ ዮሐኒ፡ ለመምህረ፡ ምስር፡ አሞኒ፨</l>
                  <l n="4">አባ፡ ገድልከ፡ ወሬዛ፡ እምገድለ፡ ቅዱሳን፡ ሞአኒ፨</l>
                  <l n="5">ወለተናግሮ፡ በአፍ፡ ዜናከ፡ ኖኀኒ፨</l>
               </lg>
               <lg type="stanza" n="33">
                  <l n="1">ስብሐት፡ ለከ፡ አምላኪየ፡ ዘወሀብከኒ፡ ሥልጣነ፨</l>
                  <l n="2">ወድርሳነ፡ ዮሐኒ፡ ግብረከ፡ ከመ፡ እፈጸም፡ ፍጡነ፨</l>
                  <l n="3">እግዚኦ፡ ተወከፍ፡ ዘልቡናየ፡ ብጽዐነ፨</l>
                  <l n="4">ወኢይበል፡ በልብከ፡ ኢይትዌከፍ፡ አነ፨</l>
                  <l n="5">አኰቴተ፡ ብእሲ፡ ኃጥእ፡ ግዱፈ፡ ኮነ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
