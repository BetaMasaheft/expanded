         <div type="edition" xml:lang="gez" xml:id="div2LIT0425Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተጸውዐ፡ ቀዳሚ፨</l>
                  <l n="2">እምቅድመ፡ ትጸውዕ፡ ምድር፡ ወሰማይ፡ ቀዋሚ፨</l>
                  <l n="3">ሳቁኤል፡ መልአክ፡ ትጉህ፡ ኢነዋሚ፨</l>
                  <l n="4">ጊዜ፡ በጽሐኒ፡ ኀዘን፡ ወደዌ፡ መሕመሚ፨</l>
                  <l n="5">ለመድኃኒትየ፡ ስመከ፡ እስሚ፨</l>
               </lg>
               <lg type="stanza" n="45">
                  <l n="1">ሰላም፡ ሰላም፡ ለማኅበረ፡ መልክእከ፡ እብል፨</l>
                  <l n="2">እንዘ፡ ለኪፎቶን፡ ኢይክል፨</l>
                  <l n="3">ሳቁኤል፡ መልአክ፡ ዖፈ፡ ነበልባል፨</l>
                  <l n="4">እምነ፡ መዝገቡ፡ ከመ፡ ይምጽአኒ፡ ሣህል፨</l>
                  <l n="5">ቅጽብ፡ በእድ፡ ወጸውዕ፡ በቃል፨</l>
               </lg>
               <lg type="stanza" n="46">
                  <l n="1">ዐስቡ፡ ለዐሳብ፡ በአምጣነ፡ ይተግህ፡ ወይጻሙ፨</l>
                  <l n="2">ዐስበ፡ ማሕሌትየ፡ እንበለ፡ መጠኑ፡ ወዐቅሙ፨</l>
                  <l n="3">ኦሳቁኤል፡ ለማየ፡ ርኅራኄ፡ ምሥያመ፨</l>
                  <l n="4">ፍቁረ፡ እኩን፡ በኀቤከ፡ ለለ፡ ዕለቱ፡ ወዓሙ፨</l>
                  <l n="5">ከመ፡ ወልድ፡ ብሕትው፡ ወዋሕድ፡ ለእሙ፨</l>
               </lg>
            </div>
         </div>
