      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0179</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0179Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በአብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ጽሚተ፨</l>
                  <l n="2">አመኒ፡ ወጠንኩ፡ ጽሒፈ፡ መልክእ፡ ክሡተ፨</l>
                  <l n="3">ማቴዎስ፡ አብ፡ ዘተወከፍከ፡ ኪዳናተ፨</l>
                  <l n="4">መጺአከ፡ በተራውጾ፡ ዘዚአየ፡ ቤተ፨</l>
                  <l n="5">አርእየኒ፡ ዘልፈ፡ ዘምሥጢር፡ ፍኖተ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘእግዚአብሔር፡ አልዐላ፨</l>
                  <l n="2">እምዝክረ፡ አረሚ፡ ዐብዳን፡ ወእምስመ፡ አንስት፡ ኵላ፨</l>
                  <l n="3">ወልደ፡ ቴዎድሮስ፡ ማቴዎስ፡ ዘተቀጸልከ፡ ቀጸላ፨</l>
                  <l n="4">ማስያስ፡ ጸዋዔ፡ ቃልከ፡ በዘመሐለ፡ መሐላ፨</l>
                  <l n="5">ዕቀበነ፡ ወትረ፡ እምዓለም፡ ደሊላ፨</l>
               </lg>
               <lg type="stanza" n="43">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ዘቤተ፡ መቅደስ፡ ንብረታ፨</l>
                  <l n="2">እለ፡ ሮማኖስ፡ ደቅ፡ ከመ፡ ጠየቁ፡ ሐተታ፨</l>
                  <l n="3">ማቴዎስ፡ ፋኑኤል፡ ተስፋ፡ አዋልድ፡ ዘተከብታ፨</l>
                  <l n="4">ኪያከ፡ አመ፡ ወደስነ፡ በውዳሴ፡ አምላክ፡ ኒቆታ፨</l>
                  <l n="5">ለነፍስነ፡ ዘልፈ፡ እምእከይ፡ ንስታ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
