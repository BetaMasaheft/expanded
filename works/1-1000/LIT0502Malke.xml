         <div type="edition" xml:lang="gez" xml:id="div2LIT0502Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ ሥሉስ፡ ቅዱስ፡ ወበስመ፡ አምላክ፡ ዋሕድ፨</l>
                  <l n="2">ድርሳነ፡ መልክእከ፡ ዮም፡ ትጸግወኒ፡ ለአብድ፨</l>
                  <l n="3">አማሕፀንኩከ፡ ይምአታ፡ ፈጻሜ፡ ኵሉ፡ ፈቃድ፨</l>
                  <l n="4">ዳዊትኒ፡ በከመ፡ ይቤ፡ ኢትኅድገኒ፡ ለባዕድ፨</l>
                  <l n="5">እስከ፡ እነግር፡ መዝራዕተከ፡ ለዘይመጽእ፡ ትውልድ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ሶበ፡ ተዘከሮ፡ ልብነ፨</l>
                  <l n="2">ዘያስተባዝኅ፡ ተድላ፡ ወዘያረስእ፡ ኀዘነ፨</l>
                  <l n="3">ፍጻሜ፡ ስብሐቲከ፡ አባ፡ አርእየኒ፡ ፍጡነ፨</l>
                  <l n="4">እትወለድ፡ ብከ፡ በይነዝ፡ አመ፡ ልደተ፡ ነፍስ፡ ኮነ፨</l>
                  <l n="5">ፅንሰ፡ ማሕፀና፡ ለሲኦል፡ እስመ፡ ኮንኩ፡ አነ፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ውስተ፡ ርእሰ፡ ደብር፡ ተያጥሮን፨</l>
                  <l n="2">ዘየዐውዶ፡ ጽዳሌ፡ ወይገለብቦ፡ ብርሃን፨</l>
                  <l n="3">ይምአታ፡ ምልክአም፡ ፍቁረ፡ መላእክት፡ ኄራን፨</l>
                  <l n="4">አድኅነኒ፡ በጸሎትከ፡ እምዘ፡ ይመጽእ፡ ኀዘን፨</l>
                  <l n="5">ወባልሐኒ፡ እምግሩም፡ ደይን፨</l>
               </lg>
               <lg type="stanza" n="52">
                  <l n="1">ይምአታ፡ ተወኪፈከ፡ ዘአወፈይኩከ፡ ዘንተ፨</l>
                  <l n="2">አምኃ፡ ልሳንየ፡ ሐምሳ፡ ወተላዊሁ፡ ክልኤተ፨</l>
                  <l n="3">በጊዜ፡ አንበቦ፡ ካህን፡ እንዘ፡ ትሬስዮ፡ ቅጽበተ፨</l>
                  <l n="4">ዘይፌውስ፡ ለዘደወየ፡ ወዘያነሥእ፡ ምዉተ፨</l>
                  <l n="5">ለኅጡአ፡ ዕሤት፡ ወልድከ፡ ሀበኒ፡ ዕሤተ፨</l>
               </lg>
               <lg type="stanza" n="53">
                  <l n="1">አመ፡ ምጽአትከ፡ ወልደ፡ አምላክ፡ ድኅረ፡ ኀለፈ፡ ለዓለም፡ ኅልፈታ፨</l>
                  <l n="2">ወአመ፡ አባግዕ፡ መልኡ፡ ለቤትከ፡ በውሳጢታ፨</l>
                  <l n="3">ድንግለ፡ ዘለፋ፡ ጽኑዕ፡ ወመርዐተ፡ ዕጹብ፡ ሐተታ፨</l>
                  <l n="4">ነፍስየ፡ ውስተ፡ እሳት፡ ከመ፡ ኢትንበር፡ ባሕቲታ፨</l>
                  <l n="5">ሀለወኒ፡ ዘእተአመኖ፡ ወልድከ፡ ይምአታ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ይምአታ፡ ጻድቅ፨</l>
                  <l n="2">ጽዑነ፡ ደብር፡ ምጡቅ፨</l>
                  <l n="3">እመ፡ ይጸሐፍ፡ በቀለመ፡ ወርቅ፨</l>
                  <l n="4">ተኣምሪከ፡ ኢየኀልቅ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለከ፡ በጸሎትከ፡ ኲናት፡ ወበሰይፍከ፡ መስቀል፨</l>
                  <l n="2">ሠዐርከ፡ አንተ፡ ወራዙተ፡ ዘቀትል፨</l>
                  <l n="3">ይምአታ፡ ወሬዛ፡ ገድል፨</l>
               </lg>
               <lg type="stanza" n="6">
                  <l n="1">ሰላም፡ ለከ፡ በጊዜ፡ ዕረፍትከ፡ አባ፡ መላእክተ፡ ሰማይ፡ ወረዱ፨</l>
                  <l n="2">በማዕጠንተ፡ ወርቅ፡ ሥጋከ፡ እንዘ፡ የዐውዱ፨</l>
                  <l n="3">ዕበየከ፡ ከመ፡ ያክሕዱ፨</l>
               </lg>
               <lg type="stanza" n="7">
                  <l n="1">ሰላም፡ ለከ፡ ንግደትየ፡ በጽሐ፡ አኮኑ፡ ወተፈጸመ፡ ምግብየ፨</l>
                  <l n="2">እንበለ፡ አስተዳሉ፡ አነ፡ ስንቀ፡ ፍኖትየ፨</l>
                  <l n="3">እንበሌከ፡ አባ፡ አስተብቍዖትየ፨</l>
                  <l n="4">እምብዕለ፡ ቤትከ፡ ክፍለኒ፡ ዐስብየ፨</l>
               </lg>
            </div>
         </div>
      </body>
