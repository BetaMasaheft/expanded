      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0126</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0126Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ሰላም፡ ለዝክረ፡ ስምከ፡ መአድምተ፨</l>
                  <l n="2">ከመ፡ አስተጋብእ፡ ማሕሌተ፨</l>
                  <l n="3">አርአያ፡ ታስተጋብእ፡ ብእሲት፡ እምነ፡ ተቅራም፡ ሕጠተ፨</l>
                  <l n="4">አቢብ፡ ቡላ፡ ዘኢያእመርከ፡ ርስሐተ፨</l>
                  <l n="5">በክነፈ፡ ኅሊና፡ በጺሐከ፡ ግብተ፨</l>
                  <l n="6">ዘያፌጽም፡ ማሕሌተከ፡ መክሥተ፨</l>
               </lg>
               <lg type="stanza" n="25">
                  <l n="1">ሰላም፡ ለዕርገትከ፡ ልዑለ፡ አርያመ፨</l>
                  <l n="2">እንዘ፡ ትትወፈይ፡ ቡላ፡ እምአፈ፡ መላእክት፡ ሰላመ፨</l>
                  <l n="3">ግበር፡ ሊተ፡ በፍጽምየ፡ ዘትእምርትከ፡ ማሕተመ፨</l>
                  <l n="4">ኢይረክብ፡ ዘይንዕወኒ፡ ወኢይመውአኒ፡ ፍጹመ፨</l>
                  <l n="5">እመ፡ ይተልወኒ፡ ረድኤትከ፡ ከዊኖ፡ ቃውመ፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">በከመ፡ ተወክፈ፡ እግዚእከ፡ ጸራይቀ፡ ክልኤቱ፨</l>
                  <l n="2">ዘእምተጽናሳ፡ ብእሲት፡ ለእመ፡ አብአት፡ ሎቱ፨</l>
                  <l n="3">አቢብ፡ ተወከፍ፡ አስትአ፡ ማሕሌትየ፡ ዝንቱ፨</l>
                  <l n="4">ለሰብለ፡ ሥርናይ፡ ከመ፡ ይበዝኅ፡ ሕጠቱ፨</l>
                  <l n="5">ይፈድፍድ፡ በኀቤከ፡ ወይብዛኅ፡ ዕሤቱ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ አቢብ፡ ንህብ፡ እምሰብአ፡ ትማልም፡ ወዮም፨</l>
                  <l n="2">እምገነተ፡ መስቀል፡ አልቦ፡ ጽጌ፡ ሕማም፨</l>
                  <l n="3">ከማከ፡ ዘይቀስም፨</l>
               </lg>
               <lg type="stanza" n="8">
                  <l n="1">ሰላም፡ ለከ፡ አቢብ፡ ቡላ፡ ኀበ፡ ኢየሱስ፡ መድኅን፨</l>
                  <l n="2">ለብእሲ፡ ኪያከ፡ ዘይትአመን፨</l>
                  <l n="3">ሰአል፡ ሎቱ፡ ቁመተ፡ የማን፨</l>
                  <l n="4">አመ፡ ጊዜ፡ ይትነፋሕ፡ ቀርን፨</l>
               </lg>
            </div>
         </div>
      </body>
      
