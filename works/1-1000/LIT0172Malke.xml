         <div type="edition" xml:lang="gez" xml:id="div2LIT0172Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ኀበ፡ ኀይለ፡ ቃል፡ ይምርሐኒ፡ ልሳንከ፡ ኮከበ፡ አእምሮ፡ ጽዱል፨</l>
                  <l n="2">ዘፍኖተ፡ ልደትከ፡ መርሖሙ፡ ለሰብአ፡ ሰገል፨</l>
                  <l n="3">ከመ፡ እንብብ፡ ሕቀ፡ እምዘዘከረ፡ ወንጌል፨</l>
                  <l n="4">ወእንግር፡ መንክራቲከ፡ ዘነገሮሙ፡ ኀይል፨</l>
                  <l n="5">አርትዕ፡ ሊተ፡ ፍኖተከ፡ ቃል፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ለየማናዊት፡ እድ፡ እንተ፡ ነበረት፡ ይብስተ፨</l>
                  <l n="2">በዕለተ፡ ሰንበት፡ ካዕበ፡ ከመ፡ ወሀብከ፡ ሕይወተ፨</l>
                  <l n="3">አመ፡ የማና፡ ጠወየ፡ ጥውየተ፨</l>
                  <l n="4">ነፍስየ፡ አሕዩ፡ እግዚኦ፡ ወኢታመክኒ፡ ሰንበተ፨</l>
                  <l n="5">እስመ፡ ኢመፍትው፡ በሰንበት፡ ያፅርዑ፡ ኂሩተ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ኦዘዐርገ፡ መልዕልተ፡ ፈለካት፡ ሳብዕ፨</l>
                  <l n="2">አኮ፡ እስከ፡ ክፍለ፡ ገነት፡ ድርዐ፡ ዘአዳም፡ ፍግዕ፨</l>
                  <l n="3">ክርስቶስ፡ በለኒ፡ አምሳለ፡ ዘታፈቅር፡ ረድእ፨</l>
                  <l n="4">ፈቀድኩ፡ ተሀሉ፡ በሥግ፡ እስከ፡ ዳግማይ፡ መጺእ፨</l>
                  <l n="5">ወእመ፡ አኮ፡ እስከ፡ ጊዜሁ፡ ለሠናይ፡ ርስዕ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">መጠነ፡ ነፍኒፍ፡ ዘልፈ፡ እምዐቢይ፡ ዝናም፨</l>
                  <l n="2">ወእምነ፡ ጢስ፡ ዘይወፅእ፡ እምውሳጤ፡ እቶን፡ ኅቱም፨</l>
                  <l n="3">መንግሥተከ፡ ክርስቶስ፡ ዜኖኩ፡ ዮም፨</l>
                  <l n="4">ለለ፡ አሐዱ፡ አሐዱ፡ ሶበ፡ ተጽሕፈ፡ እምኢያግመሮ፡ ዓለም፨</l>
                  <l n="5">እስመ፡ ኍላቌሁ፡ የዐዱ፡ እመስፈርት፡ ወዐቅም፨</l>
               </lg>
            </div>
         </div>
      </body>
