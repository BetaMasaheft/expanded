      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0535</citedRange></bibl>
            </listBibl>
            
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0535Malke">
            <div type="textpart" xml:id="masgabiya">
               <lg type="stanza" n="1">
                  <l n="1">ያሬድ፡ ማሕሌታይ፡ ለእግዚአብሔር፡ ካህኑ፨</l>
                  <l n="2">ስብሐተ፡ ትንሣኤ፡ ዘይዜኑ፨</l>
                  <l n="3">ኦሪት፡ ቶታኑ፡ ወወንጌል፡ አሣዕኑ፨</l>
                  <l n="4">ትርድአነ፡ ነዓ፡ በህየ፡ መካኑ፨</l>
                  <l n="5">ከመ፡ ጸበል፡ ግሁሳነ፡ ፀርነ፡ ይኩኑ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተጸውዖቱ፡ መዐር፨</l>
                  <l n="2">ወለሥዕርትከ፡ ጽዕድው፡ ከመ፡ ዘጌዴዎን፡ ፀምር፨</l>
                  <l n="3">ማሕሌታይ፡ ያሬድ፡ ወነባቤ፡ ሐዋዝ፡ መዝሙር፨</l>
                  <l n="4">እመ፡ ኮነ፡ ብርአ፡ ሊባኖስ፡ ወቀለመ፡ ባሕር፨</l>
                  <l n="5">እምኢኀልቀ፡ በተጽሕፎ፡ ዘዚአከ፡ ክብር፨</l>
               </lg>
               <lg type="stanza" n="25">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ዘኢተኬነዋ፡ መዋቲ፨</l>
                  <l n="2">ወለመቃብሪከ፡ ኅብእት፡ ዘኢረከባ፡ ሐታቲ፨</l>
                  <l n="3">መቃብረ፡ ሥጋከ፡ ያሬድ፡ መካነ፡ በረድ፡ ይእቲ፨</l>
                  <l n="4">እግዚአብሔር፡ ንጉሥ፡ ኰናኔ፡ ዓለማት፡ ክልኤቲ፨</l>
                  <l n="5">እስመ፡ ይቤለከ፡ ምዕራፍከ፡ ዛቲ፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">መዝሙረ፡ ማሕሌት፡ ሐዋዝ፡ ዘመዋዕለ፡ ክረምት፡ ወሐጋይ፨</l>
                  <l n="2">ዘመፀው፡ ወዘፀደይ፨</l>
                  <l n="3">ዘሠራዕከ፡ ያሬድ፡ ካህነ፡ ዝማሬ፡ ሠናይ፨</l>
                  <l n="4">ሰላምየ፡ ድሉ፡ እግዚኦ፡ መካልየ፡ ልዑል፡ ሰማይ፨</l>
                  <l n="5">አኮ፡ ዘወርቅ፡ ወብሩር፡ ጽሩይ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">መዝሙረ፡ አምላክ፡ ሕያው፡ ወዘወላዲቱ፡ ቡርክት፨</l>
                  <l n="2">ወዘትጉሃን፡ መላእክት፨</l>
                  <l n="3">ዘነቢያት፡ ወሐዋርያት፡ ዘጻድቃን፡ ወሰማዕት፨</l>
                  <l n="4">ዘደናግል፡ ወመነኮሳት፡ ዘካህናት፡ ወዲያቆናት፨</l>
                  <l n="5">ዘነበብከ፡ ወጸሐፍከ፡ ጸውዖተ፡ ስምከ፡ ይኩነኒ፡ ማሕየዌ፡ እሞት፨</l>
               </lg>
            </div>
         </div>
      </body>
