      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0168</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0168Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ለወልደ፡ ማርያም፡ ድንግል፡ እለ፡ ኮንዎ፡ ማኅበራነ፨</l>
                  <l n="2">ቃለ፡ ሃይማኖት፡ ይስብኩ፡ እንተ፡ ትመርሕ፡ የማነ፨</l>
                  <l n="3">ሠለስቱ፡ ምእት፡ ዐሠርቱ፡ ወሰመንቱ፡ አበዊነ፨</l>
                  <l n="4">በሰይፈ፡ ግዘት፡ መተሩ፡ ዕልዋነ፨</l>
                  <l n="5">በቀስታመ፡ መስቀል፡ አድከሙ፡ ፀሮሙ፡ ሰይጣነ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለሃይማኖትክሙ፡ መስተፍሥሔ፡ ዓዸም፡ እንግዳ፨</l>
                  <l n="2">እምነ፡ ጸቃውዕ፡ ጥዑም፡ ወእምነ፡ ሐሊብ፡ ጸዐዳ፨</l>
                  <l n="3">ሠለስቱ፡ ምእት፡ አናቅጸ፡ ዐምዳ፡ ወድዳ፨</l>
                  <l n="4">ለቤቴል፡ ዘያዕቆብ፡ ሃይማኖተ፡ ድንግል፡ ወወልዳ፨</l>
                  <l n="5">እንተ፡ በዕሪና፡ ተተክሉ፡ ሥላሴ፡ አዕማዳ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ ዘተወደሰ፡ ብዙኀ፨</l>
                  <l n="2">በዐውደ፡ ቈስጠንጢኖስ፡ በኵር፡ ዘፍትሐ፡ ሃይማኖት፡ ፈትሐ፨</l>
                  <l n="3">ሠለስቱ፡ ምእት፡ ዐሠርቱ፡ ወሰመንቱ፡ ዘሮሐ፨</l>
                  <l n="4">አመ፡ ፱ለኅዳር፡ ዘወሰንክሙ፡ ንጹሐ፨</l>
                  <l n="5">ጸሎተ፡ ሃይማኖት፡ ዘሊቅ፡ አትናቴዎስ፡ ሎሐ፨</l>
               </lg>
               <lg type="stanza" n="47">
                  <l n="1">ሰላም፡ ለመቃብሪክሙ፡ ዘየዐውዶ፡ ብርሃኑ፨</l>
                  <l n="2">ለዘእሙታን፡ ተንሥአ፡ በመለኮታዊ፡ ሥልጣኑ፨</l>
                  <l n="3">ሠለስቱ፡ ምእት፡ ዐሠርቱ፡ ወሰመንቱ፡ ላእካኑ፨</l>
                  <l n="4">ለዘዐርገ፡ ከመ፡ ያለቡ፡ ዕርገተ፡ ንጹሓን፡ ጻድቃኑ፨</l>
                  <l n="5">እለ፡ ይቤሎሙ፡ ንዑ፡ ይቁሙ፡ በይምኑ፨</l>
               </lg>
               <lg type="stanza" n="48">
                  <l n="1">አምኃ፡ ድርሳን፡ ወገድል፡ ለመልክእክሙ፡ ጸሐፍኩ፨</l>
                  <l n="2">እንዘ፡ በበ፡ ክፍሉ፡ እከፍል፡ ወእዌስክ፡ በበ፡ ተውሳኩ፨</l>
                  <l n="3">ሠለስቱ፡ ምእት፡ ለክብርክሙ፡ ሰገድኩ፨</l>
                  <l n="4">ተወከፉኒ፡ ማሕሌትየ፡ መሥዋዕተ፡ ጽባሑ፡ ወሰርኩ፨</l>
                  <l n="5">ዲበ፡ ጠረጴዛ፡ ሐመረ፡ ኖኅ፡ ዘአነ፡ አቅረብኩ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለክሙ፡ ሠለስቱ፡ ምእት፡ ዐሠርቱ፡ ወሰመንቱ፡ ዘኒቅያ፨</l>
                  <l n="2">ተፍጻሜተ፡ ሰማዕት፡ ጴጥሮስ፡ ባስልዮስ፡ ዘቂሣርያ፨</l>
                  <l n="3">ዮናክንዲኖስ፡ ዘሮሜ፡ ጎርጎርዮስ፡ ዘአርማንያ፨</l>
                  <l n="4">እለእስክንድሮስ፡ ሊቅ፡ ዘጉባኤ፡ አትናቴዎስ፡ ሐዋርያ፨</l>
                  <l n="5">ያዕቆብ፡ ዘንጽቢን፡ ኤፍሬም፡ ዘሶርያ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
