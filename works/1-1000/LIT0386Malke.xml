         <div type="edition" xml:lang="gez" xml:id="div2LIT0386Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ወለሥዕርትከ፡ ኤጤሜሶር፨</l>
                  <l n="2">ምስለ፡ ርእስከ፡ ግልድምያሶር፨</l>
                  <l n="3">መፍትሔ፡ ሀብታት፡ ራጉኤል፡ ፍልድምያሶር፨</l>
                  <l n="4">በእንተ፡ ኅቡእ፡ ስሙ፡ ለእግዚአብሔር፨</l>
                  <l n="5">ተሀበኒ፡ ነዓ፡ ሀብታተ፡ ሰማይ፡ ወምድር፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለገጽከ፡ ወለቀራንብቲከ፡ ጸበርትናኤል፨</l>
                  <l n="2">ምስለ፡ አዕይንቲከ፡ ሰልግዋታኤል፨</l>
                  <l n="3">መፍትሔ፡ ሀብታት፡ ራጉኤል፡ ብርስባሔል፨</l>
                  <l n="4">በእንተ፡ ኅቡእ፡ ስሙ፡ ለአማኑኤል፨</l>
                  <l n="5">ተጽናሰ፡ ወንዴተ፡ እምላዕሌየ፡ አቅልል፨</l>
               </lg>
               <lg type="stanza" n="15">
                  <l n="1">ሰላም፡ ለአጽፋረ፡ እግርከ፡ ወለቆምከ፡ ዋው፨</l>
                  <l n="2">ምስለ፡ መልክእከ፡ ታው፨</l>
                  <l n="3">መፍትሔ፡ ሀብታት፡ ራጉኤል፡ በቀቢአ፡ ዕፍረት፡ ቅድው፨</l>
                  <l n="4">በእንተ፡ ኅቡእ፡ ስሙ፡ ለእግዚአብሔር፡ ሕያው፨</l>
                  <l n="5">ዕቀበኒ፡ እምኵሉ፡ ጽልሕው፨</l>
               </lg>
            </div>
         </div>
