         <div type="edition" xml:lang="gez" xml:id="div2LIT0298Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ኣቀድም፡ አእኵቶቶ፡ ለእግዚአብሔር፡ ቅዱስ፨</l>
                  <l n="2">በእንተ፡ ኢየሱስ፡ ክርስቶስ፨</l>
                  <l n="3">ወአተሉ፡ ካዕበ፡ ዜና፡ ኢየሉጣ፡ ሐዳስ፨</l>
                  <l n="4">እስመ፡ ተክዕወ፡ በላዕሌየ፡ ፍቅረ፡ ውዳሴሃ፡ ተርሴስ፨</l>
                  <l n="5">ዘያስጥሞሙ፡ ለሥጋ፡ ወነፍስ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ አምሳለ፡ መዓር፡ ጥዑም፨</l>
                  <l n="2">ለአፈ፡ ኵሉ፡ ዓለም፨</l>
                  <l n="3">ኢየሉጣ፡ እምነ፡ ምስለ፡ ማርያም፨</l>
                  <l n="4">ሐውጺ፡ ለለዕለቱ፡ ደቂቀ፡ ዛቲ፡ ኤላም፨</l>
                  <l n="5">አምጣነ፡ አልቦሙ፡ እንበሌኪ፡ እም፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ሰላም፡ ለበድነ፡ ሥጋኪ፡ ዘምዑዝ፡ ከመ፡ መጽርይ፨</l>
                  <l n="2">ኢየሉጣ፡ ባሕርይ፨</l>
                  <l n="3">ለመካነ፡ ሥጋኪሰ፡ ኢያእመርክዎ፡ ጊጉይ፨</l>
                  <l n="4">እመኒ፡ ሰረገላ፡ ከመ፡ ወልድኪ፡ ኅሩይ፨</l>
                  <l n="5">ወለእመሂ፡ ከማየ፡ መቃብር፡ ክሩይ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ስብሐት፡ ለአብ፡ ወለወልድ፡ አኰቴት፨</l>
                  <l n="2">ወለመንፈስ፡ ቅዱስ፡ ባርኮት፨</l>
                  <l n="3">እስመ፡ አንቅሁኒ፡ ሊተ፡ ለነቢቦ፡ ዝንቱ፡ ስብሐት፨</l>
                  <l n="4">ባሕቱ፡ ኢይኀጣእ፡ ዕሴትየ፡ እምኢየሉጣ፡ ኅሪት፨</l>
                  <l n="5">እስመ፡ ለቅኑይ፡ ይደሉ፡ ዕሴት፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለኪ፡ ኢየሉጣ፡ ብዕልየ፡ ኢየሉጣ፡ ክብርየ፨</l>
                  <l n="2">ኢየሉጣ፡ ኀይልየ፡ ኢየሉጣ፡ ጽንዕየ፨</l>
                  <l n="3">ኢየሉጣ፡ መድኃኒትየ፨</l>
               </lg>
               <lg type="stanza" n="7">
                  <l n="1">ሰላም፡ ለኪ፡ ኢየሉጣ፡ በልኒ፡ አመ፡ ዕለተ፡ ፍትሕ፡ ወደይን፨</l>
                  <l n="2">ለምንት፡ ትፈርህ፡ ወተሐዝን፨</l>
                  <l n="3">ኪያከኑ፡ ኢያድኅን፡ ዘነሣእኩ፡ እምኀበ፡ አምላክ፡ ኪዳን፨</l>
               </lg>
            </div>
         </div>
      </body>
   </text></TEI>