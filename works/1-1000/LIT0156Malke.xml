      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0156</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0156Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ ስቡሕ፡ ዘየዐውዶ፡ ስባሔ፨</l>
                  <l n="2">ወበስመ፡ ማርያም፡ ድንግል፡ ምዕዝተ፡ ምግባር፡ እምነርሄ፨</l>
                  <l n="3">ስሐተ፡ መልክእከ፡ እንብብ፡ ዘይደምፅ፡ ውስተ፡ ኵለሄ፨</l>
                  <l n="4">ያብርሆ፡ ለልብየ፡ ሀብተ፡ ጸጋከ፡ መብርሄ፨</l>
                  <l n="5">ገብረ፡ ማርያም፡ ፀሓይ፡ ወጽዱል፡ ሱራሔ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘሆህያቲሁ፡ ሳብዕ፨</l>
                  <l n="2">አቅመ፡ ሰሚዖቱ፡ ለሰብእ፨</l>
                  <l n="3">ገብረ፡ ማርያም፡ በኵሉ፡ ተመሳሌ፡ ዳዊት፡ ብፁዕ፨</l>
                  <l n="4">በዐውድከ፡ ኢያቡሳዊ፡ ምዕራገ፡ ቅዱስ፡ ምሥዋዕ፨</l>
                  <l n="5">ለኀዲጐ፡ መቅሠፍት፡ ይትነሣእ፡ እዴከ፡ ባቍዕ፨</l>
               </lg>
               <lg type="stanza" n="48">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ውሳጤ፡ ቅድስት፡ ደብተራ፨</l>
                  <l n="2">ቤተ፡ ሚካኤል፡ ይእቲ፡ እደ፡ ዚአከ፡ ዘገብራ፨</l>
                  <l n="3">ገብረ፡ ማርያም፡ ተወከፍ፡ ለኅሊናየ፡ ገዐራ፨</l>
                  <l n="4">ህየንተ፡ ዘአቅረብኩ፡ ለመልክእከ፡ ምስለ፡ ቃለ፡ ስብሐት፡ ዕንዚራ፨</l>
                  <l n="5">ዶበ፡ ርእሰ፡ ልብየ፡ አንብር፡ ዘመዊእ፡ ጌራ፨</l>
               </lg>
               <lg type="stanza" n="49">
                  <l n="1">ስብሐት፡ ወክብር፡ ለማርያም፡ ይደሉ፨</l>
                  <l n="2">ዘከፈለተኒ፡ ቃለ፡ ከመ፡ እወድሰከ፡ ዘበበ፡ ክፍሉ፨</l>
                  <l n="3">ገብረ፡ ማርያም፡ ኀያል፡ ለገብረ፡ መስቀል፡ ሠርጐ፡ አክሊሉ፨</l>
                  <l n="4">ናሁ፡ ፈጸምኩ፡ ለመልክእከ፡ በጽሒፈ፡ ሐዳስ፡ ፊደሉ፨</l>
                  <l n="5">እሴተ፡ ሰላምየ፡ ፈኑ፡ እምሰማይ፡ ዘላዕሉ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
