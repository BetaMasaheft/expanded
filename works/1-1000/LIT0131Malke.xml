      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0131</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0131Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ከመ፡ ትርጓሜሁ፡ ፀሓይ፨</l>
                  <l n="2">ዘህላዌሁ፡ ሰማይ፨</l>
                  <l n="3">ገባሬ፡ መንክራት፡ <gap reason="ellipsis"/> እምነ፡ አእላፍ፡ ኅሩይ፨</l>
                  <l n="4">አልኆስስ፡ ውስተ፡ እዝንየ፡ ለብእሲ፡ ነዳይ፨</l>
                  <l n="5">መንክራት፡ ማይከ፡ እንግር፡ በመቅድስ፡ ዐባይ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ዘሕበሪሁ፡ ጸዐዳ፨</l>
                  <l n="2">ወለርእስከ፡ ቀይሕ፡ ከመ፡ ጽጌ፡ ረዳ፨</l>
                  <l n="3">ተወካፌ፡ ሥቃይ፡ <gap reason="ellipsis"/> ከመ፡ ጊዮርጊስ፡ ኮከበ፡ ልዳ፨</l>
                  <l n="4">ለቤትከ፡ መቅደሰ፡ ጽድቅ፡ እንተ፡ ዘሚካኤል፡ ዐምዳ፨</l>
                  <l n="5">እግረ፡ ምዝባሬ፡ ወሀጕል፡ ኢይቁም፡ በዐውዳ፨</l>
               </lg>
               <lg type="stanza" n="6">
                  <l n="1">ሰላም፡ ለአእናፊከ፡ መሳክወ፡ ምሥጢር፡ _ንታ፨</l>
                  <l n="2">ወለከናፍሪከ፡ ሰላም፡ መዐፁ_፡ ብዙኅ፡ ኀተታ፨</l>
                  <l n="3">ጸዋሬ፡ መስቀል፡ <gap reason="ellipsis"/> መ፡ አማኑኤል፡ ዘጎልጎታ፨</l>
                  <l n="4">ለሕዝበ፡ ቤትከ፡ እንተ፡ ዘሚካኤል፡ ማኅቶታ፨</l>
                  <l n="5">ጸላሎትከ፡ ይኩነነ፡ ኲናተ፡ ወወልታ፨</l>
               </lg>
               <lg type="stanza" n="7">
                  <l n="1">ሰላም፡ ለአፉከ፡ መስፈርተ፡ ጸሎትከ፡ _ና፨</l>
                  <l n="2">ወለአስናኒከ፡ ሰላም፡</l>
                  <l n="3"> </l>
               </lg>
            </div>
         </div>
      </body>
