      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0117</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0117Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ዐብየ፡ ላሓ፡ ነፍስየ፡ አምሳለ፡ ውሒዝ፡ ዘገዳም፨</l>
                  <l n="2">ከመ፡ ዐብየ፡ ላሓ፡ ለኢየሩሳሌም፨</l>
                  <l n="3">አመ፡ ዐብየ፡ ፍትሐ፡ ሞት፡ በስነነ፡ ኲናት፡ ጸሊም፨</l>
                  <l n="4">ገላውዴዎስ፡ እንዘ፡ ነፍስከ፡ ሕርትምተ፡ በቀል፡ ወቂም፨</l>
                  <l n="5">ወአእዳዊከ፡ ንጹሓት፡ እምደም፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ቦኑ፡ ኢያእመሩ፡ ለምሕረትከ፡ መጠና፨</l>
                  <l n="2">ወኢተዚያነውነ፡ መብዝኅተ፡ ሣህልከ፡ እምሰብአ፡ ዜና፨</l>
                  <l n="3">እለ፡ ቀተሉከ፡ ዕደው፡ በአእብዶ፡ ነፍስ፡ ወኅሊና፨</l>
                  <l n="4">ገላውዴዎስ፡ ፀርከ፡ ዘትስእል፡ ዳኅና፨</l>
                  <l n="5">[line missing]</l>
               </lg>
               <lg type="stanza" n="18">
                  <l n="1">ጽምው፡ ዖፍ፡ ወኅዱዕ፡ ገላውዴዎስ፡ ኄር፨</l>
                  <l n="2">እንዘ፡ ትጸውር፡ ቈጽለ፡ እምዕፀ፡ ዘይት፡ ሥሙር፨</l>
                  <l n="3">ከመ፡ ታብስሮሙ፡ ነዓ፡ ንትገተ፡ አይኅ፡ እምድር፨</l>
                  <l n="4">ናሁ፡ ኪኣከ፡ ይጸንሑ፡ ውስተ፡ አሐቲ፡ ሐመር፨</l>
                  <l n="5">ኅዳጣን፡ ሰብእ፡ ዘይድኅኑ፡ እምባሕር፨</l>
               </lg>
               <lg type="stanza" n="19">
                  <l n="1">ሰላም፡ ለርግዘትከ፡ ከመ፡ ጊዜ፡ ሐለይክዎ፡ በአንክሮ፨</l>
                  <l n="2">አአነብዝ፡ ገባእኩ፡ እምፍናወ፡ ሐዘን፡ ወአንጽሮ፨</l>
                  <l n="3">ባሕቱ፡ ነቃህኩ፡ ሶበ፡ ለክርስቶስ፡ እኔጽሮ፨</l>
                  <l n="4">ወአስተሐይጽ፡ በነፍስየ፡ ዘዕለተ፡ ዐርብ፡ ጻዕሮ፨</l>
                  <l n="5">ከመ፡ ገቦሁ፡ ረገዙ፡ ወቀነዉ፡ እግሮ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
