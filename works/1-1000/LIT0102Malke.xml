      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0102</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0102Malke">
            <note>The text is taken from <ref type="mss" corresp="https://betamasaheft.eu/EMDA0212"><seg corresp="EMDA0212">No item: EMDA0212</seg></ref>; spaces for rubricated words/lines were left empty in the manuscript</note>
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1"><supplied reason="omitted" resp="AD">ሰላም፡ ለዝክረ፡ ስምከ፡</supplied> <supplied reason="omitted" resp="SamAnd">ከመ፡ ስመ፡ ክል</supplied>ኤ፡ ቅልመታ፨</l>
                  <l n="2">ለጽዮን፡ በዐምደ፡ ቤታ፨</l>
                  <l n="3">መስተጽዕነ፡ ፈረስ፡ ኀያል፡ <supplied reason="omitted">ፊቅጦር፡</supplied> ወልደ፡ ማርታ፨</l>
                  <l n="4">ከመ፡ ትርከብ፡ ለዝክረ፡ ስምከ፡ ሀብታ፨</l>
                  <l n="5">መንፈስከ፡ ማሕየዊ፡ ይሰወጥ፡ ውስቴታ፨</l>
               </lg>
               <lg type="stanza" n="14">
                  <l n="1">ሰላም፡ ለበድነ፡ ሥጋከ፡ ሆርዮን፡ ዘአስተላጸቃ፨</l>
                  <l n="2">ለግንዘትከ፡ ሰላም፡ ወለመቃብሪከ፡ ንፍቃ፨</l>
                  <l n="3">ጻሕየይከ፡ ለነፍስከ፡ ዘያጠውቃ፨</l>
                  <l n="4">ቤዘ፡ ስምዕ፡ ፊቅጦር፡ ጽባሐዊ፡ እማእከለ፡ ጽልመት፡ ወጣቃ፨</l>
                  <l n="5">ውስተ፡ ብሔረ፡ ብርሃን፡ ትምጥቀኒ፡ ሥንከ፡ በሪቃ፨</l>
               </lg>
               <lg type="stanza" n="15">
                  <l n="1">አስካለ፡ ወይን፡ በምክያድ፡ በእንተ፡ አዕጽምቲከ፡ ዘተቀጥቀጣ፨</l>
                  <l n="2">ወበእንተ፡ አሥራዊከ፡ ወአምትንቲከ፡ ሥቃያተ፡ ኵሉ፡ እለ፡ ሰለጣ፨</l>
                  <l n="3">እል፡ ኪያከ፡ ፊቅጦር፡ ሰማዕተ፡ የውጣ፨</l>
                  <l n="4">ጸግወኒ፡ በትንባሌከ፡ ለማሕሌትየ፡ ተውላጣ፨</l>
                  <l n="5">ባሕርየ፡ መንግሥት፡ ሰማያዊተ፡ ዘዕጹብ፡ ሴጣ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
