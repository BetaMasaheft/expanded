      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0112</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0112Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘኍልቈ፡ ፊደሉ፡ ዓሥር፨</l>
                  <l n="2">ወለሥዕርትከ፡ ጸሊም፡ ምስለ፡ ድማኅከ፡ ክቡር፨</l>
                  <l n="3">ይርድአነ፡ ክርስቶስ፡ ሕፃን፡ ሱታፌ፡ ሕፃናት፡ ዘበኵር፨</l>
                  <l n="4">ከመ፡ ኣይድዕ፡ በበ፡ ጾታሁ፡ ጣዕመ፡ ዝክርከ፡ ሶከር፨</l>
                  <l n="5">ጽዋዐ፡ ልቡና፡ ምልአኒ፡ ዘዕዝራ፡ ማዕምር፨</l>
               </lg>
               <lg type="stanza" n="20">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ እምነ፡ ውሣጢት፡ ዘገዳም፨</l>
                  <l n="2">ወለዝኅርከ፡ እሙር፡ ምስለ፡ ክርታስከ፡ ሥዩም፨</l>
                  <l n="3">ይርድአነ፡ ክርስቶስ፡ ኮነ፡ ከመ፡ አመርከ፡ በሕልም፨</l>
                  <l n="4">አንተኑ፡ ሕፃን፡ ዘባረኮ፡ በወንጌለ፡ መንግሥት፡ እም፨</l>
                  <l n="5">ቅድመ፡ ኢየሱስ፡ ክርስቶስ፡ መድኃኔ፡ ዓለም፨</l>
               </lg>
               <lg type="stanza" n="21">
                  <l n="1">ሰላም፡ ለቤተ፡ ዝኅርከ፡ በአንጻረ፡ ቤታ፡ ለድንግል፨</l>
                  <l n="2">ከመ፡ ጎልጎታ፡ ዘኮነት፡ ለምስጋድ፡ ወለምስአል፨</l>
                  <l n="3">ይርድአነ፡ ክርስቶስ፡ ዋሕድ፡ እምሕፃናተ፡ ወንጌል፨</l>
                  <l n="4">ኅድግዎሙ፡ ይምጽኡ፡ ኀቤየ፡ ዘይቤሎሙ፡ ልዑል፨</l>
                  <l n="5">እስመ፡ ለዘከመ፡ እሉ፡ ይእቲ፡ መንግሥት፡ ወብዕል፨</l>
               </lg>
               <lg type="stanza" n="22">
                  <l n="1">ሰላም፡ ለአዘቃቲከ፡ ውስተ፡ ጥንቃቅአት፨</l>
                  <l n="2">ወመጽያሕተ፡ ለፀበልከ፡ ርጡን፡ ምስለ፡ ማያቲሁ፡ ሕይወት፨</l>
                  <l n="3">ይርድአነ፡ ክርስቶስ፡ ዳዊት፡ ዘሐጸነትከ፡ የዋሂት፨</l>
                  <l n="4">መጋቤ፡ ኩነኒ፡ ለገብርከ፡ እምሰዓተ፡ ኵሉ፡ መንሱት፨</l>
                  <l n="5">በዘተውህበከ፡ እም፡ አምላክ፡ ኪዳነ፡ ምሕረት፨</l>
               </lg>
               <lg type="stanza" n="23">
                  <l n="1">ተወኪፈከ፡ ዘንተ፡ አስተአየ፡ ዘአባላቲከ፡ ውዳሴ፨</l>
                  <l n="2">እንዘ፡ አስተታሉ፡ ዘአቅረብኩ፡ ጸውኦ፡ ስሙ፡ በሥላሴ፨</l>
                  <l n="3">ይርድአነ፡ ክርስቶስ፡ ሀበኒ፡ ሀብተ፡ በረከቱ፡ ለአውሴ፨</l>
                  <l n="4">ለዘጽህቁ፡ ወድሶተከ፡ በጥንቃቄ፡ ዐቢይ፡ ኁሣሤ፨</l>
                  <l n="5">ንዴት፡ ይኩነኒ፡ ጸጋከ፡ ሐዳሴ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ሕፃነ፡ አእምሮ፡ ፍልሱፍ፨</l>
                  <l n="2">ዘውገ፡ ሕፃናት፡ አእላፍ፨</l>
                  <l n="3">እለ፡ ቀተሎሙ፡ ሄሮድስ፡ በብልሀ፡ ሰይፍ፨</l>
                  <l n="4">ይርድአነ፡ ክርስቶስ፡ ሰብለ፡ መጽሐፍ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለከ፡ ዘኀረየከ፡ ልዑል፨</l>
                  <l n="2">እንበለ፡ ምግባር፡ ወገድል፨</l>
                  <l n="3">ሕፃነ፡ ይዋሄ፡ ሕሩመ፡ በቀል፨</l>
                  <l n="4">ይርድአነ፡ ክርስቶስ፡ ገብረ፡ መስቀል፨</l>
               </lg>
            </div>
         </div>
      </body>
      
   </text></TEI>