      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0582</citedRange></bibl>
               <bibl corresp="http://zotero.org/groups/358366/items/ZULPBCZX"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Habtamu2021Fragility"/><title level="a">Fragility and Resilience: Church History and Myth in Nineteenth-Century Ethiopia</title><title type="short">Fragility and Resilience</title><title level="j">Aethiopica</title><author><t:name xmlns:t="http://www.tei-c.org/ns/1.0">Habtamu Mengistie Tegegne</t:name></author><date>2021</date><biblScope unit="volume">23</biblScope><note type="accessed">2026-09-07T07:38:09Z</note><note type="url">https://journals.sub.uni-hamburg.de/aethiopica/article/view/1246</note><citedRange unit="page">138-140</citedRange></bibl>
            </listBibl>
