         <div type="edition" xml:lang="gez" xml:id="div2LIT0578Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ በሠርቀ፡ ኦርያሬስ፡ ሚያዝያ፨</l>
                  <l n="2">አመ፡ እምግዕዛኖሙ፡ ወፅኡ፡ ደቂቀ፡ ራሄል፡ ወልያ፨</l>
                  <l n="3">አቡነ፡ ዘአማኑኤል፡ ቡሩክ፡ ወልደ፡ አብርሃም፡ ወሶፍያ፨</l>
                  <l n="4">ተፈሥሐት፡ በልደትከ፡ ሀገሪትነ፡ ነያ፨</l>
                  <l n="5">እስመ፡ እምውስቴታ፡ ሠረቀ፡ ዳግማይ፡ ሐዋርያ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለልደትከ፡ ሐረገ፡ ወይን፡ ዘአብቈለ፨</l>
                  <l n="2">በቤተ፡ አብርሃም፡ አብ፡ እንበለ፡ ትሠቀይ፡ ጠለ፨</l>
                  <l n="3">አቡነ፡ ዘአማኑኤል፡ ካህን፡ እንተ፡ ታስተርኢ፡ ኀይለ፨</l>
                  <l n="4">ሶበ፡ ወጠንኩ፡ መልክኣቲከ፡ እንዘ፡ እሰምዕ፡ ገድለ፨</l>
                  <l n="5">ባርከኒ፡ ለፈጽሞ፡ ወሀበኒ፡ ሣህለ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ክቡር፡ ወልዑል፨</l>
                  <l n="2">ወለዜናከ፡ ሰላም፡ ገባሬ፡ ኀይል፨</l>
                  <l n="3">ዘአማኑኤል፡ ኪራኮስ፡ ጸዋሬ፡ ቅዱስ፡ መስቀል፨</l>
                  <l n="4">ባርከነ፡ ለደቂቅከ፡ በደብረ፡ በረከት፡ ጥሉል፨</l>
                  <l n="5">እለ፡ ተጋባእነ፡ ዮም፡ ለዛቲ፡ በዓል፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ እግዚአብሔር፡ ዘአልዐላ፨</l>
                  <l n="2">ለደብረ፡ በረከት፡ በማእከላ፨</l>
                  <l n="3">ዘአማኑኤል፡ ሰሎሞን፡ ለዓለም፡ ሠርጐ፡ አክሊላ፨</l>
                  <l n="4">ትዌድሰከ፡ ደብረ፡ ድኁኃን፡ እንዘ፡ እንዘ፡ ታሌዕል፡ ቃላ፨</l>
                  <l n="5">አምጣነ፡ ተዝካረከ፡ ሥርዐት፡ ወጸጋከ፡ ከለላ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ሰላም፡ ለትንሣኤከ፡ ምስለ፡ ነፍሰ፡ ጻድቃን፡ እንግልጋ፨</l>
                  <l n="2">በተጸውዖ፡ አምላክ፡ ግርምት፡ ለተዋሕዶተ፡ ነፍስ፡ ወሥጋ፨</l>
                  <l n="3">ዘአማኑኤል፡ ዮሐንስ፡ ምሉአ፡ ሞገስ፡ ወጸጋ፨</l>
                  <l n="4">እስእለከ፡ ትክበር፡ ነፍሰ፡ ዚአየ፡ እንበለ፡ ኅፀፅ፡ ወንትጋ፨</l>
                  <l n="5">በትዝምደ፡ ሥጋ፡ ወነፍስ፡ እስመ፡ አንተ፡ ዘውጋ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ለዘጸሐፈ፡ ገድለከ፡ ወለዘአንበበ፡ ወለዘተርጐመ፡ በልሳኑ፨</l>
                  <l n="2">ወለዘሰምዐ፡ በእዝኑ፨</l>
                  <l n="3">ዘአማኑኤል፡ ኅሩይ፡ ዘደብረ፡ በረከት፡ መካኑ፨</l>
                  <l n="4">አኀድግ፡ ሎሙ፡ ጌጋዮሙ፡ ሶበ፡ ኪያከ፡ ተማሕፀኑ፨</l>
                  <l n="5">ይቤሎ፡ አምላክ፡ በጽኑዕ፡ ኪዳኑ፨</l>
               </lg>
               <lg type="stanza" n="33">
                  <l n="1">ተወከፍ፡ እግዚኦ፡ ሰላመ፡ መልክእከ፡ አምኃየ፨</l>
                  <l n="2">እንበለ፡ ሠላሳ፡ ወሠላስ፡ አምጣነ፡ ካልእ፡ አልብየ፨</l>
                  <l n="3">ዘአማኑኤል፡ ካህን፡ ዘታስተሥሪ፡ ጌጋየ፨</l>
                  <l n="4">ሀበኒ፡ ለወልድከ፡ ህየንተ፡ ኅዳጥ፡ ዐሥብየ፨</l>
                  <l n="5">እምእግዚአብሔር፡ ባዕል፡ ዘይሁብ፡ ሠናየ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
