         <div type="edition" xml:lang="gez" xml:id="div2LIT0180Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">አዕይንተ፡ ልብየ፡ አብርህ፡ ከመ፡ ይሰስል፡ ፁገ፨</l>
                  <l n="2">ወበልሳንየ፡ ይትከሠት፡ በእግረ፡ ሕሊና፡ ዘዐርገ፨</l>
                  <l n="3">እግዚአብሔር፡ ሀበኒ፡ ድርሳነ፡ መርቆሬዎስ፡ ደርገ፨</l>
                  <l n="4">ይሰወጥ፡ ውስተ፡ ከርሥየ፡ እሰከ፡ ይመልእ፡ ድንጋገ፨</l>
                  <l n="5">በገይበ፡ ከናፍር፡ እቅዳሕ፡ ፍቅረከ፡ ፈለገ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ሞገሰ፡ ረድኤት፡ ዘባቲ፨</l>
                  <l n="2">ከመ፡ ዮሐንስ፡ መጥመቅ፡ ወይነ፡ አሰክሮ፡ ዘኢይሰቲ፨</l>
                  <l n="3">መርቆሬዎስ፡ አቡየ፡ እንቀ፡ ሃይማኖት፡ ከሣቲ፨</l>
                  <l n="4">እዜኑ፡ ዕበያቲከ፡ ወሠናያቲከ፡ እንታክቲ፨</l>
                  <l n="5">ያስተፌሥሕ፡ መላእክተ፡ ወልበ፡ ሰብእ፡ መዋቲ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለቆብዐ፡ ርእስከ፡ ከመ፡ ቃለ፡ መጽሐፍ፡ ጠቢብ፨</l>
                  <l n="2">በቆብዐ፡ ክርስቶስ፡ ይትሜሰል፡ እንተ፡ ተወክፈ፡ በዐርብ፨</l>
                  <l n="3">ወባዬ፡ ጸቃውዕ፡ መርቆሬዎስ፡ ዘምሳሌከ፡ ንህብ፨</l>
                  <l n="4">ወአክናፊከ፡ ጽጌ፡ አቅማሕ፡ ርቡብ፨</l>
                  <l n="5">መርዓ፡ እምቤትከ፡ ይውሕዝ፡ ሐሊብ፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለሥእርተ፡ ርእስከ፡ ዘውገ፡ እንጦንዮስ፡ ቀዳሚ፨</l>
                  <l n="2">ዘኢፀፈሮ፡ ኬንያ፡ ለተወድሶ፡ ዓለም፡ በእደ፡ ቀሳሚ፨</l>
                  <l n="3">መርቆሬዎስ፡ አቡየ፡ መምህረ፡ ሃይማኖት፡ ኢተቀያሚ፨</l>
                  <l n="4">አልቦ፡ አይሁድ፡ ወአልቦ፡ አረሚ፨</l>
                  <l n="5">ዘተገድፈ፡ ውስተ፡ በድው፡ ስመከ፡ ዘይሰሚ፨</l>
               </lg>
               <lg type="stanza" n="47">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ድኅረ፡ ነሣእከ፡ ነገረ፡ ኪዳን፨</l>
                  <l n="2">ኃጥኣነ፡ ዓለም፡ ኵሎ፡ በዘታድኅን፨</l>
                  <l n="3">ወበእንተዝ፡ ትሰመይ፡ በማኅሌተ፡ ምዑዝ፡ ልሳን፨</l>
                  <l n="4">እክለ፡ አሕይዎ፡ መርቆሬዎስ፡ ወስቴ፡ መድኃኒተ፡ ወይን፨</l>
                  <l n="5">ሰሚዐ፡ ዜናከ፡ ኢትጸግብ፡ እዝን፨</l>
               </lg>
               <lg type="stanza" n="48">
                  <l n="1">ሰላም፡ ለተአምሪከ፡ በሰዓተ፡ ቅዳሴ፡ ግሩም፨</l>
                  <l n="2">ቤተ፡ ክርስቲያን፡ ቅድስት፡ አመ፡ ትትገለበብ፡ በፍሕም፨</l>
                  <l n="3">መርቆሬዎስ፡ አርሳኒ፡ ምንኵስናከ፡ ፍጹም፨</l>
                  <l n="4">ሐፀነተከ፡ ተጋድሎ፡ ወአልሐቀተከ፡ ጾም፨</l>
                  <l n="5">ወበእንተዝ፡ ትትዌደስ፡ በዜማ፡ ጥዑም፨</l>
               </lg>
               <lg type="stanza" n="49">
                  <l n="1">ሰላም፡ ለተአምሪከ፡ እንተ፡ ይበዝኅ፡ እምኆፃ፨</l>
                  <l n="2">ወረድኤትከኒ፡ ይረውፅ፡ እምአሕፃ፨</l>
                  <l n="3">መርቆሬዎስ፡ ዐፅቅ፡ ለጒንደ፡ ሕይወት፡ ሠርፃ፨</l>
                  <l n="4">ሰይጣንሰ፡ መሠረተ፡ ኵሉ፡ ዐመፃ፨</l>
                  <l n="5">ይትነጻሕ፡ እመርሕበ፡ ቤትከ፡ ዘክርስቶስ፡ ሐነፃ፨</l>
               </lg>
               <lg type="stanza" n="50">
                  <l n="1">አምኃ፡ ሰላም፡ አቅረብኩ፡ ለዝክረ፡ ውዳሴከ፡ ዘልፈ፨</l>
                  <l n="2">ለለ፡ አሐዱ፡ አሐዱ፡ እንዘ፡ እከሥት፡ አፈ፨</l>
                  <l n="3">መርቆሬዎስ፡ ሀበኒ፡ ዘኢተኀልፍ፡ ኀሊፈ፨</l>
                  <l n="4">ጽዋዔ፡ መልክዕከ፡ በኢኊልቈ፡ ኀምሳ፡ ተጽሕፈ፨</l>
                  <l n="5">ወእምዝ፡ በድካም፡ መብዝኅቶሰ፡ ተርፈ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
