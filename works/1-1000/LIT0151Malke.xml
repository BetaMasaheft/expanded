         <div type="edition" xml:lang="gez" xml:id="div2LIT0151Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለተንሥኦትከ፡ በቃለ፡ ፈጣሪ፡ ልዑል፨</l>
                  <l n="2">ከመ፡ ወሬዛ፡ ግሩም፡ እንበለ፡ ሙስና፡ ወሀጕል፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ አቡነ፡ ጽሙደ፡ ጸሎት፡ ወገድል፨</l>
                  <l n="4">አሰሰልከ፡ ጋዕዝ፡ እምውሉድከ፡ በዘኢይትኄሰው፡ ቃል፨</l>
                  <l n="5">ድልዋኒክሙ፡ ንበሩ፡ እንዘ፡ ትብል፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ ወለልደትከ፡ መንክር፨</l>
                  <l n="2">እምጽጌ፡ ማርያም፡ ቡርክት፡ ወእምጻማ፡ ክርስቶስ፡ ክቡር፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ እንጦንስ፡ ተላዌ፡ አሠሩ፡ ለኄር፨</l>
                  <l n="4">ናስተበፅዕ፡ ዜና፡ ገድልከ፡ ምስለ፡ ሊቃናት፡ በኅብር፨</l>
                  <l n="5">ውስተ፡ ገዳምከ፡ ቅድስት፡ ዘስማ፡ ዙርዙር፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተጸውዐ፡ በኀይሉ፨</l>
                  <l n="2">ወለሥዕርትከ፡ ሰላም፡ ለፈትለ፡ ሜላት፡ አምሳሉ፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ መምህር፡ ለወልደ፡ እግዚአብሔር፡ ወንጌሉ፨</l>
                  <l n="4">እጽሕፍ፡ ዜና፡ ዝክርከ፡ ማእከለ፡ ካህናት፡ እሉ፨</l>
                  <l n="5">አምጣነ፡ ዝክርከ፡ ይትዐወቅ፡ በኵሉ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ማእከለ፡ አድባር፡ ወሐቅል፨</l>
                  <l n="2">እለ፡ በውስቴታ፡ ነበሩ፡ ማኅበረ፡ ቅዱሳን፡ አህባል፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ አቡነ፡ ዘቤተ፡ ክርስቲያን፡ አክሊል፨</l>
                  <l n="4">ኮነ፡ ምስማከከ፡ እንተ፡ አብ፡ ወንጌል፨</l>
                  <l n="5">ወኮነ፡ መርጉዘከ፡ እንተ፡ ወልድ፡ መስቀል፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ናሁ፡ አቅረብኩ፡ ማሕሌትየ፡ ለመልክእከ፡ በእማኄ፨</l>
                  <l n="2">ጸሓፌ፡ መልክእከ፡ አነ፡ እንዘ፡ ሶበ፡ እብል፡ ኤሎሄ፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ ክቡር፡ ዘመልክእከ፡ ሡራሄ፨</l>
                  <l n="4">እስመ፡ ከመ፡ እጽሐፍ፡ አባሕከኒ፡ ዜና፡ ዝክርከ፡ ስባሔ፨</l>
                  <l n="5">ዘይትነገር፡ ለከ፡ በመካን፡ ኵለሄ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ተወከፍ፡ ዘንተ፡ አምኃ፡ መልክእከ፡ በተወክሎ፨</l>
                  <l n="2">እንዘ፡ ኣቄርብ፡ ስብሐተ፡ ወብዙኀ፡ ተማኅልሎ፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ ኤልያስ፡ ነቢየ፡ ቴስብያ፡ ወሴሎ፨</l>
                  <l n="4">አርአየኒ፡ እስኩ፡ በመጽሔተ፡ አእምሮት፡ ኵሎ፨</l>
                  <l n="5">ከመ፡ ያርኢ፡ እግዚእየ፡ ሥልጣኖ፡ ወኀይሎ፨</l>
               </lg>
               <lg type="stanza" n="38">
                  <l n="1">ሰላም፡ ለበአትከ፡ ዘትሰመይ፡ ጉርብ፨</l>
                  <l n="2">እንዘ፡ በውስቴታ፡ ትጼሊ፡ ስብሐተ፡ ማርያም፡ ጠባብ፨</l>
                  <l n="3">ዐሥራተ፡ ወልድ፡ ዮናስ፡ ሰባኬ፡ ንስሓ፡ ለሕዝብ፨</l>
                  <l n="4">ያንቅሐኒ፡ እምንዋመ፡ ሀኬት፡ ኀይለ፡ ጸጋከ፡ ዕጹብ፨</l>
                  <l n="5">ከመ፡ አንቅሖ፡ ጳውሎስ፡ ለቲቶ፡ ስኩብ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
