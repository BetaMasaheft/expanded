      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0137</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0137Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ናሁ፡ አንሣእኩ፡ አዕይንትየ፡ መንገለ፡ ሥላሴ፡ ሠለስቱ፨</l>
                  <l n="2">ረድኤትየ፡ ይብጻሕ፡ አመ፡ ውዳሴከ፡ ዝንቱ፨</l>
                  <l n="3">ኢዮስያስ፡ ኮከብ፡ ዘእምከዋክብት፡ ፯ቱ፨</l>
                  <l n="4">በምድረ፡ አግዓዚ፡ እለ፡ ብርሃነ፡ ከሠቱ፨</l>
                  <l n="5">ወእምኢትዮጵያ፡ ቅድስት፡ ጽልመተ፡ አእተቱ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ምሉዐ፡ ሞገስ፡ ስም፨</l>
                  <l n="2">ከመ፡ ስመ፡ ቅዱስ፡ ጳውሎስ፡ መምህረ፡ እስያ፡ ወሮም፨</l>
                  <l n="3">ኢዮስያስ፡ አብ፡ በገራህተ፡ ሐዲስ፡ ዓለም፨</l>
                  <l n="4">አባ፡ አባ፡ እምትምህርትከ፡ ዝናም፨</l>
                  <l n="5">ጽጌ፡ በረከት፡ ተርእየ፡ ወተውህበ፡ ቀስም፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ በእደ፡ ካህናት፡ መዘምራን፨</l>
                  <l n="2">ወለመቃብሪከ፡ ቅድስት፡ እንተ፡ የዐውዳ፡ ብፅዓን፨</l>
                  <l n="3">ኢዮስያስ፡ ፀሓይ፡ መጋቤ፡ አዝማን፨</l>
                  <l n="4">አብርህ፡ ሊትአ፡ እግዚኦ፡ እምዘዚአከ፡ ብርሃን፨</l>
                  <l n="5">አመ፡ በጽልመት፡ ተእኅዘ፡ ዘዚአየ፡ ዐይን፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">አብዝኆ፡ ውዳሴ፡ እንዘ፡ ይደሉ፡ ለዕበይከ፡ መንክር፨</l>
                  <l n="2">ወለነገርከ፡ ኵሉ፡ ዘመልዕልተ፡ ኵሉ፡ ነገር፨</l>
                  <l n="3">ኢዮስያስ፡ ኰኵሕ፡ መሠረተ፡ ዐበይት፡ አድባር፨</l>
                  <l n="4">ናሁ፡ ጸሐፍኩ፡ ውዳሴከ፡ በኍልቈ፡ ፴፡ ብሩር፨</l>
                  <l n="5">ዘተሠይጠ፡ ቦሙ፡ መለኮት፡ ክቡር፨</l>
               </lg>
            </div>
         </div>
      </body>
      
