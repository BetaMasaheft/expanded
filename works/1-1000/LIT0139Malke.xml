         <div type="edition" xml:lang="gez" xml:id="div2LIT0139Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ናሁ፡ ወጠንኩ፡ ለመልክኣቲከ፡ ኵሎን፨</l>
                  <l n="2">በበ፡ አስማቲሆን፨</l>
                  <l n="3">እስጢፋኖስ፡ ጻድቅ፡ ከሣቴ፡ ብርሃን፨</l>
                  <l n="4">ከመ፡ እንብብ፡ ድርሳናቲከ፡ መጽሐፈ፡ ሐዲስ፡ ኪዳን፨</l>
                  <l n="5">ዘተናገርዎ፡ መላእክት፡ ኄራን፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለእስጢፋኖስ፡ ለአላኒቆስ፡ እጓሉ፨</l>
                  <l n="2">እምአፈ፡ ምውት፡ ዘደምጠ፡ ትእምርተ፡ ዕበዩ፡ ወብዕሉ፨</l>
                  <l n="3">ዝንቱ፡ አብ፡ ውዱስ፡ በአፈ፡ ኵሉ፨</l>
                  <l n="4">ዕዉራነ፡ ዐይን፡ አብርሃ፡ ጸበሉ፨</l>
                  <l n="5">ወካልኣነ፡ ሕሙማነ፡ ፈውሰ፡ በገድሉ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ መስተፍሥሔ፡ ኵሉ፡ ፍጡር፨</l>
                  <l n="2">ወለልደትከ፡ ሰላም፡ ለወርኀ፡ ኅዳር፨</l>
                  <l n="3">እስጢፋኖስ፡ ድንግል፡ መምህረ፡ ትሕትና፡ ወፍቅር፨</l>
                  <l n="4">ምስሌከ፡ ማኅበራኒከ፡ በልደትከ፡ ክቡር፨</l>
                  <l n="5">ተፈሥሑ፡ ሰማያት፡ ወተሐሥየት፡ ምድር፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለልደትከ፡ በዐውደ፡ ሕፃን፡ መካን፨</l>
                  <l n="2">በቃለ፡ አላኒቆስ፡ አብ፡ ወበኀይለ፡ አምላክ፡ መድኅን፨</l>
                  <l n="3">እስጢፋኖስ፡ ጻድቅ፡ እስጢፋኖስ፡ ካህን፨</l>
                  <l n="4">ሰአሎ፡ ለአምላክከ፡ አመ፡ ዕለተ፡ ፍዳ፡ ወደይን፨</l>
                  <l n="5">ይባልሐኒ፡ በምሕረቱ፡ ለብእሲ፡ ምኑን፨</l>
               </lg>
               <lg type="stanza" n="5">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዝክረ፡ ትጉሃን፡ መላእክት፨</l>
                  <l n="2">መዐዛ፡ ቅዱሳን፡ ሰማዕት፨</l>
                  <l n="3">እስጢፋኖስ፡ መምህር፡ አጽናዔ፡ ሃይማኖት፡ ርትዕት፨</l>
                  <l n="4">ዕቀበኒ፡ ለገብርከ፡ በጸሎትከ፡ ቅድስት፨</l>
                  <l n="5">አይምፃእ፡ በላዕሌየ፡ ጸላኢ፡ ስሑት፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ሰላም፡ ለፀአተ፡ ነፍስከ፡ ወለበድነ፡ ሥጋከ፡ ክልኤቱ፨</l>
                  <l n="2">ወለግንዘትከ፡ ሰላም፡ ምስለ፡ መቃብሪከ፡ ዝንቱ፨</l>
                  <l n="3">እስጢፋኖስ፡ ነፍስከ፡ ሶበ፡ ትወፅአ፡ በዝንቱ፨</l>
                  <l n="4">ተቀበልዋ፡ እንዘ፡ ይብሉ፡ መላእክት፡ በላዕሉ፡ ወታሕቱ፨</l>
                  <l n="5">ክቡር፡ በኀበ፡ ሰብእ፡ ለጻድቅ፡ ሞቱ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ተወኪፈከ፡ እግዚኦ፡ ዘአቅረብኩ፡ በአስተሐምሞ፨</l>
                  <l n="2">ለመልክእከ፡ ሰላሞ፨</l>
                  <l n="3">እስጢፋኖስ፡ ወልዱ፡ ለአላኒቆስ፡ አበሞ፨</l>
                  <l n="4">አእሚረከ፡ እግዚእየ፡ ለሰብእናየ፡ ድካሞ፨</l>
                  <l n="5">ለፀርየ፡ ዘይኄይለኒ፡ በመስቀል፡ ግዝሞ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ስብሐት፡ ይደሉ፡ ለዘአልዐለከ፡ ቀዲሙ፨</l>
                  <l n="2">ወዘቀደሰከ፡ በደሙ፨</l>
                  <l n="3">ወለመስቀሉ፡ ክቡር፡ ወለወላዲቱ፡ ወእሙ፨</l>
                  <l n="4">እስጢፋኖስ፡ ሐዋርያ፡ ሰባኬ፡ ወንጌል፡ በስሙ፨</l>
                  <l n="5">ይሴብሑ፡ ለስምከ፡ መላእክት፡ ኵሎሙ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ናሁ፡ ፈጸምኩ፡ ስብሐተ፡ መልክእከ፡ በአሚን፨</l>
                  <l n="2">በፈቃደ፡ አምላክ፡ መድኅን፨</l>
                  <l n="3">ወልደ፡ አላኒቆስ፡ ወላዲ፡ እስጢፋኖስ፡ ካህን፨</l>
                  <l n="4">ባርከነ፡ በመስቀልከ፡ ለደቂቅከ፡ ምእመን፨</l>
                  <l n="5">በሀገር፡ ወበዝ፡ መካን፨</l>
               </lg>
            </div>
         </div>
      </body>
      
