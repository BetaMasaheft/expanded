         <div type="edition" xml:lang="gez" xml:id="div2LIT0426Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ ቀዳማዊ፡ እንተ፡ ኢይብልዎ፡ እማእዜ፨</l>
                  <l n="2">ወደኃራዊ፡ ለሊሁ፡ ወዘኢያወሥእዎ፡ እስከ፡ ይእዜ፨</l>
                  <l n="3">ከመ፡ እጽሐፍ፡ ለኪ፡ ማርያም፡ ተዝካረ፡ ግፍዕኪ፡ ባሕረ፡ ተከዜ፨</l>
                  <l n="4">ቍስቋም፡ ትተረጐም፡ ለርእስየ፡ በከናፍሪሃ፡ ኑዛዜ፨</l>
                  <l n="5">እስመ፡ ነበረት፡ ምስሌኪ፡ በውእቱ፡ ጊዜ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ ወለሥዕርትኪ፡ ድሉል፨</l>
                  <l n="2">ለርእስኪ፡ ልዕልና፡ ቍስቋም፡ ልዑል፨</l>
                  <l n="3">በእንቲአሁ፡ ማርያም፡ ሶበ፡ ተአዘዘ፡ ቀትል፨</l>
                  <l n="4">ኵሎ፡ ዓለመ፡ በደሙ፡ እንዘ፡ ያድኅን፡ እምሀጕል፨</l>
                  <l n="5">በደመ፡ ሕፃናት፡ ድኅነ፡ ሕፃንኪ፡ ቃል፨</l>
               </lg>
               <lg type="stanza" n="19">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋኪ፡ ወለመቃብርኪ፡ ጌቴሴማኒ፨</l>
                  <l n="2">ወለፍልሰተ፡ ሥጋኪኒ፡ ዲበ፡ የማነ፡ ወልድኪ፡ ኰናኒ፨</l>
                  <l n="3">ማሕሌትየ፡ ማርያም፡ እንዘ፡ ትብል፡ ቅድመ፡ አማኒ፨</l>
                  <l n="4">ኀበ፡ ወፃእኩ፡ ኵለሄ፡ ወኀበ፡ ሖርኩ፡ ይእዜኒ፨</l>
                  <l n="5">ከመ፡ ደብረ፡ ቍስቋም፡ ጥልልት፡ መድኀኒተ፡ ይኩነኒ፨</l>
               </lg>
