         <div type="edition" xml:lang="gez" xml:id="div2LIT0115Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ በተዐድዎ፡ ሕግ፡ ዘኮነ፨</l>
                  <l n="2">ወለልደትከ፡ ሰላም፡ እንዘ፡ ትፈትሕ፡ ማሕፀነ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ እምአብ፡ እንተ፡ ነሣእከ፡ ሥልጣነ፨</l>
                  <l n="4">እምልብየ፡ ዝንጋኤ፡ ልብ፡ አእትት፡ ፍጡነ፨</l>
                  <l n="5">[line missing]</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘአስተዛለፋ፡ ቀባዒ፨</l>
                  <l n="2">ኀበ፡ ትንሣኤ፡ በቋዒ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ ኀያል፡ ኀያላነ፡ ጽልመት፡ መዋኢ፨</l>
                  <l n="4">አድኅነኒ፡ በረድኤትከ፡ እመልአከ፡ ዓለም፡ ፈጋዒ፨</l>
                  <l n="5">እስመ፡ አበ፡ ግፉዕ፡ አንተ፡ ወአንተ፡ ረዳኢ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ እምዐይነ፡ አእምሮ፡ ሰብአዊ፨</l>
                  <l n="2">ገጸ፡ ኍላቌሁ፡ ዘኀብአ፡ እግዚአብሔር፡ ማሕየዊ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ መክብብ፡ መምህር፡ እስክንድራዊ፨</l>
                  <l n="4">ኢትትሀከይ፡ አቂቦተነ፡ በአምሳለ፡ ትጉህ፡ ኖላዊ፨</l>
                  <l n="5">ለአባግዒከ፡ እምተኵላ፡ ነዓዊ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ሥጋከ፡ በዝየ፡ ተሰብሐ፨</l>
                  <l n="2">ወስብሐተ፡ ዕበይ፡ ነሥአ፡ እምአፈ፡ መላእክት፡ በከሃ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ ለገጽ፡ እንተ፡ ታደሉ፡ ፍትሐ፨</l>
                  <l n="4">ለነፍስየ፡ መፍቀሪትከ፡ ተወኪፈከ፡ ጻማሃ፨</l>
                  <l n="5">ኃጣውኢሃ፡ አስተስሪ፡ ወፍዲ፡ ዕዳሃ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">እሴብሖ፡ ለእግዚአብሔር፡ ዘአስተጋብአነ፡ እምርኁቅ፨</l>
                  <l n="2">በዓለ፡ ዕረፍትከ፡ ንግበር፡ ወተዝካረከ፡ በጻህቅ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ በጸጋ፡ ወላዴ፡ አእላፍ፡ ደቂቅ፨</l>
                  <l n="4">ጉባኤነ፡ ባርክ፡ ባሕቱ፡ በመስቀልከ፡ ዘጻድቅ፨</l>
                  <l n="5">ወበጸሎትከ፡ ይድኅን፡ ሕዝበከ፡ እምድድቅ፨</l>
               </lg>
               <lg type="stanza" n="31">
                  <l n="1">ለማርያም፡ ዘአለበወተኒ፡ ዘንተ፨</l>
                  <l n="2">ድርሳነ፡ መልክእከ፡ አባ፡ እንዘ፡ ትከውን፡ ረድኤተ፨</l>
                  <l n="3">ወልደ፡ ትንሣኤ፡ ለኵሉ፡ ዘታስተበቍዕ፡ ምሕረተ፨</l>
                  <l n="4">ሰሚዐከ፡ በቃለ፡ አፉየ፡ ወዘልብየ፡ ስእለተ፨</l>
                  <l n="5">ሀብተ፡ በረከት፡ ሀበኒ፡ ዕሤተ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
