         <div type="edition" xml:lang="gez" xml:id="div2LIT0138Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ አሐዱ፡ አምላክ፡ ወዕፀ፡ ሊባኖስ፡ መጾሩ፨</l>
                  <l n="2">ድርሳነ፡ መልክእከ፡ ወጠንኩ፡ እንብብ፡ በበ፡ ጾታሁ፡ ወኅብሩ፨</l>
                  <l n="3">አላኒቆስ፡ ፀሓይ፡ ዘታበርህ፡ ለለ፡ አሚሩ፨</l>
                  <l n="4">ጸግወኒ፡ ልሳነ፡ ዕዝራ፡ ወዘዮሐንስ፡ ፍቅሩ፨</l>
                  <l n="5">እለ፡ እምቀደምቶሙ፡ ጸንዑ፡ ወኵሎ፡ አእመሩ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለልደትከ፡ ዘኮነ፡ እምዘፈጸሙ፨</l>
                  <l n="2">ነገሥተ፡ እስራኤል፡ ጻድቃን፡ ሕገ፡ ኵሎሙ፨</l>
                  <l n="3">መናኔ፡ መንግሥት፡ አላኒቆስ፡ ወተድላ፡ ጣዕሙ፨</l>
                  <l n="4">አንተኑ፡ ለአኖሬዎስ፡ ዳግሙ፨</l>
                  <l n="5">ወለገዳማዊ፡ ዳንኤል፡ ዘኢዮር፡ ገዳሙ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘያስተፌሥሕ፡ አልባበ፨</l>
                  <l n="2">ከመ፡ ወይነ፡ ቃና፡ ሐዋዝ፡ ዘበውስተ፡ ቃና፡ ተረክበ፨</l>
                  <l n="3">ምስለ፡ ዘሚካኤል፡ አረጋዊ፡ ከመ፡ ቃለ፡ ወንጌል፡ ነበበ፨</l>
                  <l n="4">አላኒቆስ፡ በሰማያት፡ እንዘ፡ ትጸንሕ፡ ከብካበ፨</l>
                  <l n="5">ኀደገ፡ እመ፡ ወመነንከ፡ አበ፨</l>
               </lg>
               <lg type="stanza" n="53">
                  <l n="1">ሰላም፡ ለትንሣኤከ፡ እንተ፡ ያነሥኦ፡ ፈጣሪ፨</l>
                  <l n="2">አመ፡ ንፍሐተ፡ ቀርን፡ ደኃሪ፨</l>
                  <l n="3">አላኒቆስ፡ ክቡር፡ ዘመደ፡ ቂርቆስ፡ ወኤሪ፨</l>
                  <l n="4">ለሥጋየ፡ ዮናስ፡ ታወፅኦ፡ እምከርሠ፡ ጌጋይ፡ ዐንበሪ፨</l>
                  <l n="5">መሐሬ፡ ትሰመይ፡ ከመ፡ አብ፡ መሓሪ፨</l>
               </lg>
               <lg type="stanza" n="54">
                  <l n="1">ድኅረ፡ ከመ፡ ሙሴ፡ ነቢይ፡ ከፈልከ፡ ቀላየ፨</l>
                  <l n="2">ወከመ፡ ኢያሱ፡ መስፍን፡ አቀምከ፡ ፀሓየ፨</l>
                  <l n="3">አላኒቆስ፡ በክብር፡ ጊዜ፡ አዕረፍከ፡ ሠናየ፨</l>
                  <l n="4">ዳዊት፡ ንጉሥ፡ ዘልበ፡ እግዚኡ፡ ተሰምየ፨</l>
                  <l n="5">ክቡር፡ ሞቱ፡ ለጻድቅ፡ እንዘ፡ ይብል፡ ሐለየ፨</l>
               </lg>
               <lg type="stanza" n="56">
                  <l n="1">እምቅድመ፡ ይንሥአኒ፡ ሞት፡ ዘኢየኀድግ፡ ንጉሠ፨</l>
                  <l n="2">መጠነ፡ ድካምየ፡ ናሁ፡ ወደስኩከ፡ አንሰ፨</l>
                  <l n="3">አላኒቆስ፡ ባዕል፡ እንተ፡ ረከብከ፡ ሞገሰ፨</l>
                  <l n="4">ባርከኒ፡ አባ፡ በየማነ፡ እዴከ፡ ሥልስ፨</l>
                  <l n="5">ወታሕተ፡ ንግሥከ፡ ረስየኒ፡ ርእሰ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ኦአቡየ፡ ወላዴ፡ አዕናቍ፡ አእላፍ፨</l>
                  <l n="2">እማሕፀነ፡ ጸጋ፡ ቡርክት፡ አምሳለ፡ ሰይፍ፨</l>
                  <l n="3">ወአላኒቆስ፡ ብእሴ፡ መጽሐፍ፨</l>
               </lg>
               <lg type="stanza" n="7">
                  <l n="1">ሰላም፡ ለከ፡ ኦአቡየ፡ እንተ፡ ተሎከ፡ ዐሰሮ፨</l>
                  <l n="2">ለክርስቶስ፡ ሰላመ፡ ወተፋቅሮ፨</l>
                  <l n="3">አምጣነ፡ በጸጋ፡ ፈጸምከ፡ ወሰለጥከ፡ ግብሮ፨</l>
                  <l n="4">ለመጽሔተ፡ አቡሁ፡ ዘሠምሮ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
