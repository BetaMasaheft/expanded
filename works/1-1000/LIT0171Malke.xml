         <div type="edition" xml:lang="gez" xml:id="div2LIT0171Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለመለኮትከ፡ ዘአስተዳለወ፡ ስመ፨</l>
                  <l n="2">በእሳት፡ ወማይ፡ ድኅረ፡ ፈጠረ፡ ዓለመ፨</l>
                  <l n="3">እግዚአብሔር፡ አብ፡ ዘኢተአምር፡ ድካመ፨</l>
                  <l n="4">መድኃኔ፡ ዓለም፡ ወልድ፡ በቅድመ፡ ጲላጦስ፡ ቆመ፨</l>
                  <l n="5">ወበስቅለቱ፡ ቅድስት፡ ኀጢአተ፡ ዓለም፡ ሐተመ፨</l>
                  <l n="6">ኀጢአትየ፡ ኅትም፡ ወአዕጽፈኒ፡ ሰላመ፨</l>
                  <l n="7">ወመንፈስ፡ ቅዱስ፡ እሳት፡ አፍዕመኒ፡ ፍሕመ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለመለኮትከ፡ ዘሥዕርተ፡ ርእስ፡ አልቦቱ፨</l>
                  <l n="2">እስመ፡ ገባሬ፡ ርእስ፡ ዘሰብእ፡ ወዓለመ፡ ኵሉ፡ ውእቱ፨</l>
                  <l n="3">እግዚአብሔር፡ አሐዱ፡ ወበአካላት፡ ሠለስቱ፨</l>
                  <l n="4">ለእስራኤል፡ ዘአግባእኮ፡ ኀበ፡ ምድረ፡ ከነዓን፡ ርስቱ፨</l>
                  <l n="5">መድኃኔ፡ ዓለም፡ ወልድ፡ ማሕየዌ፡ ዓዸም፡ በሞቱ፨</l>
                  <l n="6">ወመንፈስ፡ ቅዱስ፡ ሐዋጼ፡ ትጉህ፡ ለለ፡ ዕለቱ፨</l>
                  <l n="7">ውሳጤ፡ ልብየ፡ ይብራህ፡ ወፍጡነ፡ ይኅቱ፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">ሰላም፡ ለመለኮትከ፡ እግዚአብሔር፡ ሕያው፨</l>
                  <l n="2">አንተ፡ ትሁብ፡ ወአንተ፡ ትፄውው፨</l>
                  <l n="3">መኑ፡ ከማከ፡ በውስተ፡ ኵሉ፡ ሕልው፨</l>
                  <l n="4">መድኃኔ፡ ዓለም፡ ወልድ፡ ለቤዛ፡ ዓዸም፡ ድልው፨</l>
                  <l n="5">በስህሐት፡ አሀሉ፡ ምስለ፡ ኅሩያን፡ አበው፨</l>
                  <l n="6">ፈኑ፡ ሊተ፡ መንፈስከ፡ ይጸልለኒ፡ በበድው፨</l>
                  <l n="7">እምተዐቅፎ፡ በብርሃን፡ ጽዕድው፨</l>
               </lg>
            </div>
         </div>
      </body>
      
