      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0154</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0154Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘትርጓሜሁ፡ ፍሥሓ፨</l>
                  <l n="2">ወዘይናዝዝ፡ ኵሎ፡ በዝየ፡ ወክሐ፨</l>
                  <l n="3">ዮሐንስ፡ ዘኮንከ፡ እምርስሐተ፡ ዓለም፡ ንጹሐ፨</l>
                  <l n="4">ጸሎትከ፡ ቅድመ፡ ፈጣሪ፡ ትኩነኒ፡ መርሐ፨</l>
                  <l n="5">እስመ፡ ጊዜ፡ ሞትየ፡ እፈርህ፡ ብዙኀ፨</l>
               </lg>
               <lg type="stanza" n="14">
                  <l n="1">ሰላም፡ ለቃልከ፡ እምድምፀ፡ መሰንቆ፡ ወዕንዚራ፨</l>
                  <l n="2">ዘጥዑም፡ ዜማሁ፡ ወጉህናሁ፡ ነከራ፨</l>
                  <l n="3">ንጹሐ፡ ምግባር፡ ዮሐንስ፡ ርእሰ፡ ምኔተ፡ ውራ፨</l>
                  <l n="4">ይጼልሉ፡ ክነፊሆሙ፡ ትጉሃነ፡ ሰማይ፡ ሐራ፨</l>
                  <l n="5">ላዕለ፡ ምኔትከ፡ ዘባቲ፡ መከራ፨</l>
               </lg>
               <lg type="stanza" n="50">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ መዝገበ፡ ባሕርይ፡ ዘቦቱ፨</l>
                  <l n="2">ባሕርይሰ፡ በድነ፡ ሥጋከ፡ ውእቱ፨</l>
                  <l n="3">ዮሐንስ፡ ዜናዊ፡ ምስጢረ፡ ፊደላት፡ ክልኤቱ፨</l>
                  <l n="4">አንበረኒ፡ በየማንከ፡ ጊዜ፡ ፀአተ፡ ነፍስ፡ እምዝንቱ፨</l>
                  <l n="5">እስመ፡ ንብረተዝ፡ ዓለም፡ የኀልፍ፡ በከንቱ፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">አምኃ፡ ሰላም፡ አቅረብኩ፡ ለፍልሰተ፡ ዐፅሙ፡ ወርእሱ፨</l>
                  <l n="2">ሜላተ፡ ብርሃን፡ ንጹሐ፡ እንዘ፡ ይለብሱ፨</l>
                  <l n="3">እምከርሠ፡ መቃብር፡ እሙቅ፡ ውስተ፡ ቤተ፡ ልዑል፡ መቅደሱ፨</l>
                  <l n="4">በኪዳንኪ፡ ማርያም፡ ሕይወተ፡ ሕሙማን፡ ኢያሱ፨</l>
                  <l n="5">በመንግሥተ፡ ሰማይ፡ አዕረፈት፡ ለዮሐንስ፡ ነፍሱ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ዮሐንስ፡ መስተጋድል፨</l>
                  <l n="2">ንጹሕ፡ ወድንግል፨</l>
                  <l n="3">ኀበ፡ እግዚእከ፡ አምላክ፡ ሰአሌ፡ ምሕረት፡ ወሣህል፨</l>
                  <l n="4">ጸሊ፡ ለደቂቅከ፡ ወባልሐነ፡ እምሀጕል፨</l>
                  <l n="5">እስመ፡ ጸሎትከ፡ አድኅኖ፡ ዘትክል፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለክሙ፡ ለዮሐንስ፡ አዕማዱ፨</l>
                  <l n="2">ለለ፡ አሐዱ፡ አሐዱ፨</l>
                  <l n="3">ባርኩነ፡ ዘልፈ፡ እንዘ፡ ትሰግዱ፨</l>
                  <l n="4">አብርሃም፡ ከመ፡ ባረኮ፡ ለይስሐቅ፡ ወልዱ፨</l>
                  <l n="5">እስመ፡ ቡራኬ፡ ለመምህር፡ ልማዱ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
