      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0103</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0103Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ አክሊለ፡ ዕበይ፡ ወግርማ፨</l>
                  <l n="2">እንተ፡ ተወፈየ፡ ቅድመ፡ እምእግዚአብሔር፡ ፌማ፨</l>
                  <l n="3">ገባሬ፡ ተኣምር፡ ወኀይል፡ ዕንቈ፡ ሥላሴ፡ ገሪማ፨</l>
                  <l n="4">አድኅነነ፡ ለደቂቅከ፡ እምክረ፡ በላዒ፡ መስቴማ፨</l>
                  <l n="5">በዲበ፡ ትእዛዝ፡ ዘይፈጥር፡ ጻማ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ አርአያ፡ በቀልት፡ እንበለ፡ ንትጋ፨</l>
                  <l n="2">ወለርእስከ፡ ጥሉል፡ በቅብአ፡ ሃይማኖት፡ ወጸጋ፨</l>
                  <l n="3">ዕንቈ፡ ሥላሴ፡ ጳውሎስ፡ ለጥበብ፡ ዘትዛወጋ፨</l>
                  <l n="4">አርፍቀነ፡ ለውሉድከ፡ ኀበ፡ ረሰዩ፡ እንግልጋ፨</l>
                  <l n="5">እለ፡ መነኑ፡ ለዓለም፡ ሥርዓታ፡ ወሕጋ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
   </text></TEI>