      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0125</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0125Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ ዘያስተፌሥሕ፡ አልባበ፨</l>
                  <l n="2">ወለሥዕርትኪ፡ ካዕበ፨</l>
                  <l n="3">ወለተ፡ እስራኤል፡ ያዕቆብ፡ ዘይሰመይ፡ ሕዝበ፨</l>
                  <l n="4">ይቤለኪ፡ ብእሴ፡ ጥበብ፡ በዘረከበ፡ ጥበበ፨</l>
                  <l n="5">እንዘ፡ ወለተ፡ ሰብእ፡ አንቲ፡ ትመስሊ፡ ርግበ፨</l>
               </lg>
               <lg type="stanza" n="15">
                  <l n="1">ሰላም፡ ለበድነ፡ ሥጋኪ፡ ዘገልበብዎ፡ ኄራን፨</l>
                  <l n="2">ወለግንዘትኪ፡ ፀሓይ፡ ለልብሰ፡ ብርሃን፡ ክዱን፨</l>
                  <l n="3">አመ፡ ጠፍዓት፡ ቅድመ፡ ወለተ፡ እስራኤል፡ ዐይን፨</l>
                  <l n="4">በደብረ፡ ጊዮርጊስ፡ ታቦር፡ እንተ፡ ስለሎ፡ ብርሃን፨</l>
                  <l n="5">ካህናት፡ ለሀዉ፡ ወበከዩ፡ ጻድቃን፨</l>
               </lg>
               <lg type="stanza" n="16">
                  <l n="1">ሰላም፡ ለመቃብርኪ፡ በደብረ፡ ቍስቋም፡ ዘኮነ፨</l>
                  <l n="2">ባሕረ፡ ዓቤል፡ ሞተ፡ ድኅረ፡ ሥጋኪ፡ መጠነ፨</l>
                  <l n="3">ወለተ፡ እስራኤል፡ ወይን፡ ዘታረስዒ፡ ኀዘነ፨</l>
                  <l n="4">አመ፡ ስብሐትኪ፡ ድኅረ፡ ሞትኪ፡ ሰፈነ፨</l>
                  <l n="5">አድባራተ፡ መልአ፡ ወምድረ፡ ከደነ፨</l>
               </lg>
               <lg type="stanza" n="17">
                  <l n="1">ናሁ፡ ፈጸምኩ፡ እምብዙኅ፡ በበ፡ ኅዳጥ፨</l>
                  <l n="2">ወድሶተ፡ መልክእኪ፡ __፡ ዘአፍአ፡ ወውስጥ፨</l>
                  <l n="3">__ረ፡ ልቡና፡ ሰብእ፡ ዘ_ኪ፡ ወለተ፡ እስራኤል፡ _ላጥ፨</l>
                  <l n="4">ባሕቱ፡ ኢይት__ም፡ እመ፡ ንሣየጥ፡ __ጥ</l>
                  <l n="5">ስብሐተ፡ መላእክት፡ ኵሎሙ፡ በብዙኅ፡ __ላጥ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
