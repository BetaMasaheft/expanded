      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0170</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0170Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ ዘመጽሐፈ፡ ሕይወት፡ ምስጢሩ፨</l>
                  <l n="2">በሰሌዳ፡ ብርሃን፡ ተጽሕፈ፡ ለሥዕለ፡ ኪሩብ፡ በአንጻሩ፨</l>
                  <l n="3">ሰማዕታተ፡ ክርስቶስ፡ መሲሕ፡ ለአካለ፡ ክርስቶስ፡ ማኅበሩ፨</l>
                  <l n="4">ሰራዊት፡ ምስሌክሙ፡ ውስተ፡ ደብረ፡ መዊዕ፡ ሠረሩ፨</l>
                  <l n="5">ወመንፍሥተ፡ ተድላ፡ ብዙኀ፡ በሰማይ፡ ገብሩ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ሰላም፡ ለመቃብሪክሙ፡ መላእክተ፡ ሰማይ፡ ኵሎሙ፨</l>
                  <l n="2">እንዘ፡ የዐቅቡ፡ ወትረ፡ ዘሕገ፡ ሰማዕታት፡ ፈጸሙ፨</l>
                  <l n="3">ሰማዕታተ፡ ክርስቶስ፡ መሲሕ፡ በፍቅረ፡ ማርያም፡ እሙ፨</l>
                  <l n="4">ተክዕወ፡ ደምክሙ፡ በከመ፡ ተክዕወ፡ ደሙ፨</l>
                  <l n="5">ለእግዚአብሔር፡ ሕያው፡ ዘዋሕድ፡ ስሙ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ለነባቤ፡ ዝንቱ፡ ድርሳን፡ ከመ፡ ኢይትርፍ፡ ጻማሁ፨</l>
                  <l n="2">ወዐስበ፡ ኑኀ፡ ዕድሜ፡ ይትወከፍ፡ መዝገበ፡ ኀጢአት፡ ሥጋሁ፨</l>
                  <l n="3">ሰማዕታተ፡ ክርስቶስ፡ መሲሕ፡ እምደምክሙ፡ ለሊሁ፨</l>
                  <l n="4">ወይድኀን፡ ጊዜ፡ ሐተታ፡ በምሕረተ፡ ክርስቶስ፡ ጸጋሁ፨</l>
                  <l n="5">እምገሀነማዊ፡ እሳት፡ ዘመፍርህ፡ ግርማሁ፨</l>
               </lg>
            </div>
         </div>
