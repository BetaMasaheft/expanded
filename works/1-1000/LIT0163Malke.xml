      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0163</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0163Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ሥላሴ፨</l>
                  <l n="2">ብሂልየ፡ ወጠንኩ፡ ዘመልክእከ፡ ውዳሴ፨</l>
                  <l n="3">ሐዋርያ፡ ክርስቶስ፡ ኤልያስ፡ ብሩሀ፡ ገጽ፡ ከመ፡ ሙሴ፨</l>
                  <l n="4">አብሐነ፡ ለአግብርቲከ፡ በርሱማሃ፡ ፈላሴ፨</l>
                  <l n="5">አርእስተ፡ አቃርብት፡ ንኪድ፡ ወንቀጥቅጥ፡ ከይሴ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ኀበ፡ ዐምደ፡ ወርቅ፡ ጽሩይ፨</l>
                  <l n="2">ዘጸሐፍዎ፡ ቅድመ፡ መላእክተ፡ ንጉሥ፡ ዐቢይ፨</l>
                  <l n="3">ሐዋርያ፡ ክርስቶስ፡ ጽዱል፡ እምዕንቈ፡ መረግድ፡ ኅሩይ፨</l>
                  <l n="4">አብርህ፡ ምድረ፡ ኅሊናየ፡ በጸሎትከ፡ ፀሓይ፨</l>
                  <l n="5">እስመ፡ ተገልበበ፡ በጽልመት፡ ጌጋይ፨</l>
               </lg>
               <lg type="stanza" n="7">
                  <l n="1">ሰላም፡ ለአእናፊከ፡ እለ፡ አጼነዋ፡ ዕጣነ፨</l>
                  <l n="2">ወለከናፍሪከ፡ ሰላም፡ እለ፡ ይመስላ፡ ሮማነ፨</l>
                  <l n="3">ሐዋርያ፡ ክርስቶስ፡ ወልዱ፡ ለመድኃኒነ፡ እግዚእ፡ አቡነ፨</l>
                  <l n="4">ኀበ፡ ማርያም፡ እግዝእተ፡ ኵሉ፡ አዘክር፡ ኪያነ፨</l>
                  <l n="5">ጸሎታ፡ ወበረከታ፡ የሀሉ፡ ምስሌነ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ሰላም፡ ለዕርገትከ፡ በሐዋዝ፡ ዜማ፨</l>
                  <l n="2">ኀበ፡ ምድር፡ ጽዕዱት፡ ዘብሔረ፡ ሕያዋን፡ ስማ፨</l>
                  <l n="3">ሐዋርያ፡ ክርስቶስ፡ ሕያው፡ ከመ፡ ሄኖክ፡ ወገሪማ፨</l>
                  <l n="4">አባ፡ አባ፡ ምሉአ፡ ሞገስ፡ ወግርማ፨</l>
                  <l n="5">በጸሎትከ፡ ሰደድኮ፡ ለመዊት፡ መስቴማ፨</l>
               </lg>
               <lg type="stanza" n="37">
                  <l n="1">ለዝንቱ፡ ቃለ፡ ማሕሌት፡ ወለዝንቱ፡ ድርሳን፨</l>
                  <l n="2">ለዘያነብቦ፡ በቃል፡ ወለዘይሰምዖ፡ በእዝን፨</l>
                  <l n="3">እግዚአብሔር፡ ይዕቀቦ፡ በዘሐዋርያ፡ ክርስቶስ፡ ኪዳን፨</l>
                  <l n="4">ዳዕሙ፡ ዘያሰትቶ፡ በልቡናሁ፡ ምኑን፨</l>
                  <l n="5">ከመ፡ ዳታን፡ ወአቤሮን፡ ይትኰነን፡ በደይን፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለከ፡ ቅድመ፡ መንበረ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ ሥላሴ፨</l>
                  <l n="2">ዘተዐጥን፡ ወትረ፡ በውዳሴ፨</l>
                  <l n="3">ሐዋርያ፡ ክርስቶስ፡ ምዑዘ፡ ቅዳሴ፨</l>
               </lg>
               <lg type="stanza" n="12">
                  <l n="1">ሰላም፡ ለከ፡ በኪዳንከ፡ ጽኑዕ፡ ወሕማምከ፡ ትሩፍ፨</l>
                  <l n="2">አባ፡ አባ፡ ስፉሐ፡ ክንፍ፨</l>
                  <l n="3">አኅልፈነ፡ ለነ፡ እምጸባብ፡ ምኅላፍ፨</l>
                  <l n="4">ዘሕጽርት፡ በእሳት፡ ወጽፍድ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
   </text></TEI>