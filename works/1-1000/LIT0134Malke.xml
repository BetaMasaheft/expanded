         <div type="edition" xml:lang="gez" xml:id="div2LIT0134Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትኪ፡ በሕገ፡ ሰብሳብ፡ ንጹሕ፨</l>
                  <l n="2">እምዘዮልያና፡ ቅድስት፡ በወርኀ፡ የካቲት፡ ወርኅ፨</l>
                  <l n="3">እግዚእ፡ ኀረያ፡ ብፅዕት፡ ምስለ፡ ጸጋ፡ ዘአብ፡ ፍሡሕ፨</l>
                  <l n="4">ዜና፡ ኂሩትኪ፡ በዝኀ፡ እመሥፈርተ፡ ንባብ፡ ዝኅዙኅ፨</l>
                  <l n="5">ወተኣምርኪ፡ እምኆፃ፡ ብዙኅ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ሰላም፡ ለተፈጥሮትኪ፡ ሥና፨</l>
                  <l n="2">እግዚአብሔር፡ አምላክ፡ በብዙኀ፡ ጥበብ፡ ዘመጠና፨</l>
                  <l n="3">እግዚእ፡ ኀረያ፡ ብፅዕት፡ ትምክህተ፡ ደቂቃ፡ ለዮልያና፨</l>
                  <l n="4">በገዳምኪ፡ ምድረ፡ ዞረሬ፡ ካልእተ፡ ደብረ፡ ሕግ፡ ዘሲና፨</l>
                  <l n="5">በእደ፡ ሚካኤክ፡ ሴስዪነ፡ አውሪደኪ፡ መና፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ በጸጋ፡ ሃይማኖት፡ ዘተረሰየ፨</l>
                  <l n="2">ምስለ፡ እምነ፡ ጽዮን፡ ቡርክት፡ እመ፡ ቀውስጦስ፡ አቡየ፨</l>
                  <l n="3">እግዚእ፡ ኀረያ፡ ስምኪ፡ እስመ፡ ጽጌ፡ ተስፋ፡ ጸገየ፨</l>
                  <l n="4">በምድረ፡ ዞረሬ፡ ከርሥኪ፡ ተክለ፡ ሃይማኖት፡ ሥርናየ፨</l>
                  <l n="5">አመከዐበ፡ ስሳ፡ ወምእተ፡ ፈረየ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ሰላም፡ ለመቃብርኪ፡ በደብረ፡ ዞረሬ፡ ስፍሕት፨</l>
                  <l n="2">አሜሃ፡ ለዘተገብረ፡ በእደ፡ ቅዱሳን፡ ካህናት፨</l>
                  <l n="3">እግዚእ፡ ኀረያ፡ ቡርክት፡ ወበቅድስና፡ ሥርጉት፨</l>
                  <l n="4">አምጣነ፡ አቅረብኩ፡ ለኪ፡ አምኃየ፡ አምኃ፡ ሥላሴ፡ ትሥልስት፨</l>
                  <l n="5">ወኢትትሐየዪኒ፡ ለኃጥእ፡ ገብርኪ፡ ትሑት፨</l>
               </lg>
               <lg type="stanza" n="33">
                  <l n="1">ይትአኰት፡ እግዚአብሔር፡ ለእግዚእ፡ ኀረያ፡ ዘኀረያ፨</l>
                  <l n="2">ወመዋርስቲሁ፡ ለዘረሰያ፨</l>
                  <l n="3">አምሳለ፡ ማርያም፡ ድንግል፡ ኪዳነ፡ ምሕረት፡ አወፈያ፨</l>
                  <l n="4">ኅብስተ፡ ሰማይ፡ መጠዋ፡ ሲሳያ፨</l>
                  <l n="5">ወተስፋ፡ መድኃኒት፡ ለኃጥኣን፡ ሰመያ፨</l>
               </lg>
               <lg type="stanza" n="34">
                  <l n="1">ሰላም፡ ሰላም፡ ለምድረ፡ ዞረሬ፡ ሕኑጽ፨</l>
                  <l n="2">እንበለ፡ ምንተኒ፡ ሕጸጽ፨</l>
                  <l n="3">እግዚእ፡ ኀረያ፡ ዕቀቢ፡ እግረ፡ ልቡናየ፡ እምዳኅጽ፨</l>
                  <l n="4">ወአለብውኒ፡ እግዝእትየ፡ አፍቅሮተ፡ አምላክ፡ ወቢጽ፨</l>
                  <l n="5">ከመ፡ ኢያዕቅፈኒ፡ ሊተ፡ ሐብለ፡ ሞት፡ ማእቀጽ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
