         <div type="edition" xml:lang="gez" xml:id="div2LIT0174Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምክሙ፡ ዘያስተፌሥሕ፡ ኅሊናሁ፨</l>
                  <l n="2">ለዘይጼውዕ፡ ስመክሙ፡ በጽድቅ፡ ወይትዌከል፡ ኪያሁ፨</l>
                  <l n="3">እንስሳውያን፡ ኪሩቤል፡ ለእግዚአብሔር፡ ሐራሁ፨</l>
                  <l n="4">አመ፡ እጼውዕ፡ ስመክሙ፡ ለረዲኦትየ፡ ትግሁ፨</l>
                  <l n="5">እስመ፡ ከመ፡ ኆፃ፡ ብዙኅ፡ አፅራርየ፡ ብዝኁ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለሥዕርተ፡ ርእስክሙ፡ ወለርእስክሙ፡ ግልቡብ፨</l>
                  <l n="2">በክንፈ፡ ነበልባል፡ ልሁብ፨</l>
                  <l n="3">እንስሳውያ፡ ኪሩቤል፡ መናብርቲሁ፡ ለአብ፨</l>
                  <l n="4">አመ፡ እጼውዕ፡ ስመክሙ፡ ለለ፡ ዕለታት፡ በበ፡ ምግብ፨</l>
                  <l n="5">አድኀን፡ በኀይልክሙ፡ እምአርዌ፡ ስሁብ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለቆምክሙ፡ ወለመልክእክሙ፡ ኵሎን፨</l>
                  <l n="2">ዘየዐውዶ፡ ብርሃን፨</l>
                  <l n="3">እንስሳውያን፡ ኪሩቤል፡ አዕማደ፡ ሐዲስ፡ ኪዳን፨</l>
                  <l n="4">ብጽሑኒ፡ ለተራድኦ፡ አመ፡ የኀልፍ፡ ዘመን፨</l>
                  <l n="5">ከመ፡ በላዕሌየ፡ ኢይጽናዕ፡ ሐዘን፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ናሁ፡ አቅረብኩ፡ ለዕበይክሙ፡ አምኃ፡ ስብሐት፡ ወዝማሬ፨</l>
                  <l n="2">አእላፍ፡ ካህናት፡ ኀበ፡ ቀደሱ፡ በኑባሬ፨</l>
                  <l n="3">አውያነ፡ ገዳም፡ ኪሩቤል፡ ምሉዐነ፡ ሰላም፡ ወፍሬ፨</l>
                  <l n="4">ፀርየ፡ ይግበር፡ በኀይልክሙ፡ ውስተ፡ ከርሠ፡ መሬት፡ ሥዋሬ፨</l>
                  <l n="5">አከም፡ አመ፡ ሙሴ፡ ነቢይ፡ አቤሮን፡ ወቆሬ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
