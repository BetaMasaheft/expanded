      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0136</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0136Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ አብ፡ አምላከ፡ አማልክት፡ ለሊሁ፨</l>
                  <l n="2">ወበስመ፡ ማርያም፡ ድንግል፡ እንተ፡ ተሳተፈት፡ ብዕለ፡ ጸጋሁ፨</l>
                  <l n="3">ውዳሴ፡ መልክእከ፡ እንብብ፡ ታዴዎስ፡ ለለ፡ ጽባሑ፨</l>
                  <l n="4">መሀረኒ፡ ሕገ፡ ጥበብ፡ ወአለብወኒ፡ ናሁ፨</l>
                  <l n="5">ከመ፡ ለወልዱ፡ ጥበበ፡ ይሜህር፡ አቡሁ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ በሰሌዳ፡ ሞገስ፡ ልኩእ፨</l>
                  <l n="2">ዘይትበፃዕ፡ ብፅዐ፡ በአፈ፡ መላእክት፡ ወሰብእ፨</l>
                  <l n="3">ምዑዘ፡ ምግባር፡ ታኤድዎስ፡ እምጽጌ፡ ረዳ፡ ወቅብእ፨</l>
                  <l n="4">ሤመከ፡ ወአልዐለከ፡ እግዚአብሔር፡ እግዚእ፨</l>
                  <l n="5">ወውዳሴ፡ ስምከ፡ መልአ፡ በዓለም፡ ርቡዕ፨</l>
               </lg>
               <lg type="stanza" n="26">
                  <l n="1">ሰላም፡ ለትንሣኤከ፡ እምነ፡ ዝኅርከ፡ ለዐውዳ፨</l>
                  <l n="2">ስመ፡ ባሕርያ፡ መሬት፡ እንተ፡ ትሴሰይ፡ እስከ፡ ትትወሐዳ፨</l>
                  <l n="3">አመ፡ ትመጽእ፡ ታዴዎስ፡ ምስለ፡ እግዚእከ፡ በዕለተ፡ ፍዳ፨</l>
                  <l n="4">ተዘኪረከ፡ ስምየ፡ ዘአቅረብኩ፡ ጋዳ፨</l>
                  <l n="5">ዐስበ፡ ሰላምየ፡ ፈኑ፡ እስመ፡ ብየ፡ ዕዳ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">አምኃ፡ ሰላም፡ አቅረብኩ፡ ለመልክእከ፡ መሠንየ፨</l>
                  <l n="2">እንተ፡ ኢታስተሐቅር፡ ቃለ፡ መጠነ፡ ክሂል፡ ዘብየ፨</l>
                  <l n="3">ተወኪፈከ፡ ዘንተ፡ ታዴዎስ፡ አቡየ፨</l>
                  <l n="4">ከመ፡ ተወክፈ፡ እግዚእከ፡ ጸሪቀ፡ መበለት፡ ሰኑየ፨</l>
                  <l n="5">እምጸጋከ፡ እንሣእ፡ ሀበኒ፡ ዐስብየ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
