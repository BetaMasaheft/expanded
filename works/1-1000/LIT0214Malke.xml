         <div type="edition" xml:lang="gez" xml:id="div2LIT0214Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ይትባረክ፡ እግዚአብሔር፡ ለባሕረ፡ ኤርትራ፡ ዘሠጠጣ፨</l>
                  <l n="2">እስራኤል፡ ወይሁዳ፡ ከመ፡ ይኅልፉ፡ በውስጣ፨</l>
                  <l n="3">በክቡር፡ ደሙ፡ ለነፍስየ፡ ተሣየጣ፨</l>
                  <l n="4">ካዕበኒ፡ በሰበነ፡ ርእሱ፡ ዘሦጣ፨</l>
                  <l n="5">ለማርያም፡ ንጽሕት፡ አፍአሃ፡ ወውስጣ፨</l>
               </lg>
               <lg type="stanza" n="13">
                  <l n="1">ይትባረክ፡ እግዚአብሔር፡ ዐመፃ፡ ዘአልቦ፨</l>
                  <l n="2">ለእጓለ፡ እመሕያው፡ አፈ፡ ወልሳነ፡ ዘወሀቦ፨</l>
                  <l n="3">ደብረ፡ ታቦርሃ፡ ደመናተ፡ ጽድቁ፡ ገልበቦ፨</l>
                  <l n="4">ለዝመጽሐፍ፡ ለለ፡ ጊዜ፡ አንበቦ፨</l>
                  <l n="5">ያስተባዝኅ፡ ሎቱ፡ ወያመክዕብ፡ ዐስቦ፨</l>
               </lg>
            </div>
         </div>
      </body>
