      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0121</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0121Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ይብዛኅክሙ፡ ውዳሴ፡ እስክንድር፡ መሲሕ፡ ሰሚዐ፡ ትጽሕቁ፨</l>
                  <l n="2">እስመ፡ መፍቀሬ፡ ሰብእ፡ ውእቱ፡ ወየዋህ፡ በሕቁ፨</l>
                  <l n="3">ወይበዝኅ፡ እምኆፃ፡ ባሕር፡ ኂሩቱ፡ ወጽድቁ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">በበይኑ፡ ወበጾታሁ፡ ለእስክንድር፡ መሲሕ፡ ከመ፡ እፈክር፡ ዜናሁ፨</l>
                  <l n="2">አንቀጸ፡ ልብየ፡ ጰራቅሊጦስ፡ አርኁ፨</l>
                  <l n="3">ወያዋኪ፡ በእንግድዓየ፡ ለሥነከ፡ በርሁ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ለሐ፡ ነገሥተ፡ ምድር፡ ሠለስቱ፡ እለ፡ በበ፡ መትልው፡ ዘሞቱ፨</l>
                  <l n="2">ጽልመተ፡ ሕሊና፡ ዘላሕ፡ እምአልባብ፡ ያኅቱ፨</l>
                  <l n="3">ለናኦድ፡ ሀብተ፡ መክፈልቱ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">ዝንቱ፡ ውእቱ፡ በከመ፡ ረከብኖ፡ ድልወ፡ እንዘ፡ ኪያሁ፡ ንሴፎ፨</l>
                  <l n="2">ሕይወተ፡ ሱራፌል፡ ተሳቲፎ፨</l>
                  <l n="3">እንዘ፡ እደ፡ ሞት፡ ኢይለክፎ፨</l>
                  <l n="4">ያርትዕ፡ ሃይማኖተ፡ ወይቀጥቅጥ፡ ግልፎ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
