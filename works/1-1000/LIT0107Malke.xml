         <div type="edition" xml:lang="gez" xml:id="div2LIT0107Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ ፀሓይ፡ እንተ፡ ይነብር፡ ሰማየ፨</l>
                  <l n="2">ወበስመ፡ ድንግል፡ ሰማይ፡ እንተ፡ ትጸውር፡ ፀሓየ፨</l>
                  <l n="3">ኣአኵተከ፡ ማትያስ፡ አባ፡ ወአቡየ፨</l>
                  <l n="4">ከመ፡ እንግር፡ ቅድመ፡ ኵሉ፡ ስመ፡ ዚአከ፡ ዐቢየ፨</l>
                  <l n="5">ተሠሀለኒ፡ ወሰምዐኒ፡ ለከ፡ ይብለከ፡ ልብየ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እምልበ፡ ጠቢባን፡ ዘተሰወረ፨</l>
                  <l n="2">ውስተ፡ አፈ፡ ደቂቅ፡ ትክሥት፡ ምሥጢረ፡ ሰብቲከ፡ ድኅረ፨</l>
                  <l n="3">እምክብረ፡ ኢያሱ፡ ማትያስ፡ እንተ፡ አፈድፈድከ፡ ክብረ፨</l>
                  <l n="4">ዘተፈትሐ፡ እግረ፡ ፀሓይ፡ በጸሎትከ፡ ተአሥረ፨</l>
                  <l n="5">ወእግረ፡ ኃንካሳን፡ እሱር፡ አርትዐ፡ ሐዊረ፨</l>
               </lg>
               <lg type="stanza" n="13">
                  <l n="1">ሰላም፡ ለዘባንከ፡ ሥርግወ፡ ጥብጣቤ፡ አነዳ፨</l>
                  <l n="2">ወለእንግድዓከ፡ ዘኮነ፡ ለርእስከ፡ አእምሮ፡ ሰሌዳ፨</l>
                  <l n="3">ዘተሳተፍከ፡ ማትያስ፡ ምስለ፡ ንቡረ፡ እድ፡ ሲኖዳ፨</l>
                  <l n="4">ተአየን፡ ምስለ፡ ዘዮና፡ ለደብረ፡ ጊዮርጊስ፡ በዐውዳ፨</l>
                  <l n="5">ንኡሰ፡ ወዐቢየ፡ ትባርክ፡ ውሉዳ፨</l>
               </lg>
               <lg type="stanza" n="24">
                  <l n="1">ሰላም፡ እብል፡ ለአጽፋረ፡ እግርከ፡ አፃብዕ፨</l>
                  <l n="2">ዘተቀጸላ፡ አጽፋረ፡ አክሊላተ፡ ብርሃን፡ ካልእ፨</l>
                  <l n="3">ወልደ፡ ነጐድጓድ፡ ማትያስ፡ ፍቁረ፡ እግዚእ፨</l>
                  <l n="4">ለድማኅ፡ ኢታንትግ፡ ጸልዮ፡ ለተከሥተ፡ ብርሃን፡ ብፁዕ፨</l>
                  <l n="5">እስመ፡ ደብተራሁ፡ አንተ፡ ተከላ፡ ለስምዕ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ በእደ፡ መላእክት፡ ኄራን፨</l>
                  <l n="2">ወለመቃብሪከ፡ በደብር፡ እንተ፡ ከለሎ፡ ብርሃን፨</l>
                  <l n="3">ሠያሜ፡ ካህናት፡ ማትያስ፡ ጽኑዐ፡ ሥልጣን፨</l>
                  <l n="4">እለ፡ ገብሩ፡ ተዝካረከ፡ አመ፡ ይመጽእ፡ መድኅን፨</l>
                  <l n="5">ይወርሱ፡ ዓለመ፡ ተስፋሆሙ፡ ለጻድቃን፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ሰላም፡ ለፍልሰተ፡ ዐፅምከ፡ ዘይኄይሎ፡ ጽዕዳዌ፨</l>
                  <l n="2">ወለትንሣኤከ፡ ዘይጸንሕ፡ እንተ፡ ይመጽእ፡ መርዓዌ፨</l>
                  <l n="3">መምህረ፡ ዓለም፡ ማትያስ፡ ዘአጥፋእከ፡ ግብረ፡ ምንታዌ፨</l>
                  <l n="4">አብጽሐነ፡ ውስተ፡ ሠናይ፡ እንበለ፡ ሕማም፡ ወደዌ፨</l>
                  <l n="5">በቲከከ፡ ኅምዘ፡ ኀይሉ፡ ለንስጥሮስ፡ አርዌ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ሰላም፡ ለበአትከ፡ ዐይነ፡ መልአከ፡ ሞት፡ ኀበ፡ ኢይርእያ፨</l>
                  <l n="2">መልአከ፡ ብርሃን፡ ማትያስ፡ ለደብረ፡ ድማኅ፡ ፀሓያ፨</l>
                  <l n="3">ለዕለተ፡ ሞትከ፡ ጽዮን፡ ቀዳሚ፡ ሰማዕት፡ ዘኀረያ፨</l>
                  <l n="4">በደሙ፡ ክቡር፡ ቀደሳ፡ ያዕቆብ፡ ሐዋርያ፨</l>
                  <l n="5">ወገሪማ፡ በዓለ፡ ሰመያ፨</l>
               </lg>
               <lg type="stanza" n="30">
                  <l n="1">አምኃ፡ ሰላም፡ አቅረብኩ፡ ስብሐተ፡ መልክእከ፡ በኍልቈ፡ ራብዕ፡ ሱባዔ፨</l>
                  <l n="2">ሀበኒ፡ አባ፡ ማትያስ፡ ተስፋ፡ ትንሣኤ፨</l>
                  <l n="3">ወበተአምኖ፡ ይንሥኡ፡ በረከተከ፡ በቋዔ፨</l>
                  <l n="4">ማኅበረ፡ ካህናት፡ ዘተጋብኡ፡ ውስተ፡ ድማኃዊት፡ ጉባኤ፨</l>
                  <l n="5">ኪያከ፡ ይጸውዑ፡ ዐርከ፡ ኪያከ፡ አባ፡ ኪያከ፡ መጋቤ፡ ወኪያከ፡ ረዳኤ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
