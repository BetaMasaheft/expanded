      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0167</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0167Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምኪ፡ ዘእምጸቃውዕ፡ ይጥዕም፨</l>
                  <l n="2">ለደቂቀ፡ አውያን፡ ወዘይት፡ እንበለ፡ መሥፈርት፡ ወዐቅም፨</l>
                  <l n="3">እንተ፡ ዕፍረት፡ ኅሪት፡ ዘኀረየኪ፡ ግሩም፨</l>
                  <l n="4">አድኅንኒ፡ እግዝእትየ፡ እምንሳዌ፡ ዝንቱ፡ ዓለም፨</l>
                  <l n="5">ዘበላዕሌሁ፡ ተሠልጡ፡ ዐመፃ፡ ወቂም፨</l>
               </lg>
               <lg type="stanza" n="19">
                  <l n="1">ሰላም፡ ሰላም፡ እብል፡ ለኵሎም፡ መልክኣትኪ፨</l>
                  <l n="2">ለለ፡ አሐዱ፡ አሐዱ፡ ውዱዳተ፡ ሥን፡ አባልኪ፨</l>
                  <l n="3">ጊዜ፡ ምግበ፡ ወንጌል፡ ሳምን፡ ምስካየ፡ ግፉዓን፡ ዘኮንኪ፨</l>
                  <l n="4">ብጽሒ፡ በኢጐንድዮ፡ ሶበ፡ እጼውዕ፡ ስመኪ፨</l>
                  <l n="5">ማርያም፡ እንተ፡ ዕፍረት፡ ኢይጽናዕ፡ ልብኪ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለእንተ፡ ዕፍረት፡ ዘዕፍረት፡ ሙዳይ፨</l>
                  <l n="2">እንተ፡ ዕፍረት፡ ማርያም፡ ዘኀጡአ፡ ትአስፋ፡ ምስካይ፨</l>
                  <l n="3">እንተ፡ ዕፍረት፡ ማርያም፡ እምልቡናኪ፡ ሰማይ፨</l>
                  <l n="4">ይረድ፡ ዲበ፡ ገበርኪ፡ ኪዳነ፡ ቃልኪ፡ ፀሓይ፨</l>
                  <l n="5">እስመ፡ ደመናት፡ ተሀጒሉ፡ ዐይነ፡ ልብ፡ ቅድመ፡ ኢይርአይ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ዘጸውዐ፡ ስመ፡ ዚአኪ፡ ለለ፡ ጊዜ፡ ጸባሕ፡ ወነግህ፨</l>
                  <l n="2">ኀጡአ፡ ተስፋ፡ ገብርኪ፡ እምጾታ፡ ሐዘን፡ ብዙኀ፨</l>
                  <l n="3">እንተ፡ ዕፍረት፡ ወይን፡ ጸዋሪተ፡ አስካል፡ ንጹሕ፨</l>
                  <l n="4">ያጽምዕ፡ እዝነ፡ ልብኪ፡ ወኪዳንኪ፡ ርኅሩኅ፨</l>
                  <l n="5">ዘከመ፡ አጽምዐ፡ ስእለቶ፡ አመ፡ አይኅ፡ ለኖኅ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
