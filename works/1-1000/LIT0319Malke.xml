         <div type="edition" xml:lang="gez" xml:id="div2LIT0319Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ ወለልደትከ፡ እማሕፀን፨</l>
                  <l n="2">ዳግማይ፡ ሰሎሞን፡ አበ፡ ጠቢባን፨</l>
                  <l n="3">ዘማርያም፡ ወልድከ፡ ወፍቅርከ፡ ምስኪን፨</l>
                  <l n="4">አስተበፅዐከ፡ በንባበ፡ ጽዱቅ፡ ልሳን፨</l>
                  <l n="5">ወእዌድሰከ፡ በኵሉ፡ ዘመን፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ በስመ፡ ማርያም፡ ልኩእ፨</l>
                  <l n="2">ወለሥዕርትከ፡ ጸሊም፡ ከመ፡ ሕብረ፡ ቋዕ፨</l>
                  <l n="3">ዘማርያም፡ ነቢይ፡ ወሐዋርያ፡ ካልእ፨</l>
                  <l n="4">ባርከኒ፡ ለፍቁርከ፡ በሥርዓተ፡ ተልሚድ፡ ወረድእ፨</l>
                  <l n="5">አርአየ፡ ባረከ፡ ኤልያስ፡ ለረድኡ፡ ኤልሳዕ፨</l>
               </lg>
               <lg type="stanza" n="4">
                  <l n="1">ሰላም፡ ለአዕይንቲከ፡ እለ፡ ነጸራ፡ ወርእያ፨</l>
                  <l n="2">በደሴተ፡ ዠንዳ፡ ተጽናስ፡ እንተ፡ ይእቲ፡ ቀጰዶቅያ፨</l>
                  <l n="3">ዘማርያም፡ ያዕቆብ፡ ዳግማይ፡ ሐዋርያ፨</l>
                  <l n="4">ዘመሐርከ፡ መስቀለ፡ ሞቱ፡ ለወልደ፡ ማርያም፡ ኬንያ፨</l>
                  <l n="5">አድባራት፡ በእንቲአከ፡ ብዙኀ፡ ተሐስያ፨</l>
               </lg>
               <lg type="stanza" n="22">
                  <l n="1">ሰላም፡ ሰላም፡ ለግንዘትከ፡ ሰላም፨</l>
                  <l n="2">ወለመቃብሪከ፡ ልኩእ፡ በአዕባነ፡ ጸሎት፡ ወጸም፨</l>
                  <l n="3">ዘማርያም፡ አጽንዖ፡ ለሰብእናየ፡ ድኩም፨</l>
                  <l n="4">ወመሐሮ፡ ግብረ፡ ምናኔ፡ እምአፀደ፡ ዝንቱ፡ ዓለም፨</l>
                  <l n="5">ከመ፡ ይርሳእ፡ ህላዌሁ፡ ዘሥጋ፡ ወደም፨</l>
               </lg>
            </div>
         </div>
