      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0135</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0135Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">በስመ፡ እግዚአብሔር፡ ሕያው፡ ንጉሠ፡ ወሥዩመ፨</l>
                  <l n="2">ዘበህላዌሁ፡ ይትአኰት፡ እምቅድመ፡ ይፍጥር፡ ዓለመ፨</l>
                  <l n="3">መዝገበ፡ ርኅራኄ፡ ታዴዎስ፡ እስመ፡ ታፈቅር፡ ሰላመ፨</l>
                  <l n="4">ከመ፡ እንግር፡ ኀይለ፡ ዚአከ፡ ወመንክረከ፡ መድምመ፨</l>
                  <l n="5">ዲበ፡ ረቀ፡ ልብየ፡ ጸሐፍ፡ ጸጋከ፡ ቀለመ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ለፅንሰትከ፡ በብሥራተ፡ መልአክ፡ ኪሩብ፨</l>
                  <l n="2">ወለልደትከ፡ ሰላም፡ እማሕፀነ፡ እምከ፡ ርግብ፨</l>
                  <l n="3">ታዴዎስ፡ ሳውል፡ ብርሃነ፡ አሕዛብ፡ ወሕዝብ፨</l>
                  <l n="4">ይምልኦ፡ ለእበድየ፡ ጸጋ፡ መንፈስ፡ ቅዱስ፡ ጥበብ፨</l>
                  <l n="5">ወማሕሌተ፡ ጽጌከ፡ ይቅስም፡ ልሳንየ፡ ንህብ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እንተ፡ ይጥዕም፡ ለአፍ፨</l>
                  <l n="2">ከመ፡ መዐር፡ ወሦከር፡ ዘወደሶሙ፡ መጽሐፍ፨</l>
                  <l n="3">ዕንቈ፡ ባሕርይ፡ ታዴዎስ፡ እጓለ፡ ማርያም፡ ሰደፍ፨</l>
                  <l n="4">ከመ፡ እንግር፡ ዜና፡ ዝክርከ፡ ውስተ፡ እዝነ፡ ኵሉ፡ አጽናፍ፨</l>
                  <l n="5">ላዕሌየ፡ ይኅድር፡ ጸጋከ፡ ትሩፍ፨</l>
               </lg>
               <lg type="stanza" n="53">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ እምቅድመ፡ ትኑም፡ ውስቴታ፨</l>
                  <l n="2">ኀበ፡ ይእቲ፡ በጻሕከ፡ በጸድፈ፡ ዐባይ፡ በታሕታ፨</l>
                  <l n="3">ሐዋርያ፡ ቃል፡ ታዴዎስ፡ በኀይለ፡ ጸሎትከ፡ ባሕቲታ፨</l>
                  <l n="4">አሐቲ፡ እኅትከ፡ ድኅረ፡ ተቀብረት፡ መዊታ፨</l>
                  <l n="5">ሕያውታ፡ ተንሥአት፡ ወለታ፨</l>
               </lg>
               <lg type="stanza" n="56">
                  <l n="1">ስብሐት፡ ይደሉ፡ ለማርያም፡ ዘጸገወተኒ፡ አፈ፨</l>
                  <l n="2">ቅድመ፡ ሰብእ፡ እንብብ፡ ዘውዳሴከ፡ መጽሐፈ፨</l>
                  <l n="3">ገራህተ፡ ሃይማኖት፡ ታዴዎስ፡ እንዘ፡ እጼውዐከ፡ ዘልፈ፨</l>
                  <l n="4">ዘርአ፡ ቃልየ፡ ዘበኀቤከ፡ ተገድፈ፨</l>
                  <l n="5">ይኩነኒ፡ ለወልድከ፡ ዘይፈሪ፡ አእላፈ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
