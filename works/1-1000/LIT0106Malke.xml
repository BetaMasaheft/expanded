      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0106</citedRange></bibl>
            </listBibl>
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0106Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">ጥበበ፡ ልቡና፡ ሀበኒ፡ ወጸግወኒ፡ ልሳነ፨</l>
                  <l n="2">ጰራቅሊጦስ፡ እንተ፡ ትጼሁ፡ አሜነ፨</l>
                  <l n="3">ላዕላዐ፡ ልሳን፡ ገብርከ፡ ከመ፡ እንብብ፡ አነ፨</l>
                  <l n="4">ሰላመ፡ መልክኡ፡ ለዘመድኅን፡ አቡነ፨</l>
                  <l n="5">ለዐቢይ፡ ወለንኡስ፡ መርሐ፡ ጽድቅ፡ ዘኮነ፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ሰላም፡ ሰላም፡ ለዝክረ፡ ስምከ፡ ቅዱስ፨</l>
                  <l n="2">ወለሥዕርትከ፡ ሰላም፡ በከተማ፡ ርእስ፨</l>
                  <l n="3">ዘመድኅን፡ አቡነ፡ ዘሐፀንከኒ፡ እምንእስ፨</l>
                  <l n="4">አንጽሐኒ፡ በጸሎትከ፡ ወቀድሰኒ፡ እምርኩስ፨</l>
                  <l n="5">ወምርሐኒ፡ ሊተ፡ ኀበ፡ ዘኀን፡ ወመርስ፨</l>
               </lg>
               <lg type="stanza" n="27">
                  <l n="1">ሰላም፡ ለትንሣኤከ፡ በዕለት፡ ደኃሪ፨</l>
                  <l n="2">በተልዕሎትከ፡ ላዕለ፡ ተልዕሎተ፡ ንስር፡ ሰራሪ፨</l>
                  <l n="3">ዘመድኅን፡ ጸሊ፡ ቀዊመከ፡ ቅድመ፡ ፈጣሪ፨</l>
                  <l n="4">ታንጽሐኒ፡ እምአበሳየ፡ ወጌጋይየ፡ ታስተስሪ፨</l>
                  <l n="5">እስመ፡ ርኅሩኀ፡ ልብ፡ ውእቱ፡ ወአምላክ፡ መሓሪ፨</l>
               </lg>
               <lg type="stanza" n="28">
                  <l n="1">ለምንት፡ ኀደገነ፡ ወመነንከነ፡ እስከ፡ ይእዜ፨</l>
                  <l n="2">ለውሉድከ፡ ኀዘን፡ ዘአስጠመነ፡ ከመ፡ ተከዜ፨</l>
                  <l n="3">እንዘ፡ ንብል፡ ከመዝ፡ ይሔውጸነ፡ ማእዜ፨</l>
                  <l n="4">ንበኪ፡ ለዕለቱ፡ እምጊዜ፡ ለጊዜ፨</l>
                  <l n="5">ኪያከ፡ አባ፡ ኪያከ፡ ናዛዜ፨</l>
               </lg>
               <lg type="stanza" n="29">
                  <l n="1">ኢይትርፍ፡ በከ፡ ለልሳንየ፡ ንባቡ፨</l>
                  <l n="2">በከመ፡ ይቤ፡ በትንቢት፡ ለሐሳብከ፡ ሐሳቡ፨</l>
                  <l n="3">ዘመድኅን፡ ገብሩ፡ ለእግዚአብሔር፡ ቅሩቡ፨</l>
                  <l n="4">እመ፡ ይዘሩ፡ ለነዳያን፡ እምነ፡ ዙኀ፡ መዝገቡ፨</l>
                  <l n="5">ከመ፡ ትዘከረኒ፡ ሊተ፡ በልብከ፡ ለቡ፨</l>
               </lg>
               <lg type="stanza" n="32">
                  <l n="1">ይትባረክ፡ እግዚአብሔር፡ በስፍሐ፡ ሰማዩ፡ ወምድሩ፨</l>
                  <l n="2">ወይትአኰት፡ ስሙ፡ በልሳነ፡ ኵሉ፡ ፍጡሩ፨</l>
                  <l n="3">ከመ፡ እትናገር፡ ኅዳጠ፡ አምጣነ፡ ብዙኀ፡ ምሥጢሩ፨</l>
                  <l n="4">ሰላመ፡ መልክኡ፡ ለዘመድኅን፡ ፍቁሩ፨</l>
                  <l n="5">ዘከሠተ፡ ሊተ፡ ለኃጥእ፡ ገብሩ፨</l>
               </lg>
            </div>
         </div>
      </body>
      
