      <body>
         <div type="bibliography">
            <listBibl type="editions">
               <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>0452</citedRange></bibl>
            </listBibl>
            
         </div>
         <div type="edition" xml:lang="gez" xml:id="div2LIT0452Malke">
            <div type="textpart" xml:id="malke">
               <lg type="stanza" n="1">
                  <l n="1">እግዚአብሔር፡ እግዚእ፡ ፈጣሬ፡ ኵሉ፡ ፍጥረት፨</l>
                  <l n="2">ከመ፡ ኣንብብ፡ ጥቀ፡ መልክአ፡ አግናጥዮስ፡ ሰማዕት፨</l>
                  <l n="3">ርድአኒ፡ ሊተ፡ ለፍቁርከ፡ ትሑት፨</l>
                  <l n="4">በእንተ፡ ማርያም፡ ድንግል፡ በቅድስና፡ ሥርጉት፨</l>
                  <l n="5">ወበእንተ፡ ቅዱሳን፡ አበው፡ ወዓዲ፡ መላእክት፨</l>
               </lg>
               <lg type="stanza" n="2">
                  <l n="1">ንዌድሰከ፡ በጸውዖ፡ ክቡረ፡ ስመከ፨</l>
                  <l n="2">በፍቅረ፡ ኢየሱስ፡ ክርስቶስ፡ እንተ፡ ከዐውከ፡ ደመከ፨</l>
                  <l n="3">አግናጥዮስ፡ ሰማዕት፡ ናስተበቍዐከ፨</l>
                  <l n="4">ወበኪዳንከ፡ ንቁም፡ ጥቃ፡ እግዚእከ፨</l>
                  <l n="5">ንትመሐፀን፡ ወትረ፡ ፍቁራን፡ ሕዝብከ፨</l>
               </lg>
               <lg type="stanza" n="3">
                  <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘተጽሕፈ፡ በሰማይ፨</l>
                  <l n="2">ሶበ፡ ተጋደልከ፡ በምድር፡ በስመ፡ አምላክ፡ አዶናይ፨</l>
                  <l n="3">አግናጥዮስ፡ ጥቡዕ፡ ለተወክፎ፡ ብዙኅ፡ ሥቃይ፨</l>
                  <l n="4">አዕድወኒ፡ ለፍቁርከ፡ እምባሕረ፡ እሳት፡ ዐባይ፨</l>
                  <l n="5">እስመ፡ መተንብል፡ አንተ፡ ለብእሲ፡ ጊጉይ፨</l>
               </lg>
               <lg type="stanza" n="50">
                  <l n="1">ሰላም፡ ለመቃብሪከ፡ ዘተቀብረ፡ ቦቱ፨</l>
                  <l n="2">ትራፈ፡ አናብስት፡ ዐፅምከ፡ እስከ፡ በትንሣኤ፡ ተሐቱ፨</l>
                  <l n="3">አግናጥዮስ፡ መምህር፡ ለእግዚአብሔር፡ ሰማዕቱ፨</l>
                  <l n="4">ዕቀበነ፡ ለውሉድከ፡ በኪዳንከ፡ ዝንቱ፨</l>
                  <l n="5">አዕርክተ፡ ዚአከ፡ ኢንጥፋእ፡ በከንቱ፨</l>
               </lg>
               <lg type="stanza" n="51">
                  <l n="1">ተወከፍ፡ አምኃየ፡ ዘአቅረብኩ፡ ለከ፨</l>
                  <l n="2">አግናጥዮስ፡ ቅዱስ፡ እንዘ፡ እጼውዕ፡ ስመከ፨</l>
                  <l n="3">እስመ፡ አገበረኒ፡ ሊተ፡ ምሉአ፡ በረከት፡ ገድልከ፨</l>
                  <l n="4">ወምስለ፡ ቅዱሳን፡ አበው፡ ነግሀ፡ ወሰርከ፨</l>
                  <l n="5">ለባርኮትየ፡ ነዓ፡ ለኃጥእ፡ ፍቁርከ፨</l>
               </lg>
            </div>
            <div type="textpart" xml:id="tarafa-malke">
               <lg type="stanza" n="1">
                  <l n="1">አምላከ፡ ምድር፡ ወሰማያት፡ አምላከ፡ ቅዱስ፡ አግናጥዮስ፡ ሰማዕት፨</l>
                  <l n="2">በእንተ፡ ስምከ፡ ዘሞተ፡ እንበለ፡ ፍርሀት፨</l>
                  <l n="3">ባርከነ፡ ለአግብርቲከ፡ በእንተ፡ ማርያም፡ ቅድስት፨</l>
                  <l n="4">እስመ፡ አንተ፡ አምላክነ፡ አቡሃ፡ ለምሕረት፨</l>
               </lg>
            </div>
         </div>
      </body>
