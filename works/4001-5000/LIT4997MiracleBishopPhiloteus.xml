                  <t:ab>
                     ወሀሎ፡ አሐዱ፡ ኤጲስ፡ ቆጶስ፡ <t:choice>
                        <t:corr resp="PRS6437Macomber">ኄር፡</t:corr>
                        <t:sic>ሐራ፡</t:sic>
                     </t:choice>
                     በኵሉ፡ ግብሩ፡ ወኢያደሉ፡ በመዋዕለ፡ ሢመቱ።
                  </t:ab>
               </t:div>
            </t:div>
