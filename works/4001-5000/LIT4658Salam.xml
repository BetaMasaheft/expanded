         <t:div type="edition" xml:id="div2LIT4658Salam">
            <t:note>The following text is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/BLorient590">London, British Library, BL Oriental 590</t:ref> with an emendation based on a reading from
               <t:ref type="mss" corresp="https://betamasaheft.eu/BAVet82">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 82</t:ref> in line 2.</t:note>
            <t:ab>
               <t:lg>
                  <t:l n="1">ሰላም፡ ለቤትከ፡ በሀገረ፡ ደናሕ፡ ዘቀደሳ።</t:l>
                  <t:l n="2">አርኬልላዖስ፡ ኤጲስ፡ <t:app><t:lem wit="#L">ቆጶስ፡ ዘብሔረ፡ ሱሳ።</t:lem><t:rdg wit="#V">ቆጶሳ።</t:rdg></t:app></t:l>
                  <t:l n="3">ገብርኤል፡ ሰባኬ፡ ምጽአተ፡ ክርስቶስ፡ አንበሳ።</t:l>
                  <t:l n="4">በዛቲ፡ በዓልከ፡ በዘይትሌዓል፡ ሞገሳ።</t:l>
                  <t:l n="5">በዓለ፡ ማርያም፡ አንበረ፡ ደቅስዮስ፡ በርእሳ።</t:l>
               </t:lg>
            </t:ab>
         </t:div>
