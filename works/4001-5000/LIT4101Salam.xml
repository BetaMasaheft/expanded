      <t:body>
         <t:div type="bibliography">
            
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:listBibl>
         </t:div>
         <t:div type="edition" xml:lang="gez" xml:id="div2LIT4101Salam">
            <t:div type="textpart" xml:id="malke">
               <t:lg type="stanza" n="1">
                  <t:l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ እምቅድመ፡ ኦርያሬስ፡ ሀላዊ፨</t:l>
                  <t:l n="2">እምሥርቀተ፡ ቤዝ፡ ጽባሓዊ፨</t:l>
                  <t:l n="3">ኢየሱስ፡ ክርስቶስ፡ ፍጹመ፡ ተሰብኦ፡ ናዝራዊ፨</t:l>
                  <t:l n="4">ግራህተ፡ ልብየ፡ በጠለ፡ መንፈስከ፡ አርዊ፨</t:l>
                  <t:l n="5">መሓልየ፡ ስምከ፡ በአፉገ፡ ያሕመልምል፡ ወይስዊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="2">
                  <t:l n="1">ሰላም፡ ለሕማምከ፡ ወልደ፡ እግዚአብሔር፡ ከሃሊ፨</t:l>
                  <t:l n="2">ለቤዝወ፡ ዓለም፡ ኵሉ፡ እምእደ፡ መስቴማ፡ ማህጐሊ፨</t:l>
                  <t:l n="3">ዐስየ፡ ሕይወት፡ እግዚእ፡ ላዙ፡ ኀቤከ፡ ይጼሊ፨</t:l>
                  <t:l n="4">ሕማመ፡ ሞትከ፡ ሶበ፡ ይዜከር፡ ወይሄሊ፨</t:l>
                  <t:l n="5">ውስተ፡ ዕመቀ፡ ብካይ፡ ወላሕ፡ ልብየ፡ ይቀሊ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="3">
                  <t:l n="1">ሰላም፡ ለእኅዝትከ፡ ኢየሱስ፡ ክርስቶስ፡ እግዚእነ፨</t:l>
                  <t:l n="2">በእደ፡ እብራዊ፡ ለሕማም፡ እምግብርናተ፡ ሞት፡ ታግዕዘነ፨</t:l>
                  <t:l n="3">እመሰ፡ በሥምረትከ፡ ኢኮነ፨</t:l>
                  <t:l n="4">አእዳወ፡ እብራዊ፡ ፍጡነ፨</t:l>
                  <t:l n="5">እምኮነ፡ አእባነ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="5">
                  <t:l n="1">ሰላም፡ ለሥዕርተ፡ ርእስከ፡ ለነፍኒፈ፡ ሌሊት፡ ምዕቃሉ፨</t:l>
                  <t:l n="2">ወከመ፡ ስኂን፡ አምሳሉ፨</t:l>
                  <t:l n="3">ኢየሱስ፡ ክርስቶስ፡ ለመዝራዕትከ፡ ከሃሌ፡ ኵሉ፨</t:l>
                  <t:l n="4">ገዳመ፡ መድበራ፡ አመ፡ ኤሉ፨</t:l>
                  <t:l n="5">ዘዐቀብኮሙ፡ ለእሉ፡ እፎኑመ፡ ዲበ፡ ዕፅ፡ ኪያከ፡ ሰቀሉ፨</t:l>
               </t:lg>
               <t:lg type="stanza" n="6">
                  <t:l n="1">ሰላም፡ ለከተማ፡ ርእስከ፡ ዘኰርእዎ፡ በህለት፡ ሶበ፡ ቀንኡ፨</t:l>
                  <t:l n="2">ለሄሮድስ፡ ማኅበረ፡ ሰብኡ፨</t:l>
                  <t:l n="3">ኢየሱስ፡ ክርስቶስ፡ ለእግዚአብሔር፡ በግዑ፨</t:l>
                  <t:l n="4">እምቤተ፡ ምቅናይ፡ እለ፡ ወእሉ፨</t:l>
                  <t:l n="5">ለመዝራእትከ፡ በጽንዑ፡ በበትረ፡ ሐለት</t:l>
               </t:lg>
               <t:lg type="stanza" n="99">
                  <t:l n="1"/>
               </t:lg>
            </t:div>
         </t:div>
         
         <t:div type="edition" xml:id="div3LIT4101Salam">
            <t:div type="textpart" subtype="incipit" xml:id="Incipit" xml:lang="gez">
               <t:ab> ሰላም፡ ለዝክረ፡ ስምከ፡ እምቅድመ፡ ኦርያሬስ፡ ሀላዊ። እምሥርቀተ፡ ቤዝ፡ ጽበሐዊ፡ ኢየሱስ፡ ክርስቶስ፡ ፍጹመ፡ ተሰብኦ፡ ናዝራዊ፡</t:ab>
            </t:div>
         </t:div>
      </t:body>
