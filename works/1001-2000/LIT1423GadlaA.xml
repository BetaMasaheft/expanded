            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/X2JEJBEJ"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Turaiev1908Aaron"/><title level="m">Vitae Sanctorum Indigenarum. II. Acta S. Aaronis et Philippi</title><title level="s">Corpus Scriptorum Christianorum Orientalium</title><author><t:forename>Boris</t:forename><t:surname>Turaiev</t:surname></author><pubPlace>Parisiis</pubPlace><publisher>E typographeo reipublicae</publisher><date>1908</date><series><t:title level="s">Corpus Scriptorum Christianorum Orientalium</t:title><t:biblScope unit="volume">Scriptores Aethiopici, II, 20</t:biblScope></series><biblScope unit="volume">Scriptores Aethiopici, II, 20</biblScope></t:bibl>
            </t:listBibl>
            <t:listBibl type="secondary">
               <t:bibl corresp="http://zotero.org/groups/358366/items/96GAXNWC"><seg type="encyclopediaArticle"><!-- attributes from original bibl--></seg><ptr target="bm:SamuelundRed2003Aron"/><title level="a">Aron of Däbrä Daret</title><title type="short">EAe</title><title level="m">Encyclopaedia Aethiopica</title><author><name>Samuel Wolde Yohannes</name></author><author><name>Red.</name></author><editor><forename>Siegbert</forename><surname>Uhlig</surname></editor><pubPlace>Wiesbaden</pubPlace><publisher>Harrassowitz Verlag</publisher><date>2003</date><biblScope unit="volume">I</biblScope><biblScope unit="page">350b-351a</biblScope><note type="tags"><note type="tag">bm:SamuelundRed2003Aron</note></note><note type="tag">bm:SamuelundRed2003Aron</note></t:bibl>
            </t:listBibl>
         </t:div>
         
            <t:div type="edition">
               <t:div type="textpart" subtype="chapter" n="1" xml:id="Prologue">
                  <t:label>Prologue</t:label>
                  <t:div type="textpart" subtype="incipit" xml:lang="gez" xml:id="Gadle">
                     <t:label>gadle</t:label>
                     <t:ab>
                       ዛቲ፡ መጽሐፍ፡ ገድለ፡ ጻማሆሙ፡ ለአቡነ፡ አሮን፡ መንክራዊ፡ ወዘከመ፡ ኀረያ፡ እግዚአብሔር፡ ለዳሬት፡ ደብር፡ ቅድስት፡
                     </t:ab>
                  </t:div>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="2" xml:id="MainPart">
                  <t:label>Main part</t:label>
                  <t:div type="textpart" subtype="incipit" xml:lang="gez">
                     <t:ab>
                        ስምዑ፡ <t:gap reason="omitted" extent="unknown"/> ዘኮነ፡ መካነ፡ ልደቱ፡ ለአሮን፡ <t:gap reason="omitted" extent="unknown"/> በሀገረ፡ 
                        ገብያ፡ ዘስማ፡ ሰጐዳ፡
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="explicit" xml:lang="gez">
                     <t:ab>
                        በኑዛዜ፡ ቃልከ፡ ይትረሥዕ፡ ኵሉ፡ ኀዘንነ። ወተፈጸመ፡ መዋዕለ፡ ለሁ፡ ለአባ፡ አሮን፡ መንክራዊ፡ በረከቱ፡ 
                        <t:gap reason="omitted" extent="unknown"/> አሜን።
                     </t:ab>
                  </t:div>
               </t:div>
               <t:div type="textpart" subtype="chapter" n="3" xml:id="Translatio">
                  <t:label>Translation of the body of the saint</t:label>
                     <t:listBibl type="clavis">
                        <t:bibl type="BHO" corresp="http://zotero.org/groups/358366/items/D9KQXSXB"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:BHO"/><title level="m">Bibliotheca hagiographica orientalis</title><title type="short">BHO</title><title level="s">Subsidia Hagiographica</title><author><t:name>Socii Bollandiani</t:name></author><pubPlace>Bruxellis–Beyrouth</pubPlace><publisher>Apoud Editores–Imprimerie Catholique</publisher><date>1910</date><series><t:title level="s">Subsidia Hagiographica</t:title><t:biblScope unit="volume">10</t:biblScope></series><biblScope unit="volume">10</biblScope><note type="url">https://archive.org/stream/bibliothecahagi00peet</note><t:citedRange unit="item">2</t:citedRange></t:bibl>
                     </t:listBibl>
                  <t:div type="textpart" subtype="incipit" xml:lang="gez" xml:id="Taamer">
                     <t:label>Miracle</t:label>
                     <t:ab>
                       ስምዑኬ፡ ንዜንወክሙ፡ ካዕበ፡ ኦአኃው፡ ኑኃ፡ መከራት፡ <t:gap reason="omitted" extent="unknown"/>  ለቅዱሳን፡ በደብረ፡ ዳሬት፡ ከመ፡ 
                        መሥገርት፡ ዘወረደት፡ ውስተ፡ ዓለም፡
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="explicit" xml:lang="gez">
                     <t:ab>
                         ወአብኡ፡ ንፍቀ፡ ሥጋሁ፡ ለመንክራዊ፡ አሮን፡ በክብር፡ ወበስብሐት፡ ወአንበርዋ፡ ለታቦቶሙ፡ ላዕለ፡ መቃብሪሁ፡ እስከ፡ ዮም፡ ወእስከ፡ 
                         ዛቲ፡ ዕለት፡<t:gap reason="omitted" extent="unknown"/> አሜን።
                     </t:ab>
                  </t:div>
                  <t:div type="textpart" subtype="Hymn" xml:lang="gez" xml:id="hymn">
                     <t:label>hymn</t:label>
                  </t:div>
               </t:div>
            </t:div>
         
      </t:body>
