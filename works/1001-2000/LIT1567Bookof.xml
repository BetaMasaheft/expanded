         <t:div type="edition" xml:lang="gez" xml:id="div1LIT1567Bookof">
            <t:note>Text of the EOTC printed Bible</t:note>
            <t:div type="textpart" subtype="chapter" n="1" xml:id="chapter1">
               <t:label>Chapter 1</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=1"/>ተረፈ፡ ዘርእየ፡ ዕንባቆም፡ ነቢይ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=2"/>እስከ፡ ማእዜኑ፡ እዚኦ፡ እኬልሕ፡ ወኢትሰምዕ፡ አአወዩ፡ እኬልሕ፡ ወኢትሰምዕ፡ አእወዩ፡ ኀቤከ፡ ተገፊእየ፡ ወኢታድኀን።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=3"/>አምንት፡ አርአይከኒ፡ ስራሐ፡ ወሕማመ፡ ከመ፡ አርአይ፡ ኀሳር፡ ወሕርትምና፡ ብቅድሜየ፡ ኮነ፡ ፍትሕ፡ ወመኮንንኒ፡ ይትሐለይ፡ ሕልያነ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=4"/>በእንተ፡ ዝንቱ፡ ዐለዉ፡ ህግ፡ ወኢይወ፡ ፅአ፡ ፍትሐ፡ ጽድቅ፡ እስመ፡ ይትዔገሎ፡ ኃጥእ፡ ለጻድቅ፡ በእንተ፡ ዝንቱ፡ ይወፅእ፡ ፍትሕ፡ ግፍቱዑ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=5"/>ርእዩኬ፡ እለ፡ ታስተሐቅሩ፡ ወነጽሩ፡ ወአንክሩ፡ መንክረ፡ ወትማስኑ፡ እስመ፡ ግብ፡ እገብር፡ አነ፡ በመዋዕሊክሙ፡ ዘኢተአምኑ፡ እመ፡ ነገሩክሙ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=6"/>ወናሁ፡ እፌኑ፡ ላዕሌክሙ፡ አነ፡ ፋርስሃ፡ ህዝበ፡ መሪራነ፡ ዋራዋድነ፡ እለ፡ የሐውሩ፡ በስፍሐ፡ ምድር፡ ከመ፡ ይረሰሱ፡ አብያተ፡ ዘኢኮነ፡ ዚአሆሙ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=7"/>ግሩም፡ ራእዩ፡ እምውስቴቶሙ፡ ይከውን፡ ፍትሑ፡ ወተረፋሂ፡ እምኔሁ፡ ይወፅእ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=8"/>ወይሰሩ፡ ከመ፡ ነምር፡ አፍራሲሆሙ፡ ወይበድሩ፡ እምተኲላተ፡ ዐረብ። ወይሩ፡ ከመ፡ ንስር፡ ዘይጐጒዕ፡ ለበሊዕ፡ ወይበጽሑ፡ እምርኁቅ፡ አፍራሲኖሙ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=9"/>ወይበጽሖሙ፡ ጥፍአት፡ ለኃጥኦን፡ እለ፡ ይትቃወሙ፡ ፍጽመ፡ ቅድመ፡ ገጾሙ፡ ወያስተጋብአኡ፡ ፄዋሆሙ፡ ከመ፡ ኖፃ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=10"/>ወውእቱሰ፡ ይንስ፡ ሎሙ፡ ወይፍግዕ፡ ላዕሆሙ፡ ወኃይላን፡ ተውኔቱ፡ ወይሣለቅ፡ ላዕለ፡ ኲሉ፡ አጽዋኒሆሙ፡ ወይደፍኖሙ፡ በመሬት፡ ወይእኀዞሙ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=11"/>ወእምዝ፡ ይመይጥ፡ መንፈሶ፡ ወየኀልፍ፡ ወያመስጥ፡ ለዛ፡ ኃይሉ፡ ለአምላኪየ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=12"/>አኮኑ፡ እንተ፡ ቀደምከ፡ እግዚኦ፡ አምላኪየ፡ ቅዱስ፡ ወኢንመውት፡ እግዚኦ፡ ለኲኔ፡ ሠራዕከሁ፡ ወተጠረኒ፡ ከመ፡ እዛለፍ፡ በተግሣጹ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=13"/>በዐይን፡ ንጹሕ፡ ኢይኔጽር፡ ውስተ፡ እይ፡ ወሕማም፡ ወጻዕር፡ ለምንት፡ ታረምም፡ እንዘ፡ ትሬእዩሙ፡ ለእለ፡ ያስተአክዩ፡ ወይውሕጦ፡ ኃጥእ፡ ለጻድቅ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=14"/>ወትሬስዩሙ፡ ለሰብእ፡ ከመ፡ ዓሣተ፡ ባሕር፡ ወከመ፡ አርዌ፡ ዘአልቦ፡ መኮንነ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=15"/>በመስገርቱ፡ አውፅአ፡ ያኃልቆ፡ ወሰሐቦ፡ በመርበብቱ፡ ወስተጋብኦ፡ በመስገርቱ፡ በእንተ፡ ዝንቱ፡ ይትፌስህ፡ ወይትኀሠይ፡ ልቡ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=16"/>በእንተ፡ ዝንቱ፡ ይሠውዕ፡ ለመስገርቱ፡ ወየዐጥን፡ ለመርበብቱ፡ ወኀሩይ፡ ሲሳዩ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=1&amp;verse=17"/>በእንተ፡ ዝንቱ፡ ይረብብ፡ መስገርቶ፡ ወዘልፈ፡ ይቀትሎሙ፡ ለአሕዛብ፡ ወኢይምሕኮሙ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="2" xml:id="chapter2">
               <t:label>Chapter 2</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=1"/>ወእቀውም፡ ውስተ፡ ምእቃብየ፡ ወአዐርግ፡ ዲበ፡ ኮኲሕ፡ ወአጾዕ፡ አአምሮ፡ ዘይነብበነኒ፡ በእግዚአብሔር፡ አወስኦ፡ ለዘይዛለፈኒ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=2"/>ወአውስአኒ፡ እግዚአብሔር፡ ወይቤለኒ፡ ጸሀፍ፡ ነገረ፡ ራዕይ፡ ውስተ፡ ሰሌዳ፡ ከመ፡ ያፍጥን፡ ዘያነብብ።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=3"/>እስመ፡ ዓዲሁ፡ ራእይ፡ በበዕድሜሁ፡ ወይሠርቅ፡ በማዕዶቱ፡ ወአኮ፡ ለከንቱ፡ ወአመኒ፡ በማዕዶቱ፡ ወአኮ፡ ለከንቱ። ወአመኒ፡ ጎንደየ፡ ጽንሖ፡ እስመ፡ ይመጽእ፡ ወይበጽሕ፡ ወኢይጎነዲ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=4"/>ወእመሰ፡ ተመይጠ፡ ኢትሠምር፡ ቦቱ፡ ነፍስየ፡ ጻድቅሰ፡ በአሚን፡ የሐዩ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=5"/>ወብእሲ፡ ነባቢ፡ ወመስተሐቅር፡ ኢየኀልፍ፡ ኢበምንትኒ፡ በከመ፡ አርሐበ፡ ኢበምንትኒ፡ በከመ፡ አርሐበ፡ ነፍሶ፡ ሲኦል፡ ወኢይጸግብ፡ ከመ፡ ሞት፡ ወያሰተጋብእ፡ ኀቤሁ፡ ኲሎሙ፡ አሕዛብ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=6"/>ዘንተ፡ ኲሎ፡ ይሜስሉ፡ ላዕሌሁ፡ ወይትናገሩ፡ ምሳሌሁ፡ ወይብሉ፡ አሌሎቱ፡ ለዘያስተጋብ፡ ዘኢኮነ፡ ዘዘአሀሁ፡ እስከ፡ ምንትኑ፡ ከብድ፡ ሎቱ፡ ጋለ፡ ዓቢየ።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=7"/>እስመ፡ ግብተ፡ ይትነሳእ፡ ወይነስኮ፡ ወይተግሁ፡ መመክርቲከ፡ ወትከውኖሙ፡ እንተ፡ ሕብልያ፡ ወየሐበልዩከ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=8"/>እስመ፡ አንተ፡ ሐብለይከ፡ ብዙኃነ፡ አሕዛበ፡ ወየሐበልዩከ፡ ኰሎሙ፡ አለ፡ ተርፈ፡ ሕዝብ፡ በእንተ፡ ደመ፡ ሰብእ፡ ወዓመፃ፡ አህጉር፡ ወበሐውርት፡ ወዘኲሎሙ፡ እለ፡ ይነብር፡ ውስቴታ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=9"/>አሌሎ፡ ለዜትዔገል፡ ትዕግልተ፡ እኩየ፡ ለቤቱ፡ ከመ፡ ስርር፡ ውስተ፡ አርም፡ እጎሊሁ፡ ከመ፡ ይፃእ፡ እምእደ፡ እኪያን።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=10"/>ወመከርከ፡ ኃሳረ፡ ለቤትከ፡ ወተዐደውከ፡ ብዙኀ፡ አሕዛበ፡ ወዐመፀት፡ ነፍስከ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=11"/>እስመ፡ እብንኒ፡ ትግዕር፡ እምውስተ፡ አረፍት፡ ወሦክ፡ ያወስእ፡ እምዕፅ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=12"/>አሌሎ፡ ለዘየሐንጽ፡ አህጉረ፡ በደም፡ ወያጸንዕ፡ አህጉረ፡ በዓመፃ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=13"/>ኢኮነኬ፡ ዝንቱ፡ እምኀበ፡ እግዚአብሔር፡ ዘኰሎ፡ ይመልክ፡ ወኀልቁቁ፡ በዙኃን፡ አህዛብ፡ በእሳት፡ ወተመንደቡ፡ በዙኃን፡ ህዝብ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=14"/>እስመ፡ መልአ፡ ኲሉ፡ ዓለመ፡ አእምሮ፡ ስብሐተ፡ እግዚአብሔር፡ ወይደፍኖሙ፡ ከመ፡ ማይ፡ ብዙኀ።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=15"/>ጦቤሎ፡ ለዜሰትዩ፡ ሌቢጹ፡ በዘይመውት፡ ወያሰክሮ፡ በዘየኀስር፡ ከመ፡ ይነጽር፡ ውስተ፡ በአታተ፡ ምሕራሞሙ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=16"/>ስቴ፡ ኃሳረ፡ ለክብርከ፡ ወርዌ፡ ወአንተሂ፡ ልብ፡ ረዓድ፡ ዋእንቀለቅል፡ እስመ፡ ዐገተከ፡ ጽዋዐ፡ የማኑ፡ ለእዚአብሔር፡ ወታገብእ፡ ኃሳረ፡ ላዕለ፡ ክብርክ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=17"/>እስመ፡ ርኲሰ፡ ሊባኖስ፡ ይደፍንከ፡ ወሕርትማነ፡ ወአርዌ፡ ገዳም፡ ያደንግፀከ፡ በእንተ፡ ከመ፡ ሰብእ፡ ወኃጢአተ፡ ብሔር፡ ወአህገር፡ ወኲሎሙ፡ እለ፡ ይነብር፡ ውስቴታ።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=18"/>ምንተ፡ ይበቊዕ፡ ገልፎ፡ መገለፋ፡ ወሰብኩ፡ ወገብሩ፡ ሐሰተምትሐተ፡ ዔን፡ ወይትአመኖ፡ ለገባሪሁ፡ በዘለ፡ ለሊሁ፡ ብረ፡ ከመ፡ ይግበር፡ ጣዖት፡ በሀመ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=19"/>አሌሎ፡ ለዘይቤሎ፡ ላዕፅ፡ ንቃህ፡ ወተንስእ፡ ወይቤሎ፡ ለእብን፡ ተለዐል፡ ወውርቅ፡ ወበብረር፡ ወአልቦ፡ ነፍሰ።</t:l>
                  <t:l n="20">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=2&amp;verse=20"/>ወእግዚአብሔርሰ፡ ውስተ፡ ጽርሐ፡ መቅደሱ፡ ወትፈርሆለ፡ ኲላ፡ ምድር፡ እምቅድመ፡ ገጹ።</t:l>
               </t:ab>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="3" xml:id="chapter3">
               <t:label>Chapter 3</t:label>
               <t:ab>
                  <t:l n="1">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=1"/>እግዚኦ፡ ሰማዕኩ፡ ድምጸከከ፡ ወፈራህኩ።</t:l>
                  <t:l n="2">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=2"/>ርኢኩ፡ ግብከ፡ ወአንከርኩ፡ በማእከለ፡ ክልኤ፡ ለእንስሳ፡ ርኢኩከ፡ ሶበ፡ ይቀርብ፡ ዐመቲሁ፡ አአምረከ፡ ወሶበሰ፡ ይበጽሕ፡ ጊዜሁ፡ እሌብወከ፡ ወሶበ፡ ትደነግጽ፡ ነፍስየ፡ እመንሱት፡ ተዘከረኒ፡ በምሕረት።</t:l>
                  <t:l n="3">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=3"/>እግዚአብሔርሰ፡ እምቴማን፡ ይመጽእ፡ ወቅዱስ፡ እምደብረ፡ ፋራን፡ ወእምአህገረ፡ ይሁዳ፡ ከደነ፡ ሰማያተ፡ ስኑ፡ ወመልአ፡ ምድረ፡ ስብሐቲሁ።</t:l>
                  <t:l n="4">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=4"/>ወፀዳሉኒ፡ ከመ፡ ብርሃን፡ ውእቱ፡ አቅርንት፡ ውስተ፡ እደዊሁ፡ ወረሰየ፡ ፍቁረ፡ በጽንዐ፡ ኃይሉ።</t:l>
                  <t:l n="5">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=5"/>ወየሐውር፡ ቃለ፡ ቅድመ፡ ገጹ፡ ወይወፅእ፡ ውስተ፡ ገዳም፡ እምድኅረ፡ እገሪሁ።</t:l>
                  <t:l n="6">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=6"/>ወሶበ፡ ቀውም፡ ታደለቀልቅ፡ ምድር፡ ወሶበ፡ ይኔጽር፡ ይትመሰዉ፡ አህዛብ። ወይትቀጠቀዉ፡ አድባር፡ በኃይሉ፡ ወይትመሰዉ፡ አውግር፡ ዘእምዓለም፡ ወፍኖቶሂ፡ ርኢኩ፡ ዝምዓለም።</t:l>
                  <t:l n="7">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=7"/>ወደምገፁ፡ አዕጻዳት፡ ኢትዮጵያ፡ ወማህደረ፡ ምድር፡ ምድያም፡ ይደነግፃ።</t:l>
                  <t:l n="8">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=8"/>ኢትትመዐዕ፡ ላዕለ፡ አፍላግ፡ እግዚኦ፡ ወኢይኩን፡ መዐትከ፡ ላእለ፡ እፍላግ፡ ወኢመቅሠፍትከ፡ ዲበ፡ አፍራሲከ፡ ወአፍራሲከኒ፡ መድኃኒት፡ ውእቱ።</t:l>
                  <t:l n="9">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=9"/>ወተርከ፡ ወወሰቀ፡ ቃስተከ፡ ዲበ፡ አብትር፡ ይቤ፡ እግዚአብሔር፡ ወይሠጥቅ፡ ምድረ፡ አፍላለግ።</t:l>
                  <t:l n="10">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=10"/>ይሬእዩከ፡ ወይፄዐሩ፡ አሕዛብ፡ ዋይዘሮማይ፡ በውስተ፡ ፍኖት፡ ወወሀበት፡ ቀላይ፡ ቃለ፡ ወአልዐለት፡ ግርማሃ።</t:l>
                  <t:l n="11">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=11"/>ተንስኡ፡ ፀሐይ፡ ወወርኀ፡ ወቆሙ፡ በስርዓትከ፡ በመብረቀ፡ አኅፃከ፡ የሐውሩ፡ ወበብርሃነ፡ መብረቀ፡ ወልታከ።</t:l>
                  <t:l n="12">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=12"/>በመዐትከ፡ ውሕደት፡ ምድር፡ ወታወረዶሙ፡ ለአሕዛብ፡ በመዐትከ።</t:l>
                  <t:l n="13">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=13"/>ወፃእከ፡ ታድኀኖሙ፡ ለሕዝብ፡ ከመ፡ ታድኀኖሙ፡ ለቅቡኦኒከ፡ ወወደይከ፡ ውስተ፡ አርእስቲሆሙ፡ ለኃጥኦን፡ ሞተ። ወንሳእከ፡ ማእሰረከ፡ እስከ፡ ክሳዶሙ።</t:l>
                  <t:l n="14">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=14"/>ወመተር፡ አርእስተ፡ ኃያላን፡ በድንጋፄ፡ ወያደለቀልቁ፡ ባቲ፡ ወያርኃው፡ ልጓማቲሆሙ፡ ከመ፡ ዜበልዕ፡ ነዳ፡ በጽምሚት።</t:l>
                  <t:l n="15">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=15"/>ወተጽዕን፡ አፍራሲከ፡ በውስተ፡ ባሕር፡ ወየሀውኩ፡ ማየ፡ ብዙኀ።</t:l>
                  <t:l n="16">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=16"/>ተዐቀብኩ፡ ወደንገፀኒ፡ ከርስየ፡ እምቃለ፡ ጸሎተ፡ ክናፍርየ፡ ወቦአ፡ ረዓድ፡ ውስተ፡ አዕጽምትየ፡ ወበመትሕት፡ አንቀልቀለ፡ ኃይልየ፡ ወአዐርፍ፡ በዕለተ፡ ምንዳቤየ፡ ከመ፡ እዕርግ፡ ውስተ፡ ሕዝብ፡ ዘፈለስ።</t:l>
                  <t:l n="17">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=17"/>እስመ፡ በለስኒ፡ ኢትፈሪ፡ ወአልቦ፡ ቀምሐ፡ ውስተ፡ ዐጸደ፡ ወይን፡ ወሐሰወት፡ ግብራ፡ ዘይት፡ ወራውህኒ፡ ኢይፈሪ፡ እክለ። ወተሐጒሉ፡ አባግዕ፡ አመብልዕ፡ አመብልዕ፡ ወአልህምትኒ፡ ኢይትረከቡ፡ በውስተ፡ ጎል።</t:l>
                  <t:l n="18">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=18"/>ወንሰ፡ ብግዚአብሔር፡ እትፌሣሕ፡ ወእትኀሠይ፡ በአምላኪየ፡ ወመድኃንየ።</t:l>
                  <t:l n="19">
                     <t:ref target="http://classic.net.bible.org/verse.php?book=Hab&amp;chapter=3&amp;verse=19"/>እግዚአብሔር፡ አምላኪየ፡ ወኃይየ፡ ዘያቀውሞን፡ ለእገርየ፡ ለዝሎፋ፡ ወያዐርገኒ፡ ውስተ፡ መልዕልት፡ ካማ፡ እማእ፡ እማኃልይሁ።</t:l>
               </t:ab>
            </t:div>
         </t:div>
      </t:body>
   </t:text></TEI>