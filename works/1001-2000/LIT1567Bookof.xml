         <t:listBibl type="editions">
            <t:bibl corresp="http://zotero.org/groups/358366/items/R28K3HG9"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Loefgren1930Jonanah"/><title level="m">Das äthiopische Dodekapropheton. Jona, Nahum, Habakuk, Zephanja, Haggai, Sacharja und Maleachi. Unter Zugrundelegung des Oxforder MS. Huntington 625 nach mehreren Handschriften</title><author><forename>Oscar</forename><surname>Löfgren</surname></author><pubPlace>Uppsala</pubPlace><publisher>Almqvist &amp; Wiksells Boktryckeri</publisher><date>1930</date><note type="tags"><note type="tag">BLorient501</note><note type="tag">Bible</note><note type="tag">Minor Prophets</note><note type="tag">Old Testament</note><note type="tag">bm:Loefgren1930Jonanah</note></note><note type="tag">BLorient501</note><note type="tag">Bible</note><note type="tag">Minor Prophets</note><note type="tag">Old Testament</note><note type="tag">bm:Loefgren1930Jonanah</note><t:citedRange unit="page">23-32</t:citedRange></t:bibl>
