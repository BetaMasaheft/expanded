it</item></list></desc><citeStructure unit="t:l" match="t:l" use="t:l"><desc><list><item>70</item><item>71</item><item>72</item></list></desc></citeStructure></citeStructure><citeStructure unit="incipit" match="t:div" use="t:div"><desc><list><item>incipit</item></list></desc></citeStructure></citeStructure><citeStructure unit="coretext" match="t:div" use="t:div"><desc><list><item>LukeGospel</item></list></desc><citeStructure unit="textsubunit" match="t:div" use="t:div"><desc><list><item>ch1</item><item>ch2</item><item>ch3</item><item>ch4</item><item>ch5</item><item>ch6</item><item>ch7</item><item>ch8</item><item>ch9</item><item>ch10</item><item>ch11</item><item>ch12</item><item>ch13</item><item>ch14</item><item>ch15</item><item>ch16</item><item>ch17</item><item>ch18</item><item>ch19</item><item>ch20</item><item>ch21</item></list></desc></citeStructure><citeStructure unit="explicit" match="t:div" use="t:div"><desc><list><item>explicit</item></list></desc></citeStructure><citeStructure unit="incipit" match="t:div" use="t:div"><desc><list><item>incipit</item></list></desc></citeStructure></citeStructure></citeStructure></citeStructure></refsDecl></encodingDesc>
