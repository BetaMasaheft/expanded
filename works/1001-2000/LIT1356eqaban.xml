            <t:div type="textpart" subtype="incipit" xml:lang="en" corresp="https://betamasaheft.eu/LIT1356eqaban#Incipit">
               <t:ab>
                  Oh my Lord Jesus Christ, protect me, for the sake of your dwelling
               </t:ab>
