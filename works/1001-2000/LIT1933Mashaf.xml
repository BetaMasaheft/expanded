        <t:div type="edition" xml:id="div2LIT1933Mashaf">
           <t:note>The following division into textparts follows <t:ref type="mss" corresp="https://betamasaheft.eu/BNFet110">Paris, Bibliothèque nationale de France, BnF Éthiopien 110</t:ref> and <t:ref type="mss" corresp="https://betamasaheft.eu/FSUor13">Frankfurt, Universitätsbibliothek Johann Christian Senckenberg, Frankfurt Ms. or. 13</t:ref>.</t:note>

           <t:div type="textpart" subtype="chapter" n="0" xml:id="Introduction">
               <t:label>Introduction followed by the table of the 63 rubrics and a short explanation by the translator on his methods.</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="1" xml:id="Chapter1">
               <t:label>On the work's subject</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="2" xml:id="Chapter2">
               <t:label>Introduction, on the necessity of knowing scripture</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="3" xml:id="Chapter3">
               <t:label>Summary of God's commandments, on suffering for the sake of
            virtue, on the unhappiness resulting from sinning, on good reputation,
            on false prophets and doctors</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="4" xml:id="Chapter4">
               <t:label>On the monastic life</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="5" xml:id="Chapter5">
               <t:label>On slaves</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="6" xml:id="Chapter6">
               <t:label>On the abandoning of the monastic life</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="7" xml:id="Chapter7">
               <t:label>On the necessity of keeping God's commandments without fear
            of others</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="8" xml:id="Chapter8">
               <t:label>On wrong and false doctors</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="9" xml:id="Chapter9">
               <t:label>On anger which can be righteous</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="10" xml:id="Chapter10">
               <t:label>On verbal injuries</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="11" xml:id="Chapter11">
               <t:label>On reconciliations</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="12" xml:id="Chapter12">
               <t:label>On fornication</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="13" xml:id="Chapter13">
               <t:label>On fornication, adultery, abduction of women etc.</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="14" xml:id="Chapter14">
               <t:label>On vows, lying and perjury</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="15" xml:id="Chapter15">
               <t:label>On retaliation, pardon, homicide</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="16" xml:id="Chapter16">
               <t:label>On simplicity, prudence and hability</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="17" xml:id="Chapter17">
               <t:label>On obedience</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="18" xml:id="Chapter18">
               <t:label>On the will</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="19" xml:id="Chapter19">
               <t:label>On carrying out good intentions</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="20" xml:id="Chapter20">
               <t:label>On alms</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="21" xml:id="Chapter21">
               <t:label>On the preference of giving to the poor than to the Church</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="22" xml:id="Chapter22">
               <t:label>On the use of wrongly earned money</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="23" xml:id="Chapter23">
               <t:label>On alms</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="24" xml:id="Chapter24">
               <t:label>On love and charity</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="25" xml:id="Chapter25">
               <t:label>That one should offend or hate noone.</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="26" xml:id="Chapter26">
               <t:label>That one should pray for everyone, and for apostates and heretics only
            during their lifetime and on the importance of charity towards everyone</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="27" xml:id="Chapter27">
               <t:label>On almsgiving in secret</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="28" xml:id="Chapter28">
               <t:label>On prayer</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="29" xml:id="Chapter29">
               <t:label>On the different kinds of prayers and offices of anachoretes </t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="30" xml:id="Chapter30">
               <t:label>On the different ways of prayer</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="31" xml:id="Chapter31">
               <t:label>On the conditions of effective prayer, the necessity of fleeing temptation,
            on hope, on the confessors and martyrs</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="32" xml:id="Chapter32">
               <t:label>One the uselessness of making others pray for oneself
            without working for one's own salvation, on the inefectiveness of baptism or the monastic
            life without personal sanctification, on the small number of the elected, on the mistake
            of those who pretend that God doesn't punish
         </t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="33" xml:id="Chapter33">
               <t:label>On the importance of pleasing God, not men and on God's
            judgement of intentions</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="34" xml:id="Chapter34">
               <t:label>On abandoning wordly goods and on monastic poverty</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="35" xml:id="Chapter35">
               <t:label>On poverty, remuneration of doctors and simony</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="36" xml:id="Chapter36">
               <t:label>On the relations between monks and the world</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="37" xml:id="Chapter37">
               <t:label>On the clothes and food which are suitable for monks, priests and laymen</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="38" xml:id="Chapter38">
               <t:label>On richness and poverty</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="39" xml:id="Chapter39">
               <t:label>That one should not judge others foolishly, that the one without sins should
            judge his subordinates, on the error of thinking that one should judge nobody</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="40" xml:id="Chapter40">
               <t:label>That one should not judge priests</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="41" xml:id="Chapter41">
               <t:label>On kingdom, tyranny and foreign domination</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="42" xml:id="Chapter42">
               <t:label>On God's judgement</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="43" xml:id="Chapter43">
               <t:label>On seers and visionaries</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="44" xml:id="Chapter44">
               <t:label>On the works</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="45" xml:id="Chapter45">
               <t:label>On the occuptaion of monks</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="46" xml:id="Chapter46">
               <t:label>On trading and the prohibition of trading inside Churches </t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="47" xml:id="Chapter47">
               <t:label>On the professions possible for laymen, on medicine and quacksalvers</t:label>
            </t:div>
            <t:div type="textpart" subtype="chapter" n="48" xml:id="Chapter48">
