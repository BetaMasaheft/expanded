                  <t:bibl corresp="http://zotero.org/groups/358366/items/WM9QTISH"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Nicoll1821Bodleianae"/><title level="m">Bibliothecae Bodleianae codicum manuscriptorum orientalium catalogi partis secundae volumen primum arabicos complectens</title><author><t:forename>Alexander</t:forename><t:surname>Nicoll</t:surname></author><pubPlace>Oxonii</pubPlace><publisher>E Typographeo Clarendoniano</publisher><date>1821</date><note type="url">https://books.google.de/books?id=37dJAAAAcAAJ&amp;printsec=frontcover&amp;hl=ar&amp;source=gbs_ge_summary_r&amp;cad=0#v=onepage&amp;q&amp;f=false</note><t:citedRange unit="page">17</t:citedRange></t:bibl>
                  <t:bibl corresp="http://zotero.org/groups/358366/items/Z22SPIBX"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Zuurmond1989EvangeliumMarc"/><title level="m">Novum Testamentum Aethiopice: The Synoptic Gospels&lt;hi rend="italics"&gt;, I–II:&lt;/hi&gt; General Introduction, Edition of the Gospel of Mark</title><title level="s">Äthiopistische Forschungen</title><author><t:forename>Rochus</t:forename><t:surname>Zuurmond</t:surname></author><editor><t:forename>Rochus</t:forename><t:surname>Zuurmond</t:surname></editor><pubPlace>Stuttgart</pubPlace><publisher>Franz Steiner Verlag Wiesbaden</publisher><date>1989</date><series><t:title level="s">Äthiopistische Forschungen</t:title><t:biblScope unit="volume">27</t:biblScope></series><biblScope unit="volume">27</biblScope><t:citedRange unit="page">22-23, 26-27, 29</t:citedRange></t:bibl>
