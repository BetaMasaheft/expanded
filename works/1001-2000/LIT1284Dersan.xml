         <t:div type="bibliography">
            
            <t:listBibl type="secondary">
               <t:bibl corresp="http://zotero.org/groups/358366/items/KBEJNK4A"><seg type="encyclopediaArticle"><!-- attributes from original bibl--></seg><ptr target="bm:Samuel2005EAEDersanaGabreel"/><title level="a">Dǝrsanä Gäbrǝʾel</title><title type="short">EAe</title><title level="m">Encyclopaedia Aethiopica</title><author><name>Samuel Yalew</name></author><editor><forename>Siegbert</forename><surname>Uhlig</surname></editor><pubPlace>Wiesbaden</pubPlace><publisher>Harrassowitz Verlag</publisher><date>2005</date><biblScope unit="volume">II</biblScope><biblScope unit="page">137b-138a</biblScope><note type="tags"><note type="tag">bm:Samuel2005EAEDersanaGabreel</note></note><note type="tag">bm:Samuel2005EAEDersanaGabreel</note></t:bibl>
            </t:listBibl>
         </t:div>
            
        <t:div type="edition" xml:lang="gez" xml:id="div2LIT1284Dersan">
           <t:note>The following subdivision is based on <t:ref type="mss" corresp="https://betamasaheft.eu/BAVet149">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 149</t:ref>, in which textparts follow a monthly 
              arrangement.</t:note>
           <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="Tahsas">
              <t:label xml:lang="en">Reading for the 19th of Tāḫśāś</t:label>
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="TahsasDana" corresp="https://betamasaheft.eu/LIT3955Homily">
                  <t:label xml:lang="en">Introduction concerning the building of the church of St Gabriel in Dana by Archelaus</t:label> 
               </t:div>       
           
              <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="MiracleSnake" corresp="https://betamasaheft.eu/LIT4654MiracleGa">
                 <t:label xml:lang="en">Miracle of the man who was bitten by a snake</t:label></t:div>
              <t:note>Included to both the monthly readings of Tāḫśāś and of Maggābit in <t:ref type="mss" corresp="https://betamasaheft.eu/BAVet149">Vatican City, Biblioteca Apostolica Vaticana, Aeth. 149</t:ref>.</t:note>
              
              <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="MiracleLabourer" corresp="https://betamasaheft.eu/LIT4655MiracleGa">
                  <t:label xml:lang="en">Miracle of the labourer whose foot was injured by a stone</t:label></t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="CommemorativeTahsas">
                  <t:label xml:lang="en">Commemorative note about the three youths in the furnace.</t:label>
                  <t:note>According to <t:bibl corresp="http://zotero.org/groups/358366/items/QZH8VYBF"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:GrebTiss1935Codices"/><title level="m">Bybliothecae apostolicae Vaticanae codices manu scripti recensiti iussu Pii XI Pontificis maximi. Codices Aethiopici Vaticani et Borgiani, Barberinianus orientalis 2, Rossianus 865&lt;hi rend="italics"&gt;, I:&lt;/hi&gt; Enarratio codicum</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><author><forename>Eugène</forename><surname>Tisserant</surname></author><pubPlace>Città del Vaticano</pubPlace><publisher>In Bybliotheca Vaticana</publisher><date>1935</date><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note><t:citedRange unit="page">575</t:citedRange></t:bibl>, the commemorative note is 
                     identical to <t:ref type="work" corresp="https://betamasaheft.eu/LIT1295Dersan#CommemorativeTahsas">Dǝrsāna Mikāʾel: Commemorative notice about
        the three youths in the furnace</t:ref>, but the Archangel who intervenes is Gabriel instead of Michael.</t:note>
               </t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="SalamTahsas" corresp="https://betamasaheft.eu/LIT6822SalamLakaAqabi">
                  <t:label xml:lang="en">Salām-hymn to you, keeper</t:label>
                  <t:note>According to <t:bibl corresp="http://zotero.org/groups/358366/items/QZH8VYBF"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:GrebTiss1935Codices"/><title level="m">Bybliothecae apostolicae Vaticanae codices manu scripti recensiti iussu Pii XI Pontificis maximi. Codices Aethiopici Vaticani et Borgiani, Barberinianus orientalis 2, Rossianus 865&lt;hi rend="italics"&gt;, I:&lt;/hi&gt; Enarratio codicum</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><author><forename>Eugène</forename><surname>Tisserant</surname></author><pubPlace>Città del Vaticano</pubPlace><publisher>In Bybliotheca Vaticana</publisher><date>1935</date><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note><t:citedRange unit="page">575</t:citedRange></t:bibl>, 
                     the <t:foreign xml:lang="gez">salām</t:foreign> is identical to <t:ref type="work" corresp="https://betamasaheft.eu/LIT1295Dersan#SalamTahsas">Dǝrsāna Mikāʾel: Salām to you Saints</t:ref>, but it is dedicated to the Archangel
                     Gabriel instead of Michael.</t:note>
               </t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="ConsecrationDana" corresp="https://betamasaheft.eu/LIT7717Consecra">
                  <t:label xml:lang="en">On the consecration of the church of St Gabriel in Dana</t:label></t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="Annunciation" corresp="https://betamasaheft.eu/LIT4035SenkessarDL#Tahs19Gabriel">
                  <t:label xml:lang="en">On the institution of the feast of the Annunciation</t:label>
                  <t:note>According to <t:bibl corresp="http://zotero.org/groups/358366/items/QZH8VYBF"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:GrebTiss1935Codices"/><title level="m">Bybliothecae apostolicae Vaticanae codices manu scripti recensiti iussu Pii XI Pontificis maximi. Codices Aethiopici Vaticani et Borgiani, Barberinianus orientalis 2, Rossianus 865&lt;hi rend="italics"&gt;, I:&lt;/hi&gt; Enarratio codicum</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><author><forename>Eugène</forename><surname>Tisserant</surname></author><pubPlace>Città del Vaticano</pubPlace><publisher>In Bybliotheca Vaticana</publisher><date>1935</date><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note><t:citedRange unit="page">575</t:citedRange></t:bibl>, 
                     the note corresponds to <t:ref type="work" corresp="https://betamasaheft.eu/LIT4035SenkessarDL#Tahs19Gabriel">Sǝnkǝsār (Second revision, Dabra Libānos
        recension): Commemoration of Gabriel</t:ref>.</t:note>                  
               </t:div>
           </t:div>
           
           <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="Terr">
              <t:label>Reading for the 19th of Ṭǝrr</t:label>
              <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="HomilyZechariah" corresp="https://betamasaheft.eu/LIT7718HomilyGab">
                 <t:label xml:lang="en">Homily on the annunciation of the Archangel Gabriel to Zechariah, father of John the Baptist.</t:label></t:div>
              <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="MiracleBuilding" corresp="https://betamasaheft.eu/LIT4656MiracleGa">
                 <t:label xml:lang="en">Miracle of the building of the columns of the altar dedicated to St Gabriel</t:label></t:div>
            
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="AppearanceEvagrius">
                  <t:label xml:lang="en">Commemorative note on St Gabriel’s appearance to Evagrius</t:label></t:div>                  
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="SalamTerr" corresp="https://betamasaheft.eu/LIT7719SalamGa"> 
                  <t:label xml:lang="en">Salām-hymn</t:label></t:div>
           </t:div>
            
            
           <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="Yakkatit">
              <t:label>Reading for the 19th of Yakkātit</t:label>
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="HomilyIncarnation" corresp="https://betamasaheft.eu/LIT7720HomilyGab"> 
                  
                  <t:label xml:lang="en">Homily on the Incarnation</t:label></t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="MiraclePreeminence" corresp="https://betamasaheft.eu/LIT7721MGPreeminence">
                  <t:label xml:lang="en">Miracle on the preeminence of St Gabriel</t:label></t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="DeathPaphnutius">
                  <t:label xml:lang="en">Commemorative note on the death of St Paphnutius and the appearance of the Archangel Gabriel.</t:label></t:div>
           
               <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="SalamYakkatit" corresp="https://betamasaheft.eu/LIT7722SalamPaph">
                  <t:label xml:lang="en">Salām-hymn in honour of Paphnutius</t:label></t:div>
           </t:div>
           
           
           <t:div type="textpart" subtype="chapter" xml:lang="gez" xml:id="Maggabit">
              <t:label>Reading for the 19th of Maggābit</t:label>
