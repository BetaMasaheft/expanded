         <t:div type="bibliography">
            <t:listBibl type="editions">
               <t:bibl corresp="http://zotero.org/groups/358366/items/R28K3HG9"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Loefgren1930Jonanah"/><title level="m">Das äthiopische Dodekapropheton. Jona, Nahum, Habakuk, Zephanja, Haggai, Sacharja und Maleachi. Unter Zugrundelegung des Oxforder MS. Huntington 625 nach mehreren Handschriften</title><author><t:forename>Oscar</t:forename><t:surname>Löfgren</t:surname></author><pubPlace>Uppsala</pubPlace><publisher>Almqvist &amp; Wiksells Boktryckeri</publisher><date>1930</date><t:citedRange unit="page">3-9</t:citedRange></t:bibl>
