               <t:label>Sixteen "seas" (<t:foreign xml:lang="gez">ባሕር፡</t:foreign>), each containing 16 sentences as a response to the previous questions</t:label>
               <t:note>The division in textparts is taken from 
                  <t:bibl corresp="http://zotero.org/groups/358366/items/IHD4VC4U"><seg type="journalArticle"><!-- attributes from original bibl--></seg><ptr target="bm:ContiRossini1941AwdaNagast"/><title level="a">Lo ʿawda nagast scritto divinatorio etiopico</title><title level="j">Rassegna di Studi Etiopici</title><author><forename>Carlo</forename><surname>Conti Rossini</surname></author><date>1941</date><biblScope unit="volume">1</biblScope><biblScope unit="issue">2</biblScope><biblScope unit="page">127-145</biblScope><note type="url">http://www.jstor.org/stable/41460166</note><note type="tags"><note type="tag">Divination</note><note type="tag">bm:ContiRossini1941AwdaNagast</note></note><note type="tag">Divination</note><note type="tag">bm:ContiRossini1941AwdaNagast</note><t:citedRange unit="page">131</t:citedRange></t:bibl>.
                  The Ethiopic titles of textparts are taken from <t:ref type="mss" corresp="https://betamasaheft.eu/BLorient12034">London, British Library, BL Oriental 12034</t:ref> according to the description in
                  <t:bibl corresp="http://zotero.org/groups/358366/items/RSEA4WPK"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:Strelcyn1978BritishLibrary"/><title level="m">Catalogue of Ethiopian Manuscripts in the British Library Acquired Since the Year 1877</title><author><forename>Stefan</forename><surname>Strelcyn</surname></author><pubPlace>London</pubPlace><publisher>Published by British Museum Publications for the British Library</publisher><date>1978</date><note type="tags"><note type="tag">British Museum</note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:Strelcyn1978BritishLibrary</note></note><note type="tag">British Museum</note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:Strelcyn1978BritishLibrary</note><t:citedRange unit="item">98,20</t:citedRange><t:citedRange unit="page">146</t:citedRange></t:bibl>.</t:note>
               <t:div type="textpart" subtype="chapter" xml:id="Intro">
                  <t:note>The following incipit is taken from <t:ref type="mss" corresp="https://betamasaheft.eu/BAVet119">Vatican City, Biblioteca Apostolica Vaticana, Aeth.119</t:ref> according to
                     <t:bibl corresp="http://zotero.org/groups/358366/items/QZH8VYBF"><seg type="book"><!-- attributes from original bibl--></seg><ptr target="bm:GrebTiss1935Codices"/><title level="m">Bybliothecae apostolicae Vaticanae codices manu scripti recensiti iussu Pii XI Pontificis maximi. Codices Aethiopici Vaticani et Borgiani, Barberinianus orientalis 2, Rossianus 865&lt;hi rend="italics"&gt;, I:&lt;/hi&gt; Enarratio codicum</title><author><forename>Sylvain</forename><surname>Grébaut</surname></author><author><forename>Eugène</forename><surname>Tisserant</surname></author><pubPlace>Città del Vaticano</pubPlace><publisher>In Bybliotheca Vaticana</publisher><date>1935</date><note type="tags"><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note></note><note type="tag">Cataloguing</note><note type="tag">Ethiopic</note><note type="tag">bm:GrebTiss1935Codices</note><t:citedRange unit="page">480</t:citedRange></t:bibl>.</t:note>
                  <t:ab>
                     በስመ፡ አብ፡ <t:gap reason="ellipsis"/> ፩ አምላክ፡ መሐሪ፡ ወመስተሣህል፡ ዘተናገረ፡ ፩ ጠቢ<t:surplus>ቢ</t:surplus>ብ፡ እምነ፡ ብዙኃን፡ ጠቢባን፡ ወፈላስፋውያን፡
                     ዘንተ፡ ዘስሙ፡ መጽሐፈ፡ ምክር፡ ለአበው፡  <t:sic>ቀደመት፡</t:sic> ከመ፡ ያእምሩ፡ በቱ፡ በዝ፡ እምሂ፡ ሠናየ፡ ወዕመሂ፡ እኩየ፡
                     ሰብአ፡ ዓለም፡ ለለርእሶሙ፡ ውእቱ፡ ፩ በኃሢሠ፡ መፍቅድ፡ ሐቲት፡ ፪ ሐቲት፡ በነጊደ፡ ንዋይ፡ ፫ ሐቲት፡ 
                     <t:supplied reason="omitted">በ</t:supplied>በዊዓ፡ ቤተ፡ ንጉሥ፡ <t:supplied reason="omitted"/> ፩ <t:del rend="expunctuated">ባሕረ፡ ፃና</t:del>
                     ፩ በኃሢሠ፡ መፍቅድ፡ ናሁ<t:supplied reason="omitted">፡</t:supplied> መጽአ፡ ለከ፡ ሠናይ፡ ዘያስተፌሥሕ፡ ልበከ፡ ብስራት፡ ለከ፡ እስመ፡ ይትፌጸም፡ ጻሕቅከ፡ 
                     <t:gap reason="ellipsis"/>
                  </t:ab>
