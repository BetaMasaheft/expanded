            <div type="bibliography">
                <listBibl type="editions">
                    <bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note><citedRange>7744</citedRange></bibl>
                </listBibl>
                
            </div>
            <div type="edition" xml:lang="gez" xml:id="div2LIT7744SebhataMasqal">

                <div type="textpart" xml:id="malke">
                
                    <lg type="stanza" n="1">
                        
                        <l n="1">እንዘ፡ ኣኀትም፡ ገጽየ፡ ለመስቀልከ፡ በማሕተሙ፨</l>
                        <l n="2">ተዝካረ፡ ማሕሌት፡ እጽሕፍ፡ ዘስብሐተ፡ መስቀል፡ ስሙ፨</l>
                        <l n="3">ወስከኒ፡ ክርስቶስ፡ ኀይለ፡ አእምሮትከ፡ ለለ፡ ጌሠሙ፨</l>
                        <l n="4">ወምልአኒ፡ መንፈሰ፡ ጽድቅ፡ ዘኢየሐጽጽ፡ ሰላሙ፨</l>
                        <l n="5">ከመ፡ ኢይምአኒ፡ ለሥጋየ፡ ድካሙ፨</l>

                    </lg>
                    
                    <lg type="stanza" n="2">
                        
                        <l n="1">ናሁ፡ አኀዝኩ፡ ከመ፡ እትናገር፡ ዕበዮ፨</l>
                        <l n="2">ለዕፀ፡ መስቀልከ፡ ክቡር፡ ዘተተክለ፡ በቀራንዮ፨</l>
                        <l n="3">ኢየሱስ፡ ክርስቶስ፡ ፈጻሜ፡ አምሳል፡ ወተነብዮ፨</l>
                        <l n="4">ቶስሕ፡ በላዕሌየ፡ ለመንፈስከ፡ ዋዕዮ፨</l>
                        <l n="5">ዘያቀሊ፡ ልበ፡ ወይዔምቅ፡ ኀልዮ፨</l>

                    </lg>
                    
                    <lg type="stanza" n="24">
                        
                        <l n="1">ኦዘዐርገ፡ ሰማያተ፡ ምስለ፡ ቃለ፡ ስብሐት፡ ወውዋዔ፨</l>
                        <l n="2">ፄዊወከ፡ ፄዋ፡ በመስቀለ፡ ሞትከ፡ ቅድመ፡ ጉባኤ፨</l>
                        <l n="3">በዓለ፡ ገራህይት፡ ክርስቶስ፡ መበይነ፡ ክርዳድ፡ በመስዔ፨</l>
                        <l n="4">አስተጋብእ፡ በሙዳይከ፡ አምሳለ፡ <choice><sic>ጸራቅ፡</sic><corr resp="AD">ጸራይቅ፡</corr></choice> ክልኤ፨</l>
                        <l n="5">ኍልቈ፡ ማሕሌትየ፡ ዘኀምስ፡ ሱባዔ፨</l>

                    </lg>
                    
                    <lg type="stanza" n="25">
                        
                        <l n="1">ኦዘፈኖከ፡ መንፈሰከ፡ ናዛዜ፨</l>
                        <l n="2">ኀበ፡ ሐዋርያት፡ ሀለዉ፡ ውሣጤ፡ ጽርሐ፡ ጽዮን፡ ምስለ፡ እንባዜ፨</l>
                        <l n="3">እስመ፡ መልአ፡ ክርስቶስ፡ ስብሐተ፡ መስቀልከ፡ ማየ፡ ተከዜ፨</l>
                        <l n="4">ተውላጠ፡ ዝንቱ፡ ስብሐት፡ እንበለ፡ ታጐንዲ፡ ጊዜ፨</l>
                        <l n="5">ፈንዎተ፡ ጸጋከ፡ ሊተ፡ አስተፋጥን፡ ይእዜ፨</l>

                    </lg>
                
                </div>
                
            </div>

