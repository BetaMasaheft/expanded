                </listRelation></standOff><text>
        <body>
            <div type="edition" xml:lang="gez" xml:id="div1LIT7641MalkeaYohannes">
                <div type="textpart" xml:id="malke">
                <lg type="stanza" n="1">
                <l n="1">በስመ፡ እግዚአብሔር፡ እምቅድመ፡ ዓለም፡ እምኀበ፡ ኢሀሎ፡ ኀበ፡ ሀልዎ፨</l>
                <l n="2">ወኵሎ፡ ፍጥረተ፡ ዘፈጠረ፡ በኢጻምዎ፨</l>
                <l n="3">ምሥጢረ፡ ውዳሴከ፡ እክሥት፡ ሶበ፡ ኀጣእኩ፡ ለብዎ፨</l>
                <l n="4">ነዓ፡ ዮሐንስ፡ ዜናዊ፡ ተዜንወኒ፡ ዜንዎ፨</l>
                <l n="5">ወእመ፡ አኮ፡ ያለብወኒ፡ ለፉጊር፡ ፈንዎ፨</l>
                </lg>
                <lg type="stanza" n="2">
                <l n="1">ሰላም፡ ለፅንሰትከ፡ በከመ፡ ሥርዓት፡ ዘልማድ፨</l>
                <l n="2">ወለልደትከ፡ ሰላም፡ እምጾታ፡ ፪ነገድ፨</l>
                <l n="3">ወበእንተዝ፡ ይብሉከ፡ ወልደ፡ ነጐድጓድ፨</l>
                <l n="4">አባ፡ ዮሐንስ፡ ዕቀበኒ፡ እመከራ፡ ዘመን፡ ክቡድ፨</l>
                <l n="5">ወእስከ፡ ለዓለም፡ ተማሕፅነኒ፡ እምዛቲ፡ ትውልድ፨</l>
                </lg>
                <lg type="stanza" n="3">
                <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘኢየኀልቅ፡ ሰላሙ፨</l>
                <l n="2">ወኢይጸግብ፡ መዐዛ፡ ጣዕሙ፨</l>
                <l n="3">ወልደ፡ ዘብዴዎስ፡ ዮሐንስ፡ ወልደ፡ ዘካርያስ፡ ወራሴ፡ ስሙ፨</l>
                <l n="4">ምስለ፡ ስምከ፡ አምላካዊ፡ ኀበ፡ ተጽሕፈ፡ ቀዲሙ፨</l>
                <l n="5">ፊደለ፡ ስምየ፡ ጸሐፍ፡ ለክርስቶስ፡ በደሙ፨</l>
                </lg>
                <lg type="stanza" n="29">
                <l n="1">ሰላም፡ ለፍልሰትከ፡ እምዓለመ፡ ሙታን፡ ኵሉ፨</l>
                <l n="2">ሕይወተ፡ ሕያዋን፡ ንሳተፍ፡ ኀበ፡ ዘለከ፡ ይደሉ፨</l>
                <l n="3">በእንተ፡ ፍልሰትከ፡ ጴጥሮስ፡ ለክርስቶስ፡ ሶበ፡ ተስእሎ፡ በቃሉ፨</l>
                <l n="4">ሚላዕሌከ፡ ይቤሉ፡ እመፈቀድኩ፡ የሀሉ፨</l>
                <l n="5">እስከ፡ ሶበ፡ አነ፡ ዘጊዜሁ፡ እመጽእ፡ እምላዕሉ፨</l>
                </lg>
                <lg type="stanza" n="30">
                <l n="1">አንቀጸ፡ አበቅቴ፡ ወመጥቅዕ፡ እምኈልቈ፡ ፴ ለለተርፉ፨</l>
                <l n="2">ሊቃውንተ፡ ዘመን፡ ሠርዑ፡ ከመ፡ ይረስዩ፡ ግዱፈ፨</l>
                <l n="3">አባእኩ፡ ለከ፡ በእንተዝ፡ ኅጠተ፡ ማሕሌት፡ ውኩፈ፨</l>
                <l n="4">ዮሐንስ፡ ረሲ፡ ሠሚረከ፡ ከመ፡ ዕፀ፡ ሕይወት፡ ዘልፈ፨</l>
                <l n="5">ህየንተ፡ ፩ ፴ ዘይፈሪ፡ ዘልፈ፨</l>
                </lg>
                </div>
            </div>
