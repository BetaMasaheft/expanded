        <body>
            <div type="bibliography">
                
            </div>
            <div type="edition" xml:lang="gez" xml:id="div2LIT7640MalkeaEwostatewos">
                <div type="textpart" xml:id="malke">
                <lg type="stanza" n="1">
                <l n="1">በስመ፡ አብ፡ ወወልድ፡ ወመንፈስ፡ ቅዱስ፡ እንተ፡ ከሠተ፡ ምሳሌ፨</l>
                <l n="2">ለነቢያት፡ ጥንቁቀ፡ ወለሐዋርያት፡ በኢስሳሌ፨</l>
                <l n="3">ኤዎስጣቴዎስ፡ መልአክ፡ ዘታደምፅ፡ ቀርነ፡ ትንባሌ፨</l>
                <l n="4">ከመ፡ እቅዳኅ፡ ለዕበይከ፡ ወይነ፡ ሃይማኖት፡ መጥለሌ፨</l>
                <l n="5">እምኆኅተ፡ ልብየ፡ ቅላዕ፡ ወአእትት፡ ጽሌ፨</l>
                </lg>
                <lg type="stanza" n="2">
                <l n="1">ሰላም፡ ለፅንሰትከ፡ ወለልደትከ፡ ዓዲ፨</l>
                <l n="2">ዘጽልመተ፡ ዓለም፡ አብርሀ፡ አምሳለ፡ ማኅቶት፡ ነዳዲ፨</l>
                <l n="3">ኤዎስጣቴዎስ፡ ቄርሎስ፡ መገሥጸ፡ ንስጥሮስ፡ ዘከሃዲ፨</l>
                <l n="4">ጸጋ፡ ሀበኒ፡ በጸጋ፡ ዘኢይረክቦ፡ ኀያዲ፨</l>
                <l n="5">እንዘ፡ ብዕለ፡ ነፍስ፡ እንተ፡ ወልድከ፡ ኢይንዲ፨</l>
                </lg>
                <lg type="stanza" n="3">
                <l n="1">ሰላም፡ ለዝክረ፡ ስምከ፡ ዘሞገሰ፡ መስቀል፡ አክሊሉ፨</l>
                <l n="2">ወለሥዕርትከ፡ ይቡስ፡ እምጥላሌ፡ ርስሐት፡ ኵሉ፨</l>
                <l n="3">ኤዎስጣቴዎስ፡ ባስልዮስ፡ አሠረ፡ ትምህርትከ፡ እትሉ፨</l>
                <l n="4">ውግር፡ በላዕሌየ፡ መንዲለ፡ በረከት፡ ዘላዕሉ፨</l>
                <l n="5">ወቃለ፡ ጽራኅየ፡ ለአጽምዖ፡ አእዛኒከ፡ ጽሉ፨</l>
                </lg>
                <lg type="stanza" n="27">
                <l n="1">ሰላም፡ ለግንዘተ፡ ሥጋከ፡ ለሊቀ፡ ጳጳሳት፡ በእዴሁ፨</l>
                <l n="2">ወለመቃብሪከ፡ ሰላም፡ ዘብዙኅ፡ መንክራቲሁ፨</l>
                <l n="3">ኤዎስጣቴዎስ፡ ወራሲ፡ ለጳኵሚስ፡ ብዕለ፡ ጸጋሁ፨</l>
                <l n="4">በሎሙ፡ ለቅዱሳን፡ ወልድየ፡ ናሁ፨</l>
                <l n="5">ዘቦቱ፡ ሠመርኩ፡ ባርኩ፡ ኪያሁ፨</l>
                </lg>
                <lg type="stanza" n="28">
                <l n="1">ሰላም፡ ለዑደትከ፡ ብሔረ፡ አግዓዚ፡ ኵለንታሃ፨</l>
                <l n="2">እንዘ፡ ትሰብክ፡ ወንጌሉ፡ መጽሐፈ፡ ሐሤት፡ ወፍሥሓ፨</l>
                <l n="3">ኤዎስጣቴዎስ፡ ለሃይማኖት፡ ቢጸ፡ ሐዋርያት፡ ሐዋርያሃ፨</l>
                <l n="4">እምልብየ፡ ወሕሊናየ፡ አፈቅረከ፡ ብዙኀ፨</l>
                <l n="5">ለፍቅርሰ፡ እንተ፡ ዓለም፡ አልቦቱ፡ ረባሓ፨</l>
                </lg>
                <lg type="stanza" n="29">
                <l n="1">ሰላም፡ ለንግደትከ፡ በተወክፎ፡ ብዙኅ፡ መከራ፨</l>
                <l n="2">እምኢትዮጵያ፡ አሐተ፡ ምክፈልተ፡ መርምህናም፡ ርሡይ፡ ጌራ፡</l>
                <l n="3">ኤዎስጣቴዎስ፡ በገድል፡ ቴዎዶጦስ፡ ዘዕንቆራ፨</l>
                <l n="4">ለዛቲ፡ ማሕሌት፡ ከመ፡ ኢይትረሣእ፡ ዝክራ፨</l>
                <l n="5">ውስተ፡ ጽሌ፡ ልብከ፡ ጸሐፍ፡ ወካልእ፡ ነገራ፨</l>
                </lg>
                </div>
            </div>
        </body>
