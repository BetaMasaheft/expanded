            <t:div type="edition" xml:lang="gez" xml:id="div2LIT5188MashafaMadbal"><t:note>From <t:bibl corresp="http://zotero.org/groups/358366/items/BL5NWGBV"><seg type="webpage"><!-- attributes from original bibl--></seg><ptr target="bm:MgWebsite"/><title level="a">መልክአ፡ ጉባኤ፡ Malkǝʾa gubāʾe</title><author><forename>Augustine</forename><surname>Dickinson</surname></author><date>2020</date><note type="accessed">2024-09-24</note><note type="url">https://malkeagubae.com/</note><note type="tags"><note type="tag">bm:MgWebsite</note></note><note type="tag">bm:MgWebsite</note></t:bibl></t:note>
                <t:div type="textpart" xml:id="malke">
                    <t:lg type="stanza" n="1">
                        <t:l n="1">ሰላም፡ እብል፡ ለተዋሕዶ፡ ቅድስት፡ ሥላሴ፨</t:l>
                        <t:l n="2">ቀዊምየ፡ ቅድመ፡ ሥላሴ፨</t:l>
                        <t:l n="3">እንበለ፡ ናፍቆ፡ ኣአምን፡ ህላዌ፡ ሥላሴ፨</t:l>
                        <t:l n="4">ግጻዌሆሙ፡ ሥላሴ፡ ወአካሎሙ፡ ሥላሴ፨</t:l>
                        <t:l n="5">ወቅዳሴሆሙ፡ ከማሁ፡ ሥላሴ፨</t:l>
                    </t:lg>
                    <t:lg type="stanza" n="2">
                        <t:l n="1">ለዘአኀዝኩ፡ ወወጠንኩ፡ እንዘ፡ አስተናሥእ፡ ቃለ፨</t:l>
                        <t:l n="2">ጽሒፈ፡ አሐዱ፡ ጸሎት፡ እንተ፡ ይሰመይ፡ መድበለ፨</t:l>
                        <t:l n="3">አዘቅተ፡ ኂሩት፡ ሥላሴ፡ ትፈለፍሉ፡ ሣህለ፨</t:l>
                        <t:l n="4">አዕርጉኒ፡ ለገብርክሙ፡ ሰማየ፡ አእምሮ፡ ልዑለ፨</t:l>
                        <t:l n="5">ወጸሐፉ፡ በልብየ፡ ዘጥበብ፡ ፊደለ፨</t:l>
                    </t:lg>
                    <t:lg type="stanza" n="99">
                        <t:l n="1"/>
                    </t:lg>
                </t:div>
