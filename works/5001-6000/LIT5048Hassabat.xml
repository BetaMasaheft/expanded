        <t:body>
            <t:div type="bibliography"/>
         
            <t:div type="edition">
              <t:div type="textpart" xml:id="Cycle" corresp="https://betamasaheft.eu/LIT1171Awdana">
               <t:label>Cycle of the kings</t:label>
              </t:div>
              <t:div type="textpart" xml:id="Conqueror">
               <t:label>Calculus of conqueror (<t:foreign xml:lang="gez">ሐሳበ፡ መዋዒ፡</t:foreign>)</t:label>
              </t:div>
              <t:div type="textpart" xml:id="Enoch">
               <t:label>Calculus of the <t:ref type="work" corresp="https://betamasaheft.eu/LIT1340EnochE">Ethiopic Book of Enoch</t:ref> (<t:foreign xml:lang="gez">ሐሳበ፡ ሄኖክ፡</t:foreign>)</t:label>
              </t:div>
              <t:div type="textpart" xml:id="Weather">
              <t:label>Calculus on months and weather (<t:foreign xml:lang="gez">ሐሳበ፡ መናዝል</t:foreign>)</t:label>
            </t:div>
              <t:div type="textpart" xml:id="Wealth">
              <t:label>Calculus of wealth (<t:foreign xml:lang="gez">ሐሳበ፡ ሀብት፡</t:foreign>)</t:label>
            </t:div>
              <t:div type="textpart" xml:id="Enemy" cert="medium" corresp="https://betamasaheft.eu/LIT4011Zodiac">
              <t:label>Calculus of enemy on Zodiac (<t:foreign xml:lang="gez">ሐሳበ፡ ፀር፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="MagicFormulas">
               <t:label>Magic formulas</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Weekdays">
               <t:label>Divination for weekdays</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Zodiac">
               <t:label>Divination on Zodiac</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Newborn">
               <t:label>Calculus of newborn on seven weekdays and seven Archangels</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Sick">
               <t:label>Calculus of sick (<t:foreign xml:lang="gez">ሐሳበ፡ ድውይ፡</t:foreign>)</t:label>
                <t:note>Thematically similar to <t:ref type="work" corresp="https://betamasaheft.eu/LIT7594HassabSick">Ḥassāba
          dǝwwǝy (general record)</t:ref>.</t:note>
            </t:div>
            <t:div type="textpart" xml:id="Trip">
               <t:label>Calculus of trip (<t:foreign xml:lang="gez">ሐሳበ፡ ፍኖት፡</t:foreign>)</t:label>
                <t:note>Thematically similar to <t:ref type="work" corresp="https://betamasaheft.eu/LIT7479Saalt#Journey1">Maṣḥafa Saʾalt: Chapter 7 - Concerning a journey</t:ref> and 
                    <t:ref type="work" corresp="https://betamasaheft.eu/LIT7579HassabaFen">Ḥassāba
          fǝnot (general record)</t:ref>.</t:note>
            </t:div>
            <t:div type="textpart" xml:id="Destiny">
               <t:label>Calculus of destiny (<t:foreign xml:lang="gez">ሐሳበ፡ ክፍል፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Monasteries">
               <t:label>Calculus of monasteries (<t:foreign xml:lang="gez">ሐሳበ፡ አድባር፡</t:foreign>)</t:label>
                <t:note>Thematically similar to <t:ref type="work" corresp="https://betamasaheft.eu/LIT5048Hassabat#Monasteries">Ḥassābāt: Calculus of monasteries (ሐሳበ፡
          አድባር፡)</t:ref> and
                    <t:ref type="work" corresp="https://betamasaheft.eu/LIT7611HassAdbar">Ḥassāba
          ʾadbār (general record)</t:ref>.</t:note>
            </t:div>
            <t:div type="textpart" xml:id="Life">
               <t:label>Calculus of way of life (<t:foreign xml:lang="gez">ሐሳበ፡ ነቢር፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Calculus">
               <t:label>Calculus (<t:foreign xml:lang="gez">ሐሳብ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Ezra">
               <t:label>Calculus of the <t:ref type="work" corresp="https://betamasaheft.eu/LIT3581Bookof">Book of Ezra</t:ref> (<t:foreign xml:lang="gez">ሐሳበ፡ እዝራ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Alphabet">
               <t:label>Interpretation of the Semitic alphabet</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Moon">
               <t:label>Calculus of the Moon (<t:foreign xml:lang="am">ሐሳበ፡ ጨረቃ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Psalms">
               <t:label>Calculus of the <t:ref type="work" corresp="https://betamasaheft.eu/LIT2000Mazmur">Mazmura Dāwit</t:ref> (<t:foreign xml:lang="gez">ሐሳበ፡ ዳዊት፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Ordination">
               <t:label>Calculus of ordination (<t:foreign xml:lang="gez">ሐሳበ፡ ሢመት፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Campaign">
               <t:label>Calculus of campaign (<t:foreign xml:lang="am">ሐሳበ፡ ዘመቻ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Stars">
               <t:label>Calculus of stars (<t:foreign xml:lang="gez">ሐሳበ፡ ከዋክብት፡</t:foreign>)</t:label>
                <t:note>Thematically similar to <t:ref type="work" corresp="https://betamasaheft.eu/LIT7111Zodiac">Astrological treatise on the twelve signs of the zodiac</t:ref>, 
                    <t:ref type="work" corresp="https://betamasaheft.eu/LIT7107Divination#kawakebt">Treatise on divination: ሐሳበ፡ ከዋክብት፡ ወመናዝል፡</t:ref> and <t:ref type="work" corresp="https://betamasaheft.eu/LIT7599HassStars">Ḥassāba
          kawākǝbt (general record)</t:ref>.</t:note>
            </t:div>
            <t:div type="textpart" xml:id="HusbandWife">
               <t:label>Calculus of husband and wife (<t:foreign xml:lang="gez">ሐሳበ፡ ብእሲት፡ ወብእሲ፡</t:foreign>)</t:label>
                <t:note>Thematically similar to <t:ref type="work" corresp="https://betamasaheft.eu/LIT7479Saalt#Husband">Maṣḥafa Saʾalt: Chapter 1 - Concerning a husband and wife</t:ref> and
                    <t:ref type="work" corresp="https://betamasaheft.eu/LIT7626HasHusband">Ḥassāba
          bǝʾsi wa-bǝʾsit (general record)</t:ref>.</t:note>
            </t:div>
            <t:div type="textpart" xml:id="Sybil" corresp="https://betamasaheft.eu/LIT4992HassabSabela">
               <t:label>Computus of Sybil (<t:foreign xml:lang="gez">ሐሳበ፡ ሳቤላ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Deeds">
               <t:label>On a man's deeds (<t:foreign xml:lang="gez">በእንተ፡ ገብረቱ፡ ለሰብእ፡</t:foreign>)</t:label>
            </t:div>
            <t:div type="textpart" xml:id="Kobor">
               <t:label>Book of Kobor (Chebar?) (<t:foreign xml:lang="gez">መጽሐፈ፡ ኮቦር፡</t:foreign>)</t:label>
                <t:note>For predicting events depending on the day of the week on which the feast of St John the Baptist falls, similar or possibly 
