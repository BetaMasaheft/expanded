        <t:profileDesc xmlns:t="http://www.tei-c.org/ns/1.0">
            <t:creation/>
            <t:abstract>
                <t:p>Magic prayer against the evil eye, followed by the legend of the witch seen by the Apostles on the shore of the 
                    <t:placeName ref="https://betamasaheft.eu/LOC7368Tiberias">Sea of Galilee (Tiberias)</t:placeName>. The prayer begins with the name of an eye disease (or, alternatively, a demon that causes it), or with several such names. 
                    The most common are <t:foreign xml:lang="gez">nadarā</t:foreign> (also <t:foreign xml:lang="gez">nadǝrā, nǝd(ǝ)rā</t:foreign>) and  <t:foreign xml:lang="gez">ʿāynat</t:foreign>.</t:p>
            </t:abstract>
            <t:textClass>
                <t:keywords>
                    <t:term key="ChristianLiterature" ana="#ChristianLiterature"/>
                    <t:term key="Magic" ana="#Magic"/>
                    <t:term key="Prayers" ana="#Prayers"/>
                </t:keywords>
            </t:textClass>
